res |> funnySum
//│ = 1001000

:silent
suite.add("EagerBuiltFunnySum1000", () => res |> funnySum)
suite.add("EagerBuiltFunnySum100", () => res100 |> funnySum)
suite.add("EagerBuiltFunnySum10", () => res10 |> funnySum)

