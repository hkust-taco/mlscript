#lang(0.3.x, useNewResolution: false)
#config(effectHandlers: Some(EffectHandlers()))

abstract class Emit with
  fun emit(e: Int): ()

fun range(l: Int, u: Int, h: Emit) =
  if l > u then ()
  else
    h.emit(l)
    range(l + 1, u, h)

fun run(n: Int) =
  let s = 0
  handle h = Emit with
    fun emit(e)(k) =
      set s = s + e
      k()
