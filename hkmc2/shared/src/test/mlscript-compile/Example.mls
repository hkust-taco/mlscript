
import "./Predef.mls"
open Predef


fun privFun = "hi"


module Example with ...


fun pubFun = privFun


fun (/) funnySlash(f, arg) = f(arg)

fun inc(x) = x + 1

fun test(x) = if x is
  Int then "int"
  Num then "num"
  Str then "str"
  else "other"


fun assertFail() =
  assert false


class Test(val field: Int)

module Test with
  fun next(self: Test) = Test(self.field + 1)

val t = new Test(123)


// Example of inheritance
abstract class Base
class Child1 extends Base
class Child2 extends Base


// Example of curried class
class Curried(val a)(val b)(val c) with
  fun fields = [a, b, c]


