#lang(0.3.x)

@fresh private val fileKey = Symbol("file key")

module SymbolKeyLibrary {
  @fresh val readKey = Symbol("library read")
  class Reader {
    @jsSymbol(readKey) fun read() = 55
  }
  fun make(value) =
    class Local {
      @jsSymbol(SymbolKeyLibrary.readKey) fun read() = value
    }
    new Local
  class FileReader {
    @jsSymbol(fileKey) fun read() = 64
  }
  fun makeLocal(value) =
    @fresh val key = Symbol("factory key")
    class Local {
      @jsSymbol(key) fun read() = value
    }
    new Local
}
