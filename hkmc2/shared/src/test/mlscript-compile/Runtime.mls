// runtime implementations
fun unwind(...saved) =
  curEffect.lastSegmentBuf.push(...saved)

fun mkEffect(handler, handlerFun) =
  let buf = mut []
  let seg = new mut StackSegment(buf, 0, null)
  let stack = new mut FunStack(seg, seg, null, null)
  let cont = new mut ContTrace(stack, stack, false)
  set curEffect = new mut EffectTrace(cont, buf, handler, handlerFun)

fun enterHandleBlock(handler, body) =
  let tmp = body()
  if curEffect === null do return tmp
  let buf = mut []
  let seg = new mut StackSegment(buf, 0, null)
  let newStack = new mut FunStack(seg, seg, null, null)
  set
    curEffect.contTrace.lastStack.handler = handler
    curEffect.contTrace.lastStack.nextStack = newStack
    curEffect.contTrace.lastStack = newStack
    curEffect.lastSegmentBuf = buf
  handleEffects()

object NewEffect
data class Unwind(ret)

// Assumes curEffect is not null
fun handleEffects() =
  while handleEffect() is
    NewEffect do 1 // not unit to bypass ucs bug
    Unwind(ret) do return ret

// return either new effect, final result or the same continuation if there is no handler
fun handleEffect() =
  // find the handle block corresponding to the current effect
  let stack = curEffect.contTrace.funStack
  while stack !== null and stack.handler !== curEffect.handler do
    set stack = stack.nextStack

  // no matching handle block
  if stack === null do
    return Unwind(())

  // unlink and save frames
  let saved = new mut ContTrace(
    stack.nextStack,
    curEffect.contTrace.lastStack,
    false
  )
  // to keep invariant, we need a new stack
  let newBuf = mut []
  let newSeg = new mut StackSegment(newBuf, 0, null)
  let newStack = new mut FunStack(newSeg, newSeg, null, null)
  set
    curEffect.contTrace.lastStack = newStack
    curEffect.lastSegmentBuf = newBuf
    stack.nextStack = newStack

  // handle the effect
  let k = resume(curEffect.contTrace)
  let f = curEffect.handlerFun
  set curEffect = null
  let res = f(k)
  if curEffect !== null then
    // relink the saved frames
    // We modify lastStack since the second last stack cannot be obtained quickly
    // Hence we replace lastStack's field with field from saved
    if saved.funStack === saved.lastStack do
      set saved.lastStack = curEffect.contTrace.lastStack
    set
      curEffect.contTrace.lastStack.segLast.nextSegment = saved.funStack.segHead
      curEffect.contTrace.lastStack.segLast = saved.funStack.segLast
      curEffect.contTrace.lastStack.handler = saved.funStack.handler
      curEffect.contTrace.lastStack.nextStack = saved.funStack.nextStack
      curEffect.contTrace.lastStack = saved.lastStack
      curEffect.lastSegmentBuf = saved.lastStack.segLast.buf
    NewEffect
  else
    // resume the unlinked handle blocks
    resumeContTrace(saved, res)

fun resume(contTrace)(value) =
  if contTrace.resumed do
    throw Error("Multiple resumption")
  set contTrace.resumed = true
  if resumeContTrace(contTrace, value) is
    NewEffect then handleEffects()
    Unwind(ret) then ret

let times = 0
fun dbgTimes(cnt, fn) =
  set times += 1
  if times === cnt do fn()

// Assumes curEffect === null, return either NewEffect or Unwind(...) if no effect
fun resumeContTrace(contTrace, value) =
  // TODO: increment stackDepth by some constant amount
  let curDepth = stackDepth + 1
  let stack = contTrace.funStack
  while stack !== null do
    let segment = stack.segHead
    while segment !== null do
      let
        buf = segment.buf
        off = segment.off
      while off < buf.length do
        // resume function with value
        let
          i = 0
          f = buf.[off]
          argListsLength = buf.[off + 5]
          currentArgList = off + 6
          thisOff = off + 4
        set
          resumeValue = value
          resumeArr = buf
          resumePc = buf.[off + 1]
        if argListsLength === 0 do
          throw new Error("cannot resume getters")
        while i < argListsLength - 1 do
          let argListLength = buf.[currentArgList]
          set
            f = f.apply(buf.[thisOff], buf.slice(currentArgList + 1, currentArgList + 1 + argListLength))
            currentArgList += argListLength + 1
            i += 1
        let argListLength = buf.[currentArgList]
        set
          resumeIdx = currentArgList + argListLength + 2
          off = resumeIdx + buf.[resumeIdx - 1]
          value = f.apply(buf.[thisOff], buf.slice(currentArgList + 1, currentArgList + 1 + argListLength))
          stackDepth = curDepth
        if curEffect !== null do
          set
            segment.off = off
            curEffect.contTrace.lastStack.segLast.nextSegment = segment
            curEffect.contTrace.lastStack.segLast = stack.segLast
            curEffect.contTrace.lastStack.handler = stack.handler
            curEffect.contTrace.lastStack.nextStack = stack.nextStack
            curEffect.contTrace.lastStack = contTrace.lastStack
            curEffect.lastSegmentBuf = contTrace.lastStack.segLast.buf
          return NewEffect
      set segment = segment.nextSegment
    set stack = stack.nextStack
  Unwind(value)

// stack safety
mut val stackLimit = 0 // How deep the stack can go before heapifying the stack
mut val stackDepth = 0
mut val stackHandler = null
mut val stackResume = null

object StackDelayHandler with
  fun delay() = mkEffect of this, k =>
    set stackResume = k

fun checkDepth() =
  if stackDepth >= stackLimit && stackHandler !== null then
    // this is a tail call to effectful function
    stackHandler.delay()
  else
    ()

fun runStackSafe(limit, f) =
  set
    stackLimit = limit
    stackDepth = 1
    stackHandler = StackDelayHandler
  let result = enterHandleBlock(StackDelayHandler, f)
  if curEffect !== null do
    throw new Error("Effect crossed through stack safe boundary")
  while stackResume !== null do
    let saved = stackResume
    set
      stackResume = null
      stackDepth = 1
      result = saved(())
    if curEffect !== null do
      throw new Error("Effect crossed through stack safe boundary")
  set
    stackLimit = 0
    stackDepth = 0
    stackHandler = null
  result

class Int31(v) with
  fun zext() = bitand(v, bitnot(shl(1, 31))) as Int
  fun sext() = bitor(v, shl(1, 31)) as Int

fun plus_impl(lhs, rhs) = if lhs is
  Int31 and rhs is Int31 then lhs + rhs
  else unreachable()
