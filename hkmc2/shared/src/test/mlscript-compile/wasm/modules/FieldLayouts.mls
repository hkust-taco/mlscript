#config(target: CompilationTarget.Wasm, inlining: None)

// Equal WASM layouts need not give the same names to the same field offsets.
class Parent(val x)
class Child(val y) extends Parent(10)
class Base(val a)
class Derived(val x) extends Base(x * 2)

module FieldLayouts with
  fun inherited() = new Derived(42).Base#a
  fun own() = new Derived(42).x
  fun earlier() = new Child(20).Parent#x + new Child(20).y
