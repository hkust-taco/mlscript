#lang(0.3.x)

import "../RuntimeWasm.mls"

import "../Predef.mls"
import "../Runtime.mls"

module Wasm with ...

// WebAssembly utilities
fun instantiateWasmBinary(modBuf, importObject): dyn =
  RuntimeWasm.instantiateBinary(modBuf, importObject)

fun dumpWasmModImpExp(wasmMod) =
  console.log of "Imports: %s", WebAssembly.Module.imports(wasmMod)
  console.log of "Exports: %s", WebAssembly.Module.exports(wasmMod)

fun dumpWasmInstImpExp(wasmInst: dyn) =
  console.log of "Imports: %s", wasmInst.imports
  console.log of "Exports: %s", wasmInst.exports

// Binaryen helpers share validation and disposal with the file loader.
fun binaryenFmtWat(wat, foldExprs): Str =
  RuntimeWasm.formatWat(wat, foldExprs)

fun binaryenCompileToModule(wat, importObject): dyn =
  RuntimeWasm.compileWat(wat, importObject, "worksheet")

fun unwrapWasmException(err: dyn, tag) =
  if (
    err !== null &&
    err !== unsafe.undefined &&
    typeof(err.is) === "function" &&
    typeof(err.getArg) === "function" &&
    err.is(tag)
  )
  then err.getArg(tag, 0)
  else err

fun binaryenRunFunc(wat, importObject: dyn, func: Function): Any =
  let wasmInst = binaryenCompileToModule of wat, importObject
  let exnTag =
    if wasmInst.exports.mlx_exn === unsafe.undefined
    then importObject.system.mlx_exn
    else wasmInst.exports.mlx_exn
  Runtime.try_catch of
    () => func(wasmInst.exports)
    err => throw unwrapWasmException(err, exnTag)

fun binaryenPrintFuncRes(wat, importObject, func) = 
  let result = binaryenRunFunc of wat, importObject, func
  Predef.print of Runtime.render of result


fun worksheet(url: Str, entry: Str, native: dyn) = RuntimeWasm.worksheet(url, entry, native)

fun printWorksheetResult(session: RuntimeWasm.Worksheet, wat: Str, entry: Str, pages: Int, index: Int) =
  let result = session.run(wat, entry, pages, index)
  Predef.print(Runtime.render(result))
