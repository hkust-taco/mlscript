

#lang(0.3.x)

class Option[out A]: Some[A] | None with
  fun map[B](f: A -> B): Option[B] = if this is
    Option.Some(value) then Option.Some(f(value))
    Option.None then Option.None
  
  fun filter(p: A -> Bool): Option[A] = if this is
    Option.Some(value) and p(value) then this
    else Option.None

module Option with ...


data class Some[out T](value: T) extends Option[T]
object None extends Option[Nothing]

fun isDefined[A](x: Option[A]): Bool = if x is
  Some then true
  None then false

data class Both(fst, snd)


fun getOrElse[A](opt: Option[A], default: A): A = if opt is
  Some(value) then value
  None then default

fun flatMap[A, B](opt: Option[A], f: A -> Option[B]): Option[B] = if opt is
  Some(value) then f(value)
  None then None

module unsafe with
  fun get[A](opt: Option[A]): A = if opt is
    Some(value) then value
    None then throw Error("None.get")


