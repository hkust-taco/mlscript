#lang(0.3.x)
#config(effectHandlers: Some(EffectHandlers()))

import "./BaseEffects.mls"
open BaseEffects
open ProductEarlyEffects

module product_early with ...

type List[A] = Nil | Cons[A]
object Nil
data class Cons[A](x: A, xs: List[A])

fun product(xs: List[Int], h: Abort) = if xs is
  Nil then 1 // Note: Bug in the original implementation, this should be 1 instead of 0.
  Cons(y, ys) and
    y === 0 then h.done(0)
    else y * product(ys, h)

fun enumerate(i: Int): List[Int] =
  if i < 0 then Nil else Cons(i, enumerate(i - 1))

fun runProduct(xs: List[Int]) =
  handle h = Abort with
    fun done(r)(_) = r
  product(xs, h)

fun run(n: Int) =
  let xs = enumerate(1000)
  fun loop(i, a) =
    if i === 0 then a
    else loop(i - 1, a + runProduct(xs))
  loop(n, 0)
