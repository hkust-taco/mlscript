#lang(0.3.x)
import "./Iter.mls"
import "./Predef.mls"

open Iter
open Predef { id"??" }
open LazyArray

// Helper Methods
fun normIdx(i, len) =
  if i < 0 then len + i
  else i

fun enforceArray = case
  (LazyArr | Array | String | Str | TypedArray) as a then a
  ow then throw Error("Expected an Array, got: " + String(ow))

fun concatHelper[A](a: Array, l: Int, ...args: Array[Indexable[A]]): Splice[A] =
  let =l
  let
    idx = 0
    init_len = a.length
  @unsafe set a.length = init_len + args.length * 2
  while (idx < args.length) do
    let x = args.[idx]
    set 
      a.[init_len + idx * 2] = SpliceMarker
      a.[init_len + idx * 2 + 1] = enforceArray(x)
      l += x.length
      idx += 1
  Splice of a, l

// Follows the semantics of Array.prototype.slice indices:
// https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/slice
fun normIdxSlice(i, len) =
  if i < 0 and
    i >= -len then len + i
    else 0
  else i

fun sliceHelper[A](start: Int | null, end: Int | null, arr: Indexable[A]): LazyIterable[A] =
  let len = arr.length
  let beg = normIdxSlice(start ?? 0, len)
  let fin = normIdxSlice(end ?? len, len)
  if beg >= len do
    return View of [], 0, 0
  if fin >= len do
    set fin = len
  if fin <= beg do
    return View of [], 0, 0
  
  if arr is
    View(itr, start, end) then View of itr, start + beg, end + (len - fin)
    Splice(bits, l) as s then View of s.materialize().slice(beg, fin), 0, 0
    else View of enforceArray(arr), beg, (arr.length - fin)

// Marker base class for View and Splice
class LazyArr[A] extends IterableBase[A] with

  open override fun toString(): Str = "[" + this joined(", ") + "]"
  open override fun concat(...xs: Array[Indexable[A]]): LazyIterable[A] = concatHelper(mut [SpliceMarker, this], this.length, ...xs)

// Requires that the underlying iterable is constant-time indexable
// Note: Ideally `underlying` should be typed as `IterableBase`, but `Array` currently does not extend it.
class View[A](val underlying: Indexable[A], val start: Int, val end: Int) extends LazyArr[A] with

  @annotations.jsSymbol(Symbol.iterator) override fun iterator(): Iterator[A] =
    let idx = start
    let until = underlying.length - end
    IteratorImpl of () =>
      if idx < until then
        let next = underlying.at(idx)
        set idx = idx + 1
        Result.Next of next
      else Result.Done

  fun materialize(): Indexable[A] = underlying.slice(start, underlying.length - end)
  
  override fun at(idx: Int): A =
    if idx < -length || idx >= length do
      throw RangeError("View.at: Index out of bounds")
    underlying.at(normIdx(idx, length) + start)
  override fun slice(start?: Int, end?: Int): LazyIterable[A] = sliceHelper(start, end, this)

  val len = underlying.length - start - end
  override fun length: Int = len
  override fun toString(): Str = "[" + this joined(", ") + "]"

object SpliceMarker
class Splice[A](val bits: Array, val len: Int) extends LazyArr[A] with
  let materialized = null

  @annotations.jsSymbol(Symbol.iterator) override fun iterator(): Iterator[A] =
    let idx = 0
    let uitr = null
    
    fun nextf() =
      if idx < bits.length and
        bits.[idx] is 
          SpliceMarker then
            if uitr === null do 
              set uitr = bits.[idx + 1].(Symbol.iterator)()
            let n = uitr.next()
            if n.done then
              set uitr = null
              set idx += 2
              nextf()
            else
              n
          else
            let value = bits.[idx]
            set idx += 1
            Result.Next of value
      else Result.Done
    IteratorImpl of nextf

  fun reify: Array[A] = 
    let counter = 0
    let arr = new mut Array(len)
    val stack: Array[[Int, Indexable]] = mut []
    stack.push([0, bits])
    while stack.length > 0 do
      let e = stack.pop()
      let idx = e.0
      let vals = e.1

      if vals is Splice as splice do
        set vals = splice.bits

      while (idx < vals.length and
          (vals.at(idx) is SpliceMarker) is false) do
        set arr.[counter] = vals.at(idx)
        set counter += 1
        set idx += 1
      
      if (idx < vals.length and vals.at(idx) is SpliceMarker) do
        stack.push([idx + 2, vals])
        stack.push([0, vals.at(idx + 1)])
    arr

  fun materialize(): Array[A] =
    if materialized === null do
      set materialized = reify
    materialized
  
  override fun at(idx: Int): A | unsafe.undefined = materialize().at(idx)
  override fun slice(start?: Int, end?: Int): LazyIterable[A] = sliceHelper(start, end, this)
  override fun concat(...xs: Array[Indexable[A]]): LazyIterable[A] = 
    if materialized === null 
    then concatHelper(mut [SpliceMarker, this], len, ...xs)
    else concatHelper(mut [SpliceMarker, materialized], len, ...xs)
  
  override fun length: Int = len
  override fun toString(): Str = "[" + materialize() joined(", ") + "]"


module LazyArray with...


fun mk[A](...args: Array[A]): LazyIterable[A] = View of args, 0, 0
fun concat[A](...args: Array[Indexable[A]]): LazyIterable[A] = concatHelper(mut [], 0, ...args)
fun dropLeftRight[A](beg: Int, fin: Int)(xs: Indexable[A]): LazyIterable[A] = 
  if beg < 0 || fin < 0 do
    throw RangeError("LazyArray.dropLeftRight: indices must be non-negative")
  if beg > xs.length || fin > xs.length do
    throw RangeError("LazyArray.dropLeftRight: indices out of bounds")
  sliceHelper(beg, xs.length - fin, xs)

fun equals(xs: Indexable, ys: Indexable) =
  xs.length === ys.length &&
    let idx = 0
    while (idx < xs.length) do
      if xs.at(idx) !== ys.at(idx) do return false
      set idx += 1
    true

// This is not meant for users; it's referred to by Runtime.mls
// TODO: use `LazyArray.internals.concat` when this is implemented
fun __concat(...args): LazyIterable[Any] =
  let len = 0
  let idx = 0
  while (idx < args.length) do
    if args.[idx] is SpliceMarker then
      set len += enforceArray(args.[idx + 1]).length
      set idx += 2
    else
      set len += 1
      set idx += 1
  Splice of args, len

// This is not meant for users; it's referred to by Runtime.mls
// TODO: use `LazyArray.internals.split` when this is implemented
val __split = SpliceMarker
