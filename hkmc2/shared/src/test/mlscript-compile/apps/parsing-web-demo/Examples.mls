"""

examples |> MutMap.insert of
  "caml-fibonacci"
  name: "Caml Light: Fibonacci"
  source: """let rec fib n =
  if n < 2 then 1 else fib(n-1) + fib(n-2)
;;
if sys__interactive then () else
if vect_length sys__command_line <> 2 then begin
  print_string "Usage: fib <number>";
  print_newline()
end else begin
  try
    print_int(fib(int_of_string sys__command_line.(1)));
    print_newline()
  with Failure "int_of_string" ->
    print_string "Bad integer constant";
    print_newline()
end
;;"""

examples |> MutMap.insert of
  "caml-sieve"
  name: "Caml Light: Sieve"
  source: """let rec interval min max =
  if min > max then [] else min :: interval (succ min) max
;;
let rec filter p = function
  | [] -> []
  | a :: r -> if p a then a :: filter p r else filter p r
;;
let remove_multiples_of n =
  filter (fun m -> m mod n <> 0)
;;
let sieve max =
  let rec filter_again = function
  | [] -> []
  | n :: r as l ->
      if n * n > max then l else n :: filter_again (remove_multiples_of n r)
  in
    filter_again (interval 2 max)
;;"""

examples |> MutMap.insert of
  "caml-integer-sets"
  name: "Caml Light: Integer Sets"
  source: """type t == int list;;
let empty = [];;
let rec belongs n = function
  | [] -> false
  | m :: rest ->
      if m = n then true else
        if m > n then false else belongs n rest
;;
let rec add n = function
  | [] -> [n]
  | m :: rest as set ->
      if m = n then set else
        if m > n then n :: set else m :: add n rest
;;"""

examples |> MutMap.insert of
  "caml-pascal-values"
  name: "Caml Light: Pascal Values"
  source: """#open "interp";;
let int_val = function
  | Int n -> n
  | _ -> raise(Runtime_error "integer expected")
and bool_val = function
  | Bool b -> b
  | _ -> raise(Runtime_error "boolean expected")
and array_val = function
  | Array(lower, values) -> (lower, values)
  | _ -> raise(Runtime_error "array expected")
;;
let print_value v =
  print_int(int_val v); print_newline()
;;
let read_value () =
  let input = read_line() in
  try Int(int_of_string input)
  with Failure _ -> raise(Runtime_error "read error")
;;"""

