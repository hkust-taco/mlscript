import "../parsing/Parser.mls"
import "../parsing/Lexer.mls"
import "../parsing/Tree.mls"
import "../parsing/TokenHelpers.mls"
import "../../StrOps.mls"
import "../../Iter.mls"
import "../../XML.mls"
import "../../Option.mls"
import "../../Runtime.mls"
import "../../Predef.mls"
import "../../MutMap.mls"
import "../parsing/TreeHelpers.mls"
import "../parsing/Extension.mls"
import "../parsing/ParseRuleVisualizer.mls"
import "../parsing/ParseRule.mls"
import "../parsing/Keywords.mls"
import "../parsing/Rules.mls"
import "../parsing/vendors/railroad/railroad.mjs"
import "./Examples.mls"

open XML { elem }
open Predef
open Option { Some, None }
open ParseRule { Choice }
open Examples

module Main with ...

let query = document.querySelector.bind(document)
let editor = query("#editor")
let selector = query("select#example")
let provenance = query("#example-provenance")
let provenanceText = query("#example-provenance span")
let provenanceLink = query("#example-provenance a")
let parseButton = query("button#parse")
let copyButton = query("#copy-output")
let traceToggle = query("#trace-toggle")
let parseStatus = query("#parse-status")
let outputPanel = query("#output")
let tokensOutput = query("#tokens-output")
let traceOutput = query("#trace-output")
let errorDialog = query("#error-dialog")
let errorMessage = query("#error-message")
let errorLocation = query("#error-location")
let errorStack = query("#error-stack")

fun loadExample(example) =
  set editor.value = example.source
  if example.origin is undefined then
    set provenance.hidden = true
  else
    set provenanceText.textContent = example.origin
    set provenance.hidden = false
    if example.originUrl is undefined then
      set provenanceLink.hidden = true
    else
      set provenanceLink.hidden = false
      set provenanceLink.href = example.originUrl

examples Iter.each of case [key, example] then
  let option = document.createElement of "option"
  set option.value = key
  set option.textContent = example.name
  selector.appendChild of option
  // Load the first example.
  if editor.value is "" do
    loadExample(example)

// Make pressing <kbd>Tab</kbd> add two spaces at the caret's position.
editor.addEventListener of "keydown", event =>
  if event.key is "Tab" do
    // Prevent the default tab behavior (focusing the next element).
    event.preventDefault()
    let start = editor.selectionStart
    let end = editor.selectionEnd
    set editor.value = editor.value.substring(0, start) + "  " + editor.value.substring(end)
    set editor.selectionEnd = start + 2
    set editor.selectionStart = editor.selectionEnd

selector.addEventListener of "change", event =>
  if examples |> MutMap.get(selector.value) is
    Some(example) do loadExample(example)
    None do showError(new Error("Example \"" + selector.value + "\" not found"), None)

let tabButtons = document.querySelectorAll("[data-tab]")
let tabPanels = document.querySelectorAll("[data-tab-panel]")
let activeTab = "tree"
let treeOutputText = ""
let tokensOutputText = ""
let traceOutputText = ""

fun activateTab(name: Str) =
  set activeTab = name
  tabButtons.forEach of button =>
    let active = button.dataset.tab == name
    button.classList.toggle("is-active", active)
    button.setAttribute("aria-selected", if active then "true" else "false")
  tabPanels.forEach of panel =>
    let active = panel.dataset.tabPanel == name
    panel.classList.toggle("is-active", active)
    set panel.hidden = active is false

tabButtons.forEach of button =>
  button.addEventListener of "click", _ => activateTab(button.dataset.tab)
activateTab("tree")

fun activeOutputText() = if activeTab is
  "tree" then treeOutputText
  "tokens" then tokensOutputText
  "trace" then traceOutputText
  "diagrams" then query("#syntax-diagrams").textContent
  else ""

copyButton.addEventListener of "click", _ =>
  let text = activeOutputText()
  document.defaultView.navigator.clipboard.writeText(text)
  set copyButton.textContent = "Copied"
  document.defaultView.setTimeout(() => set copyButton.textContent = "Copy", 1200)

fun setStatus(kind: Str, text: Str) =
  set parseStatus.textContent = text
  set parseStatus.className = "status " + kind

fun visibleTreeCount(trees) =
  let visible = trees
    Iter.fromStack()
    Iter.filtering(tree => Extension.isDiagramDirective(tree) is false)
    Iter.toArray()
  visible.length

fun errorName(error) =
  if error.name is undefined then "Error" else error.name.toString()

fun errorMessageText(error) =
  if error.message is undefined then error.toString() else error.message.toString()

fun stackText(error) =
  if error.stack is undefined then "(no stack trace available)"
  else
    let lines = error.stack.toString().split("\n")
    if lines.length > 0 and lines.[0].startsWith(errorName(error)) do
      lines.shift()
    lines
      Iter.mapping(line => line.trim())
      Iter.filtering(line => line.length > 0)
      Iter.joined("\n")

fun locationText(location) =
  let start = location.lookupTable.lookup(location.start)
  let end = location.lookupTable.lookup(location.end)
  "Line " + start.0 + ", column " + start.1 + " to line " + end.0 + ", column " + end.1

fun highlightLocation(location) =
  editor.focus()
  editor.setSelectionRange(location.start, Math.max(location.end, location.start + 1))

fun showError(error, reportOpt) =
  set errorMessage.textContent = errorName(error) + ": " + errorMessageText(error)
  if reportOpt is Some(report) and report.location is Some(location) then
    set errorLocation.textContent = locationText(location)
    set errorLocation.hidden = false
    highlightLocation(location)
  else
    set errorLocation.textContent = ""
    set errorLocation.hidden = true
  set errorStack.textContent = stackText(error)
  if errorDialog.open do errorDialog.close()
  errorDialog.showModal()

fun hideError() =
  if errorDialog.open do errorDialog.close()

fun firstErrorInStack(trees) =
  trees Iter.fromStack() Iter.firstDefined of tree =>
    let summary = tree Tree.summary()
    if summary.indexOf("⚠") >= 0 then Some(summary) else None

parseButton.addEventListener of "click", event =>
  Runtime.try_catch of
    () =>
      setStatus("is-running", "Parsing")
      hideError()
      Extension.resetParserState()
      Parser.resetErrorReports()
      let tokens = Lexer.lex(editor.value, noWhitespace: true)
      set outputPanel.innerHTML = ""
      set treeOutputText = ""
      set tokensOutputText = TokenHelpers.panorama(tokens)
      set tokensOutput.textContent = tokensOutputText
      set traceOutput.textContent = ""
      Parser.tracer.reset()
      set Parser.tracer.enabled = traceToggle.checked
      let trees = Parser.parse(tokens)
      set Parser.tracer.enabled = false
      set traceOutputText = Parser.tracer.messages.join("\n")
      set traceOutput.textContent = traceOutputText
      if firstErrorInStack(trees) is
        Some(message) then
          setStatus("is-error", "Error")
          showError(new Error("Parse produced an error tree: " + message), Parser.firstErrorReport())
        None then
          displayRules()
          set treeOutputText = trees Iter.fromStack() Iter.mapping(TreeHelpers.showAsTree) Iter.joined("\n")
          let count = visibleTreeCount(trees)
          setStatus("is-ok", "Parsed " + count.toString() + if count == 1 then " tree" else " trees")
          trees Iter.fromStack() Iter.each of tree => if
            Extension.isDiagramDirective(tree) then ()
            else
              let collapsibleTree = document.createElement("collapsible-tree")
              set collapsibleTree.textContent = TreeHelpers.showAsTree(tree)
              outputPanel.appendChild of collapsibleTree
    error =>
      set Parser.tracer.enabled = false
      set traceOutput.textContent = Parser.tracer.messages.join("\n")
      setStatus("is-error", "Error")
      showError(error, Parser.firstErrorReport())

let indentRegex = new RegExp("""^(\s*)""")

fun parseIndentedText(text) =
  let root = (text: "", children: mut [])
  let stack = mut [(node: root, indent: -1)]
  text.split("\n")
    Iter.filtering(line => line.trim().length > 0)
    Iter.each of line =>
      let indent = line.match(indentRegex).[1].length
      let text = line.substring(indent)
      while indent <= stack.[stack.length - 1].indent do
        stack.pop()
      let newNode = (text: text, children: mut [])
      stack.[stack.length - 1].node.children.push of newNode
      stack.push of node: newNode, indent: indent
  root.children

// * CSS styles for the error display.
// * The content in custom elements is placed inside the ShadowDOM, which is
// * scoped. Therefore, styles placed directly in HTML won't be effective on
// * elements inside custom elements. Placing CSS here is more convenient.
let errorDisplayStyle = """
.error-container {
  background-color: #fdd;
  padding: 0.375rem 0.75rem 0.5rem;
  font-family: var(--monospace);
  color: #991b1bff;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.error-message {
  margin: 0;
  font-weight: bold;
  font-size: 1.125rem;
}
.stack-trace {
  font-size: 0.875rem;
  margin: 0;
  list-style-type: none;
  padding-left: 0.5rem;
}"""

class CollapsibleTree extends HTMLElement with
  fun connectedCallback() =
    let rawText = this.textContent
    set this.textContent = ""
    let treeData = parseIndentedText(rawText)
    let treeElement = createDetailsTree(treeData)
    this.appendChild(treeElement)
  
  fun createDetailsTree(nodes) =
    let fragment = document.createDocumentFragment()
    nodes Iter.each of node =>
      let details = document.createElement("details")
      details.setAttribute("open", "")
      let summary = document.createElement("summary")
      set summary.textContent = node.text
      details.appendChild of summary
      if node.children.length > 0 then
        details.appendChild of createDetailsTree(node.children)
      else
        details.setAttribute("leaf" ,"")
      fragment.appendChild of details
      let rule = document.createElement("rule")
      rule.classList.add("rule")
      fragment.appendChild of rule
    fragment

customElements.define of "collapsible-tree", CollapsibleTree

class ErrorDisplay extends HTMLElement with
  this.attachShadow(mode: "open")
  
  let _error = None
  
  fun connectedCallback() = this.render()
  
  fun setError(value) =
    set _error = Some(value)
    this.render()
  
  fun render() = if _error is Some(error) do
    let stackLines = error.stack.split("\n")
    if stackLines.[0].startsWith(error.name) do
      stackLines.shift()
    set this.shadowRoot.innerHTML = elem("div", "class": "error-container") of
      elem("h3", "class": "error-message") of
        error.name + ": " + error.message
      elem("ul", "class": "stack-trace") of
        stackLines
          Iter.mapping of line => elem("li") of line.trim()
          Iter.joined("")
      elem("style") of errorDisplayStyle

customElements.define of "error-display", ErrorDisplay

fun makeFigures(entries) = entries
  Iter.mapping of case [name, svg] then
    elem("figure") of elem("figcaption")(name), svg
  Iter.joined("")

fun escapeHtml(value) =
  value.toString()
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll("\"", "&quot;")

fun renderCell(tagName, value) = elem(tagName) of escapeHtml(value)

fun precedenceLabel(value) = if value is
  Some(value) then value.toString()
  None then "N/A"

fun rowSortKey(left, right) = if left is
  Some(value) then value
  None and right is Some(value) then value
  else Keywords.INT_MIN

fun addPrecedenceRow(rows, name, source, left, right, note) =
  rows.push of
    name: name
    source: source
    left: precedenceLabel(left)
    right: precedenceLabel(right)
    note: note
    sortKey: rowSortKey(left, right)
  ()

fun addKeywordRows(rows) = Keywords.all Iter.each of case [_, keyword] then
  addPrecedenceRow(rows, keyword.name, "keyword", keyword.leftPrec, keyword.rightPrec, "")

fun addSymbolicOperatorRows(rows) = Keywords.operatorPrecedenceMap Iter.each of case [op, _] then
  if Keywords.opPrecOpt(op) is Some([leftPrec, rightPrec]) do
    addPrecedenceRow(rows, op, "symbolic operator", Some(leftPrec), Some(rightPrec), "derived from operator spelling")

fun addParserRows(rows) =
  addPrecedenceRow(rows, "prefix application", "parser", Some(Keywords.prefixPrec), Some(Keywords.prefixPrec), "symbolic identifier followed by an operand")
  addPrecedenceRow(rows, "application", "parser", Some(Keywords.appPrec), Some(Keywords.appPrec), "term followed by term")

fun addInfixChoiceRows(rows) =
  fun visitRule(ownerName, rule) = rule.choices Iter.fromStack() Iter.each of choice =>
    if choice is
      Choice.Keyword(_, rest) then visitRule(ownerName, rest)
      Choice.Ref(_, _, _, rest) then visitRule(ownerName, rest)
      Choice.Infix(_, rhsKind, _, rest) then
        addPrecedenceRow(rows, "<operator> <" + rhsKind + ">", "rule choice", None, None, "from " + ownerName)
        visitRule(ownerName, rest)
      Choice.End then ()
  Rules.syntaxKinds Iter.each of case [kindName, rule] then visitRule(kindName, rule)

fun precedenceRows() =
  let rows = mut []
  addKeywordRows(rows)
  addSymbolicOperatorRows(rows)
  addParserRows(rows)
  addInfixChoiceRows(rows)
  rows.sort of (a, b) =>
    if a.sortKey == b.sortKey then a.name.localeCompare(b.name)
    else b.sortKey - a.sortKey
  rows

fun renderPrecedenceRow(row) = elem("tr") of
  renderCell("td", row.name)
  renderCell("td", row.source)
  renderCell("td", row.left)
  renderCell("td", row.right)
  renderCell("td", row.note)

fun renderPrecedenceTable() = elem("table", "class": "precedence-table") of
  elem("thead") of elem("tr") of
    renderCell("th", "Form")
    renderCell("th", "Source")
    renderCell("th", "Left bp")
    renderCell("th", "Right bp")
    renderCell("th", "Notes")
  elem("tbody") of precedenceRows()
    Iter.mapping(renderPrecedenceRow)
    Iter.joined("")

fun displayRules() =
  open ParseRuleVisualizer
  open Rules
  reset()
  set query("#precedence-table>main").innerHTML = renderPrecedenceTable()
  set query("#syntax-diagrams>main").innerHTML = StrOps.concat of
    elem("h3") of "Term"
    makeFigures of render(railroad, "term", termRule)
    elem("h3") of "Type"
    makeFigures of render(railroad, "term", typeRule)
    elem("h3") of "Definition"
    makeFigures of render(railroad, "term", declRule)
    elem("h3") of "Extension"
    extendedKinds
      Iter.mapping of kindName =>
        makeFigures of render(railroad, kindName, getRuleByKind(kindName))
      Iter.joined("")

Runtime.try_catch of
  () => displayRules()
  error => showError(error, None)
