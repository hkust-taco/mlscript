#lang(0.3.x, strictResolution: true)

module AsyncLibrary with
  @annotations.async
  fun inferred() = {answer: 53}
  @annotations.async
  fun typed(value: Int): {answer: Int} = {answer: value}
  fun curried: Int -> Int -> Int
  @annotations.async
  fun curried(x)(y) = x + y
  @annotations.async
  fun getter: Int = 56
  class Methods with
    @annotations.async
    fun result(value: Int): Int = value

  // Consumers compile this body in their own unit, after the defining erasure pass.
  pattern Result = x =>
    @annotations.async fun answer(): Int = 42
    answer()
