#lang(0.3.x, strictResolution: true)

module AsyncLibrary with
  @annotations.async
  fun inferred() = {answer: 53}
  @annotations.async
  fun typed(value: Int): {answer: Int} = {answer: value}
  fun curried: Int -> Int -> Int
  @annotations.async
  fun curried(x)(y) = x + y
  @annotations.async
  fun getter: Int = 56
  class Methods with
    @annotations.async
    fun result(value: Int): Int = value

  mut val offset: Int = 1
  module Nested with
    val base = 40
    class Reader(val extra: Int) with
      @annotations.async
      fun read(): Int =
        handlers.await(Promise.resolve(()))
        base + offset + extra

  @annotations.async
  fun nested(start: Int): Int =
    let value = start
    @annotations.async
    fun next(): Int =
      handlers.await(Promise.resolve(()))
      set value += 1
      value
    handlers.await(next())
    handlers.await(next())

  // Consumers compile this body in their own unit, after the defining erasure pass.
  pattern Result = x =>
    @annotations.async fun answer(): Int = 42
    answer()
