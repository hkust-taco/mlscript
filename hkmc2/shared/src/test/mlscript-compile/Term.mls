import "fs"
import "process"
import "path"
import "url"

import "./Str.mls"

module Term with...

class Symbol(name: Str)
type Literal = null | undefined | Str | Int | Num | Bool


abstract class ConstructorLike : (SymbolCons | StringJoin | TupleCapacity | Instantiation | LocalPattern | Parameter | Nested)
class SymbolCons(symbol: Symbol) extends ConstructorLike
class StringJoin extends ConstructorLike
class TupleCapacity(size: Int, inf: Bool) extends ConstructorLike
class Instantiation(symbol: Symbol, args: globalThis.Array[DebrujinSplit]) extends ConstructorLike
class LocalPattern(id: Int) extends ConstructorLike
class Parameter(symbol: Symbol) extends ConstructorLike
class Nested(split: DebrujinSplit) extends ConstructorLike

abstract class PatternStub : (LiteralStub | CharClass | ClassLikeStub | Wildcard)
class LiteralStub(value: Literal) extends PatternStub
class CharClass(start: Str, end: Str, inclusive: Bool) extends PatternStub
class ClassLikeStub(cons: ConstructorLike) extends PatternStub
class Wildcard extends PatternStub

abstract class DebrujinSplit : (Binder | DebrujinBranch | Accept | Reject)
class Binder(body: DebrujinSplit) extends DebrujinSplit
class DebrujinBranch(scrutinee: Int, ptrn, consequent: DebrujinSplit, alternative: DebrujinSplit) extends DebrujinSplit
class Accept(outcome: Int) extends DebrujinSplit
class Reject extends DebrujinSplit

abstract class Pattern : (LitPattern | Var | ClassLike | Synonym | Tuple | Record)
class LitPattern(lit: Literal) extends Pattern
class Var(sym: Symbol) extends Pattern
class ClassLike(sym: Symbol, trm: Term, parameters: globalThis.Array[Symbol] | null) extends Pattern
class Synonym(symbol: Symbol, patternArguments: globalThis.Array[DebrujinSplit]) extends Pattern
class Tuple(size: Int, inf: Bool) extends Pattern
class Record(entities: globalThis.Array[(Str, Symbol)]) extends Pattern

class Branch(scrutinee: Ref, ptrn: Pattern, continuation: Split)

abstract class Split : (Cons | Let | Else | End)
class Cons(head: Branch, tail: Split) extends Split
class Let(sym: Symbol, term: Term, tail: Split) extends Split
class Else(default: Term) extends Split
class End extends Split


object KeywordIf
object KeywordWhile


abstract class Statement : (Term | LetDecl | DefineVar)
class LetDecl(sym: Symbol) extends Statement
class DefineVar(sym: Symbol, rhs: Term) extends Statement
// TODO: other statements


abstract class Term : (Lit | Builtin | Ref | CSRef | App | Sel | DynSel | Tup | IfLike | Lam | Blk | New |
  Region | RegRef | Assgn | Deref | SetRef | Ret | Throw | Try) extends Statement
class Lit(lit: Literal) extends Term
class Builtin(name: Str) extends Term
class Ref(sym: Symbol) extends Term
class CSRef(sym: Symbol, base: Str, file: Str | undefined) extends Term
class App(lhs: Term, rhs: Term) extends Term
class Sel(prefix: Term, nme: Str) extends Term
class DynSel(prefix: Term, fld: Term, arrayIdx: Bool) extends Term
class Tup(fields: globalThis.Array[Term]) extends Term
class IfLike(kw: KeywordIf | KeywordWhile, desugared: Split) extends Term
class Lam(params: globalThis.Array[Symbol], body: Term) extends Term
class Blk(stats: globalThis.Array[Statement], res: Term) extends Term
class New(cls: Term, args: globalThis.Array[Term]) extends Term
class Region(name: Symbol, body: Term) extends Term
class RegRef(reg: Term, value: Term) extends Term
class Assgn(lhs: Term, rhs: Term) extends Term
class Deref(ref: Term) extends Term
class SetRef(ref: Term, value: Term) extends Term
class Ret(result: Term) extends Term
class Throw(result: Term) extends Term
class Try(body: Term, finallyDo: Term) extends Term


let builtinSymbols = new globalThis.Set()
builtinSymbols.add("+")
builtinSymbols.add("-")
builtinSymbols.add("*")
builtinSymbols.add("/")
builtinSymbols.add("==")
builtinSymbols.add("<")
builtinSymbols.add(">")
builtinSymbols.add(">=")
builtinSymbols.add("<=")


let names = new globalThis.Map()
fun freshName(name) =
  if names.has(name) == false do
    names.set(name, 0)
  let i = names.get(name)
  names.set(name, i + 1)
  Str.concat(name, "_", i.toString())
    

class Context(symbols: globalThis.Set, dependencies: globalThis.Set, printOnly: Bool) with
  fun isValid(name) = symbols.has(name) || builtinSymbols.has(name) || printOnly
  fun nest = Context(new globalThis.Set(symbols), dependencies, printOnly)
  fun add(name) = symbols.add(name)
  fun depends(d) = dependencies.add(d)


fun indent(str, ind, keepLeading) =
  let res = str.split("\n").map(s => Str.concat(ind, s)).join("\n")
  if keepLeading then res
  else res.substring(ind.length)

fun showStmt(s, ctx) =
  if s is
    LetDecl(Symbol(name)) then
      ctx.add(name)
      Str.concat("let ", name)
    DefineVar(Symbol(name), value) then Str.concat(name, " = ", show(value, ctx))


fun showPattern(p, ctx) =
  if p is
    LitPattern(lit) then lit.toString()
  // TODO: other patterns


fun showSplit(s, ctx, isCont) =
  if s is
    Cons(Branch(scrut, ptrn, cont), tail) then
      Str.concat(show(scrut, ctx), " is ", showPattern(ptrn, ctx), " then ", showSplit(cont, ctx, true), "\n", showSplit(tail, ctx, false))
    Let(sym, term, split) then
      let nest = ctx.nest
      nest.add(sym.name)
      Str.concat("let ", sym.name, " = ", show(term, nest), "\n", showSplit(split, nest, false))
    Else(term) then
      if isCont then show(term, ctx)
      else Str.concat("else ", show(term, ctx))
    End then ""


fun show(t, ctx) =
  if t is
    Ref(Symbol(name)) then
      if ctx.isValid(name) then name
      else throw new globalThis.Error(Str.concat("Invalid binding name ", name))
    CSRef(Symbol(name), baseFile, file) then
      if file is undefined then ctx.depends(baseFile)
      else ctx.depends(path.join(path.dirname(baseFile), file))
      name
    Lit(lit) then lit.toString()
    Sel(prefix, name) then Str.concat("(", show(prefix, ctx), ").", name)
    App(lhs, rhs) then Str.concat("(", show(lhs, ctx), ")(", show(rhs, ctx), ")")
    Tup(fields) then fields.map(t => show(t, ctx)).join(", ")
    Lam(params, body) then
      let nest = ctx.nest
      params.forEach(s => nest.add(s.name))
      Str.concat("(", params.map(s => s.name).join(", "), ") =>\n", indent(show(body, nest), "  ", true))
    Blk(stats, res) then
      let nest = ctx.nest
      Str.concat(stats.map(s => showStmt(s, nest)).join("\n"), "\n", show(res, nest))
    IfLike(KeywordIf, split) then Str.concat("if \n", indent(showSplit(split, ctx, false), "  ", true))
    // TODO: other terms

fun print(t) =
  let ctx = Context(new globalThis.Set(), new globalThis.Set(), true)
  console.log(show(t, ctx))


fun genImport(base, p) =
  Str.concat("import \"", path.relative(base, url.fileURLToPath(p)).slice(0, -4), ".mls\"")


fun codegen(t, file) =
  let ctx = Context(new globalThis.Set(), new globalThis.Set(), false)
  let moduleName = path.parse(file).name
  let fullpath = path.join(process.cwd(), file)
  let code = Str.concat("module ", moduleName, " with ...\nfun res =\n", indent(show(t, ctx), "  ", true))
  let dependencies =
    globalThis.Array.from(ctx.dependencies).map(s => genImport(path.dirname(fullpath), s))
  if fs.existsSync(file) is false do
    fs.writeFileSync(file, "", "utf8")
  let originData = fs.readFileSync(file, "utf8")
  let newData = Str.concat(dependencies.join("\n"), "\n", code)
  if newData != originData do
    fs.writeFileSync(file, newData, "utf8")

