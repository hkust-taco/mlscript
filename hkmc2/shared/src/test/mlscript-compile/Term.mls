import "fs"
import "process"
import "path"
import "url"

import "./Predef.mls"
import "./Str.mls"

open Predef

module Term with...

class Symbol(name: Str)
type Literal = null | undefined | Str | Int | Num | Bool


class ConstructorLike with
  constructor
    SymbolCons(symbol: Symbol)
    StringJoin
    TupleCapacity(size: Int, inf: Bool)
    Instantiation(symbol: Symbol, args: Array[DebrujinSplit])
    LocalPattern(id: Int)
    Parameter(symbol: Symbol)
    Nested(split: DebrujinSplit)

class PatternStub with
  constructor
    LiteralStub(value: Literal)
    CharClass(start: Str, end: Str, inclusive: Bool)
    ClassLikeStub(cons: ConstructorLike)
    Wildcard

class DebrujinSplit with
  constructor
    Binder(body: DebrujinSplit)
    DebrujinBranch(scrutinee: Int, ptrn, consequent: DebrujinSplit, alternative: DebrujinSplit)
    Accept(outcome: Int)
    Reject

class Pattern with
  constructor
    LitPattern(lit: Literal)
    Var(sym: Symbol)
    ClassLike(sym: Symbol, trm: Term, parameters: Array[Symbol] | null)
    Synonym(symbol: Symbol, patternArguments: Array[DebrujinSplit])
    Tuple(size: Int, inf: Bool)
    Record(entities: Array[(Str, Symbol)])

class Branch(scrutinee: Ref, ptrn: Pattern, continuation: Split)

class Split with
  constructor
    Cons(head: Branch, tail: Split)
    Let(sym: Symbol, term: Term, tail: Split)
    Else(default: Term)
    End


object KeywordIf
object KeywordWhile


class Statement with
  constructor
    LetDecl(sym: Symbol)
    DefineVar(sym: Symbol, rhs: Term)
    // TODO: other statements


class Term with
  constructor
    Lit(lit: Literal)
    Builtin(name: Str)
    Ref(sym: Symbol)
    CSRef(sym: Symbol, base: Str, file: Str | undefined)
    App(lhs: Term, rhs: Term)
    Sel(prefix: Term, nme: Str)
    DynSel(prefix: Term, fld: Term, arrayIdx: Bool)
    Tup(fields: Array[Term])
    IfLike(kw: KeywordIf | KeywordWhile, desugared: Split)
    Lam(params: Array[Symbol], body: Term)
    Blk(stats: Array[Statement], res: Term)
    New(cls: Term, args: Array[Term])
    Region(name: Symbol, body: Term)
    RegRef(reg: Term, value: Term)
    Assgn(lhs: Term, rhs: Term)
    Deref(ref: Term)
    SetRef(ref: Term, value: Term)
    Ret(result: Term)
    Throw(result: Term)
    Try(body: Term, finallyDo: Term)

let names = new Map()
fun freshName(name) =
  if not(names.has(name)) do
    names.set(name, 0)
  let i = names.get(name)
  names.set(name, i + 1)
  Str.concat(name, "_", i.toString())
    

class Context(symbols: Set, dependencies: Set, printOnly: Bool) with
  fun isValid(name) = symbols.has(name) || printOnly
  fun nest = Context(new Set(symbols), dependencies, printOnly)
  fun add(name) = symbols.add(name)
  fun depends(d) = dependencies.add(d)


fun indent(str, ind, keepLeading) =
  let res = str.split("\n").map(s => Str.concat(ind, s)).join("\n")
  if keepLeading then res
  else res.substring(ind.length)

fun showStmt(s, ctx) =
  if s is
    LetDecl(Symbol(name)) then
      ctx.add(name)
      Str.concat("let ", name)
    DefineVar(Symbol(name), value) then Str.concat(name, " = ", show(value, ctx))


fun showPattern(p, ctx) =
  if p is
    LitPattern(lit) then lit.toString()
  // TODO: other patterns


fun paren(t, ctx) =
  if (t is Ref) || (t is CSRef) || (t is Lit) || (t is Sel) then show(t, ctx)
  else Str.concat("(", show(t, ctx), ")")


fun showSplit(s, ctx, isCont) =
  if s is
    Cons(Branch(scrut, ptrn, cont), tail) then
      Str.concat(show(scrut, ctx), " is ", showPattern(ptrn, ctx), " then ", showSplit(cont, ctx, true), "\n", showSplit(tail, ctx, false))
    Let(sym, term, split) then
      let nest = ctx.nest
      nest.add(sym.name)
      Str.concat("let ", sym.name, " = ", show(term, nest), "\n", showSplit(split, nest, false))
    Else(term) then
      if isCont then show(term, ctx)
      else Str.concat("else ", show(term, ctx))
    End then ""


fun show(t, ctx) =
  if t is
    Ref(Symbol(name)) then
      if ctx.isValid(name) then name
      else throw Error(Str.concat("Invalid binding name ", name))
    CSRef(Symbol(name), baseFile, file) then
      if file is undefined then ctx.depends(baseFile)
      else ctx.depends(path.join(path.dirname(baseFile), file))
      name
    Lit(lit) then lit.toString()
    Builtin(name) then name
    Sel(prefix, name) then Str.concat(paren(prefix, ctx), ".", name)
    App(lhs, rhs) then Str.concat(paren(lhs, ctx), show(rhs, ctx))
    Tup(fields) then Str.concat("(", fields.map(t => show(t, ctx)).join(", "), ")")
    Lam(params, body) then
      let nest = ctx.nest
      params.forEach(s => nest.add(s.name))
      Str.concat("(", params.map(s => s.name).join(", "), ") =>\n", indent(show(body, nest), "  ", true))
    Blk(stats, res) then
      let nest = ctx.nest
      Str.concat(stats.map(s => showStmt(s, nest)).join("\n"), "\n", show(res, nest))
    IfLike(KeywordIf, split) then Str.concat("if \n", indent(showSplit(split, ctx, false), "  ", true))
    // TODO: other terms

fun print(t) =
  let ctx = Context(new Set(), new Set(), true)
  console.log(show(t, ctx))


fun genImport(base, p) =
  Str.concat("import \"", path.relative(base, url.fileURLToPath(p)).slice(0, -4), ".mls\"")


fun codegen(t, file) =
  let ctx = Context(new Set(), new Set(), false)
  let moduleName = path.parse(file).name
  let fullpath = path.join(process.cwd(), file)
  let code = Str.concat("module ", moduleName, " with ...\nfun res =\n", indent(show(t, ctx), "  ", true), "\n")
  let dependencies =
    Array.from(ctx.dependencies).map(s => genImport(path.dirname(fullpath), s))
  if not(fs.existsSync(file)) do
    fs.writeFileSync(file, "", "utf8")
  let originData = fs.readFileSync(file, "utf8")
  let newData = Str.concat(dependencies.join("\n"), "\n", code)
  if newData != originData do
    fs.writeFileSync(file, newData, "utf8")

