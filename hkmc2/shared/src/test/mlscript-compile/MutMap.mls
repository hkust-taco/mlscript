#lang(0.3.x)

import "./Option.mls"
import "./Predef.mls"

open Predef
open Option { Some, None }


module MutMap with ...

class MutMap[A, B](val underlying: Map[A, B]) with
  
  set this.(Symbol.iterator) =
    () => underlying.(Symbol.iterator)()

fun get(key)(m: MutMap) =
  if m.underlying.has(key)
  then Some of m.underlying.get(key)
  else None

fun insert(key, value)(m: MutMap) =
  m.underlying.set(key, value)
  ()

fun delete(key)(m: MutMap) =
  m.underlying.delete(key)
  ()

fun updateWith(key)(op: Function)(m: MutMap) =
  if op(m |> get(key)) is
    Some(value) then m.underlying.set(key, value)
    None then m.underlying.delete(key)

fun keysIterator(m: MutMap) = m.underlying.keys()

fun valuesIterator(m: MutMap) = m.underlying.values()

fun values(m: MutMap) = Array.from of m.underlying.values()

fun toMap(entries: Array) =
  let
    m = empty
    i = 0
    length = entries.length
  while i < length do
    m |> insert of ...entries.at(i)
    set i += 1
  m

fun empty = new MutMap(new Map())


