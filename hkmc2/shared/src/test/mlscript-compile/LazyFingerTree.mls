#lang(0.3.x)
import "./Iter.mls"
import "./Predef.mls"
import "./FingerTreeList.mls"

open Iter
open Predef { id"??" }
open LazyFingerTree
open FingerTreeList

fun normIdx(i, len) =
  if i < 0 then len + i
  else i

fun concatHelper[A](a: Array, l: Int, ...args: Array[Indexable[A]]): Splice[A] =
  let =l
  let idx = 0
  let init_len = a.length
  @unsafe set a.length = init_len + args.length * 2
  while (idx < args.length) do
    let x = args.[idx]

    set a.[init_len + idx * 2] = SpliceMarker
    set a.[init_len + idx * 2 + 1] = x
    set l += x.length
    set idx += 1
  Splice of a, l

// Follows the semantics of Array.prototype.slice indices:
// https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/slice
fun normIdxSlice(i, len) =
  if i < 0 and
    i >= -len then len + i
    else 0
  else i

fun sliceHelper[A](start: Int | null, end: Int | null, arr: Indexable[A]) =
  let len = arr.length
  let beg = normIdxSlice(start ?? 0, len)
  let fin = normIdxSlice(end ?? len, len)
  if beg >= len do
    return View of [], 0, 0
  if fin >= len do
    set fin = len
  if fin <= beg do
    return View of [], 0, 0
  
  if arr is
    View(itr, start, end) then View of itr, start + beg, end + (len - fin)
    Splice(bits, l) as s then s.materialize().slice(beg, fin)
    ft and
      FingerTreeList.isFingerTree(ft) 
        then FingerTreeList.dropLeftRight(beg, (len - fin))(ft)
        else View of arr, beg, (len - fin)

// Marker base class for View and Splice
class LazyFT[A] extends IterableBase[A] with

  open override fun toString(): Str = "[" + this joined(", ") + "]"
  open override fun concat(...xs: Array[Indexable[A]]): Splice[A] = concatHelper(mut [SpliceMarker, this], this.length, ...xs)

class View[A](val underlying: Indexable[A], val start: Int, val end: Int) extends LazyFT[A] with

  @annotations.jsSymbol(Symbol.iterator) override fun iterator(): Iterator[A] =
    let idx = start
    let until = underlying.length - end
    IteratorImpl of () =>
      if idx < until then
        let next = underlying.at(idx)
        set idx = idx + 1
        Result.Next of next
      else Result.Done

  fun materialize(): Indexable[A] = underlying.slice(start, underlying.length - end)
  
  override fun at(idx: Int): A =
    if idx < -length || idx >= length do
      throw RangeError("View.at: Index out of bounds")
    underlying.at(normIdx(idx, length) + start)
  override fun slice(start?: Int, end?: Int) = sliceHelper(start, end, this)

  val len = underlying.length - start - end
  override fun length: Int = len
  override fun toString(): Str = "[" + this joined(", ") + "]"

object SpliceMarker
class Splice[A](val bits: Array, val len: Int) extends LazyFT[A] with
  let materialized = null

  @annotations.jsSymbol(Symbol.iterator) override fun iterator(): Iterator[A] = materialize().iterator()

  fun reify: IterableIndexable[A] =
    let acc = FingerTreeList.mk()
    val stack: Array[[Int, Indexable]] = mut []
    stack.push([0, bits])
    while stack.length > 0 do
      let e = stack.pop()
      let idx = e.0
      let vals = e.1

      if vals is Splice as splice do
        set vals = splice.bits

      while (idx < vals.length and
          (vals.at(idx) is SpliceMarker) is false) do
        set acc = acc :+ vals.at(idx)
        set idx += 1

      if (idx < vals.length and vals.at(idx) is SpliceMarker) do
        stack.push([idx + 2, vals])
        let next = vals.at(idx + 1)
        if FingerTreeList.isFingerTree(next)
          then set acc = acc ++ next
          // SpliceMarker is always followed by an indexable sequence.
          else stack.push([0, next])
    acc

  fun materialize(): IterableIndexable[A] =
    if materialized == null do
      set materialized = reify
    materialized

  override fun at(idx: Int): A = materialize().at(idx)
  // called on eager spreads in matches
  override fun slice(start?: Int, end?: Int) = sliceHelper(start, end, this)
  override fun concat(...xs: Array[Indexable[A]]): Splice[A] =
    if materialized === null 
    then concatHelper(mut [SpliceMarker, this], len, ...xs)
    else concatHelper(mut [SpliceMarker, materialized], len, ...xs)   
  
  override fun length: Int = len
  override fun toString(): Str = "[" + materialize() joined(", ") + "]"


module LazyFingerTree with...


fun mk[A](...args: Array[A]): View[A] = View of FingerTreeList.mk(...args), 0, 0
fun concat[A](...args: Array[Indexable[A]]): Splice[A] = concatHelper(mut [], 0, ...args)
fun dropLeftRight[A](beg: Int, fin: Int)(xs: Indexable[A]) =
  if beg < 0 || fin < 0 do
    throw RangeError("LazyFingerTree.dropLeftRight: indices must be non-negative")
  if beg > xs.length || fin > xs.length do
    throw RangeError("LazyFingerTree.dropLeftRight: indices out of bounds")
  sliceHelper(beg, xs.length - fin, xs)

fun equals(xs: Indexable, ys: Indexable) =
  if xs is
    [x, ...xs] then
      if ys is
        [b, ...bs] then x == b && equals(xs, bs)
        [] then false
    [] then ys.length === 0

// The following functions are not meant for users; it's meant referred to by Runtime.mls
// TODO: use `LazyFingerTree.internals.concat` when this is implemented

fun __concat(...args) = 
  let len = 0
  let idx = 0
  while (idx < args.length) do
    if args.[idx] is SpliceMarker then
      set len += (args.[idx + 1] as Indexable).length
      set idx += 2
    else
      set len += 1
      set idx += 1
  Splice of args, len

val __split = SpliceMarker
