#lang(0.3.x)

#config(liftDefns: Some(LiftDefns))

import "./Option.mls"
import "./Stack.mls"
import "./Predef.mls"

open annotations { jsSymbol }
open Option { Some, None }
open Stack { Nil, Cons }
open Predef { id"??" }


module Iter with ...

open class IterableBase[A] with
  @jsSymbol(Symbol.iterator) open fun iterator(): Iterator[A] = throw new Error("Not implemented: iterator()")

  // require that subclasses are immutable
  fun toArray(): Array[A] = [...this]
  
  let array = null
  
  fun asArray: Array[A] =
    if array is null then
      set array = toArray() Object.freeze()
      array
    else array
  
  // * Functions that create a fresh new result
  // Omitted MLscript arguments bind null; supply the native defaults explicitly.
  open fun at(idx: Int): A | unsafe.undefined = asArray.at(idx)
  open fun concat(...xs: Array[A | Array[A]]): Iterable[A] = asArray.concat(...xs)
  fun copyWithin(target: Int, start: Int, end?: Int): Array[A] =
    asArray.copyWithin(target, start, end ?? length)
  fun entries(): IterableIterator[[Int, A]] = asArray.entries()
  fun every(f: (A, drop Int, drop Array[A]) -> Bool, thisArg?): Bool =
    if thisArg is null then asArray.every(f) else asArray.every(f, thisArg)
  fun filter(f: (A, drop Int, drop Array[A]) -> Bool, thisArg?): Array[A] =
    if thisArg is null then asArray.filter(f) else asArray.filter(f, thisArg)
  fun find(f: (A, drop Int, drop Array[A]) -> Bool, thisArg?): A | unsafe.undefined =
    if thisArg is null then asArray.find(f) else asArray.find(f, thisArg)
  fun findIndex(f: (A, drop Int, drop Array[A]) -> Bool, thisArg?): Int =
    if thisArg is null then asArray.findIndex(f) else asArray.findIndex(f, thisArg)
  fun findLast(f: (A, drop Int, drop Array[A]) -> Bool, thisArg?): A | unsafe.undefined =
    if thisArg is null then asArray.findLast(f) else asArray.findLast(f, thisArg)
  fun findLastIndex(f: (A, drop Int, drop Array[A]) -> Bool, thisArg?): Int =
    if thisArg is null then asArray.findLastIndex(f) else asArray.findLastIndex(f, thisArg)
  fun flat(depth?: Int): Array[Any] = asArray.flat(depth ?? 1)
  fun flatMap[B](f: (A, drop Int, drop Array[A]) -> (B | Array[B]), thisArg?): Array[B] =
    if thisArg is null then asArray.flatMap(f) else asArray.flatMap(f, thisArg)
  fun forEach(f: (A, drop Int, drop Array[A]) -> Any, thisArg?): unsafe.undefined =
    if thisArg is null then asArray.forEach(f) else asArray.forEach(f, thisArg)
  fun includes(value: A, fromIndex?: Int): Bool = asArray.includes(value, fromIndex ?? 0)
  fun indexOf(value: A, fromIndex?: Int): Int = asArray.indexOf(value, fromIndex ?? 0)
  fun join(separator?: Str): Str = asArray.join(separator ?? ",")
  fun keys(): IterableIterator[Int] = asArray.keys()
  fun lastIndexOf(value: A, fromIndex?: Int): Int =
    if fromIndex is null then asArray.lastIndexOf(value) else asArray.lastIndexOf(value, fromIndex)
  fun map[B](f: (A, drop Int, drop Array[A]) -> B, thisArg?): Array[B] =
    if thisArg is null then asArray.map(f) else asArray.map(f, thisArg)
  // Match Array's explicitly initialized accumulator contract.
  fun reduce[B](f: (B, A, drop Int, drop Array[A]) -> B, initial: B): B = asArray.reduce(f, initial)
  fun reduceRight[B](f: (B, A, drop Int, drop Array[A]) -> B, initial: B): B = asArray.reduceRight(f, initial)
  open fun slice(start?: Int, end?: Int): Iterable[A] =
    asArray.slice(start ?? 0, end ?? length)
  fun some(f: (A, drop Int, drop Array[A]) -> Bool, thisArg?): Bool =
    if thisArg is null then asArray.some(f) else asArray.some(f, thisArg)
  fun toLocaleString(locales?: Str | Array[Str], options?: Any): Str =
    asArray.toLocaleString(locales ?? unsafe.undefined, options ?? unsafe.undefined)
  fun toReversed(): Array[A] = asArray.toReversed()
  fun toSorted(compare?: (A, A) -> Num): Array[A] =
    if compare is null then asArray.toSorted() else asArray.toSorted(compare)
  fun toSpliced(start: Int, deleteCount?: Int, ...items: Array[A]): Array[A] =
    asArray.toSpliced(start, deleteCount ?? length, ...items)
  open fun toString(): Str = asArray.toString()
  // `with` is an mls keyword
  fun id"with"(index: Int, value: A): Array[A] = asArray.with(index, value)
  
  // * Functions that modify the array in place
  fun fill(value: A, start?: Int, end?: Int): Array[A] =
    let result = toArray()
    result.fill(value, start ?? 0, end ?? result.length)
  fun pop(): A | unsafe.undefined = toArray().pop()
  fun push(...items: Array[A]): Int = toArray().push(...items)
  fun reverse(): Array[A] = toArray().reverse()
  fun shift(): A | unsafe.undefined = toArray().shift()
  fun sort(compare?: (A, A) -> Num): Array[A] =
    if compare is null then toArray().sort() else toArray().sort(compare)
  fun splice(start: Int, deleteCount?: Int, ...items: Array[A]): Array[A] =
    let result = toArray()
    result.splice(start, deleteCount ?? result.length, ...items)
  fun unshift(...items: Array[A]): Int = toArray().unshift(...items)
  
  open fun length: Int = asArray.length
  fun values(): Iterator[A] = iterator()

// Materialization guarantees indexing; a slice may already be an eager collection.
type LazyIterable[A] = IterableBase[A] & {
  materialize: () -> Indexable[A]
  concat: (...Array[Indexable[A]]) -> LazyIterable[A]
  slice: (Int?, Int?) -> IterableBase[A]
}

// * Implements the `IterableImpl` protocol.
// https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Iteration_protocols#the_iterable_protocol
class IterableImpl[A](mk: () -> Iterator[A]) extends IterableBase[A] with
  @jsSymbol(Symbol.iterator) override fun iterator(): Iterator[A] = mk()

// * Implements the `Iterator` protocol.
// https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Iteration_protocols#the_iterator_protocol
class IteratorImpl(val next: Function) with
  @jsSymbol(Symbol.iterator) fun iterator() = this

module Result with
  class Next(val value) with
    val done = false
  object Done with
    val done = true


// A helper function to detect if `Symbol.iterator` is on an object, and if not,
// indicate the object's class in the error message, which is useful for debugging.
fun getIterator(something): Iterator =
  let test = something.(Symbol.iterator)
  if test is unsafe.undefined then
    throw TypeError of "Not an iterable: " + if
      something is unsafe.undefined then "undefined"
      something is null then "null"
      let prototype = Reflect.getPrototypeOf of something
      prototype is null then "object"
      else prototype.constructor.name
  else test.call(something)

fun adaptIterable(iterable, makeNext: Function) = IterableImpl of () =>
  let iterator = getIterator of iterable
  IteratorImpl of makeNext of iterator

fun mapping[A, B](xs: Iterable[A], op: A -> B) =
  xs adaptIterable of (iterator: Iterator) => () =>
    let next = iterator.next()
    if next.done then
      Result.Done
    else
      Result.Next of op(next.value)

fun withMap[A, B](op: A -> B) = => _ mapping(op)

fun flattening(xss) =
  IterableImpl of () =>
    let iterableIterator = getIterator of xss
    // Get the first `Iterator` from the first `IterableImpl`.
    let currentIterator = if
      let firstIterableResult = iterableIterator.next()
      firstIterableResult.done then None
      else Some of getIterator of firstIterableResult.value
    // Recursively skip empty `IterableImpl`s and get the next `Iterator` and value.
    fun skipEmptyIterables() = if
      let nextIterableResult = iterableIterator.next()
      nextIterableResult.done then None
      let nextIterator = getIterator of nextIterableResult.value
      let nextResult = nextIterator.next()
      nextResult.done then skipEmptyIterables()
      else Some of [nextIterator, nextResult.value]
    IteratorImpl of () =>
      if currentIterator is
        None then Result.Done // No more `Iterator`s means we're done.
        Some(iterator) and
          let next = iterator.next() // The next item from the current `Iterator`.
          next.done and skipEmptyIterables() is // The current `Iterator` is drained.
            Some([nextIterator, value]) then
              set currentIterator = Some of nextIterator
              Result.Next of value
            None then
              set currentIterator = None
              Result.Done
          else Result.Next of next.value

fun filtering[A](xs: Iterable[A], op: A -> Bool) =
  xs adaptIterable of (iterator: Iterator) => () =>
    let next = iterator.next()
    while next.done is false and op(next.value) is false do
      set next = iterator.next()
    if next.done then
      Result.Done
    else Result.Next of next.value

fun withFilter[A](op: A -> Bool) = => _ filtering(op)

fun taking(xs, n) =
  let =n
  filtering of xs, _ =>
    set n -= 1
    n >= 0

fun withMax(n) = => _ taking(n)

fun leaving(xs, n) =
  let =n
  filtering of xs, _ =>
    set n -= 1
    n < 0

fun withoutAtLeast(n) = => _ leaving(n)

fun zippingWithIndex(xs) =
  let i = 0
  mapping of xs, x =>
    let j = i
    set i = i + 1
    [x, j]

fun foldingImpl[A, B](iterator: Iterator[A], acc: B, op: (B, A) -> B) =
  let =acc
  let next = iterator.next()
  while next.done is false do
    set acc = op(acc, next.value)
    set next = iterator.next()
  acc

fun appended(xs, ys) =
  IterableImpl of () =>
    let xsIterator = getIterator of xs
    let currentIterator = xsIterator
    IteratorImpl of () => if
      let next = currentIterator.next()
      next.done and
        currentIterator == xsIterator and
          do set currentIterator = getIterator of ys
          let next = currentIterator.next()
          next.done then Result.Done
          else Result.Next of next.value
        else Result.Done
      else Result.Next of next.value

fun withAppended(xs) = => _ appended(xs)

fun reduced[A](xs: Iterable[A], op: (A, A) -> A) =
  let iterator = getIterator of xs
  let next = iterator.next()
  if next.done do
    throw new Error("Empty iterator")
  foldingImpl(iterator, next.value, op)

fun folded[A, B](xs: Iterable[A], z: B, op: (B, A) -> B) =
  let iterator = getIterator of xs
  foldingImpl(iterator, z, op)

fun rightFolded[A, B](xs: Iterable[A], z: B, op: (A, B) -> B) =
  let iterator = getIterator of xs
  fun go() = if
    let next = iterator.next()
    next.done is true then
      z
    else
      op of next.value, go()
  go()

fun joined(xs, sep) =
  let iterator = getIterator of xs
  let next = iterator.next()
  if next.done then "" else
    let sep' = String(sep)
    foldingImpl of
      iterator
      String(next.value)
      (acc, x) => acc + sep + String(x)

fun firstDefined[A, B](xs: Iterable[A], op: A -> Option[B]) =
  let iterator = getIterator of xs
  let next = iterator.next()
  let result = None
  while next.done is false and result is None do
    set
      result = op(next.value)
      next = iterator.next()
  result

// `exists` is a keyword
fun some[A](xs: Iterable[A], op: A -> Bool) =
  let iterator = getIterator of xs
  let next = iterator.next()
  while next.done is false do
    if op(next.value) do return true
    set next = iterator.next()
  false

// `forall` is a keyword
fun every[A](xs: Iterable[A], op: A -> Bool) =
  let iterator = getIterator of xs
  let next = iterator.next()
  while next.done is false do
    if op(next.value) is false do return false
    set next = iterator.next()
  true

fun each[A](xs: Iterable[A], op: A -> Any) =
  let iterator = getIterator of xs
  let next = iterator.next()
  while next.done is false do
    op(next.value)
    set next = iterator.next()

fun toArray(view) = Array.from(view)

fun fromStack(stack) = IterableImpl of () =>
  let current = stack
  IteratorImpl of () => if current is
    Cons(head, tail) then
      set current = tail
      Result.Next of head
    Nil then Result.Done

fun toStack(xs) = xs rightFolded of Nil, Cons

// Important: This function is used by runtime directly. Do not call any function or make any lambda here.
fun isArrayLike(xs) = xs is (Array | IterableBase)
