// Temporary copy for consumers that still inspect signatures with the legacy resolver.
// Delete this file when its consumers are ported to new resolution, and change
// their imports back to Option.mls. Consumers that exchange Some/None values
// must use the same copy so constructor identities agree.


type LegacyOption[A] = LegacyOption.{ Some(A) | None }

module LegacyOption with ...


data class Some[T](value)
object None

fun isDefined(x) = if x is
  Some then true
  None then false

data class Both(fst, snd)


fun getOrElse(opt, default) = if opt is
  Some(value) then value
  None then default

fun flatMap(opt, f) = if opt is
  Some(value) then f(value)
  None then None

module unsafe with
  fun get(opt) = if opt is
    Some(value) then value
    None then throw Error("None.get")
