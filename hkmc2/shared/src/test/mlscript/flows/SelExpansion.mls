//│ id = fun id

id(f).foo
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   id¹(f⁰)‹app³›.foo‹?›{ ~> Foo⁰.foo⁰(id¹(f⁰)‹app³›)‹app⁴› }
//│ where
//│     f⁰  <~  Foo()
//│     f⁰  ~>  {a: ⋅a⁰}  {a: ⋅a¹}  {foo: ⋅foo⁰}
//│     f⁰  ->  x¹  x²
//│     id¹  <~  ((x²) -> x²)
//│     id¹  ~>  ((f⁰) -> app³)
//│     app³  <~  Foo()
//│     app³  ~>  {foo: ⋅foo²}
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 123


fun id(x) = x
