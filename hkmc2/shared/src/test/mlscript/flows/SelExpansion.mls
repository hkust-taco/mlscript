module Example with
  class Test(val field: Int)
  module Test with
    fun next(self: Test) = Test(self.field + 1)
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   module Example⁰::Example¹ {
//│     fun Test⁰
//│     class Test¹::Test²(val field⁰: Int⁰{ ~> Int⁰ }) {
//│       val field¹::field² ‹flow:field⁰› = field⁰
//│     },
//│     module Test¹::Test³ {
//│       fun next⁰::next¹(self²: ⟨Example¹.⟩Test¹) ‹flow:next⁰› = ⟨Example¹.⟩Test¹(+(self².field¹, 1)‹app¹⁷›)‹app¹⁸›
//│     }
//│   }
//│ where
//│     field⁰  <~  type Int
//│     field⁰  ->  flow:field⁰
//│     self²  <~  type Test
//│     flow:field⁰  <~  type Int
//│     flow:next⁰  <~  ((type Test) -> app¹⁸)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let e = new Example.Test(123)
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   let e⁰,
//│   e⁰ = new Example⁰.Test¹(123)
//│ where
//│     e⁰  <~  Test(123)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ e = Test(123)

