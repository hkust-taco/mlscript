fun id(x) = x
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   fun id⁰::id¹(x¹) ‹flow:id⁰› = x¹
//│ where
//│     flow:id⁰  <~  ((x¹) -> x¹)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

id(f).foo
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   id⁰{ ~> id⁰ }(f⁰)‹app¹›.Foo⁰.foo⁰{ ~> Foo⁰.foo⁰(id⁰(f⁰)‹app¹›)‹app²› }
//│ where
//│     f⁰  <~  Foo()
//│     f⁰  ~>  {a: ⋅a⁰}  {a: ⋅a¹}  {foo: ⋅foo⁰}
//│     f⁰  ->  x¹
//│     app¹  <~  Foo()
//│     app¹  ~>  {foo: ⋅foo¹}
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 123


