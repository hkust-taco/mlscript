:js
:flow
// :df

:global
:sf


class Foo with
  val a = 123
module Foo with
  fun foo(x: Foo) = x.a
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   class Foo⁰::Foo¹ {
//│     val a⁰::a¹ ‹flow:a⁰› = 123
//│   },
//│   module Foo⁰::Foo² {
//│     fun foo⁰::foo¹(x⁰: Foo⁰{ ~> Foo⁰ }) ‹flow:foo⁰› = x⁰.aˀˀˀ{ ~> x⁰.a⁰ }
//│   }
//│ where
//│     x⁰  <~  type Foo
//│     flow:a⁰  <~  123
//│     flow:foo⁰  <~  ((type Foo) -> flow:a⁰)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let f = new Foo()
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   let f⁰,
//│   f⁰ = new Foo⁰()
//│ where
//│     f⁰  <~  Foo()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f = Foo { a: 123 }

f.a
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   f⁰.a⁰
//│ where
//│     
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 123

:e
:re
f.a.b
