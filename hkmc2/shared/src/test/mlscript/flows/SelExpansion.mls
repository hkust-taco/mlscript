module AA with
  module BB with
    class CC with
      val x: Int = 1
    module CC with
      fun getX(self: CC) = self.x
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   module AA⁰::AA¹ {
//│     module BB⁰::BB¹ {
//│       class CC⁰::CC¹ {
//│         val x⁴::x⁵: Int⁰{ ~> Int⁰ } ‹flow:x⁰› = 1
//│       },
//│       module CC⁰::CC² {
//│         fun getX⁰::getX¹(self⁰: ⟨BB¹.⟩CC⁰) ‹flow:getX⁰› = self⁰.xˀˀˀ{ ~> self⁰.x⁴ }
//│       }
//│     }
//│   }
//│ where
//│     self⁰  <~  type CC
//│     flow:x⁰  <~  1
//│     flow:getX⁰  <~  ((type CC) -> flow:x⁰)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sjs
new AA.BB.CC().x
