class CC(val x: Int)
module CC with
  fun getX(self: CC) = self.x
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   fun CC³
//│   class CC⁴::CC⁵(val x⁶: Int⁰{ ~> Int⁰ }) {
//│     val x⁷::x⁸ ‹flow:x¹› = x⁶
//│   },
//│   module CC⁴::CC⁶ {
//│     fun getX²::getX³(self¹: CC⁴{ ~> CC⁴ }) ‹flow:getX¹› = self¹.xˀˀˀ{ ~> self¹.x⁷ }
//│   }
//│ where
//│     x⁶  <~  type Int
//│     x⁶  ->  flow:x¹
//│     self¹  <~  type CC
//│     flow:x¹  <~  type Int
//│     flow:getX¹  <~  ((type CC) -> flow:x¹)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:fixme // TODO: handle lifted class defs: the JS is missing the `.class` access to get the static member `CC2.class.getX`
CC(123).getX
