:js

class A with
  fun b = new A
  fun c = (x, y) => new A
module A with
  fun a = new A

:flow
:sf
fun f(x : A) = x
f(.a)
//│ Flowed:
//│   fun f⁰(x⁰: A⁰) ‹flow:f⁰› = x⁰,
//│   f⁰(_?_.a{ ~> A⁰.a⁰ })‹app⁰›
//│ where
//│     x⁰  <~  type A
//│     x⁰  ->  app⁰
//│     app⁰  <~  type A
//│     flow:f⁰  <~  ((type A) -> x⁰)
//│     flow:f⁰  ~>  ((_?_.Ident(a)) -> app⁰)
//│ = A

:flow
:sf
f(.a.b)
//│ Flowed:
//│   f⁰(A⁰.a⁰.b⁰)‹app¹›
//│ where
//│     app¹  <~  type A
//│ = A

class C
module C with
  fun a = new C

:flow
:sf
:e
fun g(x : C) = x
let d = .a
f(d)
g(d)
//│ ╔══[ERROR] Ambiguous leading dot selection
