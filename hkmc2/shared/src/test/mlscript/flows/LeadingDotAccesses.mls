:js
:flow

class A with
  fun b = new A
  fun c = (x, y) => new A
module A with
  fun a = new A

:sf
fun f(x : A) = x
f(.a)
//│ Flowed:
//│   fun f⁰(x⁰: A⁰) ‹flow:f⁰› = x⁰,
//│   f⁰(_?_.a{ ~> A⁰.a⁰ })‹app⁰›
//│ where
//│     x⁰  <~  type A
//│     x⁰  ->  app⁰
//│     app⁰  <~  type A
//│     flow:f⁰  <~  ((type A) -> x⁰)
//│     flow:f⁰  ~>  ((lds⁰) -> app⁰)
//│ = A

:sf
f(.a.b.c(1,1).b.b)
//│ Flowed:
//│   f⁰(A⁰.a⁰.b⁰.c⁰(1, 1)‹app¹›.b⁰.b⁰)‹app²›
//│ where
//│     app²  <~  type A
//│ = A

