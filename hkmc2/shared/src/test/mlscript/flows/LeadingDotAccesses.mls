:js
:flow

class A with
  fun b = new A
  fun c = (x) => new A
module A with
  fun a = new A
fun f(x : A) = x

:sf
f(.a)
//│ Flowed:
//│   f⁰(_?_.a{ ~> A⁰.a⁰ })‹app⁰›
//│ where
//│     app⁰  <~  type A
//│ = A

:sf
f(.a.b)
//│ Flowed:
//│   f⁰(A⁰.a⁰.b⁰)‹app¹›
//│ where
//│     app¹  <~  type A
//│ = A

:sf
f(.a.c(1).b.c(4))
//│ Flowed:
//│   f⁰(A⁰.a⁰.c⁰(1)‹app²›.b⁰.c⁰(4)‹app³›)‹app⁴›
//│ where
//│     app⁴  <~  type A
//│     app³  <~  A
//│     app³  ->  bind⁰
//│ = A

