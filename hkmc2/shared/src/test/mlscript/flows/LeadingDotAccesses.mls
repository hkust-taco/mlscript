:js
:flow

class A with
  fun b = new A
  fun c = (x) => new A
module A with
  fun a = new A
fun f(x : A) = x

:sf
f(.a)
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   f⁰{ ~> f⁰ }(_?_.a{ ~> A⁰.a⁰ })‹app⁰›
//│ where
//│     app⁰  <~  type A
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = A

:sf
f(.a.b)
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   f⁰{ ~> f⁰ }(A⁰.a⁰.b⁰)‹app¹›
//│ where
//│     app¹  <~  type A
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = A

:sf
let z = .a
f(z)
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   let z⁰,
//│   z⁰ = _?_.a{ ~> A⁰.a⁰ },
//│   f⁰{ ~> f⁰ }(z⁰)‹app²›
//│ where
//│     z⁰  <~  _?_.A⁰.a⁰
//│     z⁰  ~>  type A
//│     app²  <~  type A
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = A
//│ z = A

:sf
let z = .a.b.c(3)
f(z).c(4).b
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   let z¹,
//│   z¹ = A⁰.a⁰.b⁰.c⁰(3)‹app³›,
//│   f⁰(z¹)‹app⁴›.c⁰(4)‹app⁵›.b⁰
//│ where
//│     z¹  <~  _?_.A⁰.a⁰
//│     z¹  ~>  type A
//│     app³  <~  A
//│     app³  ->  bind⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = A
//│ z = A

:sf
f(.a.c(1).b.c(4))
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
