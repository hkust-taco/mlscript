:js
:flow

class A with
  fun b = new A
  fun c = (x, y) => new A
module A with
  fun a = new A
fun f(x : A) = x

:sf
f(.a)
//│ Flowed:
//│   f⁰(_?_.a{ ~> A⁰.a⁰ })‹app⁰›
//│ where
//│     app⁰  <~  type A
//│ = A

:sf
f(.a.b)
//│ Flowed:
//│   f⁰(A⁰.a⁰.b⁰)‹app¹›
//│ where
//│     app¹  <~  type A
//│ = A

:sf
f(.a.b.c(1,1).b.b)
//│ Flowed:
//│   f⁰(A⁰.a⁰.b⁰.c⁰(1, 1)‹app²›.b⁰.b⁰)‹app³›
//│ where
//│     app³  <~  type A
//│ = A

