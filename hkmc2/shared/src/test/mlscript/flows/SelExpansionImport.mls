:js
:flow
// :df

:global
:sf


import "../../mlscript-compile/Example.mls"
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   import ".../Example.mjs" as Example⁰
//│ where
//│     
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


let e = new Example.Test(123)
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   let e⁰,
//│   e⁰ = new Example⁰.Test⁰(123)
//│ where
//│     e⁰  <~  Test(123)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ e = Test(123)

e.field
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   e⁰.field⁰{ ~> e⁰.field⁰ }
//│ where
//│     e⁰  <~  Test(123)
//│     e⁰  ~>  {field: ⋅field⁰}
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 123

// Recover the imported companion module, including its class overload.
:expect Test(124)
e.next
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   e⁰.Example⁰.Test⁰.next⁰{ ~> Example⁰.Test⁰.next⁰(e⁰)‹app⁰› }
//│ where
//│     e⁰  <~  Test(123)
//│     e⁰  ~>  {field: ⋅field⁰}  {next: ⋅next⁰}
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = Test(124)


open Example
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   
//│ where
//│     
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let e = new Test(123)
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   let e¹,
//│   e¹ = new ⟨Example⁰.⟩Test⁰(123)
//│ where
//│     e¹  <~  Test(123)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ e = Test(123)

// Recover the imported companion module, including its class overload.
:expect Test(124)
e.next
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   e¹.Example⁰.Test⁰.next⁰{ ~> Example⁰.Test⁰.next⁰(e¹)‹app¹› }
//│ where
//│     e¹  <~  Test(123)
//│     e¹  ~>  {next: ⋅next¹}
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = Test(124)



