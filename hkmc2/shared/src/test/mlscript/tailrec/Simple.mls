@tailrec
fun f() = f()

module Foo with
  @tailrec
  fun bar() = bar()

fun f(x) = f(x + 1)

:sjs
fun f(x) = f(f(x) + 1)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
