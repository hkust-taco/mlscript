:sjs
:expect 200010000
module A with
  fun sum_impl(n, acc) = if n == 0 then acc else @tailcall sum_impl(n - 1, n + acc)
  fun sum(n) = sum_impl(n, 0)
A.sum(20000)
//│ JS (unsanitized):
//│ let A1;
//│ (class A {
//│   static {
//│     A1 = this
//│   }
//│   constructor() {
//│     runtime.Unit;
//│   }
//│   static sum_impl(n, acc) {
//│     loopLabel: while (true) {
//│       let scrut, tmp, tmp1;
//│       scrut = Predef.equals(n, 0);
