:silent
:lift
:expect 200010000
val x = mut []
let n = 20000
let i = 0
while i < n do
  x.push of () => i
  set i += 1
fun sumOf(x, idx, acc) =
  if idx == 0 then acc
  else 
    sumOf(x, idx - 1, acc + x![idx]())
sumOf(x, n - 1, 0)

// Check that spreads, where supported, are compiled correctly
fun f(x, ...z) =
  if x < 0 then 0
  else g(x, 0, x, x)
fun g(x, y, ...z) =
  if x < 0 then 0
  else f(x - 1, 0, ...[x, x, x])
f(100)
