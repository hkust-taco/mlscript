//│         tmp1 = n + acc;
//│         n = tmp;
//│         acc = tmp1;
//│         continue loopLabel
//│       }
//│       break;
//│     }
//│   } 
//│   static sum(n) {
//│     return A.sum_impl(n, 0)
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "A"]; 
//│ });
//│ A1.sum(20000)
//│ = 200010000

:silent
:lift
:rewriteWhile
:expect 200010000
val x = mut []
let n = 20000
let i = 0
while i < n do
  x.push of () => i
  set i += 1
fun sumOf(x, idx, acc) =
  if idx == 0 then acc
  else 
    sumOf(x, idx - 1, acc + x![idx]())
sumOf(x, n - 1, 0)

// Check that spreads, where supported, are compiled correctly
fun f(x, ...z) =
  if x < 0 then 0
  else g(x, 0, x, x)
fun g(x, y, ...z) =
  if x < 0 then 0
  else f(x - 1, 0, ...[x, x, x])
f(100)
//│ = 0

:fixme
fun f(x, y, z) = @tailcall f(...[1, 2, 3])
//│ ═══[ERROR] Spreads are not yet fully supported in calls marked @tailcall.

:fixme
fun f(x, ...y) =
  if x < 0 then g(0, 0, 0)
  else 0
fun g(x, y, z) =
  @tailcall f(...[1, 1, 2])
g(0, 0, 0)
//│ ═══[ERROR] Spreads are not yet fully supported in calls marked @tailcall.
//│ = 0

:e
:lift
fun f(x) =
  fun g() =
    @tailcall f(x)
    @tailcall f(x)
  @tailcall g()
//│ ╔══[ERROR] This call is not in tail position.
//│ ║  l.147: 	    @tailcall f(x)
//│ ╙──       	              ^^^^

:lift
fun f(x) =
  fun g() =
    @tailcall f(x)
  @tailcall g()

// Functions inside module definitions are lifted to the top level. This means they cannot yet be optimized.
:lift
:fixme
module A with
  fun f(x) =
    fun g(x) = if x < 0 then 0 else @tailcall f(x)
    @tailcall g(x - 1)
A.f(10000)
//│ ╔══[ERROR] This tail call exits the current scope and is not optimized.
//│ ║  l.165: 	    fun g(x) = if x < 0 then 0 else @tailcall f(x)
//│ ╙──       	                                              ^^^^
//│ ╔══[ERROR] This tail call exits the current scope and is not optimized.
//│ ║  l.166: 	    @tailcall g(x - 1)
//│ ╙──       	              ^^^^^^^^
//│ ═══[RUNTIME ERROR] RangeError: Maximum call stack size exceeded

// These calls are represented as field selections and don't yet have the explicitTailCall parameter.
:breakme
:e
module A with
  fun f = g
  fun g =
    @tailcall f
    f

:expect 0
module A with
  fun f(x) = if x == 0 then 0 else @tailcall g(x - 1)
  fun g(x) = if x == 0 then 1 else @tailcall f(x - 1)
A.f(10)
//│ = 0

