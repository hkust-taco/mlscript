:js

:expect 200010000
fun sum_impl(n, acc) = if n == 0 then acc else sum_impl(n - 1, n + acc)
fun sum(n) = sum_impl(n, 0)
sum(20000)
//│ = 200010000

:sjs
:expect 50000
fun g(a, b, c, d) = f(a, b, c + d)
fun f(a, b, c) =
  if 
    a > 0 then g(a - 1, b, c, 1)
    b > 0 then g(a, b - 1, c, 2)
    else c
f(10000, 20000, 0)
