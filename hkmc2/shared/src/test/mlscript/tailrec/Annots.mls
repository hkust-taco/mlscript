:js
open annotations


:w
@tailrec
fun f
//│ ═══[WARNING] Only functions with a body may be marked as @tailrec.

:w
@tailrec
class A
//│ ═══[WARNING] This annotation has no effect.

:w
@tailrec 2 + 2
//│ ╔══[WARNING] This annotation has no effect.
//│ ╟── This annotation is not supported on application terms.
//│ ║  l.16: 	@tailrec 2 + 2
//│ ╙──      	         ^^^^^
//│ = 4

@tailrec
fun f = g
fun g = f

:w
@tailcall
fun g = 2
//│ ═══[WARNING] This annotation has no effect.

fun test =
  @tailcall test

:w
let f = 0
fun test =
  @tailcall f
//│ ╔══[WARNING] This annotation has no effect.
//│ ╟── This annotation is not supported on reference terms.
//│ ║  l.38: 	  @tailcall f
//│ ╙──      	            ^
//│ f = 0

