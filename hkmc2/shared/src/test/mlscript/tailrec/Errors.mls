:js

:e
fun f(x) =
  @tailcall f(x)
  f(x)
//│ ╔══[ERROR] This call is not in tail position.
//│ ║  l.5: 	  @tailcall f(x)
//│ ╙──     	            ^^^^

:e
fun f(x) = 2
fun g(x) = @tailcall f(x)
//│ ╔══[ERROR] This call is not optimized as it does not directly recurse through its parent function.
//│ ║  l.13: 	fun g(x) = @tailcall f(x)
//│ ╙──      	                     ^^^^

:e
@tailrec fun f(x) =
  g(x)
fun g(x) = f(x); f(x)
//│ ╔══[ERROR] This function is not tail recursive.
//│ ║  l.19: 	@tailrec fun f(x) =
//│ ║        	             ^
//│ ╟── It could self-recurse through this call, which is not a tail call.
//│ ║  l.21: 	fun g(x) = f(x); f(x)
//│ ╙──      	           ^^^^

:e
@tailrec fun f(x) =
  g(x)
fun g(x) = 
  f(x)
  h(x)
fun h(x) =
  g(x)
//│ ╔══[ERROR] This function is not tail recursive.
