:e
module A with
  fun f(x) = if x == 0 then 0 else @tailcall g(x - 1)
  fun g(x) = if x == 0 then 1 else
    @tailcall f(x - 1)
    @tailcall f(x - 1)
//│ ╔══[ERROR] This call is not in tail position.
//│ ║  l.63: 	    @tailcall f(x - 1)
//│ ╙──      	              ^^^^^^^^

:w
@tailrec
fun f = 2
//│ ╔══[WARNING] This function does not directly self-recurse, but is marked @tailrec.
