:e
module A with
  fun f(x) = if x == 0 then 0 else @tailcall g(x - 1)
  fun g(x) = if x == 0 then 1 else
    @tailcall f(x - 1)
    @tailcall f(x - 1)
//│ ╔══[COMPILATION ERROR] This call is not in tail position.
//│ ║  l.64: 	    @tailcall f(x - 1)
//│ ╙──      	              ^^^^^^^^

