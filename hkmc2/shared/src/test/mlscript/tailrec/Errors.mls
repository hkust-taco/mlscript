:e
@tailrec fun f(x) =
  g(x)
fun g(x) = 
  h(x)
  f(x)
fun h(x) =
  f(x)
//│ ╔══[ERROR] This function is not tail recursive.
//│ ║  l.45: 	@tailrec fun f(x) =
//│ ║        	             ^
