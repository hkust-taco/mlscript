//│ deforest > >>> fusing >>>
//│ deforest > Some⁰(tmp⁰) ->
//│ deforest > 	match: x⁰
//│ deforest > 	fields: x⁰.x¹
//│ deforest > Some⁰(17) ->
//│ deforest > 	match: x⁰
//│ deforest > 	fields: x⁰.x¹
//│ deforest > <<< fusing <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let Some_x, fv_m, fv_scrut, fv_tmp, inlinedVal;
//│ define modSome⁰ as fun modSome¹(x, m) {
//│   loop loopLabel:
//│     let scrut, arg$Some$0$, tmp, tmp1;
//│     match x
//│       Some¹ =>
//│         set arg$Some$0$ = x.x¹;
//│         set scrut = >=⁰(arg$Some$0$, m);
//│         match scrut
//│           true =>
//│             set tmp = -⁰(arg$Some$0$, m);
//│             set tmp1 = Some⁰(tmp);
//│             set x = tmp1;
//│             continue loopLabel
//│           else
//│             return Some⁰(arg$Some$0$)
//│         end
//│       None⁰ =>
//│         return None⁰
//│       else
//│         throw new globalThis⁰.Error⁰("match error")
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ set Some_x = 17;
//│ set fv_m = 3;
//│ block inlinedLbl:
//│   loop loopLabel:
//│     set fv_scrut = >=⁰(Some_x, fv_m);
//│     match fv_scrut
//│       true =>
//│         set fv_tmp = -⁰(Some_x, fv_m);
//│         set Some_x = fv_tmp;
//│         continue loopLabel
//│       else
//│         set inlinedVal = Some⁰(Some_x);
//│         break inlinedLbl
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ return inlinedVal
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = Some(2)


:deforest
:expect Some(3)
fun maxOpt2(ls, x) = if ls is
  Nil then x
  h :: t and x is
    None then maxOpt2(t, Some(h))
    Some(m) and
      h > m then maxOpt2(t, Some(h))
      else maxOpt2(t, Some(m))
maxOpt2(id(1 :: 2 :: 3 :: Nil), None)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function maxOpt2⁰#0 @ maxOpt2² -> UnsafeEta
//│ deforest > function maxOpt2⁰#0 @ maxOpt2¹ -> UnsafeEta
//│ deforest > call >⁰@result¹ @ maxOpt2² -> Pure
//│ deforest > call >⁰@result¹ @ maxOpt2¹ -> Pure
//│ deforest > call id@result⁵ @ <root> -> UnsafeEta
//│ deforest > call maxOpt2⁰@result² @ maxOpt2² -> UnsafeEta
//│ deforest > call maxOpt2⁰@result² @ maxOpt2¹ -> UnsafeEta
//│ deforest > call maxOpt2⁰@result³ @ maxOpt2² -> UnsafeEta
//│ deforest > call maxOpt2⁰@result³ @ maxOpt2¹ -> UnsafeEta
//│ deforest > call maxOpt2⁰@result⁰ @ maxOpt2² -> UnsafeEta
//│ deforest > call maxOpt2⁰@result⁰ @ maxOpt2¹ -> UnsafeEta
//│ deforest > call maxOpt2⁰@result⁴ @ <root> -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = Some(3)

:deforest
:expect Nil
fun zipWith(xsys, f) = if xsys is
  [hx :: tx, hy :: ty] then f(hx, hy) :: zipWith([tx, ty], f)
  [Nil, Nil] then Nil
zipWith([id(Nil), id(Nil)], (x, y) => x)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function lambda⁰#0 @ lambda² -> Pure
//│ deforest > function lambda⁰#0 @ lambda¹ -> Pure
//│ deforest > function zipWith⁰#0 @ zipWith² -> UnsafeEta
