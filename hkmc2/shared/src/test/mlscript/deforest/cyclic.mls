:js

data class A(x)
data class B(x)
data object C
data object D
data class (::) Cons(h, t)
object Nil
object None
data class Some(x)



:expect 0
fun f(x) = if x is
  A(_) then f(A(2))
  else 0
f(Nil)
//│ = 0


:expect 0
fun f(x) =
  let res = if x is
    A(x) then x
  if res > 0 then f(A(res - 1)) else 0
f(A(4))
//│ = 0


:expect 0
fun f(x, b) = if x is
  Nil then if b then f(Nil, false) else 0
f(Nil, false)
//│ = 0



:deforest
fun f(a) = if a is
  C then C
  else D
(x => 0)(f(f(C)))
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function f⁰#0 @ f² -> Pure
//│ deforest > function f⁰#0 @ f³ -> Pure
//│ deforest > function f⁰#0 @ f¹ -> Pure
//│ deforest > function lambda⁰#0 @ lambda² -> Pure
//│ deforest > function lambda⁰#0 @ lambda¹ -> Pure
//│ deforest > call f⁰@result² @ <root> -> Pure
//│ deforest > call f⁰@result¹ @ <root> -> Pure
//│ deforest > call lambda⁰@result⁰ @ <root> -> Pure
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > C⁰ ->
//│ deforest > 	match: a⁰
//│ deforest > C⁰ ->
//│ deforest > 	match: a⁰
//│ deforest > D⁰ ->
//│ deforest > 	match: a⁰
//│ deforest > <<< fusing <<<
//│ = 0


:deforest
:expect Some(2)
fun maxOpt(ls) = if ls is
  Nil then None
  h :: t then
    if maxOpt(t) is
      None then Some(h)
      Some(m) then if m > h then Some(m) else Some(h)
maxOpt(id(1 :: 2 :: Nil))
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function maxOpt⁰#0 @ maxOpt² -> UnsafeEta
//│ deforest > function maxOpt⁰#0 @ maxOpt¹ -> UnsafeEta
//│ deforest > call >⁰@result¹ @ maxOpt² -> Pure
//│ deforest > call >⁰@result¹ @ maxOpt¹ -> Pure
//│ deforest > call id@result³ @ <root> -> UnsafeEta
//│ deforest > call maxOpt⁰@result² @ <root> -> UnsafeEta
//│ deforest > call maxOpt⁰@result⁰ @ maxOpt² -> UnsafeEta
//│ deforest > call maxOpt⁰@result⁰ @ maxOpt¹ -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = Some(2)


:deforest
:soir
:expect Some(2)
fun modSome(x, m) = if x is
  Some(n) and
    n >= m then modSome(Some(n - m), m)
    else Some(n)
  None then None
modSome(Some(17), 3)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function modSome⁰#0 @ modSome² -> UnsafeEta
//│ deforest > function modSome⁰#0 @ modSome¹ -> UnsafeEta
//│ deforest > call -⁰@result¹ @ modSome² -> Pure
//│ deforest > call -⁰@result¹ @ modSome¹ -> Pure
