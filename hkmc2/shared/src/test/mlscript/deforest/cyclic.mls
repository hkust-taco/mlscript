//│ deforest > Ref(member:C,Some(object:C)) ->
//│ deforest > 	Ref(a,None)
//│ deforest > Ref(member:C,Some(object:C)) ->
//│ deforest > 	Ref(a,None)
//│ deforest > Ref(member:D,Some(object:D)) ->
//│ deforest > 	Ref(a,None)
//│ deforest > Ref(member:C,Some(object:C)) ->
//│ deforest > 	Ref(a,None)
//│ deforest > <<< fusing <<<
//│ = fun test_4$test


:deforest
:expect Some(2)
fun maxOpt(ls) = if ls is
  Nil then None
  h :: t then
    if maxOpt(t) is
      None then Some(h)
      Some(m) then if m > h then Some(m) else Some(h)
maxOpt(id(1 :: 2 :: Nil))
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = Some(2)


:deforest
:sir
:expect Some(2)
fun modSome(x, m) = if x is
  Some(n) and
    n >= m then modSome(Some(n - m), m)
    else Some(n)
  None then None
modSome(Some(17), 3)
