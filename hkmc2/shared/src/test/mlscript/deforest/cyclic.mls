:deforest
:expect Some(3)
fun maxOpt2(ls, x) = if ls is
  Nil then x
  h :: t and x is
    None then maxOpt2(t, Some(h))
    Some(m) and
      h > m then maxOpt2(t, Some(h))
      else maxOpt2(t, Some(m))
maxOpt2(id(1 :: 2 :: 3 :: Nil), None)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = Some(3)

:deforest
:expect Nil
fun zipWith(xsys, f) = if xsys is
  [hx :: tx, hy :: ty] then f(hx, hy) :: zipWith([tx, ty], f)
  [Nil, Nil] then Nil
zipWith([id(Nil), id(Nil)], (x, y) => x)
//│ deforest > >>> fusing >>>
//│ deforest > Tuple(false,List(Arg(None,Ref(tx,None)), Arg(None,Ref(ty,None)))) ->
//│ deforest > 	Ref(xsys,None)
//│ deforest > 	Call(Select(Select(Ref(tmp:runtime,None),Ident(Tuple)),Ident(get)),List(Arg(None,Ref(xsys,None)), Arg(None,Lit(IntLit(0)))))
//│ deforest > 	Call(Select(Select(Ref(tmp:runtime,None),Ident(Tuple)),Ident(get)),List(Arg(None,Ref(xsys,None)), Arg(None,Lit(IntLit(1)))))
//│ deforest > Tuple(false,List(Arg(None,Ref(tmp:tmp,None)), Arg(None,Ref(tmp:tmp,None)))) ->
//│ deforest > 	Ref(xsys,None)
//│ deforest > 	Call(Select(Select(Ref(tmp:runtime,None),Ident(Tuple)),Ident(get)),List(Arg(None,Ref(xsys,None)), Arg(None,Lit(IntLit(0)))))
//│ deforest > 	Call(Select(Select(Ref(tmp:runtime,None),Ident(Tuple)),Ident(get)),List(Arg(None,Ref(xsys,None)), Arg(None,Lit(IntLit(1)))))
//│ deforest > <<< fusing <<<
//│ = Nil
