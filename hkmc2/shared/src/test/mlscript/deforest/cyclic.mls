//│ deforest > Call(Ref(member:Some,Some((Fun)term:class:Some.Some)),List(Arg(None,Ref(var:h,None)))) ->
//│ deforest > 	Ref($scrut,None)
//│ deforest > 	Select(Ref($scrut,None),Ident(x))
//│ deforest > Call(Ref(member:Some,Some((Fun)term:class:Some.Some)),List(Arg(None,Ref(var:h,None)))) ->
//│ deforest > 	Ref($scrut,None)
//│ deforest > 	Select(Ref($scrut,None),Ident(x))
//│ deforest > Ref(member:None,Some(object:None)) ->
//│ deforest > 	Ref($scrut,None)
//│ deforest > ========
//│ deforest > free vars of Ref($scrut,None):
//│ deforest > 	List(var:h)


