:deforest
:expect Some(3)
fun maxOpt2(ls, x) = if ls is
  Nil then x
  h :: t and x is
    None then maxOpt2(t, Some(h))
    Some(m) and
      h > m then maxOpt2(t, Some(h))
      else maxOpt2(t, Some(m))
maxOpt2(id(1 :: 2 :: 3 :: Nil), None)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = Some(3)

:deforest
:expect Nil
fun zipWith(xsys, f) = if xsys is
  [hx :: tx, hy :: ty] then f(hx, hy) :: zipWith([tx, ty], f)
  [Nil, Nil] then Nil
zipWith([id(Nil), id(Nil)], (x, y) => x)
//│ deforest > >>> fusing >>>
//│ deforest > [tx⁰, ty⁰] ->
//│ deforest > 	match: xsys⁰
//│ deforest > 	fields: runtime⁰.Tuple﹖.get⁰(xsys⁰, 0)
//│ deforest > 	fields: runtime⁰.Tuple﹖.get⁰(xsys⁰, 1)
//│ deforest > [tmp¹, tmp²] ->
//│ deforest > 	match: xsys⁰
//│ deforest > 	fields: runtime⁰.Tuple﹖.get⁰(xsys⁰, 0)
//│ deforest > 	fields: runtime⁰.Tuple﹖.get⁰(xsys⁰, 1)
//│ deforest > <<< fusing <<<
//│ = Nil
