:js

data class A(x)
data class B(x)
data object C
data object D
data class (::) Cons(h, t)
object Nil
object None
data class Some(x)






:deforest
fun test() =
  fun f(a) = if a is
    C then C
    else D
  (x => 0)(f(f(C)))
test
