:js

data class A(x)
data class B(x)
data object C
data object D
data class (::) Cons(h, t)
object Nil
object None
data class Some(x)



:expect 0
fun f(x) = if x is
  A(_) then f(A(2))
  else 0
f(Nil)
//│ = 0


:expect 0
fun f(x) =
  let res = if x is
    A(x) then x
  if res > 0 then f(A(res - 1)) else 0
f(A(4))
//│ = 0


:expect 0
fun f(x, b) = if x is
  Nil then if b then f(Nil, false) else 0
f(Nil, false)
//│ = 0



:deforest
fun f(a) = if a is
  C then C
  else D
(x => 0)(f(f(C)))
//│ deforest > >>> fusing >>>
//│ deforest > C⁰ ->
//│ deforest > 	match: a⁰
//│ deforest > D⁰ ->
//│ deforest > 	match: a⁰
//│ deforest > C⁰ ->
//│ deforest > 	match: a⁰
//│ deforest > <<< fusing <<<
//│ = 0


:deforest
:expect Some(2)
fun maxOpt(ls) = if ls is
  Nil then None
  h :: t then
    if maxOpt(t) is
      None then Some(h)
      Some(m) then if m > h then Some(m) else Some(h)
maxOpt(id(1 :: 2 :: Nil))
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = Some(2)


:deforest
:sir
:expect Some(2)
fun modSome(x, m) = if x is
  Some(n) and
    n >= m then modSome(Some(n - m), m)
    else Some(n)
  None then None
modSome(Some(17), 3)
