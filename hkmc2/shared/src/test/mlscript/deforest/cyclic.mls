:js

data class A(x)
data class B(x)
data object C
data object D
data class (::) Cons(h, t)
object Nil
object None
data class Some(x)






:deforest
fun test() =
  fun f(a) = if a is
    C then C
    else D
  (x => 0)(f(f(C)))
test
//│ deforest > ==============
//│ deforest > Ref(member:C,Some(object:C)) ->
//│ deforest > 	Ref(var:a,None)
//│ deforest > Ref(member:C,Some(object:C)) ->
//│ deforest > 	Ref(var:a,None)
//│ deforest > Ref(member:D,Some(object:D)) ->
//│ deforest > 	Ref(var:a,None)
//│ deforest > ========
//│ deforest > free vars of Ref(var:a,None):
//│ deforest > 	List()
//│ = fun test_4$test


:deforest
fun maxOpt(ls) = if ls is
  Nil then None
  h :: t then
    if maxOpt(t) is
      None then Some(h)
      Some(m) then if m > h then Some(m) else Some(h)
drop maxOpt(id(1 :: 2 :: Nil))
//│ deforest > ==============
//│ deforest > Call(Ref(member:Some,Some((Fun)term:class:Some.Some)),List(Arg(None,Ref(var:m,None)))) ->
