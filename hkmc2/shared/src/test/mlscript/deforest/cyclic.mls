//│ = fun test_4$test


:deforest
:expect Some(2)
fun maxOpt(ls) = if ls is
  Nil then None
  h :: t then
    if maxOpt(t) is
      None then Some(h)
      Some(m) then if m > h then Some(m) else Some(h)
maxOpt(id(1 :: 2 :: Nil))
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = Some(2)


