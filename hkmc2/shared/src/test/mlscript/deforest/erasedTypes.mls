// A cast proven to be safe by flow is removed if any of its sources is fused,
// as the closure replacing it would fail the check.
// and the slots that both the fused and unfused sources flow into are retyped to admit both (test_g$g returns Object)
:deforest
:expect 1
private fun cons(x) = if x is Box(v) then v
private fun g(x: Object): Box = x
private fun test(c, d) =
  let fused = Box(0)
  let notFused = Box(1)
  if c then cons(fused)
  else
    g(if d then fused else notFused)
    1
test(false, true)
