// `a.AA#x` has no concrete lower bound and doesn't block fusion, and it flows into a slot
// retyped by fusion from A to Function. As `a.AA#x` has type A, unrelated to Function, it can never be produced:
// as it is pure, it is dropped, and `undefined` is passed in its place
:expect 0
object A
data class AA(x: A)
private fun f(a, b) = if a is AA then f(a, a.AA#x) else if b is A then 0
f(A, A)
