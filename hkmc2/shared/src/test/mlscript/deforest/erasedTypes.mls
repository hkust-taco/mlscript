:.
:sir
:siret
:deforest
:lift

//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ import "..." as Predef; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// Deforestation extracts a fusing match's branches and continuation into new functions, renaming the symbols
// that cross into them. A rename stands for the same slot as the symbol it replaces, so it takes that
// symbol's erased type.

data class Box(v: Int)
data class Pair(a: Int, b: Str)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @data
//│ define Box⁰ as class Box² {
//│   val v⁰: Int⁰;
//│   constructor Box¹(v: Int⁰) {
//│     define v⁰ as val v¹: Int⁰ = v;
//│     end
//│   }
//│ };
//│ @data
//│ define Pair⁰ as class Pair² {
//│   val a⁰: Int⁰;
//│   val b⁰: Str⁰;
//│   constructor Pair¹(a: Int⁰, b: Str⁰) {
//│     define a⁰ as val a¹: Int⁰ = a;
//│     define b⁰ as val b¹: Str⁰ = b;
//│     end
//│   }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// A fused field selection is replaced by a symbol standing for the constructor argument (`Box_v`), which is both
// the temporary the caller assigns and the branch function's parameter. The IR already typed the selection it
// replaces as the field's type, so both take that type.
// The branch function's free variables become its second parameter list (`fv_k`), typed from the locals they
// stand for.
fun selected(n: Int, k: Str) =
  let b = Box(n)
  if b is
    Box(x) then [x, k]
//│ deforest > >>> fusing >>>
//│ deforest > Box¹(n⁰) ->
//│ deforest > 	match: b²
//│ deforest > 	fields: b².v¹
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let selected$b_Box, selected$b_rest;
//│ @affine(1) @private
//│ define selected$b_Box as fun selected$b_Box⁰(Box_v: Int⁰)(fv_arg$Box$0$: ?, fv_x: Int⁰, fv_k: Str⁰): ? {
//│   set fv_arg$Box$0$ = Box_v;
//│   set fv_x = fv_arg$Box$0$;
//│   return [fv_x, fv_k]
//│ };
//│ @private
//│ define selected$b_rest as fun selected$b_rest⁰(): ? {
//│   return null
//│ };
//│ define selected⁰ as fun selected¹(n: Int⁰, k: Str⁰): Array⁰ {
//│   let x: Int⁰, arg$Box$0$: ?, b: Function⁰, Box_v: Int⁰;
//│   set Box_v = n;
//│   set b = selected$b_Box⁰(Box_v);
//│   return (b(arg$Box$0$, x, k) as! Array⁰)
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// The code following the match becomes a separate continuation function, whose free variables are typed the
// same way - `fv_k` is a `Str` in both the branch function and the rest function.
fun withRest(n: Int, k: Str) =
  let b = Box(n)
  let r = if b is
    Box(x) then x
    else 0
  [r, k]
//│ deforest > >>> fusing >>>
//│ deforest > Box¹(n¹) ->
//│ deforest > 	match: b³
//│ deforest > 	fields: b³.v¹
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let withRest$b_Box, withRest$b_rest;
//│ @affine(1) @private
//│ define withRest$b_Box as fun withRest$b_Box⁰(Box_v: Int⁰)(fv_arg$Box$0$: ?, fv_x: Int⁰, fv_tmp: Int⁰, fv_r: Int⁰, fv_k: Str⁰): ? {
//│   set fv_arg$Box$0$ = Box_v;
//│   set fv_x = fv_arg$Box$0$;
//│   set fv_tmp = fv_x;
//│   return withRest$b_rest⁰(fv_r, fv_tmp, fv_k)
//│ };
//│ @private
//│ define withRest$b_rest as fun withRest$b_rest⁰(fv_r: Int⁰, fv_tmp: Int⁰, fv_k: Str⁰): ? {
//│   set fv_r = fv_tmp;
//│   return [fv_r, fv_k]
//│ };
//│ define withRest⁰ as fun withRest¹(n: Int⁰, k: Str⁰): Array⁰ {
//│   let r: Int⁰, x: Int⁰, arg$Box$0$: ?, tmp: Int⁰, b: Function⁰, Box_v: Int⁰;
//│   set Box_v = n;
//│   set b = withRest$b_Box⁰(Box_v);
//│   return (b(arg$Box$0$, x, tmp, r, k) as! Array⁰)
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// A constructor field that no branch selects still becomes a parameter, so that the branch function takes the
// complete constructor argument list. These placeholders are typed from the field they stand for.
fun noFields(n: Int, s: Str) =
  let p = Pair(n, s)
  if p is
    Pair then 1
//│ deforest > >>> fusing >>>
//│ deforest > Pair¹(n², s⁰) ->
//│ deforest > 	match: p⁰
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let noFields$p_Pair, noFields$p_rest;
//│ @affine(1) @private
//│ define noFields$p_Pair as fun noFields$p_Pair⁰(_a: Int⁰, _b: Str⁰)(): ? {
//│   return 1
//│ };
//│ @private
//│ define noFields$p_rest as fun noFields$p_rest⁰(): ? {
//│   return null
//│ };
//│ define noFields⁰ as fun noFields¹(n: Int⁰, s: Str⁰): Int⁰ {
//│   let p: Function⁰, Pair_a: Int⁰, Pair_b: Str⁰;
//│   set Pair_a = n;
//│   set Pair_b = s;
//│   set p = noFields$p_Pair⁰(Pair_a, Pair_b);
//│   return (p() as! Int⁰)
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// Fusion changes the physical parameter and result slots even without making a polyvariant copy.
:deforest mono
:expect 42
private fun produce(n: Int): Box = if n == 0 then Box(42) else produce(n - 1)
private fun consume(box: Box): Int = if box is Box(value) then value
consume(produce(2))
//│ deforest > >>> fusing >>>
//│ deforest > Box¹(42) ->
//│ deforest > 	match: box⁰
//│ deforest > 	fields: box⁰.v¹
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let $box_Box, $box_rest, tmp: Function⁰;
//│ @affine(1) @private
//│ define $box_Box as fun $box_Box⁰(Box_v: Int⁰)(fv_arg$Box$0$: ?, fv_value: Int⁰): ? {
//│   set fv_arg$Box$0$ = Box_v;
//│   set fv_value = fv_arg$Box$0$;
//│   return fv_value
//│ };
//│ @private
//│ define $box_rest as fun $box_rest⁰(): ? {
//│   return null
//│ };
//│ @private
//│ define produce⁰ as fun produce¹(n: Int⁰): Function⁰ {
//│   let scrut: ?, tmp1: Int⁰;
//│   set scrut = Predef⁰.equals⁰(n, 0);
//│   match scrut
//│     true =>
//│       let Box_v: Int⁰;
//│       set Box_v = 42;
//│       return $box_Box⁰(Box_v)
//│     else
//│       set tmp1 = -⁰(n, 1);
//│       return produce¹(tmp1)
//│   end
//│ };
//│ @private
//│ define consume⁰ as fun consume¹(box: Function⁰): Int⁰ {
//│   let value: Int⁰, arg$Box$0$: ?;
//│   return (box(arg$Box$0$, value) as! Int⁰)
//│ };
//│ set tmp = produce¹(2);
//│ return consume¹(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


// Projecting a fused field replaces a nominal slot by the field's representation.
:deforest mono
:expect 42
private fun pass(box: Box): Box = box
pass(Box(42)).v
//│ deforest > >>> fusing >>>
//│ deforest > Box¹(42) ->
//│ deforest > 	select: v
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Int⁰, tmp1: Int⁰, Box_v: Int⁰;
//│ @private
//│ define pass⁰ as fun pass¹(box: Int⁰): Int⁰ {
//│   return box
//│ };
//│ set Box_v = 42;
//│ set tmp = Box_v;
//│ set tmp1 = pass¹(tmp);
//│ return tmp1
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42



// The cast from a physical Any result is proved by all incoming constructors.
// Field fusion changes the result, argument, and intermediate slots to Int together.
:deforest mono
:expect 42
private fun makeOpaqueBox(): Any = Box(42)
private fun projectOpaqueBox(box: Box): Int = box.v
projectOpaqueBox(makeOpaqueBox())
//│ deforest > >>> fusing >>>
//│ deforest > Box¹(42) ->
//│ deforest > 	select: v
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Int⁰;
//│ @private
//│ define makeOpaqueBox⁰ as fun makeOpaqueBox¹(): Int⁰ {
//│   let Box_v: Int⁰;
//│   set Box_v = 42;
//│   return Box_v
//│ };
//│ @private
//│ define projectOpaqueBox⁰ as fun projectOpaqueBox¹(box: Int⁰): Int⁰ {
//│   return box
//│ };
//│ set tmp = makeOpaqueBox¹();
//│ return projectOpaqueBox¹(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


// One unknown input prevents fusion of every producer of the same cast.
:deforest mono
:expect 43
private fun mixedBox(x: Any): Int =
  val b: Box = x
  b.v
mixedBox(Box(1)) + mixedBox(hide(Box(42)))
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Box², tmp1: Int⁰, tmp2: Box², tmp3: Unknown, tmp4: Int⁰;
//│ @private
//│ define mixedBox⁰ as fun mixedBox¹(x: Unknown): Int⁰ {
//│   let b: Box²;
//│   set b = (x as! Box²);
//│   return b.v¹
//│ };
//│ set tmp = Box¹(1);
//│ set tmp1 = mixedBox¹(tmp);
//│ set tmp2 = Box¹(42);
//│ set tmp3 = Predef⁰.hide⁰(tmp2);
//│ set tmp4 = mixedBox¹(tmp3);
//│ return +⁰(tmp1, tmp4)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 43


// A fused nullary constructor becomes a closure, which its temporary and the parameter it reaches both hold.
// The call replacing the fused match returns an unknown value, which is cast into the `Int` result like the
// result of any call to a function value
:deforest mono
:expect 1
object O
private fun isO(x: O): Int = if x is O then 1 else 0
isO(O)
//│ deforest > >>> fusing >>>
//│ deforest > O⁰ ->
//│ deforest > 	match: x⁰
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let $x_O, $x_rest, deforest$lam: Function⁰;
//│ @affine(1) @private
//│ define $x_O as fun $x_O⁰()(): ? {
//│   return 1
//│ };
//│ @private
//│ define $x_rest as fun $x_rest⁰(): ? {
//│   return null
//│ };
//│ @private
//│ define isO⁰ as fun isO¹(x: Function⁰): Int⁰ {
//│   return (x() as! Int⁰)
//│ };
//│ define O¹ as object O⁰;
//│ set deforest$lam = $x_O⁰();
//│ return isO¹(deforest$lam)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1



// A field of an unfused constructor cannot be retyped per instance, so `Box(42)` stays an object: its closure
// does not fit `b: Box`
:deforest mono
:expect 42
data class H(b: Box, n: Int)
private fun get(h: H, c: Bool): Int = if c then (if h.b is Box(v) then v) else h.n
get(H(Box(42), 1), true)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Box², tmp1: H⁰;
//│ @private
//│ define get⁰ as fun get¹(h: H⁰, c: Bool⁰): Int⁰ {
//│   let scrut: ?, v: Int⁰, arg$Box$0$: ?;
//│   match c
//│     true =>
//│       set scrut = h.b⁴;
//│       match scrut
//│         Box² =>
//│           set arg$Box$0$ = scrut.v¹;
//│           set v = arg$Box$0$;
//│           return v
//│         else
//│           throw new globalThis⁰.Error⁰("match error")
//│       end
//│     else
//│       return h.n³
//│   end
//│ };
//│ @data
//│ define H¹ as class H⁰ {
//│   val b⁵: Box²;
//│   val n⁴: Int⁰;
//│   constructor H²(b: Box², n: Int⁰) {
//│     define b⁵ as val b⁴: Box² = b;
//│     define n⁴ as val n³: Int⁰ = n;
//│     end
//│   }
//│ };
//│ set tmp = Box¹(42);
//│ set tmp1 = H²(tmp, 1);
//│ return get¹(tmp1, true)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


// A field typed with the top type admits the closure of a constructor fused into a match.
:deforest mono
:expect 42
data class H(b: Any, n: Int)
private fun get(h: H, c: Bool): Int = if c then (if h.b is Box(v) then v) else h.n
get(H(Box(42), 1), true)
//│ deforest > >>> fusing >>>
//│ deforest > Box¹(42) ->
//│ deforest > 	match: scrut⁰
//│ deforest > 	fields: scrut⁰.v¹
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: H³, $scrut_Box, $scrut_rest, $c_rest, tmp1: Function⁰, Box_v: Int⁰;
//│ @affine(1) @private
//│ define $scrut_Box as fun $scrut_Box⁰(Box_v1: Int⁰)(fv_arg$Box$0$: ?, fv_v: Int⁰): ? {
//│   set fv_arg$Box$0$ = Box_v1;
//│   set fv_v = fv_arg$Box$0$;
//│   return fv_v
//│ };
//│ @private
//│ define $scrut_rest as fun $scrut_rest⁰(): ? {
//│   return $c_rest⁰()
//│ };
//│ @private
//│ define $c_rest as fun $c_rest⁰(): ? {
//│   return null
//│ };
//│ @private
//│ define get² as fun get³(h: H³, c: Bool⁰): Int⁰ {
//│   let v: Int⁰, arg$Box$0$: ?, scrut: Function⁰;
//│   match c
//│     true =>
//│       set scrut = (h.b⁶ as! Function⁰);
//│       return (scrut(arg$Box$0$, v) as! Int⁰)
//│     else
//│       return h.n⁵
//│   end
//│ };
//│ @data
//│ define H⁴ as class H³ {
//│   val b⁷: Unknown;
//│   val n⁶: Int⁰;
//│   constructor H⁵(b: Unknown, n: Int⁰) {
//│     define b⁷ as val b⁶: Unknown = b;
//│     define n⁶ as val n⁵: Int⁰ = n;
//│     end
//│   }
//│ };
//│ set Box_v = 42;
//│ set tmp1 = $scrut_Box⁰(Box_v);
//│ set tmp = H⁵(tmp1, 1);
//│ return get³(tmp, true)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42




// A fused value passing through a function whose code needs no rewriting still changes that function's types,
// so the instance it passes through gets its own copy: `idR$idR(x: Function)`
:deforest
:expect 42
private fun idpoly(x) = x
private fun get(b) = if b is Box(v) then v
get(idpoly(Box(42)))
//│ deforest > >>> fusing >>>
//│ deforest > Box¹(42) ->
//│ deforest > 	match: b⁸
//│ deforest > 	fields: b⁸.v¹
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let get$b_Box, get$b_rest, get$get, idpoly$idpoly, tmp: Function⁰, tmp1: Function⁰, Box_v: Int⁰;
//│ @private @private
//│ define get$get as fun get$get⁰(b: Function⁰): Int⁰ {
//│   let v: Int⁰, arg$Box$0$: ?;
//│   return (b(arg$Box$0$, v) as! Int⁰)
//│ };
//│ @private @private
//│ define idpoly$idpoly as fun idpoly$idpoly⁰(x: Function⁰): Function⁰ {
//│   return x
//│ };
//│ @affine(1) @private
//│ define get$b_Box as fun get$b_Box⁰(Box_v1: Int⁰)(fv_arg$Box$0$: ?, fv_v: Int⁰): ? {
//│   set fv_arg$Box$0$ = Box_v1;
//│   set fv_v = fv_arg$Box$0$;
//│   return fv_v
//│ };
//│ @private
//│ define get$b_rest as fun get$b_rest⁰(): ? {
//│   return null
//│ };
//│ @private
//│ define idpoly⁰ as fun idpoly¹(x: Box²): Box² {
//│   return x
//│ };
//│ @private
//│ define get⁴ as fun get⁵(b: Box²): Int⁰ {
//│   let v: Int⁰, arg$Box$0$: ?;
//│   match b
//│     Box² =>
//│       set arg$Box$0$ = b.v¹;
//│       set v = arg$Box$0$;
//│       return v
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ set Box_v = 42;
//│ set tmp = get$b_Box⁰(Box_v);
//│ set tmp1 = idpoly$idpoly⁰(tmp);
//│ return get$get⁰(tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42

// Each instance gets the types of what passes through it: `Function` for the match and `Int` for the selection
:deforest
:expect 43
private fun idpoly(x) = x
private fun get(b) = if b is Box(v) then v
get(idpoly(Box(42))) + idpoly(Box(1)).v
//│ deforest > >>> fusing >>>
//│ deforest > Box¹(1) ->
//│ deforest > 	select: v
//│ deforest > Box¹(42) ->
//│ deforest > 	match: b⁹
//│ deforest > 	fields: b⁹.v¹
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Int⁰, get$b_Box, get$b_rest, get$get, idpoly$idpoly, idpoly$idpoly1, tmp1: Function⁰, tmp2: Function⁰, tmp3: Int⁰, tmp4: Int⁰, Box_v: Int⁰, Box_v1: Int⁰;
//│ @private @private
//│ define get$get as fun get$get¹(b: Function⁰): Int⁰ {
//│   let v: Int⁰, arg$Box$0$: ?;
//│   return (b(arg$Box$0$, v) as! Int⁰)
//│ };
//│ @private @private
//│ define idpoly$idpoly as fun idpoly$idpoly¹(x: Function⁰): Function⁰ {
//│   return x
//│ };
//│ @private @private
//│ define idpoly$idpoly1 as fun idpoly$idpoly²(x: Int⁰): Int⁰ {
