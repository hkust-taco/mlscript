:.
:global
:sir
:siret
:deforest
:lift

//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ import "..." as Predef; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// Deforestation extracts a fusing match's branches and continuation into new functions, renaming the symbols
// that cross into them. A rename stands for the same slot as the symbol it replaces, so it takes that
// symbol's erased type.

data class Box(v: Int)
data class Pair(a: Int, b: Str)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @data
//│ define Box⁰ as class Box² {
//│   val v⁰: Int⁰;
//│   constructor Box¹(v: Int⁰) {
//│     define v⁰ as val v¹: Int⁰ = v;
//│     end
//│   }
//│ };
//│ @data
//│ define Pair⁰ as class Pair² {
//│   val a⁰: Int⁰;
//│   val b⁰: Str⁰;
//│   constructor Pair¹(a: Int⁰, b: Str⁰) {
//│     define a⁰ as val a¹: Int⁰ = a;
//│     define b⁰ as val b¹: Str⁰ = b;
//│     end
//│   }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// A fused field selection is replaced by a symbol standing for the constructor argument (`Box_v`), which is both
// the temporary the caller assigns and the branch function's parameter. The IR already typed the selection it
// replaces as the field's type, so both take that type.
// The branch function's free variables become its second parameter list (`fv_k`), typed from the locals they
// stand for.
fun selected(n: Int, k: Str) =
  let b = Box(n)
  if b is
    Box(x) then [x, k]
//│ deforest > >>> fusing >>>
//│ deforest > Box¹(n⁰) ->
//│ deforest > 	match: b²
//│ deforest > 	fields: b².v¹
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let selected$b_Box, selected$b_rest;
//│ @affine(1) @private
//│ define selected$b_Box as fun selected$b_Box⁰(Box_v: Int⁰)(fv_arg$Box$0$: ?, fv_x: Int⁰, fv_k: Str⁰): ? {
//│   set fv_arg$Box$0$ = Box_v;
//│   set fv_x = fv_arg$Box$0$;
//│   return [fv_x, fv_k]
//│ };
//│ @private
//│ define selected$b_rest as fun selected$b_rest⁰(): ? {
//│   return null
//│ };
//│ define selected⁰ as fun selected¹(n: Int⁰, k: Str⁰): Array⁰ {
//│   let x: Int⁰, arg$Box$0$: ?, b: Function⁰, Box_v: Int⁰;
//│   set Box_v = n;
//│   set b = selected$b_Box⁰(Box_v);
//│   return b(arg$Box$0$, x, k)
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// The code following the match becomes a separate continuation function, whose free variables are typed the
// same way - `fv_k` is a `Str` in both the branch function and the rest function.
fun withRest(n: Int, k: Str) =
  let b = Box(n)
  let r = if b is
    Box(x) then x
    else 0
  [r, k]
//│ deforest > >>> fusing >>>
//│ deforest > Box¹(n¹) ->
//│ deforest > 	match: b³
//│ deforest > 	fields: b³.v¹
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let withRest$b_Box, withRest$b_rest;
//│ @affine(1) @private
//│ define withRest$b_Box as fun withRest$b_Box⁰(Box_v: Int⁰)(fv_arg$Box$0$: ?, fv_x: Int⁰, fv_tmp: Int⁰, fv_r: Int⁰, fv_k: Str⁰): ? {
//│   set fv_arg$Box$0$ = Box_v;
//│   set fv_x = fv_arg$Box$0$;
//│   set fv_tmp = fv_x;
//│   return withRest$b_rest⁰(fv_r, fv_tmp, fv_k)
//│ };
//│ @private
//│ define withRest$b_rest as fun withRest$b_rest⁰(fv_r: Int⁰, fv_tmp: Int⁰, fv_k: Str⁰): ? {
//│   set fv_r = fv_tmp;
//│   return [fv_r, fv_k]
//│ };
//│ define withRest⁰ as fun withRest¹(n: Int⁰, k: Str⁰): Array⁰ {
//│   let r: Int⁰, x: Int⁰, arg$Box$0$: ?, tmp: Int⁰, b: Function⁰, Box_v: Int⁰;
//│   set Box_v = n;
//│   set b = withRest$b_Box⁰(Box_v);
//│   return b(arg$Box$0$, x, tmp, r, k)
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// A constructor field that no branch selects still becomes a parameter, so that the branch function takes the
// complete constructor argument list. These placeholders are typed from the field they stand for.
fun noFields(n: Int, s: Str) =
  let p = Pair(n, s)
  if p is
    Pair then 1
//│ deforest > >>> fusing >>>
//│ deforest > Pair¹(n², s⁰) ->
//│ deforest > 	match: p⁰
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let noFields$p_Pair, noFields$p_rest;
//│ @affine(1) @private
//│ define noFields$p_Pair as fun noFields$p_Pair⁰(_a: Int⁰, _b: Str⁰)(): ? {
//│   return 1
//│ };
//│ @private
//│ define noFields$p_rest as fun noFields$p_rest⁰(): ? {
//│   return null
//│ };
//│ define noFields⁰ as fun noFields¹(n: Int⁰, s: Str⁰): Int⁰ {
//│   let p: Function⁰, Pair_a: Int⁰, Pair_b: Str⁰;
//│   set Pair_a = n;
//│   set Pair_b = s;
//│   set p = noFields$p_Pair⁰(Pair_a, Pair_b);
//│   return p()
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// Fusion changes the physical parameter and result slots even without making a polyvariant copy.
:deforest mono
:expect 42
private fun produce(n: Int): Box = if n == 0 then Box(42) else produce(n - 1)
private fun consume(box: Box): Int = if box is Box(value) then value
consume(produce(2))
//│ deforest > >>> fusing >>>
//│ deforest > Box¹(42) ->
//│ deforest > 	match: box⁰
//│ deforest > 	fields: box⁰.v¹
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let $box_Box, $box_rest, tmp: Function⁰;
//│ @affine(1) @private
//│ define $box_Box as fun $box_Box⁰(Box_v: Int⁰)(fv_arg$Box$0$: ?, fv_value: Int⁰): ? {
//│   set fv_arg$Box$0$ = Box_v;
//│   set fv_value = fv_arg$Box$0$;
//│   return fv_value
//│ };
//│ @private
//│ define $box_rest as fun $box_rest⁰(): ? {
//│   return null
//│ };
//│ @private
//│ define produce⁰ as fun produce¹(n: Int⁰): Function⁰ {
//│   let scrut: ?, tmp1: ?;
//│   set scrut = Predef⁰.equals⁰(n, 0);
//│   match scrut
//│     true =>
//│       let Box_v: Int⁰;
//│       set Box_v = 42;
//│       return $box_Box⁰(Box_v)
//│     else
//│       set tmp1 = -⁰(n, 1);
//│       return produce¹((tmp1 as! Int⁰))
//│   end
//│ };
//│ @private
//│ define consume⁰ as fun consume¹(box: Function⁰): Int⁰ {
//│   let value: Int⁰, arg$Box$0$: ?;
//│   return box(arg$Box$0$, value)
//│ };
//│ set tmp = produce¹(2);
//│ return consume¹(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


// Projecting a fused field replaces a nominal slot by the field's representation.
:deforest mono
:expect 42
private fun pass(box: Box): Box = box
pass(Box(42)).v
//│ deforest > >>> fusing >>>
//│ deforest > Box¹(42) ->
//│ deforest > 	select: v
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Int⁰, tmp1: Int⁰, Box_v: Int⁰;
//│ @private
//│ define pass⁰ as fun pass¹(box: Int⁰): Int⁰ {
//│   return box
//│ };
//│ set Box_v = 42;
//│ set tmp = Box_v;
//│ set tmp1 = pass¹(tmp);
//│ return tmp1
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42

