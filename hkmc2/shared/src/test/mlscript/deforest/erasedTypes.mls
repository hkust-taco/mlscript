// `fail()` has no concrete lower bound but still runs (it throws), and it is returned from `g`, whose result
// is retyped by fusion from A to Function. As `fail()` has type A, unrelated to Function, it never returns:
// it is still called, and `undefined` is returned in its place
:re
object A
private fun fail(): A = throw Error("error")
private fun g(c) = if c then A else fail()
private fun f(a) = if a is A then 0 else 1
[f(g(true)), f(g(false))]
