//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 43


// A fused value passing through nested functions gets copies along the whole path: `idTwice$idTwice` calls
// its own copies of `idA`
:deforest
:expect 42
private fun idpoly(x) = x
private fun idTwice(x) = idpoly(idpoly(x))
private fun get(b) = if b is Box(v) then v
get(idTwice(Box(42)))
//│ deforest > >>> fusing >>>
//│ deforest > Box¹(42) ->
//│ deforest > 	match: b¹⁰
//│ deforest > 	fields: b¹⁰.v¹
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let get$b_Box, get$b_rest, get$get, idTwice$idTwice, idTwice_idpoly$idpoly, idTwice_idpoly$idpoly1, tmp: Function⁰, tmp1: Function⁰, Box_v: Int⁰;
//│ @private @private
//│ define get$get as fun get$get²(b: Function⁰): Int⁰ {
//│   let v: Int⁰, arg$Box$0$: ?;
//│   return (b(arg$Box$0$, v) as! Int⁰)
//│ };
//│ @private @private
//│ define idTwice$idTwice as fun idTwice$idTwice⁰(x: Function⁰): Function⁰ {
//│   let tmp2: Function⁰;
//│   set tmp2 = idTwice_idpoly$idpoly⁰(x);
//│   return idTwice_idpoly$idpoly¹(tmp2)
//│ };
//│ @private @private
//│ define idTwice_idpoly$idpoly as fun idTwice_idpoly$idpoly¹(x: Function⁰): Function⁰ {
//│   return x
