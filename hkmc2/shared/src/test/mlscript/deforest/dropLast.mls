:deforest
fun dl(ls) = if ls is
  Nil then Nil
  x :: Nil then Nil
  x :: xs then x :: dl(xs)
fun fix(x, fuel) =
  let res = dl(x)
  if fuel == 0 then res
  else
    fix(res, fuel - 1)
fix
