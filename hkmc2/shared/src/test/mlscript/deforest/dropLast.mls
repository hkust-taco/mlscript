:deforest
:expect Nil
fun dlHelper(prev, rest) = if rest is
  Nil then Nil
  h :: t then prev :: dlHelper(h, t)
fun fix(x, fuel) =
  let res = dlHelper(-1, x)
  if fuel == 0 then res
  else
    fix(res, fuel - 1)
id(fix(Nil, 1000))
