:deforest
fun dl(ls) = if ls is
  Nil then Nil
  x :: xs then dlHelper(x, xs)
fun dlHelper(prev, rest) = if rest is
  Nil then Nil
  h :: t then prev :: dlHelper(h, t)
fun fix(x, fuel) =
  let res = dl(x)
  if fuel == 0 then res
  else
    fix(res, fuel - 1)
fix
