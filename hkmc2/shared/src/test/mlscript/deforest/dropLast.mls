:js

data class (::) Cons(h, t)
data object Nil


fun lseq(l1, l2) = if
  l1 is Nil and l2 is Nil then true
  l1 is x :: xs and l2 is y :: ys and x == y then lseq(xs, ys)
  else false



:deforest
fun dl(ls) = if ls is
  Nil then Nil
  x :: Nil then Nil
  x :: xs then x :: dl(xs)
fun fix(x) =
  let res = dl(x)
  if lseq(res, x) then res
  else
    fix(res)
fix
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function dl#0 @ dl@dl -> UnsafeEta
//│ deforest > function dl#0 @ fix@fix.dl@dl -> UnsafeEta
//│ deforest > function dl#0 @ fix@fix.dl@dl -> UnsafeEta
//│ deforest > function fix#0 @ fix@fix -> UnsafeEta
//│ deforest > function fix#0 @ fix@fix -> UnsafeEta
//│ deforest > call dl@result @ dl@dl -> UnsafeEta
//│ deforest > call dl@result @ fix@fix -> UnsafeEta
//│ deforest > call dl@result @ fix@fix -> UnsafeEta
//│ deforest > call dl@result @ fix@fix.dl@dl -> UnsafeEta
//│ deforest > call dl@result @ fix@fix.dl@dl -> UnsafeEta
//│ deforest > call fix@result @ fix@fix -> UnsafeEta
//│ deforest > call fix@result @ fix@fix -> UnsafeEta
//│ deforest > call lseq@result @ fix@fix -> UnsafeEta
//│ deforest > call lseq@result @ fix@fix -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = fun fix




:deforest
fun dl(ls) = if ls is
  Nil then Nil
  x :: Nil then Nil
  x :: xs then x :: dl(xs)
fun fix(x, fuel) =
  let res = dl(x)
  if fuel == 0 then res
  else
    fix(res, fuel - 1)
fix
