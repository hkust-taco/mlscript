:deforest
:expect Nil
fun dlHelper(prev, rest) = if rest is
  Nil then Nil
  h :: t then prev :: dlHelper(h, t)
fun fix(x) =
  if x is
    Nil then Nil
    x :: xs then fix(dlHelper(x, xs))
fix(2 :: 3 :: Nil)
