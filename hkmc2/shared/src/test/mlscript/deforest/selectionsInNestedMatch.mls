:expect 12
fun c(x, y) =
  let t = if x is
    AA then
      if A is
        A then x.AA#x
  t + y
c(AA(2), 10)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function c#0 @ c@c -> UnsafeEta
//│ deforest > function c#0 @ c@c -> UnsafeEta
//│ deforest > call +@result @ c@c -> Pure
//│ deforest > call +@result @ c@c -> Pure
//│ deforest > call c@result @ <root> -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > A⁰ ->
//│ deforest > 	match: A⁰
//│ deforest > A⁰ ->
//│ deforest > 	match: A⁰
//│ deforest > AA⁰(2) ->
//│ deforest > 	match: x⁹
//│ deforest > 	fields: x⁹.x¹
//│ deforest > <<< fusing <<<
//│ = 12
