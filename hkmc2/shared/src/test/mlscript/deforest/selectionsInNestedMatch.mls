:js
:deforest

object A
object B
object C
data class AA(x)
data class BB(x)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<

object Nil
data class Cons(h, t)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<

object None
data class Some(x)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<




:expect 2
fun c(x) = if x is
  AA then
    if A is
      A then x.AA#x
c(AA(2))
//│ deforest > >>> fusing >>>
//│ deforest > A ->
//│ deforest > 	match: A
//│ deforest > A ->
//│ deforest > 	match: A
//│ deforest > AA(2) ->
//│ deforest > 	match: x
//│ deforest > 	fields: x.x1
//│ deforest > <<< fusing <<<
//│ = 2


:expect 2
fun c(x, y) = if x is
  AA then
    if y is
      A then x.AA#x
c(AA(2), A)
//│ deforest > >>> fusing >>>
//│ deforest > A ->
//│ deforest > 	match: y
//│ deforest > AA(2) ->
//│ deforest > 	match: x
//│ deforest > 	fields: x.x1
//│ deforest > <<< fusing <<<
//│ = 2



:expect 2
fun c(x, y) = if x is
  AA then
    if y is
      A then x.AA#x
fun p() = AA(2)
c(p(), A)
//│ deforest > >>> fusing >>>
//│ deforest > A ->
//│ deforest > 	match: y
//│ deforest > AA(2) ->
//│ deforest > 	match: x
//│ deforest > 	fields: x.x1
//│ deforest > <<< fusing <<<
//│ = 2




:expect 3
fun c(x, y) = if x is
  AA then
    let a = if y is
      A then 1
    a + x.AA#x
fun p() = AA(2)
c(p(), A)
//│ deforest > >>> fusing >>>
//│ deforest > A ->
//│ deforest > 	match: y
//│ deforest > AA(2) ->
//│ deforest > 	match: x
//│ deforest > 	fields: x.x1
//│ deforest > <<< fusing <<<
//│ = 3




:expect 42
fun f(x) = if x is
  AA(AA(a)) then g(a)
fun g(x) = if x is
  AA(b) then f(b)
  A then 42
f(AA(AA(AA(AA(AA(A))))))
//│ deforest > >>> fusing >>>
//│ deforest > AA(tmp) ->
//│ deforest > 	match: x
//│ deforest > 	fields: x.x1
//│ deforest > AA(tmp) ->
//│ deforest > 	match: arg$AA$0$
//│ deforest > 	fields: arg$AA$0$.x
//│ deforest > AA(tmp) ->
//│ deforest > 	match: x
//│ deforest > 	fields: x.x1
//│ deforest > AA(tmp) ->
//│ deforest > 	match: x
//│ deforest > 	fields: x.x1
//│ deforest > AA(A) ->
//│ deforest > 	match: arg$AA$0$
//│ deforest > 	fields: arg$AA$0$.x
//│ deforest > A ->
//│ deforest > 	match: x
//│ deforest > <<< fusing <<<
//│ = 42

:expect A
fun f(x) = if x is
