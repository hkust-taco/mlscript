//│ deforest > call f@result @ f@f -> UnsafeEta
//│ deforest > call f@result @ g@g -> UnsafeEta
//│ deforest > call g@result @ f@f -> UnsafeEta
//│ deforest > call g@result @ f@f -> UnsafeEta
//│ deforest > call g@result @ g@g -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > AA⁰(tmp⁰) ->
//│ deforest > 	match: x⁵
//│ deforest > 	fields: x⁵.x¹
//│ deforest > AA⁰(tmp¹) ->
//│ deforest > 	match: arg$AA$0$⁰
//│ deforest > 	fields: arg$AA$0$⁰.x¹
//│ deforest > AA⁰(tmp²) ->
//│ deforest > 	match: x⁶
//│ deforest > 	fields: x⁶.x¹
