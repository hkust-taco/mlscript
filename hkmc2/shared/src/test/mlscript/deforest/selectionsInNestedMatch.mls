:expect 2
fun c(x) = if x is
  AA then
    if A is
      A then x.AA#x
c(AA(2))
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function c#0 @ c@c -> UnsafeEta
//│ deforest > function c#0 @ c@c -> UnsafeEta
//│ deforest > call c@result @ <root> -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > A⁰ ->
//│ deforest > 	match: A⁰
//│ deforest > A⁰ ->
//│ deforest > 	match: A⁰
//│ deforest > AA⁰(2) ->
//│ deforest > 	match: x⁰
//│ deforest > 	fields: x⁰.x¹
//│ deforest > <<< fusing <<<
//│ = 2


:expect 2
fun c(x, y) = if x is
  AA then
    if y is
      A then x.AA#x
c(AA(2), A)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function c#0 @ c@c -> UnsafeEta
//│ deforest > function c#0 @ c@c -> UnsafeEta
//│ deforest > call c@result @ <root> -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > A⁰ ->
//│ deforest > 	match: y⁰
//│ deforest > AA⁰(2) ->
//│ deforest > 	match: x²
//│ deforest > 	fields: x².x¹
//│ deforest > <<< fusing <<<
//│ = 2



:expect 2
fun c(x, y) = if x is
  AA then
    if y is
      A then x.AA#x
fun p() = AA(2)
c(p(), A)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function c#0 @ c@c -> UnsafeEta
//│ deforest > function c#0 @ c@c -> UnsafeEta
