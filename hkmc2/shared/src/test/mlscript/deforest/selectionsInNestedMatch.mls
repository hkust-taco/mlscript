fun c(x) = if x is
  AA then
    if A is
      A then x.x
c(AA(2))
//│ deforest > ==============
//│ deforest > ========
//│ = 2


fun c(x, y) = if x is
  AA then
    if y is
      A then x.x
c(AA(2), A)
//│ deforest > ==============
//│ deforest > ========
//│ = 2



fun c(x, y) = if x is
  AA then
    if y is
      A then x.x
fun p() = AA(2)
c(p(), A)
//│ deforest > ==============
//│ deforest > ========
//│ = 2




fun c(x, y) = if x is
  AA then
    let a = if y is
      A then 1
    a + x.x
fun p() = AA(2)
c(p(), A)
//│ deforest > ==============
//│ deforest > ========
//│ = 3




fun f(x) = if x is
  AA(AA(a)) then g(a)
fun g(x) = if x is
  AA(b) then f(b)
  A then 42
f(AA(AA(AA(AA(AA(A))))))
