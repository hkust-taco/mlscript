:expect A
fun f(x) = if x is
  AA(AA(a)) then a
fun p() = AA(AA(A))
f(p())
//│ deforest > >>> fusing >>>
//│ deforest > AA(tmp) ->
//│ deforest > 	match: x
//│ deforest > 	fields: x.x1
//│ deforest > AA(A) ->
//│ deforest > 	match: arg$AA$0$
//│ deforest > 	fields: arg$AA$0$.x
//│ deforest > <<< fusing <<<
//│ = A



:expect 12
fun c(x, y) =
  let t = if x is
    AA then
      if A is
        A then x.AA#x
  t + y
c(AA(2), 10)
//│ deforest > >>> fusing >>>
//│ deforest > A ->
//│ deforest > 	match: A
//│ deforest > A ->
//│ deforest > 	match: A
//│ deforest > AA(2) ->
//│ deforest > 	match: x
//│ deforest > 	fields: x.x1
//│ deforest > <<< fusing <<<
//│ = 12
