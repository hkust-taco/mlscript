//│ deforest > <<< fusing <<<
//│ = 2




:expect 3
fun c(x, y) = if x is
  AA then
    let a = if y is
      A then 1
    a + x.AA#x
fun p() = AA(2)
c(p(), A)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function c#0 @ c@c -> UnsafeEta
//│ deforest > function c#0 @ c@c -> UnsafeEta
//│ deforest > function p#0 @ p@p -> UnsafeEta
//│ deforest > function p#0 @ p@p -> UnsafeEta
//│ deforest > call +@result @ c@c -> Pure
//│ deforest > call +@result @ c@c -> Pure
//│ deforest > call c@result @ <root> -> UnsafeEta
//│ deforest > call p@result @ <root> -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > A⁰ ->
//│ deforest > 	match: y²
//│ deforest > AA⁰(2) ->
//│ deforest > 	match: x⁴
//│ deforest > 	fields: x⁴.x¹
//│ deforest > <<< fusing <<<
//│ = 3




:expect 42
fun f(x) = if x is
  AA(AA(a)) then g(a)
fun g(x) = if x is
  AA(b) then f(b)
  A then 42
f(AA(AA(AA(AA(AA(A))))))
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function f#0 @ f@f -> UnsafeEta
//│ deforest > function f#0 @ f@f -> UnsafeEta
//│ deforest > function f#0 @ g@g -> UnsafeEta
//│ deforest > function g#0 @ f@f -> UnsafeEta
//│ deforest > function g#0 @ f@f -> UnsafeEta
//│ deforest > function g#0 @ g@g -> UnsafeEta
//│ deforest > call f@result @ <root> -> UnsafeEta
