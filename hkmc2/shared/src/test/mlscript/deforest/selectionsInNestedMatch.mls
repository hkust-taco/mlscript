:expect 12
fun c(x, y) =
  let t = if x is
    AA then
      if A is
        A then x.AA#x
  t + y
c(AA(2), 10)
//│ deforest > >>> fusing >>>
//│ deforest > Ref(member:A,Some(object:A)) ->
//│ deforest > 	Ref(member:A,Some(object:A))
