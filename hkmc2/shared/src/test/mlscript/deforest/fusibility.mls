// TODO: ys is still detected to be an accumulator while it's actually not...
// this is because:
// 1. `append` returns `ys` directly in its second branch
// 2. `flatten` returns `append` result directly in its first branch
// so in the flow analysis,
// `append(h, flatten(t))`
// === `append(h, append_res)`
// === `append(h, h :: append(t, ys))`
// === `append(h, h :: ys)`
// which then means the flow analysis sees
// the spurious flow `h :: ys` --> `ys`
//
// Updated note after keeping only `upperBounds(p.s.uid) ::= c` during constraint solving (var < var case):
// `ys` is now not reported below as an accumulator just by accident
// and this does not mean the problem/limitation above is properly fixed.
fun length(ls) = if ls is
  h :: t then 1 + length(t)
  Nil then 0
fun append(xs, ys) = if xs is
  h :: t then h :: append(t, ys)
  Nil then ys
fun flatten(xss) = if xss is
  h :: t then append(h, flatten(t))
  Nil then Nil
length(flatten(id((1 :: Nil) :: Nil)))
//│ deforest > >>> non-affine syms >>>
//│ deforest > <<< non-affine syms <<<
//│ deforest > >>> accumulator syms >>>
//│ deforest > <<< accumulator syms <<<
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function append#0 @ append@append -> UnsafeEta
//│ deforest > function append#0 @ flatten@flatten.append@append -> UnsafeEta
//│ deforest > function append#0 @ flatten@flatten.append@append -> UnsafeEta
//│ deforest > function flatten#0 @ flatten@flatten -> UnsafeEta
//│ deforest > function flatten#0 @ flatten@flatten -> UnsafeEta
//│ deforest > function length#0 @ length@length -> UnsafeEta
//│ deforest > function length#0 @ length@length -> UnsafeEta
//│ deforest > call +@result @ length@length -> Pure
//│ deforest > call +@result @ length@length -> Pure
//│ deforest > call append@result @ append@append -> UnsafeEta
//│ deforest > call append@result @ flatten@flatten -> UnsafeEta
//│ deforest > call append@result @ flatten@flatten -> UnsafeEta
//│ deforest > call append@result @ flatten@flatten.append@append -> UnsafeEta
//│ deforest > call append@result @ flatten@flatten.append@append -> UnsafeEta
//│ deforest > call flatten@result @ <root> -> UnsafeEta
//│ deforest > call flatten@result @ flatten@flatten -> UnsafeEta
//│ deforest > call flatten@result @ flatten@flatten -> UnsafeEta
//│ deforest > call id@result @ <root> -> UnsafeEta
//│ deforest > call length@result @ <root> -> UnsafeEta
//│ deforest > call length@result @ length@length -> UnsafeEta
//│ deforest > call length@result @ length@length -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > Cons⁰(h³, tmp⁴) ->
//│ deforest > 	match: ls³
//│ deforest > 	fields: ls³.h¹
//│ deforest > 	fields: ls³.t⁰
//│ deforest > Nil⁰ ->
//│ deforest > 	match: ls³
//│ deforest > <<< fusing <<<
//│ = 1


// TODO: y is aliased with x,
// so affinity marks `x` as non affine
fun alias_then_patmat(x) =
  let y = x
  if x is Cons(a, b) then a + b + y.Cons#h
alias_then_patmat(Cons(12, 13))
//│ deforest > >>> non-affine syms >>>
//│ deforest > tmp⁵
//│ deforest > x_for_alias_then_patmat¹
//│ deforest > x_for_alias_then_patmat⁰
