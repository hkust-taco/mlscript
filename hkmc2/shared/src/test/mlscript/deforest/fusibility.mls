// accumulator
:deforest logAccumulator logNonAffine
fun length(ls) = if ls is
  h :: t then 1 + length(t)
  Nil then 0
fun from(n, acc) = if n == 0 then acc else from(n - 1, n :: acc)
length(from(5, Nil))
