// `b` should not be considered as an accumulator here
fun length(ls) = if ls is
  h :: t then 1 + length(t)
  Nil then 0
fun ping(a, b) = if a is
  h :: t then pong(t, b)
  Nil then b
fun pong(a, b) = if a is
  h :: t then ping(t, b)
  Nil then b
length(ping(id(1 :: 2 :: Nil), 3 :: 4 :: Nil))
