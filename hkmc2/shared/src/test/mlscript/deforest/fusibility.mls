// nested ctors can differ: outer is one-shot but inner is consumed twice,
// so outer fuses and inner doesn't
fun nest_prod(x) = AA(BB(x))
fun nest_consume(f, p) = if p is AA(i) then f(i) + f(i)
fun nest_pickB(p) = if p is BB(b) then b + 1
nest_consume(nest_pickB, nest_prod(10))
//│ deforest > >>> non-affine syms >>>
//│ deforest > arg$AA$0$_for_nest_consume¹
