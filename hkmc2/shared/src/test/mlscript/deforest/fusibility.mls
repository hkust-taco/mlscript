//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = 11





fun c1(p) = if p is Many(_) then 3
fun c2(p) = if p is Many(Once(v)) then v
fun apply(f, g, p) = f(p) + g(p)
apply(c1, c2, Many(Once(10)))
