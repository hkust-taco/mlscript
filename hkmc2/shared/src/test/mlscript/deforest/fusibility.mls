// non-affinity propagates through nested ctors
fun c1(x) = if x is AA(AA(AA(v))) then v else 0
fun c2(x) = if x is AA(AA(_)) then 1 else 0
let p = AA(AA(AA(10))) in
  c1(p) + c2(p)
