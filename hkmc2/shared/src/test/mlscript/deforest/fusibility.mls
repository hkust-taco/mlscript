//│ deforest > 	fields: x¹.x⁰
//│ deforest > 	fields: x¹.x⁰
//│ deforest > <<< fusing <<<
//│ = 14


fun c(p) =
  let cl = () => if p is AA(v) then v
  cl() + cl()
c(AA(7))
