// `ys` should not be considered as an accumulator here
fun length(ls) = if ls is
  h :: t then 1 + length(t)
  Nil then 0
fun append(xs, ys) = if xs is
  h :: t then h :: append(t, ys)
  Nil then ys
length(append(id(1 :: Nil), 2 :: Nil))
