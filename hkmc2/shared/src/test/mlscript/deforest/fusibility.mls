// `y` shows up in two arms
fun affine_branched(x, y, cons_y) = if x is
  AA(_) then cons_y(y)
  BB(_) then cons_y(y)
  else 0
affine_branched(AA(0), AA(1), (y) => if y is AA(x) then x + 2)
