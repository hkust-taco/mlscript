// `y` is matched as scrut once AND referenced inside a closure body —
// even though the closure is never called, the syntactic ref still counts
fun c(y) = if y is AA(_) then
  let _d = () => y
  0
c(AA(1))
//│ deforest > >>> non-affine syms >>>
