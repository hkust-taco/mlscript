// just one use of `p`, fuse away
fun c(p) = if p is AA(v) then v
c(AA(3))
//│ deforest > >>> non-affine syms >>>
//│ deforest > <<< non-affine syms <<<
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function c#0 @ c@c -> UnsafeEta
//│ deforest > function c#0 @ c@c -> UnsafeEta
//│ deforest > call c@result @ <root> -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > AA⁰(3) ->
//│ deforest > 	match: p⁰
//│ deforest > 	fields: p⁰.x⁰
//│ deforest > <<< fusing <<<
//│ = 3


// selects on the enclosing match scrut don't count as extra uses of the scrut
fun c(x) = if x is AA(_) then x.AA#x + x.AA#x
c(AA(7))
//│ deforest > >>> non-affine syms >>>
//│ deforest > <<< non-affine syms <<<
