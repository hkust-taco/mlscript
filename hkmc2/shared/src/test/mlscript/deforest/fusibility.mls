// `ys` is not an accumulator
fun append(xs, ys) = if xs is
  h :: t then h :: append(t, ys)
  Nil then ys
fun sum(ls, acc) = if ls is
  h :: t then sum(t, h + acc)
  Nil then acc
sum(append(id(Nil), Nil), 0)
//│ deforest > >>> non-affine syms >>>
//│ deforest > <<< non-affine syms <<<
//│ deforest > >>> accumulator syms >>>
//│ deforest > <<< accumulator syms <<<
