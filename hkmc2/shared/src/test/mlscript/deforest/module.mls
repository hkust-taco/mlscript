module M with
  data class XX(a)
  data class YY(b)
  data class ZZ(c)
  data object OO
  fun h() = 123
  fun p() = XX(YY(OO))
  fun f(x) = if x is
    XX(YY(y)) then h()
M.f(M.p())
//│ deforest > >>> fusing >>>
//│ deforest > M⁰.this.XX⁰(tmp⁰) ->
//│ deforest > 	match: x⁰
//│ deforest > 	fields: x⁰.a⁰
//│ deforest > M⁰.this.YY⁰(M⁰.this.OO⁰) ->
//│ deforest > 	match: arg$XX$0$⁰
//│ deforest > 	fields: arg$XX$0$⁰.b⁰
//│ deforest > <<< fusing <<<
//│ = 123






