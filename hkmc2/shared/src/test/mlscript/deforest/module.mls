:deforest
:expect 5056
module DeforestList with
  data object Nil
  data class (::) Cons(h, t)
  fun sum(ls) = if ls is
    Nil then 0
    h :: t then h + sum(t)
  fun enum(n) = if n > 0 then n :: enum(n - 1) else Nil
  fun main() = DeforestList.sum(DeforestList.enum(3))
  val res = DeforestList.sum(DeforestList.enum(100))
DeforestList.res + DeforestList.main()
//│ deforest > >>> fusing >>>
//│ deforest > Call(Select(Ref(module:DeforestList⁰,None),Ident(Cons)),List(Arg(None,Ref(n⁰,None)), Arg(None,Ref(tmp:tmp³,None)))) ->
//│ deforest > 	Ref(ls¹,None)
//│ deforest > 	Select(Ref(ls¹,None),Ident(h))
//│ deforest > 	Select(Ref(ls¹,None),Ident(t))
//│ deforest > Select(Ref(module:DeforestList⁰,None),Ident(Nil)) ->
//│ deforest > 	Ref(ls¹,None)
//│ deforest > <<< fusing <<<
//│ = 5056





:deforest
:expect 5056
module DeforestList with
  data object Nil
  data class (::) Cons(h, t)
  fun sum(ls) =
    fun helper(ls, acc) = if ls is
      Nil then acc
      h :: t then helper(t, acc + h)
    helper(ls, 0)
  fun enum(n) = if n > 0 then n :: enum(n - 1) else Nil
  fun main() = DeforestList.sum(DeforestList.enum(3))
  val res = DeforestList.sum(DeforestList.enum(100))
DeforestList.res + DeforestList.main()
//│ deforest > >>> fusing >>>
//│ deforest > Call(Select(Ref(module:DeforestList¹,None),Ident(Cons)),List(Arg(None,Ref(n¹,None)), Arg(None,Ref(tmp:tmp⁴,None)))) ->
//│ deforest > 	Ref(ls²,None)
//│ deforest > 	Select(Ref(ls²,None),Ident(h))
//│ deforest > 	Select(Ref(ls²,None),Ident(t))
//│ deforest > Select(Ref(module:DeforestList¹,None),Ident(Nil)) ->
//│ deforest > 	Ref(ls²,None)
//│ deforest > <<< fusing <<<
//│ = 5056



