//│ deforest > 	Select(Ref(var:ls,None),Ident(t))
//│ deforest > 	Select(Ref(var:ls,None),Ident(h))
//│ deforest > Select(Ref(module:DeforestList,None),Ident(Nil)) ->
//│ deforest > 	Ref(var:ls,None)
//│ deforest > Call(Select(Ref(module:DeforestList,None),Ident(Cons)),List(Arg(None,Ref(var:n,None)), Arg(None,Ref($tmp,None)))) ->
//│ deforest > 	Ref(var:ls,None)
