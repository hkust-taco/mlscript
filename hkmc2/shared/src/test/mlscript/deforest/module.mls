:deforest
:expect [D, A]
data object A
data class B(b)
data object C
data object D
module M with
  fun f(x) = if M.g(false) is
    A and
      x < 1 then B(0)
      else M.f(x - 1)
    C then D
  fun g(b) =
    if b then
      if M.f(0) is
        B then A
        D then A
    else
      C
[M.f(3), M.g(true)]
//│ deforest > >>> fusing >>>
//│ deforest > B⁰(0) ->
//│ deforest > 	match: scrut¹
//│ deforest > D⁰ ->
//│ deforest > 	match: scrut¹
//│ deforest > A¹ ->
//│ deforest > 	match: scrut²
//│ deforest > A¹ ->
//│ deforest > 	match: scrut²
//│ deforest > C⁰ ->
//│ deforest > 	match: scrut²
//│ deforest > B⁰(0) ->
//│ deforest > 	match: scrut¹
//│ deforest > D⁰ ->
//│ deforest > 	match: scrut¹
//│ deforest > A¹ ->
//│ deforest > 	match: scrut²
//│ deforest > A¹ ->
//│ deforest > 	match: scrut²
//│ deforest > C⁰ ->
//│ deforest > 	match: scrut²
//│ deforest > <<< fusing <<<
//│ = [D, A]




module O with
  module I with
    val x = 3
    fun g() = 23
    data class C(x)

:deforest
:noInline
private fun f(module I: O.I) = I.C(3)
private fun g(x, module I: O.I) = if x is
  I.C(y) then y + 2
g(f(O.I), O.I)
//│ deforest > >>> fusing >>>
//│ deforest > I⁰.C¹(3) ->
//│ deforest > 	match: x¹
//│ deforest > 	fields: x¹.x²
//│ deforest > <<< fusing <<<
//│ = 5


