:deforest
:expect [D, A]
data object A
data class B(b)
data object C
data object D
module M with
  fun f(x) = if M.g(false) is
    A and
      x < 1 then B(0)
      else M.f(x - 1)
    C then D
  fun g(b) =
    if b then
      if M.f(0) is
        B then A
        D then A
    else
      C
[M.f(3), M.g(true)]
//│ deforest > >>> fusing >>>
//│ deforest > Ref(member:D⁰,Some(object:D¹)) ->
//│ deforest > 	Ref(tmp:scrut¹,None)
//│ deforest > Call(Ref(member:B⁰,Some(term:B¹.B²)),List(Arg(None,Lit(IntLit(0))))) ->
//│ deforest > 	Ref(tmp:scrut¹,None)
//│ deforest > Ref(member:C⁰,Some(object:C¹)) ->
//│ deforest > 	Ref(tmp:scrut²,None)
//│ deforest > Ref(member:A⁰,Some(object:A¹)) ->
//│ deforest > 	Ref(tmp:scrut²,None)
//│ deforest > <<< fusing <<<
