:expect 5056
module DeforestList with
  data object Nil
  data class (::) Cons(h, t)
  fun sum(ls) = if ls is
    Nil then 0
    h :: t then h + sum(t)
  fun enum(n) = if n > 0 then n :: enum(n - 1) else Nil
  fun main() = DeforestList.sum(DeforestList.enum(3))
  val res = DeforestList.sum(DeforestList.enum(100))
DeforestList.res + DeforestList.main()
//│ deforest > >>> fusing >>>
//│ deforest > DeforestList⁰.this.Nil⁰ ->
//│ deforest > 	match: ls⁰
//│ deforest > DeforestList⁰.this.Cons⁰(n⁰, tmp¹) ->
//│ deforest > 	match: ls⁰
//│ deforest > 	fields: ls⁰.h⁰
//│ deforest > 	fields: ls⁰.t⁰
//│ deforest > DeforestList⁰.this.Nil⁰ ->
//│ deforest > 	match: ls⁰
//│ deforest > DeforestList⁰.this.Cons⁰(n⁰, tmp¹) ->
//│ deforest > 	match: ls⁰
//│ deforest > 	fields: ls⁰.h⁰
//│ deforest > 	fields: ls⁰.t⁰
//│ deforest > DeforestList⁰.this.Cons⁰(n⁰, tmp¹) ->
//│ deforest > 	match: ls⁰
//│ deforest > 	fields: ls⁰.h⁰
//│ deforest > 	fields: ls⁰.t⁰
//│ deforest > DeforestList⁰.this.Nil⁰ ->
//│ deforest > 	match: ls⁰
//│ deforest > <<< fusing <<<
//│ = 5056





:deforest
:expect 5056
module DeforestList with
  data object Nil
  data class (::) Cons(h, t)
  fun sum(ls) =
    fun helper(ls, acc) = if ls is
      Nil then acc
      h :: t then helper(t, acc + h)
    helper(ls, 0)
  fun enum(n) = if n > 0 then n :: enum(n - 1) else Nil
  fun main() = DeforestList.sum(DeforestList.enum(3))
  val res = DeforestList.sum(DeforestList.enum(100))
DeforestList.res + DeforestList.main()
//│ deforest > >>> fusing >>>
//│ deforest > DeforestList¹.this.Nil¹ ->
//│ deforest > 	match: ls¹
//│ deforest > DeforestList¹.this.Cons¹(n¹, tmp²) ->
//│ deforest > 	match: ls¹
//│ deforest > 	fields: ls¹.h¹
//│ deforest > 	fields: ls¹.t¹
//│ deforest > DeforestList¹.this.Nil¹ ->
//│ deforest > 	match: ls¹
//│ deforest > DeforestList¹.this.Cons¹(n¹, tmp²) ->
//│ deforest > 	match: ls¹
//│ deforest > 	fields: ls¹.h¹
//│ deforest > 	fields: ls¹.t¹
//│ deforest > DeforestList¹.this.Cons¹(n¹, tmp²) ->
//│ deforest > 	match: ls¹
//│ deforest > 	fields: ls¹.h¹
//│ deforest > 	fields: ls¹.t¹
//│ deforest > DeforestList¹.this.Nil¹ ->
//│ deforest > 	match: ls¹
//│ deforest > <<< fusing <<<
//│ = 5056



