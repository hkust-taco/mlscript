module DeforestList with
  data object Nil
  data class (::) Cons(h, t)
  fun sum(ls) =
    fun helper(ls, acc) = if ls is
      Nil then acc
      h :: t then helper(t, acc + h)
    helper(ls, 0)
  fun enum(n) = if n > 0 then n :: enum(n - 1) else Nil
  fun main() = DeforestList.sum(DeforestList.enum(3))
  val res = DeforestList.sum(DeforestList.enum(100))
DeforestList.res + DeforestList.main()
//│ deforest > ==============
//│ deforest > Call(Select(Ref(module:DeforestList,None),Ident(Cons)),List(Arg(None,Ref(var:n,None)), Arg(None,Ref($tmp,None)))) ->
