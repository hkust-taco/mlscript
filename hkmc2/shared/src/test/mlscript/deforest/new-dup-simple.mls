// using `let` to declare local functions helps to avoid the problem
// caused by reordering nested `fun` functions.
:deforest
:expect 1
fun test() =
  let x = if A(0) is
    A then 1
  let f() = x
  f()
test()
//│ deforest > ==============
//│ deforest > Call(Ref(member:A,Some((Fun)term:class:A.A)),List(Arg(None,Lit(IntLit(0))))) ->
//│ deforest > 	Ref($scrut,None)
//│ = 1


