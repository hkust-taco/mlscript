:js

data class A(x)
data class B(x)
data object C
data object D
data class (::) Cons(h, t)
object Nil



:deforest
:expect 51
fun to(n, acc) = if n == 0 then acc else to(n - 1, n :: acc)
fun f1(ls1, acc) = if ls1 is
  Nil then acc
  h :: t then f1(t, acc + h)
fun f2(ls2, acc) = if ls2 is
  Nil then acc
  hh :: tt then f2(tt, acc + hh + 1)
f1(to(4, Nil), 0) + f2(to(5, Nil), 0) + f1(to(6, Nil), 0)
//│ deforest > ==============
//│ deforest > Ref(member:Nil,Some(object:Nil)) ->
//│ deforest > 	Ref(var:ls1,None)
//│ deforest > Call(Ref(member:Cons,Some((Fun)term:class:Cons.Cons)),List(Arg(None,Ref(var:n,None)), Arg(None,Ref(var:acc,None)))) ->
//│ deforest > 	Ref(var:ls1,None)
//│ deforest > 	Select(Ref(var:ls1,None),Ident(t))
//│ deforest > 	Select(Ref(var:ls1,None),Ident(h))
//│ deforest > Ref(member:Nil,Some(object:Nil)) ->
//│ deforest > 	Ref(var:ls2,None)
//│ deforest > Call(Ref(member:Cons,Some((Fun)term:class:Cons.Cons)),List(Arg(None,Ref(var:n,None)), Arg(None,Ref(var:acc,None)))) ->
//│ deforest > 	Ref(var:ls2,None)
//│ deforest > 	Select(Ref(var:ls2,None),Ident(t))
//│ deforest > 	Select(Ref(var:ls2,None),Ident(h))
//│ deforest > Ref(member:Nil,Some(object:Nil)) ->
//│ deforest > 	Ref(var:ls1,None)
//│ deforest > Call(Ref(member:Cons,Some((Fun)term:class:Cons.Cons)),List(Arg(None,Ref(var:n,None)), Arg(None,Ref(var:acc,None)))) ->
//│ deforest > 	Ref(var:ls1,None)
//│ deforest > 	Select(Ref(var:ls1,None),Ident(t))
//│ deforest > 	Select(Ref(var:ls1,None),Ident(h))
