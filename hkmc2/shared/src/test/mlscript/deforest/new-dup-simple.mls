:deforest
:expect 3
if [1, 2] is
  [a, b] then a + b
//│ deforest > ==============
//│ deforest > Tuple(false,List(Arg(None,Lit(IntLit(1))), Arg(None,Lit(IntLit(2))))) ->
//│ deforest > 	Ref($scrut,None)
//│ deforest > 	Call(Select(Select(Ref($runtime,None),Ident(Tuple)),Ident(get)),List(Arg(None,Ref($scrut,None)), Arg(None,Lit(IntLit(0)))))
//│ deforest > 	Call(Select(Select(Ref($runtime,None),Ident(Tuple)),Ident(get)),List(Arg(None,Ref($scrut,None)), Arg(None,Lit(IntLit(1)))))
//│ JS (unsanitized):
//│ let scrut1, a1, b, element1$, element0$, tup2_0, tup2_1, $scrut_2, $scrut_rest1; /* scoped */
//│ $scrut_2 = function $scrut_2(tup2_01, tup2_11) {
//│   element0$ = tup2_01;
//│   element1$ = tup2_11;
//│   b = element1$;
//│   a1 = element0$;
//│   return a1 + b
//│ };
//│ $scrut_rest1 = function $scrut_rest() {};
//│ tup2_0 = 1;
//│ tup2_1 = 2;
//│ scrut1 = () => { return $scrut_2(tup2_0, tup2_1) };
//│ scrut1()
//│ deforest > ==============
//│ deforest > Tuple(false,List(Arg(None,Lit(IntLit(1))), Arg(None,Lit(IntLit(2))))) ->
//│ deforest > 	Ref($scrut,None)
//│ deforest > 	Call(Select(Select(Ref($runtime,None),Ident(Tuple)),Ident(get)),List(Arg(None,Ref($scrut,None)), Arg(None,Lit(IntLit(0)))))
//│ deforest > 	Call(Select(Select(Ref($runtime,None),Ident(Tuple)),Ident(get)),List(Arg(None,Ref($scrut,None)), Arg(None,Lit(IntLit(1)))))
//│ = 3


