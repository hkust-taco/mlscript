:js
:deforest


object A
object B
// object C
// class AA(aa)
// class BB(bb)
// object None
// class Some(value)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<

// * Not fused: two `x is A` consumers
let x = if true then A else B
fun foo(x) =
  if x is A do print(123)
  if x is
    A then 1
    B then 2
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function foo⁰#0 @ foo¹ -> UnsafeEta
//│ deforest > call print@result⁰ @ foo¹ -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ x = A

// * We could make it work. But it's a special case that's probably not very important
let x = if true then A else B
fun foo(x) =
  if x is A do print(123)
  if x is B do print(456)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function foo⁰#0 @ foo¹ -> UnsafeEta
//│ deforest > call print@result¹ @ foo¹ -> UnsafeEta
//│ deforest > call print@result⁰ @ foo¹ -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ x = A

:expect 1
fun foo(k, x) =
  if x === 0 do k(A)
  k of
    if x > 0
      then A
      else B
fun bar(v) = if v is
  A then 1
  B then 2
foo(bar, 123)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function bar⁰#0 @ bar² -> UnsafeEta
//│ deforest > function bar⁰#0 @ bar¹ -> UnsafeEta
//│ deforest > function foo⁰#0 @ foo² -> UnsafeEta
//│ deforest > function foo⁰#0 @ foo¹ -> UnsafeEta
//│ deforest > call ===⁰@result⁰ @ foo² -> Pure
//│ deforest > call ===⁰@result⁰ @ foo¹ -> Pure
//│ deforest > call >⁰@result² @ foo² -> Pure
//│ deforest > call >⁰@result² @ foo¹ -> Pure
//│ deforest > call foo⁰@result⁴ @ <root> -> UnsafeEta
//│ deforest > call k⁰@result³ @ foo² -> UnsafeEta
//│ deforest > call k⁰@result³ @ foo¹ -> UnsafeEta
//│ deforest > call k⁰@result¹ @ foo² -> UnsafeEta
//│ deforest > call k⁰@result¹ @ foo¹ -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > A⁰ ->
//│ deforest > 	match: v⁰
//│ deforest > A⁰ ->
//│ deforest > 	match: v⁰
//│ deforest > B⁰ ->
//│ deforest > 	match: v⁰
//│ deforest > <<< fusing <<<
//│ = 1


