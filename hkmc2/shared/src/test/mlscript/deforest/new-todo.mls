object C
object D

// TODO: it's fine only when using `M.g` and `M.f` instead of `g` and `f`
:deforest
module M with ...
fun f(x) = if M.g(false) is
  A and
    x < 1 then B(0)
    else M.f(x - 1)
  C then D
fun g(b) =
  if b then
    if M.f(0) is
      B then A
      D then A
  else
    C
//│ deforest > ==============
//│ deforest > ========


[M.f(3), M.g(true)]
//│ = [D, A]
