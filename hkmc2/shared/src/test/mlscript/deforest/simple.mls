// `x.x` is successfully fused
:expect 1
fun f1(a) = if a is
  A then 1
  B then 2
  C then 3
fun f2(a) = if a is
  A then 4
  B then 5
  C then 6
fun test() =
  let x = if true then AA(A) else BB(B)
  if x is
    AA then f1(x.AA#aa)
    BB then f2(x.BB#bb)
test()
//│ deforest > >>> fusing >>>
//│ deforest > Call(Ref(member:AA,Some(term:AA⁰.AA)),List(Arg(None,Ref(member:A,Some(object:A))))) ->
//│ deforest > 	Ref(x,None)
//│ deforest > 	Select(Ref(x,None),Ident(aa))
//│ deforest > Call(Ref(member:BB,Some(term:BB⁰.BB)),List(Arg(None,Ref(member:B,Some(object:B))))) ->
//│ deforest > 	Ref(x,None)
//│ deforest > 	Select(Ref(x,None),Ident(bb))
//│ deforest > Ref(member:A,Some(object:A)) ->
//│ deforest > 	Ref(a,None)
//│ deforest > Ref(member:B,Some(object:B)) ->
//│ deforest > 	Ref(a,None)
//│ deforest > <<< fusing <<<
//│ = 1


