// technically ill-typed, so `AA(3)` (which flows to `z`) is not fused
:expect "2AA(3)NaN"
fun test(x, y, z) = if x is
  AA(a) then
    let m = if y is
      AA(a1) then a1 + z
    let n = if z is
      AA(a2) then a2 - z
    m + n
test(AA(1), AA(2), AA(3))
