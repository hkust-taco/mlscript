:expect 21
fun f(x, y) =
  let a = if x is
    AAA(n, m) then y + n - m
    BBB(n, m) then m + 1 - n
  a + 3
f(AAA(1, 3), 1) + f(BBB(2, 3), 2) + f(AAA(3, 2), 4) + f(BBB(4, 6), 0)
