// calls to `to` should be able to be duplicated
:expect 88
fun to(n) =
  if n > 0 then
    let m = n - 1
    n :: to(m)
  else
    Nil
fun f1(ls1) = if ls1 is
  h :: t then h + f1(t)
  Nil then 2
fun f2(ls2) = if ls2 is
  h :: t then h + f2(t)
  Nil then 3
fun f3(ls3) = if ls3 is
  h :: t then h + f3(t)
  Nil then 4
fun f4(ls4) = if ls4 is
  h :: t then h + f4(t)
  Nil then 5
f1(to(4)) + f2(to(5)) + f3(to(6)) + f4(to(7))
//│ deforest > >>> fusing >>>
//│ deforest > Cons⁰(n⁰, tmp⁶) ->
//│ deforest > 	match: scrut⁵⁹
//│ deforest > 	fields: scrut⁵⁹.h⁰
//│ deforest > 	fields: scrut⁵⁹.t⁰
//│ deforest > Nil⁰ ->
//│ deforest > 	match: scrut⁵⁹
//│ deforest > Cons⁰(n⁰, tmp⁶) ->
//│ deforest > 	match: scrut⁶⁰
//│ deforest > 	fields: scrut⁶⁰.h⁰
//│ deforest > 	fields: scrut⁶⁰.t⁰
//│ deforest > Nil⁰ ->
//│ deforest > 	match: scrut⁶⁰
//│ deforest > Cons⁰(n⁰, tmp⁶) ->
//│ deforest > 	match: scrut⁶¹
//│ deforest > 	fields: scrut⁶¹.h⁰
//│ deforest > 	fields: scrut⁶¹.t⁰
//│ deforest > Nil⁰ ->
//│ deforest > 	match: scrut⁶¹
//│ deforest > Cons⁰(n⁰, tmp⁶) ->
//│ deforest > 	match: scrut⁶²
//│ deforest > 	fields: scrut⁶².h⁰
//│ deforest > 	fields: scrut⁶².t⁰
//│ deforest > Nil⁰ ->
//│ deforest > 	match: scrut⁶²
//│ deforest > <<< fusing <<<
//│ = 88




