//│ deforest > 	List(var:x, var:x, $arg$BB$0$, $arg$AA$0$)
//│ = A


fun f(a) = if a is
  A then 1
  B then 2
fun test() =
  let x = if true then AA(A) else BB(B)
  if x is
    AA(x) then f(x)
    BB(x) then f(x)
test()
