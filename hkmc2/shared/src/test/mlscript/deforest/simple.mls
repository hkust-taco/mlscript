//│ deforest > Call(Ref(member:AA,Some((Fun)term:class:AA.AA)),List(Arg(None,Lit(IntLit(1))))) ->
//│ deforest > 	Ref(var:x,None)
//│ deforest > 	Select(Ref(var:x,None),Ident(aa))
//│ deforest > ========
//│ deforest > free vars of Ref(var:x,None):
