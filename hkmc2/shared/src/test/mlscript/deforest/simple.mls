// `x.AA#aa` is used both as the scrutinee of the inner match
// and as the base of a field selection (`x.AA#aa.AA#aa`),
// giving it two consumer destinations, so the inner match is not fused
:expect 3
fun f(x) = if x is
  AA then if x.AA#aa is
    AA then x.AA#aa.AA#aa
f(AA(AA(3)))
