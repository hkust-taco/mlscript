:js
:deforest


object A
object B
object C
object D
data class AA(aa)
data class BB(bb)
data class AAA(x, y)
data class BBB(x, y)
data class CCC(c)
object None
data class Some(value)
data object Nil
data class (::) Cons(h, t)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<



// * Note that this test produces dead code (non-empty rest after an abortive block prefix),
// * but that code is now renoved, as can be checked by comparing `:sir` and `:soir` outputs.
// * FIXME: At the time of writing, there is currently still some (non-dead) duplication of the big addition, though.
// :sir
// :soir
fun test(x) =
  let y = if x is
    AA(AA(v)) then v
  y + 1 + 2 + 3 + 4
test(AA(AA(10)))
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function test⁰#0 @ test² -> UnsafeEta
//│ deforest > function test⁰#0 @ test¹ -> UnsafeEta
//│ deforest > call +⁰@result² @ test² -> Pure
//│ deforest > call +⁰@result² @ test¹ -> Pure
//│ deforest > call +⁰@result³ @ test² -> Pure
//│ deforest > call +⁰@result³ @ test¹ -> Pure
//│ deforest > call +⁰@result¹ @ test² -> Pure
//│ deforest > call +⁰@result¹ @ test¹ -> Pure
//│ deforest > call +⁰@result⁰ @ test² -> Pure
//│ deforest > call +⁰@result⁰ @ test¹ -> Pure
//│ deforest > call test⁰@result⁴ @ <root> -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > AA⁰(tmp⁰) ->
//│ deforest > 	match: x⁰
//│ deforest > 	fields: x⁰.aa⁰
//│ deforest > AA⁰(10) ->
//│ deforest > 	match: arg$AA$0$⁰
//│ deforest > 	fields: arg$AA$0$⁰.aa⁰
//│ deforest > <<< fusing <<<
//│ = 20



:expect 1
let x = if true then A else B in...
if x is
  A then 1
  B then 2
