//│ deforest > ==============
//│ deforest > ========

object A
object B
object C
data class AA(aa)
data class BB(bb)
data class AAA(x, y)
data class BBB(x, y)
data class CCC(c)
object None
data class Some(value)
//│ deforest > ==============
//│ deforest > ========

fun test() =
  let x = if true then A else B
  if x is
    A then 1
    B then 2
test()
//│ deforest > ==============
//│ deforest > Ref(member:A,Some(object:A)) ->
//│ deforest > 	Ref(var:x,None)
//│ deforest > Ref(member:B,Some(object:B)) ->
//│ deforest > 	Ref(var:x,None)
//│ deforest > ========
//│ deforest > free vars of Ref(var:x,None):
//│ deforest > 	List()
//│ = 1

fun test() =
  let x = if true then AA(A) else BB(B)
  if x is
    AA(x) then x
    BB(x) then x
test()
