//│ deforest > AA⁰(A⁰) ->
//│ deforest > 	match: x²
//│ deforest > 	fields: x².aa⁰
//│ deforest > <<< fusing <<<
//│ = A


:expect 1
fun f(a) = if a is
  A then 1
  B then 2
let x = if true then AA(A) else BB(B) in...
if x is
  AA(x) then f(x)
  BB(x) then f(x)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function f⁰#0 @ f² -> UnsafeEta
//│ deforest > function f⁰#0 @ f³ -> UnsafeEta
//│ deforest > function f⁰#0 @ f¹ -> UnsafeEta
//│ deforest > call f⁰@result¹ @ <root> -> UnsafeEta
//│ deforest > call f⁰@result⁰ @ <root> -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > BB⁰(B⁰) ->
//│ deforest > 	match: x³
//│ deforest > 	fields: x³.bb⁰
//│ deforest > B⁰ ->
//│ deforest > 	match: a⁰
//│ deforest > AA⁰(A⁰) ->
//│ deforest > 	match: x³
//│ deforest > 	fields: x³.aa⁰
//│ deforest > A⁰ ->
//│ deforest > 	match: a⁰
//│ deforest > <<< fusing <<<
//│ = 1


// `x.x` is successfully fused
:expect 1
fun f1(a) = if a is
  A then 1
  B then 2
  C then 3
fun f2(a) = if a is
  A then 4
  B then 5
  C then 6
let x = if true then AA(A) else BB(B) in...
if x is
  AA then f1(x.AA#aa)
  BB then f2(x.BB#bb)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function f1⁰#0 @ f1² -> UnsafeEta
//│ deforest > function f1⁰#0 @ f1¹ -> UnsafeEta
//│ deforest > function f2⁰#0 @ f2² -> UnsafeEta
//│ deforest > function f2⁰#0 @ f2¹ -> UnsafeEta
//│ deforest > call f1⁰@result¹ @ <root> -> UnsafeEta
//│ deforest > call f2⁰@result⁰ @ <root> -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > BB⁰(B⁰) ->
//│ deforest > 	match: x⁴
//│ deforest > 	fields: x⁴.bb⁰
//│ deforest > B⁰ ->
//│ deforest > 	match: a¹
//│ deforest > AA⁰(A⁰) ->
//│ deforest > 	match: x⁴
//│ deforest > 	fields: x⁴.aa⁰
//│ deforest > A⁰ ->
//│ deforest > 	match: a²
//│ deforest > <<< fusing <<<
//│ = 1


