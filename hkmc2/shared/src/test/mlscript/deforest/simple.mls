:expect 103
fun inner(x, y) =
  let t = if x is
    AA(a) then a + y
    BB(b) then b - y
  t * y
fun outer1(x, y, z) =
  let t = if x is
    AA(a) then inner(a, y)
    BB(b) then inner(b, y)
  t + z
fun outer2(x, y, z) =
  let t = if x is
    AA(a) then inner(a, z)
    BB(b) then inner(b, y)
  t + y
let p = AA(AA(3))
outer1(p, 1, 2) + outer2(p, 3, 4) + inner(AA(5), 6)
