//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > B⁰ ->
//│ deforest > 	match: x¹
//│ deforest > A⁰ ->
//│ deforest > 	match: x¹
//│ deforest > <<< fusing <<<
//│ = 1

:expect A
let x = if true then AA(A) else BB(B) in...
if x is
  AA(x) then x
  BB(x) then x
//│ deforest > >>> effect-analysis results >>>
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > BB⁰(B⁰) ->
