//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<

object A
object B
object C
object D
data class AA(aa)
data class BB(bb)
data class AAA(x, y)
data class BBB(x, y)
data class CCC(c)
object None
data class Some(value)
data object Nil
data class (::) Cons(h, t)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<

:expect 1
fun test() =
  let x = if true then A else B
  if x is
    A then 1
    B then 2
test()
//│ deforest > >>> fusing >>>
//│ deforest > Ref(member:A,Some(object:A)) ->
//│ deforest > 	Ref(x,None)
//│ deforest > Ref(member:B,Some(object:B)) ->
//│ deforest > 	Ref(x,None)
//│ deforest > <<< fusing <<<
//│ = 1

:expect A
fun test() =
  let x = if true then AA(A) else BB(B)
  if x is
    AA(x) then x
    BB(x) then x
test()
