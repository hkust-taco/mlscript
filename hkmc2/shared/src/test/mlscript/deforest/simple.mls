:expect 103
fun inner(x, y) =
  let t = if x is
    AA(a) then a + y
    BB(b) then b - y
  t * y
fun outer1(x, y, z) =
  let t = if x is
    AA(a) then inner(a, y)
    BB(b) then inner(b, y)
  t + z
fun outer2(x, y, z) =
  let t = if x is
    AA(a) then inner(a, z)
    BB(b) then inner(b, y)
  t + y
let p = AA(AA(3))
outer1(p, 1, 2) + outer2(p, 3, 4) + inner(AA(5), 6)
//│ deforest > >>> fusing >>>
//│ deforest > Call(Ref(member:AA,Some(term:AA/AA)),List(Arg(None,Lit(IntLit(5))))) ->
//│ deforest > 	Ref(x,None)
//│ deforest > 	Select(Ref(x,None),Ident(aa))
//│ deforest > <<< fusing <<<
//│ = 103
//│ p = AA(AA(3))


