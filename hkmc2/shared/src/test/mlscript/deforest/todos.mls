// TODO: many dead code contain duplicated `t + 5 * 4 - 3 + 2 - 1`.
// `t + 5 * 4 - 3 + 2 - 1` is the "rest" of a fusing match;
// Deforestation makes programs early return at fusing matches,
// and after deforestation, the "rest" of fusing matches would appear both
// in "rest function"s and after the early return (and becomes dead code).
// A dead code elimination that detects early return would solve this problem.
:sir
:expect 78
fun test(x) =
  let t = if x is
    AA(AA(AA(a))) then a
    else 4
  t + 5 * 4 - 3 + 2 - 1
fun f(a) = if a is
  AA(AA) then 0
let p = AA(AA(AA(10)))
test(p) + f(p) + test(AA(AA(AA(10)))) + test(B)
