// TODO: fusion opportunity is lost
// because there are two consumers due to two call sites of `inner`s.
:expect 0
fun inner(x) = if x is A then 0 else 1
fun test() =
  let x = A
  inner(x) + inner(x)
test()
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = 0


