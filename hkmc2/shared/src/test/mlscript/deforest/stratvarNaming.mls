:js
:deforest logNonAffine


// `m` and `r` are source-symbol vars of `g`, `call_res` is generated inside `g`; `f` and `g` form one SCC
fun f(n) = if n == 0 then 0 else g(n - 1)
fun g(m) =
  let r = f(m)
  [m, m, r, r]
f(3)
