:expect Cons(Pair(5, 1), Cons(Pair(5, 2), Cons(Pair(5, 5), Nil)))
fun append(xs, ys) = if xs is
  h :: t then h :: append(t, ys)
  Nil then ys
fun concatMap(f, ls) = if ls is
  h :: t then append(f(h), concatMap(f, t))
  Nil then Nil
fun f1(a1) = if a1 is
  Pair(a, b) then
    fun f2(a2) = if a2 is Pair(c, d) then Pair(a, c) :: Nil else Nil
    concatMap(f2, Pair(1, 3) :: Pair(2, 3) :: Pair(a, b) :: Nil)
  else Nil
concatMap(f1, Pair(5, 10) :: Nil)
