:expect Cons(2, Cons(3, Cons(4, Nil)))
fun lscomp(ls) = if ls is
  h :: t then (h + 1) :: lscomp(t)
  Nil then Nil
if A is
  A then lscomp(1 :: 2 :: 3 :: Nil)
  B then Nil
