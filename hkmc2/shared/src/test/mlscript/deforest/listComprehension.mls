:expect Cons(Pair(1, 3), Cons(Pair(2, 4), Cons(Pair(3, 5), Nil)))
fun zip(xs_zip, ys_zip) = if
  xs_zip is x :: xt and ys_zip is y :: yt then Pair(x, y) :: zip(xt, yt)
  else Nil
fun enumFromTo(a, b) = if a < (b + 1) then a :: enumFromTo(a + 1, b) else Nil
fun lscomp1(ls) = if ls is
  Pair(x, y1) :: t then
    fun lscomp2(ls2) = if ls2 is
      Pair(y2, z) :: t2 and
        y1 == y2 then Pair(x, z) :: lscomp2(t2)
        else lscomp2(t2)
      else lscomp1(t)
    lscomp2(zip(enumFromTo(x, x + 2), enumFromTo(y1, y1 + 1)))
  else Nil
lscomp1(zip(enumFromTo(1, 3), enumFromTo(2, 4)))
