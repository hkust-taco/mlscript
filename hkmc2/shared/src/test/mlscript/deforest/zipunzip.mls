:.
:js
:deforest



object Nil
data class (::) Cons(h, t)
data class Pair(a, b)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<

:expect Pair(Cons(1, Cons(2, Nil)), Cons(2, Cons(3, Nil)))
fun zip(xs_zip, ys_zip) = if
  xs_zip is x :: xt and ys_zip is y :: yt then Pair(x, y) :: zip(xt, yt)
  else Nil
fun unzip(ls_unzip) = if ls_unzip is
  Pair(a, b) :: t and unzip(t) is Pair(atail, btail) then Pair(a :: atail, b :: btail)
  Nil then Pair(Nil, Nil)
fun enumFromTo(a, b) = if a < b then a :: enumFromTo(a + 1, b) else Nil
fun testUnzipZip(n) = unzip(zip(id(enumFromTo(1, n)), id(enumFromTo(2, n + 3))))
testUnzipZip(3)
