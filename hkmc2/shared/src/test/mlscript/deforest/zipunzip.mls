//│ deforest > 	Select(Ref(var:ls_unzip,None),Ident(t))
//│ deforest > Call(Ref(member:Pair,Some((Fun)term:class:Pair.Pair)),List(Arg(None,Ref(var:x,None)), Arg(None,Ref(var:y,None)))) ->
//│ deforest > 	Ref($arg$Cons$0$,None)
