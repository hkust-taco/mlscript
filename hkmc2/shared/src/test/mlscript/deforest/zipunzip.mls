//│ deforest > free vars of Ref(var:ls_unzip,None):
//│ deforest > 	List(var:t, var:a, var:b, var:atail, var:btail, $scrut, $arg$Cons$0$, $arg$Cons$1$, $arg$Pair$0$, $arg$Pair$1$, $arg$Pair$0$, $arg$Pair$1$, $tmp, $tmp, $tmp, $tmp)
//│ deforest > free vars of Ref($arg$Cons$0$,None):
//│ deforest > 	List(var:t, var:a, var:b, var:atail, var:btail, $scrut, $arg$Cons$1$, $arg$Pair$0$, $arg$Pair$1$, $arg$Pair$0$, $arg$Pair$1$, $tmp, $tmp, $tmp, $tmp)
//│ = Pair(Cons(1, Cons(2, Nil)), Cons(2, Cons(3, Nil)))



fun zip(xs_zip, ys_zip) = if
  xs_zip is x :: xt and ys_zip is y :: yt then Pair(x, y) :: zip(xt, yt)
  else Nil
fun unzip(ls_unzip) = if ls_unzip is
  Pair(a, b) :: t and unzip(t) is Pair(atail, btail) then Pair(a :: atail, b :: btail)
  Nil then Pair(Nil, Nil)
fun makeZippedList(n) = if n > 0 then Pair(n, n + 1) :: makeZippedList(n - 1) else Nil
fun testZipUnzip(n) = if unzip(id(makeZippedList(n))) is
  Pair(xs, ys) then zip(xs, ys)
testZipUnzip(3)
