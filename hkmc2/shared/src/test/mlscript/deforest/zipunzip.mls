:expect Cons(Pair(3, 4), Cons(Pair(2, 3), Cons(Pair(1, 2), Nil)))
fun zip(xs_zip, ys_zip) = if
  xs_zip is x :: xt and ys_zip is y :: yt then Pair(x, y) :: zip(xt, yt)
  else Nil
fun unzip(ls_unzip) = if ls_unzip is
  Pair(a, b) :: t and unzip(t) is Pair(atail, btail) then Pair(a :: atail, b :: btail)
  Nil then Pair(Nil, Nil)
fun makeZippedList(n) = if n > 0 then Pair(n, n + 1) :: makeZippedList(n - 1) else Nil
fun testZipUnzip(n) = if unzip(id(makeZippedList(n))) is
  Pair(xs, ys) then zip(xs, ys)
testZipUnzip(3)
