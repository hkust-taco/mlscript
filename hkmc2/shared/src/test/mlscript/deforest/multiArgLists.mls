:js
:deforest

// Test: Deforestation with function of multiple parameter lists
object A
data class Pair(x, y)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<

fun test(a)(b) =
  if a is Pair(x, y) then x + y + b
test(Pair(1, 2))(3)
//│ deforest > >>> fusing >>>
//│ deforest > Call(Ref(member:Pair,Some(term:Pair/Pair)),List(List(Arg(None,Lit(IntLit(1))), Arg(None,Lit(IntLit(2)))))) ->
//│ deforest > 	Ref(a,None)
//│ deforest > 	Select(Ref(a,None),Ident(x))
//│ deforest > 	Select(Ref(a,None),Ident(y))
//│ deforest > <<< fusing <<<
//│ = 6

// Test: Deforestation with nested constructor calls and multiple param lists
data class Box(v)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<

fun unbox(b)(offset) =
  if b is Box(v) then v + offset
unbox(Box(10))(5)
//│ deforest > >>> fusing >>>
//│ deforest > Call(Ref(member:Box,Some(term:Box/Box)),List(List(Arg(None,Lit(IntLit(10)))))) ->
//│ deforest > 	Ref(b,None)
//│ deforest > 	Select(Ref(b,None),Ident(v))
//│ deforest > <<< fusing <<<
//│ = 15

