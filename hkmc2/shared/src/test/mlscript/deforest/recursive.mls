fun mk(n) = if n > 0 then n :: mk(n - 1) else Nil
fun mk2d(n) = if n > 0 then mk(n) :: mk2d(n - 1) else Nil
fun append(xs, ys) = if xs is
  Nil then ys
  x :: xs then x :: append(xs, ys)
fun sum(ls_sum) = if ls_sum is
  Nil then 0
  x :: xs then x + sum(xs)
fun flatten(ls_flatten) = if ls_flatten is
  Nil then Nil
  x :: xs then append(x, flatten(xs))
