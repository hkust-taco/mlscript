:expect Cons(7, Cons(5, Cons(3, Cons(1, Nil))))
fun map(f, ls) = if ls is
  Nil then Nil
  h :: t then f(h) :: map(f, t)
fun enum(a) = if a < 0 then Nil else a :: enum(a - 1)
map(x => x + 1, map(x => x * 2, id(enum(3))))
