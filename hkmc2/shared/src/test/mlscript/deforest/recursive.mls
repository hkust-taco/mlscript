:expect Some(4)
fun filter(ls, f) = if ls is
  h :: t and
    f(h) then h :: filter(t, f)
    else filter(t, f)
  Nil then Nil
fun last(ls_last) =
  fun go(a, ls_go) = if ls_go is
    Nil then a
    h :: t then go(h, t)
  if ls_last is
    h :: t then Some(go(h, t))
    Nil then None
fun lastFilter(ls, f) = last(filter(ls, f))
lastFilter(id(1 :: 2 :: 3 :: 4 :: 5 :: Nil), x => (x % 2 == 0))
