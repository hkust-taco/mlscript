fun mk(n) = if n < 0 then Nil else n :: mk(n - 1)
fun incr(x) = x + 1
fun map(f, xs_map) = if xs_map is
  Nil then Nil
  x :: xs then f(x) :: map(f, xs)
fun rev(xs_rev, acc) = if xs_rev is
  x :: xs then rev(xs, x :: acc)
  Nil then acc
