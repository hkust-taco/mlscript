// should prevent processing a function body more than once
:deforest
fun main() = if
  false then f() + g()
  else 0
fun f() = if
  false then h()
  else 0
fun h() = if
  false then f() + main()
  else 0
fun g() = if
  false then h() + main()
  else 0
main
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = fun main





