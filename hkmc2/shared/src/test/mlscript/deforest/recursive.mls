:expect 2
fun f(x) = if x == 0 then Nil else x :: g(x - 1)
fun g(y) = if y == 0 then Nil else y :: f(y - 1)
fun cons(a) = if a is
  Nil then 0
  h :: t then h + cons(t)
fun cons1(a1) = if a1 is
  Nil then 1
  h :: t then h + cons1(t)
cons(f(0)) + cons1(f(1))
