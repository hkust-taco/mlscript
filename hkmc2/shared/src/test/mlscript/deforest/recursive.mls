data class Pair(a, b)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<


fun pair_up(xs) =
  if xs is
    x :: xss then
      if xss is
        y :: xs then Pair(x, y) :: pair_up(xs)
        else Nil
    else Nil
fun mk(n) = if n > 0 then (n - 1) :: n :: (n + 1) :: mk(n - 1) else Nil
pair_up(mk(4))
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
