//│   set X_a = tmp1;
//│   return (fv_ctorLam_y, fv_ctorLam_arg$X$0$, fv_ctorLam_arg$Y$0$) => {
//│     return f_12$x_X¹(fv_ctorLam_y, fv_ctorLam_arg$X$0$, fv_ctorLam_arg$Y$0$, X_a)
//│   }
//│ };
//│ define f_12$f⁰ as fun f_12$f¹(x) {
//│   let y, arg$X$0$, arg$Y$0$;
//│   block split_root$:
//│     block split_default$:
//│       return x(y, arg$X$0$, arg$Y$0$)
//│     throw new globalThis⁰.Error⁰("match error")
//│   return runtime⁰.Unit⁰
//│ };
//│ define f_12$x_X⁰ as fun f_12$x_X¹(fv_y, fv_arg$X$0$, fv_arg$Y$0$, X_a) {
//│   set fv_arg$X$0$ = X_a;
//│   return fv_arg$X$0$(fv_y, fv_arg$Y$0$)
