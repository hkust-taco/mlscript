//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let p⁰, f⁰, tmp, p_10$p⁰, f_12$f⁰, f_12$x_X⁰, f_12$x_rest⁰, f_12$split_default$_rest⁰, f_12$split_root$_rest⁰, f_12$arg$X$0$_Y⁰, f_12$arg$X$0$_rest⁰;
//│ define p_10$p⁰ as fun p_10$p¹() {
//│   let tmp1, Y_b, X_a;
//│   set Y_b = O⁰;
//│   set tmp1 = (fv_ctorLam_y, fv_ctorLam_arg$Y$0$) => {
