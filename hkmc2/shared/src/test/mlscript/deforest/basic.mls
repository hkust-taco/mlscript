:expect 14
fun p() = X(Y(O))
fun f(x, res) = if x is
  X(a) then
    let tmp = 12
    if a is
      Y(y) then res + tmp
f(p(), 2)
//│ deforest > >>> fusing >>>
//│ deforest > X⁰(tmp¹) ->
//│ deforest > 	match: scrut³
//│ deforest > 	fields: scrut³.a⁰
//│ deforest > Y⁰(O⁰) ->
//│ deforest > 	match: scrut⁴
//│ deforest > 	fields: scrut⁴.b⁰
//│ deforest > <<< fusing <<<
//│ = 14



:expect 16
fun f(x, y, res) = if x is
  X(a) then
    let tmp = 12
    if y is
      Y(b) then
        let _d = () => y
        res + tmp + a
f(X(1), Y(2), 3)
//│ deforest > >>> fusing >>>
//│ deforest > X⁰(1) ->
//│ deforest > 	match: scrut⁵
//│ deforest > 	fields: scrut⁵.a⁰
//│ deforest > <<< fusing <<<
//│ = 16



