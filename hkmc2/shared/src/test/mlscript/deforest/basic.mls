//│ deforest > 	fields: x.a
//│ deforest > X(a) ->
//│ deforest > 	match: x
//│ deforest > 	fields: x.a
//│ deforest > X(3) ->
//│ deforest > 	match: x
//│ deforest > 	fields: x.a
//│ deforest > <<< fusing <<<
//│ = fun lambda_8$lambda


