//│ };
//│ define f_12$split_root$_rest⁰ as fun f_12$split_root$_rest¹() {
//│   return runtime⁰.Unit⁰
//│ };
//│ define f_12$arg$X$0$_rest⁰ as fun f_12$arg$X$0$_rest¹() {
//│   return f_12$x_rest¹()
//│ };
//│ define p⁰ as fun p¹() {
//│   let tmp1;
//│   set tmp1 = Y⁰(O⁰);
//│   return X⁰(tmp1)
//│ };
