//│ };
//│ set tmp = p_10$p¹();
//│ f_12$f¹(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = O


:expect 14
fun p() = X(Y(O))
fun f(x, res) = if x is
  X(a) then
    let tmp = 12
    if a is
      Y(y) then res + tmp
f(p(), 2)
//│ deforest > >>> fusing >>>
//│ deforest > X(tmp) ->
//│ deforest > 	match: x
//│ deforest > 	fields: x.a
//│ deforest > Y(O) ->
//│ deforest > 	match: a
//│ deforest > 	fields: a.b
//│ deforest > <<< fusing <<<
//│ = 14



:expect 16
fun f(x, y, res) = if x is
  X(a) then
    let tmp = 12
    if y is
      Y(b) then
        let _d = () => y
        res + tmp + a
f(X(1), Y(2), 3)
//│ deforest > >>> fusing >>>
//│ deforest > X(1) ->
//│ deforest > 	match: x
//│ deforest > 	fields: x.a
//│ deforest > <<< fusing <<<
//│ = 16



fun c(x, d) = if x is
  X(a) then c(X(a), d)
() => c(X(3), 2)
//│ deforest > >>> fusing >>>
//│ deforest > X(a) ->
