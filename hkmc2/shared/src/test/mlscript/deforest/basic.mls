:expect B(4)
fun localFuse(x) = if A(x) is
  A(y) then B(y)
if localFuse(3) is
  B(a) then a
localFuse(4)
//│ deforest > >>> fusing >>>
//│ deforest > A(x) ->
//│ deforest > 	match: scrut
//│ deforest > 	fields: scrut.x
//│ deforest > A(x) ->
