:deforest
data object Nil
data class (::) Cons(h, t)
fun sum(ls) = if ls is
  Nil then 0
  h :: t then h + sum(t)
fun enum(n) = if n > 0 then n :: enum(n - 1) else Nil
sum(enum(3))
