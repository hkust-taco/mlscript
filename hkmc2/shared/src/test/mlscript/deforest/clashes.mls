//│ = 9



:expect 5
fun p(a) = a
fun f1(a1) = if a1 is A(x1) then x1
fun f2(a2) = if a2 is A(x2) then x2 + 1
let x = A(1)
let y = A(2)
let res1 = p(if true then x else y) // both x and y flow into this call-site result
let res2 = p(x) // x flows into this call-site result
let res3 = p(y) // y flows into this call-site result
// f1(res1) + f2(res1) + f1(res2) + f2(res3)
f1(res1) + f1(res2) + f2(res3)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function f1⁰#0 @ f1² -> UnsafeEta
//│ deforest > function f1⁰#0 @ f1³ -> UnsafeEta
//│ deforest > function f1⁰#0 @ f1¹ -> UnsafeEta
//│ deforest > function f2⁰#0 @ f2² -> UnsafeEta
//│ deforest > function f2⁰#0 @ f2¹ -> UnsafeEta
//│ deforest > function p¹#0 @ p² -> Pure
//│ deforest > function p¹#0 @ p³ -> Pure
//│ deforest > function p¹#0 @ p⁴ -> Pure
//│ deforest > function p¹#0 @ p⁵ -> Pure
//│ deforest > call +⁰@result³ @ <root> -> Pure
//│ deforest > call +⁰@result¹ @ <root> -> Pure
//│ deforest > call +⁰@result⁰ @ f2² -> Pure
//│ deforest > call +⁰@result⁰ @ f2¹ -> Pure
//│ deforest > call f1⁰@result⁴ @ <root> -> UnsafeEta
//│ deforest > call f1⁰@result⁵ @ <root> -> UnsafeEta
//│ deforest > call f2⁰@result² @ <root> -> UnsafeEta
//│ deforest > call p¹@result⁶ @ <root> -> Pure
//│ deforest > call p¹@result⁷ @ <root> -> Pure
//│ deforest > call p¹@result⁸ @ <root> -> Pure
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = 5
//│ res1 = A(1)
//│ res2 = A(1)
//│ res3 = A(2)
//│ x = A(1)
//│ y = A(2)



:expect 4
fun f1(a1) = if a1 is A(x1) then x1
fun f2(a2) = if a2 is A(x2) then x2 + 1
fun p(x, clashedCtor) =
  if true then A(x)
  else clashedCtor
let clashed = A(3)
f1(p(1, clashed)) + f2(p(2, clashed))
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function f1⁰#0 @ f1² -> UnsafeEta
//│ deforest > function f1⁰#0 @ f1¹ -> UnsafeEta
//│ deforest > function f2⁰#0 @ f2² -> UnsafeEta
//│ deforest > function f2⁰#0 @ f2¹ -> UnsafeEta
//│ deforest > function p¹#0 @ p² -> UnsafeEta
//│ deforest > function p¹#0 @ p³ -> UnsafeEta
//│ deforest > function p¹#0 @ p⁴ -> UnsafeEta
//│ deforest > call +⁰@result¹ @ <root> -> Pure
//│ deforest > call +⁰@result⁰ @ f2² -> Pure
//│ deforest > call +⁰@result⁰ @ f2¹ -> Pure
//│ deforest > call f1⁰@result⁴ @ <root> -> UnsafeEta
//│ deforest > call f2⁰@result² @ <root> -> UnsafeEta
//│ deforest > call p¹@result³ @ <root> -> UnsafeEta
//│ deforest > call p¹@result⁵ @ <root> -> UnsafeEta
//│ deforest > <<< effect-analysis results <<<
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = 4
