:expect 9
fun p(x) = A(x)
let one = p(1) in...
let two = p(2)
fun f1(p) = if p is A(a) then a + 1
fun f2(p) = if p is A(b) then b + 2
f1(one) + f2(one) + f2(two)
//│ deforest > >>> effect-analysis results >>>
//│ deforest > function f1⁰#0 @ f1² -> UnsafeEta
//│ deforest > function f1⁰#0 @ f1¹ -> UnsafeEta
