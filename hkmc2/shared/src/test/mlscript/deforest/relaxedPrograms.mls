// Branch body capturing mutable vars
:deforest
:expect 5
class C(n) with
  let _n = n
  fun get() =
    if AA(1) is AA(x) then
      let res = x + _n
      _n = _n + 1
      res
let c = C(1)
c.get() + c.get()
//│ deforest > >>> fusing >>>
//│ deforest > AA¹(1) ->
//│ deforest > 	match: scrut⁷
//│ deforest > 	fields: scrut⁷.x¹
//│ deforest > <<< fusing <<<
//│ = 5
//│ c = C(_)


// Private members are now visible outside the class
:deforest
module M with
  let _private = 3
  fun f() =
    if AA(1) is
      AA(a) then a + _private
M.f()
//│ deforest > >>> fusing >>>
//│ deforest > AA¹(1) ->
