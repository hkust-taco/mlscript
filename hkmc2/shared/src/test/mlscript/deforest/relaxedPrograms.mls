:deforest
:expect 5
data class AA(x)
class Store(n) with
  val nn = n
  fun get() =
    if AA(n) is AA(x) then x + nn
  fun foo(x) =
    if x is
      AA(x) then x + nn
val store = Store(1)
store.foo(AA(4))
//│ deforest > >>> fusing >>>
//│ deforest > AA⁰(Store⁰.this.n⁰) ->
//│ deforest > 	match: scrut⁰
//│ deforest > 	fields: scrut⁰.x⁰
//│ deforest > <<< fusing <<<
//│ = 5
//│ store = Store(_)




:deforest
:expect 5
:noInline
data class AA(x)
class Store(n) with
  fun get() =
    if AA(n) is AA(x) then x + n
  fun foo(x) =
    if x is
      AA(x) then x + n
val store = Store(1)
store.foo(AA(4))
//│ deforest > >>> fusing >>>
//│ deforest > AA¹(Store¹.this.n¹) ->
//│ deforest > 	match: scrut¹
//│ deforest > 	fields: scrut¹.x¹
//│ deforest > <<< fusing <<<
//│ = 5
//│ store = Store(_)







