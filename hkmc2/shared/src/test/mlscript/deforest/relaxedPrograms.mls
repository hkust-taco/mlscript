:js

:deforest
:expect 5
data class AA(x)
class Store(n) with
  fun get() =
    if AA(n) is AA(x) then x + n
  fun foo(x) =
    if x is
      AA(x) then x + n
val store = Store(1)
store.foo(AA(4))
//│ deforest > >>> fusing >>>
//│ deforest > AA⁰(n⁰) ->
//│ deforest > 	match: scrut⁰
//│ deforest > 	fields: scrut⁰.x⁰
//│ deforest > <<< fusing <<<
//│ = 5
//│ store = Store(_)







