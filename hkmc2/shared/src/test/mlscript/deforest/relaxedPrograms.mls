// Branch body capturing mutable vars
:deforest
:expect 5
class C(n) with
  let _n = n
  fun get() =
    if AA(1) is AA(x) then
      let res = x + _n
      _n = _n + 1
      res
let c = C(1)
c.get() + c.get()
//│ deforest > >>> effect-analysis results >>>
//│ deforest > call +@result @ <root> -> Pure
