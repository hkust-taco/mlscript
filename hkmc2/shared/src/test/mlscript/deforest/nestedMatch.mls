:expect "()()"
fun test(a, b) =
  let x
  if a is
    A then print("A")
    B then
      x = 1
  if b is
    A then
      x = 2
    B then print("B")
  print(x)
test(B, B) + test(A, A)
//│ deforest > >>> fusing >>>
//│ deforest > A⁰ ->
//│ deforest > 	match: a⁴
//│ deforest > A⁰ ->
//│ deforest > 	match: b⁰
//│ deforest > B⁰ ->
//│ deforest > 	match: a⁴
//│ deforest > B⁰ ->
//│ deforest > 	match: b⁰
//│ deforest > <<< fusing <<<
//│ > B
//│ > 1
//│ > A
//│ > 2
//│ = "()()"


// this misalign is fine
:deforest
:expect 20
fun prodDouble(x) = if x is
  0 then Nil
  n then n :: n :: prodDouble(n - 1)
fun sum(ls) = if ls is
  Nil then 0
  h :: t then h + sum(t)
sum(prodDouble(4))
//│ deforest > >>> fusing >>>
//│ deforest > Cons⁰(n⁰, tmp¹⁰) ->
//│ deforest > 	match: ls⁰
//│ deforest > 	fields: ls⁰.h⁰
//│ deforest > 	fields: ls⁰.t⁰
//│ deforest > Cons⁰(n⁰, tmp¹¹) ->
//│ deforest > 	match: ls⁰
//│ deforest > 	fields: ls⁰.h⁰
//│ deforest > 	fields: ls⁰.t⁰
//│ deforest > Nil⁰ ->
//│ deforest > 	match: ls⁰
//│ deforest > <<< fusing <<<
//│ = 20


// this misalign prevents fusion (consumer destructures 2 elements per step, producer emits 1)
:deforest
:expect 10
fun prod(x) = if x is
  0 then Nil
  n then n :: prod(n - 1)
fun cons(ls) = if ls is
  h1 :: h2 :: t then h1 + h2 + cons(t)
  _ then 0
cons(prod(4))
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = 10
