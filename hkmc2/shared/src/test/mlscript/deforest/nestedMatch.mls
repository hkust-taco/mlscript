//│ deforest > BB⁰(cc⁰) ->
//│ deforest > 	match: x1⁰
//│ deforest > 	fields: x1⁰.x²
//│ deforest > <<< fusing <<<
//│ = "ccf2f3cc"
//│ cc = CC("cc")



