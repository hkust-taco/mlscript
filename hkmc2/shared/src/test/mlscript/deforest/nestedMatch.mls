// only the match in the middle is fused
:expect "ccf2f3cc"
fun f1(x) = if x is
  AA(x1) then
    if x1 is
      BB(x2) then
        if x2 is
          CC(x3) then x3
fun f2(x) = if x is AA then "f2"
fun f3(x) = if x is CC then "f3" + x.x
fun aa(x) = AA(x)
let cc = CC("cc")
f1(aa(BB(cc))) + f2(aa(BB(CC(0)))) + f3(cc)
//│ deforest > ==============
