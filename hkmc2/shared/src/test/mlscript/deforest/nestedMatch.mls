:expect "()()"
fun test(a, b) =
  let x
  if a is
    A then print("A")
    B then
      x = 1
  if b is
    A then
      x = 2
    B then print("B")
  print(x)
test(B, B) + test(A, A)
//│ deforest > ==============
//│ deforest > Ref(member:A,Some(object:A)) ->
