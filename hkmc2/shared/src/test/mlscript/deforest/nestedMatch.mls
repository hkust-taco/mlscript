:expect 41
fun f(x, y, z, k) =
  let tmp = if z then BB(y + 1) else BB(y - 1)
  tmp.x + 
  if tmp is
    BB then
      let m = if x is
        AA then
          if AA(2) is
            AA(yf) then yf
      if AA(3) is
        AA then m + k
