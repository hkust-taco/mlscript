//│ deforest > Call(Ref(member:AA,Some((Fun)term:class:AA.AA)),List(Arg(None,Ref(var:x,None)))) ->
//│ deforest > 	Ref(var:x,None)
//│ deforest > 	Select(Ref(var:x,None),Ident(x))
//│ deforest > Call(Ref(member:BB,Some((Fun)term:class:BB.BB)),List(Arg(None,Ref(var:cc,None)))) ->
//│ deforest > 	Ref(var:x1,None)
//│ deforest > 	Select(Ref(var:x1,None),Ident(x))
//│ = "ccf2f3cc"
//│ cc = CC("cc")



