// need to include computations of `rest` from more than one levels of parent matches
:expect "105035"
fun test(x) =
  let t = if x is
    AA(AA(AA(a))) then a
    AA then "3"
  t + "5"
fun f(a) = if a is
  AA(AA) then "0"
let p = AA(AA(AA("10")))
test(p) + f(p) + test(AA(A))
