:expect 41
fun f(x, y, z, k) =
  let tmp = if z then BB(y + 1) else BB(y - 1)
  tmp.BB#x + 
  if tmp is
    BB then
      let m = if x is
        AA then
          if AA(2) is
            AA(yf) then yf
      if AA(3) is
        AA then m + k
f(AA(3), 3, true, 10) + f(AA(5), 4, false, 20)
//│ deforest > >>> fusing >>>
//│ deforest > AA⁰(2) ->
//│ deforest > 	match: scrut³
//│ deforest > 	fields: scrut³.x¹
//│ deforest > AA⁰(3) ->
//│ deforest > 	match: scrut⁴
//│ deforest > AA⁰(2) ->
//│ deforest > 	match: scrut³
//│ deforest > 	fields: scrut³.x¹
//│ deforest > AA⁰(3) ->
//│ deforest > 	match: scrut⁴
//│ deforest > AA⁰(5) ->
//│ deforest > 	match: x²⁰
//│ deforest > AA⁰(2) ->
//│ deforest > 	match: scrut³
//│ deforest > 	fields: scrut³.x¹
//│ deforest > AA⁰(3) ->
//│ deforest > 	match: scrut⁴
//│ deforest > AA⁰(3) ->
//│ deforest > 	match: x²⁰
//│ deforest > <<< fusing <<<
//│ = 41



