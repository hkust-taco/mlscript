// [FUSED PASS PR TODO]: all the eta expanded parameters can be dead-param-eliminated, but now param 1, 4, 5 are still considered live.
// Those are the parameters related to variables that could be locally scoped to a branch (they are assigned in branch body functions).
// Those parameters are detected to be dead by dpe after block simplifier, but now dpe is run before block simplifier.
// But instead of running an additional block simplifier before the fused pass, it'd be better to enable scoped branches to address this
:expect 3
:soir
:aggressive
// FIXME: Remove these @pure overrides when immutable list-field reads are inferred pure.
@annotations.pure fun append(xs, ys) = if xs is
  Nil then ys
  h :: t then h :: append(t, ys)
@annotations.pure fun flatten(xss) = if xss is
  Nil then Nil
  h :: t then append(h, flatten(t))
fun len(ls) = if ls is
  Nil then 0
  h :: t then 1 + len(t)
len(flatten(id((1 :: 2 :: Nil) :: (3 :: Nil) :: Nil)))
