:expect 3
:soir
fun append(xs, ys) = if xs is
  Nil then ys
  h :: t then h :: append(t, ys)
fun flatten(xss) = if xss is
  Nil then Nil
  h :: t then append(h, flatten(t))
fun len(ls) = if ls is
  Nil then 0
  h :: t then 1 + len(t)
len(flatten(id((1 :: 2 :: Nil) :: (3 :: Nil) :: Nil)))
