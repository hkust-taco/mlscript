//│ eta-expansion > <<< eta-expansion targets shapes <<<


:expect 15
:soir
fun enum(x) = if x < 0 then Nil else x :: enum(x - 1)
fun sum(ls, acc) = if ls is
  Nil then acc
  h :: t then sum(t, h + acc)
sum(enum(5), 0)
