let mkObj = (x: _, y: _, z: 3)
//│ mkObj = [function mkObj]

mkObj(1, 2)
//│ = {x: 1, y: 2, z: 3}

// * Note: this is parsed as `{let mkObj = x: _}, y: _, z: 3`
:fixme // shouldn't crash
// :e
// :slot
let mkObj = x: _, y: _, z: 3
//│ ═══[ERROR] Illegal position for '_' placeholder.
//│ mkObj = [function mkObj]
//│ /!!!\ Uncaught error: hkmc2.InternalError: Not in scope: y (class hkmc2.semantics.VarSymbol)

// mkObj(1, 2)

// :fixme // shouldn't crash
// :e
let mkObj =
  x: _, y: _, z: 3
//│ mkObj = [function mkObj]

// :fixme // shouldn't crash
mkObj(1, 2)
//│ = {x: 1, y: 2, z: 3}


let obj = f: _ + 1
//│ obj = {f: [function f]}

obj.f(123)
//│ = 124

{f: _ + 1}.f(123)
//│ = 124


