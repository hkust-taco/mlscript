(x =>
  fun y = x(y)
  y )
//│ Parsed Core: λx. (let y = x y in y)
//│ Inferred: x -> ∀y. ∀α. (x)^m1 ≤ (y)^m2 -> α => α ≤ y => (y)^m3
//│ As term: λx -> (let y = (let α = x y in α) in y)
//│ |> x
//│ ====== (1) ======
//│ Front: x
//│ Rule: C-Promote
//│ Remaining: 0
//│ ====== Final ======

let a = b
let b = let d = a in b
let c = b in c
//│ Parsed Core: let a = b; b = (let d = a in b); c = b in c
//│ Inferred: (c)^m5
