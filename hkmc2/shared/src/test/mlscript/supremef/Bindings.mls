let id(x) = x in id
//│ Parsed Core: let id = λx. x in id
//│ Inferred: (id)^m2
//│ As term: id
//│ |> id, ∀x. x -> (x)^m1 ≤ id
//│ ====== (1) ======
//│ Front: id
//│ Rule: C-Promote
//│ Remaining: 1
//│ ====== (2) ======
//│ Front: ∀x. x -> (x)^m1 ≤ id
//│ Rule: C-App2
//│ Remaining: 0
//│ ====== Final ======
//│ -------- LBS --------
//│ id ≥ ∀x. x -> (x)^m1
//│ ---------------------

