//│ |> x
//│ ====== (1) ======
//│ Front: x
//│ Rule: C-Promote
//│ Remaining: 0
//│ ====== Final ======

let a = b
let b = let d = a in b
let c = b in c
//│ Parsed Core: let a = b; b = (let d = a in b); c = b in c
