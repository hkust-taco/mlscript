data class C[A](m: A, n: A -> Int)
//│ Type: ⊤


fun f: [A] -> ([B] -> (C[out B] & A) -> B) -> A -> Int
f
//│ Type: ['A] -> (['B] -> (C[out 'B] ∧ 'A) ->{⊥} 'B) ->{⊥} ('A) ->{⊥} Int

fun g: [D] -> C[in Int out D] -> D
g
//│ Type: ['D] -> (C[in Int out 'D]) ->{⊥} 'D


f(g)
