fun annohelper: [outer, T extends outer] -> Region[T] ->{T} Pair[out Ref[Int, out T], out Ref[Int, out Any]]
fun annohelper(r1) =
  region r2 in
    fork((_ => r1.ref 1), (_ => r2.ref 2))
annohelper
//│ Type: forall 'T: (Region['T]) ->{'T} Pair[out Ref[Int, out 'T], out Ref[Int, ?]]
//│ Where:
//│   'T <: env@outer


