//│ Type: forall 'reg, 'reg1: Region[in 'reg out 'reg1] ->{'reg1} Pair[out Ref[Int, out 'reg1], out Ref[Int, out ¬outerhelper]]
//│ Where:
//│   'reg <: outerhelper
//│   'reg <: 'reg1


