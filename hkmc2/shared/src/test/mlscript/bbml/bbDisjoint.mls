region x in
  region y in
    fork((_ => x.ref 1), (_ => y.ref 2))
//│ Type: Pair[out Ref[Int, ?], out Ref[Int, ?]]


let naive_helper = r1 => // cannot infer the outer variable!
  region r2 in
    fork((_ => r1.ref 1), (_ => r2.ref 2))
