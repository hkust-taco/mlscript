fun id: [A] -> A -> A
fun id(x) = x
//│ Type: ⊤


run(x `=> id(x) `* x)
//│ Type: Int -> Int

:fixme
fun assertNotZero: [C] -> CodeBase[out Num, out C, out Any] -> CodeBase[out Num, out C, out Any]
fun assertNotZero(x) =
  `if (x `== `0.0) then `error else x
let checkedDiv = x `=> y `=> x `/. (assertNotZero(y))
run(checkedDiv)
