//│   'cde1#Int ∨ 'y1#Int ∨ 'cde2#Int ∨  ∧ Int<:'app ∧ ⊥<:⊥
//│   'cde1#Int ∨ 'cde2#Int ∨  ∧ Int<:'app ∧ ⊥<:⊥
//│   'y <: Int
//│   'y <: 'y1
//│   'y1 <: ¬(¬{Int})
//│   'y1 <: 'cde2
//│   'cde2 <: ¬(¬{Int})
//│   'cde3 <: 'cde
//│   'app <: ¬(¬'cde3)



(x, y) `=> x `+ y
//│ Type: CodeBase[out ('x, 'y) -> 'cde, ⊥, ?]
//│ Where:
//│   'x <: Int
//│   'x#Int ∨ 'cde1#Int ∨ 'y#Int ∨ 'cde2#Int ∨  ∧ Int<:'app ∧ ⊥<:⊥
