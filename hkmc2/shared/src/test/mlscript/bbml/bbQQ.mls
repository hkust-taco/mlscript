//│   'cde1 <: ¬(¬{Int})
//│   'cde1#Int ∨ 'y#Int ∨ 'cde2#Int ∨  ∧ Int<:'app ∧ ⊥<:⊥
//│   'cde1#Int ∨ 'cde2#Int ∨  ∧ Int<:'app ∧ ⊥<:⊥
//│   'y <: Int
//│   'y <: 'cde2
//│   'cde2 <: ¬(¬{Int})
//│   'cde3#'cde3 ∨ (  'cde3#Int ∨ 'z#Int ∨ 'cde4#Int ∨  ∧ Int<:'app1 ∧ ⊥<:⊥) ∧ (  'cde3#Int ∨ 'cde4#Int ∨  ∧ Int<:'app1 ∧ ⊥<:⊥) ∧ {0: 'cde3, 1: 'cde4}<:{0: Int, 1: Int}
//│   'z <: 'cde4
//│   'app1 <: ¬(¬'cde)
//│   'app <: ¬(¬'cde3)

f `=> x `=> y `=> f`(x, y)
//│ Type: CodeBase[out (('x, 'y) -> 'app) -> ('x -> ('y -> 'app)), ⊥, ?]

