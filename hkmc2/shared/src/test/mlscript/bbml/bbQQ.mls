//│   'cde1 <: ¬(¬{Int})
//│   'cde1#Int ∨ 'y#Int ∨ 'cde2#Int ∨  ∧ Int<:'app ∧ ⊥<:⊥
//│   'cde1#Int ∨ 'cde2#Int ∨  ∧ Int<:'app ∧ ⊥<:⊥
//│   'y <: Int
//│   'y <: 'cde2
//│   'cde2 <: ¬(¬{Int})
//│   'app <: ¬(¬'cde)


(x, y, z) `=> x `+ y `+ z
//│ Type: CodeBase[out ('x, 'y, 'z) -> 'cde, ⊥, ?]
//│ Where:
//│   'x <: Int
//│   'x#Int ∨ 'cde1#Int ∨ 'y#Int ∨ 'cde2#Int ∨  ∧ Int<:'app ∧ ⊥<:⊥
