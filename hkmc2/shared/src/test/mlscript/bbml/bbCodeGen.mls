fun pow(x) = case
  0 then 1
  n then x * pow(x)(n-1)
//│ JS (unsanitized):
//│ let pow;
//│ pow = function pow(x1) {
//│   let lambda1;
//│   lambda1 = (undefined, function (caseScrut) {
//│     let n, tmp, tmp1, tmp2;
//│     if (caseScrut === 0) {
//│       return 1
//│     } else {
//│       n = caseScrut;
//│       tmp = pow(x1);
//│       tmp1 = n - 1;
//│       tmp2 = runtime.safeCall(tmp(tmp1));
//│       return x1 * tmp2
//│     }
//│   });
//│   return lambda1
//│ };
//│ Type: ⊤


