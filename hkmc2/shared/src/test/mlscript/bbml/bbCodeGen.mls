//│ Type: Bool


:sjs
fun fact = case
  0 then 1
  n then n * fact(n - 1)
//│ JS (unsanitized):
//│ let fact;
//│ fact = function fact() {
//│   let lambda1;
//│   lambda1 = (undefined, function (caseScrut) {
