:sjs
fun pow(x) = case
  0 then 1
  n then x * pow(x)(n-1)
//│ JS:
//│ function pow(...args) {
//│   globalThis.Predef.checkArgs("pow", 1, args.length);
//│   let x = args[0];
//│   return (...args1) => {
//│     globalThis.Predef.checkArgs("", 1, args1.length);
