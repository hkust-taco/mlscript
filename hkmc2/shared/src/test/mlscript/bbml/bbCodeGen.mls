:sjs
fun fact = case
  0 then 1
  n then n * fact(n - 1)
//│ JS:
//│ Object.defineProperty(this, 'fact', { get: function() { 
//│   return (...args) => {
//│     globalThis.Predef.checkArgs("", 1, args.length);
//│     let caseScrut = args[0];
//│     let n, tmp, tmp1;
//│     if (caseScrut === 0) {
//│       return 1;
//│     } else {
//│       n = caseScrut;
//│       tmp = n - 1;
//│       tmp1 = globalThis.fact(tmp);
//│       return n * tmp1;
//│     }
//│   }; }});
//│ undefined
//│ Type: ⊤


fact(3)
//│ = 6
//│ Type: Int


