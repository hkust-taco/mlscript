//│       n = caseScrut;
//│       tmp1 = fact();
//│       tmp2 = n - 1;
//│       tmp3 = tmp1(tmp2);
//│       return n * tmp3
//│     }
//│   });
//│   return lambda1
//│ };
//│ Type: ⊤


:expect 6
fact(3)
//│ = 6
//│ Type: Int


