//│     if (caseScrut === 0) {
//│       return 1
//│     } else {
//│       n = caseScrut;
//│       tmp = pow(x1);
//│       tmp1 = n - 1;
//│       tmp2 = runtime.safeCall(tmp(tmp1));
//│       return x1 * tmp2
//│     }
//│   });
//│   return lambda1
//│ };
//│ Type: ⊤


