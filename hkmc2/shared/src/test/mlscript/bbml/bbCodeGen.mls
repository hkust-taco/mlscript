fun nott = case
  true then false
  false then true
//│ JS (unsanitized):
//│ let nott;
//│ nott = function nott() {
//│   let lambda1;
//│   lambda1 = (undefined, function (caseScrut) {
//│     switch (caseScrut) {
//│       case true:
//│         return false;
