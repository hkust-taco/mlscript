//│       return 1;
//│     } else {
//│       n = caseScrut;
//│       tmp = globalThis.pow(x);
//│       tmp1 = n - 1;
//│       tmp2 = tmp(tmp1);
//│       return x * tmp2;
//│     }
//│   };
//│ }
//│ undefined
//│ Type: ⊤


