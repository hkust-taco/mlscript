:js
:effectHandlers debug
:lift


abstract class ThreadEffect with
  fun fork(thread: () -> ()): ()
  fun yld(): ()


fun f(h: ThreadEffect, x)() =
  print("f " + x)
  h.yld()
  print("f " + x)
  h.yld()
  print("f " + x)

fun main(h: ThreadEffect) =
  print("main start")
  h.fork(f(h, 0))
  h.fork(f(h, 1))
  h.fork(f(h, 2))
  print("main end")


// task queue
let tasks = mut []
fun drain() =
  while tasks.length != 0 do
    tasks.pop(){as Function}()
//│ tasks = []


// LIFO
:re
handle h = ThreadEffect with
  fun fork(thread)(k) =
    tasks.push(thread)
    k()
    drain()
  fun yld()(k) =
    tasks.unshift(k)
    drain()
in
  main(h)
//│ > main start
//│ > main end
//│ > f 2
//│ ═══[RUNTIME ERROR] Error: Unhandled effect Handler$h$
//│ 	at f (UserThreadsUnsafe.mls:14:3)
//│ 	at drain (UserThreadsUnsafe.mls:31:5)
//│ 	at Handler$h$fork (UserThreadsUnsafe.mls:40:5)
//│ 	at Handler$h$fork (UserThreadsUnsafe.mls:40:5)


// FIFO
:re
handle h = ThreadEffect with
  fun fork(thread)(k) =
    tasks.unshift(thread)
    k()
    drain()
  fun yld()(k) =
    tasks.unshift(k)
    drain()
in
  main(h)
//│ > main start
//│ > main end
//│ > f 1
//│ ═══[RUNTIME ERROR] Error: Unhandled effect Handler$h$
//│ 	at f (UserThreadsUnsafe.mls:14:3)
//│ 	at drain (UserThreadsUnsafe.mls:31:5)
//│ 	at Handler$h$fork (UserThreadsUnsafe.mls:62:5)
//│ 	at Handler$h$fork (UserThreadsUnsafe.mls:62:5)


