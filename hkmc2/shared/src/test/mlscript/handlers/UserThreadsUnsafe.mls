:js
:effectHandlers


class ThreadEffect with
  fun fork(thread: () -> ()): ()
  fun yld(): ()


fun f(h, x)() =
  print("f " + x)
  h.yld()
  print("f " + x)
  h.yld()
  print("f " + x)

fun main(h) =
  print("main start")
  h.fork(f(h, 0))
  h.fork(f(h, 1))
  h.fork(f(h, 2))
  print("main end")


// task queue
let tasks = []
fun drain() =
  while tasks.length != 0 do
    tasks.pop()()
//│ tasks = []


// LIFO
:re
handle h = ThreadEffect with
  fun fork(thread)(k) =
    tasks.push(thread)
    k()
    drain()
  fun yld()(k) =
    tasks.unshift(k)
    drain()
in
  main(h)
//│ > main start
//│ > main end
//│ > f 2
//│ ═══[RUNTIME ERROR] Error: Unhandled effect Handler$h$
//│ 	at Cont$func$f$UserThreadsUnsafe$_mls_L10_4_89$(pc=1)
//│ 	at Cont$func$drain$UserThreadsUnsafe$_mls_L26_19_75$(pc=2)
//│ 	at Cont$handler$h$fork$UserThreadsUnsafe$_mls_L35_35_95(pc=3)
//│ 	at Cont$handler$h$fork$UserThreadsUnsafe$_mls_L35_35_95(pc=3)​
//│ ​Error: Unhandled effects


// FIFO
:re
handle h = ThreadEffect with
  fun fork(thread)(k) =
    tasks.unshift(thread)
    k()
    drain()
  fun yld()(k) =
    tasks.unshift(k)
    drain()
in
  main(h)
//│ > main start
//│ > main end
//│ > f 1
//│ ═══[RUNTIME ERROR] Error: Unhandled effect Handler$h$
//│ 	at Cont$func$f$UserThreadsUnsafe$_mls_L10_4_89$(pc=1)
//│ 	at Cont$func$drain$UserThreadsUnsafe$_mls_L26_19_75$(pc=2)
//│ 	at Cont$handler$h$fork$UserThreadsUnsafe$_mls_L58_35_98(pc=3)
//│ 	at Cont$handler$h$fork$UserThreadsUnsafe$_mls_L58_35_98(pc=3)​
//│ ​Error: Unhandled effects


