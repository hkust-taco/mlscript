:stackSafe 42
hi(0)
//│ /!!!\ Option ':stackSafe' requires ':effectHandlers' to be set
//│ = 0


:stackSafe 1000
:effectHandlers
:expect 100010000
fun sum(n) =
  if n == 0 then 0
  else
    n + sum(n - 1)
fun bad() = sum(10000) + sum(10000)
bad()
//│ = 100010000

