:js
:effectHandlers

abstract class Effect with
  fun f(): ()

// TODO: implement non local return, Bye! should not be printed
:w
fun f() =
  handle h = Effect with
    fun foo()(r) =
      let m = r(())
      print("Bye!") // This never executes because `r` returns from `f`
      m
  h.foo()
  return 3 // Note: changing this to just `3` leads to `print("Bye!")` executing
f()
//│ ╔══[WARNING] Non local return will be treated as a local return.
//│ ║  l.16: 	  return 3 // Note: changing this to just `3` leads to `print("Bye!")` executing
//│ ╙──      	         ^
//│ > Bye!
//│ = 3

:w
fun f() =
  handle h = Effect with
    fun foo()(r) =
      let m = r()
      print("Bye!")
      m
  in
    h.foo()
    return 3
  10
//│ ╔══[WARNING] Non local return will be treated as a local return.
//│ ║  l.33: 	    return 3
//│ ╙──      	           ^

