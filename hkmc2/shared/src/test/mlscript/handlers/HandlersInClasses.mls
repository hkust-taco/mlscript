data class Lol() with
  handle h = Effect with
    fun perform(arg)(k) =
      print(arg)
      "B"
  print(h.perform("A"))
  val x = 123

// * Note: does NOT return a partially initialized object
let oops = Lol()
//│ > A
//│ oops = Lol()

