:js
:lift
:effectHandlers

import "fs"

open annotations

:sir
@async
fun f(print_result) =
  print("Hello, world!")
  let r = await(fs.promises.readFile("./README.md"))
  let readme = r.toString()
  let first = readme.slice(0, readme.indexOf("\n"))
  if print_result do
    print(first)
  first
