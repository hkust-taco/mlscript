:js
:lift
:effectHandlers

import "fs"

open annotations

@async
fun f(print_result) =
  print("Hello, world!")
  let r = await(fs.promises.readFile("./README.md"))
  let readme = r.toString()
  let first = readme.slice(0, readme.indexOf("\n"))
  if print_result do
    print(first)
  first

// Should get a promise here, the promise is used for JavaScript interop
:sjs
f(false)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let inlinedVal, tmp;
//│ runtime.resetEffects();
//│ tmp = f1(false);
//│ inlinedVal = runtime.toJsAsync(tmp);
//│ if (runtime.curEffect === null) { return inlinedVal }
//│ return runtime.topLevelEffect(false);
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > Hello, world!
//│ = Promise {}


// :await will await the promise returned at the top level for the repl
:sjs
:await
f(true)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let inlinedVal1, tmp1;
//│ runtime.resetEffects();
//│ tmp1 = f1(true);
//│ inlinedVal1 = runtime.toJsAsync(tmp1);
//│ if (runtime.curEffect === null) { return inlinedVal1 }
//│ return runtime.topLevelEffect(false);
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > Hello, world!
//│ > # MLscript
//│ = "# MLscript"
