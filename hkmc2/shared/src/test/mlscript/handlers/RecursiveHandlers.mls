let str = ""
if true do
  handle h1 = Effect with
    fun perform(arg)(k) =
      set str += "A"
      k(arg)
      set str += "A"
  handle h2 = Effect with
    fun perform(arg)(k) =
      set str += str + "B"
      k(arg)
      set str += str + "B"
  h2.perform(())
  h1.perform(())
