:js
:effectHandlers


abstract class Effect[A] with
  fun perform(arg: A): A


handle h1 = Effect with
  fun perform(arg)(k) =
    print("performing " + arg)
    [k("ok")]
h1.perform("hi")
h1.perform("hello")
//│ > performing hi
//│ > performing hello
//│ = [["ok"]]

:e
h1
