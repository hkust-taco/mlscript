:re
fun lambda_test(f) =
  f()
  200
lambda_test(() =>
  raiseUnhandledEffect()
  100)
//│ ═══[RUNTIME ERROR] Error: Unhandled effect FatalEffect
//│ 	at lambda (pc=undefined)
//│ 	at lambda_test (pc=undefined)


import "../../mlscript-compile/Runtime.mls"

:silent
let res = Runtime.try(f)

res.reified.contTrace.next.getLocals

Runtime.debugEff(res.reified)
//│ > Debug EffectSig:
//│ > handler:  FatalEffect
//│ > handlerFun:  null
//│ > resumed:  false
//│ > <lastHandler is self>
//│ > FunctionContFrame(pc=undefined, last) -> (null)
//│ > 

res.resumeWith(42)
//│ > 42
//│ = Infinity



class Debugger() with
  fun break(payload)

module Test with
  fun test(j, dbg) =
    let i = 0
    let k = 2000
    if i == 0 do
      set i = dbg.break("whoops")
    j / i
  fun main(dbg) =
    test(12, dbg) + test(34, dbg)

let res =
  handle h = Debugger with
    fun break(payload)(resume) = resume
  Runtime.try(() => Test.main(h))
//│ res = EffectHandle(_)

:re
res.raise()
//│ ═══[RUNTIME ERROR] Error: Unhandled effect Handler$h$

set res = res.resumeWith(42)

:re
res.raise()
//│ ═══[RUNTIME ERROR] Error: Unhandled effect Handler$h$

res.resumeWith(666)
//│ = 0.33676533676533676

let i = 100
fun f() =
  let j = 200
  debug.printStack(true)
  set j = 300
  debug.printStack(false)
  debug.printStack(true)
//│ i = 100

f()
//│ > Stack Trace:
//│ > 	at f (pc=undefined) with locals: j=200
