:js


// * This feature relies on `finally`
:sjs
let x = 1
set x += 1 in print(x)
x
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let x, old, tmp;
//│ x = 1;
//│ old = x;
//│ try { tmp = x + 1; x = tmp; Predef.print(x); } finally { x = old; }
//│ x
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ = 1
//│ x = 1


// * But `finally` is not yet supported by effect handlers

:todo
:effectHandlers
:lift
let x = 1
handle h = Object with
  fun test()(k) =
    print("SUSPENDING")
    let res = k(42)
    print("DONE")
    res
set x += 1 in
  print("init")
  print(h.test())
  print(x)
  print("end")
x
//│ ╔══[COMPILATION ERROR] Backtracking assignment is not supported with effect handlers enabled
