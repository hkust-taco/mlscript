:js
:effectHandlers


// * This feature relies on `finally`
:sjs
let x = 1
set x += 1 in print(x)
x
//│ JS (unsanitized):
//│ let tmp, tmp1, x, old, tmp2;
//│ x = 1;
//│ old = x;
//│ try {
//│   tmp = x + 1;
//│   x = tmp;
//│   tmp1 = Predef.print(x);
//│   if (tmp1 instanceof runtime.EffectSig.class) {
//│     tmp1 = runtime.topLevelEffect(tmp1, false);
//│   }
//│   tmp2 = tmp1;
//│ } finally { x = old; }
//│ x
//│ > 2
//│ = 1
//│ x = 1


// * But `finally` is not yet supported by effect handlers

:todo
let x = 1
handle h = Object with
  fun test()(k) =
    print("SUSPENDING")
    let res = k(42)
    print("DONE")
    res
set x += 1 in
  print("init")
  print(h.test())
  print(x)
  print("end")
x
