:js
:effectHandlers
:lift


abstract class Effect with
  fun perform(arg: Str): Str


// non-resumptive handlers
handle h = Effect with
  fun perform(arg)(k) =
    "A"
h.perform("B")
let x = 123
//│ = "A"

:e
x
//│ ╔══[ERROR] Name not found: x
//│ ║  l.19: 	x
//│ ╙──      	^


handle h = Effect with
  fun perform(arg)(k) =
    print(arg)
let x = 123
x + 1
//│ = 124

:e
x
//│ ╔══[ERROR] Name not found: x
//│ ║  l.33: 	x
//│ ╙──      	^


handle h = Effect with
  fun perform(arg)(k) =
    print(arg)
val y = 123

:e
y
//│ ╔══[ERROR] Name not found: y
//│ ║  l.45: 	y
//│ ╙──      	^


