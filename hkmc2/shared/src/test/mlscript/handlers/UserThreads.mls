let exchanger = None
//│ exchanger = None

fun start(thread: ThreadEffect -> ()) =
  handle h = ThreadEffect with
    fun fork(new_thread)(k) =
      enqueue(k, ())
      start(new_thread)
    fun yld()(k) =
      enqueue(k, ())
      dequeue()
    fun xchg(x)(k) =
      if exchanger is
        Some([y, k1]) then
          set exchanger = None
          enqueue(k1, x)
          k(y)
        None then
          set exchanger = Some([x, k])
          dequeue()
  in
    thread(h)
  dequeue()
