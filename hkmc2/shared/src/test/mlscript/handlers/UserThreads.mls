:js
:effectHandlers

abstract class ThreadEffect with
  val tasks = []
  fun start(thread: ThreadEffect -> ()): ()
  fun fork(thread: ThreadEffect -> ()): ()
  fun yld(): ThreadEffect

class Lock(locked) with
  fun lock(th: ThreadEffect) =
    while locked do
      th.yld()
    set locked = true
  fun unlock() =
    set locked = false

fun f(x)(h) =
  print("f " + x)
  h.yld()
  print("f " + x)
  h.yld()
  print("f " + x)

fun main(h) =
  print("main start")
  h.fork(f(0))
  h.fork(f(1))
  h.fork(f(2))
  print("main end")


// LIFO
handle h = ThreadEffect with
  fun fork(thread)(k) =
    this.tasks.unshift(thread)
    k(())
  fun yld()(k) =
    this.tasks.push(k)
    globalThis.eval("runtime").enterHandleBlock(this, () => this.tasks.shift()(this))
  fun start(main)(k) =
    this.tasks.push(main)
    while this.tasks.length != 0 do
      globalThis.eval("runtime").enterHandleBlock(this, () => this.tasks.shift()(this))
    k()
in
  h.start(main)
//│ > main start
//│ > main end
//│ > f 2
//│ > f 1
//│ > f 0
//│ > f 2
//│ > f 1
//│ > f 0
//│ > f 2
//│ > f 1
//│ > f 0


// FIFO
handle h = ThreadEffect with
  fun fork(thread)(k) =
    this.tasks.push(thread)
    k(())
  fun yld()(k) =
    this.tasks.push(k)
    globalThis.eval("runtime").enterHandleBlock(this, () => this.tasks.shift()(this))
  fun start(main)(k) =
    this.tasks.push(main)
    while this.tasks.length != 0 do
      globalThis.eval("runtime").enterHandleBlock(this, () => this.tasks.shift()(this))
    k()
in
  h.start(main)
//│ > main start
//│ > main end
//│ > f 0
//│ > f 1
//│ > f 2
//│ > f 0
//│ > f 1
//│ > f 2
//│ > f 0
//│ > f 1
//│ > f 2


// Adapted from: https://ocaml.org/manual/5.3/effects.html

abstract class ThreadEffect with
  fun fork(thread: ThreadEffect -> ()): ()
  fun yld(): ()

val tasks = []
//│ tasks = []

fun dequeue() =
  if tasks.length != 0 do
    tasks.shift()()

fun start(thread: ThreadEffect -> ()) =
  handle h = ThreadEffect with
    fun fork(new_thread)(k) =
      tasks.push(k)
      start(new_thread)
    fun yld()(k) =
      tasks.push(k)
      dequeue()
  in
    thread(h)
  dequeue()

start(main)
//│ > main start
//│ > f 0
//│ > f 1
//│ > f 0
//│ > f 2
//│ > f 1
//│ > f 0
//│ > main end
//│ > f 2
//│ > f 1
//│ > f 2


import "../../mlscript-compile/Option.mls"
open Option

abstract class ThreadEffect with
  fun fork(thread: ThreadEffect -> ()): ()
  fun yld(): ()
  fun xchg(x: Int): Int

val tasks = []
fun enqueue(k) =
  tasks.push(k)
fun dequeue() =
  if tasks.length != 0 do
    tasks.shift()()
//│ tasks = []

class Tuple2(a, b)
let exchanger = None
//│ exchanger = None

fun start(thread: ThreadEffect -> ()) =
  handle h = ThreadEffect with
    fun fork(new_thread)(k) =
      enqueue(k)
      start(new_thread)
    fun yld()(k) =
      enqueue(k)
      dequeue()
    fun xchg(x)(k) =
      if exchanger is
        Some(Tuple2(y, k1)) then
          set exchanger = None
          enqueue(k1.bind(null, x))
          k(y)
        None then
          set exchanger = Some(Tuple2(x, k))
          dequeue()
  in
    thread(h)
  if tasks.length != 0 do
    tasks.shift()()

fun main(h) =
  h.fork(h =>
    print("[t1] Sending 0")
    let v = h.xchg(0)
    print("[t1] received " + v.toString()))
  h.fork(h =>
    print("[t2] Sending 1")
    let v = h.xchg(1)
    print("[t2] received " + v.toString()))

start(main)
//│ > [t1] Sending 0
//│ > [t2] Sending 1
//│ > [t2] received 0
//│ > [t1] received 1
