:js
:effectHandlers


class ThreadEffect with
  // task queue
  val tasks = []
  fun drain() =
    while tasks.length != 0 do
      tasks.pop()()
  fun fork(thread: () -> ()): ()
  fun yld(): ()


fun f(h, x)() =
  print("f " + x)
  h.yld()
  print("f " + x)
  h.yld()
  print("f " + x)

fun main(h) =
  print("main start")
  h.fork(f(h, 0))
  h.fork(f(h, 1))
  h.fork(f(h, 2))
  print("main end")


// LIFO
:re
handle h = ThreadEffect with
  fun fork(thread)(k) =
    this.tasks.push(thread)
    k()
    this.drain()
  fun yld()(k) =
    this.tasks.unshift(k)
    this.drain()
in
  main(h)
//│ > main start
//│ > main end
//│ > f 2
//│ ═══[RUNTIME ERROR] Error: Unhandled effect Handler$h$
//│ 	at Cont$func$f$UserThreadsSafe$_mls_L15_4_89$(pc=1)
//│ 	at Cont$func$drain$UserThreadsSafe$_mls_L5_63_123$(pc=2)
//│ 	at Cont$handler$h$UserThreadsSafe$_mls_L32_35_105(pc=4)
//│ 	at Cont$handler$h$UserThreadsSafe$_mls_L32_35_105(pc=4)​
//│ ​Error: Unhandled effects


// FIFO
:re
handle h = ThreadEffect with
  fun fork(thread)(k) =
    this.tasks.unshift(thread)
    k()
    this.drain()
  fun yld()(k) =
    this.tasks.unshift(k)
    this.drain()
in
  main(h)
//│ > main start
//│ > main end
//│ > f 0
//│ ═══[RUNTIME ERROR] Error: Unhandled effect Handler$h$1
