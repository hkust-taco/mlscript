// Getter
:fixme
handle h = Object with
  fun lol(k) = k(())
h.lol
//│ ═══[RUNTIME ERROR] Error: Unhandled effect Handler$h$6

handle h = Object with
  fun lol()(k) = k(42)
h.lol()
val x = 1

:noSanityCheck
object Foo with
  handle h = Object with
    fun lol()(k) = k(42)
  val x = h.lol()
  x + 1

:e
:re
Foo.x
