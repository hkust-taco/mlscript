:js
:effectHandlers
:lift
:noSanityCheck

class Object

handle h = Object with {}
h.oops

handle h = Object with {}
val x = 1

handle h = Object with {}
val x = 1
x + 1
//│ = 2

:e
x
//│ ╔══[ERROR] Name not found: x
//│ ║  l.20: 	x
//│ ╙──      	^


// Getter
handle h = Object with
  fun lol(k) = k(())
h.lol

handle h = Object with
  fun lol()(k) = k(42)
h.lol()
val x = 1

object Foo with
  handle h = Object with
    fun lol()(k) = k(42)
  val x = h.lol()
  x + 1

:e
Foo.x
//│ ╔══[ERROR] Object 'Foo' does not contain member 'x'
//│ ║  l.43: 	Foo.x
//│ ╙──      	   ^^


