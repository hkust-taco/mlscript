:expect 100
fun f() =
  if true do
    let f = null
    let done = false
    while not(done) do
      set
        f = () => return 100
        done = true
    f()
    print("Bad")
f()
//│ = 100

:expect 2
fun f() =
  // * A partial application is a lambda, so this is a non-local return
  let g = tuple(., return 2)
  g(1)
  print("Bad")
  3
f()
//│ = 2

:expect 2
fun f() =
  // * An implicit lambda is a lambda, so this is a non-local return
  let g = tuple(_, return 2)
  g(1)
  print("Bad")
  3
f()
//│ = 2

:expect 5
do lbl:
  // * Similarly, this is a non-local break
  let g = tuple(_, lbl.break(5))
  g(0)
  print("Bad")
  0
//│ = 5

