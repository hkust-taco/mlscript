:js
:effectHandlers
:lift


fun f() =
  (() => return 100)()
  print("Bad")
f()
//│ = 100


fun foo(x) =
  let xs = [() => return x + 1]
  xs.0()

foo(123)
//│ = 124


:expect 123
fun f() =
  let lam = () => return 123
  fun g() =
    let lam2 = () => return 200
    lam()
    lam2()
    100
  print("Ok")
  g()
  print("Bad")
  100
f()
//│ > Ok
//│ = 123

:expect 100
fun f() =
  let lam = () => return 123
  fun g() =
    let lam2 = () => return 200
    lam2()
    lam()
    100
  print("Ok")
  print(g())
  print("Continue")
  100
f()
//│ > Ok
//│ > 200
//│ > Continue
//│ = 100


:re
fun f() = () => return 3
f()()
//│ ═══[RUNTIME ERROR] Error: Unhandled effect $_non$_local$_return$_effect$_12

:re
fun f(): () -> Int = () => return () => 3
f()()
//│ ═══[RUNTIME ERROR] Error: Unhandled effect $_non$_local$_return$_effect$_14


