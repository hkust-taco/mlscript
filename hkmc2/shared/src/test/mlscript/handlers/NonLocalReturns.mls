:expect 100
fun f() =
  if true do
    let f = null
    let done = false
    while not(done) do
      set
        f = () => return 100
        done = true
    f()
    print("Bad")
f()
//│ = 100

// broken due to handlers currently not handling `object` properly
:fixme
:expect 100
fun f() =
  object A with
    return 100
  4
f()
//│ ═══[COMPILATION ERROR] No definition found in scope for member 'nonLocalRetHandler$f'
//│ ═══[RUNTIME ERROR] ReferenceError: nonLocalRetHandler$f is not defined
//│ ═══[RUNTIME ERROR] Expected: '100', got: 'undefined'

// ctor cannot raise effect, so error is expected.
:fixme
:expect 100
fun f() =
  class A with
    return 100
  new A
f()
