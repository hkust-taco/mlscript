fun permutations(gen, l) =
  permutations_impl(gen, Nil, l)

let result =
  handle gen = Generator with
    fun produce(result)(resume) =
      print(result)
      let r = resume(())
      result :: r
  permutations(gen, 1 :: 2 :: 3 :: 4 :: Nil), Nil
in length(result)
