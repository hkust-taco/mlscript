:js
:effectHandlers

import "../../mlscript-compile/Stack.mls"
open Stack

class Generator with
  fun produce(result: Stack[Int]): ()

fun (++) concat(l1, l2) =
  if l1 is 
    Nil then l2
    Cons(h, t) then Cons(h, t ++ l2)
