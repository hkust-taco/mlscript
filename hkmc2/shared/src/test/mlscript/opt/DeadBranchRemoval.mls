:js

#config(deadBranchRemoval: true)


data class C(a)
data class D(b)
data class E(c)

if true then 1 else 0
//│ = 1

// * Properly removes the `D` branch and the whole match
// :dopt
:soir
if C(123) is
  C(x) then print(x)
  D(y) then print(y)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, arg$D$0$, arg$C$0$;
//│ set scrut = C⁰(123);
//│ match scrut
//│   C¹ =>
//│     set arg$C$0$ = scrut.a⁰;
//│     return Predef⁰.print⁰(arg$C$0$)
//│   D⁰ =>
//│     set arg$D$0$ = scrut.b⁰;
//│     return Predef⁰.print⁰(arg$D$0$)
//│   else
//│     throw new globalThis⁰.Error⁰("match error")
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123

// * Properly removes the `else` branch
:soir
if C(123) is
  C(x) then print(x)
  else print("?")
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, arg$C$0$;
//│ set scrut = C⁰(123);
//│ match scrut
//│   C¹ =>
//│     set arg$C$0$ = scrut.a⁰;
//│     return Predef⁰.print⁰(arg$C$0$)
//│   else
//│     return Predef⁰.print⁰("?")
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123

// :dopt
let c = if hide(true) then C(123) else D(456)
in if c is
  C(x) then print(x)
  else print("?")
//│ > 123

// * Properly removes the `E` branch
:soir
let c = if hide(true) then C(123) else D(456)
in if c is
  C(x) then print(x)
  D(y) then print(y)
  E(z) then print(z)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, tmp, arg$E$0$, arg$D$0$, arg$C$0$;
//│ set scrut = Predef⁰.hide⁰(true);
//│ match scrut
//│   true =>
//│     set tmp = C⁰(123);
//│     end
//│   else
//│     set tmp = D¹(456);
//│     end
//│ match tmp
//│   C¹ =>
//│     set arg$C$0$ = tmp.a⁰;
//│     return Predef⁰.print⁰(arg$C$0$)
//│   D⁰ =>
//│     set arg$D$0$ = tmp.b⁰;
//│     return Predef⁰.print⁰(arg$D$0$)
//│   E⁰ =>
//│     set arg$E$0$ = tmp.c⁰;
//│     return Predef⁰.print⁰(arg$E$0$)
//│   else
//│     throw new globalThis⁰.Error⁰("match error")
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123


