:js

#config(deadBranchRemoval: true)


data class C(a)
data class D(b)
data class E(c)

if true then 1 else 0
//│ = 1

// * Properly removes the `D` branch and the whole match
// :dopt
:soir
if C(123) is
  C(x) then print(x)
  D(y) then print(y)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, y⁰, arg$D$0$, arg$C$0$;
//│ set scrut = C⁰(123);
//│ set arg$C$0$ = scrut.a⁰;
//│ Predef⁰.print⁰(arg$C$0$)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123

// * Properly removes the `else` branch
:soir
if C(123) is
  C(x) then print(x)
  else print("?")
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, arg$C$0$; set scrut = C⁰(123); set arg$C$0$ = scrut.a⁰; Predef⁰.print⁰(arg$C$0$)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123

// :dopt
let c = if hide(true) then C(123) else D(456)
in if c is
  C(x) then print(x)
  else print("?")
//│ > 123

// * Properly removes the `E` branch
:soir
let c = if hide(true) then C(123) else D(456)
in if c is
  C(x) then print(x)
  D(y) then print(y)
  E(z) then print(z)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, z⁰, tmp, arg$E$0$, arg$D$0$, arg$C$0$;
//│ set scrut = Predef⁰.hide⁰(true);
//│ match scrut
//│   true =>
//│     set tmp = C⁰(123);
//│     end
//│   else
//│     set tmp = D⁰(456);
//│     end
//│ match tmp
//│   C¹ =>
//│     set arg$C$0$ = tmp.a⁰;
//│     Predef⁰.print⁰(arg$C$0$)
//│   D¹ =>
//│     set arg$D$0$ = tmp.b⁰;
//│     Predef⁰.print⁰(arg$D$0$)
//│   else
//│     unreachable /* exhaustive match */
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123


