:soir
let emptyItemCount = 0
let c() = (set emptyItemCount += 1)
in
  c()
  if
    emptyItemCount > 0 then
      let emptyItemCount' = emptyItemCount
      set emptyItemCount = 0
      print(emptyItemCount')
