:js


// * Currently can't propagate from `val` since it's not defined with an Assign
:soir
val x = 1
let y = x
y
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define x⁰ as val x¹ = 1; set y⁰ = x¹; return x¹
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1
//│ x = 1
//│ y = 1

// * But can propagate to `val` from `let`
:soir
let x = 1
val y = x
y
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ set x² = 1; define y¹ as val y² = 1; return y²
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1
//│ x = 1
//│ y = 1


// :dopt
:soir
val x = 1
let y = x in print(y)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define x³ as val x⁴ = 1; return Predef⁰.print⁰(x⁴)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1


// * A copy of a parameter must not be propagated through a loop mutation of that parameter.
// * This is a minimized version of lexer location regressions that occurred several times in the past.
:soir
fun preserveLoopEntry(idx) =
  let startIndex = idx
  let done = false
  while done is false do
    set done = true
    set idx += 1
  [startIndex, idx]
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define preserveLoopEntry⁰ as fun preserveLoopEntry¹(idx) {
//│   let startIndex, done;
//│   set startIndex = idx;
//│   set done = false;
//│   loop lbl:
//│     let tmp;
//│     match done
//│       false =>
//│         set done = true;
//│         set tmp = +⁰(idx, 1);
//│         set idx = tmp;
//│         continue lbl
//│       else
//│         end
//│     end
//│   return [startIndex, idx]
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

print(preserveLoopEntry(2))
//│ > [2, 3]


