:js


// * Currently can't propagate from `val` since it's not defined with an Assign
:soir
val x = 1
let y = x
y
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁰, y⁰; define x⁰ as val x¹ = 1; set y⁰ = x¹; x¹
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1
//│ x = 1
//│ y = 1

// * But can propagate to `val` from `let`
:soir
let x = 1
val y = x
y
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let y¹, x²; set x² = 1; define y¹ as val y² = 1; y²
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1
//│ x = 1
//│ y = 1


// :dopt
:soir
val x = 1
let y = x in print(y)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x³; define x³ as val x⁴ = 1; Predef⁰.print⁰(x⁴)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1

