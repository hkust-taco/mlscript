//│     do Predef⁰.print⁰(ConstructorLocal².this.stored⁰);
//│     end
//│   }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

ConstructorLocal(123)
//│ > 123
//│ = ConstructorLocal(_)


