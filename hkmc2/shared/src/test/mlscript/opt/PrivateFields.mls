:soir
object Foo with
  let state =1 
  fun test1 =
    let res = state
    set state += 1
    res
  fun test2 =
    set state = 0
    do test1
    state
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define Foo⁰ as object Foo¹ {
//│   private val state⁰;
//│   constructor() {
//│     set Foo¹.this.state⁰ = 1;
//│     end
//│   }
//│   method test1⁰ = fun test1¹ {
//│     let res, tmp;
//│     set res = Foo¹.this.state⁰;
//│     set tmp = +⁰(Foo¹.this.state⁰, 1);
//│     set Foo¹.this.state⁰ = tmp;
//│     return res
//│   }
//│   method test2⁰ = fun test2¹ {
//│     set Foo¹.this.state⁰ = 0;
//│     do Foo¹.this.test1¹;
//│     return Foo¹.this.state⁰
//│   }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect 1
Foo.test1
//│ = 1

:expect 2
Foo.test1
//│ = 2

:expect 1
Foo.test2
//│ = 1


:soir
module Bar with
  let state = 1
  fun test1 =
    let res = state
    set state += 1
    res
  fun test2 =
    set state = 0
    do test1
    state
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define Bar⁰ as class Bar¹
//│ module Bar² {
//│   private val state¹;
//│   constructor {
//│     set Bar².this.state¹ = 1;
//│     end
//│   }
//│   method test1² = fun test1³ {
//│     let res, tmp;
//│     set res = Bar².this.state¹;
//│     set tmp = +⁰(Bar².this.state¹, 1);
//│     set Bar².this.state¹ = tmp;
//│     return res
//│   }
//│   method test2² = fun test2³ {
//│     set Bar².this.state¹ = 0;
//│     do Bar².this.test1³;
//│     return Bar².this.state¹
//│   }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect 1
Bar.test1
//│ = 1

:expect 2
Bar.test1
//│ = 2

:expect 1
Bar.test2
//│ = 1


:soir
object UnusedObjectPrivate with
  let used = print(1)
  let unused = print(2)
  fun get = used
module UnusedModulePrivate with
  let used = print(3)
  let unused = print(4)
  fun get = used
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define UnusedObjectPrivate⁰ as object UnusedObjectPrivate¹ {
//│   private val used⁰;
//│   constructor() {
//│     set UnusedObjectPrivate¹.this.used⁰ = Predef⁰.print⁰(1);
//│     do Predef⁰.print⁰(2);
//│     end
//│   }
//│   method get⁰ = fun get¹ {
//│     return UnusedObjectPrivate¹.this.used⁰
//│   }
//│ };
//│ define UnusedModulePrivate⁰ as class UnusedModulePrivate¹
//│ module UnusedModulePrivate² {
//│   private val used¹;
//│   constructor {
//│     set UnusedModulePrivate².this.used¹ = Predef⁰.print⁰(3);
//│     do Predef⁰.print⁰(4);
//│     end
//│   }
//│   method get² = fun get³ { return UnusedModulePrivate².this.used¹ }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ > 2
//│ > 3
//│ > 4

UnusedObjectPrivate.get + UnusedModulePrivate.get
//│ = "()()"


// Unused constructor parameters and explicit private values need no instance fields.
:soir
class UnusedParameter(value)
class UnusedField with
  private val value = 1
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define UnusedParameter⁰ as class UnusedParameter² {
//│   constructor UnusedParameter¹
//│ };
//│ define UnusedField⁰ as class UnusedField¹;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


