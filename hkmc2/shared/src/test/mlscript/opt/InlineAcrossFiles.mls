:sjs
:soir
FilePrivateFunctions.accessibleFunction1() + "?"
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp; set tmp = inaccessibleFunction⁰(); do Predef⁰.print⁰(tmp); return "Okay??"
