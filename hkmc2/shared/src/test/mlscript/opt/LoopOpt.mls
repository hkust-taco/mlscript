//│     true =>
//│       return runtime⁰.Unit⁰
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————




// :dopt
:sir
:soir
fun foo() =
  let x = 1
  if true do
    set x = 2
    return ()
  x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let foo²;
//│ define foo² as fun foo³() {
//│   let x, scrut;
//│   set x = 1;
//│   set scrut = true;
//│   match scrut
//│     true =>
//│       set x = 2;
//│       return runtime⁰.Unit⁰
//│     else
//│       return x
//│   end
//│ };
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let foo²;
//│ define foo² as fun foo³() { match true true => return runtime⁰.Unit⁰ else return 1 end };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————




// * The post-loop state must merge the zero-iteration value with values from loop-back edges.
:sir
:soir
fun loopBackPost(flag) =
  let x = 1
  while flag do
    set x = 2
    set flag = false
  x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let loopBackPost⁰;
//│ define loopBackPost⁰ as fun loopBackPost¹(flag) {
//│   let x;
//│   set x = 1;
//│   loop lbl:
//│     match flag
//│       true =>
//│         set x = 2;
//│         set flag = false;
//│         continue lbl
//│       else
//│         end
//│     end
//│   return x
//│ };
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let loopBackPost⁰;
//│ define loopBackPost⁰ as fun loopBackPost¹(flag) {
//│   let x;
//│   set x = 1;
//│   loop lbl:
//│     match flag
//│       true =>
//│         set x = 2;
//│         set flag = false;
//│         continue lbl
//│       else
//│         end
//│     end
//│   return x
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

print(loopBackPost(false))
print(loopBackPost(true))
//│ > 1
//│ > 2


// * The `else` branch sees assignments that reached the next iteration.
:sir
:soir
fun loopElseReturn(flag) =
  let x = 1
  while flag
    then
      set x = 2
      set flag = false
    else return x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let loopElseReturn⁰;
//│ define loopElseReturn⁰ as fun loopElseReturn¹(flag) {
//│   let x;
//│   set x = 1;
//│   loop lbl:
//│     match flag
//│       true =>
//│         set x = 2;
//│         set flag = false;
//│         continue lbl
//│       else
//│         return x
//│     end
//│   return runtime⁰.Unit⁰
//│ };
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let loopElseReturn⁰;
//│ define loopElseReturn⁰ as fun loopElseReturn¹(flag) {
//│   let x;
//│   set x = 1;
//│   loop lbl:
//│     match flag
//│       true =>
//│         set x = 2;
//│         set flag = false;
//│         continue lbl
//│       else
//│         return x
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

print(loopElseReturn(false))
print(loopElseReturn(true))
//│ > 1
//│ > 2


// * Assignments on abortive loop-body paths must not pollute the ordinary loop exit.
:sir
:soir
fun loopReturnDoesNotPolluteExit(flag) =
  let x = 1
  while flag do
    set x = 2
    return x
  x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let loopReturnDoesNotPolluteExit⁰;
//│ define loopReturnDoesNotPolluteExit⁰ as fun loopReturnDoesNotPolluteExit¹(flag) {
//│   let x;
//│   set x = 1;
//│   loop lbl:
//│     match flag
//│       true =>
//│         set x = 2;
//│         return x
//│       else
//│         end
//│     end
//│   return x
//│ };
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let loopReturnDoesNotPolluteExit⁰;
//│ define loopReturnDoesNotPolluteExit⁰ as fun loopReturnDoesNotPolluteExit¹(flag) {
//│   match flag
//│     true =>
//│       return 2
//│     else
//│       return 1
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

print(loopReturnDoesNotPolluteExit(false))
print(loopReturnDoesNotPolluteExit(true))
//│ > 1
//│ > 2






