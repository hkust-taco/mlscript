// under mono mode, no dead ctor elim
:flowBasedOpt debugDce
:soir
:noInline
:expect 3
fun app(k) = k(C(1))
app(c => 2) + app(c => if c is C then 1 else 0)
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let lambda, tmp, lambda1, tmp1;
//│ define app⁰ as fun app¹(k) {
//│   let tmp2;
//│   set tmp2 = C⁰(1);
//│   return k(tmp2)
//│ };
//│ define lambda as fun lambda⁰(c) {
//│   return 2
//│ };
//│ set tmp = app¹(lambda⁰);
//│ define lambda1 as fun lambda¹(c) {
//│   match c
//│     C¹ =>
//│       return 1
//│     else
//│       return 0
//│   end
//│ };
//│ set tmp1 = app¹(lambda¹);
//│ return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 3


// under poly mode, one instance of `ctor` gets its ctor eliminated
:flowBasedOpt debugDce poly
:soir
:noInline
:expect 3
fun ctor() = C(1)
fun app(k) = k(ctor())
app(c => 2) + app(c => if c is C then 1 else 0)
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > eliminable: Call(member:C²‹term:C⁰›, [[1]])
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp, lambda, tmp1, lambda_7$lambda, app_6$app, app_6_ctor_3$ctor;
//│ define lambda_7$lambda as fun lambda_7$lambda⁰() {
//│   return 2
//│ };
//│ define app_6$app as fun app_6$app⁰(k) {
//│   do app_6_ctor_3$ctor⁰();
//│   return k()
//│ };
//│ define app_6_ctor_3$ctor as fun app_6_ctor_3$ctor⁰() {
//│   return undefined
//│ };
//│ define ctor⁰ as fun ctor¹() {
//│   return C⁰(1)
//│ };
//│ define app² as fun app³(k) {
//│   let tmp2;
//│   set tmp2 = ctor¹();
//│   return k(tmp2)
//│ };
//│ set tmp = app_6$app⁰(lambda_7$lambda⁰);
//│ define lambda as fun lambda²(c) {
//│   match c
//│     C¹ =>
//│       return 1
//│     else
//│       return 0
//│   end
//│ };
//│ set tmp1 = app³(lambda²);
//│ return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 3


