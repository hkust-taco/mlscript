// constructing `P(1)` prints, so do not eliminate
:soir
:noInline
fun n() =
  let unused = P(1)
  2
n()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define n⁰ as fun n¹() { do P⁰(1); return 2 }; return n¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ = 2

:soir
:noInline
:expect 4
fun f() =
  let unused = A(1)
  2
f() + f()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > eliminable: Call(member:A²‹term:A⁰›, [[1]])
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1;
//│ define f² as fun f³() { return 2 };
//│ set tmp = f³();
//│ set tmp1 = f³();
//│ return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 4


:flowBasedOpt debugDce poly
:soir
:noInline
:expect 4
fun g() =
  let unused = B(1)
  2
g() + g()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > eliminable: Call(member:B¹‹term:B²›, [[1]])
//│ dead-constructor-elim > eliminable: Call(member:B¹‹term:B²›, [[1]])
//│ dead-constructor-elim > eliminable: Call(member:B¹‹term:B²›, [[1]])
