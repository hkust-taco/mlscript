// the ctor is dead, but `y.x` is kept
:soir
:noInline
fun s(y) =
  let unused = A(y.x)
  2
s(new O)
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > eliminable: Call(member:A²‹term:A⁰›, [[Select(y⁰, Ident(x))]])
