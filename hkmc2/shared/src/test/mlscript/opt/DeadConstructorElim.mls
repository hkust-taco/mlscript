:js
:flowBasedOpt debugDce


data class A(x)
data class B(y)
data class C(z)
class P(x) with
  print(x)
class D with
  fun app(cb) = cb(A(1))
class O with
  fun x = print("get x")
  fun z = print("get z")
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<


:soir
:noInline
fun f() =
  let b = A([1, 2])
  if b is A then 1 else 0
f()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > eliminable: Tuple(false, [1, 2])
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define f⁰ as fun f¹() {
//│   let b;
//│   set b = A⁰(undefined);
//│   match b
//│     A¹ =>
//│       return 1
//│     else
//│       return 0
//│   end
//│ };
//│ return f¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

:soir
:noInline
fun g() =
  let unused = A(1)
  2
g()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > eliminable: Call(member:A²‹term:A⁰›, [[1]])
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define g⁰ as fun g¹() { return 2 }; return g¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2


