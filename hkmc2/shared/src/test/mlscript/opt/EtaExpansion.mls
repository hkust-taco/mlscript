// `f(b)`'s result discarded so `g1` and `h1` keep the liveness of their own call sites and
// would disagree on eliminable parameters if we keep the eta-expandability of `f1`
:noInline
:flowBasedOpt debugEta debugDpe
:soir
@affine(0) private fun g1(x) = 0
@affine(0) private fun h1(x) = x
private fun f1(b) = if b then g1 else h1
private fun main1(b) =
  f1(b)
  g1(1) + h1(2)
main1(true)
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > g1⁰#0 @ <root> -> eliminable: {0}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @affine(0) @private
//│ define g1⁰ as fun g1¹() {
//│   return 0
//│ };
//│ @affine(0) @private
//│ define h1⁰ as fun h1¹(x) {
//│   return x
//│ };
//│ @private
//│ define f1⁰ as fun f1¹(b) {
//│   match b
//│     true =>
//│       return g1¹
//│     else
//│       return h1¹
//│   end
//│ };
//│ @private
//│ define main1⁰ as fun main1¹(b) {
//│   let tmp, tmp1;
//│   do f1¹(b);
//│   set tmp = g1¹();
//│   set tmp1 = h1¹(2);
//│   return +⁰(tmp, tmp1)
//│ };
//│ return main1¹(true)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2

// similar as above, but `f2(b)` is not discarded but pattern matched
:noInline
:flowBasedOpt debugEta debugDpe
:expect 0
@affine(0) private fun g2(x) = 0
@affine(0) private fun h2(x) = x
private fun f2(b) = if b then g2 else h2
private fun main2(b) =
  if f2(b) is 0 then 0 else 1
  g2(1)
main2(true)
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > g2⁰#0 @ <root> -> eliminable: {0}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 0



// eta expansion keeps the target's rest parameter and spreads it at the call site
:flowBasedOpt mono debugEta
:soir
:noInline
:expect [1, 2, 3]
@affine(1) fun rest(a)(...xs) = xs
fun returnRest(a) = rest(a)
returnRest(0)(1, 2, 3)
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > returnRest⁰#0 @ <root>: [1, 0+rest]
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @affine(1)
//│ define rest⁰ as fun rest¹(a)(...xs) {
//│   return xs
//│ };
//│ define returnRest⁰ as fun returnRest¹(a)(...eta$0$rest) {
//│   return rest¹(a)(...eta$0$rest)
//│ };
//│ return returnRest¹(0)(1, 2, 3)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [1, 2, 3]

// eta expansion and dead param elim working at the same time
:flowBasedOpt mono debugEta debugDpe
:soir
:noInline
:expect [2, 3]
@affine(1) private fun rest2(a)(b, ...xs) = xs
private fun returnRest2(a) = rest2(a)
private fun app(f) = f(1, 2, 3)
app(returnRest2(0))
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > returnRest2⁰#0 @ <root>: [1, 1+rest]
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > returnRest2⁰#0 @ <root> -> eliminable: {0}
//│ dead-param-elim > rest2⁰#0 @ <root> -> eliminable: {0}
//│ dead-param-elim > rest2⁰#1 @ <root> -> eliminable: {0}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp;
//│ @affine(1) @private
//│ define rest2⁰ as fun rest2¹()(...xs) {
//│   return xs
//│ };
//│ @private
//│ define returnRest2⁰ as fun returnRest2¹()(...eta$0$rest) {
//│   return rest2¹()(...eta$0$rest)
//│ };
//│ @private
//│ define app⁰ as fun app¹(f) { return f(2, 3) };
//│ set tmp = returnRest2¹();
//│ return app¹(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [2, 3]


// the copy of `f` for `k1` eta-expands its nested `g` with the original symbol before refreshing it,
// so the kept `g` no longer owns `g`'s irDefn; BlockSimplifier then reads the two-param-list copy,
// sees `g(x)` as an unsaturated (hence pure) call, and moves it past `print("between")`
// correct output: between, g, between
:fixme
:flowBasedOpt poly
:soir
:noInline
:expect 13
@affine(1) fun k1(a)(b) = a + b
fun k2(a)(b) = a * b
fun f(k, x) =
  fun g(y) =
    if y > 1 do print("g")
    k(y)
  let h = g(x)
  print("between")
  h(2)
f(k1, 1) + f(k2, 5)
//│ ╔══[INTERNAL ERROR] Compiler reached an unexpected state at 'FlowAnalysisBasedRewrite.scala:208': a copy binds the original symbol term:g
//│ ╟── The compilation result may be incorrect.
//│ ╙── This is a compiler bug; please report it to the maintainers.
//│ ╔══[INTERNAL ERROR] Compiler reached an unexpected state at 'TailRecOpt.scala:86': Call node passes 2 argument lists to term:g⁸, which can receive 1.
//│ ╟── The compilation result may be incorrect.
//│ ╙── This is a compiler bug; please report it to the maintainers.
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, f$f;
//│ define f$f as fun f$f⁰(k, x) {
//│   let g;
//│   define g as fun g⁹(y)(eta$0$0) {
//│     let scrut;
//│     set scrut = >⁰(y, 1);
//│     match scrut
//│       true =>
//│         do Predef⁰.print⁰("g");
//│         return k(y)(eta$0$0)
//│       else
//│         return k(y)(eta$0$0)
//│     end
//│   };
//│   do Predef⁰.print⁰("between");
//│   return g⁹(x)(2)
//│ };
//│ @affine(1)
//│ define k1⁰ as fun k1¹(a)(b) {
//│   return +⁰(a, b)
//│ };
//│ define k2⁰ as fun k2¹(a)(b) {
//│   return *⁰(a, b)
//│ };
//│ define f⁸ as fun f⁹(k, x) {
//│   let g;
//│   define g as fun g⁸(y) {
//│     let scrut;
//│     set scrut = >⁰(y, 1);
//│     match scrut
//│       true =>
//│         do Predef⁰.print⁰("g");
//│         return k(y)
//│       else
//│         return k(y)
//│     end
//│   };
//│   do Predef⁰.print⁰("between");
//│   return g⁸(x)(2)
//│ };
//│ set tmp = f$f⁰(k1¹, 1);
//│ set tmp1 = f⁹(k2¹, 5);
//│ return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > between
//│ > between
//│ > g
//│ = 13
