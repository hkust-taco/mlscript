:.
:js
:lift
:flowBasedOpt debugEta


// each function value produced by `f(a)` is one-shot, so `g` can take `b` directly
:soir
:expect 3
@affine(1) fun f(a)(b) = a + b
fun g(x) = f(x)
g(1)(2)
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > g⁰#0 @ <root>: [1, 1]
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @inline @affine(1)
//│ define f⁰ as fun f¹(a)(b) {
//│   return +⁰(a, b)
//│ };
//│ @inline
//│ define g⁰ as fun g¹(x)(eta$0$0) { return +⁰(x, eta$0$0) };
//│ return 3
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 3


// without the annotation, `g` is left alone
:soir
:expect 3
fun f(a)(b) = a + b
fun g(x) = f(x)
g(1)(2)
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @inline
//│ define f² as fun f³(a)(b) { return +⁰(a, b) };
//│ define g² as fun g³(x) { return f³(x) };
//│ return 3
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 3


// the returned lambda is one-shot, so `h` can take `y` directly
:soir
:expect 3
fun h(x) = @affine(0) y => x + y
h(1)(2)
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > h⁰#0 @ <root>: [1, 1]
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @inline define h⁰ as fun h¹(x)(eta$0$0) { return +⁰(x, eta$0$0) }; return 3
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 3


// the monomorphic analysis merges `f` and `h` into `k`, and `h(x)` is not marked as one-shot,
// so `g` is left alone
:soir
:noInline
:expect 15
@affine(1) fun f(a)(b) = a + b
fun h(a)(b) = a * b
fun g(k, x) = k(x)
g(f, 1)(2) + g(h, 3)(4)
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let baseCall, tmp, baseCall1, tmp1;
//│ @affine(1)
//│ define f⁴ as fun f⁵(a)(b) {
//│   return +⁰(a, b)
//│ };
//│ define h² as fun h³(a)(b) {
//│   return *⁰(a, b)
//│ };
//│ define g⁴ as fun g⁵(k, x) {
//│   return (k(x) as! Function⁰)
//│ };
//│ set baseCall = g⁵(f⁵, 1);
//│ set tmp = baseCall(2);
//│ set baseCall1 = g⁵(h³, 3);
//│ set tmp1 = baseCall1(4);
//│ return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 15


// the polymorphic one expands only the copy of `g` that is called with `f`
:flowBasedOpt debugEta poly
:soir
:noInline
:expect 15
@affine(1) fun f(a)(b) = a + b
fun h(a)(b) = a * b
fun g(k, x) = k(x)
g(f, 1)(2) + g(h, 3)(4)
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let baseCall, tmp, baseCall1, tmp1;
//│ @affine(1)
//│ define f⁶ as fun f⁷(a)(b) {
//│   return +⁰(a, b)
//│ };
//│ define h⁴ as fun h⁵(a)(b) {
//│   return *⁰(a, b)
//│ };
//│ define g⁶ as fun g⁷(k, x) {
//│   return (k(x) as! Function⁰)
//│ };
//│ set baseCall = g⁷(f⁷, 1);
//│ set tmp = baseCall(2);
//│ set baseCall1 = g⁷(h⁵, 3);
//│ set tmp1 = baseCall1(4);
//│ return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 15


// a lambda has only parameter list 0
:w
fun h(x) = @affine(1) y => x + y
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	fun h(x) = @affine(1) y => x + y
//│ ║        	           ^^^^^^^^^^
//│ ╟── This annotation is not supported on function literal terms.
//│ ║  l.+1: 	fun h(x) = @affine(1) y => x + y
//│ ╙──      	                      ^^^^^^^^^^
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<

:w
@affine(0) val v = 1
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	@affine(0) val v = 1
//│ ╙──      	^^^^^^^^^^
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ v = 1

:w
fun h(x) = @affine(0) x
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	fun h(x) = @affine(0) x
//│ ║        	           ^^^^^^^^^^
//│ ╟── This annotation is not supported on reference terms.
//│ ║  l.+1: 	fun h(x) = @affine(0) x
//│ ╙──      	                      ^
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<


// `f(b)`'s result discarded so `g1` and `h1` keep the liveness of their own call sites and
// would disagree on eliminable parameters if we keep the eta-expandability of `f1`
:noInline
:flowBasedOpt debugEta debugDpe
:soir
@affine(0) private fun g1(x) = 0
@affine(0) private fun h1(x) = x
private fun f1(b) = if b then g1 else h1
private fun main1(b) =
  f1(b)
  g1(1) + h1(2)
main1(true)
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > g1⁰#0 @ <root> -> eliminable: {0}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @affine(0) @private
//│ define g1⁰ as fun g1¹() {
//│   return 0
//│ };
//│ @affine(0) @private
//│ define h1⁰ as fun h1¹(x) {
//│   return x
//│ };
//│ @private
//│ define f1⁰ as fun f1¹(b) {
//│   match b
//│     true =>
//│       return g1¹
//│     else
//│       return h1¹
//│   end
//│ };
//│ @private
//│ define main1⁰ as fun main1¹(b) {
//│   let tmp, tmp1;
//│   do f1¹(b);
//│   set tmp = g1¹();
//│   set tmp1 = h1¹(2);
//│   return +⁰(tmp, tmp1)
//│ };
//│ return main1¹(true)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2

// similar as above, but `f2(b)` is not discarded but pattern matched
:noInline
:flowBasedOpt debugEta debugDpe
:expect 0
@affine(0) private fun g2(x) = 0
@affine(0) private fun h2(x) = x
private fun f2(b) = if b then g2 else h2
private fun main2(b) =
  if f2(b) is 0 then 0 else 1
  g2(1)
main2(true)
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > g2⁰#0 @ <root> -> eliminable: {0}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 0



// eta expansion keeps the target's rest parameter and spreads it at the call site
:flowBasedOpt mono debugEta
:soir
:noInline
:expect [1, 2, 3]
@affine(1) fun rest(a)(...xs) = xs
fun returnRest(a) = rest(a)
returnRest(0)(1, 2, 3)
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > returnRest⁰#0 @ <root>: [1, 0+rest]
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @affine(1)
//│ define rest⁰ as fun rest¹(a)(...xs) {
//│   return xs
//│ };
//│ define returnRest⁰ as fun returnRest¹(a)(...eta$0$rest) {
//│   return rest¹(a)(...eta$0$rest)
//│ };
//│ return returnRest¹(0)(1, 2, 3)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [1, 2, 3]

// eta expansion and dead param elim working at the same time
:flowBasedOpt mono debugEta debugDpe
:soir
:noInline
:expect [2, 3]
@affine(1) private fun rest2(a)(b, ...xs) = xs
private fun returnRest2(a) = rest2(a)
private fun app(f) = f(1, 2, 3)
app(returnRest2(0))
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > returnRest2⁰#0 @ <root>: [1, 1+rest]
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > rest2⁰#0 @ <root> -> eliminable: {0}
//│ dead-param-elim > returnRest2⁰#0 @ <root> -> eliminable: {0}
//│ dead-param-elim > rest2⁰#1 @ <root> -> eliminable: {0}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp;
//│ @affine(1) @private
//│ define rest2⁰ as fun rest2¹()(...xs) {
//│   return xs
//│ };
//│ @private
//│ define returnRest2⁰ as fun returnRest2¹()(...eta$0$rest) {
//│   return rest2¹()(...eta$0$rest)
//│ };
//│ @private
//│ define app⁰ as fun app¹(f) {
//│   return (f(2, 3) as! Array⁰)
//│ };
//│ set tmp = returnRest2¹();
//│ return app¹(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [2, 3]


// * It doesn't eta-expand if there's no lifting :)
:expect 42
#config(liftDefns: None)
@affine(0) fun leaf() = 42
fun node() = leaf
node()()
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 42
:expect 42
#config(liftDefns: Some(LiftDefns))
@affine(0) fun leaf() = 42
fun node() = leaf
node()()
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > node⁰#0 @ <root>: [0, 0]
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 42


// a copy that expands a nested `g` must leave the in-place `g` owning its symbol's irDefn:
// otherwise the later BlockSimplifier reads the copy's two-param-list `g`, so `g(x)` looks unsaturated, hence pure, and moves past `print`
:flowBasedOpt poly
:soir
:noInline
:expect 13
@affine(1) fun k1(a)(b) = a + b
fun k2(a)(b) = a * b
fun f(k, x) =
  fun g(y) =
    if y > 1 do print("g")
    k(y)
  let h = g(x)
  print("between")
  h(2)
f(k1, 1) + f(k2, 5)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let g, tmp, tmp1;
//│ define g as fun g⁸(k, y) {
//│   let scrut;
//│   set scrut = >⁰(y, 1);
//│   match scrut
//│     true =>
//│       do Predef⁰.print⁰("g");
//│       return (k(y) as! Function⁰)
//│     else
//│       return (k(y) as! Function⁰)
//│   end
//│ };
//│ @affine(1)
//│ define k1⁰ as fun k1¹(a)(b) {
//│   return +⁰(a, b)
//│ };
//│ define k2⁰ as fun k2¹(a)(b) {
//│   return *⁰(a, b)
//│ };
//│ define f⁸ as fun f⁹(k, x) {
//│   let h;
//│   set h = g⁸(k, x);
//│   do Predef⁰.print⁰("between");
//│   return (h(2) as! Int⁰)
//│ };
//│ set tmp = f⁹(k1¹, 1);
//│ set tmp1 = f⁹(k2¹, 5);
//│ return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > between
//│ > g
//│ > between
//│ = 13


// the copy of `f` refreshes `b`, which `a` refers to before `b` is defined
:flowBasedOpt poly
:soir
:noInline
:expect 13
@affine(1) fun k1(a)(b) = a + b
fun k2(a)(b) = a * b
fun f(k, x) =
  fun a(y) = b(y)
  fun b(y) = k(y)
  let h = a(x)
  h(2)
f(k1, 1) + f(k2, 5)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let a, b, tmp, tmp1;
//│ define a as fun a⁰(k, y) {
//│   return b⁰(k, y)
//│ };
//│ define b as fun b⁰(k, y) {
//│   return (k(y) as! Function⁰)
//│ };
//│ @affine(1)
//│ define k1² as fun k1³(a1)(b1) {
//│   return +⁰(a1, b1)
//│ };
//│ define k2² as fun k2³(a1)(b1) {
//│   return *⁰(a1, b1)
//│ };
//│ define f¹⁰ as fun f¹¹(k, x) {
//│   let h;
//│   set h = a⁰(k, x);
//│   return (h(2) as! Int⁰)
//│ };
//│ set tmp = f¹¹(k1³, 1);
//│ set tmp1 = f¹¹(k2³, 5);
//│ return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 13


// a copy of `f` selects a field of its nested `C` through an ascribed parameter before `C` is defined
:flowBasedOpt poly
:soir
:noInline
:w
:expect 13
@affine(1) fun k1(a)(b) = a + b
fun k2(a)(b) = a * b
fun f(k, x) =
  fun get(o: C) = if o is C then o.x
  fun g(y) = k(y)
  class C(val x)
  let h = g(get(new C(x)))
  h(2)
f(k1, 1) + f(k2, 5)
//│ ═══[WARNING] Cannot yet lift class/module `C` as it is used in an instance check.
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let g, get, tmp, tmp1;
//│ define get as fun get⁰(C$, o) {
//│   match o
//│     C⁰ =>
//│       return o.x⁰
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ define g as fun g⁹(k, y) {
//│   return (k(y) as! Function⁰)
//│ };
//│ @affine(1)
//│ define k1⁴ as fun k1⁵(a)(b) {
//│   return +⁰(a, b)
//│ };
//│ define k2⁴ as fun k2⁵(a)(b) {
//│   return *⁰(a, b)
//│ };
//│ define f¹² as fun f¹³(k, x) {
//│   let C, h, tmp2, tmp3;
//│   define C as class C⁰ {
//│     val x¹;
//│     constructor C¹(x1) {
//│       define x¹ as val x⁰ = x1;
//│       end
//│     }
//│   };
//│   set tmp2 = new C⁰(x);
//│   set tmp3 = get⁰(C⁰, tmp2);
//│   set h = g⁹(k, tmp3);
//│   return h(2)
//│ };
//│ set tmp = f¹³(k1⁵, 1);
//│ set tmp1 = f¹³(k2⁵, 5);
//│ return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 13


// the params eta expansion appends take the types of the params they stand for, and the result is what the targets
// return: `g(x: Int)(eta$0$0: Int): Int` passes `eta$0$0` to `b: Int` without a cast
:soir
:siret
:noInline
:expect 3
@affine(1) fun f(a: Int)(b: Int) = a + b
fun g(x) = f(x)
g(1)(2)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let g$g;
//│ @private
//│ define g$g as fun g$g⁰(x: Int⁰)(eta$0$0: Int⁰): Int⁰ {
//│   return f¹⁴(x)(eta$0$0)
//│ };
//│ @affine(1)
//│ define f¹⁵ as fun f¹⁴(a: Int⁰)(b: Int⁰): Int⁰ {
//│   return +⁰(a, b)
//│ };
//│ define g¹⁰ as fun g¹¹(x: Int⁰)(eta$0$0: Int⁰): Int⁰ { return f¹⁴(x)(eta$0$0) };
//│ return g$g⁰(1)(2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 3
