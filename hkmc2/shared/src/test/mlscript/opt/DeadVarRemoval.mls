:soir
fun main =
  let x = 2 + 2
  1
main
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let main⁰, tmp, inlinedVal;
//│ define main⁰ as fun main¹() { return 1 };
//│ set inlinedVal = 1;
//│ set tmp = inlinedVal;
//│ main¹
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


