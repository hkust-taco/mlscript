:sir // * Done immediately upon lowering thanks to Call's smart constructor
2 + 2 * 3 > 0
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ return true
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = true


:dopt // * Correctly done in only 2 passes: first, folding; second, removing dead vars
:soir
let x = 2
in let y = 2
in let x += 1
in
  set y += 1
  print(x + y)
//│ ⬤ Simplif. iter. 1
//│ Captured variables: HashSet()
//│ !! Change triggered { x⁰ ~> 2 }
//│ !! Change triggered { y⁰ ~> 2 }
//│ !! Change triggered { tmp:tmp⁰ ~> 3 }
//│ !! Change triggered { x¹ ~> 3 }
//│ ▶ VP:
//│ >  let x, y, x1, tmp, tmp1;
//│ >  set x = 2;
//│ >  set y = 2;
//│ >  set x1 = 3;
//│ >  set tmp = 3;
//│ >  set y = (3 as! Int⁰);
//│ >  set tmp1 = +⁰(3, y);
//│ >  return Predef⁰.print⁰(tmp1)
//│ ⬤ Simplif. iter. 2
//│ !! Change triggered { rm x⁰ = 2 }
//│ !! Change triggered { rm x¹ = 3 }
//│ !! Change triggered { rm tmp:tmp⁰ = 3 }
//│ ▶ DCE:
//│ >  let y, tmp; set y = 2; set y = (3 as! Int⁰); set tmp = +⁰(3, y); return Predef⁰.print⁰(tmp)
//│ Captured variables: HashSet()
//│ !! Change triggered { rm ass y⁰ = 2 }
//│ ▶ VP:
//│ >  let y, tmp; set y = (3 as! Int⁰); set tmp = +⁰(3, y); return Predef⁰.print⁰(tmp)
//│ ⬤ Simplif. iter. 3
//│ Captured variables: HashSet()
//│ ⬤ Simplif. iter. 1
//│ Captured variables: HashSet()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let y, tmp; set y = (3 as! Int⁰); set tmp = +⁰(3, y); return Predef⁰.print⁰(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 6


// :dopt
:soir
let peek = hide(2 + 2)
let last = peek
set peek = 1
last
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ set peek⁰ = (Predef⁰.hide⁰(4) as! Int⁰); set last⁰ = peek⁰; set peek⁰ = 1; return last⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 4
//│ last = 4
//│ peek = 1


