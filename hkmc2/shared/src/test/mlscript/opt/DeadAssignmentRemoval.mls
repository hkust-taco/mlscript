:js


let x = hide(1)
in print(x)
//│ > 1

// :dopt
:soir
let x
in
  set x = hide(2)
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp; set tmp = Predef⁰.hide⁰(2); return Predef⁰.print⁰(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2

:soir
let x = 1
in
  set x = hide(2)
  print(x)
  set x = hide(3)
  set x = hide(4)
  set x += 1
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, tmp2;
//│ set tmp = Predef⁰.hide⁰(2);
//│ do Predef⁰.print⁰(tmp);
//│ do Predef⁰.hide⁰(3);
//│ set tmp1 = Predef⁰.hide⁰(4);
//│ set tmp2 = +⁰(tmp1, 1);
//│ return Predef⁰.print⁰(tmp2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ > 5


// * Note that the dead assignment to parameter x is removed
:sir
:soir
fun f(x) =
  x = 1
  42
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define f⁰ as fun f¹(x) { set x = 1; return 42 }; end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define f⁰ as fun f¹(x) { return 42 }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// :dopt
:soir
fun main =
  let x
  x = 1
  x = 2
  x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define main⁰ as fun main¹() { return 2 }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// :dopt
// :sir
let x = if maybe then 1 else 1
print(x)
//│ > 1
//│ x = 1


:soir
:re
let x in
  try
    set x = 1
    if maybe do throw 42
    set x = 2
  finally print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x, scrut, tmp;
//│ try
//│   set x = 1;
//│   set scrut = Predef⁰.maybe⁰;
//│   match scrut
//│     true =>
//│       throw 42
//│     else
//│       set x = 2;
//│       set tmp = runtime⁰.Unit⁰;
//│       end
//│   end
//│ finally
//│   do Predef⁰.print⁰(x);
//│   end;
//│   return tmp
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ ═══[RUNTIME ERROR] 42

