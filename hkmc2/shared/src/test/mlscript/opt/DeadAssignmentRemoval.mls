:js


let x = hide(1)
in print(x)
//│ > 1

// :dopt
:soir
let x
in
  set x = hide(2)
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp; set tmp = Predef⁰.hide⁰(2); return Predef⁰.print⁰(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2

:soir
let x = 1
in
  set x = hide(2)
  print(x)
  set x = hide(3)
  set x = hide(4)
  set x += 1
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, tmp2;
//│ set tmp = Predef⁰.hide⁰(2);
//│ do Predef⁰.print⁰(tmp);
//│ do Predef⁰.hide⁰(3);
//│ set tmp1 = Predef⁰.hide⁰(4);
//│ set tmp2 = +⁰(tmp1, 1);
//│ return Predef⁰.print⁰(tmp2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ > 5


