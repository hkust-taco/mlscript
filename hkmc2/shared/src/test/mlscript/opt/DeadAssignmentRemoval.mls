:expect 2
fun test =
  let x
  try
    set x = 1
    if maybe do
      set x = 2
      throw 42
    else print("hello")
    set x = 3
  finally return x
test
//│ = 2

:soir
let x = 1 in
  let y
  set x = 2 in
    set y = 3
  y
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let y; try set y = 3; end finally end; return y
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 3


