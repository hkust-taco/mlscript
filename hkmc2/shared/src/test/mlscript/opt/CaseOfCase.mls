fun multiProducer(x) = if x is
  "" then 0
  "1" then 1
  "2" then 0


// TODO: should optimize because the branches can be duplicated, as they are small (below inlining threshold)
:soir
x => if multiProducer(x) is
  0 then print("Z")
  1 then print("O")
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let lambda⁰;
//│ @private
//│ define lambda⁰ as fun lambda¹(x) {
//│   let inlinedVal;
//│   match x
//│     "" =>
//│       set inlinedVal = 0;
//│       end
//│     "1" =>
//│       set inlinedVal = 1;
//│       end
//│     "2" =>
//│       set inlinedVal = 0;
//│       end
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   match inlinedVal
//│     0 =>
//│       return Predef⁰.print⁰("Z")
//│     1 =>
//│       return Predef⁰.print⁰("O")
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ return lambda¹
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun


// Note: should NOT optimize because that would lead to duplicating a branch whose size is above the inlining threshold
:inlineThreshold 10
:soir
x => if multiProducer(x) is
  0 then print of
    "Hello", "hello", "hello", "hello", "hello", "hello", "hello", "hello", "hello", "hello"
  1 then print("?")
