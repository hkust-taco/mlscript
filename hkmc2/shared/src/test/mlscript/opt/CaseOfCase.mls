:js


import "../../mlscript-compile/Option.mls"
open Option


:global
:inlineThreshold 100



fun toStr(b) = if b then "ok" else "nope"
fun fromStr(s) = if s is
  "ok" then true
  "nope" then false


// TODO: should optimize by distributing the branches of the second match over the first
:soir
fun foo(x) = x toStr() fromStr()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let foo⁰;
//│ define foo⁰ as fun foo¹(x) {
//│   let inlinedVal;
//│   match x
//│     true =>
//│       set inlinedVal = "ok";
//│       end
//│     else
//│       set inlinedVal = "nope";
//│       end
//│   match inlinedVal
//│     "ok" =>
//│       return true
//│     "nope" =>
//│       return false
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect true
foo(true)
//│ = true


