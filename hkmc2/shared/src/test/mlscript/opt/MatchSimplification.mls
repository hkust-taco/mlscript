//│ match true true => 1 else 0 end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// :dopt
// :sir
:soir
fun f(x) =
  if x is 0 do
    set x = 1
  if x is 1 do
    print("!")
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁰;
//│ define f⁰ as fun f¹(x) {
//│   match x
//│     0 =>
//│       set x = 1;
//│       end
//│   match x
//│     1 =>
//│       do Predef⁰.print⁰("!");
//│       return runtime⁰.Unit⁰
//│     else
//│       return runtime⁰.Unit⁰
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

