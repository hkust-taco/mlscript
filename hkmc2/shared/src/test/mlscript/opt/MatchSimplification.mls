:js


if true then 1 else 0
//│ = 1


// :dopt
:soir
let x = true in if x then 1 else 0
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ match true true => return 1 else return 0 end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// :dopt
// :sir
:soir
fun f(x) =
  if x is 0 do
    set x = 1
  if x is 1 do
    print("!")
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define f⁰ as fun f¹(x) {
//│   match x
//│     0 =>
//│       set x = 1;
//│       do Predef⁰.print⁰("!");
//│       return runtime⁰.Unit⁰
//│     1 =>
//│       do Predef⁰.print⁰("!");
//│       return runtime⁰.Unit⁰
//│     else
//│       return runtime⁰.Unit⁰
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect true
:soir
true is Bool
