:js


// * Remove useless objects
:soir
:sjs
fun f() =
  object A
  42
f()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f; f = function f() { return 42 }; return 42
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define f⁰ as fun f¹() { return 42 }; return 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42

// * Do not remove objects with non-trivial constructors
:soir
:sjs
fun f() =
  object A with
    print("Hello")
  42
f()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f1, A2;
//│ f1 = function f() {
//│   let A3;
//│   (class A {
//│     static {
//│       new this
//│     }
//│     constructor() {
//│       A3 = this;
//│       Predef.print("Hello");
//│       Object.defineProperty(this, "class", {
//│         value: A
//│       });
//│       globalThis.Object.freeze(this);
//│     }
//│     toString() { return runtime.render(this); }
//│     static [definitionMetadata] = ["object", "A"];
//│   });
//│   return 42
//│ };
//│ (class A1 {
//│   static {
//│     new this
//│   }
//│   constructor() {
//│     A2 = this;
//│     Predef.print("Hello");
//│     Object.defineProperty(this, "class", {
//│       value: A1
//│     });
//│     globalThis.Object.freeze(this);
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["object", "A"];
//│ });
//│ return 42
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let A;
//│ define f² as fun f³() {
//│   let A1;
//│   define A1 as object A⁰ {
//│     constructor() {
//│       do Predef⁰.print⁰("Hello");
//│       end
//│     }
//│   };
//│   return 42
//│ };
//│ define A as object A¹ { constructor() { do Predef⁰.print⁰("Hello"); end } };
//│ return 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > Hello
//│ = 42


