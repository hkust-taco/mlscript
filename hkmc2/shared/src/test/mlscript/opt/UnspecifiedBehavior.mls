:js


// * Accesses to variables that were not initialized may return arbitrary values.
// * (Perhaps we should only allow this to happen when aggressive optimizations are enabled?)

// * Note: We observe the value `2` even though the branch where the assignment occurs is dead
:expect 2
let x
let y = 1
if hide(false) then
  x = 2
else
  print('hi)
hide of hide of hide of hide of hide of x // big expression so it's not folded into the `else`
//│ > hi
//│ = 2
//│ x = undefined
//│ y = 1

:expect undefined
let x
let y = 1
if hide(false) then
  x = 2
else
  print('hi)
x // folded into the `else`; no longer observe the value `2`
//│ > hi
//│ x = undefined
//│ y = 1


// * Reading an uninitialized top-level variable yields undefined.
// :dopt
:soir
let x
print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁰; Predef⁰.print⁰(undefined)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > undefined
//│ x = undefined

// * Keep the uninitialized binding visible to the following block.
let x
//│ x = undefined

// :dopt
:soir
if x is 0 do print()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ match x¹ 0 => do Predef⁰.print⁰(); runtime⁰.Unit⁰ else runtime⁰.Unit⁰ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
