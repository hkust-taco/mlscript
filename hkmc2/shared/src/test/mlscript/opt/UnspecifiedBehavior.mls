:js


// * Accesses to variables that were not initialized may return arbitrary values.
// * (Perhaps we should only allow this to happen when aggressive optimizations are enabled?)

// * Note: We observe the value `2` even though the branch where the assignment occurs is dead
:expect 2
:soir
let x
let y = 1
if hide(false) then
  x = 2
else
  print('hi)
hide of hide of hide of hide of hide of x // big expression so it's not folded into the `else`
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁰, y⁰, scrut, tmp, tmp1, tmp2, tmp3;
//│ set y⁰ = 1;
//│ set scrut = Predef⁰.hide⁰(false);
//│ match scrut
//│   true =>
//│     set x⁰ = 2;
//│     end
//│   else
//│     do Predef⁰.print⁰("hi");
//│     end
//│ set tmp = Predef⁰.hide⁰(2);
//│ set tmp1 = Predef⁰.hide⁰(tmp);
//│ set tmp2 = Predef⁰.hide⁰(tmp1);
//│ set tmp3 = Predef⁰.hide⁰(tmp2);
//│ Predef⁰.hide⁰(tmp3)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ = 2
//│ x = undefined
//│ y = 1

:expect undefined
:soir
let x
let y = 1
if hide(false) then
  x = 2
else
  print('hi)
x // folded into the `else`; no longer observe the value `2`
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x¹, y¹, scrut;
//│ set y¹ = 1;
//│ set scrut = Predef⁰.hide⁰(false);
//│ match scrut
//│   true =>
//│     set x¹ = 2;
//│     2
//│   else
//│     do Predef⁰.print⁰("hi");
//│     undefined
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ x = undefined
//│ y = 1


// * Reading an uninitialized top-level variable yields undefined.
// :dopt
:soir
let x
print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x²; Predef⁰.print⁰(undefined)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > undefined
//│ x = undefined

// * Keep the uninitialized binding visible to the following block.
let x
//│ x = undefined

// :dopt
if x is 0 do print()
