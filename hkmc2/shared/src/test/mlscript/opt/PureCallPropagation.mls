:js


fun foo(x)(y) = 42

:soir
let f = foo(1) in f(2)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ return 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


fun foo(x)(y)(z) =
  print("hi")
  x + y + z

:soir
foo(1)(2)(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ return foo$worker⁰(1, 2, 3)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ = 6

// * The unsaturated call `foo(1)(2)` is pure, so it can be propagated
// * to later call sites and combined with their remaining arguments.
:soir
let f = foo(1)(2)
print("hello")
f(3) + f(4)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁰, inlinedVal, inlinedVal1;
//│ set f⁰ = foo⁰(1)(2);
//│ do Predef⁰.print⁰("hello");
//│ set inlinedVal = foo$worker⁰(1, 2, 3);
//│ set inlinedVal1 = foo$worker⁰(1, 2, 4);
//│ return +⁰(inlinedVal, inlinedVal1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hello
//│ > hi
//│ > hi
//│ = 13
//│ f = fun


:global
:inlineThreshold 100


:soir
let f = foo(1)(2) in
  print("hello")
  f(3) + f(4)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ do Predef⁰.print⁰("hello"); do Predef⁰.print⁰("hi"); do Predef⁰.print⁰("hi"); return 13
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hello
//│ > hi
//│ > hi
//│ = 13

:soir
let f = foo(1)(2)
print("hello")
f(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f¹; set f¹ = foo⁰(1)(2); do Predef⁰.print⁰("hello"); do Predef⁰.print⁰("hi"); return 6
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hello
//│ > hi
//│ = 6
//│ f = fun


:soir
fun foo(x)(y) =
  print("hi")
  z => 42
let f = foo(1)(2)
print("hello")
f(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let foo¹, f², lambda⁰;
//│ @private
//│ define lambda⁰ as fun lambda¹(z) {
//│   return 42
//│ };
//│ @inline
//│ define foo¹ as fun foo²(x)(y) {
//│   do Predef⁰.print⁰("hi");
//│   return lambda¹
//│ };
//│ do Predef⁰.print⁰("hi");
//│ set f² = lambda¹;
//│ do Predef⁰.print⁰("hello");
//│ return 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ > hello
//│ = 42
//│ f = fun


// * The wrapper is still inlined using the alternative inlining threshold
:inlineThreshold 0
:soir
foo(1)(2)(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ do Predef⁰.print⁰("hi"); return lambda¹(3)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ = 42

// * Note that in this example, we share the worker call result (unlike examples at the beginning of the file)
:soir
let f = foo(1)(2)
print("hello")
f(3) + f(4)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f³, tmp, tmp1;
//│ do Predef⁰.print⁰("hi");
//│ set f³ = lambda¹;
//│ do Predef⁰.print⁰("hello");
//│ set tmp = lambda¹(3);
//│ set tmp1 = lambda¹(4);
//│ return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ > hello
//│ = 84
//│ f = fun


