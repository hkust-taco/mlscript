:js


fun foo(x)(y) = 42

:soir
let f = foo(1) in f(2)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ return 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


fun foo(x)(y)(z) =
  print("hi")
  x + y + z

:soir
foo(1)(2)(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ do Predef⁰.print⁰("hi"); return 6
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ = 6

// * The unsaturated call `foo(1)(2)` is pure, so it can be propagated
// * to later call sites and combined with their remaining arguments.
:soir
let f = foo(1)(2)
print("hello")
f(3) + f(4)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ set f⁰ = foo⁰(1)(2);
//│ do Predef⁰.print⁰("hello");
//│ do Predef⁰.print⁰("hi");
//│ do Predef⁰.print⁰("hi");
//│ return 13
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hello
//│ > hi
//│ > hi
//│ = 13
//│ f = fun


:global
:inlineThreshold 100


:soir
let f = foo(1)(2) in
  print("hello")
  f(3) + f(4)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ do Predef⁰.print⁰("hello"); do Predef⁰.print⁰("hi"); do Predef⁰.print⁰("hi"); return 13
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hello
//│ > hi
//│ > hi
//│ = 13

:soir
let f = foo(1)(2)
print("hello")
f(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ set f¹ = foo⁰(1)(2); do Predef⁰.print⁰("hello"); do Predef⁰.print⁰("hi"); return 6
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hello
//│ > hi
//│ = 6
//│ f = fun


:soir
fun foo(x)(y) =
  print("hi")
  z => 42
let f = foo(1)(2)
print("hello")
f(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let foo$worker, lambda;
//│ @inline
//│ define foo¹ as fun foo²(x)(y) {
//│   return foo$worker⁰(x, y)
//│ };
//│ define foo$worker as fun foo$worker⁰(x, y) {
//│   let lambda1;
//│   do Predef⁰.print⁰("hi");
//│   @private
//│   define lambda1 as fun lambda⁰(z) {
//│     return 42
//│   };
//│   return lambda⁰
//│ };
//│ do Predef⁰.print⁰("hi");
//│ @private
//│ define lambda as fun lambda¹(z) {
//│   return 42
//│ };
//│ set f² = lambda¹;
//│ do Predef⁰.print⁰("hello");
//│ return 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ > hello
//│ = 42
//│ f = fun


// * The wrapper is still inlined using the alternative inlining threshold
:inlineThreshold 0
:soir
foo(1)(2)(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let inlinedVal; set inlinedVal = foo$worker⁰(1, 2); return inlinedVal(3)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ = 42

// * Note that in this example, we share the worker call result (unlike examples at the beginning of the file)
:soir
let f = foo(1)(2)
print("hello")
f(3) + f(4)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, inlinedVal;
//│ set inlinedVal = foo$worker⁰(1, 2);
//│ set f³ = inlinedVal;
//│ do Predef⁰.print⁰("hello");
//│ set tmp = inlinedVal(3);
//│ set tmp1 = inlinedVal(4);
//│ return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ > hello
//│ = 84
//│ f = fun


// * Do not propagate an unsaturated call prefix if it mentions a local
// * that has gone out of scope by the later call site.
:soir
fun scopedPrefixFoo(x)(y) = x + y
() =>
  let f
  if maybe is
    false then 0
    true then
      scope.locally of (
        let x = hide(0)
        f = scopedPrefixFoo(x)
      )
  print of
    "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello"
  f(2)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let lambda;
//│ @inline
//│ define scopedPrefixFoo⁰ as fun scopedPrefixFoo¹(x)(y) {
//│   return +⁰(x, y)
//│ };
//│ @private
//│ define lambda as fun lambda²() {
//│   let f, scrut;
//│   set scrut = Predef⁰.maybe⁰;
//│   match scrut
//│     false =>
//│       end
//│     true =>
//│       let x;
//│       set x = Predef⁰.hide⁰(0);
//│       set f = scopedPrefixFoo¹(x);
//│       end
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   do Predef⁰.print⁰("Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello");
//│   return f(2)
//│ };
//│ return lambda²
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun

