// Bodies below the alternative inlining threshold should not get a worker.
:soir
fun tiny(x)(y) = y
tiny(1)(2)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tiny⁰; define tiny⁰ as fun tiny¹(x)(y) { return y }; 2
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2

