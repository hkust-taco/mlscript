:js


// * This can be made a tail call
:soir
fun foo() =
  let x = hide(42)
  x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define foo⁰ as fun foo¹() { return Predef⁰.hide⁰(42) }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// * The call should NOT be moved into the conditional, here, as it is impure
:soir
fun foo() =
  let x = hide(42)
  if maybe then
    x
  else
    0
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define foo² as fun foo³() {
//│   let x, scrut;
//│   set x = Predef⁰.hide⁰(42);
//│   set scrut = Predef⁰.maybe⁰;
//│   match scrut
//│     true =>
//│       return x
//│     else
//│       return 0
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


fun bar(x)(y) = x + y

// * This `bar(42)` call is pure (because unsaturated) and can be moved into tail position
:soir
:noInline
fun foo() =
  let x = bar(42)
  print("Hello")
  if maybe then
    x
  else
    0
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define foo⁴ as fun foo⁵() {
//│   let scrut;
//│   do Predef⁰.print⁰("Hello");
//│   set scrut = Predef⁰.maybe⁰;
//│   match scrut
//│     true =>
//│       return bar⁰(42)
//│     else
//│       return 0
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// * This can still be made a tail call because the pure statement on the way is dropped
:soir
fun foo() =
  let x = hide(42)
  let y = bar(42)
  x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define foo⁶ as fun foo⁷() { return Predef⁰.hide⁰(42) }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


fun const(x)(y) = x

:soir
fun main =
  let x
  x = const(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define main⁰ as fun main¹() { return runtime⁰.Unit⁰ }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


