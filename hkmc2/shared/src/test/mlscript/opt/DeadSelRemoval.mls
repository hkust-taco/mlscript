:soir
do
  val x = 2 + 2
  val y = print(2)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ do Predef⁰.print⁰(2); return runtime⁰.Unit⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2


scope.locally of (
  val x = 1
  val y = print(2)
  123
)
//│ > 2
//│ = 123


// :soir
module Foo with
  mut val x = 1
  fun y =
    set x += 1
    print(x)

Foo.x
//│ = 1

// * The first selection is pure and can be removed
:soir
Foo.x, Foo.x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ return Foo⁰.x⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

// * TODO: also optimize
Foo.x; Foo.x
//│ = 1

// * Cannot remove the first selection!
:soir
:expect 2
Foo.y, Foo.x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ do Foo⁰.y⁰; return Foo⁰.x⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ = 2

:expect 3
Foo.y; Foo.x
//│ > 3
//│ = 3


let a = Foo.x in Foo.x
//│ = 3

:expect 4
let a = Foo.y in Foo.x
//│ > 4
//│ = 4


(
  val a = print("hi")
  42
)
//│ > hi
//│ = 42

:soir
:ssjs
(
  val a = Foo.y
  42
)
