//│ do Predef⁰.print⁰("hi"); 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ = 42

:soir
:ssjs
(
  val a = Foo.y
  42
)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
