:expect 123
scope.locally of {
  val x = 1
  val y = print(2)
  123
}
//│ > 2
//│ = 123


// :soir
module Foo with
  mut val x = 1
  fun y =
    set x += 1
    print(x)

Foo.x
//│ = 1

// * TODO: The first selection is free of side effects and should be dropped,
// * but it is not pure, as it reads mutable state, and we do not currently distinguish the two.
:soir
Foo.x, Foo.x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ do Foo⁰.x⁰; return Foo⁰.x⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

// * TODO: also optimize
Foo.x; Foo.x
//│ = 1

// * Cannot remove the first selection!
:soir
:expect 2
Foo.y, Foo.x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, tmp2;
//│ set tmp = Foo⁰.x⁰;
//│ set tmp1 = +⁰(tmp, 1);
//│ set Foo⁰.x⁰ = tmp1;
//│ set tmp2 = Foo⁰.x⁰;
//│ do Predef⁰.print⁰(tmp2);
//│ return Foo⁰.x⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ = 2

:expect 3
Foo.y; Foo.x
//│ > 3
//│ = 3


let a = Foo.x in Foo.x
//│ = 3

:expect 4
let a = Foo.y in Foo.x
//│ > 4
//│ = 4


:expect 42
{
  val a = print("hi")
  42
}
//│ > hi
//│ = 42

