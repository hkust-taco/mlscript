fun addUntilN(xs, n) =
  if n <= 0 then xs
  else addUntilN([n] ++ xs, n - 1)

:silent
let zs = addUntilN(mk(), 1000)

:expect 1000
zs.length
//│ = 1000

fun popUntilEmpty(lft, acc) =
  if lft is
    [a, ...ls] then popUntilEmpty(ls, [..acc, a])
    [] then acc

:sjs
fun popByIndex(start, end, acc, lft) =
  if start >= end then acc
  else popByIndex(start + 1, end, [...acc, lft.at(start)], lft)
