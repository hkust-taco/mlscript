:.
:js

import "../../mlscript-compile/Stack.mls"
open Stack

:expect [1, 2, 3]
toArray(1 :: 2 :: 3 :: Nil)
//│ = [1, 2, 3]

:expect [3, 2, 1]
toReverseArray(1 :: 2 :: 3 :: Nil)
//│ = [3, 2, 1]

:expect []
toArray(Nil)
//│ = []

:expect []
toReverseArray(Nil)
//│ = []

:expect [42]
toArray(42 :: Nil)
//│ = [42]

:expect [1, 2, 3]
toArray(fromArray([1, 2, 3]))
//│ = [1, 2, 3]

// Zip accumulates its row backwards, so it needs the reverse conversion.
:expect [[1, "a", true], [2, "b"]]
toArray(zip(1 :: 2 :: Nil, "a" :: "b" :: Nil, true :: Nil))
//│ = [[1, "a", true], [2, "b"]]
