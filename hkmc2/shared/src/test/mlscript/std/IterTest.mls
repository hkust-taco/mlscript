fun xs = [1, 2, 3] Iter.mapping(=> _ + "!" !> print)

xs
//│ = IterableImpl(_)

xs.toArray()
//│ > 1!
//│ > 2!
//│ > 3!
//│ = ["1!", "2!", "3!"]

