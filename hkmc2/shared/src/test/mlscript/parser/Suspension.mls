:js


print of ...
123
//│ > 123

print of...
123
//│ > 123

print of
  123
//│ > 123


// * Interesting quirk:

print of ...
[1, 2]
//│ > [1, 2]

print of ...
  [1, 2]
//│ > 1 2


if true do...

if true do...
print(1)
//│ > 1


module Option with ...

module Option with ...
val a = 1

module Option with ...
// 
val a = 1
// 

:pt
module A with
  
  module B with ...
  
  val a = 1
  
  val b = 2
  
//│ ———————————————| Parsed tree |——————————————————————————————————————————————————————————————————————
//│ TypeDef:
//│   k = Mod
//│   head = InfixApp:
//│     lhs = Ident of "A"
//│     kw = Keywrd of keyword 'with'
//│     rhs = Block of Ls of
//│       TypeDef:
//│         k = Mod
//│         head = InfixApp:
//│           lhs = Ident of "B"
//│           kw = Keywrd of keyword 'with'
//│           rhs = Block of Ls of
//│             TermDef:
//│               k = ImmutVal
//│               head = Ident of "a"
//│               rhs = S of IntLit of 1
//│             TermDef:
//│               k = ImmutVal
//│               head = Ident of "b"
//│               rhs = S of IntLit of 2
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


fun test(x) =
  if x then print("ok") else...
  print("ko")
let foo = 1
//│ foo = 1


:w
x =>
  if false then 0 else...
  1
let bar = 1
//│ ╔══[WARNING] Pure expression in statement position
//│ ║  l.86: 	x =>
//│ ║        	^^^^
//│ ║  l.87: 	  if false then 0 else...
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.88: 	  1
//│ ╙──      	^^^
//│ bar = 1

bar
//│ = 1


:w
:e
x => if false then 0 else...
  1
