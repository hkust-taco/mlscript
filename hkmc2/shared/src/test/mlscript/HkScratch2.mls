+ 1
+ 2
//│ = 3

let res =
  + 1
  + 2
//│ res = 3

0 *
  + 1
  + 2
//│ = 0

x =>
  + 1
  + 2
//│ = fun


let res =
  | 1
//│ res = 1

| 2 + 2
*
| 3 + 3
//│ = 24

2 + 2
*
3 + 3
//│ = 24

2 + 2
  *
3 + 3
//│ = 11

| 2 + 2
  *
| 3 + 3
//│ = 14

2 + 2 * | 3 + 3
//│ = 14

:pt
1 + | 2 + 3
//│ Parsed tree:
//│ OpApp:
//│   lhs = IntLit of 1
//│   op = Ident of "+"
//│   rhss = Ls of 
//│     App:
//│       lhs = Ident of "|"
//│       rhs = Tup of Ls of 
//│         OpApp:
//│           lhs = IntLit of 2
//│           op = Ident of "+"
//│           rhss = Ls of 
//│             IntLit of 3
//│ = 6


// :pt
// :de
// :s
pattern Bin =
  | 0

0 is Bin
//│ = true

1 is Bin
//│ = false


:fixme
let res =
  | 1
  | 2
//│ ╔══[COMPILATION ERROR] Unexpected term form in expression position (composed type)
