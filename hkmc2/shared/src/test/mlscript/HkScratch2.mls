// :dp
// :pt
pattern Bin =
  | 0
  | 1

0 is Bin
//│ = true

1 is Bin
//│ = true

2 is Bin
//│ = false


pattern Bin =
  | 0 => false
  | 1 => true

Bin.unapply(0)
//│ = MatchSuccess(false, {})
Bin.unapply(1)
//│ = MatchSuccess(true, {})
Bin.unapply(2)
//│ = MatchFailure(null)


