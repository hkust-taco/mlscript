let xs = Seq
  \ {key: "A", value: 1}
  \ {key: "B", value: 2}
  \ {key: "A", value: 3}
  \ {key: "B", value: 4}
//│ xs = Seq({key: "A", value: 1}, {key: "B", value: 2}, {key: "A", value: 3}, {key: "B", value: 4})

xs.groupMapReduce
  \ x => x.'key
  \ x => x.'value
  \ (x, y) => x + y
//│ = Map(2) {"A" => 4, "B" => 6}

xs.groupMapReduce
  \ => _.'key
  \ => _.'value
  \ => _ + _
//│ = Map(2) {"A" => 4, "B" => 6}

xs.groupMapReduce
  \ _.key
  \ _.value
  \ _ + _
//│ = Map(2) {"A" => 4, "B" => 6}


let xs = Seq
  \ { key: "A", value: 1 }
  \ { key: "B", value: 2 }
//│ xs = Seq({key: "A", value: 1}, {key: "B", value: 2})


fun Seq[A](...xs: Array[A]): Seq[A] = new Seq(xs)
class Seq[out A] {
  constructor(val elements: Array[A])
  fun map[B](f: A -> B) = new Seq \ elements.map \ pass1 \ f
}

