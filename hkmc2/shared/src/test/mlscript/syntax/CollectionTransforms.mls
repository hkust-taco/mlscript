fun Seq[A](...xs: Array[A]) = new Seq(xs)
class Seq[out A] {
  
  // constructor(val ...xs: A) // TODO: support
  constructor(val elements: Array[A])
  
  fun map[B](f: A -> B): Seq[B] = new Seq \ elements.map \ pass1 \ f
  
  fun groupMapReduce[B, C](getKey: A -> B, getValue: A -> C, reduce: (C, C) -> C): Map[B, C] =
    let groups = new Map[B, C]()
    elements.forEach \ pass1 \ e =>
      let
        key = getKey(e)
        value = getValue(e)
      if groups.has(key) then
        let oldValue = groups.get(key)
        groups.set(key, reduce(oldValue, value))
      else
        groups.set(key, value)
    groups
  
  override fun toString() = "Seq(" + elements.map(pass1 \ renderAsStr).join(", ") + ")"
}


let xs = Seq(1, 2, 3)
//│ xs = Seq(1, 2, 3)

xs.map(=> _ + 1).map(=> _ * 2).map(=> _ - 1)
//│ = Seq(3, 5, 7)

xs
  .map(=> _ + 1)
  .map(=> _ * 2)
  .map(=> _ - 1)
//│ = Seq(3, 5, 7)

xs
  .map \ _ + 1
  .map \ _ * 2
  .map \ _ - 1
//│ = Seq(3, 5, 7)

xs
  .map \ x => x + 1
  .map \ x => x * 2
  .map \ x => x - 1
//│ = Seq(3, 5, 7)

