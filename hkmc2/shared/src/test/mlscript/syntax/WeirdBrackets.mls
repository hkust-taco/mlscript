class Box[T](val content: T)

:ucs desugared
fun interesting(x) =
  if x is Box( Int then 1, Bool then 2 )
//│ Split with nested patterns:
//│ >  if
//│ >    x is member:Box⁰^term:interesting⁰(member:Int⁰^term:interesting⁰) then 1
//│ >    x is member:Box⁰^term:interesting⁰(member:Bool⁰^term:interesting⁰) then 2
//│ Expanded split with flattened patterns:
//│ >  ‹if|while›
//│ >    x is member:Box⁰^term:interesting⁰(arg$Box$0$) and tmp:arg$Box$0$ is member:Int⁰^term:interesting⁰ then 1
//│ >    x is member:Box⁰^term:interesting⁰(arg$Box$0$) and tmp:arg$Box$0$ is member:Bool⁰^term:interesting⁰ then 2

interesting of Box(42)
//│ = 1

interesting of Box(true)
//│ = 2

:re
