// The annotations for the following expressions are not supported for now.

module debug

:w
@debug 0
//│ ╔══[WARNING] The annotation qualifier is not applied
//│ ║  l.6: 	@debug 0
//│ ║       	 ^^^^^
//│ ╟── Because annotations are not supported for integer literal
//│ ║  l.6: 	@debug 0
//│ ╙──     	       ^

:w
@debug 1 + 2
//│ ╔══[WARNING] The annotation qualifier is not applied
//│ ║  l.15: 	@debug 1 + 2
//│ ║        	 ^^^^^
//│ ╟── Because annotations are not supported for application
//│ ║  l.15: 	@debug 1 + 2
//│ ╙──      	       ^^^^^

:w
(@debug 1 + 2)
//│ ╔══[WARNING] The annotation qualifier is not applied
//│ ║  l.24: 	(@debug 1 + 2)
//│ ║        	  ^^^^^
//│ ╟── Because annotations are not supported for application
//│ ║  l.24: 	(@debug 1 + 2)
//│ ╙──      	        ^^^^^

:w
(@debug 1) + 2
//│ FAILURE: Unexpected lack of warnings

:w
(1 + @debug 2)
//│ FAILURE: Unexpected lack of warnings

class Log(msg: Str)

:w
id(@Log 5)
//│ FAILURE: Unexpected lack of warnings

:pe
:w
@1 + 2 class Qux
//│ ╔══[PARSE ERROR] Expected end of input; found 'class' keyword instead
//│ ║  l.48: 	@1 + 2 class Qux
//│ ╙──      	       ^^^^^
//│ ╔══[WARNING] The annotation qualifier is not applied
//│ ║  l.48: 	@1 + 2 class Qux
//│ ║        	 ^
//│ ╟── Because annotations are not supported for application
//│ ║  l.48: 	@1 + 2 class Qux
//│ ╙──      	   ^^^
