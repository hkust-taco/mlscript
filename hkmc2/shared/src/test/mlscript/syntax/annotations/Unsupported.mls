//│ ║  l.45: 	(@debug 1) + 2
//│ ║        	  ^^^^^
//│ ╟── Such annotations are not supported on integer literal terms.
//│ ║  l.45: 	(@debug 1) + 2
//│ ╙──      	        ^
//│ = 3

:w
(1 + @debug 2)
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.55: 	(1 + @debug 2)
//│ ║        	      ^^^^^
//│ ╟── Such annotations are not supported on integer literal terms.
//│ ║  l.55: 	(1 + @debug 2)
//│ ╙──      	            ^
//│ = 3

data class Log(msg: Str)

:w
id(@Log 5)
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.67: 	id(@Log 5)
