:.
:js
// The annotations for the following expressions are not supported for now.

object debug

import "../../../mlscript-compile/StrOps.mls"

:w
@debug
open StrOps
//│ ╔══[WARNING] This annotation has no effect
//│ ║  l.+1: 	@debug
//│ ║        	^^^^^^
//│ ╟── Annotations are not supported on open terms.
//│ ║  l.+2: 	open StrOps
//│ ╙──      	^^^^^^^^^^^

:w
@debug 0
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	@debug 0
//│ ║        	^^^^^^
//│ ╟── This annotation is not supported on integer literal terms.
//│ ║  l.+1: 	@debug 0
//│ ╙──      	       ^
//│ = 0

:w
@debug 1 + 2
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	@debug 1 + 2
//│ ║        	^^^^^^
//│ ╟── This annotation is not supported on application terms.
//│ ║  l.+1: 	@debug 1 + 2
//│ ╙──      	       ^^^^^
//│ = 3

:w
(@debug 1 + 2)
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	(@debug 1 + 2)
//│ ║        	 ^^^^^^
//│ ╟── This annotation is not supported on application terms.
//│ ║  l.+1: 	(@debug 1 + 2)
//│ ╙──      	        ^^^^^
//│ = 3

:w
(@debug 1) + 2
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	(@debug 1) + 2
//│ ║        	 ^^^^^^
//│ ╟── This annotation is not supported on integer literal terms.
//│ ║  l.+1: 	(@debug 1) + 2
//│ ╙──      	        ^
//│ = 3

:w
(1 + @debug 2)
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	(1 + @debug 2)
//│ ║        	     ^^^^^^
//│ ╟── This annotation is not supported on integer literal terms.
//│ ║  l.+1: 	(1 + @debug 2)
//│ ╙──      	            ^
//│ = 3

data class Log(msg: Str)

:w
id(@Log 5)
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	id(@Log 5)
//│ ║        	   ^^^^
//│ ╟── This annotation is not supported on integer literal terms.
//│ ║  l.+1: 	id(@Log 5)
//│ ╙──      	        ^
//│ = 5

:pe
:re
@1 + 2 class Qux
//│ ╔══[PARSE ERROR] Expected end of input; found 'class' keyword instead
//│ ║  l.+1: 	@1 + 2 class Qux
//│ ╙──      	       ^^^^^
//│ ═══[RUNTIME ERROR] TypeError: 3 is not a function
