:.
:js


// The `@compile` annotation should annotate `A(0)`, not `A(0) as y`.
// The precedence of annotations should be tight enough to not include `as`.

pattern A(pattern B) = B


:expect 0
fun foo(x) = if x is @annotations.compile A(0) as y then y
foo(0)
//│ = 0

:expect 0
fun foo(x) = if x is (@annotations.compile A(0)) as y then y
foo(0)
//│ = 0

// :pt
// :re
// if 1 is (@annotations.compile A(0)) as y then y

:expect 0
fun foo(x) = if x is @annotations.compile (A(0) as y) then y
foo(0)
//│ = 0

:expect 0
fun foo(x) = if x is @annotations.compile {A(0) as y} then y
foo(0)
//│ = 0

:expect 0
fun foo(x) = if x is (@annotations.compile (A(0) as y)) then y
foo(0)
//│ = 0

:pe // parses as `@annotations.compile(A(0) as y) ‹missing annot body›`
:e
fun foo(x) = if x is (@annotations.compile(A(0) as y)) then y
//│ ╔══[PARSE ERROR] Expected start of expression in this position
//│ ║  l.+1: 	fun foo(x) = if x is (@annotations.compile(A(0) as y)) then y
//│ ║        	                                                     ^
//│ ╟── found a lone annotation instead
//│ ║  l.+1: 	fun foo(x) = if x is (@annotations.compile(A(0) as y)) then y
//│ ╙──      	                      ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Unrecognized pattern (‹erroneous syntax›).
//│ ║  l.+1: 	fun foo(x) = if x is (@annotations.compile(A(0) as y)) then y
//│ ╙──      	                                                     ^
//│ ╔══[COMPILATION ERROR] Name not found: y
//│ ║  l.+1: 	fun foo(x) = if x is (@annotations.compile(A(0) as y)) then y
//│ ╙──      	                                                            ^

:expect 0
fun foo(x) = if x is (@annotations.compile {A(0) as y}) then y
foo(0)
//│ = 0

:expect 0
fun foo(x) = if x is (@annotations.compile A(0) as y) then y
foo(0)
//│ = 0


// Using a dummy annotation to test that annotations gobble

type Test

:e
:w
@Test 1
//│ ╔══[COMPILATION ERROR] Resolution error in member reference
//│ ║  l.+1: 	@Test 1
//│ ║        	^^^^^
//│ ╙── Expected a term; got type alias 'Test'
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	@Test 1
//│ ║        	^^^^^
//│ ╟── This annotation is not supported on integer literal terms.
//│ ║  l.+1: 	@Test 1
//│ ╙──      	      ^
//│ = 1

:e
:w
@Test 2 + 1
//│ ╔══[COMPILATION ERROR] Resolution error in member reference
//│ ║  l.+1: 	@Test 2 + 1
//│ ║        	^^^^^
//│ ╙── Expected a term; got type alias 'Test'
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	@Test 2 + 1
//│ ║        	^^^^^
//│ ╟── This annotation is not supported on application terms.
//│ ║  l.+1: 	@Test 2 + 1
//│ ╙──      	      ^^^^^
//│ = 3

:e
:w
@Test 2 as Int
//│ ╔══[COMPILATION ERROR] Resolution error in member reference
//│ ║  l.+1: 	@Test 2 as Int
//│ ║        	^^^^^
//│ ╙── Expected a term; got type alias 'Test'
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	@Test 2 as Int
//│ ║        	^^^^^
//│ ╟── This annotation is not supported on type ascription terms.
//│ ║  l.+1: 	@Test 2 as Int
//│ ╙──      	      ^^^^^^^^
//│ = 2

:e
:w
@Test id(2) as Int
