object inline

:w
// All functions are annotated with @inline.
@inline
fun
  min(x, y) = if x < y then x else y
  max(x, y) = if x > y then x else y
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.80: 	@inline
//│ ╙──      	 ^^^^^^
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.80: 	@inline
//│ ╙──      	 ^^^^^^

:w
@inline let
  abs(x) = if x < 0 then -x else x
  clamp(x, lo, hi) = min(max(x, lo), hi)
//│ ╔══[WARNING] This annotation has no effect
//│ ║  l.92: 	@inline let
