object inline

:w
// All functions are annotated with @inline.
@inline
fun
  min(x, y) = if x < y then x else y
  max(x, y) = if x > y then x else y
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.84: 	@inline
//│ ╙──      	^^^^^^^
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.84: 	@inline
//│ ╙──      	^^^^^^^

:w
@inline let
  abs(x) = if x < 0 then -x else x
  clamp(x, lo, hi) = min(max(x, lo), hi)
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.96: 	@inline let
//│ ╙──      	^^^^^^^
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.96: 	@inline let
//│ ╙──      	^^^^^^^
//│ abs = fun abs
//│ clamp = fun clamp

:w
// Only the first variable is annotated with @inline.
let
  @inline success = 0
  failure = 1
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.111: 	  @inline success = 0
//│ ╙──       	  ^^^^^^^
//│ failure = 1
//│ success = 0

// Multiple annotations
// ====================

:w
@inline @tailrec fun fib(n) =
  if n < 2 then n else fib(n - 1) + fib(n - 2)
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.123: 	@inline @tailrec fun fib(n) =
//│ ╙──       	^^^^^^^
//│ ╔══[WARNING] This annotation has no effect.
