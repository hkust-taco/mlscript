:js

module tailrec

tailrec
//│ = tailrec { class: [class tailrec] }

@tailrec fun fact_n(n, acc) =
  if n == 0 then acc else fact(n - 1, n * acc)
  
fun fact(n) =
  @tailrec fun go(n, acc) =
    if n == 0 then acc else go(n - 1, n * acc)
  go(n, 1)

