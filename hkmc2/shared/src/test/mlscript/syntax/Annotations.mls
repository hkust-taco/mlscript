module debug

@debug 0
//│ = 0

@debug 1 + 2
//│ = 3

(@debug 1 + 2)
//│ = 3

(@debug 1) + 2
//│ = 3

(1 + @debug 2)
//│ = 3

class Log(msg: Str)

fact(@Log 5)
//│ = 120

class Freezed(degree: Num)

@Freezed(-273.15) class AbsoluteZero

@Freezed(-18) class Beverage(name: Str)

@Freezed(-4) let drink = Beverage("Coke")
//│ drink = Beverage { name: 'Coke' }

module Foo with
  class Bar(qax: Str)

@Foo.Bar("baz") class Qux

@42 class Qux

