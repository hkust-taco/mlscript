// An escaping callback's unannotated input must admit external callers, even if its local calls
// all pass a record containing `answer`. Initializers already produce the required diagnostic.
:e
private fun initialCallback(value) = value.answer
fun exportInitialCallback() = {mut callback: initialCallback}
initialCallback({answer: 42})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
