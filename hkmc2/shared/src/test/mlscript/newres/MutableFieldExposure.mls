// FIXME: The same callback escapes through assignment, but receives no unknown external input.
:breakme
:e
private fun assignedCallback(value) = value.answer
fun exportAssignedCallback() =
  let record = {mut callback: 0}
  set record.callback = assignedCallback
  record
assignedCallback({answer: 42})
//│ = 42
