// The copied field retains the paths of both returned spread records.
:ge
private class NestedCell(mut val value)
private fun original() = {item: 0}
private fun intermediate() = {...original()}
fun exportNestedCopy() =
  let copy = mut {...intermediate()}
  set copy.item = NestedCell(1)
  copy
