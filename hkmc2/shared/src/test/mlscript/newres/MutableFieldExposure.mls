// An assigned closure retains its generic factory's substitution and scope exits.
:ge
private fun make[T](seed: T) =
  fun callback(value) = value.answer
  let record = {mut callback: 0}
  set record.callback = callback
  callback({answer: seed})
  record
fun exportGenericCallback() = make(42)
