// Each call instantiates the inherited argument type, whether the override names it or omits it.
:expect [11, 22, 33, 44]
private class LeftItem(val left: Int)
private class RightItem(val right: Int)
private class IdentityBase with
  open fun id[A](x: A): A = x
private class NamedIdentity extends IdentityBase with
  override fun id[B](x) = x
private class InferredIdentity extends IdentityBase with
  override fun id(x) = x
[
  new NamedIdentity().id[LeftItem](LeftItem(11)).left,
  new NamedIdentity().id[RightItem](RightItem(22)).right,
  new InferredIdentity().id(LeftItem(33)).left,
  new InferredIdentity().id(RightItem(44)).right,
]
//│ = [11, 22, 33, 44]

// Storing the generic method once still permits a different type argument on each invocation.
:expect [7, 8]
private val savedIdentity = new NamedIdentity().id
[savedIdentity[LeftItem](LeftItem(7)).left, savedIdentity[RightItem](RightItem(8)).right]
//│ = [7, 8]
//│ savedIdentity = fun id

// An explicitly written result B reads the type argument inferred through the inherited parameter x.
:expect [7, 9]
private class ResultBase with
  open fun id[A](x: A): A = x
private class NamedResult extends ResultBase with
  override fun id[B](x): B = x
private val pick = new NamedResult().id
[pick(LeftItem(7)).left, pick(RightItem(9)).right]
//│ = [7, 9]
//│ pick = fun id

// A single selection can dispatch to overrides with different method type parameters.
:expect [5, 6]
private class OtherIdentity extends IdentityBase with
  override fun id[C](x) = x
private fun receiver(flag) = if flag then new NamedIdentity else new OtherIdentity
private fun dispatch[T](x: T, flag) = receiver(flag).id[T](x)
[dispatch[LeftItem](LeftItem(5), true).left, dispatch[RightItem](RightItem(6), false).right]
//│ = [5, 6]

// An explicit type argument determines which members a direct caller can select on the result.
:e
private class General
private class Special extends General with
  val extra = 5
new NamedIdentity().id[General](new Special).extra
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+4: 	new NamedIdentity().id[General](new Special).extra
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Value of type 'General' does not contain member 'extra'
//│ ║  l.+4: 	new NamedIdentity().id[General](new Special).extra
//│ ╙──      	                       ^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A separate polymorphic signature retains binders for explicit type application.
:expect [11, 12]
class First(val first: Int)
class Second(val second: Int)
private fun identity: [A] -> A -> A
private fun identity(x) = x
[identity[First](First(11)).first, identity[Second](Second(12)).second]
//│ = [11, 12]

// A polymorphic value annotation also retains its own binders.
:expect 13
class Item(val value: Int)
let identity = (x => x) as [A] -> A -> A
identity[Item](Item(13)).value
//│ = 13
//│ identity = fun identity

// Explicit arguments of an annotated polymorphic value restrict its result interface.
:ge
class Base
class Child extends Base with
  val extra = 1
let identity = (x => x) as [A] -> A -> A
identity[Base](new Child).extra
//│ ╔══[COMPILATION ERROR] Resolution error in selection
