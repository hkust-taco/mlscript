:.

// An inferred result combines a declared type parameter and ordinary value flow.
// Both calls must preserve their own annotations and unannotated argument shapes.
:expect [1, 2, 3, 4]
class First(val first: Int)
class Second(val second: Int)
private fun pair[A](x: A, y) = [x, y]
let left = pair(First(1), Second(2))
let right = pair(Second(3), First(4))
[left.0.first, left.1.second, right.0.second, right.1.first]
//│ = [1, 2, 3, 4]
//│ left = [First(1), Second(2)]
//│ right = [Second(3), First(4)]

// An unannotated callback and inferred result retain their dependence on A.
:expect [5, 6]
class First(val first: Int)
class Second(val second: Int)
private fun apply[A](x: A, f) = f(x)
[apply(First(5), x => x.first), apply(Second(6), x => x.second)]
//│ = [5, 6]

// An omitted trailing type argument is a hole inferred from each caller.
// The written Int argument and the Pair interface remain in place.
// TODO: template argument rebasing must not introduce a lossy wildcard round trip.
:fixme
:expect [1, 2]
class First(val first: Int)
class Second(val second: Int)
class Pair[A, B](val value: [A, B])
private fun second(pair: Pair[Int]) = pair.value.1
[second(Pair([0, First(1)])).first, second(Pair([0, Second(2)])).second]
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+5: 	[second(Pair([0, First(1)])).first, second(Pair([0, Second(2)])).second]
//│ ║        	 ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Instance of class 'Second' does not contain member 'first'
//│ ║  l.+5: 	[second(Pair([0, First(1)])).first, second(Pair([0, Second(2)])).second]
//│ ╙──      	                                                    ^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+5: 	[second(Pair([0, First(1)])).first, second(Pair([0, Second(2)])).second]
//│ ║        	                                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Instance of class 'First' does not contain member 'second'
//│ ║  l.+5: 	[second(Pair([0, First(1)])).first, second(Pair([0, Second(2)])).second]
//│ ╙──      	                 ^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ ═══[RUNTIME ERROR] Expected: '[1, 2]', got: 'undefined'

// Bare alias uses infer their omitted argument without losing the alias body.
// TODO: the same template argument rebasing loses caller IDs through the alias.
:fixme
:expect [3, 4]
class First(val first: Int)
class Second(val second: Int)
class Pair[A, B](val value: [A, B])
type HalfPair[T] = Pair[Int, T]
private fun second(pair: HalfPair) = pair.value.1
[second(Pair([0, First(3)])).first, second(Pair([0, Second(4)])).second]
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+6: 	[second(Pair([0, First(3)])).first, second(Pair([0, Second(4)])).second]
//│ ║        	 ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Instance of class 'Second' does not contain member 'first'
//│ ║  l.+6: 	[second(Pair([0, First(3)])).first, second(Pair([0, Second(4)])).second]
//│ ╙──      	                                                    ^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+6: 	[second(Pair([0, First(3)])).first, second(Pair([0, Second(4)])).second]
//│ ║        	                                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Instance of class 'First' does not contain member 'second'
//│ ║  l.+6: 	[second(Pair([0, First(3)])).first, second(Pair([0, Second(4)])).second]
//│ ╙──      	                 ^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ ═══[RUNTIME ERROR] Expected: '[3, 4]', got: 'undefined'

// A bare Array annotation has an inferred element hole in both positions.
// This case has no declared type binder to instantiate at either call.
// TODO: template argument rebasing currently mixes the two callers' hole bounds.
:fixme
:expect [5, 6]
class First(val first: Int)
class Second(val second: Int)
private fun append(xs: Array, value) = xs.push(value)
let xs = mut []
let ys = mut []
append(xs, First(5))
append(ys, Second(6))
[xs.0.first, ys.0.second]
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+8: 	[xs.0.first, ys.0.second]
//│ ║        	 ^^^^^^^^^^
//│ ╟── Instance of class 'Second' does not contain member 'first'
//│ ║  l.+7: 	append(ys, Second(6))
//│ ╙──      	           ^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+8: 	[xs.0.first, ys.0.second]
//│ ║        	             ^^^^^^^^^^^
//│ ╟── Instance of class 'First' does not contain member 'second'
//│ ║  l.+6: 	append(xs, First(5))
//│ ╙──      	           ^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ ═══[RUNTIME ERROR] Expected: '[5, 6]', got: 'undefined'
//│ xs = [First(5)]
//│ ys = [Second(6)]

// A returned closure observes annotated and inferred fields after the outer call.
:expect [7, 8, 9, 10]
class First(val first: Int)
class Second(val second: Int)
private fun delayed[A](x: A, y) = () => [x, y]
let left = delayed(First(7), Second(8))
let right = delayed(Second(9), First(10))
[left().0.first, left().1.second, right().0.second, right().1.first]
//│ = [7, 8, 9, 10]
//│ left = fun
//│ right = fun

// Inferring a base member's result must not assume every override returns that shape.
// Either an incompatible override or the unsupported selection must be rejected.
:ge
class Item(val value: Int)
class Other(val other: Int)
class Base with
  open fun item() = Item(1)
class Child extends Base with
  override fun item() = Other(2)
private fun read(x: Base) = x.item().value
read(new Child)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+7: 	private fun read(x: Base) = x.item().value
//│ ║        	                            ^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'value' of a value with unknown shape.
//│ ╟── The shape of this value is unknown.
//│ ║  l.+7: 	private fun read(x: Base) = x.item().value
//│ ╙──      	                            ^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// LocalChild.read inherits Any even though its only direct call supplies a record with 'only'.
:e
private class LocalBase with
  open fun read(x: Any): Int = 0
private class LocalChild extends LocalBase with
  override fun read(x) = x.only
private fun throughBase(p: LocalBase) = p.read(null)
new LocalChild().read({only: 7})
throughBase(new LocalChild)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+4: 	  override fun read(x) = x.only
//│ ║        	                         ^^^^^^
//│ ╟── Value with an empty interface does not contain member 'only'
//│ ║  l.+2: 	  open fun read(x: Any): Int = 0
//│ ║        	                   ^^^
//│ ╟── Type 'Any' is declared without a member interface.
//│ ║  in ../decls/Prelude.mls
//│ ║  l.XX: 	declare type Any
//│ ╙──      	             ^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A call through the base type supplies the unannotated parameter of its override.
:e
private class ReadBase with
  open fun read(x): Int = 0
private class ReadChild extends ReadBase with
  override fun read(x) = x.only
private fun runRead(p: ReadBase) = p.read(null)
new ReadChild().read({only: 7})
runRead(new ReadChild)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+4: 	  override fun read(x) = x.only
//│ ║        	                         ^^^^^^
//│ ╟── Null literal does not contain member 'only'
//│ ║  l.+5: 	private fun runRead(p: ReadBase) = p.read(null)
//│ ╙──      	                                          ^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// The only value for x arrives through the second application of a saved nominal method.
:expect 8
private class ReadItem(val only: Int)
private class CurriedReader with
  fun read(n: Int)(x): Int = n + x.only
private fun remaining(p: CurriedReader) = p.read(1)
remaining(new CurriedReader)(ReadItem(7))
//│ = 8

// An explicit projection locates the method even when the receiver's type has no member interface.
:expect 9
private class ProjectionReader with
  fun read(x): Int = x.only
private fun projectedRead(p: Any, x) = p.ProjectionReader#read(x)
projectedRead(new ProjectionReader, ReadItem(9))
//│ = 9

// A saved nominal method retains each call's own type argument through its remaining parameter list.
:expect [7, 9]
private class ReadOther(val other: Int)
private class PolyReadBase with
  open fun choose[A]()(x: A): A = x
private class PolyReadChild extends PolyReadBase with
  override fun choose[B]()(x): B = x
private fun chooseBoth(p: PolyReadChild) =
  let choose = p.choose
  [choose()(ReadItem(7)).only, choose()(ReadOther(9)).other]
chooseBoth(new PolyReadChild)
//│ = [7, 9]

// The override must also handle every type a base caller can choose for A.
:e
private class PolyBase with
  open fun inspect[A](x: A): Int = 0
private class PolyChild extends PolyBase with
  override fun inspect(x) = x.only
new PolyChild().inspect({only: 7})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+4: 	  override fun inspect(x) = x.only
//│ ║        	                            ^^^^^^
//│ ╟── Cannot resolve member 'only' of a value with unknown shape.
//│ ║  l.+2: 	  open fun inspect[A](x: A): Int = 0
