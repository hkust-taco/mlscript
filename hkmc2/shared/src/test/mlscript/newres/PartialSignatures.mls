:.

// An inferred result combines a declared type parameter and ordinary value flow.
// Both calls must preserve their own annotations and unannotated argument shapes.
:expect [1, 2, 3, 4]
class First(val first: Int)
class Second(val second: Int)
private fun pair[A](x: A, y) = [x, y]
let left = pair(First(1), Second(2))
let right = pair(Second(3), First(4))
[left.0.first, left.1.second, right.0.second, right.1.first]
//│ = [1, 2, 3, 4]
//│ left = [First(1), Second(2)]
//│ right = [Second(3), First(4)]

// An unannotated callback and inferred result retain their dependence on A.
:expect [5, 6]
class First(val first: Int)
class Second(val second: Int)
private fun apply[A](x: A, f) = f(x)
[apply(First(5), x => x.first), apply(Second(6), x => x.second)]
//│ = [5, 6]

// TODO: an omitted trailing type argument is a hole inferred from each caller.
// The written Int argument and the Pair interface remain in place.
:fixme
:expect [1, 2]
class First(val first: Int)
class Second(val second: Int)
class Pair[A, B](val value: [A, B])
private fun second(pair: Pair[Int]) = pair.value.1
[second(Pair([0, First(1)])).first, second(Pair([0, Second(2)])).second]
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.32: 	[second(Pair([0, First(1)])).first, second(Pair([0, Second(2)])).second]
//│ ║        	 ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'first' of a value with unknown shape.
//│ ╟── Type argument 'B' is omitted in this annotation, so its shape is unknown.
//│ ║  l.31: 	private fun second(pair: Pair[Int]) = pair.value.1
//│ ╙──      	                         ^^^^
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.32: 	[second(Pair([0, First(1)])).first, second(Pair([0, Second(2)])).second]
//│ ║        	                                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'second' of a value with unknown shape.
//│ ╟── Type argument 'B' is omitted in this annotation, so its shape is unknown.
//│ ║  l.31: 	private fun second(pair: Pair[Int]) = pair.value.1
//│ ╙──      	                         ^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ ═══[RUNTIME ERROR] Expected: '[1, 2]', got: 'undefined'

// TODO: bare alias uses infer their omitted argument without losing the alias body.
:fixme
:expect [3, 4]
class First(val first: Int)
class Second(val second: Int)
class Pair[A, B](val value: [A, B])
type HalfPair[T] = Pair[Int, T]
private fun second(pair: HalfPair) = pair.value.1
[second(Pair([0, First(3)])).first, second(Pair([0, Second(4)])).second]
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.58: 	[second(Pair([0, First(3)])).first, second(Pair([0, Second(4)])).second]
