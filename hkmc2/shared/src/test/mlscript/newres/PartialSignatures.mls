// TODO: a bare Array annotation has an inferred element hole in both positions.
// This case has no declared type binder to instantiate at either call.
:fixme
:expect [5, 6]
class First(val first: Int)
class Second(val second: Int)
private fun append(xs: Array, value) = xs.push(value)
let xs = mut []
let ys = mut []
append(xs, First(5))
append(ys, Second(6))
[xs.0.first, ys.0.second]
//│ ╔══[COMPILATION ERROR] This selection of member 'first' has no resolved target
//│ ║  l.87: 	[xs.0.first, ys.0.second]
//│ ╙──      	 ^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ ═══[RUNTIME ERROR] Expected: '[5, 6]', got: 'undefined'
//│ xs = [First(5)]
//│ ys = [Second(6)]

// A returned closure observes annotated and inferred fields after the outer call.
:expect [7, 8, 9, 10]
class First(val first: Int)
class Second(val second: Int)
private fun delayed[A](x: A, y) = () => [x, y]
let left = delayed(First(7), Second(8))
let right = delayed(Second(9), First(10))
[left().0.first, left().1.second, right().0.second, right().1.first]
//│ = [7, 8, 9, 10]
//│ left = fun
//│ right = fun

// Inferring a base member's result must not assume every override returns that shape.
// Either an incompatible override or the unsupported selection must be rejected.
:ge
class Item(val value: Int)
class Other(val other: Int)
class Base with
  fun item() = Item(1)
class Child extends Base with
  fun item() = Other(2)
private fun read(x: Base) = x.item().value
read(new Child)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.117: 	private fun read(x: Base) = x.item().value
//│ ║         	                            ^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'value' of a value with unknown shape.
//│ ╟── The shape of this value is unknown.
//│ ║  l.117: 	private fun read(x: Base) = x.item().value
//│ ╙──       	                            ^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A separate polymorphic signature retains binders for explicit type application.
:expect [11, 12]
class First(val first: Int)
class Second(val second: Int)
private fun identity: [A] -> A -> A
private fun identity(x) = x
[identity[First](First(11)).first, identity[Second](Second(12)).second]
//│ = [11, 12]

// A polymorphic value annotation also retains its own binders.
:expect 13
class Item(val value: Int)
let identity = (x => x) as [A] -> A -> A
identity[Item](Item(13)).value
//│ = 13
//│ identity = fun identity

// Explicit arguments of an annotated polymorphic value restrict its result interface.
:ge
class Base
class Child extends Base with
  val extra = 1
let identity = (x => x) as [A] -> A -> A
identity[Base](new Child).extra
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.151: 	identity[Base](new Child).extra
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╙── Value of type 'Base' does not contain member 'extra'
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ identity = fun identity

// Type application checks the retained quantified binder count.
:ge
let identity = (x => x) as [A] -> A -> A
identity[Int, Int](1)
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.162: 	identity[Int, Int](1)
//│ ║         	^^^^^^^^^^^^^^^^^^
//│ ╟── Function with a declared signature expected 1 type argument, but got 2
//│ ║  l.161: 	let identity = (x => x) as [A] -> A -> A
//│ ╙──       	                                  ^^^^^^
//│ = 1
//│ identity = fun identity

// One stored polymorphic value has separate inferred arguments at each call site.
:expect [14, 15]
class First(val first: Int)
class Second(val second: Int)
let identity = (x => x) as [A] -> A -> A
[identity(First(14)).first, identity(Second(15)).second]
//│ = [14, 15]
//│ identity = fun identity

// Specialization is retained by the value; it does not specialize the shared source.
:expect [16, 17]
class First(val first: Int)
class Second(val second: Int)
let identity = (x => x) as [A] -> A -> A
let first = identity[First]
let second = identity[Second]
[first(First(16)).first, second(Second(17)).second]
//│ = [16, 17]
//│ first = fun identity
//│ identity = fun identity
//│ second = fun identity

// Later parameter lists retain the first application's type-parameter instance.
:expect [18, 19]
class First(val first: Int)
class Second(val second: Int)
let keep = (x => y => x) as [A] -> A -> A -> A
let first = keep(First(18))
let second = keep(Second(19))
[first(First(0)).first, second(Second(0)).second]
//│ = [18, 19]
//│ first = fun
//│ keep = fun keep
//│ second = fun

// A stored reference to a fully annotated declaration uses the application's site.
:expect [20, 21]
class First(val first: Int)
class Second(val second: Int)
private fun identity[A](x: A): A = x
let shared = identity
[shared(First(20)).first, shared(Second(21)).second]
//│ = [20, 21]
//│ shared = fun identity

// A returned scheme binds B at its own call while retaining the captured A.
:expect [22, 23, 24, 25]
class First(val first: Int)
class Second(val second: Int)
let pair = (x => y => [x, y]) as [A] -> A -> ([B] -> B -> [A, B])
let first = pair(First(22))
let second = pair(Second(23))
let left = first(Second(24))
let right = second(First(25))
[left.0.first, right.0.second, left.1.second, right.1.first]
//│ = [22, 23, 24, 25]
//│ first = fun
//│ left = [First(22), Second(24)]
//│ pair = fun pair
//│ right = [Second(23), First(25)]
//│ second = fun

// A private returned closure must be checked from its annotation before any call.
class Item(val value: Int)
private fun get(): Item -> Int = x => x.value
