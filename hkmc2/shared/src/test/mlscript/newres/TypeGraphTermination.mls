// A constructor-free output wildcard preserves A and reaches a finite graph.
// Normalizing both argument parts must not retain nested wildcard environments.
type Chain[A] = {value: A, next: Chain[out A]}
private fun walk[A](chain: Chain[A], n: Int) =
  if n > 0 then walk(chain.next, n - 1) else ()

// Input-only and two-part wildcards are finite too. Neither part may retain
// the preceding wildcard as an unevaluated binding layer.
type Chain[A] = {value: A, next: Chain[in A]}
private fun walk[A](chain: Chain[A], n: Int) =
  if n > 0 then walk(chain.next, n - 1) else ()

type Chain[A, B] = {value: A, next: Chain[in B out A, in A out B]}
private fun walk[A, B](chain: Chain[A, B], n: Int) =
  if n > 0 then walk(chain.next, n - 1) else ()
