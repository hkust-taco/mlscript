// Pattern guards execute in the enclosing function's return scope.
:expect 42
fun guardedReturn() =
  if 0 is (_ where (return {answer: 42})) then throw new Error("unreachable")
  else throw new Error("unreachable")
guardedReturn().answer
//│ = 42
