// An impossible conjunction must not exclude either of its alternatives.
:ge
fun stillNull(value: Str | null) =
  if value is ~(null & Str) as text then text.length else 0
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.122: 	  if value is ~(null & Str) as text then text.length else 0
//│ ║         	                                         ^^^^^^^^^^^
//│ ╟── Null literal does not contain member 'length'
//│ ║  l.121: 	fun stillNull(value: Str | null) =
//│ ╙──       	                           ^^^^

// A negated loop condition is checked again after assigning the next link.
:expect [0, 2]
class Link(val next: Link | null)
fun linkCount(head: Link | null) =
  let cur = head
  let count = 0
  while cur is ~null as node do
    set count += 1
    set cur = node.next
  count
[linkCount(null), linkCount(Link(Link(null)))]
//│ = [0, 2]

// Rewritten loops used by effect handlers must also reach the failure exit.
:lift
:effectHandlers
:expect [0, 2]
fun countLinks(head: Link | null) =
  let cur = head
  let count = 0
  while cur is ~null as node do
    set count += 1
    set cur = node.next
  count
[countLinks(null), countLinks(Link(Link(null)))]
//│ = [0, 2]

// A failed negation in an imperative conditional skips its body.
:expect [0, 1]
fun mark(value: TextBox | Empty) =
  let count = 0
  if value is ~Empty do set count = 1
  count
[mark(new Empty), mark(TextBox("abc"))]
//│ = [0, 1]

// A nominal constructor with unrestricted fields can be excluded as a whole.
:expect [0, 3]
fun unboxedLength(value: TextBox | Str) =
  if value is ~TextBox(_) as text then text.length else 0
[unboxedLength(TextBox("abc")), unboxedLength("abc")]
//│ = [0, 3]
