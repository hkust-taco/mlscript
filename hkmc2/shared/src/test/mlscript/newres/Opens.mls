//│ Shadowed = 20


// Explicit selective opens win regardless of their order relative to wildcard opens.
fun namedAfter() = {
  open Values
  open Selected { extra }
  extra
}
fun namedBefore() = {
  open Selected { extra }
  open Values
  extra
}

:expect [6, 6]
[namedAfter(), namedBefore()]
//│ = [6, 6]

:e
fun ambiguousReversed() = {
  open Selected
  open Values
  extra
}
ambiguousReversed()
