// Both the temporary assignment and restoration use the selected open member.
fun temporary() = {
  open Overloaded
  let during = set Item = 21 in Item
  [during, Item]
}

:expect [21, 11]
temporary()
//│ = [21, 11]


module Callable {
  class Make { fun answer() = 22 }
  fun Make() = new Make
}
fun callable() = {
  open Callable
  [Make().answer(), (new Make).answer()]
}

:expect [22, 22]
callable()
//│ = [22, 22]


// Bare pattern names resolve through both forms of open.
:expect [1, 0, 1, 0]
module BarePatterns { class Token }
fun bareWildcard(x) = {
  open BarePatterns
  if x is Token then 1 else 0
}
fun bareNamed(x) = {
  open BarePatterns { Token }
  if x is Token then 1 else 0
}
[bareWildcard(new BarePatterns.Token), bareWildcard(0),
 bareNamed(new BarePatterns.Token), bareNamed(0)]
//│ = [1, 0, 1, 0]
