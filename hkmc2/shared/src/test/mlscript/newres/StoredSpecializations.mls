//│ ═══[RUNTIME ERROR] Expected: '9', got: 'undefined'

// Supplying the scheme's arguments consumes its type parameter list immediately.
:ge
private fun inferred[A](value: A) = value
private fun declared[A](value: A): A = value
private val first = inferred[Int]
private val second = declared[Int]
first[Str]
second[Str]
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.66: 	first[Str]
//│ ║        	^^^^^^^^^^
//│ ╟── Function 'inferred' expected 0 type arguments, but got 1
//│ ║  l.62: 	private fun inferred[A](value: A) = value
//│ ╙──      	        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.67: 	second[Str]
//│ ║        	^^^^^^^^^^^
//│ ╟── Function 'declared' expected 0 type arguments, but got 1
//│ ║  l.63: 	private fun declared[A](value: A): A = value
//│ ╙──      	        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = fun declared
//│ first = fun inferred
//│ second = fun declared

// Arity is checked at specialization even if the value is never called.
:ge
private fun identity[A](value: A) = value
private val tooMany = identity[Int, Str]
//│ ╔══[COMPILATION ERROR] Resolution error in type application
