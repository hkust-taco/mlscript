// The recursive edge also runs: getter reads must retain their runtime effects.
:expect 45
private fun countdown() =
  let remaining = 3
  fun result = if remaining == 0 then {answer: 45} else
    set remaining = remaining - 1
    result
  result.answer
countdown()
//│ = 45

// A base result discovered after a forward reference must reach both getters.
:expect [42, 42]
fun first = second
fun second = if true then {answer: 42} else first
[first.answer, second.answer]
//│ = [42, 42]

// Re-observing completed definitions must replay their inferred result.
:expect 42
first.answer
//│ = 42

// Recursive getters retain the enclosing call's captured value.
:expect [1, 2]
private fun captured(value) =
  fun result = if true then value else result
  result
[captured({left: 1}).left, captured({right: 2}).right]
//│ = [1, 2]

// Selected member getters use the same finite result graph as direct references.
:expect 43
module Getters with
  fun first = second
  fun second = if true then {answer: 43} else first
Getters.first.answer
//│ = 43

// Sharing results must retain each invocation's generic substitution.
:expect [3, 4]
class First(val left: Int)
class Second(val right: Int)
private fun generic[T](value: T) =
  fun result = if true then value else result
  result
[generic(First(3)).left, generic(Second(4)).right]
//│ = [3, 4]

// A by-name generic consumes its own type arguments before returning a closure.
:expect [5, 6]
private fun identity[T] = if true then (value: T) => value else identity[T]
[identity[First](First(5)).left, identity[Second](Second(6)).right]
//│ = [5, 6]

// Imported bodies retain copied listeners and independent caller activations.
import "../../mlscript-compile/GenericLibrary.mls"

:expect [8, 9, 7]
[GenericLibrary.recursiveIdentity(First(8)).left,
 GenericLibrary.recursiveIdentity(Second(9)).right,
 GenericLibrary.recursiveGetter.known]
//│ = [8, 9, 7]

// A result cycle does not grant dynamic member access.
