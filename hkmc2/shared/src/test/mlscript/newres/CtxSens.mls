:sr
class Foo(val a) {
  val b = A
}
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   fun Foo⁰
//│   class Foo¹::Foo²(val a⁰) { val a¹::a² ‹flow:a⁰› = a⁰^a², val b⁰::b¹ ‹flow:b⁰› = A⁰^Foo²^b¹ }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let x = Foo(A)
//│ x = Foo(class A { u: 1 })

:sr
x.a.u
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   x⁰.a¹.u⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

:sr
x.b.u
