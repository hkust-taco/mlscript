:.


:sr
module A {
  val u = 1
}
module B {
  val u = 2
}
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   module A⁰::A¹ { val u⁰::u¹ ‹flow:u⁰› = 1 }, module B⁰::B¹ { val u²::u³ ‹flow:u¹› = 2 }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


fun foo(x) = x

// :de
:sr
foo(A).u
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   foo⁰(A⁰)‹app⁰›.u⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

foo(A).u
//│ = 1

// * We now preserve context sensitivity
:sr
foo(B).u
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   foo⁰(B⁰)‹app¹›.u²
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2


// :de
:sr
fun bar(y) =
  foo(y)
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   fun bar⁰::bar¹(y⁰) ‹flow:bar⁰› = foo⁰^bar¹(y⁰)‹app²›
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

