//│ ╙──       	                   ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ invalidClass = 0

:e
let ambiguousClass = Primary.class
set ambiguousClass = Curried.class
new ambiguousClass
//│ ╔══[COMPILATION ERROR] The class interpretation here is ambiguous
//│ ║  l.373: 	new ambiguousClass
//│ ║         	    ^^^^^^^^^^^^^^
//│ ╟── class 'Primary' defined here
//│ ║  l.7: 	class Primary(val x)
//│ ║       	      ^^^^^^^
//│ ╟── class 'Curried' defined here
//│ ║  l.12: 	class Curried(val x)(val y)
//│ ╙──      	      ^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ ambiguousClass = class Curried

// Storing a constructor function in a variable or a record preserves the same value.
:expect true
let constructors = {make: Primary}
ctor == constructors.make
//│ = true
//│ constructors = {make: fun Primary { class: class Primary }}

:expect [35, 35]
[new ctor(35).x, new constructors.make(35).x]
//│ = [35, 35]

:expect true
ctor.class == constructors.make.class
//│ = true

let curriedCtor = Curried
//│ curriedCtor = fun Curried { class: class Curried }

:expect 44
new curriedCtor(43)(44).y
//│ = 44

let partialCtor = new curriedCtor(45)
//│ partialCtor = fun partialCtor

:expect 46
partialCtor(46).y
//│ = 46

let capturedCtor = earlier.Nested
let capturedRecord = {make: earlier.Nested}
//│ capturedCtor = fun Nested { class: class Nested }
//│ capturedRecord = {make: fun Nested { class: class Nested }}

:noInline
:expect [101, 101, true]
[new capturedCtor(1).result(), new capturedRecord.make(1).result(),
 capturedCtor.class == capturedRecord.make.class]
//│ = [101, 101, true]

// Partial construction reads the constructor's class before a later assignment.
let currentCtor = earlier.Nested
let ctorFactory = new currentCtor
set currentCtor = later.Nested
//│ ctorFactory = fun ctorFactory
//│ currentCtor = fun Nested { class: class Nested }

:noInline
:expect [101, 201]
[ctorFactory(1).result(), new currentCtor(1).result()]
//│ = [101, 201]

:e
let mixedRepresentation = Primary
set mixedRepresentation = Primary.class
new mixedRepresentation
//│ ╔══[COMPILATION ERROR] The class interpretation here is ambiguous
//│ ║  l.441: 	new mixedRepresentation
