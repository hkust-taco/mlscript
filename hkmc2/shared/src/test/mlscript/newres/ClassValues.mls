// Qualified, opened, and captured classes must retain their runtime receiver.
module Namespace {
  class Item(val value)
  class Plain
  val Plain = 100
}

:expect class Item
Namespace.Item.class
//│ = class Item

:expect class Plain
Namespace.Plain.class
//│ = class Plain

open Namespace

:expect true
Item.class == Namespace.Item.class
//│ = true

fun captured(x) = {
  class Local {
    fun value() = x
  }
  val Local = 1
  (new Local.class).value()
}

:expect 23
captured(23)
//│ = 23

// Selecting the runtime class does not instantiate it.
class Explosive() {
  throw "must not run the constructor"
}

:expect class Explosive
Explosive.class
//│ = class Explosive

:e
Empty().class
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.200: 	Empty().class
//│ ║         	^^^^^^^^^^^^^
//│ ╟── Instance of class 'Empty' does not contain member 'class'
//│ ║  l.200: 	Empty().class
//│ ╙──       	^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:e
set Bare.class = 1
//│ ╔══[COMPILATION ERROR] Assignment requires a term member
//│ ║  l.210: 	set Bare.class = 1
//│ ╙──       	    ^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Specialization must survive class selection and subsequent construction.
class Generic[T](val value: T)
class Payload(val number: Int)

:expect 31
new Generic[Payload].class(Payload(31)).value.number
//│ = 31

:expect 32
new Generic.class[Payload](Payload(32)).value.number
//│ = 32

:expect true
Generic[Payload].class == Generic.class
//│ = true

// Each outer instance owns a distinct nested class object.
class Outer(val value) {
  class Inner {
    fun result() = value
  }
  val Inner = 0
}
let first = Outer(41)
let second = Outer(42)
//│ first = Outer(41)
//│ second = Outer(42)

:expect [41, 42, false]
[(new first.Inner.class).result(), (new second.Inner.class).result(),
 first.Inner.class == second.Inner.class]
//│ = [41, 42, false]

// Calling through a closure retains the selected class, even with inlining off.
fun runtimeClass() = Primary.class

:noInline
:expect true
runtimeClass() == Primary.class
//│ = true

// Forward references wait for the whole overload set to complete.
fun forwardClass() = Forward.class
class Forward
val Forward = false
//│ Forward = false

:expect class Forward
forwardClass()
//│ = class Forward

import "../../mlscript-compile/OverloadedClassLibrary.mls"

:expect class Item
OverloadedClassLibrary.Item.class
//│ = class Item

:expect 52
(new OverloadedClassLibrary.Item.class).answer()
//│ = 52

// Ordinary fields and foreign dynamic selections keep their usual behavior.
let record = {"class": 5}
//│ record = {class: 5}

:expect 5
record.class
//│ = 5

// Passing a constructor as an argument does not preserve class-selection syntax.
:e
private fun classOfValue(value) = value.class
classOfValue(Empty)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.287: 	private fun classOfValue(value) = value.class
//│ ║         	                                  ^^^^^^^^^^^
//│ ╟── Class 'Empty' does not contain member 'class'
//│ ║  l.6: 	class Empty()
//│ ╙──     	^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Foreign class declarations denote their native binding directly.
declare class String with
  constructor(value: Str)
  val length: Int
declare fun String(value: Str): Str

:expect 5
new String.class("hello").length
//│ = 5

// Class values retain constructor arity and captured receivers through bindings.
:expect 16
new raw(16).x
//│ = 16

let rawCurried = Curried.class
//│ rawCurried = class Curried

:expect 18
new rawCurried(17)(18).y
//│ = 18

let partial = new rawCurried(19)
//│ partial = fun partial

:expect 20
partial(20).y
//│ = 20

val storedClass = Primary.class
let classRecord = {make: Primary.class}
//│ classRecord = {make: class Primary}
//│ storedClass = class Primary

:expect [21, 22]
[new storedClass(21).x, new classRecord.make(22).x]
//│ = [21, 22]

let specializedClass = Generic[Payload].class
//│ specializedClass = class Generic

:expect 33
new specializedClass(Payload(33)).value.number
//│ = 33

let nestedClass = first.Inner.class
//│ nestedClass = class Inner

:expect 41
new nestedClass().result()
//│ = 41

// A partial construction captures the class object before its binding changes.
class Enclosing(val number) {
  class Nested(val argument) {
    fun result() = number + argument
  }
}
let earlier = Enclosing(100)
let later = Enclosing(200)
let currentClass = earlier.Nested.class
let construct = new currentClass
set currentClass = later.Nested.class
//│ construct = fun construct
//│ currentClass = class Nested
//│ earlier = Enclosing(100)
//│ later = Enclosing(200)

:noInline
:expect [101, 201]
[construct(1).result(), new currentClass(1).result()]
//│ = [101, 201]

// Class values can flow through function parameters and getter results.
:expect 34
private fun instantiate(cls, x) = new cls(x)
instantiate(Primary.class, 34).x
//│ = 34

fun storedGetter = Primary.class

:expect 35
new storedGetter(35).x
//│ = 35

// Inheritance uses the same class value and constructor parameter lists.
class Derived extends rawCurried(36)(37)

:expect 37
new Derived().y
//│ = 37

let bareClass = Bare
//│ bareClass = class Bare

:expect true
new bareClass is Bare
//│ = true

:e
let invalidClass = 0
new invalidClass
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
