// Class objects are independent of constructor syntax and term overloads.
class Bare
class Empty()
class Primary(val x)
class Auxiliary {
  constructor(val x)
  fun value() = x
}
class Curried(val x)(val y)
class Overloaded {
  fun answer() = 42
}
val Overloaded = 7
class Getter
fun Getter = throw "must not evaluate the term overload"
class Companion()
module Companion {
  val value = 10
}
//│ Overloaded = 7

:expect class Bare
:sr
Bare.class
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   Bare⁰.class‹Bare¹›
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = class Bare

:expect class Empty
:sr
Empty.class
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   Empty⁰.class‹Empty¹›
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = class Empty

:expect class Primary
Primary.class
//│ = class Primary

:expect class Auxiliary
Auxiliary.class
//│ = class Auxiliary

:expect class Curried
Curried.class
//│ = class Curried

:expect class Overloaded
Overloaded.class
//│ = class Overloaded

:expect class Getter
Getter.class
//│ = class Getter

:expect class Companion { value: 10 }
Companion.class
//│ = class Companion { value: 10 }

:expect 42
(new Overloaded.class).answer()
//│ = 42

:expect 12
(new Primary.class(12)).x
//│ = 12

:expect 13
(new Auxiliary.class(13)).value()
//│ = 13

:expect 15
(new Curried.class(14)(15)).y
//│ = 15

// Evaluated terms do not preserve the class-selection syntax.
let raw = Primary.class
let ctor = Primary
val saved = Primary
//│ ctor = fun Primary { class: class Primary }
//│ raw = class Primary
//│ saved = fun Primary { class: class Primary }

:expect true
raw == Primary.class
//│ = true

:e
raw.class
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.94: 	raw.class
//│ ║        	^^^^^^^^^
//│ ╟── Class value does not contain member 'class'
//│ ║  l.7: 	class Primary(val x)
//│ ╙──     	      ^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:e
ctor.class
