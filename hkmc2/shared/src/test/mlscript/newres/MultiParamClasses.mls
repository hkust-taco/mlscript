:sr
class Foo(val a)(val b) {
  val c = a + b
}
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   fun Foo⁰
//│   class Foo¹::Foo²(val a⁰)(val b⁰) {
//│     val a¹::a² ‹flow:a⁰› = a⁰^a²,
//│     val b¹::b² ‹flow:b⁰› = b⁰^b²,
//│     val c⁰::c¹ ‹flow:c⁰› = +(Foo².this.a¹^c¹, Foo².this.b¹^c¹)‹app⁰›
//│   }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sr
let f = new Foo
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   let f⁰, f⁰ = new Foo¹
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f = fun f

let mk = f(1)
//│ mk = fun

:sr
mk(2)
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   mk⁰(2)‹app¹›
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = Foo(1)

