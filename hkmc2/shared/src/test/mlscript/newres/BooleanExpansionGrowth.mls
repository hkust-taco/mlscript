// FIXME: Resolving an unused parameter annotation should not enumerate every
// combination of its union alternatives. TypeFormula.intersection distributes
// intersections over unions, so the n independent pairs below produce 2^n
// clauses. TypeFormula.normalized then compares clauses pairwise for absorption.
// All field names are distinct, so none of these clauses absorbs another.
// With 14 pairs this produces 16,384 clauses; the diff test took about 19 seconds
// during the resolver audit, even though the function never reads its parameter.
// Larger annotations become impractical without doing any useful resolution work.
//
// Keep the triggering code commented out so ordinary test runs stay fast.
// Uncomment the whole definition to reproduce the growth. A fix must avoid this
// eager expansion while retaining the stable identities used to stop recursive
// type substitutions from growing forever. It must also retain every possible
// member and argument flow; discarding alternatives to cap the size is incorrect.
// fun exponential(value: ({a0: Int} | {b0: Int}) & ({a1: Int} | {b1: Int}) & ({a2: Int} | {b2: Int}) & ({a3: Int} | {b3: Int}) & ({a4: Int} | {b4: Int}) & ({a5: Int} | {b5: Int}) & ({a6: Int} | {b6: Int}) & ({a7: Int} | {b7: Int}) & ({a8: Int} | {b8: Int}) & ({a9: Int} | {b9: Int}) & ({a10: Int} | {b10: Int}) & ({a11: Int} | {b11: Int}) & ({a12: Int} | {b12: Int}) & ({a13: Int} | {b13: Int})) = 0

// Exercise the same form at a size that is cheap enough for ordinary test runs.
fun small(value: ({a0: Int} | {b0: Int}) & ({a1: Int} | {b1: Int}) & ({a2: Int} | {b2: Int})) = 0
