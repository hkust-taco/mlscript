open annotations { inline, noInline }

// A public factory can hide its implementation class. Only the chosen interpretation is checked.
module Factory with
  private class Item with
    fun value = 7
  fun Item() = new Item

:expect 7
Factory.Item().value
//│ = 7

:noInline
:expect 7
Factory.Item().value
//│ = 7

