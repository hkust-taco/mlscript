// Both-private function companions use their real private storage for initialization and reads.
:expect [11, 11, [4, 6], 13]
module Secrets with
  private class Entry with
    fun value = 11
  private fun Entry() = new Entry
  private fun Convert(x: Int) = x + 1
  private module Convert with
    fun twice(x: Int) = x + x
  private class Pair with
    fun value = 13
  private module Pair with
    fun make() = new Pair
  fun make() = new Entry
  fun call() = Entry()
  fun convert(x: Int) = [Convert(x), Convert.twice(x)]
  fun pair() = Pair.make()
[Secrets.make().value, Secrets.call().value, Secrets.convert(3), Secrets.pair().value]
//│ = [11, 11, [4, 6], 13]

:noInline
:expect [11, 11, [4, 6], 13]
[Secrets.make().value, Secrets.call().value, Secrets.convert(3), Secrets.pair().value]
//│ = [11, 11, [4, 6], 13]

:e
Secrets.Convert.twice(3)
//│ ╔══[COMPILATION ERROR] Cannot access private module 'Convert' outside its declaring owner
//│ ║  l.249: 	Secrets.Convert.twice(3)
//│ ║         	       ^^^^^^^^
//│ ╟── private module declared here
//│ ║  l.230: 	  private module Convert with
//│ ╙──       	                 ^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:e
new Secrets.Entry
//│ ╔══[COMPILATION ERROR] Cannot access private class 'Entry' outside its declaring owner
//│ ║  l.259: 	new Secrets.Entry
//│ ║         	           ^^^^^^
//│ ╟── private class declared here
//│ ║  l.226: 	  private class Entry with
//│ ╙──       	                ^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


