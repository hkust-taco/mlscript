// Private constructors do not require either the class or its module to be private.
class Public with
  private constructor
  fun value = 17
module Public with
  fun make() = new Public

:expect 17
Public.make().value
//│ = 17

:e
new Public
//│ ╔══[COMPILATION ERROR] Cannot access the private constructor of class 'Public' outside the class
//│ ║  l.355: 	new Public
//│ ║         	^^^^^^^^^^
//│ ╟── private constructor declared here
//│ ║  l.345: 	  private constructor
//│ ╙──       	  ^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// Private class inputs are not exposed just because their companion module is public.
module Encapsulated with
  private class Cell with
    constructor(value)
    fun read() = value.field
  module Cell with
    fun read() = (new Cell({field: 19})).read()

:expect 19
Encapsulated.Cell.read()
//│ = 19


// Inlining within one compilation unit emits accessors for private function storage.
:expect [23, 6]
module InlineSecrets with
  private class Entry with
    fun value = 23
  private fun Entry() = new Entry
  private fun Convert(x: Int) = x
  private module Convert with
    @noInline fun twice(x: Int) = x + x
  @inline fun make() = new Entry
  @inline fun twice(x: Int) = Convert.twice(x)
[InlineSecrets.make().value, InlineSecrets.twice(3)]
//│ = [23, 6]


// Copied definitions must retain the refreshed function carrying their class value.
@inline fun local(value: Int) = {
  private class Entry with
    fun read() = value
  private fun Entry() = new Entry
  @noInline fun read() = (new Entry).read()
  read()
}

:expect [29, 31]
[local(29), local(31)]
//│ = [29, 31]


// Public companions may precede their private classes.
module Reverse with
  fun Entry() = new Entry
  private class Entry with
    fun value = 37
  module Box with
    fun make() = new Box
  private class Box with
    fun value = 41

:expect [37, 41]
[Reverse.Entry().value, Reverse.Box.make().value]
//│ = [37, 41]


// TODO: nested classes without function companions still use public JS fields, so the private
// class overwrites the inherited public class even though lookup selects the inherited definition.
:fixme
:expect [43, 47]
class BaseTypes with
  class Entry with
    fun value = 43
class DerivedTypes extends BaseTypes with
  private class Entry with
    fun value = 47
  fun own() = new Entry
let derived = new DerivedTypes
[(new derived.Entry).value, derived.own().value]
//│ ═══[RUNTIME ERROR] Expected: '[43, 47]', got: '[47, 47]'
//│ = [47, 47]
//│ derived = DerivedTypes { Entry: class Entry }


