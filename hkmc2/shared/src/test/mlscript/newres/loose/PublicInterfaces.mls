// Private helpers that do not escape retain local inference.
:expect 11
private fun local(x) = x.value
local({value: 11})
//│ = 11

// Explicitly described alternatives still use lenient missing-member checking.
:expect 12
module Known { val value = 12 }
module Other { val other = 0 }
fun declared(x: Known | Other) = x.value
declared(Known)
//│ = 12

// A dynamic target does not exempt the function's other possible public inputs.
:e
fun dynamic(x) = x.value
