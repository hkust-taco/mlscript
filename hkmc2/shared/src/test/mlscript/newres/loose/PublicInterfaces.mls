// Recursive spread widening must not hide public inputs behind a local target.
// FIXME: Preserve public-input provenance in the bounded tuple widening representation.
:breakme
:e
#lang(strictResolution: true)
private fun padded(x, n: Int) = if n == 0 then [x] else [x, ...padded(x, n - 1)]
fun deep(x) =
  let value = if hide(true) then padded(x, 4).4 else {value: 0}
  value.value
deep({value: 16})
//│ = 16
