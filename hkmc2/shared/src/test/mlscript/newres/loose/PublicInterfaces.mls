// Constructor refinement must preserve the input's origin on unknown fields.
:e
private class Box(val item)
fun refined(x) = if x is Box(item) then item.value else 0
refined(Box({value: 10}))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.189: 	fun refined(x) = if x is Box(item) then item.value else 0
