// An annotated callback interface must be checked in a non-strict worksheet too.
:e
#lang(strictResolution: false)
private fun erase(f: Function) = ()
private fun callback(x) = x.value
callback({value: 15})
erase(callback)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
