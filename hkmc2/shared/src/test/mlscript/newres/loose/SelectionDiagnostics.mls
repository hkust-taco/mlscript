//│ ╙──     	                                ^^^^^

// Following aliases preserves the component's written use, not its definition.
:e
type Left = First
type Right = Second
fun aliases(x: Left | Right) = x.absent
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.27: 	fun aliases(x: Left | Right) = x.absent
