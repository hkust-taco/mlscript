//│ ║       	              ^^^^^
//│ ╟── Value of type 'Second' does not contain member 'absent'
//│ ║  l.9: 	fun nested(x: First | (Second | Third)) = x.absent
//│ ║       	                       ^^^^^^
//│ ╟── Value of type 'Third' does not contain member 'absent'
