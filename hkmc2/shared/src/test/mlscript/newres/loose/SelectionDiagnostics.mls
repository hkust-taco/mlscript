// Uncertain components retain both the use and the declaration explaining them.
:e
declare type Hidden
fun unknowns(x: Any | Hidden) = x.absent
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.69: 	fun unknowns(x: Any | Hidden) = x.absent
