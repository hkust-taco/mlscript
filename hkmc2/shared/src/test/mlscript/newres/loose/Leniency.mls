// Compiled selections retain their targets when imports supply new receiver shapes.
:expect [7, 8, 0]
#lang(0.3.x)
import "../../../mlscript-compile/LenientSelections.mls"
[LenientSelections.observed,
 LenientSelections.read(LenientSelections.WithValue(8), true),
 LenientSelections.read((new LenientSelections.WithoutValue) as Any, false)]
//│ = [7, 8, 0]
