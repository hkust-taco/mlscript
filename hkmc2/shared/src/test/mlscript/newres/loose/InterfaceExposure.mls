// Type parameters remain opaque independently of visibility and exposure checks.
:e
fun generic[A](x: A) = x.a
generic({a: 1})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+1: 	fun generic[A](x: A) = x.a
//│ ║        	                       ^^^
//│ ╟── Cannot resolve member 'a' of a value with unknown shape.
//│ ║  l.+1: 	fun generic[A](x: A) = x.a
//│ ║        	                  ^
//│ ╟── Type parameter 'A' does not specify a member interface.
//│ ║  l.+1: 	fun generic[A](x: A) = x.a
//│ ╙──      	            ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

