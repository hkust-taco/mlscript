:e
class Item(val a: Int)
private fun generic[A](x: A) = x.a
generic[Item](Item(1))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	private fun generic[A](x: A) = x.a
