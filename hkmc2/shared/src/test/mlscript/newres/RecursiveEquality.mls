:.

// Keep the unannotated deep-equality implementation separate from Predef's
// public Any × Any -> Bool interface. Recursing on array elements must not
// cause unbounded inference or a stack overflow.
:expect [true, false, true, false]
fun deepEqual(a, b) = if
  a === b then true
  a is Array as a and b is Array as b and a.length === b.length then
    a.every((item, index, ...) => deepEqual(item, b.at(index)))
  else a !== undefined and a !== null and b !== undefined and b !== null and
    let ac = a!constructor
    ac !== undefined and ac === b!constructor and
      let md = ac!(Predef.Symbols.definitionMetadata)
      md !== undefined and
        md.2.every((field, ...) => field !== null and deepEqual(a!(field), b!(field)))
class Box(val value: Int)
[deepEqual([[1], [2]], [[1], [2]]), deepEqual([[1]], [[2]]), deepEqual(Box(3), Box(3)), deepEqual(Box(3), Box(4))]
//│ = [true, false, true, false]

// Refinement must also reach a fixed point through mutually recursive helpers.
// Exposure supplies unknown inputs independently of these concrete local calls.
:expect true
fun visit(value) = if value is Array as items then visitArray(items) else true
fun visitArray(items: Array) = items.every((item, ...) => visit(item))
visit([1, [2, [3]], []])
//│ = true
