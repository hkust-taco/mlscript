:expect ["ABC", 3]
fun get[A](fields: {value: A}): A = fields.value
[get(value: "abc").toUpperCase(), get[Array[Int]](value: [1, 2, 3]).length]
//│ = ["ABC", 3]

:expect "quoted"
fun quoted(fields: {"name": Str}) = fields.name
quoted(name: "quoted")
//│ = "quoted"

:expect "OK"
fun callback(fields: {f: Str -> Str}): Str = fields.f("ok")
callback(f: x => x.toUpperCase())
//│ = "OK"

// A typed return must also check callbacks stored in its record implementation.
