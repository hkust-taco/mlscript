:.

:expect ["HELLO", 3]
fun describe(fields: {name: Str, count: Int}) = [fields.name.toUpperCase(), fields.count]
describe(name: "hello", count: 3)
//│ = ["HELLO", 3]

:expect 5
fun apply(fields: {operation: Int -> Int, value: Int}) = fields.operation(fields.value)
apply(operation: x => x + 1, value: 4)
//│ = 5

