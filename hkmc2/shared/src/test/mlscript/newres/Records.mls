// An explicit field after an unknown key still wins.
:expect 13
{(key): 0, a: 13}.a
//│ = 13


// Known spreads preserve both field identity and captured values.
:expect 14
{...{answer: 14}}.answer
//│ = 14

:expect 15
{answer: 0, ...{answer: 15}}.answer
//│ = 15

:expect 16
{...{answer: 0}, answer: 16}.answer
//│ = 16

:expect 17
{answer: 17, ...{other: 0}}.answer
//│ = 17

fun spreadWrap(x) = {...{value: x}}

:expect 18
spreadWrap({first: 18}).value.first
//│ = 18

:expect 19
spreadWrap({second: 19}).value.second
//│ = 19

// Mutable fields retain their identity after writes.
:expect 20
let mutableRecord = mut {answer: 0}
set mutableRecord.answer = 20
mutableRecord.answer
//│ = 20
//│ mutableRecord = {answer: 20}

// TODO: Track writes to mutable fields. Their initializer must not determine
