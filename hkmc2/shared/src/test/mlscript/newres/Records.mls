// Both opened records define `shared`, so the reference is ambiguous. The error
// must point to each field definition and the corresponding open statement.
:e
fun ambiguousRecordOpen() =
  let firstRecord = {shared: 1}
  let secondRecord = {shared: 2}
  open firstRecord
  open secondRecord
  shared
ambiguousRecordOpen()
//│ ╔══[COMPILATION ERROR] Wildcard-open reference 'shared' is ambiguous
