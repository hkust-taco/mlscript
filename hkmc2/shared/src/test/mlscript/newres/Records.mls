:.


:sr
:expect 1
{a: 1}.a
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   { let a⁰, a⁰ = 1, "a": a⁰ }.a¹
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

:expect 2
{"a": 2}.a
//│ = 2

:expect 3
{a: 1, b: a + 2}.b
//│ = 3

:expect 4
{inner: {answer: 4}}.inner.answer
//│ = 4

// Duplicate keys use the last property, including its value shape.
:expect 5
{a: {wrong: 0}, a: {answer: 5}}.a.answer
//│ = 5

// Fields are values; stored lambdas receive ordinary arguments.
:expect 6
{f: x => x + 1}.f(5)
//│ = 6

// The record's context must filter values from other calls to the same producer.
fun wrap(x) = {value: x}

:expect 7
wrap({left: 7}).value.left
//│ = 7

:expect 8
wrap({right: 8}).value.right
//│ = 8

// Reading the same field through a helper retains the receiver context too.
:expect 9
private fun read(r) = r.value
read(wrap({answer: 9})).answer
//│ = 9

:expect 10
read(wrap({different: 10})).different
//│ = 10

// Both selective and wildcard opens can expose record properties.
:expect 11
let record = {answer: 11}
open record {answer}
answer
//│ = 11
//│ record = {answer: 11}

:expect 12
let record2 = {answer2: 12}
open record2
answer2
//│ = 12
//│ record2 = {answer2: 12}

