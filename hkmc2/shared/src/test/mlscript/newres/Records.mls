//│ ╙──       	                          ^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// A known-absent name in one open does not mask a later source that supplies it.
:expect 28
fun knownMissingOpen() =
  let unrelated = {...{other: 0}}
  let fallback = {wanted: 28}
  open unrelated
  open fallback
  wanted
knownMissingOpen()
//│ = 28

// With no supplying source, a known-absent name still produces an error.
:e
fun allMissingOpen() =
  let unrelated = {other: 0}
  open unrelated
  nonexistent
allMissingOpen()
//│ ╔══[COMPILATION ERROR] Name not found in wildcard opens: nonexistent
//│ ║  l.286: 	  nonexistent
//│ ╙──       	  ^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// Both a.value and b.value must resolve to the field supplied by {value: 29}.
// The two {...xs} expressions have equal syntax but separate AST nodes and listeners.
// Treating the second expression as already processed would skip its subscription
// to xs, leaving b.value unresolved.
:expect [29, 29]
private fun repeatedRecords(xs) =
  let a = {...xs}
  let b = {...xs}
  [a.value, b.value]
repeatedRecords({value: 29})
//│ = [29, 29]

// Both reads of pendingRecord.value are elaborated before laterRecord's body.
// Once its body is available, the resolver must supply the field to both reads.
:expect [30, 30]
let pendingRecord = {...laterRecord()}
fun readPendingRecord() = [pendingRecord.value, pendingRecord.value]
fun laterRecord() = {value: 30}
readPendingRecord()
//│ = [30, 30]
//│ pendingRecord = {value: 30}

// Updating mutableCopy.value must leave stableRecord.value equal to 31.
:expect [31, 32]
let stableRecord = {value: 31}
let mutableCopy = mut {...stableRecord}
set mutableCopy.value = 32
[stableRecord.value, mutableCopy.value]
//│ = [31, 32]
//│ mutableCopy = {value: 32}
//│ stableRecord = {value: 31}

