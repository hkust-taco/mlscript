//│ ╙──       	           ^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// Unknown mutable values in an open must not disappear in favor of another source.
:fixme
fun unknownValueOpen() =
  let unknownValue = mut {value: {answer3: 0}}
  let fallbackValue = {answer3: 1}
  let openedValue = unknownValue.value
  open openedValue
  open fallbackValue
  answer3
unknownValueOpen()
