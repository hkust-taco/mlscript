// An explicit field after an unknown key still wins.
:expect 13
{(key): 0, a: 13}.a
//│ = 13


// Known spreads preserve both field identity and captured values.
:expect 14
{...{answer: 14}}.answer
//│ = 14

:expect 15
{answer: 0, ...{answer: 15}}.answer
//│ = 15

:expect 16
{...{answer: 0}, answer: 16}.answer
//│ = 16

:expect 17
{answer: 17, ...{other: 0}}.answer
//│ = 17

fun spreadWrap(x) = {...{value: x}}

:expect 18
spreadWrap({first: 18}).value.first
//│ = 18

:expect 19
spreadWrap({second: 19}).value.second
//│ = 19

// Mutable fields retain their identity after writes.
:expect 20
let mutableRecord = mut {answer: 0}
set mutableRecord.answer = 20
mutableRecord.answer
//│ = 20
//│ mutableRecord = {answer: 20}

// TODO: Track writes to mutable fields. Their initializer must not determine
// static targets after an assignment (even if another receiver has that member).
:fixme
let changing = mut {value: {before: 0}}
set changing.value = {after: 21}
changing.value.after
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.151: 	changing.value.after
//│ ║         	^^^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'after' of a value with unknown shape.
//│ ║  l.149: 	let changing = mut {value: {before: 0}}
//│ ╙──       	                    ^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ changing = {value: {after: 21}}


// TODO: Nested helper calls currently lose the outer call-site mark when
// entering the helper through a capture, merging these two value shapes.
:fixme
fun nestedWrap(x) = {...wrap(x)}
nestedWrap({first: 22}).value.first
nestedWrap({second: 23}).value.second
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.166: 	nestedWrap({first: 22}).value.first
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Record literal does not contain member 'first'
//│ ║  l.167: 	nestedWrap({second: 23}).value.second
//│ ╙──       	            ^^^^^^^^^^
