// Recursive spreads must converge even as their candidate graph grows.
// TODO: Resolve fields through widened recursive spreads.
:fixme
fun recursiveRecord(n) =
  if n == 0 then {answer: 27}
  else {...recursiveRecord(n - 1)}
recursiveRecord(2).answer
//│ ╔══[COMPILATION ERROR] Resolution error in selection
