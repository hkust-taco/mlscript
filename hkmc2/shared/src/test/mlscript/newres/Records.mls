// Recursive spreads must converge even as their candidate graph grows.
// TODO: Resolve fields through widened recursive spreads.
:fixme
fun recursiveRecord(n) =
  if n == 0 then {answer: 27}
  else {...recursiveRecord(n - 1)}
recursiveRecord(2).answer
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.236: 	recursiveRecord(2).answer
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'answer' across a computed key or unknown record spread.
//│ ║  l.235: 	  else {...recursiveRecord(n - 1)}
//│ ╙──       	           ^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// Unknown mutable values in an open must not disappear in favor of another source.
:fixme
fun unknownValueOpen() =
  let unknownValue = mut {value: {answer3: 0}}
  let fallbackValue = {answer3: 1}
  let openedValue = unknownValue.value
  open openedValue
  open fallbackValue
  answer3
unknownValueOpen()
//│ ╔══[COMPILATION ERROR] Resolution error in wildcard-open reference
