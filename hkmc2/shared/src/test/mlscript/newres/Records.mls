// A missing member in a spread must fall through to earlier fields; an unknown
// member must not. This also holds when wildcard opens offer another candidate.
:fixme
let unknownKeys = {(key): 0}
fun unknownOpen() =
  open unknownKeys
  let knownKeys = {a: 24}
  open knownKeys
  a
unknownOpen()
//│ ╔══[COMPILATION ERROR] Resolution error in wildcard-open reference
//│ ║  l.191: 	  a
//│ ║         	  ^
//│ ╟── Cannot resolve member 'a' across a computed key or unknown record spread.
//│ ║  l.186: 	let unknownKeys = {(key): 0}
//│ ╙──       	                          ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ unknownKeys = {a: 0}

// A later explicit field makes an earlier unknown spread irrelevant to lookup.
:expect 25
{...unknownKeys, a: 25}.a
//│ = 25

// Forward producers remain pending until their body is available.
:expect 26
let forwardRecord = {...makeRecord()}
fun makeRecord() = {answer: 26}
forwardRecord.answer
//│ = 26
//│ forwardRecord = {answer: 26}

// Strict resolution still diagnoses distinct field identities from alternatives.
:e
fun choose(flag) = if flag then {answer: 1} else {answer: 2}
choose(true).answer
//│ ╔══[COMPILATION ERROR] This selection of member 'answer' is ambiguous, as it has multiple resolved targets
//│ ║  l.218: 	choose(true).answer
//│ ║         	^^^^^^^^^^^^^^^^^^^
//│ ╟── target: record field 'answer'
