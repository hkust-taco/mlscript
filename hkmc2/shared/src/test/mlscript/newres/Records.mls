// TODO: Nested helper calls currently lose the outer call-site mark when
// entering the helper through a capture, merging these two value shapes.
:fixme
fun nestedWrap(x) = {...wrap(x)}
nestedWrap({first: 22}).value.first
nestedWrap({second: 23}).value.second
