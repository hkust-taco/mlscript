:sir
:expect 10
class SuperBase { open fun foo(x) = x + 1 }
class SuperChild extends SuperBase { override fun foo(x) = super.foo(x + 1) * 2 }
(new SuperChild).foo(3)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp;
//│ define SuperBase⁰ as class SuperBase¹ {
//│   method foo¹ = fun foo²(x) {
//│     return +⁰(x, 1)
//│   }
//│ };
//│ define SuperChild⁰ as class SuperChild¹ extends SuperBase¹ {
//│   method foo³ = fun foo⁴(x) {
//│     let tmp1, tmp2;
//│     set tmp1 = +⁰(x, 1);
//│     set tmp2 = super[SuperBase¹](SuperChild¹.this).foo²(tmp1);
//│     return *⁰(tmp2, 2)
//│   }
//│ };
//│ set tmp = new SuperChild¹();
//│ return tmp.foo⁴(3)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 10

:expect 11
class SuperInherited extends SuperChild { fun bar(x) = super.foo(x) + 1 }
(new SuperInherited).bar(3)
//│ = 11

:expect 10
class SuperClosure extends SuperBase {
  override fun foo(x) = (() => super.foo(x + 1) * 2)()
}
(new SuperClosure).foo(3)
//│ = 10

:expect 13
class GetterBase(val n) { open fun value = n + 1 }
class GetterChild(n) extends GetterBase(n) {
  override fun value = super.value + super.n
}
(new GetterChild(6)).value
//│ = 13

:expect 12
class ReceiverBase {
  open fun value() = 1
  open fun run() = this.value() + 2
}
class ReceiverChild extends ReceiverBase {
  override fun value() = 10
  override fun run() = super.run()
}
(new ReceiverChild).run()
//│ = 12

:expect 7
class GenericBase[A](val value: A) { open fun get(): A = value }
class GenericChild[A](x: A) extends GenericBase[A](x) {
  override fun get(): A = super.get()
}
(new GenericChild[Int](7)).get()
//│ = 7

// Forward parent references resolve, but JS still initializes classes in source order.
:fixme
:expect 8
class ForwardChild extends ForwardBase { override fun f(x) = super.f(x) + 1 }
class ForwardBase { open fun f(x) = x + 2 }
(new ForwardChild).f(5)
