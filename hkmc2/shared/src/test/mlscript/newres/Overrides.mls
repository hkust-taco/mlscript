// Evaluating a class value must not re-evaluate the parent at every super call.
:expect 8
fun makeParent(n) = {
  class Parent { open fun f() = n }
  Parent
}
let parent = makeParent(4)
class StoredParent extends parent { override fun f() = super.f() * 2 }
(new StoredParent).f()
//│ = 8
//│ parent = class Parent

