// The nearest common ancestor is used even when a deeper ancestor is also common.
:expect [5, 6]
class MiddleBase extends Base { open override fun foo() = 4 }
class DeepLeft extends MiddleBase { override fun foo() = 5 }
class DeepRight extends MiddleBase { override fun foo() = 6 }
private fun readDeep(x) = x.foo()
[readDeep(new DeepLeft), readDeep(new DeepRight)]
//│ = [5, 6]

// Local classes and their super calls can be lifted while retaining captured arguments.
:lift
:inlineThreshold 10000
:expect [6, 14]
fun local(n) = {
  class LocalBase { open fun foo(x) = n + x }
  class LocalChild extends LocalBase { override fun foo(x) = super.foo(x) * 2 }
  (new LocalChild).foo(1)
}
[local(2), local(6)]
//│ = [6, 14]

