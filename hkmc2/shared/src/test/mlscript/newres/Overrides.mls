// A lifted subclass can call a top-level parent and retain its captured argument.
:lift
:inlineThreshold 10000
:expect [8, 10]
fun lifted(n) = {
  class Child extends SuperBase { override fun foo(x) = super.foo(x) + n }
  (new Child).foo(2)
}
[lifted(5), lifted(7)]
//│ = [8, 10]

