:.

class Base { open fun foo() = 1 }
class Left extends Base { override fun foo() = 2 }
class Right extends Base { override fun foo() = 3 }
class Inherited extends Base

:sir
:expect [2, 3, 1]
private fun read(x) = x.foo()
[read(new Left), read(new Right), read(new Inherited)]
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, tmp2, tmp3, tmp4, tmp5;
//│ @private
//│ define read⁰ as fun read¹(x) {
//│   return x.foo⁰()
//│ };
//│ set tmp = new Left⁰();
//│ set tmp1 = read¹(tmp);
//│ set tmp2 = new Right⁰();
//│ set tmp3 = read¹(tmp2);
//│ set tmp4 = new Inherited⁰();
//│ set tmp5 = read¹(tmp4);
//│ return [tmp1, tmp3, tmp5]
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [2, 3, 1]

:e
class Closed { fun foo() = 1 }
class Invalid extends Closed { override fun foo() = 2 }
//│ ╔══[COMPILATION ERROR] Cannot override non-open member 'foo'
//│ ║  l.30: 	class Invalid extends Closed { override fun foo() = 2 }
//│ ║        	                               ^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Inherited member 'foo' is defined here
//│ ║  l.29: 	class Closed { fun foo() = 1 }
//│ ╙──      	                   ^^^

:e
