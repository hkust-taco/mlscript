// Different receiver classes can inherit the same declaration without overriding it.
:expect [1, 1]
class OtherInherited extends Base
private fun readInherited(flag) = {
  let receiver = if flag then new Inherited else new OtherInherited
  receiver.foo()
}
[readInherited(true), readInherited(false)]
//│ = [1, 1]

// Reassigning a stored class cannot change a previously defined superclass.
// The resolver still assumes one contextual parent shape per class; reassignment violates
// its constructor-shape cache assertion before lowering. The runtime result remains correct.
:fixme
:expect 4
let changingParent = makeParent(4)
class SavedParent extends changingParent { override fun f() = super.f() }
set changingParent = makeParent(9)
(new SavedParent).f()
//│ ╔══[INTERNAL ERROR] Compiler reached an unexpected state at 'NewResolver.scala:2838'
//│ ╟── The compilation result may be incorrect.
//│ ╙── This is a compiler bug; please report it to the maintainers.
//│ = 4
//│ changingParent = class Parent

// For a nested class, its receiver must likewise be saved at the extends clause.
// This also encounters the constructor-shape cache limitation above.
:fixme
:expect 5
class Holder(n) { class Parent { open fun f() = n } }
let changingHolder = Holder(5)
class SavedNestedParent extends changingHolder.Parent { override fun f() = super.f() }
set changingHolder = Holder(11)
(new SavedNestedParent).f()
//│ ╔══[INTERNAL ERROR] Compiler reached an unexpected state at 'NewResolver.scala:2838'
//│ ╟── The compilation result may be incorrect.
//│ ╙── This is a compiler bug; please report it to the maintainers.
//│ = 5
//│ changingHolder = Holder(_)
