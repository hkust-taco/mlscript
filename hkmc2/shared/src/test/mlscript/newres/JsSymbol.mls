:.

open annotations { fresh, jsSymbol, noInline }

// The key's declared type is intentionally Any: the resolver does not type-check it.
module Keys {
  @fresh val first: Any = Symbol("first")
  @fresh val second = Symbol("second")
  @fresh val strKey = "hello"
}

:expect [41, 42, 42, 1337]
open class Base {
  @jsSymbol(Keys.first) open fun read() = 41
  @jsSymbol(Keys.strKey) open fun hi = 1337
}
class Child extends Base {
  @jsSymbol(Keys.first) override fun read() = super.read() + 1
}
let c = new Child, [
  new Base().read()
  c.read()
  c.(Keys.first)()
  c.(Keys.strKey)
]
//│ = [41, 42, 42, 1337]
//│ c = Child

:expect [1337, 1337]
[c.hi, c.'hello]
//│ = [1337, 1337]

:e
c.hello
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.34: 	c.hello
//│ ║        	^^^^^^^
//│ ╟── Instance of class 'Child' does not contain member 'hello'
//│ ║  l.20: 	let c = new Child, [
//│ ╙──      	        ^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Structural signatures and computed record fields use the same key identity.
:expect [43, 44]
type Reader = {@jsSymbol(Keys.second) read: () -> Int}
private fun read(value: Reader) = value.read()
[read({(Keys.second): () => 43}), read({(Keys.second): () => 44})]
//│ = [43, 44]

// An immutable value may occur in the middle of a stable path.
:expect 45
class KeyHolder {
  @fresh val key = Symbol("held")
}
val holder = new KeyHolder
class Held {
  @jsSymbol(holder.key) fun read() = 45
}
(new Held).read()
//│ = 45
//│ holder = KeyHolder { key: Symbol("held") }

// Local keys must survive substitution, and are evaluated separately on each call.
:expect [46, 47]
private fun local(value) =
  @fresh val key = Symbol("local")
  class Local {
    @jsSymbol(key) fun read() = value
  }
  (new Local).read()
[local(46), local(47)]
//│ = [46, 47]

// The same property key cannot be overridden under a different source name.
:e
class Renamed extends Base {
  @jsSymbol(Keys.first) override fun other() = 0
}
//│ ╔══[COMPILATION ERROR] Member 'other' uses the same @jsSymbol key as inherited member 'read'; overrides must keep the inherited name.
//│ ║  l.77: 	  @jsSymbol(Keys.first) override fun other() = 0
//│ ║        	                                     ^^^^^
//│ ╟── The inherited member is declared here.
//│ ║  l.14: 	  @jsSymbol(Keys.first) open fun read() = 41
//│ ╙──      	                             ^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Member 'other' is marked 'override' but overrides no inherited member
//│ ║  l.77: 	  @jsSymbol(Keys.first) override fun other() = 0
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

:e
class DifferentKey extends Base {
  @jsSymbol(Keys.second) override fun read() = 0
}
//│ ╔══[COMPILATION ERROR] Overriding member 'read' must use the same @jsSymbol annotation as its parent.
//│ ║  l.91: 	  @jsSymbol(Keys.second) override fun read() = 0
//│ ║        	                                      ^^^^
//│ ╟── The inherited member is declared here.
//│ ║  l.14: 	  @jsSymbol(Keys.first) open fun read() = 41
//│ ╙──      	                                 ^^^^

:e
class Duplicate {
  @jsSymbol(Keys.first) fun read() = 0
  @jsSymbol(Keys.first) fun other() = 1
}
//│ ╔══[COMPILATION ERROR] Duplicate definition of member 'Keys.first'.
//│ ╟── Member 'read' is defined here.
//│ ║  l.102: 	  @jsSymbol(Keys.first) fun read() = 0
//│ ║         	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Member 'other' is defined here.
//│ ║  l.103: 	  @jsSymbol(Keys.first) fun other() = 1
//│ ╙──       	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

