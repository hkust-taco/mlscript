// Iterator only promises next; iterable implementations supply their own method.
import "../../mlscript-compile/Iter.mjs"

:expect [48, 49]
let count = 48
let iterator = Iter.IteratorImpl(() =>
  if count <= 49 then
    let value = count
    set count = count + 1
    {value: value, done: false}
  else {done: true})
[...iterator]
//│ = [48, 49]
//│ count = 50
//│ iterator = IteratorImpl(fun)

:e
private fun requireIterable(iterator: Iterator[Int]) = iterator.iterator()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.159: 	private fun requireIterable(iterator: Iterator[Int]) = iterator.iterator()
//│ ║         	                                                       ^^^^^^^^^^^^^^^^^
//│ ╟── Value of type 'Iterator' does not contain member 'iterator'
//│ ║  l.159: 	private fun requireIterable(iterator: Iterator[Int]) = iterator.iterator()
//│ ╙──       	                                      ^^^^^^^^^^^^^

// The annotation is a prelude declaration, usable through ordinary opens.
:expect [50, 51]
private fun opened() =
  open annotations { jsSymbol }
  class Opened {
    @jsSymbol(Keys.first) fun read() = 50
  }
  (new Opened).read()
private fun wildcard() =
  open annotations
  class Wildcard {
    @jsSymbol(Keys.second) fun read() = 51
  }
  (new Wildcard).read()
[opened(), wildcard()]
//│ = [50, 51]

// A user function with the same spelling does not change a method's key.
:w
:expect 52
private fun shadowed() =
  fun jsSymbol(key) = key
  class Ordinary {
    @jsSymbol(Keys.first) fun read() = 52
  }
  (new Ordinary).("read")()
shadowed()
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.190: 	    @jsSymbol(Keys.first) fun read() = 52
//│ ╙──       	    ^^^^^^^^^^^^^^^^^^^^^
//│ = 52

// An escaping instance must retain the key chosen by its creating invocation.
// FIXME: Named selection needs a runtime witness for a key outside the caller's scope.
// Hoisting the key would incorrectly share it between different invocations.
:fixme
:expect [53, 54]
@annotations.noInline
private fun escaping(value) =
  @annotations.fresh val localKey = Symbol("escaping")
  class Escaped {
    @annotations.jsSymbol(localKey) fun read() = value
  }
  new Escaped
[escaping(53).read(), escaping(54).read()]
//│ ╔══[COMPILATION ERROR] No definition found in scope for member 'localKey'
//│ ╟── which references the symbol introduced here
//│ ║  l.206: 	  @annotations.fresh val localKey = Symbol("escaping")
//│ ╙──       	                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] No definition found in scope for member 'localKey'
//│ ╟── which references the symbol introduced here
//│ ║  l.206: 	  @annotations.fresh val localKey = Symbol("escaping")
//│ ╙──       	                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] ReferenceError: localKey is not defined
//│ ═══[RUNTIME ERROR] Expected: '[53, 54]', got: 'undefined'

// Imported keys must keep their defining module alive through IR transformations.
import "../../mlscript-compile/SymbolKeyLibrary.mls"

:expect [55, 56]
[(new SymbolKeyLibrary.Reader).read(), SymbolKeyLibrary.make(56).read()]
//│ = [55, 56]

// Direct immutable receiver aliases identify the same fresh field.
:expect 57
val holderAlias = holder
open class HeldBase {
  @annotations.jsSymbol(holder.key) open fun read() = 0
}
class HeldChild extends HeldBase {
  @annotations.jsSymbol(holderAlias.key) override fun read() = 57
}
(new HeldChild).read()
//│ = 57
//│ holderAlias = KeyHolder { key: Symbol("held") }

// A selected receiver alias must replace its entire path, including its prefix.
:expect 58
module Aliases {
  val nested = holder
}
class SelectedAlias extends HeldBase {
  @annotations.jsSymbol(Aliases.nested.key) override fun read() = 58
}
(new SelectedAlias).read()
//│ = 58

// Reading and assigning through a structural alias use the same symbol property.
:expect 59
type Cell = {@annotations.jsSymbol(Keys.first) value: Int}
private fun update(cell: Cell) =
  set cell.value = 59
  cell.value
update(mut {(Keys.first): 0})
//│ = 59
