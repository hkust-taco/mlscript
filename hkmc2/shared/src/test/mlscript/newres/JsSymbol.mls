// Imported keys must keep their defining module alive through IR transformations.
import "../../mlscript-compile/SymbolKeyLibrary.mls"

:expect [55, 56]
[(new SymbolKeyLibrary.Reader).read(), SymbolKeyLibrary.make(56).read()]
//│ = [55, 56]

// Direct immutable receiver aliases identify the same fresh field.
:expect 57
val holderAlias = holder
open class HeldBase {
  @jsSymbol(holder.key) open fun read() = 0
}
class HeldChild extends HeldBase {
  @jsSymbol(holderAlias.key) override fun read() = 57
}
(new HeldChild).read()
//│ = 57
//│ holderAlias = KeyHolder { key: Symbol("held") }

// A selected receiver alias must replace its entire path, including its prefix.
:expect 58
module Aliases {
  val nested = holder
}
class SelectedAlias extends HeldBase {
  @jsSymbol(Aliases.nested.key) override fun read() = 58
}
(new SelectedAlias).read()
//│ = 58

// Reading and assigning through a structural alias use the same symbol property.
:expect 59
type Cell = {@jsSymbol(Keys.first) value: Int}
private fun update(cell: Cell) =
  set cell.value = 59
  cell.value
update(mut {(Keys.first): 0})
//│ = 59

// A returned closure captures the original key, even when its name is shadowed.
:expect [60, 61]
@noInline
private fun captured(value) =
  @fresh val capturedKey = Symbol("captured")
  class Captured {
    @jsSymbol(capturedKey) fun read() = value
  }
  val instance = new Captured
  () =>
    @fresh val capturedKey = Symbol("shadow")
    instance.read()
[captured(60)(), captured(61)()]
//│ = [60, 61]

// Local modules are bindings too; a sibling scope cannot recover their keys.
@noInline
private fun moduleKey(value) =
  module LocalKeys { @fresh val key = Symbol("module key") }
  class Local {
    @jsSymbol(LocalKeys.key) fun fetch() = value
  }
  new Local

