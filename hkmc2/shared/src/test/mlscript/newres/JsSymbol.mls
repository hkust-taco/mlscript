// Inherited implementations also need the key at the super access site.
@noInline
private fun baseWithLocalKey() =
  @fresh val baseKey = Symbol("base")
  open class LocalBase {
    @jsSymbol(baseKey) open fun read() = 66
  }
  LocalBase.class
val EscapedBase = baseWithLocalKey()
//│ EscapedBase = class LocalBase

:e
class MissingSuperKey extends EscapedBase {
  fun run() = super.read()
}
(new MissingSuperKey).run()
