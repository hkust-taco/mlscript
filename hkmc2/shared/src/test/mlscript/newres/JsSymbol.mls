// The same-file accessor remains available even outside the key's owner.
:expect 73
module PrivateOwner {
  @fresh private val key = Symbol("same-file private key")
  class Reader {
    @jsSymbol(key) fun read() = 73
  }
}
new PrivateOwner.Reader().read()
//│ = 73
