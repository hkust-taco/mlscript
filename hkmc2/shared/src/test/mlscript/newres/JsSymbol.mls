:.

// The key's declared type is intentionally Any: the resolver does not type-check it.
module Keys {
  @annotations.fresh val first: Any = Symbol("first")
  @annotations.fresh val second = Symbol("second")
}

:expect [41, 42, 42]
open class Base {
  @annotations.jsSymbol(Keys.first) open fun read() = 41
}
class Child extends Base {
  @annotations.jsSymbol(Keys.first) override fun read() = super.read() + 1
}
[(new Base).read(), (new Child).read(), (new Child).(Keys.first)()]
//│ = [41, 42, 42]

// Structural signatures and computed record fields use the same key identity.
:expect [43, 44]
type Reader = {@annotations.jsSymbol(Keys.second) read: () -> Int}
private fun read(value: Reader) = value.read()
[read({(Keys.second): () => 43}), read({(Keys.second): () => 44})]
//│ = [43, 44]

// An immutable value may occur in the middle of a stable path.
:expect 45
class KeyHolder {
  @annotations.fresh val key = Symbol("held")
}
val holder = new KeyHolder
class Held {
  @annotations.jsSymbol(holder.key) fun read() = 45
}
(new Held).read()
//│ = 45
//│ holder = KeyHolder { key: Symbol("held") }

// Local keys must survive substitution, and are evaluated separately on each call.
:expect [46, 47]
private fun local(value) =
  @annotations.fresh val key = Symbol("local")
  class Local {
    @annotations.jsSymbol(key) fun read() = value
  }
  (new Local).read()
[local(46), local(47)]
//│ = [46, 47]

// The same property key cannot be overridden under a different source name.
:e
class Renamed extends Base {
  @annotations.jsSymbol(Keys.first) override fun other() = 0
}
//│ ╔══[COMPILATION ERROR] Member 'other' uses the same @jsSymbol key as inherited member 'read'; overrides must keep the inherited name.
//│ ║  l.53: 	  @annotations.jsSymbol(Keys.first) override fun other() = 0
//│ ║        	                                                 ^^^^^
//│ ╟── The inherited member is declared here.
//│ ║  l.11: 	  @annotations.jsSymbol(Keys.first) open fun read() = 41
//│ ╙──      	                                         ^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Member 'other' is marked 'override' but overrides no inherited member
//│ ║  l.53: 	  @annotations.jsSymbol(Keys.first) override fun other() = 0
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

:e
class DifferentKey extends Base {
  @annotations.jsSymbol(Keys.second) override fun read() = 0
}
//│ ╔══[COMPILATION ERROR] Overriding member 'read' must use the same @jsSymbol annotation as its parent.
//│ ║  l.67: 	  @annotations.jsSymbol(Keys.second) override fun read() = 0
//│ ║        	                                                  ^^^^
//│ ╟── The inherited member is declared here.
//│ ║  l.11: 	  @annotations.jsSymbol(Keys.first) open fun read() = 41
//│ ╙──      	                                             ^^^^

:e
class Duplicate {
  @annotations.jsSymbol(Keys.first) fun read() = 0
  @annotations.jsSymbol(Keys.first) fun other() = 1
}
//│ ╔══[COMPILATION ERROR] Duplicate definition of member 'Keys.first'.
//│ ╟── Member 'read' is defined here.
//│ ║  l.78: 	  @annotations.jsSymbol(Keys.first) fun read() = 0
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Member 'other' is defined here.
//│ ║  l.79: 	  @annotations.jsSymbol(Keys.first) fun other() = 1
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

val ordinary = Symbol("ordinary")
//│ ordinary = Symbol("ordinary")

:e
class Unmarked {
  @annotations.jsSymbol(ordinary) fun read() = 0
}
