// Lambdas expose the declared interface of the builtin Function class.
:expect "f"
let f = x => x
f.name
//│ = "f"
//│ f = fun f

// A lambda used only as the receiver of a resolved method call is still live.
:expect 3
(x => x + 1).apply(null, [2])
//│ = 3

:expect true
(x => x) is Function
//│ = true

