// Without that recursive checking edge, the declared receiver supplies its
// lexical class bindings to the by-name bound. The body supplies no candidates.
class Item(val value: Int)
class Provider[T] with
  fun make: [A restricts T] -> A
  fun make = throw 0
private fun read(provider: Provider[Item]) = provider.make.value
