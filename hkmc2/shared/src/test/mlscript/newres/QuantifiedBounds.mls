// FIXME: A generic implementation should also be checked using its upper bound.
:fixme
class Item(val value: Int)
fun read: [A extends Item] -> A -> Int
fun read(x) = x.value
//│ ╔══[COMPILATION ERROR] This selection of member 'value' has no resolved target
//│ ║  l.23: 	fun read(x) = x.value
