// Control: an explicit type argument supplies the declared member interface.
class Item(val value: Int)
declare fun make: [A extends Item] -> () -> A
private fun read() = make[Item]().value

// FIXME: Every result satisfies the upper bound, even without explicit arguments.
// The upper constraint is installed, but observing an unconstrained instance
// still has no interface. Its guarantee must be kept apart from lower candidates.
:fixme
class Item(val value: Int)
declare fun make: [A extends Item] -> () -> A
private fun read() = make().value
//│ ╔══[COMPILATION ERROR] This selection of member 'value' has no resolved target
//│ ║  l.14: 	private fun read() = make().value
