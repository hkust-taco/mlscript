// Calling a private helper does not expose arbitrary inputs to it.
:expect 1
private fun hidden(x) = x.a
fun closed() = hidden({a: 1})
closed()
//│ = 1

// An annotated returned callback is checked under its declared domain.
:expect 1
class A(val a: Int)
fun typed(): A -> Int = x => x.a
typed()(new A(1))
//│ = 1

// The diagnostic retains the parameter, field storage, and returned record.
:e
private fun hiddenRecord(x) = x.a
fun exportRecord() = {callback: hiddenRecord}
hiddenRecord({a: 1})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.183: 	private fun hiddenRecord(x) = x.a
