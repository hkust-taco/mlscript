// A stored callback with a declared input interface remains callable.
:expect 3
private fun typedInSpread(x: {a: Int}) = x.a
private val typedCallbacks = mut [typedInSpread]
val escapedTypedSpread = [...typedCallbacks]
escapedTypedSpread.0({a: 3})
//│ = 3
//│ escapedTypedSpread = [fun typedInSpread]
//│ typedCallbacks = [fun typedInSpread]
