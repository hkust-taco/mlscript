// Explicit dynamic spreads still permit dynamic element operations.
:expect 3
[...([{a: 3}] as dyn)].0.a
//│ = 3

// Recursive discovery observes later shapes without repeatedly scanning the graph.
:e
private fun recursiveHidden(x) = x.a
fun recursiveExport(n) = if n == 0 then {callback: recursiveHidden} else recursiveExport(n - 1)
recursiveHidden({a: 1})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.293: 	private fun recursiveHidden(x) = x.a
//│ ║         	                                 ^^^
//│ ╟── Cannot resolve member 'a' of a value with unknown shape.
//│ ╟── Parameter 'x' admits values of unknown shape.
//│ ║  l.293: 	private fun recursiveHidden(x) = x.a
//│ ║         	                            ^
//│ ╟── This value is stored in this record field.
//│ ║  l.294: 	fun recursiveExport(n) = if n == 0 then {callback: recursiveHidden} else recursiveExport(n - 1)
//│ ║         	                                         ^^^^^^^^
//│ ╟── This value is returned here.
//│ ║  l.294: 	fun recursiveExport(n) = if n == 0 then {callback: recursiveHidden} else recursiveExport(n - 1)
//│ ║         	                            ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── 'recursiveExport' is exposed by this compilation unit.
//│ ║  l.294: 	fun recursiveExport(n) = if n == 0 then {callback: recursiveHidden} else recursiveExport(n - 1)
//│ ╙──       	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A term overload cannot hide an exposed class interface from this check.
:e
class Shadowed {
  fun bad(x) = x.a
}
val Shadowed = 0
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.317: 	  fun bad(x) = x.a
//│ ║         	               ^^^
//│ ╟── Cannot resolve member 'a' of a value with unknown shape.
//│ ╟── Parameter 'x' admits values of unknown shape.
//│ ║  l.317: 	  fun bad(x) = x.a
//│ ║         	          ^
//│ ╟── Member 'bad' is accessible here.
//│ ║  l.317: 	  fun bad(x) = x.a
//│ ║         	  ^^^^^^^^^^^^^^^^
//│ ╟── 'Shadowed' is exposed by this compilation unit.
