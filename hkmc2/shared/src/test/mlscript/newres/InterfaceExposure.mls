// A spread retains the generic input that made its member interface unknown.
:e
fun spreadRecord[A](x: A) = ({...x}).a
spreadRecord({a: 1})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+1: 	fun spreadRecord[A](x: A) = ({...x}).a
//│ ║        	                            ^^^^^^^^^^
//│ ╟── This spread has no known element shape.
//│ ║  l.+1: 	fun spreadRecord[A](x: A) = ({...x}).a
//│ ║        	                                 ^
//│ ╟── Cannot resolve member 'a' across a computed key or unknown record spread.
//│ ║  l.+1: 	fun spreadRecord[A](x: A) = ({...x}).a
//│ ║        	                       ^
//│ ╟── Type parameter 'A' does not specify a member interface.
//│ ║  l.+1: 	fun spreadRecord[A](x: A) = ({...x}).a
//│ ╙──      	                 ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// The same provenance survives indexing into an unresolved tuple spread.
