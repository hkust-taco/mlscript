// A constructor test narrows the class, but cannot close its unannotated fields.
:e
class Holder(val value)
fun inspect(x) = if x is Holder(y) then y.a else 0
inspect(Holder({a: 1}))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	fun inspect(x) = if x is Holder(y) then y.a else 0
//│ ║        	                                        ^^^
//│ ╟── Cannot resolve member 'a' of a value with unknown shape.
//│ ╟── This constructor field may contain a value of unknown shape.
//│ ║  l.+1: 	class Holder(val value)
//│ ║        	                 ^^^^^
//│ ╟── Parameter 'x' admits values of unknown shape.
//│ ║  l.+2: 	fun inspect(x) = if x is Holder(y) then y.a else 0
//│ ║        	            ^
//│ ╟── 'inspect' is exposed by this compilation unit.
//│ ║  l.+2: 	fun inspect(x) = if x is Holder(y) then y.a else 0
//│ ╙──      	^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Declared fields remain usable after narrowing an unknown input.
:expect 2
class KnownField(val a: Int)
class TypedHolder(val value: KnownField)
fun inspectTyped(x) = if x is TypedHolder(y) then y.a else 0
inspectTyped(TypedHolder(KnownField(2)))
//│ = 2

// A class pattern also admits arbitrary instantiations of its type parameters.
:e
class GenericHolder[A](val value: A)
fun inspectGeneric(x) = if x is GenericHolder(y) then y.a else 0
inspectGeneric(GenericHolder({a: 1}))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	fun inspectGeneric(x) = if x is GenericHolder(y) then y.a else 0
//│ ║        	                                                      ^^^
//│ ╟── Cannot resolve member 'a' of a value with unknown shape.
//│ ╟── This constructor field may contain a value of unknown shape.
//│ ║  l.+1: 	class GenericHolder[A](val value: A)
//│ ║        	                           ^^^^^
//│ ╟── Parameter 'x' admits values of unknown shape.
//│ ║  l.+2: 	fun inspectGeneric(x) = if x is GenericHolder(y) then y.a else 0
//│ ║        	                   ^
//│ ╟── 'inspectGeneric' is exposed by this compilation unit.
//│ ║  l.+2: 	fun inspectGeneric(x) = if x is GenericHolder(y) then y.a else 0
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Narrowing does not mix the external activation into concrete calls.
:expect 3
val unwrap = case Holder(y) then y
unwrap(Holder({a: 3})).a
//│ = 3
//│ unwrap = fun

// Abstract annotations still admit a class test and its declared field interface.
:expect 4
fun inspectAbstract(x: Any) = if x is TypedHolder(y) then y.a else 0
inspectAbstract(TypedHolder(KnownField(4)))
//│ = 4

// A result annotation does not hide callable methods of a returned private class.
// FIXME: Follow the declared member interface to its implementation without
// exposing initializer shapes hidden by the nominal annotation.
:breakme
:e
private class EscapedClass with
  fun inspect(x) = x.a
fun annotatedInstance(): EscapedClass = new EscapedClass
new EscapedClass().inspect({a: 1})
//│ = 1

// Spreading an array hides its length, but still exposes the stored functions.
:e
private fun hiddenInSpread(x) = x.a
private val callbacks = mut [hiddenInSpread]
val escapedSpread = [...callbacks]
hiddenInSpread({a: 1})
