// Exposing a constructor must not pollute separately constructed instances.
// FIXME: Rebuilding the same class loses the original constructor activation.
:fixme
:expect 42
class CopyBox(val value) with
  fun copy() = CopyBox(value)
CopyBox({answer: 42}).copy().value.answer
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.210: 	CopyBox({answer: 42}).copy().value.answer
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'answer' of a value with unknown shape.
//│ ╟── Parameter 'value' admits values of unknown shape.
//│ ║  l.208: 	class CopyBox(val value) with
//│ ║         	                  ^^^^^
//│ ╟── 'CopyBox' is exposed by this compilation unit.
//│ ║  l.208: 	class CopyBox(val value) with
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.209: 	  fun copy() = CopyBox(value)
//│ ╙──       	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ ═══[RUNTIME ERROR] Expected: '42', got: 'undefined'

// A previously compiled private definition cannot acquire an open interface later.
private fun oldHidden(x) = x.a
oldHidden({a: 1})
//│ = 1

:e
val oldEscape = {callback: oldHidden}
