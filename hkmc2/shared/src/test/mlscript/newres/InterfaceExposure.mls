// Concrete type arguments still substitute into generic results at call sites.
:expect [3, 4]
class IdentityItem(val a: Int)
private fun identity[A](x: A): A = x
[identity(IdentityItem(3)).a, identity[IdentityItem](IdentityItem(4)).a]
//│ = [3, 4]

:expect 1
private fun foo(x) = x.a
foo({a: 1})
//│ = 1

:expect 1
class A(val a: Int)
fun foo(x: A) = x.a
foo(new A(1))
//│ = 1

// An unknown callable alternative is an error despite a known local call.
:e
fun apply(f) = f(1)
apply(x => x)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+1: 	fun apply(f) = f(1)
//│ ║        	               ^^^^
//│ ╟── Value of unknown shape cannot be called like a function.
//│ ╟── Parameter 'f' admits values of unknown shape.
//│ ║  l.+1: 	fun apply(f) = f(1)
//│ ║        	          ^
//│ ╟── 'apply' is exposed by this compilation unit.
//│ ║  l.+1: 	fun apply(f) = f(1)
//│ ╙──      	^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A declared callable interface admits calls.
:expect 1
fun apply(f: Int -> Int) = f(1)
apply(x => x)
//│ = 1

// Exposure follows returned closures and aggregate elements.
