// It also applies through captures and generic class members.
:e
private class GenericClass[A](value: A) with
  fun read() = (() => value.a)()
(new GenericClass({a: 1})).read()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.54: 	  fun read() = (() => value.a)()
