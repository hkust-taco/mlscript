//│ ╟── This type annotation supplies the value's shape.
//│ ║  l.53: 	private class GenericClass[A](value: A) with
//│ ║        	                                     ^
//│ ╟── Type parameter 'A' does not specify a member interface.
//│ ║  l.53: 	private class GenericClass[A](value: A) with
//│ ╙──      	                           ^
