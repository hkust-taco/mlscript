// Calling a private helper does not expose arbitrary inputs to it.
:expect 1
private fun hidden(x) = x.a
fun closed() = hidden({a: 1})
closed()
//│ = 1

// An annotated returned callback is checked under its declared domain.
:expect 1
class A(val a: Int)
fun typed(): A -> Int = x => x.a
typed()(new A(1))
//│ = 1

// The diagnostic retains the parameter, field storage, and returned record.
:e
private fun hiddenRecord(x) = x.a
fun exportRecord() = {callback: hiddenRecord}
hiddenRecord({a: 1})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+1: 	private fun hiddenRecord(x) = x.a
//│ ║        	                              ^^^
//│ ╟── Cannot resolve member 'a' of a value with unknown shape.
//│ ╟── Parameter 'x' admits values of unknown shape.
//│ ║  l.+1: 	private fun hiddenRecord(x) = x.a
//│ ║        	                         ^
//│ ╟── This value is stored in this record field.
//│ ║  l.+2: 	fun exportRecord() = {callback: hiddenRecord}
//│ ║        	                      ^^^^^^^^
//│ ╟── This value is returned here.
//│ ║  l.+2: 	fun exportRecord() = {callback: hiddenRecord}
//│ ║        	                      ^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── 'exportRecord' is exposed by this compilation unit.
//│ ║  l.+2: 	fun exportRecord() = {callback: hiddenRecord}
//│ ╙──      	^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Exposing a constructor must not pollute separately constructed instances.
// FIXME: Rebuilding the same class loses the original constructor activation.
:fixme
:expect 42
class CopyBox(val value) with
  fun copy() = CopyBox(value)
CopyBox({answer: 42}).copy().value.answer
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+3: 	CopyBox({answer: 42}).copy().value.answer
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'answer' of a value with unknown shape.
//│ ╟── Parameter 'value' admits values of unknown shape.
//│ ║  l.+1: 	class CopyBox(val value) with
//│ ║        	              ^^^^^^^^^
//│ ╟── 'CopyBox' is exposed by this compilation unit.
//│ ║  l.+1: 	class CopyBox(val value) with
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ ═══[RUNTIME ERROR] Expected: '42', got: 'undefined'

// A previously compiled private definition cannot acquire an open interface later.
private fun oldHidden(x) = x.a
oldHidden({a: 1})
//│ = 1

:e
val oldEscape = {callback: oldHidden}
//│ ╔══[COMPILATION ERROR] Resolution error in selection
