:.

// Observed calls cannot close an exposed unannotated parameter.
:e
fun foo(x) = x.a
foo({a: 1})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.5: 	fun foo(x) = x.a
//│ ║       	             ^^^
//│ ╟── Cannot resolve member 'a' of a value with unknown shape.
//│ ╟── Parameter 'x' admits values of unknown shape.
//│ ║  l.5: 	fun foo(x) = x.a
//│ ║       	        ^
//│ ╟── 'foo' is exposed by this compilation unit.
//│ ║  l.5: 	fun foo(x) = x.a
//│ ╙──     	^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Nor can a type parameter acquire an interface from local instantiations.
:e
fun foo[A](x: A) = x.a
foo({a: 1})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.21: 	fun foo[A](x: A) = x.a
//│ ║        	                   ^^^
//│ ╟── Cannot resolve member 'a' of a value with unknown shape.
//│ ╟── This type annotation supplies the value's shape.
//│ ║  l.21: 	fun foo[A](x: A) = x.a
//│ ║        	              ^
//│ ╟── Type parameter 'A' does not specify a member interface.
//│ ║  l.21: 	fun foo[A](x: A) = x.a
//│ ╙──      	        ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

