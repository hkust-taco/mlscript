// A callback's extra optional parameter is absent even if a direct call supplied it.
:e
private fun extra(x, s?) = s.length
extra(0, "hi")
fun invoke(f: Int -> Int) = f(0)
invoke(extra)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.5: 	private fun extra(x, s?) = s.length
//│ ║       	                           ^^^^^^^^
//│ ╟── Undefined literal does not contain member 'length'
//│ ║  l.5: 	private fun extra(x, s?) = s.length
//│ ╙──     	                     ^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Narrowing the absent parameter is valid.
:expect [2, 0]
private fun extraSafe(x, s?) = if s is ~undefined as s then s.length else 0
fun invokeSafe(f: Int -> Int) = f(0)
[extraSafe(0, "hi"), invokeSafe(extraSafe)]
//│ = [2, 0]

// A droppable rest argument can supply an extra optional parameter, but can be empty.
:expect [0, 3]
fun invokeRest(f: (Int, drop ...Array[Str]) -> Int) = [f(0), f(0, "abc")]
invokeRest((x, s?) => if s is ~undefined as s then s.length else 0)
//│ = [0, 3]

:e
fun invokeMissingRest(f: (Int, drop ...Array[Str]) -> Int) = f(0)
invokeMissingRest((x, s?) => s.length)
