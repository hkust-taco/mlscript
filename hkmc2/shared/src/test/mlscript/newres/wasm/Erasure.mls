// A nonempty join must not ignore an incompatible concrete alternative.
:ge
let value = const(1)
set value = wasm.i64.const(2)
value
//│ ╔══[COMPILATION ERROR] Types 'Int32' and 'Int64' have no common representation
//│ ║  l.+2: 	set value = wasm.i64.const(2)
//│ ╙──      	    ^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Types 'Int32' and 'Int64' have no common representation
//│ ║  l.+1: 	let value = const(1)
//│ ╙──      	    ^^^^^
//│ ╔══[COMPILATION ERROR] Cannot cast a Wasm value of type `i32` to `(ref null any)` in a different type hierarchy
//│ ║  l.+1: 	let value = const(1)
//│ ╙──      	            ^^^^^^^^
//│ ═══[COMPILATION ERROR] Cannot cast a Wasm value of type `i64` to `(ref null any)` in a different type hierarchy


// External callers already contribute Unknown; it conflicts with an unboxed input.
:ge
fun exported(value) = value
exported(const(42))
//│ ╔══[COMPILATION ERROR] Types 'Int32' and 'Unknown' have no common representation
//│ ║  l.+1: 	fun exported(value) = value
//│ ╙──      	                      ^^^^^
//│ ╔══[COMPILATION ERROR] Types 'Int32' and 'Unknown' have no common representation
//│ ║  l.+2: 	exported(const(42))
//│ ╙──      	         ^^^^^^^^^
//│ Wasm result:
//│ = 42


// Explicit Any keeps its declared representation and rejects an unboxed initializer.
:ge
val annotated: Any = const(42)
annotated
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int32' at an unrelated type 'Unknown'
