//│ ╙──       	         ^^^^^^^^^^^^^^^^^^
//│ Wasm result:
//│ = 42


// Mutable fields admit unknown writes even when the only local initializer is numeric.
:ge
private class Mutable(mut val value)
Mutable(wasm.i32.const(42)).value
//│ ═══[COMPILATION ERROR] Types 'Int32' and 'Unknown' have no common representation
//│ ═══[COMPILATION ERROR] Cannot cast a Wasm value of type `i32` to `(ref null any)` in a different type hierarchy
//│ ═══[COMPILATION ERROR] Wasm entry function has incompatible result types `Int32` and `Unknown`


// An explicit mutable-field annotation supplies the storage interface.
:noInline
:expect 42
private class Mutable(mut val value: Int32)
let cell = Mutable(wasm.i32.const(1))
set cell.value = wasm.i32.const(42)
cell.value
//│ Wasm result:
//│ = 42


// Explicit Any keeps its declared representation and rejects an unboxed initializer.
:ge
val annotated: Any = wasm.i32.const(42)
annotated
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int32' at an unrelated type 'Unknown'
