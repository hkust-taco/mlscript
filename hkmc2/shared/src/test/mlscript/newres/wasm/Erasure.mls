// A forward call and all return paths contribute to the same result slot.
:noInline
:expect 42
private fun caller() = later(true)
private fun later(flag) =
  if flag do return const(42)
  const(99)
caller()
//│ Wasm result:
//│ = 42


// Recursive and independent callers share one physical parameter representation.
:noInline
:expect 42
private fun repeat(again, value) =
  if again then repeat(false, value) else value
let first = repeat(true, const(40))
let second = repeat(false, const(2))
wasm.i32.add(first, second)
//│ Wasm result:
//│ = 42


// Assignments inside nested functions contribute to the storage slot.
:noInline
:expect 42
let value = const(1)
private fun update() = set value = const(42)
update()
value
//│ Wasm result:
//│ = 42


