// Undefined contributes no representation constraint to the result slot.
// Its value is unspecified, so only the concrete branch's result is asserted.
:noInline
:expect 42
private fun choose(flag, value) =
  if flag do return value
  unsafe.undefined
let unused = choose(false, const(1))
choose(true, const(42))
//│ Wasm result:
//│ = 42


// An explicit undefined value inhabits all four unboxed types and nominal references.
// Exercise parameter, result, field, and local slots without observing the unspecified values.
:noInline
:expect 42
private class Missing(val a: Int32, val b: Int64, val c: Float32, val d: Float64)
private fun empty(): Missing = unsafe.undefined
private fun pass(a: Int32, b: Int64, c: Float32, d: Float64): Int32 =
  val missing = Missing(a, b, c, d)
  let local = missing.a
  set local = unsafe.undefined
  local
let missing = empty()
let unspecified = pass(unsafe.undefined, unsafe.undefined, unsafe.undefined, unsafe.undefined)
42
//│ Wasm result:
//│ = 42


// Dead-parameter elimination may replace a typed return with undefined.
:noInline
:flowBasedOpt mono
:soir
:expect 42
private fun discard() =
  fun i32(value: Int32) = value
  fun i64(value: Int64) = value
  fun f32(value: Float32) = value
  fun f64(value: Float64) = value
  val a = i32(const(1))
  val b = i64(wasm.i64.const(2))
  val c = f32(wasm.f32.const(3.0))
  val d = f64(wasm.f64.const(4.0))
  42
discard()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private
//│ define discard⁰ as fun discard¹() {
//│   let f64, f32, i64, i32;
//│   define i32 as fun i32⁰() {
//│     return undefined
//│   };
//│   define i64 as fun i64⁰() {
//│     return undefined
//│   };
//│   define f32 as fun f32⁰() {
//│     return undefined
//│   };
//│   define f64 as fun f64⁰() {
//│     return undefined
//│   };
//│   do wasm⁰.i32¹.const⁰(1);
//│   do i32⁰();
//│   do wasm⁰.i64¹.const¹(2);
//│   do i64⁰();
//│   do wasm⁰.f32¹.const²(3.0);
//│   do f32⁰();
//│   do wasm⁰.f64¹.const³(4.0);
//│   do f64⁰();
//│   return 42
//│ };
//│ return discard¹()
//│ Wasm result:
//│ = 42


// Returning undefined in an unboxed representation must still execute the call's effects.
:noInline
:expect 42
let calls = const(0)
private fun absent(): Int64 =
  set calls = wasm.i32.add(calls, const(1))
  unsafe.undefined
private fun consume(value: Int64): Int32 = calls
let count = consume(absent())
wasm.i32.add(count, const(41))
//│ Wasm result:
//│ = 42


// A branch's undefined value leaves the conditional temporary's representation unconstrained.
:noInline
:expect 42
private fun choose(flag) =
  let value = if flag then const(42) else unsafe.undefined
  value
let unused = choose(false)
choose(true)
//│ Wasm result:
//│ = 42


// Exhaustive loop branches repeat or explicitly return; they never return Unit.
:noInline
:expect 42
private fun loop(flag) =
  while flag
    then set flag = false
    else return const(42)
loop(true)
//│ Wasm result:
//│ = 42


// A returning conditional can make the remainder unreachable, even when it has another representation.
:noInline
:expect 42
private fun early() =
  if true then return const(42)
  "unreachable"
early()
//│ Wasm result:
//│ = 42


// A private member does not change the representation of the public member it shadows.
:noInline
:expect 42
class PublicBase with
  fun value = const(42)
class PrivateDerived extends PublicBase with
  private fun value = true
  fun ownValue = value
let derived = new PrivateDerived
if derived.ownValue then derived.value else const(0)
//│ Wasm result:
//│ = 42


#lang(0.3.x)
//│ Wasm result:
//│ = {}


// Trailing arguments retain the inferred unboxed calling convention of the full argument list.
:noInline
:expect 42
private fun add(left, right) = wasm.i32.add(left, right)
add(const(41)) \ const(1)
//│ Wasm result:
//│ = 42


// A backtracking assignment saves the variable in a temporary, which takes the variable's representation:
// saving and restoring an unboxed `i32` needs no conversion. The Wasm backend does not support `finally` yet.
:ge
let saved = const(1)
set saved = const(2) in saved
