// Publish forward parent headers before joining different nominal instances.
:noInline
:expect 42
private fun choose(flag) = if flag then Left() else Right()
private class Left() extends Parent()
private class Right() extends Parent()
private class Parent() with
  val value = const(42)
choose(true).value
//│ Wasm result:
//│ = 42


