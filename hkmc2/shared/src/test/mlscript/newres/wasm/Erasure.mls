// A forward call and all return paths contribute to the same result slot.
:noInline
:expect 42
private fun caller() = later(true)
private fun later(flag) =
  if flag do return wasm.i32.const(42)
  wasm.i32.const(99)
caller()
//│ Wasm result:
//│ = 42


// Recursive and independent callers share one physical parameter representation.
:noInline
:expect 42
private fun repeat(again, value) =
  if again then repeat(false, value) else value
let first = repeat(true, wasm.i32.const(40))
let second = repeat(false, wasm.i32.const(2))
wasm.i32.add(first, second)
//│ Wasm result:
//│ = 42


// Assignments inside nested functions contribute to the storage slot.
:noInline
:expect 42
let value = wasm.i32.const(1)
private fun update() = set value = wasm.i32.const(42)
update()
value
//│ Wasm result:
//│ = 42


// Auxiliary constructor parameters have the same representation as their generated fields.
:noInline
:expect 42
private class Box with
  constructor(val value)
new Box(wasm.i32.const(42)).value
//│ Wasm result:
//│ = 42


// Publish forward parent headers before joining different nominal instances.
:noInline
:expect 42
private fun choose(flag) = if flag then Left() else Right()
private class Left() extends Parent()
private class Right() extends Parent()
private class Parent() with
  val value = wasm.i32.const(42)
choose(true).value
//│ Wasm result:
//│ = 42


// A separate full signature supplies an unboxed parameter without a parameter annotation.
