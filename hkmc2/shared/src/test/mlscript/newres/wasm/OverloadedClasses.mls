:.


// A class constructor and an explicitly overloaded function have distinct identities.
:noInline
:expect 42
class Factory {
  val answer: Int = 21
}
fun Factory(x: Int): Int = x + 1
fun originalFactory() = new Factory
type OriginalFactory = Factory
Factory(20) + (new Factory).answer
//│ Wasm result:
//│ = 42


// Imported constructors and term functions remain distinct in later blocks.
:noInline
:expect 43
Factory(21) + (new Factory).answer
//│ Wasm result:
//│ = 43


// Declaration order and nominal class tests select the same constructor.
:noInline
:expect 42
fun Reverse(): Int = 40
class Reverse { val answer: Int = 2 }
Reverse() + (new Reverse).answer
//│ Wasm result:
//│ = 42


:noInline
:expect 1
if new Reverse is Reverse then 1 else 0
//│ Wasm result:
//│ = 1


// Duplicated local classes and their function companions keep distinct identities.
:lift
:inlineThreshold 10000
:expect 45
fun make(n: Int): Int = {
  class Local { val answer: Int = 20 }
  fun Local(x: Int): Int = x + 1
  Local(n) + (new Local).answer
}
make(1) + make(2)
//│ Wasm result:
//│ = 45


// A class-only import must not require its old companion function's signature.
:noInline
:expect 99
fun Factory(): Int = 99
Factory()
//│ Wasm result:
//│ = 99

:inlineThreshold 10000
:expect 21
originalFactory().answer
//│ Wasm result:
//│ = 21


// A cast depends on the original class too, without referring to its constructor.
:noInline
:expect 21
fun checkOriginal(x): OriginalFactory = x
checkOriginal(originalFactory()).answer
//│ Wasm result:
//│ = 21
