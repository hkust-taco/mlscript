:.

:expect 10
class Base() { open fun f(x: Int): Int = x + 1 }
class Child() extends Base() { override fun f(x) = super.f(x + 1) * 2 }
Child().f(3)
//│ Wasm result:
//│ = 10

// Unannotated base members publish no representations, so their overrides inherit none.
:expect 10
class UnannotatedBase() { open fun f(x) = x + 1 }
class UnannotatedChild() extends UnannotatedBase() { override fun f(x) = super.f(x + 1) * 2 }
UnannotatedChild().f(3)
//│ Wasm result:
//│ = 10

:expect 21
class Root() { open fun f() = 1 }
class Middle() extends Root()
class Leaf() extends Middle() { override fun f() = 21 }
fun read(x: Root) = x.f()
read(Leaf())
//│ Wasm result:
//│ = 21

:expect 7
abstract class Abstract() { fun f(): Int }
class Concrete() extends Abstract() { fun f() = 7 }
fun readAbstract(x: Abstract) = x.f()
readAbstract(Concrete())
//│ Wasm result:
//│ = 7

:expect 10
class GetterBase() { open fun value: Int = 5 }
class GetterChild() extends GetterBase() { override fun value = super.value * 2 }
GetterChild().value
//│ Wasm result:
//│ = 10

:expect 10
class UnannotatedGetterBase() { open fun value = 5 }
class UnannotatedGetterChild() extends UnannotatedGetterBase() { override fun value = super.value * 2 }
UnannotatedGetterChild().value
//│ Wasm result:
//│ = 10

:expect 9
class FieldBase() { open val x: Int = 1 }
class FieldChild() extends FieldBase() { override val x: Int = 9 }
fun field(x: FieldBase) = x.x
field(FieldChild())
//│ Wasm result:
//│ = 9

:expect 7
abstract class AbstractField() { val x: Int }
class ConcreteField() extends AbstractField() { val x: Int = 7 }
fun abstractField(x: AbstractField) = x.x
abstractField(ConcreteField())
//│ Wasm result:
//│ = 7

:lift
:inlineThreshold 10000
:expect 10
fun local() = {
  class Base() { open fun f(x: Int): Int = x + 1 }
  class Child() extends Base() { override fun f(x) = super.f(x) * 2 }
  Child().f(4)
}
local()
//│ Wasm result:
//│ = 10

:expect 12
abstract class WideField() { val value: Any }
class NarrowField() extends WideField() { val value: Int = 12 }
fun readNarrow(x: NarrowField): Int = x.value
readNarrow(NarrowField())
//│ Wasm result:
//│ = 12

