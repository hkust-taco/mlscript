:expect [true, 2, false, 1]
let values = new mut Set
values.add("a")
values.add("b")
let present = values.has("a")
let size = values.size
values.delete("a")
[present, size, values.has("a"), values.size]
//│ = [true, 2, false, 1]
//│ present = true
//│ size = 2
//│ values = Set(1) {"b"}

:expect [true, "ab", null, false]
let re = new RegExp("a+")
let groups = new RegExp("ab").exec("abc")
[re.test("aa"), (if groups is Array as array then array.at(0) else "missing"),
 re.exec("c"), (new Map).has("missing")]
//│ = [true, "ab", null, false]
//│ groups = ["ab"]
//│ re = /a+/

:expect [true, true, true, "oops"]
let error = Error("oops")
[error is Error, TypeError("bad") is TypeError,
 RangeError("bounds") is RangeError, error.message]
//│ = [true, true, true, "oops"]
//│ error = Error: oops

:expect [true, 3, "42", true]
let xs = Array(3)
[xs is Array, xs.length, String(42), (new Error("new")) is Error]
//│ = [true, 3, "42", true]
//│ xs = [<3 empty items>]
