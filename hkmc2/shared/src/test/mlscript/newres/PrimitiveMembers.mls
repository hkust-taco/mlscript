:.

:expect [3, "abab", "A", 98, "1.00", "23"]
["abc".length, "ab".repeat(2), "abc".charAt(0).toUpperCase(),
 "abc".charCodeAt(1), (1).toFixed(2), (23).toString()]
//│ = [3, "abab", "A", 98, "1.00", "23"]

:expect ["AB", "1.5", "a-b"]
fun upper(s: Str) = s.toUpperCase()
fun decimal(n: Num) = n.toFixed(1)
[upper("ab"), decimal(1.5), "a b".split(" ").join("-")]
//│ = ["AB", "1.5", "a-b"]

