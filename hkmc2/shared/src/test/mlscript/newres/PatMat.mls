//│   fun Foo⁰
//│   class Foo¹::Foo²(val a⁰) {
//│     val a¹::a² ‹flow:a⁰› = a⁰^a²
//│   },
//│   object Bar⁰::Bar¹ {
//│     val b⁰::b¹ ‹flow:b⁰› = 123
//│   },
//│   fun Baz⁰
//│   class Baz¹::Baz²(c⁰) {
//│     @private val c¹::c² ‹flow:c⁰› = c⁰^c²,
//│     fun b²::b³ ‹flow:b¹› = Baz².this.c¹^b³
//│   }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


