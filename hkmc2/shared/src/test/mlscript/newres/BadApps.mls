// A fully applied constructor really has received all its argument lists.
:e
class Curried(x)(y)
fun overapply(instance) = instance()
overapply(Curried(1)(2))
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+2: 	fun overapply(instance) = instance()
//│ ║        	                          ^^^^^^^^^^
//│ ╟── Instance of class 'Curried' cannot receive more argument lists.
//│ ║  l.+3: 	overapply(Curried(1)(2))
//│ ║        	          ^^^^^^^^^^^^^
//│ ╟── Value of unknown shape cannot be called like a function.
//│ ╟── Parameter 'instance' admits values of unknown shape.
//│ ║  l.+2: 	fun overapply(instance) = instance()
//│ ║        	              ^^^^^^^^
//│ ╟── 'overapply' is exposed by this compilation unit.
//│ ║  l.+2: 	fun overapply(instance) = instance()
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Explicitly constructed instances must not be told to add another new.
:e
class Plain
fun overapply(instance) = instance()
overapply(new Plain)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+2: 	fun overapply(instance) = instance()
//│ ║        	                          ^^^^^^^^^^
