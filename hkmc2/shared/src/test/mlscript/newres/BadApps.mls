// Returning a non-callable value adds capture marks, not an argument list.
:e
fun result() = 1
result()()
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+2: 	result()()
//│ ║        	^^^^^^^^^^
//│ ╟── Integer literal cannot be called like a function.
//│ ║  l.+1: 	fun result() = 1
//│ ╙──      	               ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A captured module is still a non-callable value.
:e
module M
fun call(x) = x()
call(M)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+2: 	fun call(x) = x()
//│ ║        	              ^^^
//│ ╟── Module 'M' cannot be called like a function.
//│ ║  l.+1: 	module M
//│ ║        	^^^^^^^^
//│ ╟── Value of unknown shape cannot be called like a function.
//│ ╟── Parameter 'x' admits values of unknown shape.
//│ ║  l.+2: 	fun call(x) = x()
//│ ║        	         ^
//│ ╟── 'call' is exposed by this compilation unit.
//│ ║  l.+2: 	fun call(x) = x()
//│ ╙──      	^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Plain class values require new, including when passed through a parameter.
:e
class Plain
fun instantiate(cls) = cls()
instantiate(Plain)
//│ ╔══[COMPILATION ERROR] Resolution error in application
