:.

// Names in function types label parameters; their annotations supply the types.
:expect 3
fun named(f: (s: Str) -> Int) = f("abc")
named(s => s.length)
//│ = 3

// Optional named parameters retain both the annotation and the null case.
:expect [0, 3]
fun namedOptional(f: (s?: Str) -> Int) = [f(), f("abc")]
namedOptional((s?) => if s is ~null as s then s.length else 0)
//│ = [0, 3]

:e
fun missingNamed(f: (s?: Str) -> Int) = f()
missingNamed((s?) => s.length)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.17: 	missingNamed((s?) => s.length)
//│ ║        	                     ^^^^^^^^
//│ ╟── Null literal does not contain member 'length'
//│ ║  l.17: 	missingNamed((s?) => s.length)
//│ ║        	              ^^
//│ ╟── Null literal does not contain member 'length'
//│ ║  l.16: 	fun missingNamed(f: (s?: Str) -> Int) = f()
//│ ╙──      	                     ^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Normalization also applies through aliases, generics, and droppable parameters.
:expect 3
type Named[A] = (x: A, drop index: Int) -> Int
fun namedGeneric[A](x: A, f: Named[A]) = f(x, 0)
namedGeneric("abc", x => x.length)
//│ = 3

:expect [0, 3]
fun namedSignature: (text?: Str) -> Int
fun namedSignature(text?) = if text is ~null as text then text.length else 0
[namedSignature(), namedSignature("abc")]
//│ = [0, 3]
