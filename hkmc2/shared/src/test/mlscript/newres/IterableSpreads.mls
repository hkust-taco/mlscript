// Reject two aliases for the same property instead of inferring the wrong body.
:e
class Duplicate {
  @annotations.jsSymbol(Symbol.iterator) fun first() = [Box(1)].iterator()
  @annotations.jsSymbol(Symbol.iterator) fun second() = [Box(2)].iterator()
}
//│ ╔══[COMPILATION ERROR] Duplicate definition of member 'Symbol.iterator'.
//│ ╟── Member 'first' is defined here.
