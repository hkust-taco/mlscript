// A known target can still be resolved alongside an opaque protocol alternative.
:expect 14
private fun partlyKnown(xs: Iterable[Box] | Empty) = [...xs].0.value
partlyKnown([Box(14)])
//│ = 14

#lang(eagerResolution: true)

// Generic iterable callers keep their own element types through annotations.
:expect [15, 16]
class First(val first: Int)
class Second(val second: Int)
private fun copy[A](xs: Iterable[A]): Array[A] = [...xs]
[copy([First(15)]).0.first, copy(new Set[Second]([Second(16)])).0.second]
//│ = [15, 16]

