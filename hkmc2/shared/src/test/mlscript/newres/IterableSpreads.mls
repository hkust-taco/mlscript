// An override must keep the runtime key declared by its parent.
:e
class MissingSymbol extends Parent {
  override fun iterator() = [Box(3)].iterator()
}
//│ ╔══[COMPILATION ERROR] Overriding member 'iterator' must use the same @jsSymbol annotation as its parent.
