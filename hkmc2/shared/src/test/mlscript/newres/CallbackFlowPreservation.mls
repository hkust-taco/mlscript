// A callback collecting a typed variadic interface must retain its element types.
private fun variadic(f: (...Array[Str]) -> Int) = 0
variadic((...xs) => xs.map(x => x.length).length)
//│ = 0

// A trailing parameter may receive a leading argument, a rest element, or a suffix.
private fun trailing(f: (Str, ...Array[Str]) -> Int) = 0
trailing((...xs, last) => last.length)
//│ = 0

private fun collect(f: (Str, ...Array[Str], Str) -> Int) = 0
collect((...xs) => xs.map(x => x.length).length)
//│ = 0

class Left(val value: Int)
class Right(val value: Int)

// Uncertain positions must keep both candidates, so strict resolution sees ambiguity.
:e
private fun mixed(f: (Left, ...Array[Right]) -> Int) = 0
mixed((...xs, last) => last.value)
//│ ╔══[COMPILATION ERROR] This selection of member 'value' is ambiguous, as it has multiple resolved targets
//│ ║  l.23: 	mixed((...xs, last) => last.value)
//│ ║        	                       ^^^^^^^^^^
//│ ╟── target: value 'value' in overloaded function and class 'Right'
//│ ║  l.18: 	class Right(val value: Int)
//│ ║        	                ^^^^^
//│ ╟── target: value 'value' in overloaded function and class 'Left'
//│ ║  l.17: 	class Left(val value: Int)
//│ ╙──      	               ^^^^^
//│ = 0

// Consuming an unknown prefix must retain the rest's possible element flows.
private fun dropOne(first, ...rest) = rest
private fun copy(xs: Array[Str]) = dropOne(...xs, "tail").map(x => x.length)

// The same flow must reach a typed callback's generic element parameter.
:e
#lang(eagerResolution: false)
private fun typed[A](f: (...Array[A]) -> Int, a: A) =
  mixed(f)
  a.value
//│ ╔══[COMPILATION ERROR] This selection of member 'value' is ambiguous, as it has multiple resolved targets
//│ ║  l.44: 	  a.value
//│ ║        	  ^^^^^^^
//│ ╟── target: value 'value' in overloaded function and class 'Left'
//│ ║  l.17: 	class Left(val value: Int)
//│ ║        	               ^^^^^
//│ ╟── target: value 'value' in overloaded function and class 'Right'
//│ ║  l.18: 	class Right(val value: Int)
//│ ╙──      	                ^^^^^

// The interface always supplies two arguments, even though its prefix has one.
#lang(eagerResolution: true)
private fun requiredPair(f: (Str, drop ...Array[Str], drop Str) -> Int) = 0
requiredPair((first?, second?) => second.length)
//│ = 0

// A tuple annotation on the interface's rest must not give a sliced rest its
// original length. Forward the remaining argument without a false arity error.
private fun tupleRest(f: (...[Str, Str]) -> Int) = 0
private fun length(s: Str) = s.length
tupleRest((first?, ...rest) => length(...rest))
//│ = 0

private fun emptyTupleRest(f: (...[]) -> Int) = 0
emptyTupleRest((first?, ...rest) => rest.length)
//│ = 0
