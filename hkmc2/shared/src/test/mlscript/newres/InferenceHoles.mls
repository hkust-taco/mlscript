// An external callback may supply an unknown value for its result's hole.
:ge
class Item(val value: Int)
class Box[T](val item: T)
fun read(callback: () -> Box) = callback().item.value
read(() => Box(Item(14)))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.149: 	fun read(callback: () -> Box) = callback().item.value
//│ ║         	                                ^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'value' of a value with unknown shape.
//│ ╟── Parameter 'callback' admits values of unknown shape.
//│ ║  l.149: 	fun read(callback: () -> Box) = callback().item.value
//│ ║         	         ^^^^^^^^^^^^^^^^^^^
//│ ╟── 'read' is exposed by this compilation unit.
