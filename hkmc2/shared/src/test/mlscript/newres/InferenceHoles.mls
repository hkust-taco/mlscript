// A result hole retains the call's explicit-binder view while observing its body.
:expect [15, 16]
class First(val first: Int)
class Second(val second: Int)
class Box[T](val item: T)
private fun wrap[A](value: A): Box = Box(value)
[wrap(First(15)).item.first, wrap(Second(16)).item.second]
//│ = [15, 16]
