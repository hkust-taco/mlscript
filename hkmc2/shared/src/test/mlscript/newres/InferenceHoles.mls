:.

// Each missing formal position and each annotation occurrence has its own hole.
:expect [1, 2, 3, 4]
class First(val first: Int)
class Second(val second: Int)
class Pair[A, B](val value: [A, B])
private fun both(left: Pair, right: Pair) =
  [left.value.0.first, left.value.1.second, right.value.0.second, right.value.1.first]
both(Pair([First(1), Second(2)]), Pair([Second(3), First(4)]))
//│ = [1, 2, 3, 4]

// TODO: preserve distinct callers through a recursive hole reference.
// This hole must use ordinary inference, not fresh call-site parameter symbols.
:expect [5, 6]
class First(val first: Int)
class Second(val second: Int)
private fun append(xs: Array, value, n: Int) =
  if n > 0 then append(xs, value, n - 1) else xs.push(value)
let xs = mut []
let ys = mut []
append(xs, First(5), 2)
append(ys, Second(6), 2)
[xs.0.first, ys.0.second]
//│ = [5, 6]
//│ xs = [First(5)]
//│ ys = [Second(6)]

// A fixed fragment still restricts the interface next to an inferred argument.
:ge
class Base
class Child(val extra: Int) extends Base
class Pair[A, B](val value: [A, B])
private fun first(pair: Pair[Base]) = pair.value.0.extra
first(Pair([Child(7), 0]))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.34: 	private fun first(pair: Pair[Base]) = pair.value.0.extra
//│ ║        	                                      ^^^^^^^^^^^^^^^^^^
//│ ╙── Value of type 'Base' does not contain member 'extra'
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// External inputs remain unknown even when local callers supply useful shapes.
:ge
class Item(val value: Int)
class Box[T](val item: T)
fun read(box: Box) = box.item.value
read(Box(Item(8)))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.46: 	fun read(box: Box) = box.item.value
//│ ║        	                     ^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'value' of a value with unknown shape.
//│ ╟── Parameter 'box' admits values of unknown shape.
//│ ║  l.46: 	fun read(box: Box) = box.item.value
//│ ║        	         ^^^^^^^^
//│ ╟── 'read' is exposed by this compilation unit.
//│ ║  l.46: 	fun read(box: Box) = box.item.value
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Incomplete result annotations infer their holes from the implementation.
:expect 9
class Item(val value: Int)
class Box[T](val item: T)
private fun make(): Box = Box(Item(9))
make().item.value
//│ = 9

// An ascription preserves its written structure and infers its missing argument.
:expect 10
class Item(val value: Int)
class Box[T](val item: T)
let box = Box(Item(10)) as Box
box.item.value
//│ = 10
//│ box = Box(Item(10))

// TODO: omissions in an alias body need the alias use's contextual graph view.
:fixme
:expect [11, 12]
class First(val first: Int)
class Second(val second: Int)
class Box[T](val item: T)
type SomeBox = Box
private fun both(left: SomeBox, right: SomeBox) = [left.item.first, right.item.second]
both(Box(First(11)), Box(Second(12)))
