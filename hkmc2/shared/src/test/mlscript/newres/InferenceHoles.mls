// Only missing arguments are inferred; excess arguments remain invalid.
:ge
class Box[T](val item: T)
private fun excess(value: Box[Int, Str]) = ()
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.104: 	private fun excess(value: Box[Int, Str]) = ()
//│ ║         	                          ^^^^^^^^^^^^^
//│ ╟── Type 'Box' accepts at most 1 type argument, but got 2.
//│ ║  l.104: 	private fun excess(value: Box[Int, Str]) = ()
//│ ║         	                          ^^^^^^^^^^^^^
//│ ╟── The type parameters are declared here.
//│ ║  l.103: 	class Box[T](val item: T)
//│ ╙──       	                       ^

// A type alias checks its own argument list before interpreting the body.
:ge
class Box[T](val item: T)
type Alias[A] = Box[A]
private fun excess(value: Alias[Int, Str]) = ()
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.119: 	private fun excess(value: Alias[Int, Str]) = ()
//│ ║         	                          ^^^^^^^^^^^^^^^
//│ ╟── Type 'Alias' accepts at most 1 type argument, but got 2.
//│ ║  l.119: 	private fun excess(value: Alias[Int, Str]) = ()
//│ ║         	                          ^^^^^^^^^^^^^^^
//│ ╟── The type parameters are declared here.
//│ ║  l.118: 	type Alias[A] = Box[A]
//│ ╙──       	                ^^^^^^

