// A wildcard open reads a single runtime field even when two records declare it.
:expect 7
fun opened(value: {shared: Int} & {shared: Int, extra: Bool}) =
  open value
  shared
opened(shared: 7, extra: true)
//│ = 7

// Intersection constraints infer generic fields and check callback parameters.
:expect "TYPED"
fun extract[T](value: {item: T} & {tag: Int}): T = value.item
extract(item: "typed", tag: 0).toUpperCase()
//│ = "TYPED"

:expect "CALLBACK"
fun callback(value: {run: Str -> Str} & {tag: Int}) = value.run("callback")
callback(run: x => x.toUpperCase(), tag: 0)
//│ = "CALLBACK"

:e
fun invalidCallback(): {run: Object -> Int} & {tag: Int} =
  {run: x => x.secret, tag: 0}
invalidCallback()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
