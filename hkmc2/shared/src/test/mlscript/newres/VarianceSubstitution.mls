// Declaration-site contravariance reverses polarity and selects Base -> Int.
:ge
class Base
class Child(val value: Int) extends Base
class Sink[in T] with
  fun put(value: T): () = ()
class Producer[T] with
  fun use(f: Sink[T] -> Int): Int = f(new Sink[T])
let producer = (new Producer as Producer[in (Base -> Int) out (Child -> Int)])
producer.use(sink =>
  sink.put(x => x.value)
  7
)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.131: 	  sink.put(x => x.value)
//│ ║         	                ^^^^^^^
//│ ╟── Value of type 'Base' does not contain member 'value'
//│ ║  l.129: 	let producer = (new Producer as Producer[in (Base -> Int) out (Child -> Int)])
//│ ╙──       	                                             ^^^^
//│ = 7
//│ producer = Producer

// A written wildcard input reverses the member input polarity: T selects Base.
// Its input constraint contributes Base to the argument, invalidating .value.
:ge
class Base
class Child(val value: Int) extends Base
class Box[T](val item: T)
class Receiver[T] with
  fun accept(box: Box[in T]): () = ()
let receiver = (new Receiver as Receiver[in Child out Base])
let box = Box(Child(8))
receiver.accept(box)
box.item.value
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.154: 	box.item.value
//│ ║         	^^^^^^^^^^^^^^
//│ ╟── Value of type 'Base' does not contain member 'value'
//│ ║  l.151: 	let receiver = (new Receiver as Receiver[in Child out Base])
//│ ╙──       	                                                      ^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ box = Box(Child(8))
//│ receiver = Receiver
