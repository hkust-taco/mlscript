// The callback receives Sink[in (Base -> Int) out (Child -> Int)]. Its put
// input uses the lower bound, so the supplied function must handle every Base.
:ge
class Base
class Child(val value: Int) extends Base
class Sink[T] with
  fun put(value: T): () = ()
class Producer[T] with
  fun use(f: Sink[T] -> Int): Int = f(new Sink[T])
let producer = (new Producer as Producer[in (Base -> Int) out (Child -> Int)])
producer.use(sink =>
  sink.put(x => x.value)
  1
)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.14: 	  sink.put(x => x.value)
//│ ║        	                ^^^^^^^
//│ ╟── Value of type 'Base' does not contain member 'value'
//│ ║  l.12: 	let producer = (new Producer as Producer[in (Base -> Int) out (Child -> Int)])
//│ ╙──      	                                             ^^^^
//│ = 1
//│ producer = Producer

// The projected input is Box[in Base out Child]. The input part contributes
// Base to the inferred box argument, so its item cannot retain a Child-only view.
:ge
class Base
class Child(val value: Int) extends Base
class Box[T](val item: T)
class Receiver[T] with
  fun accept(box: Box[T]): () = ()
let receiver = (new Receiver as Receiver[in Child out Base])
let box = Box(Child(2))
receiver.accept(box)
box.item.value
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.37: 	box.item.value
//│ ║        	^^^^^^^^^^^^^^
//│ ╟── Value of type 'Base' does not contain member 'value'
//│ ║  l.34: 	let receiver = (new Receiver as Receiver[in Child out Base])
//│ ╙──      	                                                      ^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ box = Box(Child(2))
//│ receiver = Receiver

// Control: an explicitly fixed argument gives the callback Child.
:expect 3
class Base
class Child(val value: Int) extends Base
class Sink[T] with
  fun put(value: T): () = ()
class Producer with
  fun use(f: Sink[Child -> Int] -> Int): Int = f(new Sink[Child -> Int])
let producer = new Producer
producer.use(sink =>
  sink.put(x => x.value)
  3
)
//│ = 3
//│ producer = Producer

// Control: an explicitly fixed argument preserves Box[Child].
:expect 4
class Base
class Child(val value: Int) extends Base
class Box[T](val item: T)
class Receiver with
  fun accept(box: Box[Child]): () = ()
let receiver = new Receiver
let box = Box(Child(4))
receiver.accept(box)
box.item.value
//│ = 4
//│ box = Box(Child(4))
//│ receiver = Receiver

// Tuple fields preserve the domain polarity, including both nominal argument parts.
:ge
class Base
class Child(val value: Int) extends Base
class Box[T](val item: T)
class Receiver[T] with
  fun accept(boxes: [Box[T]]): () = ()
let receiver = (new Receiver as Receiver[in Child out Base])
let box = Box(Child(5))
receiver.accept([box])
box.item.value
