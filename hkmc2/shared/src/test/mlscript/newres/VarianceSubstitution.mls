// Structural fields preserve the domain polarity and the nested input bound.
:ge
class Base
class Child(val value: Int) extends Base
class Box[T](val item: T)
class Receiver[T] with
  fun accept(record: {item: Box[T]}): () = ()
let receiver = (new Receiver as Receiver[in Child out Base])
let box = Box(Child(6))
receiver.accept({item: box})
box.item.value
