// The prelude's universal superclass is explicitly open.
:expect 5
class ExplicitObject extends Object() { fun value() = 5 }
new ExplicitObject().value()
//│ = 5

:e
class InvalidParameterized extends SealedClasses.Parameterized[Int](1)
//│ ╔══[COMPILATION ERROR] Cannot extend sealed class 'Parameterized' outside its compilation unit
//│ ║  l.+1: 	class InvalidParameterized extends SealedClasses.Parameterized[Int](1)
//│ ║        	                                   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class 'Parameterized' is defined here; declare it 'open' or 'abstract' to allow external subclasses
//│ ║  in ../../mlscript-compile/SealedClasses.mls
//│ ║  l.XX: 	  class Parameterized[A](val item: A)
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

:expect 7
class OpenParameterized extends SealedClasses.OpenParameterized[Int](7)
new OpenParameterized().item
//│ = 7
