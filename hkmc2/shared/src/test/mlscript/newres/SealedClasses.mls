// The prelude's universal superclass is explicitly open.
:expect 5
class ExplicitObject extends Object { fun value() = 5 }
(new ExplicitObject).value()
//│ = 5

:e
class InvalidParameterized extends SealedClasses.Parameterized[Int](1)
//│ ╔══[COMPILATION ERROR] Cannot extend sealed class 'Parameterized' outside its compilation unit
//│ ║  l.130: 	class InvalidParameterized extends SealedClasses.Parameterized[Int](1)
