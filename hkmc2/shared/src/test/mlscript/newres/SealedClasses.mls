:.

import "../../mlscript-compile/SealedClasses.mls"

// Worksheet blocks and nested scopes still belong to the same compilation unit.
class Local { fun value() = 3 }

:expect [3, 3, 3]
class LocalChild extends Local
module Nested with
  class LocalChild extends Local
[(new LocalChild).value(), (new Nested.LocalChild).value(),
 (new Local with { fun extra() = 4 }).value()]
//│ = [3, 3, 3]

// A sealed class can still be constructed outside its defining unit.
:expect 1
(new SealedClasses.Closed).value()
//│ = 1

:expect [2, 4, 1]
class OpenChild extends SealedClasses.Open
class AbstractChild extends SealedClasses.Abstract { fun value() = 4 }
class IndirectChild extends SealedClasses.OpenChild
[(new OpenChild).value(), (new AbstractChild).value(), (new IndirectChild).value()]
//│ = [2, 4, 1]

:e
class Invalid extends SealedClasses.Closed
//│ ╔══[COMPILATION ERROR] Cannot extend sealed class 'Closed' outside its compilation unit
//│ ║  l.29: 	class Invalid extends SealedClasses.Closed
//│ ║        	                      ^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class 'Closed' is defined here; declare it 'open' or 'abstract' to allow external subclasses
//│ ║  in ../../mlscript-compile/SealedClasses.mls
//│ ║  l.3: 	  class Closed { fun value() = 1 }
//│ ╙──     	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

// Neither modifier on the subclass grants access to a sealed parent.
:e
open class InvalidOpen extends SealedClasses.Closed
//│ ╔══[COMPILATION ERROR] Cannot extend sealed class 'Closed' outside its compilation unit
