//│ ║        	                                       ^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class 'Closed' is defined here; declare it 'open' or 'abstract' to allow external subclasses
//│ ║  in ../../mlscript-compile/SealedClasses.mls
//│ ║  l.XX: 	  class Closed { fun value() = 1 }
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

// Openness is not inherited by subclasses.
:e
class InvalidGrandchild extends SealedClasses.ClosedChild
//│ ╔══[COMPILATION ERROR] Cannot extend sealed class 'ClosedChild' outside its compilation unit
//│ ║  l.+1: 	class InvalidGrandchild extends SealedClasses.ClosedChild
//│ ║        	                                ^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class 'ClosedChild' is defined here; declare it 'open' or 'abstract' to allow external subclasses
//│ ║  in ../../mlscript-compile/SealedClasses.mls
//│ ║  l.XX: 	  class ClosedChild extends Open
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

:e
object InvalidObject extends SealedClasses.Closed
//│ ╔══[COMPILATION ERROR] Cannot extend sealed class 'Closed' outside its compilation unit
