//│ ║  l.150: 	discardRest((...xs) => xs.0.value)
//│ ║         	             ^^^^^
//│ ╟── Cannot resolve member 'value' of a value with unknown shape.
//│ ║  l.149: 	private fun discardRest(f: ErasedCallback) = ()
//│ ║         	                           ^^^^^^^^^^^^^^
//│ ╙── The 'Function' type does not specify parameter types.

// Explicit callback annotations still provide an interface for their parameters.
:expect 42
class Payload(val value: Int)
private fun invoke(f: Function) = f(Payload(42))
invoke((x: Payload) => x.value)
//│ = 42

// Exposure follows returned callbacks after forward definitions are available.
:ge
private fun discardReturned(f: Function) = ()
discardReturned(() => makeCallback())
private fun makeCallback() = laterCallback
private fun laterCallback(x) = x.value
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.174: 	private fun laterCallback(x) = x.value
//│ ║         	                               ^^^^^^^
//│ ╟── Parameter 'x' admits values of unknown shape.
//│ ║  l.174: 	private fun laterCallback(x) = x.value
//│ ║         	                          ^
//│ ╟── This value is returned here.
//│ ║  l.172: 	discardReturned(() => makeCallback())
//│ ║         	                      ^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'value' of a value with unknown shape.
//│ ║  l.171: 	private fun discardReturned(f: Function) = ()
//│ ║         	                               ^^^^^^^^
//│ ╙── The 'Function' type does not specify parameter types.

