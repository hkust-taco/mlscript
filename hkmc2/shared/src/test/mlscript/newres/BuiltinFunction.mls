// Following a callback that returns itself must reach a fixed point.
:expect ()
private fun recursive(x) = recursive
private fun discardRecursive(f: Function) = ()
discardRecursive(recursive)

// Application diagnostics follow the same parameter-to-annotation path as selections.
:ge
private fun discardCallable(f: Function) = ()
discardCallable(x => x())
