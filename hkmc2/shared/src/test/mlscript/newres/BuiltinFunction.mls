//│ ║  l.133: 	private fun discard(f: Function) = ()
//│ ║         	                       ^^^^^^^^
//│ ╙── The 'Function' type does not specify parameter types.

// Aliases retain the annotation witness, including for unknown rest elements.
:ge
type ErasedCallback = Function
private fun discardRest(f: ErasedCallback) = ()
discardRest((...xs) => xs.0.value)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.150: 	discardRest((...xs) => xs.0.value)
