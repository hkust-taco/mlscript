// Calls select the callable overload even when the class has a companion module.
:expect 3
Array[Int](3).length
//│ = 3

// at supports negative indices; foreign undefined results normalize to unit.
:expect [3, 1, ()]
let xs = [1, 2, 3]
[xs.at(-1), xs.at(0), xs.at(3)]
//│ = [3, 1, ()]
//│ xs = [1, 2, 3]

:expect ["7,7,3", "7", "7,9,3"]
let xs = mut [1, 2, 3]
let filled = xs.fill(7, 0, 2).join()
let removed = xs.splice(1, 1, 9).join()
[filled, removed, xs.join()]
//│ = ["7,7,3", "7", "7,9,3"]
//│ filled = "7,7,3"
//│ removed = "7"
//│ xs = [7, 9, 3]

// reduce's accumulator receives both the initial value and the callback results.
:expect [3, 5]
class Item(val value: Int)
class Total(val total: Int)
[[Item(1), Item(2)].reduce((acc, item, ...) => Total(acc.total + item.value), Total(0)).total,
 [Item(5)].reduce((acc, item, ...) => acc + item.value, 0)]
//│ = [3, 5]

// An accumulator shape that comes only from the initial value is still checked.
:e
class Item(val value: Int)
class Total(val total: Int)
[Item(1)].reduce((acc, item, ...) => acc.missing, Total(0))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.207: 	[Item(1)].reduce((acc, item, ...) => acc.missing, Total(0))
//│ ║         	                                     ^^^^^^^^^^^
//│ ╟── Instance of class 'Total' does not contain member 'missing'
//│ ║  l.207: 	[Item(1)].reduce((acc, item, ...) => acc.missing, Total(0))
//│ ╙──       	                                                  ^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Without an initial value, the first element would be the accumulator,
// which the declared signature does not describe.
:e
[1, 2].reduce((acc, x, ...) => acc + x)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.219: 	[1, 2].reduce((acc, x, ...) => acc + x)
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Function 'reduce' expected 2 arguments, but got 1
//│ ║  in ../decls/Prelude.mls
//│ ║  l.170: 	  fun reduce[U](f: (U, T, Int, Array[T]) -> U, initial: U): U
//│ ╙──       	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = 3

// A tuple created in one activation of `mk` and passed to another has the path
// `↘mk ↗mk`, whereas `[1]` has the path `↘mk`. Both receivers share the result
// type parameter of the same `map` selection. The exit from the first activation
// is provenance: Array's members remain at its global definition, so both paths
// read that parameter from the same scope.
:expect [1]
private fun mk(xs) = xs.map((x, ...) => if x is Int then x else mk([x]))
mk([1])
//│ = [1]

// The accumulator of reduce is fed back into the receiver in the same way.
:expect 0
private fun mk(...args) = args.reduce((acc, x, ...) => if acc is Int then acc else mk(...acc), 0)
mk(1, 2)
//│ = 0
