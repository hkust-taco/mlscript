// * Private members are only accessible from within their owner and its companion,
// * including from the definitions nested in them.

module M with
  private val secret = 41
  private fun inc(x) = x + 1
  fun reveal = inc(secret)
  module Nested with
    fun reveal = M.inc(M.secret)

:expect 42
M.reveal
//│ = 42

:expect 42
M.Nested.reveal
//│ = 42

:e
M.secret
//│ ╔══[COMPILATION ERROR] Cannot access private member 'secret' outside its declaring owner
//│ ║  l.23: 	M.secret
//│ ║        	 ^^^^^^^
//│ ╟── private member declared here
//│ ║  l.8: 	  private val secret = 41
//│ ╙──     	              ^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:e
M.inc(1)
//│ ╔══[COMPILATION ERROR] Cannot access private member 'inc' outside its declaring owner
//│ ║  l.33: 	M.inc(1)
//│ ║        	 ^^^^
//│ ╟── private member declared here
//│ ║  l.9: 	  private fun inc(x) = x + 1
//│ ╙──     	              ^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


class Box(val value) with
  private val secret = value + 1
  fun reveal = secret
  fun sameSecret(that: Box) = this.secret == that.secret

:expect [2, true]
[Box(1).reveal, Box(1).sameSecret(Box(1))]
//│ = [2, true]

:e
Box(1).secret
//│ ╔══[COMPILATION ERROR] Cannot access private member 'secret' outside its declaring owner
//│ ║  l.53: 	Box(1).secret
//│ ║        	      ^^^^^^^
//│ ╟── private member declared here
//│ ║  l.44: 	  private val secret = value + 1
//│ ╙──      	              ^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:e
fun peek(box: Box) = box.Box#secret
//│ ╔══[COMPILATION ERROR] Cannot access private member 'secret' outside its declaring owner
//│ ║  l.63: 	fun peek(box: Box) = box.Box#secret
//│ ║        	                             ^^^^^^
//│ ╟── private member declared here
//│ ║  l.44: 	  private val secret = value + 1
//│ ╙──      	              ^^^^^^

// * The parameters of a class that are not declared with `val` are private.

class Point(x, val y)

:e
Point(1, 2).x
//│ ╔══[COMPILATION ERROR] Cannot access private member 'x' outside its declaring owner
//│ ║  l.76: 	Point(1, 2).x
//│ ║        	           ^^
//│ ╟── private member declared here
//│ ║  l.73: 	class Point(x, val y)
//│ ╙──      	            ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:expect 2
Point(1, 2).y
//│ = 2


// * A class and its companion can access each other's private members.

class Pair(val fst, val snd) with
  private val sum = fst + snd
  private fun scaled(k) = Pair.scale(sum, k)
module Pair with
  private fun scale(n, k) = n * k
  fun sumOf(p: Pair) = p.sum
  fun scaledOf(p: Pair, k) = p.scaled(k)
[Pair.sumOf(Pair(1, 2)), Pair.scaledOf(Pair(1, 2), 10)]
//│ = [3, 30]

:e
Pair.scale(1, 2)
//│ ╔══[COMPILATION ERROR] Cannot access private member 'scale' outside its declaring owner
//│ ║  l.103: 	Pair.scale(1, 2)
//│ ║         	    ^^^^^^
//│ ╟── private member declared here
//│ ║  l.96: 	  private fun scale(n, k) = n * k
//│ ╙──      	              ^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// * Subclasses cannot access the private members of their parents,
// * unless they are nested in them.

class Base with
  private fun secret = 1

:e
class Derived extends Base with
  fun get = this.secret
//│ ╔══[COMPILATION ERROR] Cannot access private member 'secret' outside its declaring owner
//│ ║  l.121: 	  fun get = this.secret
//│ ║         	                ^^^^^^^
//│ ╟── private member declared here
//│ ║  l.117: 	  private fun secret = 1
//│ ╙──       	              ^^^^^^

:e
class Derived extends Base with
  fun get = super.secret
//│ ╔══[COMPILATION ERROR] Private member 'secret' is not available through 'super'
//│ ║  l.131: 	  fun get = super.secret
//│ ║         	                 ^^^^^^^
//│ ╟── private member declared here
//│ ║  l.117: 	  private fun secret = 1
//│ ╙──       	              ^^^^^^

class Outer with
  private val v = 1
  fun mk = new Inner
  class Inner extends Outer with
    fun get = this.v

:expect 1
(new Outer).mk.get
//│ = 1


// * Private members do not hide inherited members from the code that cannot access them,
// * just like JavaScript's private class elements do not hide inherited properties.

class Named(val name)
class Tagged(name, val tag) extends Named(name + "!") with
  fun describe = name + ":" + tag

:expect ["a!", "a:1"]
[Tagged("a", 1).name, Tagged("a", 1).describe]
//│ = ["a!", "a:1"]

class Parent with
  val label = "parent"
class Child extends Parent with
  private val label = "child"
  fun own = label
let c = new Child
//│ c = Child { label: "parent" }

:expect ["parent", "child"]
[c.label, c.own]
//│ = ["parent", "child"]

// * Private members are not available through `super`.

class A with
  fun f = "A"
class B extends A with
  private fun f = "B"
  fun g = f
class C extends B with
  fun h = super.f

:expect ["A", "B", "A"]
[(new C).f, (new C).g, (new C).h]
//│ = ["A", "B", "A"]


// * A reference whose possible receivers include an inaccessible private member is rejected.

:e
class Secretive with
  private val v = 1
class Open with
  val v = 2
private fun get(x) = x.v
[get(new Secretive), get(new Open)]
//│ ╔══[COMPILATION ERROR] Cannot access private member 'v' outside its declaring owner
//│ ║  l.195: 	private fun get(x) = x.v
//│ ║         	                      ^^
//│ ╟── private member declared here
//│ ║  l.192: 	  private val v = 1
//│ ╙──       	              ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// * Explicit opens can name inaccessible members, but not use them,
// * while wildcard opens do not provide them.

module Lib1 with
  private fun hidden = 1

open Lib1 { hidden }

:e
hidden
//│ ╔══[COMPILATION ERROR] Cannot access private member 'hidden' outside its declaring owner
