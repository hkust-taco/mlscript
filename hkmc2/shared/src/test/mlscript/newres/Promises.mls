// Returning explicitly, or returning a closure, must not expose the payload.
:await
:expect 44
@annotations.async
fun explicitReturn() = return {answer: 44}
explicitReturn().then(value => value.answer)
//│ = 44

:e
@annotations.async
fun returnedClosure() = () => 42
returnedClosure()()
