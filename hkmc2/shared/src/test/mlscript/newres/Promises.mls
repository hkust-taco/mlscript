// The pending wrapper survives higher-order inference after partial application.
:await
:expect 58
fun finish[T](callback: Int -> T): T = callback(38)
finish(separatelyTyped(20)).then(value => value)
//│ = 58

// An arrow in the payload type is not an extra parameter list of the definition.
:await
:expect 59
fun signedClosure: () -> () -> Int
@annotations.async
fun signedClosure() = () => 59
signedClosure().then(callback => callback())
//│ = 59

// An ineffective annotation on a value must not change its interface.
:w
:expect 60
@annotations.async
val plainValue = {answer: 60}
plainValue.answer
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.280: 	@annotations.async
//│ ╙──       	^^^^^^^^^^^^^^^^^^
//│ = 60
//│ plainValue = {answer: 60}

// Awaiting an inferred async result retains its record interface.
:await
:expect 61
@annotations.async
fun awaitInferred() = handlers.await(inferred()).answer + 19
awaitInferred()
//│ = 61

// Both async bodies and Promise.resolve adopt an already promised result.
:await
:expect 62
@annotations.async
fun nestedAsync() = Promise.resolve(Promise.resolve({answer: 62}))
nestedAsync().then(value => value.answer)
//│ = 62

// Chaining flattens promised callback results before the next callback or await.
:await
:expect 63
@annotations.async
fun awaitChain() =
  let value = handlers.await(Promise.resolve({answer: 63}).then(value => @annotations.async value))
  value.answer
awaitChain()
//│ = 63

// Promise.all accepts plain values and promises and exposes fulfilled elements.
:await
:expect 64
class PromiseAnswer(val answer: Int)
Promise.all([PromiseAnswer(32), Promise.resolve(PromiseAnswer(32))]).then(values =>
  values.[0].answer + values.[1].answer)
//│ = 64

// The constructor infers its payload from calls to its resolve callback.
:await
:expect 65
(new Promise((resolve, reject) => resolve({answer: 65}))).then(value => value.answer)
//│ = 65

// Generic async calls retain independent payloads, including nested fields.
:await
:expect "independent"
@annotations.async
fun asyncIdentity[T](value: T): T = value
@annotations.async
fun independentPayloads() =
  let first = handlers.await(asyncIdentity({first: {answer: 66}}))
  let second = handlers.await(asyncIdentity({second: "independent"}))
  first.first.answer
  second.second
independentPayloads()
//│ = "independent"

// Inferred bodies must also keep call-site payloads apart.
:await
:expect "inferred"
@annotations.async
fun inferredIdentity(value) = value
@annotations.async
fun independentInferredPayloads() =
  let first = handlers.await(inferredIdentity({first: {answer: 67}}))
  let second = handlers.await(inferredIdentity({second: "inferred"}))
  first.first.answer
  second.second
independentInferredPayloads()
//│ = "inferred"

// Promise-returning generic async calls flatten their payload per instantiation.
:await
:expect 70
asyncIdentity(Promise.resolve({answer: 70})).then(value => value.answer)
//│ = 70

// Promise constructor resolution also adopts promised values.
:await
:expect 71
(new Promise((resolve, reject) => resolve(Promise.resolve({answer: 71})))).then(value => value.answer)
//│ = 71

:await
:expect 72
@annotations.async
fun awaitConstructed() =
  let value = handlers.await(new Promise((resolve, reject) => resolve(Promise.resolve({answer: 72}))))
  value.answer
awaitConstructed()
//│ = 72

// Recursive async calls share a deferred fulfillment interface.
:await
:expect 73
@annotations.async
fun recursiveAsync(n: Int) = if n == 0 then {answer: 73} else recursiveAsync(n - 1)
recursiveAsync(3).then(value => value.answer)
//│ = 73

// Inferred generic bodies preserve their substitution without a result annotation.
:await
:expect "generic body"
@annotations.async
fun inferredGeneric[T](value: T) = value
@annotations.async
fun awaitGenericBody() =
  let first = handlers.await(inferredGeneric({first: 74}))
  let second = handlers.await(inferredGeneric({second: "generic body"}))
  first.first
  second.second
awaitGenericBody()
//│ = "generic body"

// A resolve call discovered after a consumer still supplies that consumer's type.
:await
:expect 75
let settleLater
let pending = new Promise((resolve, reject) => set settleLater = resolve)
let settled = pending.then(value => value.answer)
settleLater({answer: 75})
settled
//│ = 75
//│ pending = Promise {}
//│ settleLater = fun
//│ settled = Promise {}

// Type arguments are retained through an explicitly declared promise boundary.
:await
:expect 76
fun declaredPromise(): Promise[{answer: Int}] = Promise.resolve({answer: 76})
declaredPromise().then(value => value.answer)
//│ = 76

