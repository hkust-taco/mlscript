// A generic async signature must retain Promise after explicit specialization.
:await
:expect 51
@annotations.async
fun generic[T](value: T): T = value
generic[Int](51).then(value => value)
//│ = 51

// Typed higher-order inference must also see the wrapped result.
:await
:expect 52
fun invokeWith[T](callback: Int -> T): T = callback(52)
invokeWith(typed).then(value => value.answer)
//│ = 52

// Imported interfaces retain async annotations through cloning and completion.
