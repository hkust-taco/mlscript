:.

// The prelude's declared Promise interface supports factory calls and chaining.
// Callback parameters and await results inherit the promise's payload type.
:await
:expect 43
Promise.resolve(42).then(value => value + 1)
//│ = 43

:await
:expect "recovered: failed"
Promise.reject("failed").then(value => value, reason => "recovered: " + reason)
//│ = "recovered: failed"

:await
:expect 42
Promise.all([Promise.resolve(20), Promise.resolve(22)]).then(values => values.at(0) + values.at(1))
//│ = 42

// Async expressions expose the same Promise interface as declared factories.
:await
:expect {answer: 42}
@annotations.async {answer: 42}
//│ = {answer: 42}

:await
:expect 42
let asyncResult = @annotations.async {answer: 42}
asyncResult.then(value => value.answer)
//│ = 42
//│ asyncResult = Promise {}

// The Promise interface and its async origin survive a function call.
:e
fun makePromise() = @annotations.async {answer: 42}
makePromise().answer
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.36: 	makePromise().answer
//│ ║        	^^^^^^^^^^^^^^^^^^^^
//│ ╟── Value of type 'Promise' does not contain member 'answer'
//│ ║  l.35: 	fun makePromise() = @annotations.async {answer: 42}
//│ ║        	                    ^^^^^^^^^^^^^^^^^^
//│ ╙── This async annotation wraps the body's result in a promise.
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Async functions expose Promise, so selecting a field of their body is invalid.
