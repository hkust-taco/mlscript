// Async getters and methods obey the same rule as ordinary functions.
:await
:expect 45
@annotations.async
fun asyncGetter: {answer: Int} = {answer: 45}
asyncGetter.then(value => value.answer)
//│ = 45

:await
:expect 46
class AsyncMethods with
  @annotations.async
  fun fetch(value: Int): {answer: Int} = {answer: value}
(new AsyncMethods).fetch(46).then(value => value.answer)
//│ = 46

// Partial application is still a function; only the last call returns Promise.
:await
:expect 47
@annotations.async
fun curried(x: Int)(y: Int): Int = x + y
let remaining = curried(20)
remaining(27).then(value => value)
//│ = 47
//│ remaining = fun

:e
curried(20).then(value => value)
