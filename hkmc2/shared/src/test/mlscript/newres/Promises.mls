// Await propagates the fulfilled value's interface.
:await
:expect 42
@annotations.async
fun awaitAnswer() =
  let value = handlers.await(Promise.resolve({answer: 42}))
  value.answer
awaitAnswer()
//│ = 42

// Both inferred and annotated bodies expose Promise at the call boundary.
:await
:expect 42
@annotations.async
fun inferred() = {answer: 42}
inferred().then(value => value.answer)
//│ = 42

:await
:expect 43
@annotations.async
fun typed(value: Int): {answer: Int} = {answer: value}
typed(43).then(value => value.answer)
