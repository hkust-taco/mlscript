// Generic result inference through a callback must infer Promise, not the body.
:await
:expect 42
fun invoke[T](callback: () -> T): T = callback()
invoke(inferred).then(value => value.answer)
//│ = 42

:await
:expect 48
invoke(() => typed(48)).then(value => value.answer)
//│ = 48

// Throwing bodies still have the async calling interface, even without returns.
@annotations.async
fun throws() = throw new Error("failed")
fun inspectThrows() = throws().then((value: Any) => 0)

// The built-in Promise must be used even when a local declaration shadows it.
:await
:expect 49
fun shadowed() =
  class Promise
  @annotations.async
  fun result() = 49
  result().then(value => value)
shadowed()
//│ = 49

// Separate signatures describe the body's result, including curried arrows.
:await
:expect 50
fun separatelyTyped: Int -> Int -> Int
@annotations.async
fun separatelyTyped(x)(y) = x + y
let typedRemaining = separatelyTyped(20)
typedRemaining(30).then(value => value)
//│ = 50
//│ typedRemaining = fun

