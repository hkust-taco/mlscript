:.

// The prelude's declared Promise interface supports factory calls and chaining.
// Its callback type is Function; inputs inspected by callbacks need explicit types.
:await
:expect 43
Promise.resolve(42).then((value: dyn) => value + 1)
//│ = 43

:await
:expect "recovered: failed"
Promise.reject("failed").then((value: dyn) => value, (reason: dyn) => "recovered: " + reason)
//│ = "recovered: failed"

:await
:expect 42
Promise.all([Promise.resolve(20), Promise.resolve(22)]).then((values: dyn) => values.at(0) + values.at(1))
//│ = 42

// Async expressions execute, but do not yet expose the declared Promise interface.
:await
:expect {answer: 42}
@annotations.async {answer: 42}
//│ = {answer: 42}

:e
let asyncResult = @annotations.async {answer: 42}
asyncResult.then((value: dyn) => value.answer)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.28: 	asyncResult.then((value: dyn) => value.answer)
//│ ║        	^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'then' of a value with unknown shape.
//│ ╟── This async expression returns a promise, rather than the value of its body.
//│ ║  l.27: 	let asyncResult = @annotations.async {answer: 42}
//│ ║        	                  ^^^^^^^^^^^^^^^^^^
//│ ╙── Member resolution for async results is not supported yet.
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ asyncResult = Promise {}

// The unknown async result must retain its origin through a function call.
:e
fun makePromise() = @annotations.async {answer: 42}
makePromise().answer
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.43: 	makePromise().answer
//│ ║        	^^^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'answer' of a value with unknown shape.
//│ ╟── This async expression returns a promise, rather than the value of its body.
//│ ║  l.42: 	fun makePromise() = @annotations.async {answer: 42}
//│ ║        	                    ^^^^^^^^^^^^^^^^^^
//│ ╙── Member resolution for async results is not supported yet.
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// FIXME: An async function's caller currently sees the body's shape, although
// lowering wraps the result in a promise. This selection should be rejected.
:breakme
:e
@annotations.async
fun asyncFunction() = {answer: 42}
asyncFunction().answer

// FIXME: Await does not yet propagate the fulfilled value's interface.
:fixme
:await
:expect 42
@annotations.async
fun awaitAnswer() =
  let value = handlers.await(Promise.resolve({answer: 42}))
  value.answer
awaitAnswer()
//│ ╔══[COMPILATION ERROR] This selection of member 'answer' has no resolved target
//│ ║  l.69: 	  value.answer
//│ ╙──      	  ^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ ═══[RUNTIME ERROR] Expected: '42', got: 'Promise {}'
//│ = Promise {}
