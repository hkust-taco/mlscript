//│ ║  l.136: 	@annotations.async
//│ ║         	^^^^^^^^^^^^^^^^^^
//│ ║  l.137: 	fun curried(x: Int)(y: Int): Int = x + y
//│ ╙──       	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
