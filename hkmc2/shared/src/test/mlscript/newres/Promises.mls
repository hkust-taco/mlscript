// A generic async signature must retain Promise after explicit specialization.
:await
:expect 51
@annotations.async
fun generic[T](value: T): T = value
generic[Int](51).then((value: Int) => value)
//│ = 51

// Typed higher-order inference must also see the wrapped result.
:await
:expect 52
fun invokeWith[T](callback: Int -> T): T = callback(52)
invokeWith(typed).then((value: {answer: Int}) => value.answer)
//│ = 52

// Imported interfaces retain async annotations through cloning and completion.
import "../../mlscript-compile/AsyncLibrary.mls"

:await
:expect 53
AsyncLibrary.inferred().then((value: {answer: Int}) => value.answer)
//│ = 53

:await
:expect 54
AsyncLibrary.typed(54).then((value: {answer: Int}) => value.answer)
//│ = 54

:await
:expect 55
AsyncLibrary.curried(20)(35).then((value: Int) => value)
//│ = 55

:await
:expect 56
AsyncLibrary.getter.then((value: Int) => value)
//│ = 56

:await
:expect 57
fun nominalMethod(receiver: AsyncLibrary.Methods) =
  receiver.result(57).then((value: Int) => value)
nominalMethod(new AsyncLibrary.Methods)
//│ = 57

:e
