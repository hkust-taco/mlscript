// Promise payloads that escape must expose their callbacks' parameter obligations.
:!js
:e
val escapedCallback = @annotations.async {value => value.answer}
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.451: 	val escapedCallback = @annotations.async {value => value.answer}
//│ ║         	                                                   ^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'answer' of a value with unknown shape.
//│ ╟── Parameter 'value' admits values of unknown shape.
//│ ║  l.451: 	val escapedCallback = @annotations.async {value => value.answer}
//│ ║         	                                          ^^^^^
//│ ╟── This value is fulfilled by this promise.
//│ ║  in ../decls/Prelude.mls
//│ ║  l.180: 	declare class Promise[out A](executor: (A -> Any, Any -> Any) -> Any) {
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.181: 	  fun id"then"[B](onFulfilled: Awaited[A] -> B, ...onRejected: Array[Any -> B]): Promise[Awaited[B]]
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.182: 	}
//│ ║         	^
//│ ╟── 'escapedCallback' is exposed by this compilation unit.
//│ ║  in Promises.mls:451
//│ ║  l.451: 	val escapedCallback = @annotations.async {value => value.answer}
//│ ╙──       	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

// A promise with no finite fulfillment has no payload member interface.
:!js
:e
@annotations.async
fun noFulfillment() = noFulfillment()
noFulfillment().then(value => value.answer)
//│ ╔══[COMPILATION ERROR] This selection of member 'answer' has no resolved target
//│ ║  l.477: 	noFulfillment().then(value => value.answer)
//│ ╙──       	                              ^^^^^^^^^^^^

// TODO: Infer structural thenables' fulfillment callbacks. Their original fields
// must not be exposed as the payload while JavaScript adopts the resolved value.
:!js
:fixme
class Thenable with
  fun id"then"(resolve: {answer: Int} -> Any, reject: Any -> Any) = resolve({answer: 77})
Promise.resolve(new Thenable).then(value => value.answer)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.488: 	Promise.resolve(new Thenable).then(value => value.answer)
//│ ║         	                                            ^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'answer' of a value with unknown shape.
//│ ╟── This value may be a thenable; its fulfillment interface is not known.
//│ ║  l.488: 	Promise.resolve(new Thenable).then(value => value.answer)
//│ ╙──       	                ^^^^^^^^^^^^
