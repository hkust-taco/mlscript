:.

// The prelude's declared Promise interface supports factory calls and chaining.
// Its callback type is Function; inputs inspected by callbacks need explicit types.
:await
:expect 43
Promise.resolve(42).then((value: dyn) => value + 1)
//│ = 43

:await
:expect "recovered: failed"
Promise.reject("failed").then((value: dyn) => value, (reason: dyn) => "recovered: " + reason)
//│ = "recovered: failed"

:await
:expect 42
Promise.all([Promise.resolve(20), Promise.resolve(22)]).then((values: dyn) => values.at(0) + values.at(1))
//│ = 42

// Async expressions expose the same Promise interface as declared factories.
:await
:expect {answer: 42}
@annotations.async {answer: 42}
//│ = {answer: 42}

:await
:expect 42
let asyncResult = @annotations.async {answer: 42}
asyncResult.then((value: dyn) => value.answer)
//│ = 42
//│ asyncResult = Promise {}

// The Promise interface and its async origin survive a function call.
:e
fun makePromise() = @annotations.async {answer: 42}
makePromise().answer
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.36: 	makePromise().answer
//│ ║        	^^^^^^^^^^^^^^^^^^^^
//│ ╟── Value of type 'Promise' does not contain member 'answer'
//│ ║  l.35: 	fun makePromise() = @annotations.async {answer: 42}
//│ ║        	                    ^^^^^^^^^^^^^^^^^^
//│ ╙── This async annotation wraps the body's result in a promise.
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Async functions expose Promise, so selecting a field of their body is invalid.
:e
@annotations.async
fun asyncFunction() = {answer: 42}
asyncFunction().answer
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.50: 	asyncFunction().answer
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Value of type 'Promise' does not contain member 'answer'
//│ ║  l.48: 	@annotations.async
//│ ║        	^^^^^^^^^^^^^^^^^^
//│ ╙── This async annotation wraps the body's result in a promise.
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// FIXME: Await does not yet propagate the fulfilled value's interface.
:fixme
:await
:expect 42
@annotations.async
fun awaitAnswer() =
  let value = handlers.await(Promise.resolve({answer: 42}))
  value.answer
awaitAnswer()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.67: 	  value.answer
//│ ║        	  ^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'answer' of a value with unknown shape.
//│ ║  in ../decls/Prelude.mls
//│ ║  l.562: 	  fun await(promise: Promise): Any
//│ ║         	                               ^^^
//│ ╟── Type 'Any' is declared without a member interface.
//│ ║  l.2: 	declare type Any
//│ ╙──     	             ^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ ═══[RUNTIME ERROR] Expected: '42', got: 'Promise {}'
//│ = Promise {}

// Both inferred and annotated bodies expose Promise at the call boundary.
:await
:expect 42
@annotations.async
fun inferred() = {answer: 42}
inferred().then((value: {answer: Int}) => value.answer)
//│ = 42

:await
:expect 43
@annotations.async
fun typed(value: Int): {answer: Int} = {answer: value}
typed(43).then((value: {answer: Int}) => value.answer)
//│ = 43

:e
typed(43).answer
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.99: 	typed(43).answer
//│ ║        	^^^^^^^^^^^^^^^^
//│ ╟── Value of type 'Promise' does not contain member 'answer'
//│ ║  l.93: 	@annotations.async
//│ ║        	^^^^^^^^^^^^^^^^^^
//│ ╙── This async annotation wraps the body's result in a promise.
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Returning explicitly, or returning a closure, must not expose the payload.
:await
:expect 44
@annotations.async
fun explicitReturn() = return {answer: 44}
explicitReturn().then((value: {answer: Int}) => value.answer)
//│ = 44

:e
@annotations.async
fun returnedClosure() = () => 42
returnedClosure()()
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.120: 	returnedClosure()()
//│ ║         	^^^^^^^^^^^^^^^^^^^
//│ ╟── Value of type 'Promise' cannot be called like a function.
//│ ║  l.118: 	@annotations.async
//│ ║         	^^^^^^^^^^^^^^^^^^
//│ ╙── This async annotation wraps the body's result in a promise.
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Async getters and methods obey the same rule as ordinary functions.
:await
:expect 45
@annotations.async
fun asyncGetter: {answer: Int} = {answer: 45}
asyncGetter.then((value: {answer: Int}) => value.answer)
//│ = 45

:await
:expect 46
class AsyncMethods with
  @annotations.async
  fun fetch(value: Int): {answer: Int} = {answer: value}
(new AsyncMethods).fetch(46).then((value: {answer: Int}) => value.answer)
//│ = 46

// Partial application is still a function; only the last call returns Promise.
:await
:expect 47
@annotations.async
fun curried(x: Int)(y: Int): Int = x + y
let remaining = curried(20)
remaining(27).then((value: Int) => value)
//│ = 47
//│ remaining = fun

:e
curried(20).then((value: Int) => value)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
