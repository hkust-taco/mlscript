//│ ╟── Function with a declared signature expected 0 arguments, but got 1
//│ ║  l.140: 	fun unused(factory: () -> Int) = factory(1)
//│ ╙──       	                    ^^

// A callable annotation also hides extra members of the concrete result.
:ge
class Base
class Child extends Base with
  val extra = 42
fun read(factory: () -> Base) = factory().extra
read(() => new Child)
