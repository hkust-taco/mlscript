// An unannotated field cannot reveal its initializer through an annotated receiver.
:ge
class Item with
  val extra = 42
class Box(val item)
fun read(box: Box) = box.item.extra
read(Box(new Item))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.74: 	fun read(box: Box) = box.item.extra
//│ ║        	                     ^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'extra' of a value with unknown shape.
//│ ║  l.74: 	fun read(box: Box) = box.item.extra
//│ ╙──      	                     ^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// An unannotated method result cannot reveal the method body either.
:ge
class Item with
  val extra = 42
class Box with
  fun item() = new Item
fun read(box: Box) = box.item().extra
read(new Box)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
