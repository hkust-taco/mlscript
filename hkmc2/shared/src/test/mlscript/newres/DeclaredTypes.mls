// A generic method's result carries the receiver's type argument to the caller.
:expect [1, 2]
class First(val first: Int)
class Second(val second: Int)
class Box[X](val value: X) with
  fun get(): X = value
fun identity[T](x: T): T = x
[identity[Box[First]](Box[First](First(1))).get().first,
 identity[Box[Second]](Box[Second](Second(2))).get().second]
//│ = [1, 2]

// Function constraints propagate tuple shapes through a type argument.
:expect [2, 4]
class Foo[X](val f: X -> X)
fun test[A](x: Foo[[A, Int]]) = x.f
test(new Foo(arg => [arg.0 + 1, arg.1 + 2]))([1, 2])
//│ = [2, 4]

// Dependent method signatures also keep distinct inferred instantiations separate.
:expect [1, 2]
class First(val first: Int)
class Second(val second: Int)
class Box[X](val value: X) with
  fun get(): X = value
class Foo[X](val f: Box[X])
fun test[A](x: Foo[A]) = x.f
[test(new Foo(new Box(First(1)))).get().first,
 test(new Foo(new Box(Second(2)))).get().second]
//│ = [1, 2]

