// Independent callback instantiations must not mix their tuple element shapes.
:expect [2, 4]
class First(val first: Int)
class Second(val second: Int)
class Foo[X](val f: X -> X)
fun test[A](x: Foo[[A, Int]]) = x.f
[test(new Foo(arg => [First(arg.0.first + 1), arg.1]))([First(1), 0]).0.first,
 test(new Foo(arg => [Second(arg.0.second + 2), arg.1]))([Second(2), 0]).0.second]
//│ = [2, 4]

