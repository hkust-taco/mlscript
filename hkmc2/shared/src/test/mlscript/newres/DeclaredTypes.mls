// A concrete annotation supplies the nested member interface without losing tuple precision.
:expect 42
class Item with
  val oops = 42
class Box[X](val value: [X, X])
fun foo(x: Box[Item]) = x.value.0.oops
foo(Box[Item]([new Item, new Item]))
