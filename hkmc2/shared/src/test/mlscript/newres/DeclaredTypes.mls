// Inherited declared fields retain their type through curried constructors.
:expect 42
class Item(val value: Int)
class Parent(val item: Item)(val ignored)
class Child(input)(ignored) extends Parent(input)(ignored)
fun read(child: Child) = child.item.value
read(Child(Item(42))(0))
//│ = 42

// Nested captures do not bring implementation argument marks through the annotation.
:expect 42
class Item(val value: Int)
class Box(val item: Item)
fun enclosing(box: Box) =
  fun inner() = box.item.value
  inner()
enclosing(Box(Item(42)))
//│ = 42

// Generic aliases and inherited interfaces substitute declared type arguments.
:expect 42
class Item(val value: Int)
class Box[T](val item: T)
type Wrapped[T] = Box[T]
class Child[T](item: T) extends Box[T](item)
fun read(box: Wrapped[Item]) = box.item.value
fun inherited(box: Child[Item]) = box.item.value
read(Box[Item](Item(20))) + inherited(Child[Item](Item(22)))
//│ = 42

// Function type annotations supply the result interface without inspecting a lambda.
:expect 42
class Item(val value: Int)
type Factory[T] = () -> T
fun read(factory: Factory[Item]) = factory().value
read(() => Item(42))
//│ = 42

// Function type arity is checked even when the annotated function is unused.
:ge
fun unused(factory: () -> Int) = factory(1)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.140: 	fun unused(factory: () -> Int) = factory(1)
