// Type-parameter uses in nested signatures retain their capture path.
:expect 42
class Item(val value: Int)
fun identity[T](x: T): T =
  fun nested(): T = x
  nested()
identity(Item(42)).value
//│ = 42

// Infer through nested nominal type arguments, preserving each constructor's marks.
:expect 42
class Box[X](val value: X)
class Foo[X](val f: Box[X])
fun test[A](x: Foo[A]) = x.f
test(new Foo(new Box(Predef))).value.id(42)
//│ = 42

// Distinct nested instantiations must not leak their member sets into each other.
:expect [1, 2]
class First(val first: Int)
class Second(val second: Int)
class Box[X](val value: X)
class Foo[X](val f: Box[X])
fun test[A](x: Foo[A]) = x.f
[test(new Foo(new Box(First(1)))).value.first,
 test(new Foo(new Box(Second(2)))).value.second]
//│ = [1, 2]

