//│ ║         	                     ^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'extra' of a value with unknown shape.
//│ ║  l.226: 	fun read(box: Box) = box.Box#item.extra
//│ ╙──       	                     ^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A signature alias supplies the interface to both the body and callers.
:expect 42
class Item(val value: Int)
type Reader = (Item) -> Int
fun read: Reader
fun read(item) = item.value
read(Item(42))
//│ = 42

// Explicit and inferred type arguments share parameter flow, with distinct call marks.
:expect [42, 7, 42, 7]
class Item(val value: Int)
class Other(val different: Int)
fun identity[T](x: T): T = x
[identity[Item](Item(42)).value, identity[Other](Other(7)).different,
 identity(Item(42)).value, identity(Other(7)).different]
//│ = [42, 7, 42, 7]

// Explicit type arguments prevent the value argument from refining the interface.
:ge
class Base
class Child extends Base with
  val extra = 42
fun identity[T](x: T): T = x
identity[Base](new Child).extra
