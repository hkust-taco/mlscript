// A callback supplied through an annotation exposes its declared result shape.
:expect 42
class Item(val value: Int)
fun run[A](f: Int -> A): A = f(0)
fun callback: Int -> Item = ignored => Item(42)
run(callback).value
//│ = 42

// Tuple elements can be used directly as callees.
:expect 42
[x => x + 1].0(41)
//│ = 42

// Indexed assignments must retain indexed lowering.
:expect 42
let xs = mut [1, 2]
set xs.1 = 42
xs.1
//│ = 42
//│ xs = [1, 42]
