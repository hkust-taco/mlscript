:.

// No calls are needed to resolve an annotated receiver's members.
class Box(val value)
fun unused(box: Box) = box.value

// Reading an unannotated field crosses no constructor argument-flow boundary.
:expect 42
class Box(val value)
fun read(box: Box) = box.value
read(Box(42))
//│ = 42

// An annotation hides subclass-only members, even at an observed call.
:ge
class Base
class Child extends Base with
  val extra = 42
fun hidden(base: Base) = base.extra
hidden(new Child)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.19: 	fun hidden(base: Base) = base.extra
//│ ║        	                         ^^^^^^^^^^
//│ ╙── Value of type 'Base' does not contain member 'extra'
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// The declared interface selects the method, while dispatch uses the actual receiver.
:expect 42
class Base with
  fun value(): Int = 0
class Child extends Base with
  fun value(): Int = 42
fun read(base: Base) = base.value()
read(new Child)
//│ = 42

// A declared result is opaque even when its body constructs a known subclass.
:ge
class Base
class Child extends Base with
  val extra = 42
fun make(): Base = new Child
make().extra
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.43: 	make().extra
//│ ║        	^^^^^^^^^^^^
//│ ╙── Value of type 'Base' does not contain member 'extra'
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Likewise for a getter/value annotation and for explicit ascription.
