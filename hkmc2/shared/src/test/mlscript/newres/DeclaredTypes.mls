// Callback inputs and outputs share inferred type arguments at the application.
:expect 43
class Item(val value: Int)
fun apply[A](f: A -> A, x: A): A = f(x)
apply(arg => Item(arg.value + 1), Item(42)).value
//│ = 43

// Expected callback parameters retain explicit abstraction boundaries.
:ge
class Base
class Child extends Base with
  val extra = 1
fun apply[A](f: A -> A, x: A): A = f(x)
apply[Base](arg => (arg.extra; arg), new Child)
