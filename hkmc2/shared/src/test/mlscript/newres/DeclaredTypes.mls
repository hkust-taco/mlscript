//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Separate signatures annotate implementation parameters before any observed call.
:ge
class Base
class Child extends Base with
  val extra = 42
fun hidden: (Base) -> Int
fun hidden(base) = base.extra
hidden(new Child)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
