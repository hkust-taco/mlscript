// An overloaded type name must not expose its value initializer through an interface.
:ge
class Secret with
  val extra = 42
module Types with
  class Item
  val Item = new Secret
fun hidden(module types: Types) = types.Item.extra
hidden(Types)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
