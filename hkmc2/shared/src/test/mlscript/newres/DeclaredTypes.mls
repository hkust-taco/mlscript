// Explicit and inferred type arguments share parameter flow, with distinct call marks.
:expect [42, 7, 42, 7]
class Item(val value: Int)
class Other(val different: Int)
fun identity[T](x: T): T = x
[identity[Item](Item(42)).value, identity[Other](Other(7)).different,
 identity(Item(42)).value, identity(Other(7)).different]
//│ = [42, 7, 42, 7]

