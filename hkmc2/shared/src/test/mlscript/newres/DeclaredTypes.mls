// Tuple projections retain contexts through spreads and function returns.
:expect [1, 2]
class First(val first: Int)
class Second(val second: Int)
fun wrap(x) = [...[x]]
[wrap(First(1)).0.first, wrap(Second(2)).0.second]
//│ = [1, 2]

// Mutation invalidates initializer shapes, including through a tuple spread.
