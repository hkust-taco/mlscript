// Alias substitution keeps nested arguments in the scope where they were written.
:expect 42
class Item(val value: Int)
type Identity[T] = T
type Twice[T] = Identity[Identity[T]]
fun read(item: Twice[Item]) = item.value
read(Item(42))
//│ = 42

// Recursive nominal signatures unfold only when a member is selected.
class Node(val next: Link)
type Link = Node
fun unused(node: Link) = node.next.next

// An unproductive alias must not loop, even when each step grows its arguments.
:ge
class Box[T]
type Loop[T] = Loop[Box[T]]
fun unused(value: Loop[Int]) = value.field
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.207: 	fun unused(value: Loop[Int]) = value.field
//│ ║         	                               ^^^^^^^^^^^
//│ ╟── Cannot resolve member 'field' of a value with unknown shape.
//│ ║  l.207: 	fun unused(value: Loop[Int]) = value.field
//│ ╙──       	                  ^^^^^^^^^

// Type arguments provide callable shapes through the generic parameter.
:expect 42
fun invoke[T](value: T) = value()
invoke[() -> Int](() => 42)
//│ = 42

// A class-qualified selection still respects an annotated receiver's field boundary.
:ge
class Item with
  val extra = 42
class Box(val item)
fun read(box: Box) = box.Box#item.extra
read(Box(new Item))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
