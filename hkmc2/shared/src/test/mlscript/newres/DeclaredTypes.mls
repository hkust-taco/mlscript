//│ ║  l.215: 	type Loop[T] = Loop[Box[T]]
//│ ║         	               ^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.215: 	type Loop[T] = Loop[Box[T]]
//│ ╙──       	     ^^^^
//│ ╔══[COMPILATION ERROR] This selection of member 'field' has no resolved target
//│ ║  l.216: 	fun unused(value: Loop[Int]) = value.field
//│ ╙──       	                               ^^^^^^^^^^^

// A concrete instantiation cannot authorize calls through an opaque type parameter.
