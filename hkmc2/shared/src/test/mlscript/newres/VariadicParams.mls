:.
open annotations


// *** Variadic parameters followed by trailing parameters ***

:sjs
fun f(x, ...xs, y) = [x, xs, y]
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f;
//│ f = function f(x, ...args) {
//│   let y, inlinedVal, tmp, tmp1;
//│   tmp1 = 1 + args.length;
//│   runtime.checkArgs("f", 2, tmp1);
//│   tmp = args.length - 1;
//│   inlinedVal = runtime.safeCall(args.slice(0, tmp));
//│   y = args.at(-1);
//│   return globalThis.Object.freeze([ x, inlinedVal, y ])
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect [[1, [], 2], [1, [2], 3], [1, [2, 3], 4]]
[f(1, 2), f(1, 2, 3), f(1, 2, 3, 4)]
//│ = [[1, [], 2], [1, [2], 3], [1, [2, 3], 4]]

:e
f(1)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.27: 	f(1)
//│ ║        	^^^^
//│ ╟── Function 'f' expected at least 2 arguments, but got 1
//│ ║  l.8: 	fun f(x, ...xs, y) = [x, xs, y]
//│ ╙──     	^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected at least 2 arguments but got 1

fun g(...xs, y, z) = [xs, y, z]

:expect [[[], 1, 2], [[1, 2], 3, 4]]
[g(1, 2), g(1, 2, 3, 4)]
//│ = [[[], 1, 2], [[1, 2], 3, 4]]

:expect [1, [2], 3]
((x, ...xs, y) => [x, xs, y])(1, 2, 3)
//│ = [1, [2], 3]


// *** Optional parameters before a variadic parameter ***

// The required parameters take the first and last arguments, the optional ones
// take the remaining ones from left to right, and the variadic one takes the rest.
:sjs
fun h(x, y?, z?, ...xs, w) = [x, y, z, xs, w]
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let h;
//│ h = function h(x, ...args7) {
//│   let y7, z2, w, inlinedVal12, inlinedVal13, tmp14, tmp15, tmp16;
//│   tmp16 = 1 + args7.length;
//│   runtime.checkArgs("h", 2, tmp16);
//│   tmp15 = args7.length - 1;
//│   inlinedVal12 = runtime.safeCall(args7.slice(0, tmp15));
//│   y7 = inlinedVal12.at(0);
//│   z2 = inlinedVal12.at(1);
//│   tmp14 = args7.length - 1;
//│   inlinedVal13 = runtime.safeCall(args7.slice(2, tmp14));
//│   w = args7.at(-1);
//│   return globalThis.Object.freeze([ x, y7, z2, inlinedVal13, w ])
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect [[1, undefined, undefined, [], 2], [1, 2, undefined, [], 3]]
[h(1, 2), h(1, 2, 3)]
//│ = [[1, undefined, undefined, [], 2], [1, 2, undefined, [], 3]]

:expect [[1, 2, 3, [], 4], [1, 2, 3, [4, 5], 6]]
[h(1, 2, 3, 4), h(1, 2, 3, 4, 5, 6)]
//│ = [[1, 2, 3, [], 4], [1, 2, 3, [4, 5], 6]]


// *** Explicit `undefined` arguments ***

// Arguments may be `undefined`, which is preserved, including for optional and trailing parameters.
:expect [1, [undefined], undefined]
f(1, undefined, undefined)
//│ = [1, [undefined], undefined]

:expect [1, undefined, undefined, [], 2]
h(1, undefined, 2)
//│ = [1, undefined, undefined, [], 2]

:expect [1, 2, undefined, [undefined], undefined]
h(1, 2, undefined, undefined, undefined)
//│ = [1, 2, undefined, [undefined], undefined]

:noInline
:expect [[undefined], undefined]
fun trailingNoInline(x, ...xs, y) = [xs, y]
trailingNoInline(1, undefined, undefined)
//│ = [[undefined], undefined]


// *** Spread arguments ***

:expect [1, [2, 3], 4]
let arr = [2, 3, 4]
f(1, ...arr)
//│ = [1, [2, 3], 4]
//│ arr = [2, 3, 4]

:expect [1, [2], 3]
f(...[1, 2], 3)
//│ = [1, [2], 3]

:expect [[1, 2], 3, 4]
g(...[1, 2, 3, 4])
//│ = [[1, 2], 3, 4]


// *** Resolution of trailing parameters ***

class A(val a: Int)
class B(val b: Int)

:expect 2
private fun lastA(...xs, y) = y.a
lastA(B(0), B(1), A(2))
//│ = 2

:e
private fun lastB(...xs, y) = y.b
lastB(B(0), A(1))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.129: 	private fun lastB(...xs, y) = y.b
//│ ║         	                              ^^^
//│ ╟── Instance of class 'A' does not contain member 'b'
//│ ║  l.130: 	lastB(B(0), A(1))
//│ ╙──       	            ^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// *** Function types and callbacks ***

fun app(f: (Int, ...Array[Int], Str) -> Str) = f(1, 2, 3, "a")

:expect "a"
app((x, ...xs, s) => s)
//│ = "a"

// A callback cannot discard a non-droppable rest parameter.
:e
app((x, s) => s)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.150: 	app((x, s) => s)
//│ ║         	^^^^^^^^^^^^^^^^
//│ ╟── Callback parameter list does not match its declared function type.
//│ ║  l.150: 	app((x, s) => s)
//│ ║         	    ^^^^^^^^^^^
//│ ╟── The expected function type is declared here.
//│ ║  l.142: 	fun app(f: (Int, ...Array[Int], Str) -> Str) = f(1, 2, 3, "a")
//│ ╙──       	           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = 2

// A callback may collect trailing arguments in its own rest parameter.
:expect "b"
app((x, ...xs) => "b")
//│ = "b"


// *** Optimizations ***

:expect 6
@tailrec fun sum(acc, ...xs, last) =
  if xs.length == 0 then acc + last else sum(acc + last, ...xs)
sum(0, 1, 2, 3)
//│ = 6

// Omitted optional arguments are `undefined`, even when their extraction is not inlined.
:noInline
:expect [1, undefined, [], 2]
fun h(x, y?, ...xs, w) = [x, y, xs, w]
h(1, 2)
//│ = [1, undefined, [], 2]

:noInline
:expect "none"
fun h(x, y?, ...xs, w) = if y is undefined then "none" else "some"
h(1, 2)
//│ = "none"

// Stack-safe resumption calls the function again with its saved arguments, which must include
// those of its rest parameter, including the arguments of the trailing parameters lowered into it.
:effectHandlers
:lift
:stackSafe 10
:expect [[1, 2], 3]
fun deep(n, ...xs, last) = if n == 0 then [xs, last] else deep(n - 1, ...xs, last)
deep(100, 1, 2, 3)
//│ = [[1, 2], 3]

:effectHandlers
:lift
:stackSafe 10
:expect [1, 2, 3]
fun deepRest(n, ...xs) = if n == 0 then xs else deepRest(n - 1, ...xs)
deepRest(100, 1, 2, 3)
//│ = [1, 2, 3]

:effectHandlers
:lift
:stackSafe 10
:expect [1, [], 2]
fun deepOpt(n, y?, ...xs, last) = if n == 0 then [y, xs, last] else deepOpt(n - 1, y, ...xs, last)
deepOpt(100, 1, 2)
//│ = [1, [], 2]


// *** Errors ***

:e
fun bad(...xs, ...ys) = 0
//│ ╔══[COMPILATION ERROR] A parameter list cannot have more than one variadic parameter.
//│ ║  l.219: 	fun bad(...xs, ...ys) = 0
//│ ╙──       	               ^^^^^

:e
fun bad(...xs, y?) = 0
//│ ╔══[COMPILATION ERROR] Optional parameters cannot follow a variadic parameter.
//│ ║  l.225: 	fun bad(...xs, y?) = 0
//│ ╙──       	               ^^

:e
fun bad(f: (...Array[Int], ...Array[Int]) -> Int) = 0
//│ ╔══[COMPILATION ERROR] A parameter list cannot have more than one variadic parameter.
//│ ║  l.231: 	fun bad(f: (...Array[Int], ...Array[Int]) -> Int) = 0
//│ ╙──       	                           ^^^^^^^^^^^^^

:e
fun bad(f: (...Array[Int], Int?) -> Int) = 0
//│ ╔══[COMPILATION ERROR] Optional parameters cannot follow a variadic parameter.
//│ ║  l.237: 	fun bad(f: (...Array[Int], Int?) -> Int) = 0
//│ ╙──       	                           ^^^^

:e
class C(x, ...xs, y)
//│ ╔══[COMPILATION ERROR] Spread parameters are not supported in class parameters.
//│ ║  l.243: 	class C(x, ...xs, y)
//│ ╙──       	           ^^^^^
