:.
open annotations


// *** Variadic parameters followed by trailing parameters ***

:sjs
fun f(x, ...xs, y) = [x, xs, y]
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f;
//│ f = function f(x, ...args) {
//│   let y, inlinedVal, tmp, tmp1;
//│   tmp1 = 1 + args.length;
//│   runtime.checkArgs("f", 2, tmp1);
//│   tmp = args.length - 1;
//│   inlinedVal = runtime.safeCall(args.slice(0, tmp));
//│   y = runtime.Tuple.get(args, -1);
//│   return globalThis.Object.freeze([ x, inlinedVal, y ])
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect [[1, [], 2], [1, [2], 3], [1, [2, 3], 4]]
[f(1, 2), f(1, 2, 3), f(1, 2, 3, 4)]
//│ = [[1, [], 2], [1, [2], 3], [1, [2, 3], 4]]

:e
f(1)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.27: 	f(1)
//│ ║        	^^^^
//│ ╟── Function 'f' expected at least 2 arguments, but got 1
//│ ║  l.8: 	fun f(x, ...xs, y) = [x, xs, y]
//│ ╙──     	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected at least 2 arguments but got 1

fun g(...xs, y, z) = [xs, y, z]

:expect [[[], 1, 2], [[1, 2], 3, 4]]
[g(1, 2), g(1, 2, 3, 4)]
//│ = [[[], 1, 2], [[1, 2], 3, 4]]

:expect [1, [2], 3]
((x, ...xs, y) => [x, xs, y])(1, 2, 3)
//│ = [1, [2], 3]


// *** Optional parameters before a variadic parameter ***

// The required parameters take the first and last arguments, the optional ones
// take the remaining ones from left to right, and the variadic one takes the rest.
:sjs
fun h(x, y?, z?, ...xs, w) = [x, y, z, xs, w]
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let h;
//│ h = function h(x, ...args7) {
//│   let w, inlinedVal12, inlinedVal13, inlinedVal14, tmp14, scrut, tmp15, scrut1, tmp16, tmp17;
//│   tmp17 = 1 + args7.length;
//│   runtime.checkArgs("h", 2, tmp17);
//│   tmp16 = args7.length - 1;
//│   scrut1 = 0 < tmp16;
//│   if (scrut1 === true) {
//│     inlinedVal12 = args7.at(0);
//│   } else {
//│     inlinedVal12 = undefined;
//│   }
//│   tmp15 = args7.length - 1;
//│   scrut = 1 < tmp15;
//│   if (scrut === true) {
//│     inlinedVal13 = args7.at(1);
//│   } else {
//│     inlinedVal13 = undefined;
//│   }
//│   tmp14 = args7.length - 1;
//│   inlinedVal14 = runtime.safeCall(args7.slice(2, tmp14));
//│   w = runtime.Tuple.get(args7, -1);
//│   return globalThis.Object.freeze([ x, inlinedVal12, inlinedVal13, inlinedVal14, w ])
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect [[1, undefined, undefined, [], 2], [1, 2, undefined, [], 3]]
[h(1, 2), h(1, 2, 3)]
//│ = [[1, undefined, undefined, [], 2], [1, 2, undefined, [], 3]]

:expect [[1, 2, 3, [], 4], [1, 2, 3, [4, 5], 6]]
[h(1, 2, 3, 4), h(1, 2, 3, 4, 5, 6)]
//│ = [[1, 2, 3, [], 4], [1, 2, 3, [4, 5], 6]]


// *** Spread arguments ***

:expect [1, [2, 3], 4]
let arr = [2, 3, 4]
f(1, ...arr)
//│ = [1, [2, 3], 4]
//│ arr = [2, 3, 4]

:expect [1, [2], 3]
f(...[1, 2], 3)
//│ = [1, [2], 3]

:expect [[1, 2], 3, 4]
g(...[1, 2, 3, 4])
//│ = [[1, 2], 3, 4]


// *** Resolution of trailing parameters ***

class A(val a: Int)
class B(val b: Int)

:expect 2
private fun lastA(...xs, y) = y.a
lastA(B(0), B(1), A(2))
//│ = 2

:e
private fun lastB(...xs, y) = y.b
lastB(B(0), A(1))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.117: 	private fun lastB(...xs, y) = y.b
//│ ║         	                              ^^^
//│ ╟── Instance of class 'A' does not contain member 'b'
//│ ║  l.118: 	lastB(B(0), A(1))
//│ ╙──       	            ^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// *** Function types and callbacks ***

fun app(f: (Int, ...Array[Int], Str) -> Str) = f(1, 2, 3, "a")

:expect "a"
app((x, ...xs, s) => s)
//│ = "a"

// Trailing parameters receive the last arguments, so callbacks must have the same structure.
:e
app((x, s) => s)
//│ ╔══[COMPILATION ERROR] Resolution error in function type
//│ ║  l.130: 	fun app(f: (Int, ...Array[Int], Str) -> Str) = f(1, 2, 3, "a")
//│ ║         	           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Callback parameter list does not match its declared function type.
//│ ║  l.138: 	app((x, s) => s)
//│ ╙──       	    ^^^^^^^^^^^
//│ = 2

:e
app((x, ...xs) => "b")
//│ ╔══[COMPILATION ERROR] Resolution error in function type
//│ ║  l.130: 	fun app(f: (Int, ...Array[Int], Str) -> Str) = f(1, 2, 3, "a")
//│ ║         	           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Callback parameter list does not match its declared function type.
//│ ║  l.148: 	app((x, ...xs) => "b")
//│ ╙──       	    ^^^^^^^^^^^^^^^^^
//│ = "b"


// *** Optimizations ***

:expect 6
@tailrec fun sum(acc, ...xs, last) =
  if xs.length == 0 then acc + last else sum(acc + last, ...xs)
sum(0, 1, 2, 3)
//│ = 6


// *** Errors ***

:e
fun bad(...xs, ...ys) = 0
//│ ╔══[COMPILATION ERROR] A parameter list cannot have more than one variadic parameter.
//│ ║  l.170: 	fun bad(...xs, ...ys) = 0
//│ ╙──       	               ^^^^^

:e
fun bad(...xs, y?) = 0
//│ ╔══[COMPILATION ERROR] Optional parameters cannot follow a variadic parameter.
//│ ║  l.176: 	fun bad(...xs, y?) = 0
//│ ╙──       	               ^^

:e
fun bad(f: (...Array[Int], ...Array[Int]) -> Int) = 0
//│ ╔══[COMPILATION ERROR] A parameter list cannot have more than one variadic parameter.
//│ ║  l.182: 	fun bad(f: (...Array[Int], ...Array[Int]) -> Int) = 0
//│ ╙──       	                           ^^^^^^^^^^^^^

:e
fun bad(f: (...Array[Int], Int?) -> Int) = 0
//│ ╔══[COMPILATION ERROR] Optional parameters cannot follow a variadic parameter.
//│ ║  l.188: 	fun bad(f: (...Array[Int], Int?) -> Int) = 0
//│ ╙──       	                           ^^^^

:e
class C(x, ...xs, y)
//│ ╔══[COMPILATION ERROR] Spread parameters are not supported in class parameters.
//│ ║  l.194: 	class C(x, ...xs, y)
//│ ╙──       	           ^^^^^
