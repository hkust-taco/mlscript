:.

// An empty declaration still has a source span.
:e
module Empty
Empty.missing
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.6: 	Empty.missing
//│ ║       	^^^^^^^^^^^^^
//│ ╟── Module 'Empty' does not contain member 'missing'
//│ ║  l.5: 	module Empty
//│ ╙──     	       ^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A member annotation must not become the enclosing module's location.
:e
module Container with
  declare fun text(): Str
Container.missing
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.19: 	Container.missing
//│ ║        	^^^^^^^^^^^^^^^^^
//│ ╟── Module 'Container' does not contain member 'missing'
//│ ║  l.17: 	module Container with
//│ ╙──      	       ^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Nested declarations retain their own spans.
:e
module Outer with
  module Inner with
    declare fun text(): Str
Outer.Inner.missing
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.33: 	Outer.Inner.missing
//│ ║        	^^^^^^^^^^^^^^^^^^^
//│ ╟── Module 'Inner' does not contain member 'missing'
//│ ║  l.31: 	  module Inner with
//│ ╙──      	         ^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A nominal annotation continues to point at the use of the type.
:e
class Base with
  declare fun text(): Str
fun hidden(value: Base) = value.missing
hidden(new Base)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.46: 	fun hidden(value: Base) = value.missing
//│ ║        	                          ^^^^^^^^^^^^^
//│ ╟── Value of type 'Base' does not contain member 'missing'
//│ ║  l.46: 	fun hidden(value: Base) = value.missing
//│ ╙──      	                  ^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// The receiver inside a class uses the declaration, including its name and body.
:e
class Receiver with
  declare fun text(): Str
  fun inspect() = this.missing
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.60: 	  fun inspect() = this.missing
//│ ║        	                  ^^^^^^^^^^^^
//│ ╟── Class definition 'Receiver' does not contain member 'missing'
//│ ║  l.58: 	class Receiver with
//│ ║        	^^^^^^^^^^^^^^^^^^^
//│ ║  l.59: 	  declare fun text(): Str
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.60: 	  fun inspect() = this.missing
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

// Parameterized classes likewise use the written declaration, not only its fields.
:e
class Parameterized(value: Int) with
  fun inspect() = this.missing
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.75: 	  fun inspect() = this.missing
//│ ║        	                  ^^^^^^^^^^^^
//│ ╟── Class definition 'Parameterized' does not contain member 'missing'
//│ ║  l.74: 	class Parameterized(value: Int) with
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.75: 	  fun inspect() = this.missing
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

// A class without fields has a declaration location even in pattern diagnostics.
:e
class Empty
if new Empty is Empty(_) then 1 else 0
//│ ╔══[COMPILATION ERROR] Resolution error in constructor
//│ ║  l.88: 	if new Empty is Empty(_) then 1 else 0
//│ ║        	                ^^^^^^^^
//│ ╟── Class definition 'Empty' does not take pattern arguments.
//│ ║  l.87: 	class Empty
//│ ╙──      	^^^^^^^^^^^
//│ = 0
