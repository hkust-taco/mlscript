:.

// An empty declaration still has a source span.
:e
module Empty
Empty.missing
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	Empty.missing
//│ ║        	^^^^^^^^^^^^^
//│ ╟── Module 'Empty' does not contain member 'missing'
//│ ║  l.+1: 	module Empty
//│ ╙──      	^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A member annotation must not become the enclosing module's location.
:e
module Container with
  declare fun text(): Str
Container.missing
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+3: 	Container.missing
//│ ║        	^^^^^^^^^^^^^^^^^
//│ ╟── Module 'Container' does not contain member 'missing'
//│ ║  l.+1: 	module Container with
//│ ╙──      	^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Nested declarations retain their own spans.
:e
module Outer with
  module Inner with
    declare fun text(): Str
Outer.Inner.missing
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+4: 	Outer.Inner.missing
//│ ║        	^^^^^^^^^^^^^^^^^^^
//│ ╟── Module 'Inner' does not contain member 'missing'
//│ ║  l.+2: 	  module Inner with
//│ ╙──      	  ^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A nominal annotation continues to point at the use of the type.
:e
class Base with
  declare fun text(): Str
fun hidden(value: Base) = value.missing
hidden(new Base)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+3: 	fun hidden(value: Base) = value.missing
//│ ║        	                          ^^^^^^^^^^^^^
//│ ╟── Value of type 'Base' does not contain member 'missing'
//│ ║  l.+3: 	fun hidden(value: Base) = value.missing
//│ ╙──      	                  ^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// The receiver inside a class uses the declaration's header, without its body.
:e
class Receiver with
  declare fun text(): Str
  fun inspect() = this.missing
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+3: 	  fun inspect() = this.missing
//│ ║        	                  ^^^^^^^^^^^^
//│ ╟── Class definition 'Receiver' does not contain member 'missing'
//│ ║  l.+1: 	class Receiver with
//│ ╙──      	^^^^^^^^^^^^^^

// Parameterized classes likewise use the written header, not only its fields.
:e
class Parameterized(value: Int) with
  fun inspect() = this.missing
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	  fun inspect() = this.missing
//│ ║        	                  ^^^^^^^^^^^^
//│ ╟── Class definition 'Parameterized' does not contain member 'missing'
//│ ║  l.+1: 	class Parameterized(value: Int) with
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

// A class without fields has a declaration location even in pattern diagnostics.
:e
class Empty
if new Empty is Empty(_) then 1 else 0
//│ ╔══[COMPILATION ERROR] Resolution error in constructor
//│ ║  l.+2: 	if new Empty is Empty(_) then 1 else 0
//│ ║        	                ^^^^^^^^
//│ ╟── Class definition 'Empty' does not take pattern arguments.
//│ ║  l.+1: 	class Empty
//│ ╙──      	^^^^^^^^^^^
//│ = 0


// Diagnostics citing a class show its header: its modifiers, type and value
// parameters, and parent clause, but neither its annotations, body, nor companions.
object note

:w
@note
data class Pair[A](a: A, b: Int) extends Base with
  fun first = a
  fun second = b
module Pair with
  fun make(a) = Pair(a, 0)
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	@note
//│ ╙──      	^^^^^
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	@note
//│ ╙──      	^^^^^

:e
Pair(1)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+1: 	Pair(1)
//│ ║        	^^^^^^^
//│ ╟── Constructor of class 'Pair' expected 2 arguments, but got 1
//│ ║  l.XX: 	data class Pair[A](a: A, b: Int) extends Base with
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = Pair(1, undefined)

:e
Pair[Int, Int](1, 2)
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.+1: 	Pair[Int, Int](1, 2)
//│ ║        	^^^^^^^^^^^^^^
//│ ╟── Constructor of class 'Pair' expected 1 type argument, but got 2
//│ ║  l.XX: 	data class Pair[A](a: A, b: Int) extends Base with
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = Pair(1, 2)

:e
if Pair(1, 2) is Pair(x) then x
//│ ╔══[COMPILATION ERROR] Resolution error in constructor
//│ ║  l.+1: 	if Pair(1, 2) is Pair(x) then x
//│ ║        	                 ^^^^^^^
//│ ╟── Class definition 'Pair' expected 2 pattern arguments, but got 1
//│ ║  l.XX: 	data class Pair[A](a: A, b: Int) extends Base with
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] Error: match error

:e
Pair(1, 2).missing
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+1: 	Pair(1, 2).missing
//│ ║        	^^^^^^^^^^^^^^^^^^
//│ ╟── Instance of class 'Pair' does not contain member 'missing'
//│ ║  l.+1: 	Pair(1, 2).missing
//│ ╙──      	^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A `declare` modifier is part of the header.
:e
:re
declare class Declared(val length: Int) with
  fun reverse(): Declared
Declared()
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+3: 	Declared()
//│ ║        	^^^^^^^^^^
//│ ╟── Constructor of class 'Declared' expected 1 argument, but got 0
//│ ║  l.+1: 	declare class Declared(val length: Int) with
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] TypeError: globalThis.Declared is not a function

// Arity errors also cite the `constructor(...)` declarations, which the header does not show.
:e
class Constructed with
  constructor(x, y)
  fun f = 1
new Constructed(1)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+4: 	new Constructed(1)
//│ ║        	^^^^^^^^^^^^^^^^^^
//│ ╟── Constructor of class 'Constructed' expected 2 arguments, but got 1
//│ ║  l.+1: 	class Constructed with
//│ ║        	^^^^^^^^^^^^^^^^^
//│ ╟── The constructor is declared here.
//│ ║  l.+2: 	  constructor(x, y)
//│ ╙──      	  ^^^^^^^^^^^^^^^^^
//│ = Constructed

// Type alias and pattern headers exclude their right-hand sides.
:e
type Alias[A] = Pair[A]
fun excess(value: Alias[Int, Str]) = ()
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.+2: 	fun excess(value: Alias[Int, Str]) = ()
//│ ║        	                  ^^^^^^^^^^^^^^^
//│ ╟── Type 'Alias' accepts at most 1 type argument, but got 2.
//│ ║  l.+2: 	fun excess(value: Alias[Int, Str]) = ()
//│ ║        	                  ^^^^^^^^^^^^^^^
//│ ╟── The type parameters are declared here.
//│ ║  l.+1: 	type Alias[A] = Pair[A]
//│ ╙──      	^^^^^^^^^^^^

:e
pattern Small(n) = n & (0 | 1 | 2)
Small(1)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+2: 	Small(1)
//│ ║        	^^^^^^^^
//│ ╟── Pattern 'Small' cannot be called like a function.
//│ ║  l.+1: 	pattern Small(n) = n & (0 | 1 | 2)
//│ ╙──      	^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:e
Constructed.missing
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+1: 	Constructed.missing
//│ ║        	^^^^^^^^^^^^^^^^^^^
//│ ╟── Class value does not contain member 'missing'
//│ ║  l.XX: 	class Constructed with
//│ ╙──      	^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:e
class Mixed(a) with
  fun f = 1
  constructor(x, y)
new Mixed(1)(2)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+4: 	new Mixed(1)(2)
//│ ║        	^^^^^^^^^^^^^^^
//│ ╟── Constructor of class 'Mixed' expected 2 arguments, but got 1
//│ ║  l.+1: 	class Mixed(a) with
//│ ║        	^^^^^^^^^^^^^^
//│ ╟── The constructor is declared here.
//│ ║  l.+3: 	  constructor(x, y)
//│ ╙──      	  ^^^^^^^^^^^^^^^^^
//│ = Mixed(_)

// The classes of ADT constructors are located at their own declarations,
// rather than spanning the enclosing class whose modifiers they reuse.
:e
abstract class IntList with
  constructor
    Nil
    Cons(x: Int, xs: IntList)
Cons(1)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+5: 	Cons(1)
//│ ║        	^^^^^^^
//│ ╟── Constructor of class 'Cons' expected 2 arguments, but got 1
//│ ║  l.+4: 	    Cons(x: Int, xs: IntList)
//│ ╙──      	    ^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Cannot instantiate abstract class 'Cons'
//│ ║  l.+5: 	Cons(1)
//│ ║        	^^^^^^^
//│ ╟── Abstract class defined here
//│ ║  l.+4: 	    Cons(x: Int, xs: IntList)
//│ ╙──      	    ^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:e
class Opt[T] with
  constructor
    None
    Some(x: T)
Some(1, 2)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+5: 	Some(1, 2)
//│ ║        	^^^^^^^^^^
//│ ╟── Constructor of class 'Some' expected 1 argument, but got 2
//│ ║  l.+4: 	    Some(x: T)
//│ ╙──      	    ^^^^^^^^^
//│ = Some(1)

// Diagnostics citing a function likewise show only its header.
:e
fun twice(f: Int -> Int, x: Int): Int =
  let y = f(x)
  f(y)
twice(x => x + 1)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+4: 	twice(x => x + 1)
//│ ║        	^^^^^^^^^^^^^^^^^
//│ ╟── Function 'twice' expected 2 arguments, but got 1
//│ ║  l.+1: 	fun twice(f: Int -> Int, x: Int): Int =
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] Error: Function 'twice' expected at least 2 arguments but got 1

// So do those citing a member, such as an exposed function with an unknown parameter.
:e
fun exposed(f) =
  let y = f(0)
  y
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+2: 	  let y = f(0)
//│ ║        	          ^^^^
//│ ╟── Value of unknown shape cannot be called like a function.
//│ ╟── Parameter 'f' admits values of unknown shape.
//│ ║  l.+1: 	fun exposed(f) =
//│ ║        	            ^
//│ ╟── 'exposed' is exposed by this compilation unit.
//│ ║  l.+1: 	fun exposed(f) =
//│ ╙──      	^^^^^^^^^^^^^^

:e
:re
declare fun declared(x: Int): Int
declared(1, 2)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+2: 	declared(1, 2)
//│ ║        	^^^^^^^^^^^^^^
//│ ╟── Function 'declared' expected 1 argument, but got 2
//│ ║  l.+1: 	declare fun declared(x: Int): Int
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] TypeError: globalThis.declared is not a function

// An `open` modifier is located at its whole statement; only its start belongs to the header.
:e
class Opened with
  open fun f(x) =
    x + 1
    x + 2
new Opened().f(1, 2)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+5: 	new Opened().f(1, 2)
//│ ║        	^^^^^^^^^^^^^^^^^^^^
//│ ╟── Function 'f' expected 1 argument, but got 2
//│ ║  l.+2: 	  open fun f(x) =
//│ ╙──      	  ^^^^^^^^^^^^^
//│ = 3

// Each call cites the unknown parameter's declaration without repeating the callee span.
:e
fun invokeAtEachUse(f) =
  let alias = f
  f()
  alias()
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+4: 	  alias()
//│ ║        	  ^^^^^^^
//│ ╟── Value of unknown shape cannot be called like a function.
//│ ╟── Parameter 'f' admits values of unknown shape.
//│ ║  l.+1: 	fun invokeAtEachUse(f) =
//│ ║        	                    ^
//│ ╟── 'invokeAtEachUse' is exposed by this compilation unit.
//│ ║  l.+1: 	fun invokeAtEachUse(f) =
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+3: 	  f()
//│ ║        	  ^^^
//│ ╟── Value of unknown shape cannot be called like a function.
//│ ╟── Parameter 'f' admits values of unknown shape.
//│ ║  l.+1: 	fun invokeAtEachUse(f) =
//│ ║        	                    ^
//│ ╟── 'invokeAtEachUse' is exposed by this compilation unit.
//│ ║  l.+1: 	fun invokeAtEachUse(f) =
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^
