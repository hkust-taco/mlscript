//│ ║         	               ^
//│ ╟── Parameter 'f' admits values of unknown shape.
//│ ║  l.278: 	fun invokeRest(f, x, ...tail) = f()
//│ ║         	               ^
//│ ╟── 'invokeRest' is exposed by this compilation unit.
//│ ║  l.278: 	fun invokeRest(f, x, ...tail) = f()
//│ ╙──       	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = 97

// When repeatedTuples receives [Box(98)], both a and b must acquire its element
// shape so that both `.value` selections resolve. Although the tuple expressions
// have equal syntax, resolving a does not notify the listeners attached to b.
:expect [98, 98]
private fun repeatedTuples(xs) =
  let a = [0, ...xs]
  let b = [0, ...xs]
  [second(...a).value, second(...b).value]
repeatedTuples([Box(98)])
//│ = [98, 98]

// A public callback signature supplies the callable interface even for an opaque spread.
:expect 97
fun invokeAnnotatedRest(f: () -> Int, x, ...tail) = f()
invokeAnnotatedRest(...opaque([() => 97]), Box(0))
//│ = 97

// Array element annotations survive spreads; their length remains unknown.
:expect 97
let callbacks = new mut Array[() -> Int](0)
callbacks.push(() => 97)
private fun invokeTypedRest(f, x, ...tail) = f()
invokeTypedRest(...callbacks, Box(0))
//│ = 97
//│ callbacks = [fun]

// A public unannotated callback is checked for unknown callers despite a typed local call.
:e
fun invokePublicRest(f, x, ...tail) = f()
invokePublicRest(...callbacks, Box(0))
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.322: 	fun invokePublicRest(f, x, ...tail) = f()
//│ ║         	                                      ^^^
//│ ╟── Value of unknown shape cannot be called like a function.
//│ ║  l.322: 	fun invokePublicRest(f, x, ...tail) = f()
//│ ║         	                     ^
//│ ╟── Parameter 'f' admits values of unknown shape.
//│ ║  l.322: 	fun invokePublicRest(f, x, ...tail) = f()
//│ ║         	                     ^
//│ ╟── 'invokePublicRest' is exposed by this compilation unit.
//│ ║  l.322: 	fun invokePublicRest(f, x, ...tail) = f()
//│ ╙──       	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = 97

// A function parameter's Array annotation carries its element interface through a spread.
:expect 97
fun invokeArray(xs: Array[() -> Int]) =
  private fun invoke(f, x, ...tail) = f()
  invoke(...xs, Box(0))
invokeArray(callbacks)
//│ = 97

// A private tuple-based call can infer the callback directly.
:expect 98
private fun invokeTuple(f, x, ...tail) = f()
invokeTuple(...[() => 98], Box(0))
//│ = 98

// Aliases and nested tuple elements retain their declared shapes through rest forwarding.
:expect 42
class Item(val value: Int)
type Pairs[T] = Array[[T, Int]]
private fun first(head, ...tail) = head
private fun skip(head, ...tail) = first(...tail)
fun readPairs(xs: Pairs[Item]) = skip(0, ...xs).0.value
readPairs([[Item(42), 1]])
//│ = 42

// Annotating an array with a base element type must hide subclass-only members.
:ge
class Base
class Child extends Base with
  val extra = 42
fun readBase(xs: Array[Base]) = first(...xs).extra
readBase([new Child])
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.367: 	fun readBase(xs: Array[Base]) = first(...xs).extra
//│ ║         	                                ^^^^^^^^^^^^^^^^^^
//│ ╙── Value of type 'Base' does not contain member 'extra'
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Different type arguments keep distinct element interfaces at their call sites.
:expect [41, 42]
class Left(val left: Int)
class Right(val right: Int)
fun head[A](xs: Array[A]): A = first(...xs)
[head[Left]([Left(41)]).left, head[Right]([Right(42)]).right]
//│ = [41, 42]

// Constructor type arguments are scoped to each array allocation.
:expect [43, 44]
let lefts = new mut Array[Left](0)
let rights = new mut Array[Right](0)
lefts.push(Left(43))
rights.push(Right(44))
[first(...lefts).left, first(...rights).right]
//│ = [43, 44]
//│ lefts = [Left(43)]
//│ rights = [Right(44)]

// An unannotated allocation cannot borrow another array's element type or its pushed values.
:e
let unknownCallbacks = new mut Array(0)
unknownCallbacks.push(() => 99)
private fun invokeUnannotatedArray(f, ...tail) = f()
invokeUnannotatedArray(...unknownCallbacks)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.398: 	private fun invokeUnannotatedArray(f, ...tail) = f()
//│ ║         	                                                 ^^^
//│ ╟── Value of unknown shape cannot be called like a function.
//│ ║  l.399: 	invokeUnannotatedArray(...unknownCallbacks)
//│ ║         	                          ^^^^^^^^^^^^^^^^
//│ ╟── This spread has no known element shape.
//│ ║  l.399: 	invokeUnannotatedArray(...unknownCallbacks)
//│ ╙──       	                          ^^^^^^^^^^^^^^^^
//│ = 99
//│ unknownCallbacks = [fun]

