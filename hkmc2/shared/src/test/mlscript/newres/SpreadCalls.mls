// Rest arity may be valid while the callable argument remains unknown.
:e
fun invokeRest(f, x, ...tail) = f()
invokeRest(...opaque([() => 97]), Box(0))
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.278: 	fun invokeRest(f, x, ...tail) = f()
