// Passing an allocation through a private parameter preserves its declared element type.
:expect [43, 44]
private fun localFirstInArray(xs) =
  private fun head(x, ...tail) = x
  head(...xs)
[localFirstInArray(lefts).left, localFirstInArray(rights).right]
//│ = [43, 44]
