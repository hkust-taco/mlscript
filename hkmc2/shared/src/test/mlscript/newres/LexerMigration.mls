:.

// Explicit imports override the builtin unary ~ under the new open semantics.
:expect "ab"
module Strings with
  fun (~) concat(left: Str, right: Str): Str = left + right
open Strings { concat, ~ }
"a" ~ "b"
//│ = "ab"

// Token's factory methods receive their trailing contextual argument from the lexical scope.
:expect 5
class Context(val value: Int)
private fun make(value: Int)(using context: Context): Int = value + context.value
using Context = Context(2)
make(3)
//│ = 5
