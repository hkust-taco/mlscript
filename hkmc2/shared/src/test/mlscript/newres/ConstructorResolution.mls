// Pattern parameters preserve the caller's selected constructor interpretation.
:expect [1, 0]
pattern Identity(pattern P) = P
fun parameterized(x) = {
  open Constructors
  if x is Identity(Token) then 1 else 0
}
[parameterized(new Constructors.Token), parameterized(0)]
//│ = [1, 0]
