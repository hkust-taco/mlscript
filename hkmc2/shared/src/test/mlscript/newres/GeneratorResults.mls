:.

// A generator call returns an iterator even when its body returns a literal.
@annotations.generator
fun generated() = 1

:expect {value: 1, done: true}
generated().next()
//│ = {value: 1, done: true}


// The callable's representation is the iterator; the body's result is only the payload
// of the final step. Bindings of the call therefore hold an iterator, not an integer.
:sir
:siret
@annotations.generator
fun counted(): Int =
  yield 0
  1
let iterator = counted()
iterator.next()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @generator
//│ define counted⁰ as fun counted¹(): Iterator⁰ {
//│   do yield⁰(0);
//│   return 1
//│ };
//│ set iterator⁰ = counted¹();
//│ return iterator⁰.next⁰()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = {value: 0, done: false}
//│ iterator =  {}
