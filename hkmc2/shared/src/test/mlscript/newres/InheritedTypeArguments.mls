:.

// Control: an exact nominal match transfers the supplied argument to read's A.
:expect 1
class Item(val value: Int)
class Parent[A](val item: A)
private fun read[A](parent: Parent[A]) = parent.item
read(new Parent[Item](Item(1))).value
//│ = 1

// FIXME: A constructed subclass must transfer its instantiated Parent argument.
// The field signature is complete, so this does not require inferring members.
:fixme
:expect 2
class Item(val value: Int)
class Parent[A](val item: A)
class Child[A](item: A) extends Parent[A](item)
private fun read[A](parent: Parent[A]) = parent.item
read(new Child[Item](Item(2))).value
