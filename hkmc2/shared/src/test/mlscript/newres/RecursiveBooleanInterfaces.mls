// Negation is a Boolean operation, not a structural guard, even though the
// current resolver otherwise treats negated interfaces as opaque.
:e
type Loop = ~Loop
//│ ╔══[COMPILATION ERROR] Resolution error in negation type
//│ ║  l.+1: 	type Loop = ~Loop
//│ ║        	            ^^^^^
//│ ╟── Unguarded recursive type alias 'Loop'.
//│ ║  l.+1: 	type Loop = ~Loop
//│ ║        	             ^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+1: 	type Loop = ~Loop
//│ ╙──      	     ^^^^

:e
type Negated[A] = ~A
type Loop = Negated[Loop]
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.+2: 	type Loop = Negated[Loop]
//│ ║        	            ^^^^^^^^^^^^^
//│ ╟── Unguarded recursive type alias 'Loop'.
//│ ║  l.+2: 	type Loop = Negated[Loop]
//│ ║        	                    ^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+2: 	type Loop = Negated[Loop]
//│ ╙──      	     ^^^^

// Keeping negation's source dependencies does not reject nonrecursive types.
type NotInt = ~Int
private fun unused(x: NotInt) = ()

// A constructor underneath negation still guards its recursive reference.
type Loop = ~([Loop])
private fun unused(x: Loop) = ()

// A bound on a quantified parameter is not a structural guard.
:e
type Loop = [A extends Loop] -> A
//│ ╔══[COMPILATION ERROR] Resolution error in universal quantification
//│ ║  l.+1: 	type Loop = [A extends Loop] -> A
//│ ║        	                                ^
//│ ╟── Unguarded recursive type alias 'Loop'.
//│ ║  l.+1: 	type Loop = [A extends Loop] -> A
//│ ║        	                       ^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+1: 	type Loop = [A extends Loop] -> A
//│ ╙──      	     ^^^^

// Wildcard bounds are transparent, including through a forwarding alias.
:e
type Identity[A] = A
type Loop = Identity[out Loop]
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.+2: 	type Loop = Identity[out Loop]
//│ ║        	            ^^^^^^^^^^^^^^^^^^
//│ ╟── Unguarded recursive type alias 'Loop'.
//│ ║  l.+2: 	type Loop = Identity[out Loop]
//│ ║        	                         ^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+2: 	type Loop = Identity[out Loop]
//│ ╙──      	     ^^^^

// Applying an abstract type parameter supplies no known structural guard.
:e
type Apply[F, A] = F[A]
type Identity[A] = A
type Loop = Apply[Identity, Loop]
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.+3: 	type Loop = Apply[Identity, Loop]
//│ ║        	            ^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Unguarded recursive type alias 'Loop'.
//│ ║  l.+3: 	type Loop = Apply[Identity, Loop]
//│ ║        	                            ^^^^
