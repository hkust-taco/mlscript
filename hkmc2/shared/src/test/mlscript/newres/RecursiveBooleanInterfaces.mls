// A forward reference must resolve before formal-use summaries are finalized.
:e
type Loop = Forward[Loop]
type Forward[A] = Identity[A]
type Identity[A] = A
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.+1: 	type Loop = Forward[Loop]
//│ ║        	            ^^^^^^^^^^^^^
//│ ╟── Unguarded recursive type alias 'Loop'.
//│ ║  l.+1: 	type Loop = Forward[Loop]
//│ ║        	                    ^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+1: 	type Loop = Forward[Loop]
//│ ╙──      	     ^^^^

// Growing arguments do not guard a recursive alias application.
:e
type Loop[A] = Loop[Array[A]]
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.+1: 	type Loop[A] = Loop[Array[A]]
//│ ║        	               ^^^^^^^^^^^^^^
//│ ╟── Unguarded recursive type alias 'Loop'.
//│ ║  l.+1: 	type Loop[A] = Loop[Array[A]]
//│ ║        	               ^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+1: 	type Loop[A] = Loop[Array[A]]
//│ ╙──      	     ^^^^

// Guards may appear in a wrapper alias, including one declared later.
type Loop = Wrap[Loop]
type Wrap[A] = {next: A}
private fun walk(x: Loop) = x.next.next

type Wrap[A] = [A]
type Loop = Wrap[Loop]
private fun walk(x: Loop) = x.0.0

type Wrap[A] = () -> A
type Loop = Wrap[Loop]
private fun walk(x: Loop) = x()()

class Box[A](val value: A)
type Loop = Box[Loop]
private fun walk(x: Loop) = x.value.value

// A mutual cycle with a structural guard is valid.
type Left = Right
type Right = {next: Left}
private fun walk(x: Left) = x.next.next

// Reusing an identity alias in a finite expression is not recursive.
:expect 2
class Item(val value: Int)
type Identity[A] = A
type Twice[A] = Identity[Identity[A]]
private fun read(x: Twice[Item]) = x.value
read(Item(2))
//│ = 2

// An unused actual argument cannot introduce a cycle into the expanded alias.
:expect 3
class Item(val value: Int)
type Ignore[A] = Item
type Loop = Ignore[Loop]
private fun read(x: Loop) = x.value
read(Item(3))
//│ = 3

// Forwarded parameter uses must be composed across multiple alias applications.
type Pair[A, B] = [B, A]
type Wrap[A] = Pair[Int, A]
type Loop = Wrap[Loop]
private fun walk(x: Loop) = x.0.0

// Unrelated guarded aliases in the same source graph remain usable.
:e
type Bad = Bad | Good
type Good = {next: Good}
private fun walk(x: Good) = x.next.next
//│ ╔══[COMPILATION ERROR] Resolution error in alternation
//│ ║  l.+1: 	type Bad = Bad | Good
//│ ║        	           ^^^^^^^^^^
//│ ╟── Unguarded recursive type alias 'Bad'.
//│ ║  l.+1: 	type Bad = Bad | Good
//│ ║        	           ^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+1: 	type Bad = Bad | Good
//│ ╙──      	     ^^^

// Quantification alone is not a structural guard.
:e
type Loop = [A] -> Loop
//│ ╔══[COMPILATION ERROR] Resolution error in universal quantification
//│ ║  l.+1: 	type Loop = [A] -> Loop
//│ ║        	                   ^^^^
//│ ╟── Unguarded recursive type alias 'Loop'.
//│ ║  l.+1: 	type Loop = [A] -> Loop
//│ ║        	                   ^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+1: 	type Loop = [A] -> Loop
//│ ╙──      	     ^^^^

// Function domains, as well as results, guard recursive references.
type Loop = Loop -> Int
private fun apply(f: Loop, x: Loop): Int = f(x)

// Guarded and unguarded uses of the same formal must both be considered.
:e
type MixedUse[A] = A | [A]
type Loop = MixedUse[Loop]
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.+2: 	type Loop = MixedUse[Loop]
//│ ║        	            ^^^^^^^^^^^^^^
//│ ╟── Unguarded recursive type alias 'Loop'.
//│ ║  l.+2: 	type Loop = MixedUse[Loop]
//│ ║        	                     ^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+2: 	type Loop = MixedUse[Loop]
//│ ╙──      	     ^^^^

// A forwarding alias may omit an unused parameter without introducing a guard.
:e
type First[A, B] = A
type Loop = First[Loop]
//│ ╔══[COMPILATION ERROR] Resolution error in type application
