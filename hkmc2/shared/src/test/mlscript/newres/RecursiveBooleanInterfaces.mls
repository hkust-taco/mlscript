:.

// Control: an ordinary forwarding alias preserves the declared interface.
:expect 1
class Item(val value: Int)
type Choice[A] = A
private fun read(x: Choice[Item]) = x.value
read(Item(1))
//│ = 1

// FIXME: A productive recursive union adds no unknown alternative. This
// predates Boolean normalization: the alias recursion guard publishes an opaque
// candidate alongside Item, preventing lookup even though the unfolding is finite.
:fixme
:expect 2
class Item(val value: Int)
type Choice[A] = A | Choice[A]
private fun read(x: Choice[Item]) = x.value
read(Item(2))
