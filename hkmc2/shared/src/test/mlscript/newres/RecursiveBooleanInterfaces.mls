:.

// An ordinary forwarding alias preserves the declared interface.
:expect 1
class Item(val value: Int)
type Choice[A] = A
private fun read(x: Choice[Item]) = x.value
read(Item(1))
//│ = 1

// Reject the definition itself, even when no value observes its interface.
:e
type Loop = Loop
//│ ╔══[COMPILATION ERROR] Resolution error in member reference
//│ ║  l.+1: 	type Loop = Loop
//│ ║        	            ^^^^
//│ ╟── Unguarded recursive type alias 'Loop'.
//│ ║  l.+1: 	type Loop = Loop
//│ ║        	            ^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+1: 	type Loop = Loop
//│ ╙──      	     ^^^^

:e
type Choice[A] = A | Choice[A]
//│ ╔══[COMPILATION ERROR] Resolution error in alternation
//│ ║  l.+1: 	type Choice[A] = A | Choice[A]
//│ ║        	                 ^^^^^^^^^^^^^
//│ ╟── Unguarded recursive type alias 'Choice'.
//│ ║  l.+1: 	type Choice[A] = A | Choice[A]
//│ ║        	                     ^^^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+1: 	type Choice[A] = A | Choice[A]
//│ ╙──      	     ^^^^^^

:e
type Choice[A] = A & Choice[A]
//│ ╔══[COMPILATION ERROR] Resolution error in composition
//│ ║  l.+1: 	type Choice[A] = A & Choice[A]
//│ ║        	                 ^^^^^^^^^^^^^
//│ ╟── Unguarded recursive type alias 'Choice'.
//│ ║  l.+1: 	type Choice[A] = A & Choice[A]
//│ ║        	                     ^^^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+1: 	type Choice[A] = A & Choice[A]
//│ ╙──      	     ^^^^^^

// Mutual recursion may cross several transparent aliases before cycling.
:e
type First = Second
type Second = Third
type Third = First
//│ ╔══[COMPILATION ERROR] Resolution error in member reference
//│ ║  l.+2: 	type Second = Third
//│ ║        	              ^^^^^
//│ ╟── Unguarded recursive type alias 'Second'.
//│ ║  l.+1: 	type First = Second
//│ ║        	             ^^^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+2: 	type Second = Third
//│ ╙──      	     ^^^^^^
//│ ╔══[COMPILATION ERROR] Resolution error in member reference
//│ ║  l.+1: 	type First = Second
//│ ║        	             ^^^^^^
//│ ╟── Unguarded recursive type alias 'First'.
//│ ║  l.+3: 	type Third = First
//│ ║        	             ^^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+1: 	type First = Second
//│ ╙──      	     ^^^^^
//│ ╔══[COMPILATION ERROR] Resolution error in member reference
//│ ║  l.+3: 	type Third = First
//│ ║        	             ^^^^^
//│ ╟── Unguarded recursive type alias 'Third'.
//│ ║  l.+2: 	type Second = Third
//│ ║        	              ^^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+3: 	type Third = First
//│ ╙──      	     ^^^^^

// A guarded branch does not guard a separate recursive alternative.
:e
type Mixed = ({next: Mixed} | Mixed)
//│ ╔══[COMPILATION ERROR] Resolution error in alternation
//│ ║  l.+1: 	type Mixed = ({next: Mixed} | Mixed)
//│ ║        	               ^^^^^^^^^^^^^^^^^^^^
//│ ╟── Unguarded recursive type alias 'Mixed'.
//│ ║  l.+1: 	type Mixed = ({next: Mixed} | Mixed)
//│ ║        	                              ^^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+1: 	type Mixed = ({next: Mixed} | Mixed)
//│ ╙──      	     ^^^^^

// Boolean absorption must not conceal a written unguarded cycle.
:e
type Hidden[A] = A | (A & Hidden[A])
//│ ╔══[COMPILATION ERROR] Resolution error in alternation
//│ ║  l.+1: 	type Hidden[A] = A | (A & Hidden[A])
//│ ║        	                 ^^^^^^^^^^^^^^^^^^
//│ ╟── Unguarded recursive type alias 'Hidden'.
//│ ║  l.+1: 	type Hidden[A] = A | (A & Hidden[A])
//│ ║        	                          ^^^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+1: 	type Hidden[A] = A | (A & Hidden[A])
//│ ╙──      	     ^^^^^^

// An enclosing constructor does not make an invalid alias definition valid.
:e
type Wrapper = {value: Loop}
type Loop = Loop
//│ ╔══[COMPILATION ERROR] Resolution error in member reference
//│ ║  l.+2: 	type Loop = Loop
//│ ║        	            ^^^^
//│ ╟── Unguarded recursive type alias 'Loop'.
//│ ║  l.+2: 	type Loop = Loop
//│ ║        	            ^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+2: 	type Loop = Loop
//│ ╙──      	     ^^^^

// Forwarding formals and captures remain transparent to the guardedness check.
:e
type Identity[A] = A
type Loop = Identity[Loop]
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.+2: 	type Loop = Identity[Loop]
//│ ║        	            ^^^^^^^^^^^^^^
//│ ╟── Unguarded recursive type alias 'Loop'.
//│ ║  l.+2: 	type Loop = Identity[Loop]
//│ ║        	                     ^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+2: 	type Loop = Identity[Loop]
//│ ╙──      	     ^^^^

:e
private fun local() =
  type Identity[A] = A
  type Loop = Identity[Loop]
  ()
//│ ╔══[COMPILATION ERROR] Resolution error in type application
