// Calling a nominal value points to the annotation that made it non-callable.
:ge
class Base
fun invoke(value: Base) = value()
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.218: 	fun invoke(value: Base) = value()
//│ ║         	                          ^^^^^^^
//│ ╟── Value of type 'Base' cannot be called like a function.
//│ ║  l.218: 	fun invoke(value: Base) = value()
//│ ╙──       	                  ^^^^

// Arity errors on a declared callback identify its function type.
:ge
fun invoke(callback: Int -> Int) = callback()
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.228: 	fun invoke(callback: Int -> Int) = callback()
//│ ║         	                                   ^^^^^^^^^^
//│ ╟── Function with a declared signature expected 1 argument, but got 0
//│ ║  l.228: 	fun invoke(callback: Int -> Int) = callback()
//│ ╙──       	                     ^^^^^^^^^^

// Type argument arity errors retain the same callback signature witness.
:ge
fun invoke(callback: Int -> Int) = callback[Int](0)
//│ ╔══[COMPILATION ERROR] Resolution error in type application
//│ ║  l.238: 	fun invoke(callback: Int -> Int) = callback[Int](0)
//│ ║         	                                   ^^^^^^^^^^^^^
//│ ╟── Function with a declared signature expected 0 type arguments, but got 1
//│ ║  l.238: 	fun invoke(callback: Int -> Int) = callback[Int](0)
//│ ╙──       	                     ^^^^^^^^^^

// A function interface also explains missing members on the callback itself.
:ge
fun inspect(callback: Int -> Int) = callback.missing
//│ ╔══[COMPILATION ERROR] Resolution error in selection
