//│ ╟── This negated type does not specify a member interface.
//│ ║  l.107: 	fun inspect(value: ~Int) = value.member
//│ ╙──       	                    ^^^

// Calling a value retains the same explanation as selecting its members.
:ge
class Item(val value: Int)
fun invoke(xs: Array[in Item]) = xs.0()
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.119: 	fun invoke(xs: Array[in Item]) = xs.0()
//│ ║         	                                 ^^^^^^
//│ ╟── Value with no known interface cannot be called like a function.
//│ ║  l.119: 	fun invoke(xs: Array[in Item]) = xs.0()
//│ ║         	                     ^^^^^^^
//│ ╟── This type argument specifies only an input bound.
//│ ║  l.119: 	fun invoke(xs: Array[in Item]) = xs.0()
//│ ║         	                     ^^^^^^^
//│ ╙── Values read through it have no output bound more specific than 'Any'.

// Shared argument types must not attribute a different declaration's variance.
:ge
class Item(val value: Int)
class Left[in L](val item: L)
class Right[in R](val item: R)
type Pair[A] = [Left[A], Right[A]]
let pair = ([new Left(Item(1)), new Right(Item(2))] as Pair[Item])
pair.1.item.value
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.138: 	pair.1.item.value
//│ ║         	^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'value' of a value with unknown shape.
//│ ╟── This type argument supplies only an input bound for 'R'.
//│ ║  l.137: 	let pair = ([new Left(Item(1)), new Right(Item(2))] as Pair[Item])
//│ ║         	                                                            ^^^^
//│ ╟── Type parameter 'R' is declared contravariant here.
//│ ║  l.135: 	class Right[in R](val item: R)
//│ ║         	               ^
//│ ╙── Values read through it have no output bound more specific than 'Any'.
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ pair = [Left(Item(1)), Right(Item(2))]

// Capturing and returning a typed value preserves the selected parameter's witness.
:ge
class Item(val value: Int)
class Left[in L](val item: L)
class Right[in R](val item: R)
type Pair[A] = [Left[A], Right[A]]
private fun delay[A](value: A) = () => value
let pair = ([new Left(Item(1)), new Right(Item(2))] as Pair[Item])
delay(pair)().1.item.value
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.161: 	delay(pair)().1.item.value
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'value' of a value with unknown shape.
//│ ╟── This type argument supplies only an input bound for 'R'.
//│ ║  l.160: 	let pair = ([new Left(Item(1)), new Right(Item(2))] as Pair[Item])
//│ ║         	                                                            ^^^^
//│ ╟── Type parameter 'R' is declared contravariant here.
//│ ║  l.157: 	class Right[in R](val item: R)
//│ ║         	               ^
//│ ╙── Values read through it have no output bound more specific than 'Any'.
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ pair = [Left(Item(1)), Right(Item(2))]
