// Checked indexing reports the annotation that does not expose an array.
:ge
class Base
fun inspect(value: Base) = value.[0]
//│ ╔══[COMPILATION ERROR] Resolution error in array index
//│ ║  l.259: 	fun inspect(value: Base) = value.[0]
//│ ║         	                           ^^^^^^^^
//│ ╟── Value of type 'Base' does not support checked array indexing.
//│ ║  l.259: 	fun inspect(value: Base) = value.[0]
//│ ║         	                   ^^^^
//│ ╙── Use '![...]' for a dynamic access.

// An annotated instance cannot be used as a constructor.
:ge
class Base
val instance: Base = new Base
new instance
