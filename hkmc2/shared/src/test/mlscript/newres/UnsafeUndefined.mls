:w
:expect [undefined]
fun bareValue() = [undefined]
bareValue()
//│ ╔══[WARNING] Direct use of 'undefined' is discouraged; use 'unsafe.undefined' for JavaScript interoperation.
//│ ║  l.21: 	fun bareValue() = [undefined]
//│ ╙──      	                   ^^^^^^^^^
//│ = [undefined]

:w
type BareType = undefined
//│ ╔══[WARNING] Direct use of 'undefined' is discouraged; use 'unsafe.undefined' for JavaScript interoperation.
//│ ║  l.29: 	type BareType = undefined
//│ ╙──      	                ^^^^^^^^^

:w
:expect [1, 0]
fun barePattern(value) = if value is undefined then 1 else 0
[barePattern(unsafe.undefined), barePattern(null)]
//│ ╔══[WARNING] Direct use of 'undefined' is discouraged; use 'unsafe.undefined' for JavaScript interoperation.
//│ ║  l.36: 	fun barePattern(value) = if value is undefined then 1 else 0
//│ ╙──      	                                     ^^^^^^^^^
//│ = [1, 0]

// Warning about the spelling must preserve the literal type and its narrowing behavior.
:w
:expect [0, 3]
fun bareLength(value: Str | BareType) =
  if value is ~undefined as text then text.length else 0
[bareLength(unsafe.undefined), bareLength("abc")]
//│ ╔══[WARNING] Direct use of 'undefined' is discouraged; use 'unsafe.undefined' for JavaScript interoperation.
//│ ║  l.47: 	  if value is ~undefined as text then text.length else 0
//│ ╙──      	               ^^^^^^^^^
//│ = [0, 3]

// The virtual module emits the host literal without a runtime module lookup.
:sir
:sjs
:expect [undefined, true, false]
[unsafe.undefined, unsafe.undefined === unsafe.undefined, unsafe.undefined === null]
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ return [undefined, true, false]
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ return globalThis.Object.freeze([ undefined, true, false ])
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [undefined, true, false]

// Runtime patterns still distinguish undefined from legitimate values.
:expect [0, 3]
fun length(value: Str | unsafe.undefined) =
  if value is ~unsafe.undefined as text then text.length else 0
[length(unsafe.undefined), length("abc")]
//│ = [0, 3]

:expect [true, false]
fun isUndefined(value) = if value is unsafe.undefined then true else false
[isUndefined(unsafe.undefined), isUndefined(null)]
//│ = [true, false]

// Undefined contributes no member target, even in strict and eager resolution.
:expect 3
fun unchecked(value: Str | unsafe.undefined) = value.length
unchecked("abc")
//│ = 3

// Optional parameters still convert the unsafe value to null on entry.
:expect [null, null, 7]
fun optional(value?) = value
[optional(), optional(unsafe.undefined), optional(7)]
//│ = [null, null, 7]

// Recognition uses the Prelude symbol, not the spelling of the qualifier.
:expect 42
let unsafe = {id"undefined": 42} in unsafe.undefined
//│ = 42


