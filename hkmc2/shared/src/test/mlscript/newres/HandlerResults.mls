// FIXME: The handler receiver and its result need shape propagation. This
// handler aborts: its record, not the rest of the handled body, is the result.
:fixme
:expect 42
abstract class AnswerEffect with
  fun answer()
fun handled() =
  handle h = AnswerEffect with
    fun answer()(resume) = {answer: 42}
  h.answer()
  {answer: 0}
handled().answer
