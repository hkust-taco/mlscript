// FIXME: Propagate the possible results of resumptive handlers. This handler
// aborts with {answer: 42}; the handled body's final record is unreachable.
:fixme
:expect 42
private abstract class AnswerEffect with
  fun answer()
fun handled() =
  handle h = AnswerEffect with
    fun answer()(resume) = {answer: 42}
  h.answer()
  {answer: 0}
handled().answer
