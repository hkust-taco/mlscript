:js


use Int = 42
use Str = "42"

:expect 42
use[Int]
//│ = 42

:expect "42"
use[Str]
//│ = "42"

:e
use[Num]
//│ ╔══[ERROR] Cannot query instance for use-expression of type Num
//│ ║  l.16: 	use[Num]
//│ ║        	    ^^^
//│ ╙── Missing instance: Expected: Num; Available: (Int, Str)

:expect 42
let x = use[Int]
x
//│ = 42
//│ x = 42


