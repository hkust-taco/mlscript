data class Some[T](value: T)


:expect 42
fun f[T](using Some[T]) = use[Some[T]].value
use Some[Int] = Some(42)
f
//│ = 42

:e
use{[Some[Int]].value}
//│ = 42
//│ FAILURE: Unexpected lack of type error

:e
use([Some[Int]].value)
