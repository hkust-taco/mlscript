:js

using Int = 42

fun foo()(using Int) = [use[Int]]

fun bar(x)(using Int) = [x, use[Int]]

fun baz(x)(using Int)(y)(using Num) = [x, use[Int], y, use[Num]]


:e
baz
//│ ╔══[ERROR] Cannot query instance of type Num for call: 
//│ ║  l.13: 	baz
//│ ║        	^^^
//│ ╟── Required by contextual parameter declaration: 
//│ ║  l.9: 	fun baz(x)(using Int)(y)(using Num) = [x, use[Int], y, use[Num]]
//│ ║       	                               ^^^
//│ ╙── Missing instance: Expected: Num; Available: Int
//│ = fun


using Num = 0.42

// foo
// should be expanded to
// () => foo()
// and then resolved to
// () => foo()(<using> 42)
:sjs
let f1 = foo
//│ JS (unsanitized):
//│ let f1, tmp, lambda1;
//│ lambda1 = (undefined, function () {
//│   let tmp1;
//│   tmp1 = foo();
//│   return runtime.safeCall(tmp1(instance$Ident$_Int$_))
//│ });
//│ tmp = lambda1;
//│ f1 = tmp;
//│ f1 = fun

:expect [42]
f1()
//│ = [42]

// bar
// should be expanded to
// (x) => bar(x)
// and then resolved to
// (x) => bar(x)(<using> 42)
:sjs
let f2 = bar
//│ JS (unsanitized):
//│ let f2, tmp1, lambda2;
//│ lambda2 = (undefined, function (x) {
//│   let tmp2;
//│   tmp2 = bar(x);
//│   return runtime.safeCall(tmp2(instance$Ident$_Int$_))
//│ });
//│ tmp1 = lambda2;
//│ f2 = tmp1;
//│ f2 = fun

:expect [0.42, 42]
f2(0.42)
//│ = [0.42, 42]

// baz
// should be expanded to
// (x) => baz(x)
// and then resolved to
// (x) => baz(x)(<using> 42)
:sjs
let f3 = baz
//│ JS (unsanitized):
//│ let f3, tmp2, lambda3;
//│ lambda3 = (undefined, function (x) {
//│   let lambda4;
//│   lambda4 = (undefined, function (y) {
//│     let tmp3, tmp4, tmp5;
//│     tmp3 = baz(x);
//│     tmp4 = runtime.safeCall(tmp3(instance$Ident$_Int$_));
//│     tmp5 = runtime.safeCall(tmp4(y));
//│     return runtime.safeCall(tmp5(instance$Ident$_Num$_))
//│   });
//│   return lambda4
//│ });
//│ tmp2 = lambda3;
//│ f3 = tmp2;
//│ f3 = fun

:expect [43, 42, 44, 0.42]
f3(43)(44)
//│ = [43, 42, 44, 0.42]

// This should not expand
:sjs
foo()
//│ JS (unsanitized):
//│ let tmp4; tmp4 = foo(); runtime.safeCall(tmp4(instance$Ident$_Int$_))
//│ = [42]

// This should not expand
:sjs
bar(0.42)
//│ JS (unsanitized):
//│ let tmp5; tmp5 = bar(0.42); runtime.safeCall(tmp5(instance$Ident$_Int$_))
//│ = [0.42, 42]


