
module M with
  val foo: module M = M
  fun bar: module M = M
  fun baz(): module M = M
  fun that: module N = N
module N with
  fun that: module M = M

module R with
  fun foo()(): module N = N
  fun bar[T](using Int)(using Num)(using Str): module M = M

fun foo[T](using Int)(using Num)(using Str): module M = M

using Int = 42
using Num = 4.2
using Str = "42"

