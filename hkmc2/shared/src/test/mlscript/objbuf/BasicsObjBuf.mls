:js

import "../../mlscript-compile/ObjectBuffer.mls"
open ObjectBuffer
open annotations


:sjs
@buffered
class A with
  constructor(x)
  fun f(y) = x + y
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let A1;
//│ (class A {
//│   static {
//│     A1 = this
//│   }
//│   static {
//│     A.size = 1;
//│   }
//│   static ctor(buf, idx) {
//│     return (x) => {
//│       let idx1;
//│       idx1 = idx + 0;
//│       buf.buf[idx1] = x;
//│       return idx
//│     }
//│   }
//│   static f(buf, idx) {
//│     return (y) => {
//│       let idx1;
//│       idx1 = idx + 0;
//│       return buf.buf.at(idx1) + y
//│     }
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "A"];
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


@bufferable
class A2(x) with
  fun f(y) = x + y

