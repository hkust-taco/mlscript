:w
@bufferable
module B3
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.91: 	@bufferable
//│ ╙──      	^^^^^^^^^^^

:w
@bufferable
object B3
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.98: 	@bufferable
//│ ╙──      	^^^^^^^^^^^


:breakme // TODO: disallow direct instantiation of @buffered classes
new A
//│ = fun

:fixme // TODO: disallow direct instantiation of @buffered classes
new A(123).f(0)
//│ ═══[RUNTIME ERROR] TypeError: tmp.f is not a function


let buf = new DefaultObjectBuffer(10)
//│ buf = DefaultObjectBuffer(_)

let obj1 = buf.mkNew(A)(3)
//│ obj1 = 0

let obj2 = buf.mkNew(A)(5)
//│ obj2 = 2

A.f(buf, obj1)(1)
//│ = 4

A.f(buf, obj2)(1)
//│ = 6

buf.del(A, obj1)

let obj3 = buf.mkNew(A)(10)
//│ obj3 = 0

// UAF
A.f(buf, obj1)(1)
//│ = 11

A.f(buf, obj3)(1)
//│ = 11


@bufferable
class Oops with
  fun hi = print("hi")

let obj1 = buf.mkNew(Oops)
//│ obj1 = 0


Oops.hi(buf, obj2)
//│ > hi

let obj2 = buf.mkNew(A)(3)
//│ obj2 = 4

A.f(buf, obj2)(1)
//│ = 4

buf.del(Oops, obj1)

:expect 4
A.f(buf, obj2)(1)
//│ = 4


@buffered
class A with
  constructor(x)
  val z = x
  fun f(y) = x + y + z



