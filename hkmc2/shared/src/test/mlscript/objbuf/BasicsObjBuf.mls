// A buffered method keeps all its original argument lists and result interface.
@annotations.buffered
class Curried with
  constructor(value: Str)
  fun append(suffix: Str)(last: Str): Str = value + suffix + last
  fun valueLength: Int = value.length
  fun echo[T](value: T): T = value

:expect "abc"
let curried = buf.mkNew(Curried)("a")
Curried.append(buf, curried)("b")("c").toLowerCase()
//│ = "abc"
//│ curried = 6

:expect "1.0"
Curried.valueLength(buf, curried).toFixed(1)
//│ = "1.0"

:expect ["ABC", "12.0"]
[Curried.echo(buf, curried)("abc").toUpperCase(), Curried.echo(buf, curried)(12).toFixed(1)]
//│ = ["ABC", "12.0"]

// Even a zero-sized class must run its constructor.
:expect 1
let initialized = 0
@buffered
class Empty with
  set initialized += 1
let empty = buf.mkNew(Empty)
initialized
//│ = 1
//│ empty = 0
//│ initialized = 1

