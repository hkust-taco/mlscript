:fixme
:ge
@bufferable
object B3
//│ /!!!\ Uncaught error: java.lang.IllegalArgumentException: requirement failed


let buf = new DefaultObjectBuffer(10)
//│ buf = DefaultObjectBuffer(_)

let obj1 = buf.mkNew(A.class)(3)
//│ obj1 = 0

let obj2 = buf.mkNew(A.class)(5)
//│ obj2 = 2

A.class.f(buf, obj1)(1)
//│ = 4

A.class.f(buf, obj2)(1)
//│ = 6

buf.del(A.class, obj1)

let obj3 = buf.mkNew(A.class)(10)
//│ obj3 = 0

// UAF
A.class.f(buf, obj1)(1)
//│ = 11

A.class.f(buf, obj3)(1)
//│ = 11


:sjs
@bufferable
class Oops with
  fun hi = print("hi")
//│ JS (unsanitized):
//│ let Oops1;
//│ globalThis.Object.freeze(class Oops {
//│   static {
//│     Oops1 = this
//│   }
//│   constructor() {}
//│   static {
//│     this.size = 0;
