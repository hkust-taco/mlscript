:breakme
:ge
@bufferable
module B3

:fixme
:ge
@bufferable
object B3
//│ /!!!\ Uncaught error: java.lang.IllegalArgumentException: requirement failed


let buf = new DefaultObjectBuffer(10)
//│ buf = DefaultObjectBuffer(_)

let obj1 = buf.mkNew(A)(3)
//│ obj1 = 0

let obj2 = buf.mkNew(A)(5)
//│ obj2 = 2

A.f(buf, obj1)(1)
//│ = 4

A.f(buf, obj2)(1)
//│ = 6

buf.del(A, obj1)

let obj3 = buf.mkNew(A)(10)
//│ obj3 = 0

// UAF
A.f(buf, obj1)(1)
//│ = 11

A.f(buf, obj3)(1)
//│ = 11


:sjs
@bufferable
class Oops with
  fun hi = print("hi")
//│ JS (unsanitized):
//│ let Oops1;
//│ globalThis.Object.freeze(class Oops {
//│   static {
//│     Oops1 = this
//│   }
//│   constructor() {}
//│   static {
//│     this.size = 0;
//│   }
//│   static ctor(buf1, idx) {
//│     return idx
//│   } 
//│   static hi(buf1, idx) {
//│     return Predef.print("hi")
//│   }
//│   get hi() {
//│     return Predef.print("hi");
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Oops"]; 
//│ });

let obj1 = buf.mkNew(Oops)
//│ obj1 = 0


Oops.hi(buf, obj2)
//│ > hi

let obj2 = buf.mkNew(A)(3)
//│ obj2 = 4

A.f(buf, obj2)(1)
//│ = 4

buf.del(Oops, obj1)

:expect 4
A.f(buf, obj2)(1)
//│ = 4


