let buf = new DefaultObjectBuffer(10)
//│ buf = DefaultObjectBuffer(_)

let obj1 = buf.mkNew(A.class)(3)
//│ obj1 = 0

let obj2 = buf.mkNew(A.class)(5)
//│ obj2 = 2

A.class.f(buf, obj1)(1)
//│ = 4

A.class.f(buf, obj1)(1)
//│ = 5

A.class.f(buf, obj2)(1)
//│ = 6

buf.del(A.class, obj1)

let obj3 = buf.mkNew(A.class)(10)
//│ obj3 = 0

// UAF
A.class.f(buf, obj1)(1)
//│ = 11

A.class.f(buf, obj3)(1)
//│ = 12


@bufferable
class A(x) with
  mut val z = x
  fun f(y) =
    set z += 1
    z


