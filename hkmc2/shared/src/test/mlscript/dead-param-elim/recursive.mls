private fun isEven(n) = if n == 0 then true else isOdd(n - 1)
private fun isOdd(n) = if n == 0 then false else isEven(n - 1)
isEven(10)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = true



