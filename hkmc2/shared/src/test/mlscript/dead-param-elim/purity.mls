:js
:noInline
:flowBasedOpt debugDpe


// an eliminated arg with effects is still evaluated
:re
:soir
private fun f(a) = 0
fun g(o) = f(o.x)
g(null)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > prodfun f#0 @ <root> -> eliminable: {0}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private
//│ define f⁰ as fun f¹() { return 0 };
//│ define g⁰ as fun g¹(o) { do o.x﹖; return f¹() };
//│ return g¹(null)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of null (reading 'x')

// args before it are evaluated first, so this throws on `x` rather than on `y`
:re
:soir
private fun f(a, b) = a
fun g(o, p) = f(o.x, p.y)
g(null, null)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > prodfun f#0 @ <root> -> eliminable: {1}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private
//│ define f² as fun f³(a) {
//│   return a
//│ };
//│ define g² as fun g³(o, p) {
//│   let arg;
//│   set arg = o.x﹖;
//│   do p.y﹖;
//│   return f³(arg)
//│ };
//│ return g³(null, null)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of null (reading 'x')

// pure args before it are evaluated first too: `bump` sets `n`, so passing `n` must still give 0
:soir
let n = 0
class A with
  fun bump = set n = 1
private fun f(a, b) = a
fun g(o) = f(n, o.bump)
g(new A)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > prodfun f#0 @ <root> -> eliminable: {1}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp;
//│ @private
//│ define f⁴ as fun f⁵(a) {
//│   return a
//│ };
//│ define g⁴ as fun g⁵(o) {
//│   let arg;
//│   set arg = n⁰;
//│   do o.bump﹖;
//│   return f⁵(arg)
//│ };
//│ set n⁰ = 0;
//│ define A⁰ as class A¹ {
//│   method bump⁰ = fun bump¹ {
//│     set n⁰ = 1;
//│     return runtime⁰.Unit⁰
//│   }
//│ };
//│ set tmp = new A¹();
//│ return g⁵(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0
//│ n = 1
