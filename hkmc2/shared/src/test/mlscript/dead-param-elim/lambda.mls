:expect 42
:soir
private fun f(a) =
  let g = () => a
  g()
f(42)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private define f⁰ as fun f¹(a) { return a }; return 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42



// two `apply`, one has dead param, another does not
:noInline
private fun apply(f, x) = f(x)
private fun main(f1, f2) =
  apply(f1, 42) + apply(f2, 0)
private fun main1() = main((a) => 0, (a) => a + 1)
main1()
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 1


// [INLINING PR FIXME]: regression? even with :noInline
:noInline
// two `apply`, one has dead param, another does not;
// but if `apply` is inlined, we can eliminate the `a` in `(a) => 0`
private fun apply(f, x) = f(x)
private fun main(f1, f2) =
  apply(f1, 42) + apply(f2, 0)
private fun main1() = main((a) => 0, (a) => a + 1)
main1()
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 1

// the DPE copy of `main1` rebuilds its nested `lambda` with its original symbol before refreshing it,
// so the in-place rewrite of `main1` then rewrites a `lambda` that no longer owns its symbol
:fixme
:flowBasedOpt debugDpe poly
:noInline
private fun apply(f, x) = f(x)
private fun main(f1, f2) =
  apply(f1, 42) + apply(f2, 0)
private fun main1() = main((a) => 0, (a) => a + 1)
main1()
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > apply⁰#0 @ main1⁰.main⁰.apply¹ -> eliminable: {1}
//│ dead-param-elim > lambda⁰#0 @ main1⁰ -> eliminable: {0}
//│ dead-param-elim > apply⁰#0 @ main1¹.main⁰.apply¹ -> eliminable: {1}
//│ dead-param-elim > lambda⁰#0 @ main1¹ -> eliminable: {0}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ╔══[INTERNAL ERROR] Compiler reached an unexpected state at 'FlowAnalysisBasedRewrite.scala:208': a copy binds the original symbol term:lambda
//│ ╟── The compilation result may be incorrect.
//│ ╙── This is a compiler bug; please report it to the maintainers.
//│ ╔══[INTERNAL ERROR] Compiler reached an unexpected state at 'FlowAnalysisBasedRewrite.scala:208': a copy binds the original symbol term:lambda
//│ ╟── The compilation result may be incorrect.
