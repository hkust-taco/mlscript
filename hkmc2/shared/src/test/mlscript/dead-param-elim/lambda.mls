:deadParamElim
:expect 42
fun f(a) =
  let g = () => a
  g()
f(42)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > prodfun f#0 @ f@2 -> all params live
//│ dead-param-elim > prodfun f#0 @ f@3 -> all params live
//│ dead-param-elim > prodfun g#0 @ f@2 -> all params live
//│ dead-param-elim > prodfun g#0 @ f@3 -> all params live
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 42



// two `apply`, one has dead param, another does not
:deadParamElim
fun apply(f, x) = f(x)
fun main(f1, f2) =
  apply(f1, 42) + apply(f2, 0)
fun main1() = main((a) => 0, (a) => a + 1)
main1()
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > prodfun apply#0 @ apply@11 -> all params live
//│ dead-param-elim > prodfun apply#0 @ main1@10.main@8.apply@2 -> eliminable: {1}
//│ dead-param-elim > prodfun apply#0 @ main1@10.main@8.apply@4 -> all params live
//│ dead-param-elim > prodfun apply#0 @ main1@13.main@8.apply@2 -> eliminable: {1}
//│ dead-param-elim > prodfun apply#0 @ main1@13.main@8.apply@4 -> all params live
//│ dead-param-elim > prodfun apply#0 @ main@12.apply@2 -> all params live
//│ dead-param-elim > prodfun apply#0 @ main@12.apply@4 -> all params live
//│ dead-param-elim > prodfun lambda#0 @ main1@10 -> eliminable: {0}
//│ dead-param-elim > prodfun lambda#0 @ main1@10 -> all params live
//│ dead-param-elim > prodfun lambda#0 @ main1@13 -> eliminable: {0}
//│ dead-param-elim > prodfun lambda#0 @ main1@13 -> all params live
//│ dead-param-elim > prodfun main#0 @ main1@10.main@8 -> all params live
//│ dead-param-elim > prodfun main#0 @ main1@13.main@8 -> all params live
//│ dead-param-elim > prodfun main#0 @ main@12 -> all params live
//│ dead-param-elim > prodfun main1#0 @ main1@10 -> all params live
//│ dead-param-elim > prodfun main1#0 @ main1@13 -> all params live
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 1
