:noInline
private fun f(module I: O.I) = I.C(3)
private fun g(x, module I: O.I) = if x is
  I.C(y) then y + 2
g(f(O.I), O.I)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 5

