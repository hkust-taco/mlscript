:noInline
private fun f(module O: O) = O.I.x
private fun g(module O: O) = O.I.g()
f(O) + g(O)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
