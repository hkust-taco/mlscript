module M with
  data class Foo(x) with
    private fun m() = this.x + 1
    private fun n(y) = this.x + y
let foo = M.Foo(123)
foo M.Foo::n(2)
//│ ╔══[COMPILATION ERROR] Cannot access private member 'n' outside its declaring owner
//│ ║  l.110: 	foo M.Foo::n(2)
