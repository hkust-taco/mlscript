:js
:deadParamElim debug
:noInline




module M with
  private fun f(a) = 0
  private fun g(b) = b
M.f(1)
M.g(2)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > prodfun f#0 @ <root> -> eliminable: {0}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 2


:expect 3
module M with
  val x = 3
  private fun f(a) = x
  private fun main() = M.f(42)
M.main()
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > prodfun f#0 @ <root> -> eliminable: {0}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 3


:expect 42
module M with
  private fun f(a) = a
  private fun main() = M.f(42)
M.main()
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
