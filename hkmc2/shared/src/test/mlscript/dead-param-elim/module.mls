:deadParamElim
:expect 125
module M with
  data class Foo(x) with
    private fun m() = this.x + 1
    private fun n(y) = this.x + y
let foo = M.Foo(123)
foo M.Foo::n(2)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
