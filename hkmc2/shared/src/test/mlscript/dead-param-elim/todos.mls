:js
:deforest
:flowBasedOpt debugEta debugDpe

open annotations { noInline }
data class (::) Cons(h, t)
data object Nil
data object A
data object B
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<


// TODO: dead eta expanded parameters from variables declared outside a fused match.
// `r` is declared before the match in `c` and assigned in its branches, so it is a free variable of the
// branch functions and becomes the eta expanded parameter `eta$0$0` of `p`, which is dead but kept by dpe.
// Scoped branches will not fully help here, as `r` is not local to a branch.
// A block simplifier before the fused pass makes `r` unread so that dpe eliminates it
:expect 1
:soir
@noInline fun p(b) = if b then A else B
fun c(x) =
  let r = 0
  if x is
    A do set r = 1
    B do set r = 2
  r
c(p(true))
//│ deforest > >>> fusing >>>
//│ deforest > A⁰ ->
//│ deforest > 	match: x⁰
//│ deforest > B⁰ ->
//│ deforest > 	match: x⁰
//│ deforest > <<< fusing <<<
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > p_7$p: [1, 1]
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let p_7$p$worker;
//│ @private @noInline
//│ define p_7$p$worker as fun p_7$p$worker⁰(b, eta$0$0) {
//│   match b
//│     true =>
//│       return 1
//│     else
//│       return 2
//│   end
//│ };
//│ @noInline
//│ define p⁰ as fun p¹(b) {
//│   match b
//│     true =>
//│       return A⁰
//│     else
//│       return B⁰
//│   end
//│ };
//│ define c⁰ as fun c¹(x) {
//│   match x
//│     A⁰ =>
//│       return 1
//│     B⁰ =>
//│       return 2
//│     else
//│       return 0
//│   end
//│ };
//│ return p_7$p$worker⁰(true, 0)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

// TODO: some params also come from variables local to a branch, but
// even with the block simplifier before the fused pass, eta expansion param 8 will not be eliminated:
// param 8 is the match result `tmp1`, which is assigned the non-trivial `h + sumPlus(t)` in `sumPlus_16$ls_Cons`
// and there is no way for block simplifier to remove it; this case scoped branches can help
:expect 11
:soir
fun enum(x) = if x < 0 then Nil else x :: enum(x - 1)
fun sumPlus(ls) =
  let r = if ls is
    Nil then 0
    h :: t then h + sumPlus(t)
  r + 1
sumPlus(enum(3))
//│ deforest > >>> fusing >>>
