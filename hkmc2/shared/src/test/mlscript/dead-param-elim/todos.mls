//│ deforest > 	fields: ls⁰.t⁰
//│ deforest > <<< fusing <<<
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > enum_14$enum: [1, 9]
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > prodfun sumPlus_16$ls_Cons#1 @ <root> -> eliminable: {0, 5}
//│ dead-param-elim > prodfun sumPlus_16$ls_Nil#1 @ <root> -> eliminable: {0, 5}
//│ dead-param-elim > <<< dead-param-elim results <<<
