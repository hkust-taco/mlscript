//│   end
//│ };
//│ @noInline
//│ define p² as fun p³(b) {
//│   match b
//│     true =>
//│       return A⁰
//│     else
//│       return B⁰
//│   end
//│ };
//│ define c² as fun c³(x) {
//│   match x
//│     A⁰ =>
//│       return 1
//│     B⁰ =>
//│       return 2
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
