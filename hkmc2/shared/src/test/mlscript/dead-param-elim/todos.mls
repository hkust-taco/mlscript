//│       set fv_tmp = +⁰(x, inlinedVal);
//│       return +⁰(fv_tmp, 1)
//│   end
//│ };
//│ define enum⁰ as fun enum¹(x) {
//│   let scrut, tmp, tmp1;
//│   set scrut = <⁰(x, 0);
//│   match scrut
//│     true =>
//│       return Nil⁰
