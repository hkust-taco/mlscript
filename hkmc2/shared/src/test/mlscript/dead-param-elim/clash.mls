//│ dead-param-elim > prodfun f#0 @ f@1 -> eliminable: {0, 1}
//│ dead-param-elim > prodfun g#0 @ g@2 -> eliminable: {0, 1}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = [4, 5]



:deadParamElim
:expect [3, 4, 5]
fun f(a, b, ...rest) = rest
fun g(a, b, c, ...rest) = rest
(if true then f else g)(1,2,3,4,5)
