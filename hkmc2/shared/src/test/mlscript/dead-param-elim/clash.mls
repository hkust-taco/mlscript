:deadParamElim debug




// g has dead param `b`, but f has live param `a`
:expect 0
private fun f(a) = a
private fun g(b) = 0
private fun test(x)(y) = if false then x else y
private fun m() = test(f)(g)(5)
m()
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 0



:expect 3
private fun f(a)(b) = 0
private fun g(a)(b) = a + b
private fun main(x)(y) = if false then x else y
private fun m1() = main(f)(g)(1)(2)
m1()
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 3


