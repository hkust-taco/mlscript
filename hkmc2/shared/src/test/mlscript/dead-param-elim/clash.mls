:soir
[1,2,3].map((x, i, a) => x + 1)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp, lambda⁰;
//│ set tmp = [1, 2, 3];
//│ define lambda⁰ as fun lambda¹(x, i, a) { return +⁰(x, 1) };
//│ tmp.map﹖(lambda¹)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [2, 3, 4]



:expect [4, 5]
private fun f(a, b, ...rest) = rest
private fun g(a, b, c, ...rest) = rest
(if false then f else g)(1,2,3,4,5)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > prodfun f#0 @ <root> -> eliminable: {0, 1}
//│ dead-param-elim > prodfun g#0 @ <root> -> eliminable: {0, 1, 2}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = [4, 5]


