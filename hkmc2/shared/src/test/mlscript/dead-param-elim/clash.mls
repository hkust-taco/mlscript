:deadParamElim
:sir
[1,2,3].map((x, i, a) => x + 1)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp, lambda⁰;
//│ set tmp = [1, 2, 3];
//│ define lambda⁰ as fun lambda¹(x, i, a) { return +⁰(x, 1) };
//│ tmp.map﹖(lambda¹)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [2, 3, 4]



:deadParamElim
:expect [4, 5]
fun f(a, b, ...rest) = rest
fun g(a, b, c, ...rest) = rest
(if false then f else g)(1,2,3,4,5)
