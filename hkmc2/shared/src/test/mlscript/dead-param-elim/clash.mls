// f, g, h all flow to the same call site
:expect 0
private fun f(a) = a
private fun g(b) = 0
private fun h(c) = 0
private fun pick(x)(y)(z) = if false then x else if false then y else z
private fun m() = pick(f)(g)(h)(5)
m()
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 0






