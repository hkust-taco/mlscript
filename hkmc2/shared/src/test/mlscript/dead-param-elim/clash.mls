// f, g, h all flow to the same call site
:deadParamElim
fun f(a) = a
fun g(b) = 0
fun h(c) = 0
fun pick(x)(y)(z) = if false then x else if false then y else z
fun m() = pick(f)(g)(h)(5)
//│ dead-param-elim > >>> dead-param-elim results >>>
