:.
:js
:noInline

// Test: Dead parameter elimination with multiple parameter lists
:flowBasedOpt
:soir
private fun f(a)(b) = a
f(42)(99)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private define f⁰ as fun f¹(a)() { return a }; return f¹(42)()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42

// Test: Both params dead across two parameter lists
:flowBasedOpt
:soir
private fun g(x)(y) = 0
g(1)(2)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private define g⁰ as fun g¹()() { return 0 }; return g¹()()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

// Test: Dead param in second list only
:flowBasedOpt
:soir
private fun h(x)(y) = x
h(5)(10)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private define h⁰ as fun h¹(x)() { return x }; return h¹(5)()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 5

// Test: Dead param in first list only
:flowBasedOpt
:soir
private fun j(x)(y) = y
j(5)(10)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private define j⁰ as fun j¹()(y) { return y }; return j¹()(10)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 10

// Test: Three parameter lists, middle one dead
:flowBasedOpt
:soir
private fun k(a)(b)(c) = a + c
k(1)(2)(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private define k⁰ as fun k¹(a)()(c) { return +⁰(a, c) }; return k¹(1)()(3)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 4

:flowBasedOpt
:soir
:expect 2
private fun m(a, b)(...rest) = b
let xs = [3, 4]
m(1, 2)(...xs)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private define m⁰ as fun m¹(b)(...rest) { return b }; set xs⁰ = [3, 4]; return m¹(2)(...xs⁰)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2
//│ xs = [3, 4]

