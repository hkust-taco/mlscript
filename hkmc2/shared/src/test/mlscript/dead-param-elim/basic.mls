class Foo(x) with
  fun bar(a) = x
let foo = Foo(1)
foo.bar(99)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let Foo⁰, foo⁰;
//│ define Foo⁰ as class Foo²(x) {
//│   private val x⁰;
//│   constructor Foo¹ {
//│     set x⁰ = x;
//│     end
//│   }
//│   method bar⁰ = fun bar¹(a) { return x⁰ }
//│ };
//│ set foo⁰ = Foo¹(1);
//│ foo⁰.bar﹖(99)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1
//│ foo = Foo(_)


