//│ = 3

:deadParamElim debug poly
fun f(a) = g(a)
fun g(x) = 3
f(1)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > prodfun f#0 @ f@3 -> eliminable: {0}
//│ dead-param-elim > prodfun g#0 @ f@3.g@1 -> eliminable: {0}
//│ dead-param-elim > prodfun g#0 @ f@4.g@1 -> eliminable: {0}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 3

f(2)
g(1)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 3


:deadParamElim debug mono
:expect [3, 4]
private fun f(x) =
  fun g(a, b, ...rest) = 
    print(x)
    rest
  g(1, 2, 3, 4)
f(2)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > prodfun g#0 @ <root> -> eliminable: {0, 1}
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ > 2
//│ = [3, 4]



