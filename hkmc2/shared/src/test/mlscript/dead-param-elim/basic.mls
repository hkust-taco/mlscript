:expect 1
data class Pair(a, b)
private fun fst(p) = if p is Pair(a, b) then a
fst(Pair(1, 2))
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 1



:expect 2
data class Pair(a, b)
private fun snd(p) = if p is Pair(a, b) then b
snd(Pair(1, 2))
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ = 2




