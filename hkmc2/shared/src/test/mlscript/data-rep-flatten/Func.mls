fun f(x, y) =
  let t = if x then new Foo(new C(y), 0) else new Bar(new D(y))
  @matchShapes(Foo(_, 0), Bar(_)) shape.match of t,
    () =>
      let m = t.Foo#x
      @matchShapes(C(_), D(_)) shape.match of m, () => m.C#x + 1, () => m.D#x + 2
    () =>
      let m = t.Bar#x
      @matchShapes(C(_), D(_)) shape.match of m, () => m.C#x + 1, () => m.D#x + 2
