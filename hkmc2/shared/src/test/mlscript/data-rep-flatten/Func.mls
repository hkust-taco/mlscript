fun f(x, y) =
  let t = if x then new Foo(new C(y), 0) else new Bar(new D(y))
  let s1 = @matchShapes(Foo(_, 0), Bar(_)) shape.match of t,
    () => g(t)
    () => h(t)
  let s2 = @matchShapes(Foo(_, _), Bar(_)) shape.match of t,
    () => g(t)
    () => h(t)
  s1 + s2
private fun g(t) =
  let m = t.Foo#x
  @matchShapes(C(_), D(_)) shape.match of m, () => m.C#x + 1, () => m.D#x + 2
private fun h(t) =
  let m = t.Bar#x
  @matchShapes(C(_), D(_)) shape.match of m, () => m.C#x + 1, () => m.D#x + 2
