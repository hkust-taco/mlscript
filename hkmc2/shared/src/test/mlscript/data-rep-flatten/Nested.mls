class Cons(val x, val xs)
object Nil
//│ >>> start data-rep-flatten collection-phase
//│ <<< end data-rep-flatten collection-phase
//│ >>> start data-rep-flatten transform-phase
//│ <<< end data-rep-flatten transform-phase


:ssjs
fun foo(x, y, z) =
  let ls = new Cons(1, new Cons(2, new Cons(3, new Cons(x, new Cons(y, new Cons(z, Nil))))))
  bar(ls)
private fun bar(ls) =
  @matchShapes(Cons(1, Cons(2, Cons(3, Cons(_, Cons(_, Cons(_, Nil)))))))
  shape.match of ls, () => ls.Cons#xs.Cons#xs.Cons#xs.Cons#x + ls.Cons#xs.Cons#xs.Cons#xs.Cons#xs.Cons#x + + ls.Cons#xs.Cons#xs.Cons#xs.Cons#xs.Cons#xs.Cons#x 
