//│ >>> start data-rep-flatten transform-phase
//│ <<< end data-rep-flatten transform-phase


fun foo(x, y) =
  let f = new Foo(x, y)
  @matchShapes(f, Foo(_, _)) shape.match of () => new Bar(f.Foo#x + f.Foo#y)
