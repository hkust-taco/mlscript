fun foo(x, y) =
  let t = new Some(x)
  let p = @matchShapes(Some(_), None) shape.match of t, () => new Bar(t.Some#x), () => new Bar(0)
  @matchShapes(Bar(_)) shape.match of p, () => p.Bar#x + 1
