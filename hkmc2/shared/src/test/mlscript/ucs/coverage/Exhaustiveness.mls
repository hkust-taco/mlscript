:e
:breakme // Exhaustiveness checking must account for the comparison split.
// Resolution accepts the methods; the future checker must analyze the split.
abstract class Tree: Node | Empty with
  fun contains(wanted: Int): Bool
object Empty extends Tree with
  fun contains(wanted: Int): Bool = false
data class Node(value: Int, left: Tree, right: Tree) extends Tree with
  fun contains(wanted: Int): Bool = if wanted
    < value then left.contains(wanted)
    > value then right.contains(wanted)
    == value then true

:expect [true, false]
let tree = Node(2, Node(1, Empty, Empty), Node(3, Empty, Empty))
[tree.contains(1), tree.contains(4)]
//│ = [true, false]
//│ tree = Node(2, Node(1, Empty, Empty), Node(3, Empty, Empty))

