// The base case.
fun f(x, y) = if x is
    Tru and y is Tru then true
    Fals and y is Fals then false
    Tru and y is Fals then true
    Fals and y is Tru then true

// Replace the `x is Fals` with `_`
fun f(x, y) = if x is
    Tru and y is Tru then true
    Fals and y is Fals then false
    _ and y is
      Tru then true
      Fals then false

f(Tru, Tru)
f(Tru, Fals)
f(Fals, Tru)
f(Fals, Fals)
