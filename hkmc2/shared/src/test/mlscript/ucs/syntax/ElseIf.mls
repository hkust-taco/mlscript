// Test with real booleans
fun g(x, y) = if x is
  true and y is true then true
  false and y is false then false
  _ and y is
    true then true
    false then false

// Chained UCS terms
fun f(x, y) = if x is
    Tru and y is Tru then true
    Fals and y is Fals then false
  else if y is
    Tru then true
    Fals then false

