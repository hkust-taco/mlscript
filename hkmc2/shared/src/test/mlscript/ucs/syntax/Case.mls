:js

let f = case x then 0
//│ f = fun f

f(1)
//│ = 0

let g = case
  0 then 1
  1 then 0
//│ g = fun

g(0)
//│ = 1

g(1)
//│ = 0

let h = case 0 | 1 then 42
//│ h = fun

h(0)
//│ = 42

h(1)
//│ = 42

