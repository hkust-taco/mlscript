:js

:ucs desugared
// * Note that this always associates to the left
fun f(x) =
  if x ==
    1 +
      2 then 0
      _ then 1
//│ The simple split before desugaring:
//│ >  if
//│ >    let $scrut = 1
//│ >    let $scrut = builtin:==(x, builtin:+($scrut, 2))
//│ >    $scrut is true then 0
//│ >    else 1
//│ Split expanded from the simple split:
//│ >  if
//│ >    let $scrut = 1
//│ >    let $scrut = builtin:==(x, builtin:+($scrut, 2))
//│ >    $scrut is true then 0
//│ >    else 1

