:.
:js

fun f(x) =
  if
    x > 0  then 0
    x == 0 then 1
    _      then 2


fun f(x) =
  if
    x > 0  and
      x % 2 === 0 then true
      _           then false
    x == 0 then true
    _      then false

f(0)
f(2)
f(3)
f(0 - 1)
f(0 - 2)
//│ = false

fun f(x) =
  if
    x > 0  and
      x % 2 === 0 then true
      else false
    x == 0 then true
    else false

f(0)
f(2)
f(1)
f(0 - 1)
//│ = false
