// :de
// type List = Nil | Cons

:ctx
type List = Nil | Cons
object Nil
data class (::) Cons(head: Int, tail: List)
//│ Env:
//│   :: -> RefElem(member:Cons)
//│   Cons -> RefElem(member:Cons)
//│   List -> RefElem(member:List)
//│   Nil -> RefElem(member:Nil)

Cons(1, Nil)
//│ = Cons(1, Nil)

:ge
1 :: 2
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int' at an unrelated type 'Object'
//│ ║  l.21: 	1 :: 2
//│ ╙──      	     ^
//│ = Cons(1, 2)

fun map(f, xs) = if xs is
  Nil then Nil
  x :: xs' then f(x) :: map(f, xs')


