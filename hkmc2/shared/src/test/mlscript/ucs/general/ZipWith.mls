:.
:js

import "../../../mlscript-compile/Stack.mls"
import "../../../mlscript-compile/Option.mls"
open Stack
open Option { Some, None }

fun pairup(x, y) = [x, y]

// All equivalent split layouts must preserve order and reject unequal lengths.
fun checkZip(zip: ((Any, Any) -> Any, Stack[Any], Stack[Any]) -> Option[Stack[Any]]) =
  assert zip(pairup, Nil, Nil) == Some(Nil)
  assert zip(pairup, 1 :: Nil, Nil) == None
  assert zip(pairup, Nil, "a" :: Nil) == None
  assert zip(pairup, 1 :: 2 :: Nil, "a" :: Nil) == None
  assert zip(pairup, 1 :: Nil, "a" :: "b" :: Nil) == None
  assert zip(pairup, 1 :: 2 :: Nil, "a" :: "b" :: Nil) == Some([1, "a"] :: [2, "b"] :: Nil)

fun zipWith(f, xs, ys) =
  if xs is
    Cons(x, xs) and ys is Cons(y, ys) and zipWith(f, xs, ys) is Some(tail) then Some(Cons(f(x, y), tail))
    Nil and ys is Nil then Some(Nil)
  else None

checkZip(zipWith)

fun zipWith(f, xs, ys) =
  if xs is Cons(x, xs) and ys is Cons(y, ys) and zipWith(f, xs, ys) is Some(tail) then Some(Cons(f(x, y), tail))
  else if xs is Nil and ys is Nil then Some(Nil)
  else None

checkZip(zipWith)

fun zipWith(f, xs, ys) =
  if xs is Cons(x, xs) and ys is Cons(y, ys) then
    if zipWith(f, xs, ys) is Some(tail) then Some(Cons(f(x, y), tail))
    else None
  else if xs is Nil and ys is Nil then Some(Nil)
  else None

checkZip(zipWith)

fun zipWith(f, xs, ys) =
  if xs is
    Cons(x, xs) then
      if ys is
        Cons(y, ys) then
          if zipWith(f, xs, ys) is
            Some(tail) then Some(Cons(f(x, y), tail))
            None then None
        Nil then None
    Nil then
      if ys is Nil then Some(Nil) else None

checkZip(zipWith)

:expect [[0, "0"], [1, "1"]]
toArray \ Option.unsafe.get \ zipWith(pairup, 0 :: 1 :: Nil, "0" :: "1" :: Nil)
//│ = [[0, "0"], [1, "1"]]

:re
Option.unsafe.get(zipWith(pairup, Nil, 0 :: Nil))
//│ ═══[RUNTIME ERROR] Error: None.get

// Omitting the successful empty case makes every result None.
fun zipWithoutBase(f, xs, ys) =
  if xs is Cons(x, xs)
    and ys is Cons(y, ys)
    and zipWithoutBase(f, xs, ys) is Some(tail) then Some(Cons(f(x, y), tail))
  else None

:expect [None, None]
[zipWithoutBase(pairup, Nil, Nil), zipWithoutBase(pairup, 0 :: Nil, "0" :: Nil)]
//│ = [None, None]

// This misplaced Some is well-typed but is not an implementation of zipWith.
fun zipMisplacedSome(f, xs, ys) =
  if xs is Cons(x, xs) and ys is Cons(y, ys) and zipMisplacedSome(f, xs, ys) is Some(tail) then Cons(Some(f(x, y)), tail)
  else if xs is Nil and ys is Nil then Some(Nil)
  else None

:expect None
zipMisplacedSome(pairup, 0 :: 1 :: Nil, "0" :: "1" :: Nil)
//│ = None
