fun p(x, y) =
  if
    x is Some and y is None then 0
    y is Some and x is Some then 1
    x is Some and y is Some then 0

fun h(x, y) =
  if x is
    None then y
    let y_square = y * y
    Some(z) then z + y_square

h(Some(5), 6)
//│ = 41

