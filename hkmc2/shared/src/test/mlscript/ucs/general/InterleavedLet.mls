fun inc(x) = x + 1

fun qq(x, z) =
  if x ==
    let y = inc(z)
    y * y then 0
    else 0

fun bruh(x) =
  if
    x == 0 then 0
    let y = 1
    else y

fun f1(x) = x + 1
fun f2(x, y) = x + y

fun ff(x) =
  if
    x == 0 then 0
    let y = f1(x)
    let z = f2(x, y)
    z == 1 then 1
    z == 2 then 2
    else 0

fun p(x): Bool = true

fun ip(x, y) =
  if p(x) and
    let z = inc(y)
    y === z * z then "bruh"
  else "rocks"

fun tr(x) =
  if x is
    Some(v) then v
    let tmp = 1
    None then tmp

// This is a very interesting side-effect example!

fun mn(a) =
  if a is
    Some(x) and x is
      Left(b) and b is
        0 then "b is 1"
        let _ = print(b)
        1 then "b is 2"
        2 then "b is 3"
      Right(b) then "right-defined"
    None       then "undefined"

mn \ None
mn \ Some \ Left \ 0
mn \ Some \ Left \ 1
mn \ Some \ Left \ 2
mn \ Some \ Right \ ()
//│ > 1
//│ > 2
//│ = "right-defined"


// Interleaved bindings inside an operator split are now supported.
fun f(x, z) = if x
  == 0 then "zero"
  let y = z + 1
  == y * y then "square"
  else "other"

:expect ["zero", "square", "other"]
[f(0, 2), f(9, 2), f(8, 2)]
//│ = ["zero", "square", "other"]

data class A()
data class B()

fun tt(x) =
  if x
    is A() then "A"
    let y = "B"
    is B() then y

:expect ["A", "B"]
[tt(A()), tt(B())]
//│ = ["A", "B"]
