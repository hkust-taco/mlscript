import "../../../mlscript-compile/Stack.mls"
open Stack


fun map(f, xs) = if xs is
  Nil then Nil
  let xs' = map(f, xs)
  Cons(x, xs) then Cons(f(x), xs')


object Bot


import "../../../mlscript-compile/Option.mls"
open Option { Some, None }


fun normalize(tp) = ()
fun glb(tp1, tp2) = ()


// TODO: `as` keyword 
fun merge(tp1, tp2) = if
  let tp1_n = normalize(tp1)
  tp1_n is Bot then Bot
  let tp2_n = normalize(tp2)
  tp2_n is Bot then Bot
  let m = merge(tp1_n, tp2_n)
  m is Some(tp) then tp
  m is None     then glb(tp1_n, tp2_n)

fun f(x) =
  if x ==
    let v = 0
    v then v
    else 0


class Either[out A, out B]: Left[A] | Right[B]
data class Left[A](leftValue: A) extends Either[A, Nothing]
data class Right[B](rightValue: B) extends Either[Nothing, B]

fun q(x) =
  if
    x is Some and x is Some and x is Some then 0

