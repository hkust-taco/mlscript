:re
process(Numb(-10))
//│ ═══[RUNTIME ERROR] Error: MLscript call unexpectedly returned `undefined`, the forbidden value.

fun process(e, n) =
  if e is
    Numb(n) and n > 0 then n
    Numb(m) then n + m

process(Numb(0), 10)
process(Numb(-1), 10)
process(Numb(1), 10)
//│ = 1


