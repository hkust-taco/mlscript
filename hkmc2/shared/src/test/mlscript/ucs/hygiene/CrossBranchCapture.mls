data class Pair[A, B](a: A, b: B)

:e
fun process(e) =
  if e is
    Pair(Numb(n), Numb(m)) then Numb(n + m)
    Pair(Vec(xs), Vec(ys)) then n
    Pair(Vec(n),  Numb(n)) then n
