import "../../../mlscript-compile/Option.mls"
open Option { Some, None }
import "../../../mlscript-compile/Stack.mls"
open Stack

fun equalElements[A](xs: Array[A], ys: Array[A], eq: (A, A) -> Bool): Bool =
  xs.length === ys.length and xs.every((x, i, ...) => eq(x, ys.at(i)))

//     _    ____ _____
//    / \  / ___|_   _|
//   / _ \ \___ \ | |
//  / ___ \ ___) || |
// /_/   \_\____/ |_|
//

class Expr: Lambda | BuiltIn | Instance | Thunk | StrLit | IntLit | ExprList
data class Lambda(f: Stack[Data] -> Data) extends Expr
data class BuiltIn(e: Stack[Data] -> Data) extends Expr
data class Instance(n: Str, m: Stack[[Str, Expr]]) extends Expr
data class Thunk(e: () -> Data) extends Expr
data class StrLit(s: Str) extends Expr
data class IntLit(n: Int) extends Expr
data class ExprList(l: Stack[Expr]) extends Expr
fun equalExpr(x: Expr, y: Expr): Bool = if x is
  Lambda(f) and y is Lambda(g) then f === g
  BuiltIn(f) and y is BuiltIn(g) then f === g
  Instance(n, m) and y is Instance(n', m') then
    fun equalPair(a: [Str, Expr], b: [Str, Expr]) = a.0 === b.0 and equalExpr(a.1, b.1)
    n === n' and equalElements(toArray(m), toArray(m'), equalPair)
  Thunk(e) and y is Thunk(e') then e === e'
  StrLit(s) and y is StrLit(s') then s === s'
  IntLit(n) and y is IntLit(n') then n === n'
  ExprList(l) and y is ExprList(l') then equalElements(toArray(l), toArray(l'), equalExpr)
  else false
fun showExpr(e: Expr): Str = if e is
  Lambda(f) then "<lambda>"
  BuiltIn(f) then "<built-in>"
  Instance(n, m) then "<object " + n + ">"
  Thunk(e) then "<thunk>"
  // StrLit(s) then "str:" ++ s
  // IntLit(n) then "int:" ++ toString(n)
  StrLit(s) then s
  IntLit(n) then String(n)
  ExprList(l) then "[" + l.map(showExpr).join(", ") + "]"
class Data: Literal | DataList | Symbol
data class Literal(e: Expr) extends Data
data class DataList(l: Stack[Data]) extends Data
data class Symbol(s: Str) extends Data
fun equalData(x: Data, y: Data): Bool = if x is
  Literal(e) and y is Literal(e') then equalExpr(e, e')
  DataList(l) and y is DataList(l') then equalElements(toArray(l), toArray(l'), equalData)
  Symbol(s) and y is Symbol(s') then s === s'
  else false
fun showData(d: Data): Str = if d is
  Literal(e) then showExpr(e)
  DataList(l) then "(" + l.map(showData).join(", ") + ")"
  // Symbol(s) then "sym:" ++ s
  Symbol(s) then s

//  _____       _                 _
// |_   _|___  | | __ ___  _ __  (_) ____ ___  _ __
//   | | / _ \ | |/ // _ \| '_ \ | ||_  // _ \| '__|
//   | || (_) ||   <|  __/| | | || | / /|  __/| |
//   |_| \___/ |_|\_\\___||_| |_||_|/___|\___||_|
