fun isDigit(n) = 48 <= n and n <= 57
fun isDigits(s: Str): Bool =
  let s' = String(s)
  fun aux(i) =
    if i < s'.length and isDigit(s'.charCodeAt(i))
      then aux(i + 1)
      else i === s'.length
  aux(0)
isDigits("123")
//│ = true

isDigits("123jump")
//│ = false

isDigits("bruh")
//│ = false

class ParseResult[out A]: Success[A] | Failure
data class Success[out A](value: A) extends ParseResult[A]
data class Failure(error: Str) extends ParseResult[Nothing]

fun parseExpr(tokens: Stack[Str]): [ParseResult[Data], Stack[Str]] =
  if tokens is
    Cons("(", tail) then parseList(tail)
    Cons(")", _) then [Failure("Unmatched closing parenthesis."), tokens]
    Cons(token, tail) and
      isDigits(token) then [(Success \ Literal \ IntLit \ parseInt(token, 10)), tail]
      else [(Success \ Symbol \ token), tail]
    Nil then [Failure("Unexpected end of input, expect either `)` or more tokens."), Nil]
  
fun parseList(tokens: Stack[Str]): [ParseResult[DataList], Stack[Str]] =
  fun collect(acc, ts) = if ts is
    Cons(")", tail) then [(Success \ DataList \ reverse \ acc), tail]
    Cons and parseExpr(ts) is
      [Success(datum), rest] then collect(datum :: acc, rest)
      [Failure(_) as failure, rest] then [failure, rest]
    Nil then [Failure("Unexpected end of input, expect either `)` or more tokens."), Nil]
  collect(Nil, tokens)

fun showParse(source: Str): Str =
  if parseExpr(tokenize(source)) is
    [Success(datum), _] then "Ok: " + showData(datum)
    [Failure(error), _] then "Error: " + error

showParse("(cons 1 nil)")
//│ = "Ok: (cons, 1, nil)"

showParse("(cons 1 (cons 2 nil))")
//│ = "Ok: (cons, 1, (cons, 2, nil))"

showParse("(cons 1 (cons 2 (cons 3 nil)))")
//│ = "Ok: (cons, 1, (cons, 2, (cons, 3, nil)))"

showParse("(+ 1 2)")
//│ = "Ok: (+, 1, 2)"

showParse("(car (cons 1 nil))")
//│ = "Ok: (car, (cons, 1, nil))"

