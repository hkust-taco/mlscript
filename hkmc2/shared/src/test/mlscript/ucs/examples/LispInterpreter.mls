fun skipBlank(s: Str, i: Int): Int =
  if
    i < 0 then skipBlank(s, 0)
    i >= s.length then s.length
    s.charCodeAt(i) == 32 then skipBlank(s, i + 1)
    else i

fun scanWhile(s: Str, i: Int, p: Str -> Bool): Option[[Str, Int]] =
  fun aux(acc, i) =
    if i < s.length and s.charAt(i) is ch and p(ch)
      then aux(acc + ch, i + 1)
      else [acc, i]
  if aux("", i) is
    ["", _] then None
    [acc, i] then Some([acc, i])

fun isDelimiter(ch) = ch !== " " and ch !== "(" and ch !== ")"

fun nextToken(s: Str, i: Int): Option[[Str, Int]] =
  let i' = skipBlank(s, i)
  if s.charAt(i') is
    "(" then Some(["(", i' + 1])
    ")" then Some([")", i' + 1])
    else scanWhile(s, i', isDelimiter)

fun tokenize(s: Str): Stack[Str] =
  let s' = String(s)
  fun aux(acc, i) =
    if nextToken(s', i) is
      None then reverse(acc)
      Some([token, i']) then aux(token :: acc, i')
  aux(Nil, 0)

render \ tokenize("")
//│ = "Nil"

render \ tokenize("12")
//│ = "Cons(\"12\", Nil)"

render \ tokenize("x")
//│ = "Cons(\"x\", Nil)"

render \ tokenize("(quote (cons 1 nil))")
//│ = "Cons(\"(\", Cons(\"quote\", Cons(\"(\", Cons(\"cons\", Cons(\"1\", Cons(\"nil\", Cons(\")\", Cons(\")\", Nil))))))))"

render \ tokenize("(+ 1 2)")
//│ = "Cons(\"(\", Cons(\"+\", Cons(\"1\", Cons(\"2\", Cons(\")\", Nil)))))"

