:ucs normalized

fun test(x) = if x is
  Int then "Int"
  0 then "Zero"
//│ Normalized:
//│ >  ‹if|while›
//│ >    let tmp:scrut = x⁰
//│ >    tmp:scrut is member:Int⁰^term:test⁰ then "Int"

test(0)
//│ = "Int"

fun test(x, p) = if x is
  Int and p(x) then "foo"
  0 then "bar"
  else "qax"
//│ Normalized:
//│ >  ‹if|while›
//│ >    let tmp:scrut = x¹
//│ >    tmp:scrut is refined member:Int⁰^term:test¹ and
//│ >      let tmp:scrut = p⁰(x¹)
//│ >      tmp:scrut is true then "foo"
//│ >      tmp:scrut is 0 then "bar"
//│ >      else "qax"
//│ >    else "qax"

fun test(x, p) = if x is
  Str and p(x) then "foo"
  "lol" then "bar"
  else "qax"
//│ Normalized:
//│ >  ‹if|while›
//│ >    let tmp:scrut = x²
//│ >    tmp:scrut is refined member:Str⁰^term:test² and
//│ >      let tmp:scrut = p¹(x²)
//│ >      tmp:scrut is true then "foo"
//│ >      tmp:scrut is "lol" then "bar"
//│ >      else "qax"
//│ >    else "qax"

test("test", _ => true)
//│ = "foo"

test("lol", _ => true)
//│ = "foo"

test("lol", _ => false)
//│ = "bar"

test("", _ => false)
//│ = "qax"

fun test(x, p) = if x is
  Num and p(x) then "great"
  2.71828 then "E"
  3.14159 then "PI"
  else "other"
//│ Normalized:
//│ >  ‹if|while›
//│ >    let tmp:scrut = x³
//│ >    tmp:scrut is refined member:Num⁰^term:test³ and
//│ >      let tmp:scrut = p²(x³)
//│ >      tmp:scrut is true then "great"
//│ >      tmp:scrut is 2.71828 then "E"
//│ >      tmp:scrut is 3.14159 then "PI"
//│ >      else "other"
//│ >    else "other"

fun test(x, p) = if x is
  Bool and p(x) then "great"
  true then "false"
  false then "true"
//│ Normalized:
//│ >  ‹if|while›
//│ >    let tmp:scrut = x⁴
//│ >    tmp:scrut is refined member:Bool⁰^term:test⁴ and
//│ >      let tmp:scrut = p³(x⁴)
//│ >      tmp:scrut is true then "great"
//│ >      tmp:scrut is true then "false"
//│ >      tmp:scrut is false then "true"

fun test(x, p) = if x is
  Object and p(x) then "great"
  Bool and p(x) then "great, again"
  true then "false"
  false then "true"
//│ Normalized:
//│ >  ‹if|while›
//│ >    let tmp:scrut = x⁵
//│ >    tmp:scrut is member:Object⁰^term:test⁵ and
//│ >      let tmp:scrut = p⁴(x⁵)
//│ >      tmp:scrut is true then "great"
//│ >    tmp:scrut is refined member:Bool⁰^term:test⁵ and
//│ >      let tmp:scrut = p⁴(x⁵)
//│ >      tmp:scrut is true then "great, again"
//│ >      tmp:scrut is true then "false"
//│ >      tmp:scrut is false then "true"

object Foo

fun f(arg) = if
  arg is
    undefined then "undefined"
    null      then "null"
    Object    then String(arg)
//│ Normalized:
//│ >  ‹if|while›
//│ >    let tmp:scrut = arg⁰
//│ >    tmp:scrut is undefined then "undefined"
//│ >    tmp:scrut is null then "null"
//│ >    tmp:scrut is member:Object⁰^term:f⁰ then member:String⁰^term:f⁰(arg⁰)

f of undefined
//│ = "undefined"

f of null
//│ = "null"

f of Foo
//│ = "Foo"

fun f(arg) = if
  arg is
    Object    then String(arg)
    undefined then "undefined"
    null      then "null"
//│ Normalized:
//│ >  ‹if|while›
//│ >    let tmp:scrut = arg¹
//│ >    tmp:scrut is member:Object⁰^term:f¹ then member:String⁰^term:f¹(arg¹)
//│ >    tmp:scrut is undefined then "undefined"
//│ >    tmp:scrut is null then "null"

f of undefined
//│ = "undefined"

f of null
//│ = "null"

f of Foo
