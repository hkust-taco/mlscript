:js
:ucs normalized

fun test(x) = if x is
  Int then "Int"
  0 then "Zero"
//│ Normalized:
//│ >  ‹if|while› x⁰ is Int then "Int"

test(0)
//│ = "Int"

fun test(x, p) = if x is
  Int and p(x) then "foo"
  0 then "bar"
  else "qax"
//│ Normalized:
//│ >  ‹if|while›
//│ >    x¹ is refined Int and
//│ >      let tmp:scrut⁰ = p⁰(x¹)
//│ >      tmp:scrut⁰ is true then "foo"
//│ >      x¹ is 0 then "bar"
//│ >      else "qax"
//│ >    else "qax"

fun test(x, p) = if x is
  Str and p(x) then "foo"
  "lol" then "bar"
  else "qax"
//│ Normalized:
//│ >  ‹if|while›
//│ >    x² is refined Str and
//│ >      let tmp:scrut¹ = p¹(x²)
//│ >      tmp:scrut¹ is true then "foo"
//│ >      x² is "lol" then "bar"
//│ >      else "qax"
//│ >    else "qax"

test("test", _ => true)
//│ = "foo"

test("lol", _ => true)
//│ = "foo"

test("lol", _ => false)
//│ = "bar"

test("", _ => false)
//│ = "qax"

fun test(x, p) = if x is
  Num and p(x) then "great"
  2.71828 then "E"
  3.14159 then "PI"
  else "other"
//│ Normalized:
//│ >  ‹if|while›
//│ >    x³ is refined Num and
//│ >      let tmp:scrut² = p²(x³)
//│ >      tmp:scrut² is true then "great"
//│ >      x³ is 2.71828 then "E"
//│ >      x³ is 3.14159 then "PI"
//│ >      else "other"
//│ >    else "other"

fun test(x, p) = if x is
  Bool and p(x) then "great"
  true then "false"
  false then "true"
//│ Normalized:
//│ >  ‹if|while› x⁴ is refined Bool and
//│ >    let tmp:scrut³ = p³(x⁴)
//│ >    tmp:scrut³ is true then "great"
//│ >    x⁴ is true then "false"
//│ >    x⁴ is false then "true"

fun test(x, p) = if x is
  Object and p(x) then "great"
  Bool and p(x) then "great, again"
  true then "false"
  false then "true"
//│ Normalized:
//│ >  ‹if|while›
//│ >    x⁵ is Object and
//│ >      let tmp:scrut⁴ = p⁴(x⁵)
//│ >      tmp:scrut⁴ is true then "great"
//│ >    x⁵ is refined Bool and
//│ >      let tmp:scrut⁵ = p⁴(x⁵)
//│ >      tmp:scrut⁵ is true then "great, again"
//│ >      x⁵ is true then "false"
//│ >      x⁵ is false then "true"

object Foo

fun f(arg) = if
  arg is
    undefined then "undefined"
    null      then "null"
    Object    then String(arg)
//│ Normalized:
//│ >  ‹if|while›
//│ >    arg⁰ is undefined then "undefined"
//│ >    arg⁰ is null then "null"
//│ >    arg⁰ is Object then member:String⁰(arg⁰)

f of undefined
//│ = "undefined"

f of null
//│ = "null"

f of Foo
//│ = "Foo"

fun f(arg) = if
  arg is
    Object    then String(arg)
    undefined then "undefined"
    null      then "null"
//│ Normalized:
//│ >  ‹if|while›
//│ >    arg¹ is Object then member:String⁰(arg¹)
//│ >    arg¹ is undefined then "undefined"
//│ >    arg¹ is null then "null"

f of undefined
//│ = "undefined"

f of null
//│ = "null"

f of Foo
//│ = "Foo"

fun f(arg) = if arg is
  Object then String(arg)
  Foo then "just Foo"
//│ Normalized:
//│ >  ‹if|while› arg² is Object then member:String⁰(arg²)

import "../../../mlscript-compile/Runtime.mls"

fun f(arg) = if arg is
  Object then String(arg)
  Runtime.MatchSuccess then "just Foo"
//│ Normalized:
//│ >  ‹if|while› arg³ is Object then member:String⁰(arg³)

fun f(arg) = if arg is
  Foo then "just Foo"
  Object then String(arg)
//│ Normalized:
//│ >  ‹if|while›
//│ >    arg⁴ is Foo then "just Foo"
//│ >    arg⁴ is Object then member:String⁰(arg⁴)

fun f(arg) = if arg is
  Int then "Int"
  Object then String(arg)
