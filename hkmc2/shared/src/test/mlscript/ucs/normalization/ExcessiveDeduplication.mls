// * Contemplate this absolutely horrendous code (before optimization):
:sir
:soir
:sjs
if false do ()
123
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ 123
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut;
//│ block split_root$:
//│   block split_1$:
//│     set scrut = false;
//│     match scrut
//│       true =>
//│         break split_1$
//│       else
//│         break split_1$
//│     end
//│   end
//│ 123
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ 123
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 123

:patMatConsequentSharingThreshold 10

// * How it ought to be:
:sir
if false do ()
123
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut; set scrut = false; 123
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 123


object Obj with
  fun test =
    print("hi")
    false

:sjs
if Obj.test do ()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ Obj1.test; runtime.Unit
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi



