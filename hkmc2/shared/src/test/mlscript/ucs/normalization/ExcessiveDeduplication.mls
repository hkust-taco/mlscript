:js
:patMatConsequentSharingThreshold 1
// ^ force dedup even for small consequents


let
  x = true
  y = 2
  z = true
//│ x = true
//│ y = 2
//│ z = true


// TODO: This should *not* be automatically deduplicated.
// * In fact, we should probably never try to deduplicate things that are already duplicated in the source.
:sjs
if
  x then 0
  y then 0
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (x === true) {
//│   0
//│ } else {
//│   if (y === true) {
//│     0
//│   } else { throw globalThis.Object.freeze(new globalThis.Error("match error")) }
//│ }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

// * Compare with:
:sjs
if
  x then 0
  y then 1
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (x === true) {
//│   0
//│ } else {
//│   if (y === true) {
//│     1
//│   } else { throw globalThis.Object.freeze(new globalThis.Error("match error")) }
//│ }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0


// * Sharing is now implemented via `LetSplit` / `UseSplit` join points during normalization
// * (see `Normalization.normalizeImpl`). However, when the consequent references the shared
// * alternative at most once (refCount ≤ 1), the alternative is inlined instead of being
// * hoisted behind a label, since a label wrapper would only pay for itself with multiple
// * reuses. That is the case here, so the alternative below is duplicated:
:ssjs
:ucs normalized
if
  x and z then 1
  y is [b] then let x = 1 in x + b
//│ Normalized:
//│ >  ‹if|while›
//│ >    x is true and
//│ >      z is true then 1
//│ >      y is []=1 and
//│ >        let tmp:element0$ = ((tmp:runtime⁰.)Tuple.)get‹term:get›(y⁰, 0)
//│ >        let b = tmp:element0$⁰
//│ >        else
//│ >          let x
//│ >          x = 1
//│ >          builtin:+⁰(x⁰, b⁰)
//│ >    y is []=1 and
//│ >      let tmp:element0$ = ((tmp:runtime⁰.)Tuple.)get‹term:get›(y⁰, 0)
//│ >      let b = tmp:element0$⁰
//│ >      else
//│ >        let x
//│ >        x = 1
//│ >        builtin:+⁰(x⁰, b⁰)
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ let b, x1, element0$;
//│ if (x === true) {
//│   if (z === true) {
//│     block$res4 = 1;
//│     undefined
//│   } else {
//│     if (runtime.Tuple.isArrayLike(y) && y.length === 1) {
//│       element0$ = runtime.checkCall(runtime.Tuple.get(y, 0));
//│       b = element0$;
//│       x1 = 1;
//│       block$res4 = x1 + b;
//│       undefined
//│     } else {
//│       throw globalThis.Object.freeze(new globalThis.Error("match error"))
//│     }
//│   }
//│ } else {
//│   if (runtime.Tuple.isArrayLike(y) && y.length === 1) {
//│     element0$ = runtime.checkCall(runtime.Tuple.get(y, 0));
//│     b = element0$;
//│     x1 = 1;
//│     block$res4 = x1 + b;
//│     undefined
//│   } else { throw globalThis.Object.freeze(new globalThis.Error("match error")) }
//│ }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

// * With a consequent that references the alternative more than once, the join-point
// * sharing does kick in and we get output shaped like:
// >  if
// >    let-split $j =
// >      y is Some(argument0$) and
// >        let b = $argument0$
// >        else
// >          let x
// >          x = 1
// >          builtin:+(x, b)
// >    x is true and
// >      z is true then 1
// >      $j
// >    $j


// * Note the redundant `set scrut = false` before `123` in the lowered IR below; it is
// * the remnant of a trivially-false `if false do ()` that the IR optimizer later removes.
:sir
:soir
:sjs
if false do ()
123
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ 123
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut; set scrut = false; 123
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ 123
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 123

:patMatConsequentSharingThreshold 10

// * How it ought to be:
:sir
if false do ()
123
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut; set scrut = false; 123
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 123


object Obj with
  fun test =
    print("hi")
    false

:sjs
if Obj.test do ()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ Obj1.test; runtime.Unit
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi



