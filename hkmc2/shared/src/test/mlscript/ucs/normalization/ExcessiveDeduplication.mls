:.
:js
:patMatConsequentSharingThreshold 1
// ^ force dedup even for small consequents


let
  x = true
  y = 2
  z = true
//│ x = true
//│ y = 2
//│ z = true


// * We never try to deduplicate things that are already duplicated in the source.
// * (A previous version of the UCS was using hash-consing to do so, which was a bad idea.)
:sjs
if
  x then 0
  y then 0
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let scrut, scrut1;
//│ scrut = x;
//│ if (scrut === true) {
//│   return 0
//│ }
//│ scrut1 = y;
//│ if (scrut1 === true) {
//│   return 0
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

// * Compare with:
:sjs
if
  x then 0
  y then 1
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let scrut2, scrut3;
//│ scrut2 = x;
//│ if (scrut2 === true) {
//│   return 0
//│ }
//│ scrut3 = y;
//│ if (scrut3 === true) {
//│   return 1
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0


// * The last split is `y is [b] then ...`. It used to be duplicated because it serves
// * as the alternative split when `x` or `z` fails. Now we bind the split to a
// * split symbol and use it as the alternative splits of `x` and `z`.
:ssjs
:ucs normalized
if
  x and z then 1
  y is [b] then let x = 1 in x + b
//│ Normalized:
//│ >  ‹if|while›
//│ >    let tmp:scrut = x⁰
//│ >    let-split σ =
//│ >      let tmp:scrut = y⁰
//│ >      tmp:scrut is []=1 and
//│ >        let tmp:element0$ = ((tmp:runtime⁰.)Tuple‹module:Tuple›.)get‹term:Tuple/get›(tmp:scrut⁰, 0)
//│ >        let b = tmp:element0$⁰
//│ >        else
//│ >          let x
//│ >          x = 1
//│ >          builtin:+⁰(x¹, b⁰)
//│ >    tmp:scrut is true and
//│ >      let tmp:scrut = z⁰
//│ >      tmp:scrut is true then 1
//│ >      $σ
//│ >    $σ
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ let scrut4, scrut5, scrut6, element0$, tmp;
//│ scrut4 = x;
//│ σ$x: {
//│   if (scrut4 === true) {
//│     scrut5 = z;
//│     if (scrut5 === true) {
//│       tmp = 1;
//│       break σ$x
//│     }
//│   }
//│   scrut6 = y;
//│   if (runtime.Tuple.isArrayLike(scrut6) && scrut6.length === 1) {
//│     element0$ = runtime.checkCall(runtime.Tuple.get(scrut6, 0));
//│     tmp = 1 + element0$;
//│   } else { throw globalThis.Object.freeze(new globalThis.Error("match error")) }
//│ }
//│ block$res5 = tmp;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

// * The original draft of let-split constructs:
// >  if
// >    let-split $j =
// >      y is Some(argument0$) and
// >        let b = $argument0$
// >        else
// >          let x
// >          x = 1
// >          builtin:+(x, b)
// >    x is true and
// >      z is true then 1
// >      $j
// >    $j


// * The lowered IR keeps a `set scrut = false` from `if false do ()`. The optimizer
// * drops it:
:sir
:soir
:sjs
if false do ()
123
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut; set scrut = false; return 123
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ return 123
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ return 123
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 123

:patMatConsequentSharingThreshold 10

// * How it ought to be:
:sir
if false do ()
123
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut; set scrut = false; return 123
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 123


object Obj with
  fun test =
    print("hi")
    false

:sjs
if Obj.test do ()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ Obj1.test; return runtime.Unit
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi



