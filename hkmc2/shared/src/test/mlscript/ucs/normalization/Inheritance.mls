:js


class A
class B extends A

:breakme // Should warn that the `B` branch is unreachable
let f = case
  A then "A"
  B then "B"
//│ f = fun f

f(new A)
//│ = "A"

f(new B)
//│ = "A"


let f = case
  B then "B"
  A then "A"
//│ f = fun f

f(new A)
//│ = "A"

f(new B)
//│ = "B"


:sir
let f = case
  A & B then "A & B"
  A then "A"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f⁰, lambda⁰;
//│ define lambda⁰ as fun lambda¹(caseScrut) {
//│   block split_root$:
//│     block split_default$:
//│       match caseScrut
//│         A⁰ =>
//│           match caseScrut
//│             B⁰ =>
//│               return "A & B"
//│             A⁰ =>
//│               return "A"
//│             else
//│               break split_default$
//│           end
//│         else
//│           break split_default$
//│       end
//│     throw new globalThis⁰.Error⁰("match error")
//│   return runtime⁰.Unit⁰
//│ };
//│ set f⁰ = lambda¹;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f = fun

:expect "A"
f(new A)
//│ = "A"

:expect "A & B"
f(new B)
//│ = "A & B"


