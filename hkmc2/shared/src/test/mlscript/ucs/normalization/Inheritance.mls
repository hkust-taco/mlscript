:js


class A
class B extends A

:breakme // Should warn that the `B` branch is unreachable
let f = case
  A then "A"
  B then "B"
//│ f = fun f

f(new A)
//│ = "A"

f(new B)
//│ = "A"


let f = case
  B then "B"
  A then "A"
//│ f = fun f

f(new A)
//│ = "A"

f(new B)
//│ = "B"


:sir
let f = case
  A & B then "A & B"
  A then "A"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f⁰, lambda⁰;
//│ define lambda⁰ as fun lambda¹(caseScrut) {
//│   match caseScrut
//│     A⁰ =>
//│       match caseScrut
//│         B⁰ =>
//│           return "A & B"
//│         else
//│           return "A"
//│       end
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ set f⁰ = lambda¹;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f = fun

:expect "A"
f(new A)
//│ = "A"

:expect "A & B"
f(new B)
//│ = "A & B"


// Cross-file import test: verify isSubclassOf works with imported classes.
// Token.mls defines: abstract class Token; class Space() extends Token; class Error() extends Token; etc.
// Space and Error are siblings (both extend Token), so they should be disjoint.

import "../../../mlscript-compile/apps/parsing/Token.mls"
open Token { Space, Error }

:sir
let g = case
  Space & Error then "Space & Error"
  Space then "Space"
  Error then "Error"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let g⁰, g¹;
//│ define g¹ as fun g²(caseScrut) {
//│   match caseScrut
//│     Space⁰ =>
//│       return "Space"
//│     Error¹ =>
//│       return "Error"
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ set g⁰ = g²;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ g = fun g

:expect "Space"
g(Space())
//│ = "Space"

:expect "Error"
g(Error())
//│ = "Error"

