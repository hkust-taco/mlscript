:js


// === No join point cases ===


// * No join point: alternative is End (single branch, no fallback to share)
:sir
fun f1(x) = if x is 0 then "zero"
f1(0)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f1⁰;
//│ define f1⁰ as fun f1¹(x) {
//│   match x
//│     0 =>
//│       return "zero"
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ f1¹(0)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "zero"

// * No join point: consequent is full, so alternative is unreachable in true branch
:sir
fun f2(x) = if x is
  0 then "zero"
  _ then "other"
f2(0)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f2⁰; define f2⁰ as fun f2¹(x) { match x 0 => return "zero" else return "other" end }; f2¹(0)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "zero"

// * No join point: alternative references the same scrutinee
// * (specialization transforms it differently on each side)
data class A(x)
data class B(y)

:sir
fun f3(v) = if v is
  A(0) then "A0"
  A(x) then "A"
  B(y) then "B"
f3(A(0))
f3(A(1))
f3(B(2))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f3⁰, tmp, tmp1, tmp2;
//│ define f3⁰ as fun f3¹(v) {
//│   let x, y, arg$B$0$, arg$A$0$;
//│   match v
//│     A⁰ =>
//│       set arg$A$0$ = v.x⁰;
//│       match arg$A$0$
//│         0 =>
//│           return "A0"
//│         else
//│           set x = arg$A$0$;
//│           return "A"
//│       end
//│     B⁰ =>
//│       set arg$B$0$ = v.y⁰;
//│       set y = arg$B$0$;
//│       return "B"
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ set tmp = A¹(0);
//│ do f3¹(tmp);
//│ set tmp1 = A¹(1);
//│ do f3¹(tmp1);
//│ set tmp2 = B¹(2);
//│ f3¹(tmp2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "B"


// === Join point cases ===


// * Join point: non-trivial Else alternative on different scrutinee
:sir
fun f4(x, y) = if
  x is 0 then "x=0"
  y is 1 then "y=1"
  else "neither"
f4(0, 9)
f4(9, 1)
f4(9, 9)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f4⁰;
//│ define f4⁰ as fun f4¹(x, y) {
//│   match x
//│     0 =>
//│       return "x=0"
//│     else
//│       match y
//│         1 =>
//│           return "y=1"
//│         else
//│           return "neither"
//│       end
//│   end
//│ };
//│ do f4¹(0, 9);
//│ do f4¹(9, 1);
//│ f4¹(9, 9)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "neither"

// * Join point: multi-branch alternative, different scrutinee
:sir
fun f5(x, y) = if
  x is 0 then "x=0"
  y is 1 then "y=1"
  y is 2 then "y=2"
f5(0, 9)
f5(9, 1)
f5(9, 2)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f5⁰;
//│ define f5⁰ as fun f5¹(x, y) {
//│   match x
//│     0 =>
//│       return "x=0"
//│     else
//│       match y
//│         1 =>
//│           return "y=1"
//│         2 =>
//│           return "y=2"
//│         else
//│           throw new globalThis⁰.Error⁰("match error")
//│       end
//│   end
//│ };
//│ do f5¹(0, 9);
//│ do f5¹(9, 1);
//│ f5¹(9, 2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "y=2"

// * Join point: deeply nested class patterns share the default branch
data class S(value)

:sir
fun f6(v) = if v is
  S(S(S(0))) then "deep"
  _ then "default"
f6(S(S(S(0))))
f6(S(S(S(1))))
f6(S(S(42)))
f6(S(42))
f6(42)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f6⁰, tmp, tmp1, tmp2, tmp3, tmp4, tmp5, tmp6, tmp7, tmp8;
//│ define f6⁰ as fun f6¹(v) {
//│   let arg$S$0$, arg$S$0$1, arg$S$0$2;
//│   match v
//│     S⁰ =>
//│       set arg$S$0$ = v.value⁰;
//│       match arg$S$0$
//│         S⁰ =>
//│           set arg$S$0$1 = arg$S$0$.value⁰;
//│           match arg$S$0$1
//│             S⁰ =>
//│               set arg$S$0$2 = arg$S$0$1.value⁰;
//│               match arg$S$0$2
//│                 0 =>
//│                   return "deep"
//│                 else
//│                   return "default"
//│               end
//│             else
//│               return "default"
//│           end
//│         else
//│           return "default"
//│       end
//│     else
//│       return "default"
//│   end
//│ };
//│ set tmp = S¹(0);
//│ set tmp1 = S¹(tmp);
//│ set tmp2 = S¹(tmp1);
//│ do f6¹(tmp2);
//│ set tmp3 = S¹(1);
//│ set tmp4 = S¹(tmp3);
//│ set tmp5 = S¹(tmp4);
//│ do f6¹(tmp5);
//│ set tmp6 = S¹(42);
//│ set tmp7 = S¹(tmp6);
//│ do f6¹(tmp7);
//│ set tmp8 = S¹(42);
//│ do f6¹(tmp8);
//│ f6¹(42)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "default"

// * Join point: default branch with a computation should not be duplicated
:sir
fun f7(v) = if v is
  S(S(0)) then 0
  _ then S(S(S(99)))
f7(S(S(0)))
f7(42)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f7⁰, tmp, tmp1;
//│ define f7⁰ as fun f7¹(v) {
//│   let arg$S$0$, arg$S$0$1, tmp2, tmp3;
//│   block σ:
//│     match v
//│       S⁰ =>
//│         set arg$S$0$ = v.value⁰;
//│         match arg$S$0$
//│           S⁰ =>
//│             set arg$S$0$1 = arg$S$0$.value⁰;
//│             match arg$S$0$1
//│               0 =>
//│                 return 0
//│               else
//│                 break σ
//│             end
//│           else
//│             break σ
//│         end
//│       else
//│         break σ
//│     end
//│   set tmp2 = S¹(99);
//│   set tmp3 = S¹(tmp2);
//│   return S¹(tmp3)
//│ };
//│ set tmp = S¹(0);
//│ set tmp1 = S¹(tmp);
//│ do f7¹(tmp1);
//│ f7¹(42)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = S(S(S(99)))

// * Join point used only from the false branch (consequent is not full,
// * but after specialization the UseSplit is consumed)
:sir
fun f8(x, y) = if
  x is 0 and y is 0 then "both zero"
  else "fallback"
f8(0, 0)
f8(0, 1)
f8(1, 0)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f8⁰;
//│ define f8⁰ as fun f8¹(x, y) {
//│   match x
//│     0 =>
//│       match y
//│         0 =>
//│           return "both zero"
//│         else
//│           return "fallback"
//│       end
//│     else
//│       return "fallback"
//│   end
//│ };
//│ do f8¹(0, 0);
//│ do f8¹(0, 1);
//│ f8¹(1, 0)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "fallback"

// * Join-point threshold scales with the number of references: this fallback
// * is small enough that two references would not pass threshold 2, but three
// * surviving references should still be shared.
:sir
:patMatConsequentSharingThreshold 2
fun f8b(x, y, z) = if
  x is 0 and y is 0 and z is 0 then "all zero"
  else "fallback"
f8b(0, 0, 0)
f8b(0, 0, 1)
f8b(0, 1, 0)
f8b(1, 0, 0)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f8b⁰;
//│ define f8b⁰ as fun f8b¹(x, y, z) {
//│   block σ:
//│     match x
//│       0 =>
//│         match y
//│           0 =>
//│             match z
//│               0 =>
//│                 return "all zero"
//│               else
//│                 break σ
//│             end
//│           else
//│             break σ
//│         end
//│       else
//│         break σ
//│     end
//│   return "fallback"
//│ };
//│ do f8b¹(0, 0, 0);
//│ do f8b¹(0, 0, 1);
//│ do f8b¹(0, 1, 0);
//│ f8b¹(1, 0, 0)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "fallback"


// === Normalized IR checks ===


// * Verify LetSplit appears in normalized output:
// * The consequent `x is 0 and y is 0 then ...` is not full, and
// * the alternative `else "fallback"` doesn't reference `x`.
:ucs normalized
fun f9(x, y) = if
  x is 0 and y is 0 then "match"
  else "fallback"
//│ Normalized:
//│ >  ‹if|while›
//│ >    x is 0 and
//│ >      y is 0 then "match"
//│ >      else "fallback"
//│ >    else "fallback"


// * Verify no LetSplit when alternative references same scrutinee
:ucs normalized
fun f10(v) = if v is
  A(0) then "A0"
  A(x) then "A"
  B(y) then "B"
//│ Normalized:
//│ >  ‹if|while›
//│ >    v is A(arg$A$0$) and
//│ >      tmp:arg$A$0$ is 0 then "A0"
//│ >      let x = tmp:arg$A$0$⁰
//│ >      else "A"
//│ >    v is B(arg$B$0$) and
//│ >      let y = tmp:arg$B$0$⁰
//│ >      else "B"


// === UseSplit preservation during specialization ===


// * When specialization encounters a UseSplit whose body references the
// * current scrutinee but the patterns are unrelated (Dog vs Cat),
// * the specialization is a no-op and the UseSplit should be preserved
// * rather than inlined (to maintain sharing via the join point).

data class Cat()
data class Dog()

// * The alternative `y is Dog then ... else ...` does not reference x, so
// * normalizeImpl creates a UseSplit for it. During inner normalization of
// * `y is Cat then ... ++ UseSplit(σ)`, specialization with `y is Cat`
// * encounters the UseSplit. Its body tests `y is Dog` — unrelated to Cat
// * in negative mode (Case 1.2.2) — so specialization returns N and the
// * UseSplit is preserved.
:sir
:ucs normalized
fun f11(x, y) = if
  x is Cat() and y is Cat() then 1
  y is Dog() then 2
  else 3
//│ Normalized:
//│ >  ‹if|while›
//│ >    x is Cat() and
//│ >      y is Cat() then 1
//│ >      y is Dog() then 2
//│ >      else 3
//│ >    y is Dog() then 2
//│ >    else 3
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f11⁰;
//│ define f11⁰ as fun f11¹(x, y) {
//│   match x
//│     Cat⁰ =>
//│       match y
//│         Cat⁰ =>
//│           return 1
//│         Dog⁰ =>
//│           return 2
//│         else
//│           return 3
//│       end
//│     else
//│       match y
//│         Dog⁰ =>
//│           return 2
//│         else
//│           return 3
//│       end
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f11(Cat(), Cat())
f11(Cat(), Dog())
f11(Dog(), Cat())
f11(Dog(), Dog())
//│ = 2

// * Similar case, but with three scrutinee-crossing branches. The fallback
// * is shared across multiple match levels.
:sir
fun f12(x, y) = if
  x is Cat() and y is Cat() then "cc"
  x is Dog() and y is Dog() then "dd"
  y is Dog() then "yd"
  else "other"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f12⁰;
//│ define f12⁰ as fun f12¹(x, y) {
//│   match x
//│     Cat⁰ =>
//│       match y
//│         Cat⁰ =>
//│           return "cc"
//│         Dog⁰ =>
//│           return "yd"
//│         else
//│           return "other"
//│       end
//│     Dog⁰ =>
//│       match y
//│         Dog⁰ =>
//│           return "dd"
//│         else
//│           return "other"
//│       end
//│     else
//│       match y
//│         Dog⁰ =>
//│           return "yd"
//│         else
//│           return "other"
//│       end
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f12(Cat(), Cat())
f12(Dog(), Dog())
f12(Cat(), Dog())
f12(Dog(), Cat())
//│ = "other"
