:js
:patMatConsequentSharingThreshold 5

let x = 0
let y = 0
let z = 0
//│ x = 0
//│ y = 0
//│ z = 0

:sjs
if x === 0 then 1 else 2
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let scrut; scrut = x === 0; if (scrut === true) { 1 } else { 2 }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

:sjs
let a = if x === 0 then 1 else 2
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let a, scrut1, tmp; scrut1 = x === 0; if (scrut1 === true) { tmp = 1; } else { tmp = 2; } a = tmp;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ a = 1

:sjs
print of if x === 0 then 1 else 2
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let scrut2; scrut2 = x === 0; if (scrut2 === true) { Predef.print(1) } else { Predef.print(2) }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1

:sjs
if x is
  0 and y is
    0 and z is
      0 then "000"
      1 then "001"
    1 then "01"
  1 then "1"
  else ""
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ switch (x) {
//│   case 0:
//│     switch (y) {
//│       case 0:
//│         switch (z) {
//│           case 0:
//│             "000";
//│             break;
//│           case 1:
//│             "001";
//│             break;
//│           default:
//│             "";
//│         }
//│         break;
//│       case 1:
//│         "01";
//│         break;
//│       default:
//│         "";
//│     }
//│     break;
//│   case 1:
//│     "1";
//│     break;
//│   default:
//│     "";
//│ }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "000"

// * Making the terms artificially big to force sharing of consequents
:sjs
if x is
  0 and y is
    0 and z is
      0 then "000-------------------------------------------------------------------------"
      1 then "001-------------------------------------------------------------------------"
    1 then "01-------------------------------------------------------------------------"
  1 then "1-------------------------------------------------------------------------"
  else "-------------------------------------------------------------------------"
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp1;
//│ split_root$: {
//│   switch (x) {
//│     case 0:
//│       switch (y) {
//│         case 0:
//│           switch (z) {
//│             case 0:
//│               tmp1 = "000-------------------------------------------------------------------------";
//│               break split_root$;
//│             case 1:
//│               tmp1 = "001-------------------------------------------------------------------------";
//│               break split_root$;
//│           }
//│           break;
//│         case 1:
//│           tmp1 = "01-------------------------------------------------------------------------";
//│           break split_root$;
//│       }
//│       break;
//│     case 1:
//│       tmp1 = "1-------------------------------------------------------------------------";
//│       break split_root$;
//│   }
//│   tmp1 = "-------------------------------------------------------------------------";
//│ }
//│ tmp1
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "000-------------------------------------------------------------------------"

