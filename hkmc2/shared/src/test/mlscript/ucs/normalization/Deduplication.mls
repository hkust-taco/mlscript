:sir
fun foo(x, y, z) =
  if x is
    0 and y is
      0 and z is
        0 then "000"
        1 then "001"
      1 then "01"
    1 then "1"
    else ""
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define foo⁰ as fun foo¹(x, y, z) {
//│   let scrut, scrut1, scrut2;
//│   set scrut = x;
//│   match scrut
//│     0 =>
//│       set scrut1 = y;
//│       match scrut1
//│         0 =>
//│           set scrut2 = z;
//│           match scrut2
//│             0 =>
//│               return "000"
//│             1 =>
//│               return "001"
//│             else
//│               return ""
//│           end
//│         1 =>
//│           return "01"
//│         else
//│           return ""
//│       end
//│     1 =>
//│       return "1"
//│     else
//│       return ""
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

foo(0, 0, 0)
//│ = "000"

:sir
print of if
  x is 0 and
    y is 0 and
      z is 0 then "000"
    y is 1 then "01_"
    z is 1 then "0_1"
  x is 1 then "1__"
  y is 2 then "_2_"
  else "___"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut, scrut1, scrut2, scrut3, scrut4, scrut5, scrut6, tmp, tmp1, tmp2;
//│ set scrut = x⁰;
//│ block σ$x:
//│   block σ:
//│     match scrut
//│       0 =>
//│         set scrut1 = y⁰;
//│         block σ$x1:
//│           block σ1:
//│             match scrut1
//│               0 =>
//│                 set scrut2 = z⁰;
//│                 match scrut2
//│                   0 =>
//│                     set tmp1 = "000";
//│                     break σ$x1
//│                   else
//│                     break σ1
//│                 end
//│               else
//│                 break σ1
//│             end
//│           set scrut3 = y⁰;
//│           match scrut3
//│             1 =>
//│               set tmp1 = "01_";
//│               break σ$x1
//│             else
//│               set scrut4 = z⁰;
//│               match scrut4
//│                 1 =>
//│                   set tmp1 = "0_1";
//│                   break σ$x1
//│                 else
//│                   break σ
//│               end
//│           end
//│         set tmp = tmp1;
//│         break σ$x
//│       else
//│         break σ
//│     end
//│   set scrut5 = x⁰;
//│   match scrut5
//│     1 =>
//│       set tmp = "1__";
//│       break σ$x
//│     else
//│       set scrut6 = y⁰;
//│       match scrut6
//│         2 =>
//│           set tmp = "_2_";
//│           break σ$x
//│         else
//│           set tmp = "___";
//│           break σ$x
//│       end
//│   end
//│ set tmp2 = tmp;
//│ return Predef⁰.print⁰(tmp2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 000

:ucs normalized deduplicated
// `SplitDeduplicator` can detect more split-level duplications.
fun foo(x, y, z) = if
  x is 0 and
    y is 0 and
      z is 0 then "000"
    y is 1 then "01_"
    z is 1 then "0_1"
  x is 1 then "1__"
  y is 2 then "_2_"
  else "___"
//│ Normalized:
//│ >  ‹if|while›
//│ >    let tmp:scrut = x¹
//│ >    let-split σ =
//│ >      let tmp:scrut = x¹
//│ >      tmp:scrut is 1 then "1__"
//│ >      let tmp:scrut = y¹
//│ >      tmp:scrut is 2 then "_2_"
//│ >      else "___"
//│ >    tmp:scrut is 0 and
//│ >      let tmp:scrut = y¹
//│ >      let-split σ =
//│ >        let tmp:scrut = y¹
//│ >        tmp:scrut is 1 then "01_"
//│ >        let tmp:scrut = z¹
//│ >        tmp:scrut is 1 then "0_1"
//│ >        $σ
//│ >      tmp:scrut is 0 and
//│ >        let tmp:scrut = z¹
//│ >        tmp:scrut is 0 then "000"
//│ >        $σ
//│ >      $σ
//│ >    $σ

fun expensive_call(str: Str) = Math.pow(2, str.length)

:sir
fun foo(x, y, z) = if x is
  0 and y is
    0 and z is
      0 then "000"
      1 then "001"
    1 then "01"
  1 then "1"
  else
    let value = "hello"
    expensive_call(value)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define foo² as fun foo³(x, y, z) {
//│   let scrut, scrut1, scrut2, value;
//│   set scrut = x;
//│   match scrut
//│     0 =>
//│       set scrut1 = y;
//│       match scrut1
//│         0 =>
//│           set scrut2 = z;
//│           match scrut2
//│             0 =>
//│               return "000"
//│             1 =>
//│               return "001"
//│             else
//│               set value = "hello";
//│               return expensive_call⁰((value as! Str⁰))
//│           end
//│         1 =>
//│           return "01"
//│         else
//│           set value = "hello";
//│           return expensive_call⁰((value as! Str⁰))
//│       end
//│     1 =>
//│       return "1"
//│     else
//│       set value = "hello";
//│       return expensive_call⁰((value as! Str⁰))
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

foo(0, 0, 0)
//│ = "000"


object A
object B
object C

:sir
// Since no branch is duplicated, there is no label or `break`.
fun foo(x, y, z) =
  if x is A then "Hello"
  else "Goodbye"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define foo⁴ as fun foo⁵(x, y, z) {
//│   let scrut;
//│   set scrut = x;
//│   match scrut
//│     A⁰ =>
//│       return "Hello"
//│     else
//│       return "Goodbye"
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sir
// Before the deduplication is introduced:
// let foo;
// foo = function foo(x1, y, z) {
//   if (x1 instanceof A1) {
//     if (y instanceof B1) {
//       if (z instanceof C1) {
//         return "Hello"
//       } else { return "Goodbye" }
//     } else { return "Goodbye" }
//   } else { return "Goodbye" }
// };
fun foo(x, y, z) =
  if x is A and y is B and z is C then "Hello"
  else "Goodbye"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define foo⁶ as fun foo⁷(x, y, z) {
//│   let scrut, scrut1, scrut2;
//│   set scrut = x;
//│   match scrut
//│     A⁰ =>
//│       set scrut2 = y;
//│       match scrut2
//│         B⁰ =>
//│           set scrut1 = z;
//│           match scrut1
//│             C⁰ =>
//│               return "Hello"
//│             else
//│               return "Goodbye"
//│           end
//│         else
//│           return "Goodbye"
//│       end
//│     else
//│       return "Goodbye"
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sir
// The default branch which throws the match error should be also deduplicated.
fun foo(x, y, z) =
  if x is A and y is B and z is C then "Hello"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define foo⁸ as fun foo⁹(x, y, z) {
//│   let scrut, scrut1, scrut2;
//│   set scrut = x;
//│   match scrut
//│     A⁰ =>
//│       set scrut2 = y;
//│       match scrut2
//│         B⁰ =>
//│           set scrut1 = z;
//│           match scrut1
//│             C⁰ =>
//│               return "Hello"
//│             else
//│               throw new globalThis⁰.Error⁰("match error")
//│           end
//│         else
//│           throw new globalThis⁰.Error⁰("match error")
//│       end
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect "Hello"
foo(A, B, C)
//│ = "Hello"

:re
foo(A, A, A)
//│ ═══[RUNTIME ERROR] Error: match error

:re
foo(A, B, B)
//│ ═══[RUNTIME ERROR] Error: match error

:sir
let y = if true then 1 else 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut, tmp;
//│ set scrut = true;
//│ match scrut
//│   true =>
//│     set tmp = 1;
//│     end
//│   else
//│     set tmp = 2;
//│     end
//│ set y² = tmp;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ y = 1

fun pred(x) = true

:ucs normalized
// Not only the final else is deduplicated, the `z is A` split is also deduplicated.
fun foo1(x, y, z) = if
  x is A and pred(x) then print of 1
  z is A then print of 2
  else print of 3
//│ Normalized:
//│ >  ‹if|while›
//│ >    let tmp:scrut = x²
//│ >    let-split σ =
//│ >      let tmp:scrut = z²
//│ >      tmp:scrut is member:A¹^term:foo1⁰ then member:Predef¹.print^term:foo1⁰(2)
//│ >      else member:Predef¹.print^term:foo1⁰(3)
//│ >    tmp:scrut is member:A¹^term:foo1⁰ and
//│ >      let tmp:scrut = member:pred⁰^term:foo1⁰(x²)
//│ >      tmp:scrut is true then member:Predef¹.print^term:foo1⁰(1)
//│ >      $σ
//│ >    $σ

:ucs normalized deduped
// This shows a cascaded split let-binding.
fun foo2(x, y, z) = if
  x is A and pred(x) then print of 1
  y is A and pred(y) then print of 2
  z is A then print of 3
  else print of 4
//│ Normalized:
//│ >  ‹if|while›
//│ >    let tmp:scrut = x³
//│ >    let-split σ =
//│ >      let tmp:scrut = y³
//│ >      let-split σ =
//│ >        let tmp:scrut = z³
//│ >        tmp:scrut is member:A¹^term:foo2⁰ then member:Predef¹.print^term:foo2⁰(3)
//│ >        else member:Predef¹.print^term:foo2⁰(4)
//│ >      tmp:scrut is member:A¹^term:foo2⁰ and
//│ >        let tmp:scrut = member:pred⁰^term:foo2⁰(y³)
//│ >        tmp:scrut is true then member:Predef¹.print^term:foo2⁰(2)
//│ >        $σ
//│ >      $σ
//│ >    tmp:scrut is member:A¹^term:foo2⁰ and
//│ >      let tmp:scrut = member:pred⁰^term:foo2⁰(x³)
//│ >      tmp:scrut is true then member:Predef¹.print^term:foo2⁰(1)
//│ >      $σ
//│ >    $σ
