:js
:patMatConsequentSharingThreshold 5

let x = 0
let y = 0
let z = 0
//│ x = 0
//│ y = 0
//│ z = 0

:sir
if x === 0 then 1 else 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut; set scrut = ===⁰(x⁰, 0); match scrut true => return 1 else return 2 end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

:sir
let a = if x === 0 then 1 else 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let a⁰, scrut, tmp;
//│ set scrut = ===⁰(x⁰, 0);
//│ match scrut
//│   true =>
//│     set tmp = 1;
//│     end
//│   else
//│     set tmp = 2;
//│     end
//│ set a⁰ = tmp;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ a = 1

:sir
print of if x === 0 then 1 else 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut, tmp;
//│ set scrut = ===⁰(x⁰, 0);
//│ match scrut
//│   true =>
//│     begin
//│       set tmp = 1;
//│       end;
//│     return Predef⁰.print⁰(tmp)
//│   else
//│     begin
//│       set tmp = 2;
//│       end;
//│     return Predef⁰.print⁰(tmp)
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1

:sir
if x is
  0 and y is
    0 and z is
      0 then "000"
      1 then "001"
    1 then "01"
  1 then "1"
  else ""
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ match x⁰
//│   0 =>
//│     match y⁰
//│       0 =>
//│         match z⁰
//│           0 =>
//│             return "000"
//│           1 =>
//│             return "001"
//│           else
//│             return ""
//│         end
//│       1 =>
//│         return "01"
//│       else
//│         return ""
//│     end
//│   1 =>
//│     return "1"
//│   else
//│     return ""
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "000"

// * Making the terms artificially big to force sharing of consequents
:sir
if x is
  0 and y is
    0 and z is
      0 then "000-------------------------------------------------------------------------"
      1 then "001-------------------------------------------------------------------------"
    1 then "01-------------------------------------------------------------------------"
  1 then "1-------------------------------------------------------------------------"
  else "-------------------------------------------------------------------------"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ match x⁰
//│   0 =>
//│     match y⁰
//│       0 =>
//│         match z⁰
//│           0 =>
//│             return "000-------------------------------------------------------------------------"
//│           1 =>
//│             return "001-------------------------------------------------------------------------"
//│           else
//│             return "-------------------------------------------------------------------------"
//│         end
//│       1 =>
//│         return "01-------------------------------------------------------------------------"
//│       else
//│         return "-------------------------------------------------------------------------"
//│     end
//│   1 =>
//│     return "1-------------------------------------------------------------------------"
//│   else
//│     return "-------------------------------------------------------------------------"
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "000-------------------------------------------------------------------------"

:sir
let qqq = if x is
  0 and y is
    0 and z is
      0 then "000"
      1 then "001"
    1 then "01"
  1 then "1"
  else ""
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let qqq⁰, tmp;
//│ match x⁰
//│   0 =>
//│     match y⁰
//│       0 =>
//│         match z⁰
//│           0 =>
//│             set tmp = "000";
//│             end
//│           1 =>
//│             set tmp = "001";
//│             end
//│           else
//│             set tmp = "";
//│             end
//│         end
//│       1 =>
//│         set tmp = "01";
//│         end
//│       else
//│         set tmp = "";
//│         end
//│     end
//│   1 =>
//│     set tmp = "1";
//│     end
//│   else
//│     set tmp = "";
//│     end
//│ set qqq⁰ = tmp;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ qqq = "000"

