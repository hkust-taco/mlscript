:sir
if x is
  0 and y is
    0 and z is
      0 then "000"
      1 then "001"
    1 then "01"
  1 then "1"
  else ""
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut, scrut1, scrut2;
//│ set scrut = x⁰;
//│ match scrut
//│   0 =>
//│     set scrut1 = y⁰;
//│     match scrut1
//│       0 =>
//│         set scrut2 = z⁰;
//│         match scrut2
//│           0 =>
//│             return "000"
//│           1 =>
//│             return "001"
//│           else
//│             return ""
//│         end
//│       1 =>
//│         return "01"
//│       else
//│         return ""
//│     end
//│   1 =>
//│     return "1"
//│   else
//│     return ""
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "000"

// * Making the terms artificially big to force sharing of consequents
:sir
if x is
  0 and y is
    0 and z is
      0 then "000-------------------------------------------------------------------------"
      1 then "001-------------------------------------------------------------------------"
    1 then "01-------------------------------------------------------------------------"
  1 then "1-------------------------------------------------------------------------"
  else "-------------------------------------------------------------------------"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut, scrut1, scrut2;
//│ set scrut = x⁰;
//│ match scrut
//│   0 =>
//│     set scrut1 = y⁰;
//│     match scrut1
//│       0 =>
//│         set scrut2 = z⁰;
//│         match scrut2
//│           0 =>
//│             return "000-------------------------------------------------------------------------"
//│           1 =>
//│             return "001-------------------------------------------------------------------------"
//│           else
//│             return "-------------------------------------------------------------------------"
//│         end
//│       1 =>
//│         return "01-------------------------------------------------------------------------"
//│       else
//│         return "-------------------------------------------------------------------------"
//│     end
//│   1 =>
//│     return "1-------------------------------------------------------------------------"
//│   else
//│     return "-------------------------------------------------------------------------"
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "000-------------------------------------------------------------------------"

