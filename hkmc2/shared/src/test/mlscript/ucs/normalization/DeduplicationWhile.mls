:js
:patMatConsequentSharingThreshold 1
// ^ force dedup even for small consequents


// :sjs
() =>
while true and false do print(1) else print(2)
//│ = fun

:sir
() =>
while true and true and false do print(1) else print(2)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let lambda;
//│ @private
//│ define lambda as fun lambda⁰() {
//│   loop lbl:
//│     let scrut, scrut1, scrut2, tmp;
//│     set scrut = true;
//│     block σ$x:
//│       block σ:
//│         match scrut
//│           true =>
//│             set scrut2 = true;
//│             match scrut2
//│               true =>
//│                 set scrut1 = false;
//│                 match scrut1
//│                   true =>
//│                     set tmp = Predef⁰.print⁰(1);
//│                     break σ$x
//│                   else
//│                     break σ
//│                 end
//│               else
//│                 break σ
//│             end
//│           else
//│             break σ
//│         end
//│       set tmp = Predef⁰.print⁰(2);
//│       break σ$x
//│     continue lbl
//│   return runtime⁰.Unit⁰
//│ };
//│ return lambda⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun

// :sjs
let x = 3
if x > 0 and x ===
  1 do print("A")
  2 do print("A")
  3 do print("B")
  4 do print("B")
//│ > B
//│ x = 3

:sir
x =>
while x > 0 and x ===
  1 do print("A")
  2 do print("A")
  3 do print("B")
  4 do print("B")
