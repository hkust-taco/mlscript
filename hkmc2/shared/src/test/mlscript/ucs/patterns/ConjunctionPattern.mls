:js


object A
object B

if A is
    A & A & B then 0
    B & A & B then 1
    A & A & A then 2
    else 3
//│ = 2

if A is
    A & A & B then 0
    B & A & B then 1
    A & A & A then 2
    else 3
//│ = 2

:sjs
fun foo(v) =
  if v is
    A & B then 1
    else 0
//│ JS (unsanitized):
//│ let foo; foo = function foo(v) { if (v instanceof A1.class) { return 0 } else { return 0 } };

foo(A)
//│ = 0

foo(B)
//│ = 0
