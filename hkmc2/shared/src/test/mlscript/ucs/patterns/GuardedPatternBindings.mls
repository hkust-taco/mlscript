:js

:w
pattern PlainPair = [x, y]
//│ ╔══[WARNING] Useless pattern binding: x.
//│ ║  l.4: 	pattern PlainPair = [x, y]
//│ ╙──     	                     ^
//│ ╔══[WARNING] Useless pattern binding: y.
//│ ║  l.4: 	pattern PlainPair = [x, y]
//│ ╙──     	                        ^


// Regression test: variables used in `where` guards should not produce
// spurious "Useless pattern binding" warnings.

pattern Symmetry =
  ([x, y] where (x == y))

[1, 1] is Symmetry
//│ = true

[1, 2] is Symmetry
//│ = false

