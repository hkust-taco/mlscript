:js


:w
pattern PlainPair = [x, y]
//│ ╔══[WARNING] Useless pattern binding: x.
//│ ║  l.5: 	pattern PlainPair = [x, y]
//│ ╙──     	                     ^
//│ ╔══[WARNING] Useless pattern binding: y.
//│ ║  l.5: 	pattern PlainPair = [x, y]
//│ ╙──     	                        ^


// Regression test: variables used in `where` guards should not produce
// spurious "Useless pattern binding" warnings.

pattern Symmetry =
  ([x, y] where (x == y))

[1, 1] is Symmetry
//│ = true

[1, 2] is Symmetry
//│ = false

// We should check the free variables in `where` guards.
:w
pattern PairSum = [x, y] where (let x = true, let y = x, y)
// We should check the free variables in `where` guards.
//│ ╔══[WARNING] Useless pattern binding: x.
//│ ║  l.28: 	pattern PairSum = [x, y] where (let x = true, let y = x, y)
//│ ╙──      	                   ^
//│ ╔══[WARNING] Useless pattern binding: y.
//│ ║  l.28: 	pattern PairSum = [x, y] where (let x = true, let y = x, y)
//│ ╙──      	                      ^

:w
pattern PairSum = [x, y] where (if x is [y] then y)
//│ FAILURE: Unexpected lack of warnings

:w
pattern PairSum = [x, y] where (class C(y) with { fun test = y }, C(x).test)
//│ ╔══[WARNING] Useless pattern binding: y.
//│ ║  l.42: 	pattern PairSum = [x, y] where (class C(y) with { fun test = y }, C(x).test)
//│ ╙──      	                      ^


