:w
pattern PairSum = [x, y] where (class C(y) with { fun test = y }, C(x).test)
//│ ╔══[WARNING] Unused pattern binding: y.
//│ ║  l.45: 	pattern PairSum = [x, y] where (class C(y) with { fun test = y }, C(x).test)
//│ ╙──      	                      ^

:w
pattern PairSum = [x, y] where (fun y = 1, print(y), x)
//│ ╔══[WARNING] Unused pattern binding: y.
//│ ║  l.51: 	pattern PairSum = [x, y] where (fun y = 1, print(y), x)
//│ ╙──      	                      ^

// Forward reference to `y` should not be counted as a free variable
:w
pattern PairSum = [x, y] where (print(y), fun y = 1, x)
//│ ╔══[WARNING] Unused pattern binding: y.
//│ ║  l.58: 	pattern PairSum = [x, y] where (print(y), fun y = 1, x)
//│ ╙──      	                      ^


