:ignore
:ucs normalized

import "../../../mlscript-compile/Option.mls"

open Option

// OK
x => if x is
  refined(None) then x
//│ ╔══[COMPILATION ERROR] Name not found: refined
//│ ║  l.10: 	  refined(None) then x
//│ ╙──      	  ^^^^^^^
//│ ╔══[COMPILATION ERROR] Cannot use this ‹error› as a pattern.
