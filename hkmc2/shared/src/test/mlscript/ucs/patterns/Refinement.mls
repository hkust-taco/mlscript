//│ ╙──      	  ^^^^^^^
//│ Normalized:
//│ >  ‹if|while›

// Should warn about the inconsistent refinement
x => if x is
  refined(None) then x
  Some then x
//│ ╔══[COMPILATION ERROR] Name not found: refined
//│ ║  l.34: 	  refined(None) then x
