// OK
x => if x is
  refined(Some) then x
//│ ╔══[COMPILATION ERROR] Name not found: refined
//│ ║  l.22: 	  refined(Some) then x
//│ ╙──      	  ^^^^^^^
//│ ╔══[COMPILATION ERROR] Cannot use this ‹error› as a pattern.
