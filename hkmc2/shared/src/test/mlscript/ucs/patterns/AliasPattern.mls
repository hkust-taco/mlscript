:js

import "../../../mlscript-compile/Option.mls"

open Option

fun map(f) = case
  Some(x)   then Some(f(x))
  None as n then n

fun map(f) = case
  Some(x as n) then Some of f(n)
  None as n then n


fun foo = case
  Some(Some(a as b) as c) as d then [a, b, c, d]

foo of Some(Some(42))
//│ = [42, 42, Some(42), Some(Some(42))]
