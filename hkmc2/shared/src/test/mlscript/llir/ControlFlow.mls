//│         let x$733 = 1 in
//│         jump j$731(x$733)
//│       B$710 =>
//│         let x$734 = a$716.<B$710:y> in
//│         let x$735 = 2 in
//│         jump j$731(x$735)
//│       _ =>
//│         panic "match error"
//│   def j$731(tmp$729) =
//│     tmp$729
//│   def entry$738() =
