:intl
abstract class Callable
object FnLike1 extends Callable with
  fun apply1(x) = x * 2
fun apply(f, x) = f(x)
fun main() =
  let mul2 = FnLike1
  apply(mul2, 3)
main()
//│ 
//│ Interpreted:
//│ 6

