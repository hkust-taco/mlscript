fun sim(n, k) =
  fun proc(rs) =
    let xs = take_lz(100, nub_lz(rs))
    let best = 100
    let bestk = maximum(take(k, xs))
    let afterk = dropWhile(x => x < bestk, drop(k, xs))
    listEq(best :: Nil, take(1, afterk))
  
  simulate(n, 100, proc)
//│ ═══[COMPILATION ERROR] Name not found: member:take_lz
