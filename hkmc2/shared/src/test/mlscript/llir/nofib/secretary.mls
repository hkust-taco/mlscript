fun simulate(n, m, proc) =
  fun lscomp(ls) = if ls is
    Nil then Nil
    seed :: t then proc(infRand(m, seed)) :: lscomp(t)
  
  floatOfInt(listLen(filter(x => x, lscomp(enumFromTo(1, n))))) / floatOfInt(n)
