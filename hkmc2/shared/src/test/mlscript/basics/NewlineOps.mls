//│ ═══[COMPILATION ERROR] Cannot call non-unary builtin symbol '*'
//│ ═══[RUNTIME ERROR] Error: Cannot call non-unary builtin symbol '*'

2,* 3
//│ = 6

2 ,* 3
//│ = 6

2 + 2
* 3
//│ = 12

2 + 2 ,* 3
//│ = 12

2 + 2 ,* 2 + 2
//│ = 10

2 + 2 ,*, 2 + 2
//│ = 16

module Arr with
  val len = (xs: Array) => xs.length

let
  xs = [1, 2]
  ys = [3, 4, 5]
//│ xs = [1, 2]
//│ ys = [3, 4, 5]

xs |> Arr.len
+
ys |> Arr.len
//│ = 5

xs |> Arr.len,+
ys |> Arr.len
//│ = 5

xs |> Arr.len
+, ys |> Arr.len
//│ = 5

xs |> Arr.len ,+, ys |> Arr.len
//│ = 5

:w
:expect 3
xs |> Arr.len
,+
ys |> Arr.len
//│ ╔══[WARNING] Pure expression in statement position
//│ ║  l.+2: 	,+
//│ ╙──      	 ^
//│ = 3

xs |> Arr.len
,+ 1
//│ = 1

:pe
:re
xs |> Arr.len
+,
ys |> Arr.len
//│ ╔══[PARSE ERROR] Expected start of expression in this position; found new line instead
//│ ║  l.+2: 	+,
//│ ║        	  ^
//│ ║  l.+3: 	ys |> Arr.len
//│ ╙──
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

xs |> Arr.len
+, ys |> Arr.len
//│ = 5

// :pe
xs |> Arr.len is 2 ,+, ys |> Arr.len
//│ = 4

xs |> Arr.len is 2 ,+, ys |> Arr.len is 3
//│ = 2

// :pe
xs |> Arr.len is 2 ,+
ys |> Arr.len
//│ = 4




