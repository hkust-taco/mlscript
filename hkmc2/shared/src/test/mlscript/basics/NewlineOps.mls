//│ x = 1


2
  + 1
* 2
//│ = 6

2
  |> (a: _)
  .a
//│ = 2

// * The placeholder is delimited by `|>`, not by the parentheses,
// * so this selects field `a` of the record in the lambda body.
2
  |> (a: _)
    .a
//│ = 2

:ge
:re
2
  |> (a: _)
.a
//│ ╔══[COMPILATION ERROR] Unexpected term form in expression position (leading dot selection)
//│ ║  l.+3: 	.a
//│ ╙──      	^^
