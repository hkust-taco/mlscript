class DynCtor() with
  declare val dynField: Int
  set this.("dynField") = 42

DynCtor().dynField
//│ = 42

new DynCtor().dynField
//│ = 42


// * A literal receiver is parenthesized: `-1["toFixed"]` would parse as `-(1["toFixed"])`.
:sjs
(-1).("toFixed")(1)
