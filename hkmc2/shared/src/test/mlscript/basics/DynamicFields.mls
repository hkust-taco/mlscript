:js


let xs = mut [1, 2, 3]
//│ xs = [1, 2, 3]

:sjs
xs.(0)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ return xs[0]
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

:sjs
set xs.(0) = 4
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ xs[0] = 4; return runtime.Unit
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

xs.(0)
//│ = 4

set xs.[0] += 1

set xs.[0] = xs.[0] + 1

xs.[0]
//│ = 6

set xs.("lol") = "wat"

xs
//│ = [6, 2, 3]


class Foo(val x)

let foo = Foo(123)
//│ foo = Foo(123)

foo.("x")
//│ = 123

// TODO sanitize
:breakme
:re
foo.("y")

// TODO sanitize
:breakme
:re
foo.(0)

:re
foo.[0]
//│ ═══[RUNTIME ERROR] TypeError: foo.at is not a function

// * Array indexing syntax is only for numeric indices – this should throw
:re
foo.["x"]
//│ ═══[RUNTIME ERROR] TypeError: foo.at is not a function


class DynCtor() with
  set this.("dynField") = 42

DynCtor().dynField
//│ = 42

new DynCtor().dynField
//│ = 42


