// Fixed: `if true then success: 42` should work like `if true then (success: 42)`

if true then (success: 42)
//│ = {success: 42}

if true then
  success: 42
//│ = {success: 42}

if true then success: 42
//│ = {success: 42}

if true then 1 else 2
//│ = 1

if true then print("hello") else print("world")
//│ > hello
