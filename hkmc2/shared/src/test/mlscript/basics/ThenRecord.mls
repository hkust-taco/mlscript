//* Fixed: `if true then success: 42` should work like `if true then (success: 42)`

if true then (success: 42)
//│ = {success: 42}

if true then
  success: 42
//│ = {success: 42}

if true then success: 42
//│ = {success: 42}


if true then success: 42 else failure: "oops"
//│ = {success: 42}

if false then success: 42 else failure: "oops"
//│ = {failure: "oops"}


