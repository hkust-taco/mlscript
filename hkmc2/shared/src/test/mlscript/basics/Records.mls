:silent
import "../../mlscript-compile/Iter.mls"
let graphics = new Set of tuple of
  "circle", "ellipse", "image", "line", "path"
  "polygon", "polyline", "rect", "text", "use"

fun showProps(x, y, props) = Object.entries(props)
  Iter.mapping of case
    ["x", x'] then "x: " + (x + x')
    ["y", y'] then "y: " + (y + y')
    [k, v] then k + ": " + v
  Iter.joined(", ")

fun output(i, s) = print of "  ".repeat(i) + s

fun t(kind, props) =
  if graphics.has(kind) then
    (args, ...) => output of args.'i, kind + " " + showProps(args.'x, args.'y, props)
  else
    (...children) => (args) =>
      output of args.'i, kind + " " + showProps(args.'x, args.'y, props) + " with"
      children Iter.each of child => child of
        x: args.'x + props.x
        y: args.'y + props.y
        i: args.'i + 1
//│ FAILURE: Unexpected compilation error
//│ FAILURE LOCATION: reportResolutionError (NewResolverState.scala:328)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.178: 	      children Iter.each of child => child of
//│ ║         	                                     ^^^^^^^^
//│ ║  l.179: 	        x: args.'x + props.x
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.180: 	        y: args.'y + props.y
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.181: 	        i: args.'i + 1
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Parameter 'child' admits values of unknown shape.
//│ ║  l.178: 	      children Iter.each of child => child of
//│ ║         	                            ^^^^^
//│ ╟── Value of unknown shape cannot be called like a function.
//│ ║  in ../../mlscript-compile/Iter.mls
//│ ║  l.261: 	fun each(xs, op: Function) =
//│ ║         	                 ^^^^^^^^
//│ ╙── The 'Function' type does not specify parameter types.

let display = t('group, x: 20, y: 20) of
  t('circle, x: 30, y: 30, r: 42)
  t('rect, x: 40, y: 40, width: 80, height: 90)
  t('ellipse, x: 50, y: 50, rx: 40, ry: 60)
//│ display = fun

display(x: 11, y: 22, i: 2)
//│ > group x: 31, y: 42 with
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: mkQuery (JSBackendDiffMaker.scala:280)
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

let display = t("group", x: 0, y: 0) of
  t("circle", x: 10, y: 10, r: 42)
//│ display = fun

display(x: 88, y: 99, i: 0)
//│ > group x: 88, y: 99 with
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: mkQuery (JSBackendDiffMaker.scala:280)
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

