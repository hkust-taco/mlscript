//│ = {x: 1}

id of { x: 1 }
//│ = {x: 1}

id of ({ x: 1 })
//│ = {x: 1}


id of ({ x: 1, y: 2 })
//│ = {x: 1, y: 2}

id of (x: 1, y: 2)
//│ = {x: 1, y: 2}

id of { x: 1, y: 2 }
