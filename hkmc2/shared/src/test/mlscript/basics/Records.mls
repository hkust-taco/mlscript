{1, 2}
//│ ╔══[WARNING] Pure expression in statement position
//│ ║  l.17: 	{1, 2}
//│ ╙──      	 ^
//│ = 2

{foo: 1}
//│ = {foo: 1}


let rcd = { foo: 1, bar: "..." }
//│ rcd = {foo: 1, bar: "..."}

[rcd.foo, rcd.bar]
//│ = [1, "..."]

typeof(rcd)
//│ = "object"


// * Should we allow this syntax?

let rcd = (foo: 1, bar: "...")
//│ rcd = {foo: 1, bar: "..."}

[rcd.foo, rcd.bar]
//│ = [1, "..."]

let rcd = (
  foo: 1
  bar: "..."
)
//│ rcd = {foo: 1, bar: "..."}

let rcd =
  foo: 1
  bar:
    "..."
//│ rcd = {foo: 1, bar: "..."}

[rcd.foo, rcd.bar]
//│ = [1, "..."]

print <|
  foo: 1
  bar:
    "..."
//│ > {foo: 1, bar: "..."}


// * But not this syntax...

