:pt
fun f(x) = if x
  == 0 then "a"
  > 1 then "b"
//│ Parsed tree:
//│ TermDef:
//│   k = Fun
//│   head = App:
//│     lhs = Ident of "f"
//│     rhs = Tup of Ls of 
//│       Ident of "x"
//│   rhs = S of IfLike:
//│     kw = keyword 'if'
//│     kwLoc = N
//│     split = OpSplit:
//│       lhs = Ident of "x"
//│       ops_rhss = Ls of 
//│         InfixApp:
//│           lhs = OpApp:
//│             lhs = SplitPoint
//│             op = Ident of "=="
//│             rhss = Ls of 
//│               IntLit of 0
//│           kw = keyword 'then'
//│           rhs = StrLit of "a"
//│         InfixApp:
//│           lhs = OpApp:
//│             lhs = SplitPoint
//│             op = Ident of ">"
//│             rhss = Ls of 
//│               IntLit of 1
//│           kw = keyword 'then'
//│           rhs = StrLit of "b"

f(0)
//│ = "a"

