:.
:js


class Foo with
  val x = 0
  fun change =
    set x += 1


// Dynamic receivers allow these tests to add fields while retaining runtime checks.
:sjs
val f: dyn = new Foo
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f, tmp; tmp = globalThis.Object.freeze(new Foo1()); f = tmp;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f = Foo { x: 0 }

set
  f.x = 1
  f.y = 1

:expect 0
f.x
//│ = 0

:re
f.change
//│ ═══[RUNTIME ERROR] TypeError: Cannot assign to read only property 'x' of object '[object Object]'

:expect 0
f.x
//│ = 0

:re
f.y
//│ ═══[RUNTIME ERROR] Error: Access to required field 'y' yielded 'undefined'


:sjs
// :elt
val f: dyn = new mut Foo
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f1, tmp1; tmp1 = new Foo1(); f1 = tmp1;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f = Foo { x: 0 }

set
  f.x = 1
  f.y = 1

f.change

:expect 2
f.x
//│ = 2

:expect 1
f.y
//│ = 1


:e
let f = mut new Foo
//│ ╔══[COMPILATION ERROR] Illegal position for 'mut' modifier.
//│ ║  l.64: 	let f = mut new Foo
//│ ╙──      	        ^^^
//│ f = Foo { x: 0 }

:e
:re
new mut Foo.x
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.72: 	new mut Foo.x
//│ ║        	        ^^^^^
//│ ╟── Class value does not contain member 'x'
//│ ║  l.5: 	class Foo with
//│ ╙──     	      ^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


val f: dyn = new mut Foo()
//│ f = Foo { x: 0 }

set
  f.x = 1
  f.y = 1

f.change

:expect 2
f.x
//│ = 2

:expect 1
f.y
//│ = 1


new mut Foo().x
//│ = 0

new Foo().x
//│ = 0



class Foo(val x)


let f = new Foo(0)
//│ f = Foo(0)

set f.x = 1

:expect 0
f.x
//│ = 0


let f = new mut Foo(0)
//│ f = Foo(0)

set f.x = 1

:expect 1
f.x
//│ = 1


val f: dyn = Foo(0)
//│ f = Foo(0)

set
  f.x = 1
  f.y = 1

:expect 0
f.x
//│ = 0

:re
f.y
//│ ═══[RUNTIME ERROR] Error: Access to required field 'y' yielded 'undefined'



class Foo(mut val x) with
  mut val y = 0


let f = new Foo(0)
//│ f = Foo(0)

set
  f.x = 1
  f.y = 1

// * Note that `mut val`s are backed by an internally mutable private field.

:expect 1
f.x
//│ = 1

:expect 1
f.y
//│ = 1



val f: dyn = new Object with
  val x = 12
//│ f = $anon { x: 12 }

set
  f.x = 1
  f.y = 1

f.x
//│ = 12

:re
f.y
//│ ═══[RUNTIME ERROR] Error: Access to required field 'y' yielded 'undefined'


val f: dyn = new mut Object with
  val x = 12
//│ f = $anon { x: 12 }

set
  f.x = 1
  f.y = 1

f.x
//│ = 1

f.y
//│ = 1


