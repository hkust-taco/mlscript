:.
:js


class C

:sjs
new! C
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ return globalThis.Object.freeze(new C1())
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = C

let c = C
//│ c = class C

new! c
//│ = C

let f = new! _
//│ f = fun f

f(c)
//│ = C

// * Same in JS:
// *    > new id(C)
// *    Uncaught TypeError: id is not a constructor
// *    > new (id(C))
// *    C {}
:sjs
:pt
:re
new! id(C)
//│ ———————————————| Parsed tree |——————————————————————————————————————————————————————————————————————
//│ App:
//│   lhs = PrefixApp:
//│     kw = Keywrd of keyword 'new!'
//│     rhs = Ident of "id"
//│   rhs = Tup of Ls of
//│     Ident of "C"
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ return globalThis.Object.freeze(new Predef.id(C1))
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] TypeError: Predef.id is not a constructor

// * Ok (as in JS)
new! (id(C))
//│ = C

// * We should reject static new on an unknown class.
:e
:re
new id(C)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.54: 	new id(C)
