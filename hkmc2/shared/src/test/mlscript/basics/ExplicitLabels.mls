:js


do exit:
  if true do exit.break(42)
  0
//│ = 42


let i = 0 in do loop:
  if i >= 3 do loop.break(i)
  set i += 1
  loop.continue
//│ = 3


let i = 0 in do outLoop:
  do inner:
    if i >= 4 do outLoop.break(i)
    set i += 1
    outLoop.continue
//│ = 4


