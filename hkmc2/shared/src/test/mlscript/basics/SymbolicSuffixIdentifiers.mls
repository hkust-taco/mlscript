:js


:sjs
fun foo_bar_<:<(value_?!) = value_?! + 1
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let foo_bar; foo_bar = function foo_bar(value) { return value + 1 };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

foo_bar_<:<(41)
//│ = 42


class Box_#(val value_?!) with
  fun add_++(delta) = value_?! + delta

let box_# = new Box_#(42)
//│ box_# = Box(42)

box_#.value_?!
//│ = 42

box_#.add_++(1)
//│ = 43


