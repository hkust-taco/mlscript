//│         let tmp, tmp1, tmp2, tmp3, tmp4;
//│         tmp = 10 * n1;
//│         tmp1 = tmp + n2;
//│         tmp2 = 10 * tmp1;
//│         tmp3 = tmp2 + n3;
//│         tmp4 = 10 * tmp3;
//│         return tmp4 + n4
//│       }
//│     }
//│   }
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(3)(0)(3)(1)
