fun f(n1: Int): Int = n1
//│ JS:
//│ function f(...args) {
//│   if (args.length !== 1) { throw new globalThis.Error("Function 'f' expected 1 arguments but got " + args.length) }
//│   let n1 = args[0];
//│   return n1;
//│ }
//│ undefined

f(42)
//│ JS:
//│ this.f(42)
//│ = 42

fun f(n1: Int)(n2: Int): Int =  (10 * n1 + n2)
//│ JS:
//│ function f(...args) {
//│   if (args.length !== 1) { throw new globalThis.Error("Function 'f' expected 1 arguments but got " + args.length) }
//│   let n1 = args[0];
//│   return (...args1) => {
//│     if (args1.length !== 1) { throw new globalThis.Error("Function expected 1 arguments but got " + args1.length) }
//│     let n2 = args1[0];
//│     let tmp;
//│     tmp = 10 * n1;
//│     return tmp + n2;
//│   };
//│ }
//│ undefined

f(4)(2)
//│ JS:
//│ let tmp; tmp = this.f(4); tmp(2)
//│ = 42

fun f(n1: Int)(n2: Int)(n3: Int): Int = 10 * (10 * n1 + n2) + n3
//│ JS:
//│ function f(...args) {
//│   if (args.length !== 1) { throw new globalThis.Error("Function 'f' expected 1 arguments but got " + args.length) }
