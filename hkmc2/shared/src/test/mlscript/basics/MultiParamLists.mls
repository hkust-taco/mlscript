fun f(n1: Int)(n2: Int): Int =  (10 * n1 + n2)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f1; f1 = function f(n1) { return (n2) => { let tmp; tmp = 10 * n1; return tmp + n2 } };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

