//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42

fun f(n1: Int)(n2: Int)(n3: Int): Int = 10 * (10 * n1 + n2) + n3
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f2;
//│ f2 = function f(n1) {
//│   return (n2) => {
//│     return (n3) => {
//│       let tmp, tmp1, tmp2;
//│       tmp = 10 * n1;
//│       tmp1 = tmp + n2;
//│       tmp2 = 10 * tmp1;
//│       return tmp2 + n3
//│     }
//│   }
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(4)(2)(0)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ f2(4)(2)(0)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 420

fun f(n1: Int)(n2: Int)(n3: Int)(n4: Int): Int = 10 * (10 * (10 * n1 + n2) + n3) + n4
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
