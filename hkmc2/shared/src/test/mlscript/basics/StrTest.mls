:ge
~"a"
//│ ╔══[COMPILATION ERROR] Unexpected term form in expression position (negation type)
//│ ║  l.+1: 	~"a"
//│ ╙──      	^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


:expect "ab"
~("a", "b")
//│ = "ab"


:expect "ab"
~ of "a", "b"
//│ = "ab"

(~) of "a", "b"
//│ = "ab"


fun test(...xs) =
  concat of ...xs, "!"

test("a", "b", "c")
//│ = "abc!"


"a" StrOps.concat2("b")
//│ = "ab"

"a" StrOps.concat2 of "b"
//│ = "ab"


