:.
:js

import "../../mlscript-compile/StrOps.mls"

open StrOps
open StrOps { concat2, ~ }


:sjs
"a" is Str
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (typeof "a" === 'string') { return true } return false;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = true


concat of "a", "b", "c"
//│ = "abc"

concat of
  "a"
  "b"
  "c"
//│ = "abc"


// TODO (~) should be sanitized

:e
(~)("a", "b", "c")
//│ ╔══[COMPILATION ERROR] Resolution error in application
