:js

import "../../mlscript-compile/StrOps.mls"

open StrOps


:sjs
"a" is Str
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (typeof "a" === 'string') { true } else { false }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = true


concat of "a", "b", "c"
//│ = "abc"

concat of
  "a"
  "b"
  "c"
//│ = "abc"


// TODO (~) should be sanitized

:e
(~)("a", "b", "c")
//│ ╔══[COMPILATION ERROR] Expected 2 arguments, got 3
//│ ║  l.29: 	(~)("a", "b", "c")
//│ ╙──      	   ^^^^^^^^^^^^^^^
//│ = "ab"


:e
(~)("a")
//│ ╔══[COMPILATION ERROR] Expected 2 arguments, got 1
//│ ║  l.37: 	(~)("a")
//│ ╙──      	   ^^^^^
//│ = "aundefined"

:ge
~"a"
//│ ╔══[COMPILATION ERROR] Unexpected term form in expression position (negation type)
//│ ║  l.44: 	~"a"
