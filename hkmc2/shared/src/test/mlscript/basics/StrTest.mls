//│ = "ab"


:e
(~)("a")
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+1: 	(~)("a")
//│ ║        	^^^^^^^^
//│ ╟── Function 'concat2' expected 2 arguments, but got 1
//│ ║  in ../../mlscript-compile/StrOps.mls
