:pe
:ge
~ of "a", "b"
//│ ╔══[PARSE ERROR] Expected start of expression in this position; found 'of' keyword instead
//│ ║  l.61: 	~ of "a", "b"
//│ ╙──      	  ^^
//│ ╔══[PARSE ERROR] Expected end of input; found literal instead
//│ ║  l.61: 	~ of "a", "b"
//│ ╙──      	     ^^^
//│ ═══[COMPILATION ERROR] Unexpected term form in expression position (negation type)
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

(~) of "a", "b"
//│ = "ab"


fun test(...xs) =
  concat of ...xs, "!"

test("a", "b", "c")
//│ = "abc!"


"a" StrOps.concat2("b")
//│ = "ab"

"a" StrOps.concat2 of "b"
//│ = "ab"


