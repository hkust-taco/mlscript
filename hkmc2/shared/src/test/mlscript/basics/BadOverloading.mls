:e
// A term declaration does not create a function that can own its companion.
fun Foo: Int
object Foo
//│ ╔══[COMPILATION ERROR] A term declaration cannot have an implemented object companion
//│ ║  l.48: 	fun Foo: Int
//│ ║        	^^^^^^^^^^^^
//│ ╟── Companion 'Foo' is defined here
//│ ║  l.49: 	object Foo
//│ ╙──      	^^^^^^^^^^

