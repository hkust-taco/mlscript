// Class and module companions require a function definition with parameters.
class Foo
fun Foo() = 1

fun Foo() = 1
module Foo

// An existing value cannot own a companion.
:e
val Foo = 1
module Foo
//│ ╔══[COMPILATION ERROR] A module companion must be a function with a parameter list
//│ ║  l.+1: 	val Foo = 1
//│ ║        	^^^^^^^^^^^
//│ ╟── Arbitrary values cannot be overloaded with module 'Foo'
//│ ║  l.+2: 	module Foo
//│ ╙──      	^^^^^^^^^^
//│ ═══[RUNTIME ERROR] TypeError: Cannot create property 'class' on number '1'
//│ Foo = 1


:e
fun (**) f1(a, b) = "[" + a + " * " + b + "]"
fun (**) f2(a, b) = "(" + a + " + " + b + ")"
//│ ╔══[COMPILATION ERROR] Symbolic name '**' of definition 'f1' is already used
//│ ║  l.+1: 	fun (**) f1(a, b) = "[" + a + " * " + b + "]"
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── by sibling member 'f2'
//│ ║  l.+2: 	fun (**) f2(a, b) = "(" + a + " + " + b + ")"
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

1 ** 2
//│ = "(1 + 2)"

:e
fun (**) t() = 0
fun (++) t() = 1
//│ ╔══[COMPILATION ERROR] Multiple definitions of symbol 't'
