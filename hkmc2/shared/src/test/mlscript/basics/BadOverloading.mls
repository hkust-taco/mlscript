fun (**) f1(a, b) = "[" + a + " * " + b + "]"
fun (**) f2(a, b) = "(" + a + " + " + b + ")"
//│ ╔══[COMPILATION ERROR] Symbolic name '**' of definition 'f1' is already used
//│ ║  l.98: 	fun (**) f1(a, b) = "[" + a + " * " + b + "]"
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── by sibling member 'f2'
//│ ║  l.99: 	fun (**) f2(a, b) = "(" + a + " + " + b + ")"
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

1 ** 2
