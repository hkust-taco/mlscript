// Class and module companions require a function definition with parameters.
class Foo
fun Foo() = 1

fun Foo() = 1
module Foo

// An existing value cannot own a companion.
:e
val Foo = 1
module Foo
//│ ╔══[COMPILATION ERROR] A module companion must be a function with a parameter list
