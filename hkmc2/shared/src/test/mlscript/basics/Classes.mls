:js


class Foo

class Foo()

class Foo(x: Int)

class Foo(x: Int, y: Str)

class Foo(x: Int) with
  val y = x


class Foo(x: Int) { val y = x }

class Foo {
  // Class bodies without `with` are refinements and should remain newline-aware
  // even when the first line is a comment.
  fun f = 1
}

class Foo(pred) {
  val r = pred.id(42)
  fun callId(x) = pred.id(x)
}

