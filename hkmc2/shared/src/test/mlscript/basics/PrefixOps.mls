:js

import "../../mlscript-compile/Stack.mls"
open Stack


0 *
  + 1
  + 2
//│ = 0

x =>
  + 1
  + 2
//│ = fun


| 1
//│ = 1

& 1
//│ = 1

let res =
  | 1
//│ res = 1

| 2 + 2
*
| 3 + 3
//│ = 24

2 + 2
*
3 + 3
//│ = 24

2 + 2
  *
3 + 3
//│ = 11

| 2 + 2
  *
| 3 + 3
//│ = 14

2 + 2 * | 3 + 3
//│ = 14

:pt
1 + | 2 + 3
//│ ———————————————| Parsed tree |——————————————————————————————————————————————————————————————————————
//│ OpApp:
//│   lhs = IntLit of 1
//│   op = Ident of "+"
//│   rhss = Ls of 
//│     PrefixApp:
//│       kw = Keywrd of keyword '|'
//│       rhs = OpApp:
//│         lhs = IntLit of 2
//│         op = Ident of "+"
//│         rhss = Ls of 
//│           IntLit of 3
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 6

:e
| 1
| 2
//│ ╔══[COMPILATION ERROR] Unexpected term form in expression position (alternation)
//│ ║  l.69: 	| 1
//│ ║        	  ^
//│ ║  l.70: 	| 2
//│ ╙──      	^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


pattern Bin =
  | 0

0 is Bin
//│ = true

1 is Bin
//│ = false


pattern Bin =
  | 0
  | 1

0 is Bin
//│ = true

1 is Bin
//│ = true

2 is Bin
//│ = false


pattern Bin =
  | 0 => false
  | 1 => true

Bin.unapply(0)
//│ = MatchSuccess(false, null)
Bin.unapply(1)
//│ = MatchSuccess(true, null)
Bin.unapply(2)
//│ = MatchFailure(null)


// * Note:

let x =
  +
//│ x = fun x

x(2, 3)
//│ = 5


