:.
:js

// * Control flow in implicit lambdas behaves as in explicit lambdas:
// * `return` is a non-local return, `break` and `continue` cross a boundary,
// * and `yield` does not refer to the enclosing generator.
// * See also `handlers/NonLocalReturns.mls` for non-local control flow with effect handlers enabled.


// * Non-local returns require effect handlers

:e
fun foo() =
  let f = => tuple(_, return 2)
  f(1)
  3
//│ ╔══[COMPILATION ERROR] Non-local return statements are only supported with effect handlers enabled.
//│ ║  l.14: 	  let f = => tuple(_, return 2)
//│ ╙──      	                      ^^^^^^^^

:e
fun foo() =
  let f = x => tuple(x, return 2)
  f(1)
  3
//│ ╔══[COMPILATION ERROR] Non-local return statements are only supported with effect handlers enabled.
//│ ║  l.23: 	  let f = x => tuple(x, return 2)
//│ ╙──      	                        ^^^^^^^^

:e
fun foo() =
  1 |> tuple(_, return 2)
//│ ╔══[COMPILATION ERROR] Non-local return statements are only supported with effect handlers enabled.
//│ ║  l.32: 	  1 |> tuple(_, return 2)
//│ ╙──      	                ^^^^^^^^

// * The `return` is in the outer implicit lambda, which has a placeholder
:e
fun foo() =
  let f = => tuple(_, => return 2)
  3
//│ ╔══[COMPILATION ERROR] Non-local return statements are only supported with effect handlers enabled.
//│ ║  l.40: 	  let f = => tuple(_, => return 2)
//│ ╙──      	                         ^^^^^^^^


// * Without placeholders, delimiting terms are not lambdas, so these are ordinary returns

fun foo() =
  1 |> tuple(return 2)
  3

foo()
//│ = 2

fun foo() =
  tuple(=> return 2)
  3

foo()
//│ = 2


// * Whether the term is a lambda is not known yet when elaborating a construct that precedes its first placeholder

:e
fun foo() =
  let f = => tuple(return 2, _)
  f(1)
  3
//│ ╔══[COMPILATION ERROR] Unsupported control flow before the first '_' placeholder of an implicit lambda.
//│ ║  l.68: 	  let f = => tuple(return 2, _)
//│ ║        	                   ^^^^^^^^
//│ ╟── The implicit lambda is introduced by this placeholder.
//│ ║  l.68: 	  let f = => tuple(return 2, _)
//│ ║        	                             ^
//│ ╙── Use an explicit lambda instead, or place a '_' placeholder before the control flow.

:e
fun foo() =
  let f = => return _
  f(1)
  3
//│ ╔══[COMPILATION ERROR] Unsupported control flow before the first '_' placeholder of an implicit lambda.
//│ ║  l.81: 	  let f = => return _
//│ ║        	             ^^^^^^^^
//│ ╟── The implicit lambda is introduced by this placeholder.
//│ ║  l.81: 	  let f = => return _
//│ ║        	                    ^
//│ ╙── Use an explicit lambda instead, or place a '_' placeholder before the control flow.


// * Labels

:e
do lbl:
  let f = => tuple(_, lbl.break(1))
  f(0)
  2
//│ ╔══[COMPILATION ERROR] Non-local 'break' is only supported with effect handlers enabled.
//│ ║  l.97: 	  let f = => tuple(_, lbl.break(1))
//│ ╙──      	                      ^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:e
let i = 0 in do lbl:
  let f = => tuple(_, lbl.continue)
  set i += 1
  if i < 3 do f(0)
  i
//│ ╔══[COMPILATION ERROR] Non-local 'continue' is only supported with effect handlers enabled.
//│ ║  l.107: 	  let f = => tuple(_, lbl.continue)
//│ ╙──       	                      ^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

do lbl:
  let f = => tuple(_, do inner: inner.break(1))
  f(0).1
//│ = 1

do lbl:
  0 |> tuple(lbl.break(1))
  2
//│ = 1


// * Generators

open annotations

:e
@generator
fun gen() =
  let f = => tuple(_, yield 1)
  f(0)
//│ ╔══[COMPILATION ERROR] Yield expressions are not allowed in this context.
//│ ║  l.134: 	  let f = => tuple(_, yield 1)
//│ ╙──       	                      ^^^^^^^

// * Without placeholders, the `yield` is in the generator
:sjs
@generator
fun gen() =
  0 |> tuple(yield 1)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let gen1;
//│ gen1 = function* gen() {
//│   let tmp, xs1;
//│   tmp = yield 1;
//│   xs1 = [ tmp ];
//│   return runtime.safeCall(xs1(0))
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// * Legacy syntax, where all terms delimit implicit lambdas

#lang(0.2.x)

:e
fun foo() = tuple(_, return 2)
//│ ╔══[COMPILATION ERROR] Non-local return statements are only supported with effect handlers enabled.
//│ ║  l.161: 	fun foo() = tuple(_, return 2)
//│ ╙──       	                     ^^^^^^^^

:e
fun foo() = tuple(return 2, _)
//│ ╔══[COMPILATION ERROR] Unsupported control flow before the first '_' placeholder of an implicit lambda.
//│ ║  l.167: 	fun foo() = tuple(return 2, _)
//│ ║         	                  ^^^^^^^^
//│ ╟── The implicit lambda is introduced by this placeholder.
//│ ║  l.167: 	fun foo() = tuple(return 2, _)
//│ ║         	                            ^
//│ ╙── Use an explicit lambda instead, or place a '_' placeholder before the control flow.

fun foo() =
  if true then return 1
  2

foo()
//│ = 1

fun foo() =
  tuple(id(return 1), x => x)

foo()
//│ = 1

