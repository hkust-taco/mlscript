:.
:js


let arr = [1, 2, 3]
//│ arr = [1, 2, 3]

arr.1
//│ = 2

arr."1"
//│ = 2

// Equivalent:
arr.'1
//│ = 2


{a: 123}.'a
//│ = 123

{'a: 123}.'a
//│ = 123

{"a": 123}.'a
//│ = 123


let obj = a: 1
//│ obj = {a: 1}

obj.a
//│ = 1

obj .a
//│ = 1

obj
  .a
//│ = 1

:pe
obj. a
//│ ╔══[PARSE ERROR] Expected end of input; found period instead
//│ ║  l.+1: 	obj. a
//│ ╙──      	   ^
//│ = {a: 1}

obj.("a")
//│ = 1

obj .("a")
//│ = 1

:fixme
obj
  .("a")
//│ ╔══[PARSE ERROR] Expected an expression; found period instead
//│ ║  l.+2: 	  .("a")
//│ ╙──      	  ^
//│ ╔══[PARSE ERROR] Unexpected period here
//│ ║  l.+2: 	  .("a")
//│ ╙──      	  ^
//│ ╔══[COMPILATION ERROR] Illegal juxtaposition right-hand side (‹erroneous syntax›).
//│ ║  l.+2: 	  .("a")
//│ ╙──      	  ^
//│ = {a: 1}

:pe
obj. ("a")
//│ ╔══[PARSE ERROR] Expected end of input; found period instead
//│ ║  l.+1: 	obj. ("a")
//│ ╙──      	   ^
//│ = {a: 1}

obj."a"
//│ = 1

obj ."a"
//│ = 1

:fixme
obj
  ."a"
//│ ╔══[PARSE ERROR] Expected an expression; found period instead
//│ ║  l.+2: 	  ."a"
//│ ╙──      	  ^
//│ ╔══[PARSE ERROR] Unexpected period here
//│ ║  l.+2: 	  ."a"
//│ ╙──      	  ^
//│ ╔══[COMPILATION ERROR] Illegal juxtaposition right-hand side (‹erroneous syntax›).
//│ ║  l.+2: 	  ."a"
//│ ╙──      	  ^
//│ = {a: 1}

:pe
obj. "a"
//│ ╔══[PARSE ERROR] Expected end of input; found period instead
//│ ║  l.+1: 	obj. "a"
//│ ╙──      	   ^
//│ = {a: 1}


let obj =
  " ": 1
  "¯\\_(ツ)_/¯": 2
//│ obj = {" ": 1, "¯_(ツ)_/¯": 2}

obj." "
//│ = 1

:w
obj."¯\_(ツ)_/¯"
//│ ╔══[WARNING] Found invalid escape character
//│ ║  l.+1: 	obj."¯\_(ツ)_/¯"
//│ ╙──      	       ^
//│ = 2

:fixme
:expect 2
obj."¯\\_(ツ)_/¯"
//│ ═══[RUNTIME ERROR] Expected: '2', got: 'undefined'

:w
"¯\_(ツ)_/¯"
//│ ╔══[WARNING] Found invalid escape character
//│ ║  l.+1: 	"¯\_(ツ)_/¯"
//│ ╙──      	   ^
//│ = "¯_(ツ)_/¯"

:w
let obj = "¯\_(ツ)_/¯": 2
//│ ╔══[WARNING] Found invalid escape character
//│ ║  l.+1: 	let obj = "¯\_(ツ)_/¯": 2
//│ ╙──      	             ^
//│ obj = {"¯_(ツ)_/¯": 2}

:w
obj."¯\_(ツ)_/¯"
//│ ╔══[WARNING] Found invalid escape character
//│ ║  l.+1: 	obj."¯\_(ツ)_/¯"
//│ ╙──      	       ^
//│ = 2

:expect "¯\\_(ツ)_/¯"
"¯\\_(ツ)_/¯"
//│ = "¯\\_(ツ)_/¯"


