:js


let arr = [1, 2, 3]
//│ arr = [1, 2, 3]

arr.1
//│ = 2

arr."1"
//│ = 2

// Equivalent:
arr.'1
//│ = 2


{a: 123}.'a
//│ = 123

{'a: 123}.'a
//│ = 123

{"a": 123}.'a
//│ = 123


let obj = a: 1
//│ obj = {a: 1}

obj.a
//│ = 1

obj .a
//│ = 1

obj
  .a
//│ = 1

