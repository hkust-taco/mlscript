:.
:js


// * A class with a primary constructor can't be overloaded with a term,
// * as the primary constructor acts like an overloaded function.
:e
fun Foo(x) = new Foo(x, 0)
data class Foo(x, y)
//│ ╔══[COMPILATION ERROR] Not yet supported: overloading of function 'Foo'
//│ ║  l.+1: 	fun Foo(x) = new Foo(x, 0)
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── with class of the same name
//│ ║  l.+2: 	data class Foo(x, y)
//│ ╙──      	     ^^^^^^^^^^^^^^^

fun Foo(x) = new Foo(x, 0)
data class Foo { constructor(x, y) }

Foo(123)
//│ = Foo

:e
Foo(123, 456)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+1: 	Foo(123, 456)
//│ ║        	^^^^^^^^^^^^^
//│ ╟── Function 'Foo' expected 1 argument, but got 2
//│ ║  l.XX: 	fun Foo(x) = new Foo(x, 0)
//│ ╙──      	^^^^^^^^^^
//│ = Foo

:e
new Foo(123)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	new Foo(123)
//│ ║        	^^^^^^^^^^^^
//│ ╟── Constructor of class 'Foo' expected 2 arguments, but got 1
//│ ║  l.XX: 	data class Foo { constructor(x, y) }
//│ ║        	^^^^^^^^^^^^^^
//│ ╟── The constructor is declared here.
//│ ║  l.XX: 	data class Foo { constructor(x, y) }
//│ ╙──      	                 ^^^^^^^^^^^^^^^^^
//│ = Foo

new Foo(123, 456)
//│ = Foo


