:.
:js


123 |.print()
//│ > 123

123 |.tuple()
//│ = [123]


tuple(123, 456)
//│ = [123, 456]

123 |.tuple(456)
//│ = [123, 456]

123 |.tuple of 456
//│ = [123, 456]

123 |.tuple @ 456
//│ = [123, 456]

123 |> (tuple(_, 456))
//│ = [123, 456]

// * Partial application syntax (see `PartialApps.mls`)
123 |> tuple(., 456)
//│ = [123, 456]


