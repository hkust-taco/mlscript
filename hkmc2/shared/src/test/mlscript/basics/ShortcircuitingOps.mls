:js


:sjs
1 && 2
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (1 === true) { return 2 } return false;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = false


fun
  loud(x) = print(x); x
  loudTrue = loud(true)
  loudFalse = loud(false)


true && loudTrue
//│ > true
//│ = true

true && loudFalse
//│ > false
//│ = false

false && loudTrue
//│ = false

:sjs
print(1 && loudTrue)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (1 === true) { Predef.print(true); return Predef.print(true) } return Predef.print(false);
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > false

:sjs
1 || 2
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (1 === false) { return 2 } return true;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = true

print(1 || 2)
//│ > true

1 || loudTrue
//│ = true

1 || loudFalse
//│ = true

true || loudTrue
//│ = true


123 || loud(42)
//│ = true

0 || loud(42)
//│ = true

123 && loud(42)
//│ = false

