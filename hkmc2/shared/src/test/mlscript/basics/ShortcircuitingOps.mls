//│ runtime.safeCall(tmp(0, false, 42, 123))
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 123


print of
  print("A") && print("B")
//│ > A
//│ > undefined false


fun (&&) foo(x, y) =
  print(x)
  print(y)
  x and y

1 && 2
//│ > 1
//│ > 2
//│ = false


