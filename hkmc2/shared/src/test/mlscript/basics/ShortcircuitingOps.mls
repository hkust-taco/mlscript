:js


:sjs
1 && 2
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (1 === true) { 2 } else { false }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = false

1 || 2
//│ = 2


fun test(x) =
  print(x)
  x

:sjs
123 || test(42)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (123 === true) { true } else { test(42) }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 42
//│ = 42

0 || test(42)
//│ > 42
//│ = 42

123 && test(42)
//│ = false

:sjs
fold(||)(0, false, 42, 123)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let lambda, tmp;
//│ lambda = (undefined, function (arg1, arg2) {
