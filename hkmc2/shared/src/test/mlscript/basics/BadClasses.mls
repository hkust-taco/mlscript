

// TODO should make better error messages!

:e
class Foo { log("hi") }
//│ ╔══[COMPILATION ERROR] Invalid class definition head: unexpected block in this position
//│ ║  l.6: 	class Foo { log("hi") }
//│ ╙──     	          ^^^^^^^^^^^^^

:e
class Foo { 1 }
//│ ╔══[COMPILATION ERROR] Invalid class definition head: unexpected block in this position
//│ ║  l.12: 	class Foo { 1 }
//│ ╙──      	          ^^^^^


// * Note that these work:

:w
class Foo with { 1 }
//│ ╔══[WARNING] Pure expression in statement position
//│ ║  l.21: 	class Foo with { 1 }
//│ ╙──      	                 ^

:w
class Foo with
  1
//│ ╔══[WARNING] Pure expression in statement position
//│ ║  l.28: 	  1
//│ ╙──      	  ^


