:sjs
id(.)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let lambda; lambda = (undefined, function (_0) { return _0 }); return lambda
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun


fun incr = => _ + 1
fun add = => _ + _

passTo(2, incr)()
//│ = 3

passTo(2, => incr(_))()
//│ = 3

passTo(2, => incr @ _)()
//│ = 3

passTo(2, => incr(.) @ _)()
//│ = 3

passTo(2, => (=> incr(_)) @ _)()
//│ = 3

passTo(2, => add(_, 2))()
//│ = 4

passTo(2, add(., 2))()
//│ = 4

passTo(1, => incr(_) + _)(2)
//│ = 4

passTo(1, => (=> incr(_)) @ _ + _)(2)
//│ = 4

passTo(1, => (=> add(_, 1)) @ _ + _)(2)
//│ = 4

passTo(1, => incr(.) @ _ + _)(2)
//│ = 4

passTo(1, => add(., 1) @ _ + _)(2)
//│ = 4


:sjs
let f = => add(_, 1)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f, f1; f1 = function f(_0) { return _0 + 1 }; f = f1;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f = fun f

let f = add(., 1)
f(1)
//│ = 2
//│ f = fun f

let f = => add of _, 1
//│ f = fun f

f(1)
//│ = 2


tuple(.)(1)
//│ = [1]

tuple(1, ., 3)(2)
//│ = [1, 2, 3]

let f = tuple(0, ., 3, .)
//│ f = fun f

f(2, 4)
//│ = [0, 2, 3, 4]

(tuple of .)(1)
//│ = [1]

(tuple of ., ., .)(1, 2, 3)
//│ = [1, 2, 3]

tuple |> apply of ., 1, 2, 3
//│ = [1, 2, 3]

Math.pow(., 2)(3)
//│ = 9

// * Partial applications can be curried
tuple(.)(.)(1)
//│ = [1]

// * Underscore placeholders are delimited outside of the partial application
(=> tuple of ., _, .)(2)(1, 3)
//│ = [1, 2, 3]

(=> tuple(_, .))(1)(2)
//│ = [1, 2]

// * A placeholder belongs to the closest enclosing application
tuple(tuple(.))
//│ = [fun]

tuple(tuple(.)).[0](1)
//│ = [1]

:sjs
let xs = [1, 2]
tuple(...xs, .)(3)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let xs1; xs1 = globalThis.Object.freeze([ 1, 2 ]); return Predef.tuple(...xs1, 3)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [1, 2, 3]
//│ xs = [1, 2]

// * The function and the other arguments are evaluated each time the partial application is called
let f = tuple(print("eval"), .)
//│ f = fun f

f(1)
f(2)
//│ > eval
//│ > eval
//│ = [(), 2]


// * Named arguments (which are passed as a record) can be placeholders
fun foo(r) = r

foo(x: ., y: 1)(0)
//│ = {x: 0, y: 1}

foo(x: ., y: .)(0, 1)
//│ = {x: 0, y: 1}


// * The partial application is a lambda, so a `return` in it is a non-local return
// * (see also `handlers/NonLocalReturns.mls`)
:e
fun foo() =
  let f = tuple(., return 2)
  f(1)
  3
//│ ╔══[COMPILATION ERROR] Non-local return statements are only supported with effect handlers enabled.
//│ ║  l.167: 	  let f = tuple(., return 2)
//│ ╙──       	                   ^^^^^^^^


// * Arguments that are not themselves placeholders delimit the placeholders in them

tuple(. + 1)
//│ = [fun]

tuple(. + 1).0(1)
//│ = 2

passTo(2, . * 10)()
//│ = 20

tuple(1, . + ., 3).1(1, 2)
//│ = 3

tuple(- .).0(1)
//│ = -1

tuple(.(1)).0(x => x + 1)
//│ = 2

tuple(. .a).0({a: 1})
//│ = 1

tuple(not .).0(true)
//│ = false

tuple(. is Str).0("a")
//│ = true

tuple(. > 0 and . < 10).0(1, 2)
//│ = true

// * A bare placeholder argument is still bound by its argument list
tuple(., . + 1)(1).1(2)
//│ = 3

tuple(key: . + 1).0.key(1)
//│ = 2

// * Explicit lambdas are not traversed, so their bodies cannot contain placeholders
:e
tuple(y => . + y)
//│ ╔══[COMPILATION ERROR] Illegal position for '.' partial application placeholder.
//│ ║  l.216: 	tuple(y => . + y)
//│ ║         	           ^
//│ ╙── A '.' placeholder must be in an argument or in parentheses, as in `pow(., 2)` or `(. + 1)`
//│ = [fun]

// * Prefix `=>` only delimits underscore placeholders
tuple(=> . + _).0(1)(2)
//│ = 3


// * Parentheses delimit the placeholders in them

(.)(1)
//│ = 1

(. + 1)(1)
//│ = 2

(- .)(1)
//│ = -1

tuple((.)).0(1)
//│ = 1

let f = (. * 2)
f(21)
//│ = 42
//│ f = fun f

1 |> (. + 1)
//│ = 2


// * Array literals bind their placeholder elements

[., 1](0)
//│ = [0, 1]

[., 1, .](0, 2)
//│ = [0, 1, 2]

[. + 1, 2]
//│ = [fun, 2]

(mut [., 1])(0)
//│ = [0, 1]


// * Instantiations bind their placeholder arguments

data class Foo(a, b)

Foo(., 1)(0)
//│ = Foo(0, 1)

(new Foo(., 1))(0)
//│ = Foo(0, 1)

new Foo(. + 1, 1).a(1)
//│ = 2

data class Bar(a)(b)

(new Bar(.)(.))(1, 2)
//│ = Bar(1)


// * `break` on a value that is not a label is an ordinary method call
let obj = new Object with
  fun break(x, y) = [x, y]
//│ obj = $anon

obj.break(., 1)(0)
//│ = [0, 1]


// * Backslash arguments

tuple(1) \ .
//│ = fun

(tuple(1) \ .)(2)
//│ = [1, 2]

(tuple(1) \ . + 1).1(2)
//│ = 3


