// * Standard syntax of ADTs (TODO)

class Expr
  constructor Lit(n: Int)
  constructor Add(lhs: Expr, rhs: Expr)
//│ ╔══[PARSE ERROR] Expected end of input; found indented block instead
//│ ║  l.8: 	  constructor Lit(n: Int)
//│ ╙──     	^^

class Expr[A] with
  constructor
    Lit(n: Int) { A = Int }
    Add(lhs: Expr[Int], rhs: Expr[Int]) { A = Int }
//│ /!!!\ Uncaught error: scala.MatchError: Constructor(Block(List(Jux(App(Ident(Lit),Tup(List(InfixApp(Ident(n),keyword ':',Ident(Int))))),Block(List(Def(Ident(A),Ident(Int))))), Jux(App(Ident(Add),Tup(List(InfixApp(Ident(lhs),keyword ':',App(Ident(Expr),TyTup(List(Ident(Int))))), InfixApp(Ident(rhs),keyword ':',App(Ident(Expr),TyTup(List(Ident(Int)))))))),Block(List(Def(Ident(A),Ident(Int)))))))) (of class hkmc2.syntax.Tree$Constructor)


// * one can also go the TypeScript way

data class Lit(n: Int)
data class Add(lhs: Expr, rhs: Expr)

type Expr = Lit | Add


// * Which could get a "blessed" shorthand syntax as well

enum Expr =
  | Lit(n: Int)
  | Add(lhs: Expr, rhs: Expr)
//│ ╔══[ERROR] Unrecognized definitional assignment left-hand side: juxtaposition
