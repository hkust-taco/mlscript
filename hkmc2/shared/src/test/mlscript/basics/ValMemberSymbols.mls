// :ssjs
:sir
:lift
// TODO: remove this flag when the lifter problem is resolved (see: the end of ClassInFun.mls)
:deadParamElim off
fun foo(x, y) =
  class A(val u) with { val v = y }
  let a = new A(x)
  [a, a.A#u, a.A#v]
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let A;
//│ define A as class A⁷ {
//│   private val y⁰;
//│   val u⁰;
//│   val v⁰;
//│   constructor A⁶(u, y) {
//│     set A⁷.this.y⁰ = y;
//│     define u⁰ as val u¹ = u;
//│     define v⁰ as val v¹ = A⁷.this.y⁰;
//│     end
//│   }
//│ };
//│ define foo⁰ as fun foo¹(x, y) { let a; set a = new A⁷(x, y); return [a, a.u¹, a.v¹] };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect [A(1), 1, 2]
foo(1, 2)
//│ = [A(1), 1, 2]


