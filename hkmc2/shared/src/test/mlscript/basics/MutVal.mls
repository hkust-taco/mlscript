:js


let cached = 1
//│ cached = 1

:sjs
set cached = 2
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ cached = 2; return runtime.Unit
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

cached
//│ = 2


object O with
  val x = 1
  let y = 1
  fun gy = y
  fun sy = set y += 1

set O.x = 2

O.x
//│ = 1

O.sy

O.gy
//│ = 2


:soir
class Foo(x, val y, mut val z)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define Foo⁰ as class Foo² {
//│   val y⁰;
//│   val z⁰;
//│   constructor Foo¹(x, y, z) { define y⁰ as val y¹ = y; define z⁰ as val z¹ = z; end }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:soir
class Foo(x, val y, mut val z) with
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define Foo³ as class Foo⁵ {
//│   private val x⁰;
//│   val y²;
//│   val z²;
//│   constructor Foo⁴(x, y, z) {
//│     set Foo⁵.this.x⁰ = x;
//│     define y² as val y³ = y;
//│     define z² as val z³ = z;
//│     do Predef⁰.print⁰(Foo⁵.this.x⁰);
//│     end
//│   }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let f = Foo(1, 2, 3)
//│ > 1
//│ f = Foo(_, 2, 3)

f.z
//│ = 3

set f.z = 0

f.z
//│ = 0


data class Foo(mut val x)

let f = Foo(1)
//│ f = Foo(1)

set f.x = 2

f.x
//│ = 2
