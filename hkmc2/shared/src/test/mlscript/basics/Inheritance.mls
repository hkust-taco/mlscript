:js


class Foo with
  val x = 10
  fun foo = x + 1


object Bar extends Foo

:todo // recognize fields that are inherited from superclasses
[Bar.x, Bar.foo]
//│ ╔══[ERROR] Object 'Bar' does not contain member 'x'
//│ ║  l.12: 	[Bar.x, Bar.foo]
//│ ╙──      	    ^^
//│ ╔══[ERROR] Object 'Bar' does not contain member 'foo'
//│ ║  l.12: 	[Bar.x, Bar.foo]
//│ ╙──      	           ^^^^
//│ = [10, 11]

let b = id(Bar) in [b.x, b.foo]
//│ = [10, 11]

Bar is Foo
//│ = true

Bar is String
//│ = false


// :pt
// :elt
// :de
data class Bar(y) extends Foo with
  fun bar = y + 1

let b = Bar(42)
//│ b = Bar(42)

b is Foo
//│ = true

b is String
//│ = false

[b.x, b.foo]
//│ = [10, 11]


:sjs
data class Baz(z) extends Bar(z * 1) with
  fun baz = this.bar * 2
//│ JS (unsanitized):
//│ let Baz1;
//│ Baz1 = function Baz(z) {
