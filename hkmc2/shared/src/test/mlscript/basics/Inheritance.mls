//│   }
//│   constructor(z) {
//│     let tmp;
//│     tmp = z * 1;
//│     super(tmp);
//│     this.z = z;
//│   }
//│   get baz() {
//│     return this.bar * 2;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Baz", ["z"]]; 
//│ });

let b = Baz(42)
//│ b = Baz(42)

b is Foo
//│ = true

b is String
//│ = false

[b.x, b.foo]
//│ = [10, 11]



abstract class Option[out T]: Some[T] | None
object None extends Option[Nothing]
data class Some[out T](x: T) extends Option[T]
[Some(123) is Option, None is Option, Some(123) is String, None is String]
//│ = [true, true, false, false]


data class Barr(x: Int)(y: Int) with
  fun f = x + y

