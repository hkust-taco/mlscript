:.
:js


// Dynamic receivers keep property additions and missing-field checks observable at runtime.
let r = ({a: 0} as dyn)
//│ r = {a: 0}

set
  r.a = 1
  r.foo = 1

:expect 0
r.a
//│ = 0

:re
r.foo
//│ ═══[RUNTIME ERROR] Error: Access to required field 'foo' yielded 'undefined'


let r = mut {a: 1} as dyn
//│ r = {a: 1}

set
  r.a = 1
  r.foo = 1

:expect 1
r.a
//│ = 1

:expect 1
r.foo
//│ = 1


let r = mut {} as dyn
//│ r = {}

set r.foo = 1

:expect 1
r.foo
//│ = 1


:sjs
let r = ({} as dyn)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let r3; r3 = runtime.Unit;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ r = ()

:re
r.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

set r.foo = 1

:re
r.foo
//│ ═══[RUNTIME ERROR] Error: Access to required field 'foo' yielded 'undefined'

:re
(() as dyn).foo
//│ ═══[RUNTIME ERROR] Error: Access to required field 'foo' yielded 'undefined'

let s = ({} as dyn)
//│ s = ()

set s.foo = 2

:re
r.foo
//│ ═══[RUNTIME ERROR] Error: Access to required field 'foo' yielded 'undefined'


:e
mut()
//│ ╔══[COMPILATION ERROR] Illegal position for 'mut' modifier.
//│ ║  l.80: 	mut()
//│ ╙──      	^^^


let r = mut
  x: 1
//│ r = {x: 1}

Object.freeze(r)
//│ = {x: 1}

set r.x = 2

:expect 1
r.x
//│ = 1


