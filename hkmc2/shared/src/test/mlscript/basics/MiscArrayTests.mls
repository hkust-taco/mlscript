xs
//│ = [0, 1, 2]

let xs = mut [...xs]
//│ xs = [0, 1, 2]

let f = xs \print
//│ f = fun

f()
//│ > [0, 1, 2]

xs.reverse()
//│ = [2, 1, 0]

:re
