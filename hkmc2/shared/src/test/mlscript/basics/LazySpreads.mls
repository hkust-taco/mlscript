//│       element0$ = runtime.Tuple.get(caseScrut, 0);
//│       middleElements3 = runtime.safeCall(runtime.Tuple.slice(caseScrut, 1, 1));
//│       lastElement0$3 = runtime.Tuple.get(caseScrut, -1);
