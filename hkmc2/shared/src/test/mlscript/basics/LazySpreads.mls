//│   return lambda
//│ };

:expect 30
sum2(arr)
//│ = 30

:e
fun f(..xs) = xs
//│ ╔══[ERROR] Lazy spread parameters not allowed.
//│ ║  l.81: 	fun f(..xs) = xs
//│ ╙──      	      ^^^^

:ge
sum2(..arr)
//│ ╔══[COMPILATION ERROR] Lazy spreads are not supported in call arguments
//│ ║  l.87: 	sum2(..arr)
//│ ╙──      	    ^^^^^^^
//│ ═══[RUNTIME ERROR] Error: Function expected 1 argument but got 2


fun map2(f) = case
  [] then []
  [x, ..xs, y] then [f(x), ..map2(f)(xs), f(y)]

:expect [10, 8, 6, 4, 2, 2, 4, 6, 8, 10]
map2(x => x * 2)(arr)
//│ = [10, 8, 6, 4, 2, 2, 4, 6, 8, 10]
