private fun map2(f) = case
  [] then []
  [x, ..xs, y] then [f(x), ..map2(f)(xs), f(y)]

:expect [10, 8, 6, 4, 2, 2, 4, 6, 8, 10]
map2(x => x * 2)(arr)
//│ = [10, 8, 6, 4, 2, 2, 4, 6, 8, 10]

// A lazy spread builds a collection whose slice can keep its lazy representation.
:sir
:siret
:expect [false, true]
private fun rest(xs) = if xs is [_, ..ys] then ys
[Array.isArray(rest([0, ..[1, 2]])), Array.isArray(rest([0, ...[1, 2]]))]
