:js


fun f =
  print("reachable")
  return
  print("unreachable")

f
//│ > reachable


fun foo(x) =
  if x do
    print("true")
    return 42
  print("false")
  0

foo(true)
//│ > true
//│ = 42

foo(false)
//│ > false
//│ = 0


fun foo(x) =
  return
    print("returning...")
    x

foo(123)
//│ > returning...
//│ = 123


