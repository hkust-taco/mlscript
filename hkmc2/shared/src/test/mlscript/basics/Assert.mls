:re
assert false
//│ ═══[RUNTIME ERROR] Error: Assertion failed (Assert.mls:18)

assert xs is Array


// * FIXME: Error-prone!!
:sjs
:fixme
assert(true); 123
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
