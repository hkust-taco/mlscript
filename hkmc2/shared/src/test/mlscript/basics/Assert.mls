:js


let xs = [1, 2, 3]
//│ xs = [1, 2, 3]

:sjs
assert true
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (true === true) {
//│   return runtime.Unit
//│ }
//│ return runtime.safeCall(runtime.assertFail("Assert.mls", "9"));
