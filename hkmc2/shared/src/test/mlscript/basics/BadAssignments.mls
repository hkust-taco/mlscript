

fun x = 1

:ge
set x
//│ ╔══[COMPILATION ERROR] Expected a right-hand side for this assignment
//│ ║  l.+1: 	set x
//│ ╙──      	    ^

:ge
set x = 0
//│ ╔══[COMPILATION ERROR] Cannot assign to function 'x'
//│ ║  l.+1: 	set x = 0
//│ ║        	    ^^^^^
//│ ╟── Defined here:
//│ ║  l.XX: 	fun x = 1
//│ ╙──      	^^^^^^^^^


val x = 1

:ge
set x = 0
//│ ╔══[COMPILATION ERROR] Cannot assign to value 'x'
//│ ║  l.+1: 	set x = 0
//│ ║        	    ^^^^^
//│ ╟── Defined here:
//│ ║  l.XX: 	val x = 1
//│ ╙──      	^^^^^^^^^


:ge
mut val x = 1
//│ ╔══[COMPILATION ERROR] Mutable 'val' definitions are only valid as members of a module, object, or class definition
//│ ║  l.+1: 	mut val x = 1
//│ ╙──      	    ^^^^^^^^^

:ge
set x = 0
//│ ╔══[COMPILATION ERROR] Cannot assign to symbol 'x'
//│ ║  l.+1: 	set x = 0
//│ ║        	    ^^^^^
//│ ╟── Defined here:
//│ ║  l.XX: 	mut val x = 1
//│ ╙──      	    ^^^^^^^^^


:ge
fun foo() =
  val x = 1
  set x = 2
//│ ╔══[COMPILATION ERROR] Cannot assign to value 'x'
//│ ║  l.+3: 	  set x = 2
//│ ║        	      ^^^^^
//│ ╟── Defined here:
//│ ║  l.+2: 	  val x = 1
//│ ╙──      	  ^^^^^^^^^

:ge
fun foo() =
  mut val x = 1
  set x = 2
//│ ╔══[COMPILATION ERROR] Mutable 'val' definitions are only valid as members of a module, object, or class definition
//│ ║  l.+2: 	  mut val x = 1
//│ ╙──      	      ^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Cannot assign to symbol 'x'
//│ ║  l.+3: 	  set x = 2
//│ ║        	      ^^^^^
//│ ╟── Defined here:
//│ ║  l.+2: 	  mut val x = 1
//│ ╙──      	      ^^^^^^^^^


class X
module X

:ge
set X = 2
//│ ╔══[COMPILATION ERROR] Cannot assign to overloaded class and module 'X'
//│ ║  l.+1: 	set X = 2
//│ ║        	    ^^^^^
//│ ╟── Defined here:
//│ ║  l.XX: 	class X
//│ ║        	^^^^^^^
//│ ║  l.XX: 	module X
//│ ╙──      	^^^^^^^^


:ge
set globalThis = 0
//│ ╔══[COMPILATION ERROR] Cannot assign to symbol 'globalThis'
//│ ║  l.+1: 	set globalThis = 0
//│ ╙──      	    ^^^^^^^^^^^^^^


