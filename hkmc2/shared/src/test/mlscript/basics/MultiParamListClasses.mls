// class Foo(using z: Int)
// * is to be understood as
class Foo0
fun Foo(using z: Int) = new mut Foo0 !> res =>
  set res.z = z

using Int = 123

Foo
//│ = Foo0 { z: 123 }

// class Foo(x, y)(using z)
// * is to be understood as
class Foo0
fun Foo(x, y)(using z: Int) = new mut Foo0 !> res =>
  set
    res.x = x
    res.y = y
    res.z = z


Foo(1, 2)
//│ = Foo0 { x: 1, y: 2, z: 123 }

:sjs
let f = Foo // should compile to `(x, y) => Foo(x, y)(use[Int])`
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f, f1; f1 = function f(x, y) { return Foo7(x, y)(instance$Ident$_Int$_) }; f = f1;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f = fun f

// Eta-expansion happens here. See EtaExpansion.mls.
f(1, 2)
//│ = Foo0 { x: 1, y: 2, z: 123 }

