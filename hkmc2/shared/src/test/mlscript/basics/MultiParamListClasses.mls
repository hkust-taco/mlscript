class Foo(x, y)(using z: Int)

// * it to be understood as
class Foo0
fun Foo(using z: Int) = new Foo0 !> res =>
  set res.z = z

using Int = 123

Foo
//│ = Foo0

// class Foo(x, y)(using z)
// * it to be understood as
class Foo0
fun Foo(x, y)(using z: Int) = new Foo0 !> res =>
  set
    res.x = x
    res.y = y
    res.z = z


Foo(1, 2)
//│ = Foo0

