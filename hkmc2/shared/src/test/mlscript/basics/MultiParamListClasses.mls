:js


data class Foo(x, y)(z)

Foo
//│ = fun Foo { class: class Foo }

Foo(1, 2)
//│ = fun

Foo(1, 2)(3)
//│ = Foo(1, 2)

:re
:sir
Foo(1, 2)(3)(4)
