:js


data class Foo(x, y)(z)

Foo
//│ = fun Foo { class: class Foo }

Foo(1, 2)
//│ = fun

Foo(1, 2)(3)
//│ = Foo(1, 2)

:re
:sir
Foo(1, 2)(3)(4)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let baseCall; set baseCall = new Foo⁰(1, 2, 3); return baseCall(4)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] TypeError: baseCall is not a function


new Foo(1, 2)
//│ = fun

new Foo(1, 2)(3)
//│ = Foo(1, 2)

:re
:sir
new Foo(1, 2)(3)(4)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let baseInst; set baseInst = new Foo⁰(1, 2, 3); return baseInst(4)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
