import "../../mlscript-compile/Iter.mls"
open Iter

filtering of [], _ =>
  1
//│ = IterableImpl(_)

=> print(_)
//│ = fun


:sjs
let test = (=> _.f(0, _, 2)) as (({f: (Int, Int, Int) -> ()}, Int) -> ())
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let test, test1;
//│ test1 = function test(_0, _1) { return runtime.safeCall(_0.f(0, _1, 2)) };
//│ test = test1;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ test = fun test

:e
:re
test(f: print)(1)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+1: 	test(f: print)(1)
//│ ║        	^^^^^^^^^^^^^^
//│ ╟── Function with a declared signature expected 2 arguments, but got 1
//│ ║  l.XX: 	let test = (=> _.f(0, _, 2)) as (({f: (Int, Int, Int) -> ()}, Int) -> ())
//│ ╙──      	                                 ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+1: 	test(f: print)(1)
//│ ║        	^^^^^^^^^^^^^^^^^
//│ ╟── Value with no known interface cannot be called like a function.
//│ ║  l.XX: 	let test = (=> _.f(0, _, 2)) as (({f: (Int, Int, Int) -> ()}, Int) -> ())
//│ ║        	                                                                      ^^
//│ ╟── No member interface is known for this type.
//│ ║  l.XX: 	let test = (=> _.f(0, _, 2)) as (({f: (Int, Int, Int) -> ()}, Int) -> ())
//│ ╙──      	                                                                      ^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

test((f: print), 1)
//│ > 0 1 2

test({f: print}, 1)
//│ > 0 1 2

{f: print}
//│ = {f: fun print}

({f: print})
//│ = {f: fun print}

[{f: print}]
//│ = [{f: fun print}]

[{f: print}, 1]
//│ = [{f: fun print}, 1]


print(=> inc(_))
//│ > fun

:sjs
=> _ is Int
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let lambda10;
//│ lambda10 = (undefined, function (_0) {
