:re
test(f: print)(1)
//│ ═══[RUNTIME ERROR] Error: Function expected 2 arguments but got 1

test((f: print), 1)
//│ > 0 1 2

test({f: print}, 1)
//│ > 0 1 2

{f: print}
//│ = {f: fun print}

({f: print})
//│ = {f: fun print}

[{f: print}]
//│ = [{f: fun print}]

[{f: print}, 1]
//│ = [{f: fun print}, 1]


