//│   return false;
//│ });
//│ return lambda10
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun

let f = => _ is Int
[f(1), f("1")]
//│ = [true, false]
//│ f = fun f

[1, "a", 3, true] filtering(=> _ is Int) toArray()
//│ = [1, 3]

42 is _
//│ = true


let x_to = => x: _
//│ x_to = fun x_to

x_to(42)
//│ = {x: 42}


