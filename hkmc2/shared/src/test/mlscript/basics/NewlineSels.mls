:js


let rcd = a: b: c: 1
//│ rcd = {a: {b: {c: 1}}}

rcd.a.b.c
//│ = 1

rcd
  .a
//│ = {b: {c: 1}}

rcd
  .a
  .b
//│ = {c: 1}

rcd
  .a.b
//│ = {c: 1}

rcd
  .a
  .b
  .c
//│ = 1

rcd
  .a.b.c
//│ = 1

rcd
  .a.b
  .c
//│ = 1

