let rcd =
  a: x => b: y => c: x + y
//│ rcd = {a: fun a}

rcd.a(1).b(2).c
//│ = 3

rcd
  .a(1)
  .b(2)
  .c
//│ = 3

rcd
  .a(1).b(2)
  .c
//│ = 3

rcd
  .a(1)
  .b(2).c
//│ = 3

rcd
  .a(1)
  .b(2)
  .c + 1
//│ = 4

