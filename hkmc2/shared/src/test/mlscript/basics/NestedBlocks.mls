// * Checking that a `val` in a nested block is not treated as a member of the enclosing object

object Foo with
  if true then
    val x = 0

:e
:re
Foo.x
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.13: 	Foo.x
//│ ║        	^^^^^
//│ ╟── Object 'Foo' does not contain member 'x'
//│ ║  l.7: 	object Foo with
//│ ╙──     	       ^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


module Oops with
  if true then
    fun f = 1
    ()

// * We used to forget to reset the owner to None in sub-blocks like this one
:e
:re
object Oops with
  if true then
    val fakeField = 1
    print(fakeField)
  print(this.fakeField) // shouldn't work!
