fun start(x, f) =
  while x do
    f(() => x)

// if `z` and `g` is defined in a nested scoped block
// and `g` is floated out to the top level, `z` in `g` gets unbound.
// so currently nested `if`s do not get nested `Scoped` blocks
:sjs
fun f(x) =
  if x do
    if x do
      let z = 3
      fun g() = z
