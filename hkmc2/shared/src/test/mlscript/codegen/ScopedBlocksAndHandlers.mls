// The class body generated by the handler is in the
// top level of the function, and it refers to `g`.
// So there would be problems if the declartion of `g`
// is nested inside the first `if`.
:expect 2
fun foo(h) =
  h.perform()
  if true then
    if true then
      fun g() = 2
      g()
  else
    fun g() = 3
    g()
handle h = Effect with
  fun perform()(k) = k(())
foo(h)
//│ = 2



