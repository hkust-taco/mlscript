:.
:js


// === Basic constructor with single param list ===

// Note: an empty constructor parameter list is parsed as the unit literal `()`
:pt
class Foo with
  constructor()
  fun get = 0
//│ ———————————————| Parsed tree |——————————————————————————————————————————————————————————————————————
//│ TypeDef:
//│   k = Cls
//│   head = InfixApp:
//│     lhs = Ident of "Foo"
//│     kw = Keywrd of keyword 'with'
//│     rhs = Block of Ls of
//│       Constructor of Unt
//│       TermDef:
//│         k = Fun
//│         head = Ident of "get"
//│         rhs = S of IntLit of 0
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect 0
new Foo().get
//│ = 0

class Foo with
  constructor()(x)
  fun get = x

:expect 1
new Foo()(1).get
//│ = 1

// Plain class with constructor(x, y) generates JS constructor with field assignments
:sjs
class Foo with
  constructor(x, y)
  fun getX = x
  fun getY = y
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let Foo5;
//│ (class Foo4 {
//│   static {
//│     Foo5 = this
//│   }
//│   constructor(x, y) {
//│     this.#x = x;
//│     this.#y = y;
//│   }
//│   #x;
//│   #y;
//│   get getX() {
//│     return this.#x;
//│   }
//│   get getY() {
//│     return this.#y;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Foo"];
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let f = new Foo(1, 2)
//│ f = Foo

f.getX
//│ = 1

f.getY
//│ = 2


// === Multiple constructor param lists ===

// constructor(x, y)(u, v) flattens into single JS constructor
class Bar with
  constructor(x, y)(u, v)
  fun sum() = x + y + u + v

let b = new Bar(1, 2)(3, 4)
//│ b = Bar

b.sum()
//│ = 10


// === Main params + constructor (aux params) ===

// Foo(a, b) with { constructor(x, y)(u, v) } should have (a, b) as main
// and [(x, y), (u, v)] as aux param lists
class Baz(a, b) with
  constructor(x, y)(u, v)
  fun total() = a + b + x + y + u + v

:expect 21
Baz(1, 2)(3, 4)(5, 6).total()
//│ = 21

let mk = Baz(1, 2)(3, 4)
//│ mk = fun

mk(5, 6).total()
//│ = 21


// === Data class with constructor ===

data class Point(label) with
  constructor(x, y)
  fun coords() = [x, y]

Point("A")(1, 2).coords()
//│ = [1, 2]


// === Single aux param list on class with main params ===

class Qux(a) with
  constructor(extra)
  fun both() = a + extra

:expect 133
Qux(10)(123).both()
//│ = 133

// === Extending classes with multiple parameter lists ===

class A(val x)(val y)
class B extends A(1)(2)

:expect B { x: 1, y: 2 }
new B
//│ = B { x: 1, y: 2 }

class A(val x) with
  constructor(y)(z) 
  fun bruh = x + y + z

class B extends A(1)(2)(3)

:expect 6
new B().bruh
//│ = 6

:e
class B extends A(0)
//│ ╔══[COMPILATION ERROR] Extending a partially applied class is not supported
//│ ║  l.+1: 	class B extends A(0)
//│ ╙──      	                ^^^^

new B
//│ = B { x: 0 }

class C

:e
class D extends C(0)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	class D extends C(0)
//│ ║        	                ^^^^
//│ ╟── Class value expected 0 arguments, but got 1
//│ ║  l.XX: 	class C
//│ ╙──      	^^^^^^^
//│ ╔══[COMPILATION ERROR] Too many parameter lists for parent class
//│ ║  l.+1: 	class D extends C(0)
//│ ╙──      	                ^^^^

:e
new A(1)(2) with
  fun a = 0
//│ ╔══[COMPILATION ERROR] Extending a partially applied class is not supported
//│ ║  l.+1: 	new A(1)(2) with
//│ ║        	^^^^^^^^^^^^^^^^
//│ ║  l.+2: 	  fun a = 0
//│ ╙──      	^^^^^^^^^^^
//│ = $anon { x: 1 }

:e
new A(1)(2)(3)(4) with
  fun a = 0
//? = $anon { x: 1 }
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	new A(1)(2)(3)(4) with
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.+2: 	  fun a = 0
//│ ║        	^^^^^^^^^^^
//│ ╟── Class 'A' expected at most 3 argument lists, but got 4
//│ ║  l.XX: 	class A(val x) with
//│ ║        	^^^^^^^^^^^^^^
//│ ╟── The constructor is declared here.
//│ ║  l.XX: 	  constructor(y)(z) 
//│ ╙──      	  ^^^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Too many parameter lists for parent class
//│ ║  l.+1: 	new A(1)(2)(3)(4) with
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.+2: 	  fun a = 0
//│ ╙──      	^^^^^^^^^^^
//│ = $anon { x: 1 }
