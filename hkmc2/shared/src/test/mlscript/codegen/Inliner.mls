:js

#config(deadBranchRemoval: true)


:soir
fun f() = 0
f()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁰; define f⁰ as fun f¹() { return 0 }; return 0
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

:soir
fun f(x) = x
f(100)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f²; define f² as fun f³(x) { return x }; return 100
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 100


:soir
fun f() =
  let done(x) = x
  done
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁴;
//│ define f⁴ as fun f⁵() {
//│   let done;
//│   @private
//│   define done as fun done⁰(x) { return x };
//│   return done⁰
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// * TODO: support spread arguments like this one
:soir
:inlineThreshold 10
fun f(a, b, c) = a + b + c
print(f(1, 2, 3))
print(f(1, 2, ...[1]))
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁶, tmp, tmp1;
//│ define f⁶ as fun f⁷(a, b, c) {
//│   let tmp2;
//│   set tmp2 = +⁰(a, b);
//│   return +⁰(tmp2, c)
//│ };
//│ do Predef⁰.print⁰(6);
//│ set tmp = [1];
//│ set tmp1 = f⁷(1, 2, ...tmp);
//│ return Predef⁰.print⁰(tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 6
//│ > 4

// TODO: should be inlined
:soir
:expect [1, [2, 3, 4]]
fun f(x, ...ys) = [x, ys]
let
  us = [1, 2, 3]
  v = 4
f(...us, v)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁸, us⁰, v⁰;
//│ define f⁸ as fun f⁹(x, ...ys) {
//│   return [x, ys]
//│ };
//│ set us⁰ = [1, 2, 3];
//│ set v⁰ = 4;
//│ return f⁹(...us⁰, 4)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [1, [2, 3, 4]]
//│ us = [1, 2, 3]
//│ v = 4


:soir
:inlineThreshold 10
fun f(a, ...b) =
  print(a)
  print(b)
f(1, ...[2])
f(1, ...[2], ...[3])
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f¹⁰, tmp, tmp1, tmp2;
//│ define f¹⁰ as fun f¹¹(a, ...b) {
//│   do Predef⁰.print⁰(a);
//│   return Predef⁰.print⁰(b)
//│ };
//│ set tmp = [2];
//│ do f¹¹(1, ...tmp);
//│ set tmp1 = [2];
//│ set tmp2 = [3];
//│ return f¹¹(1, ...tmp1, ...tmp2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ > [2]
//│ > 1
//│ > [2, 3]


// All inlined
:soir
:inlineThreshold 10
fun f(a, b, ...c) =
  print(a + b)
  print(c)
f(1, 2)
f(1, 2, 3)
f(1, 2, 3, 4)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f¹², c⁰, c¹, c²;
//│ define f¹² as fun f¹³(a, b, ...c) {
//│   let tmp;
//│   set tmp = +⁰(a, b);
//│   do Predef⁰.print⁰(tmp);
//│   return Predef⁰.print⁰(c)
//│ };
//│ set c⁰ = mut [];
//│ do Predef⁰.print⁰(3);
//│ do Predef⁰.print⁰(c⁰);
//│ set c¹ = mut [3];
//│ do Predef⁰.print⁰(3);
//│ do Predef⁰.print⁰(c¹);
//│ set c² = mut [3, 4];
//│ do Predef⁰.print⁰(3);
//│ return Predef⁰.print⁰(c²)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 3
//│ > []
//│ > 3
//│ > [3]
//│ > 3
//│ > [3, 4]

// only inline perfect match when spread is used
:sjs
:inlineThreshold 10
fun f(a, b, ...c) =
  print(a + b)
  print(c)
f(1, ...[2, 3])
f(1, 2, ...[3])
f(1, 2, 3, ...[4])
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f7, tmp5, tmp6, tmp7;
//│ f7 = function f(a, b, ...c3) {
//│   let tmp8;
//│   tmp8 = a + b;
//│   Predef.print(tmp8);
//│   return Predef.print(c3)
//│ };
//│ tmp5 = globalThis.Object.freeze([
//│   2,
//│   3
//│ ]);
//│ f7(1, ...tmp5);
//│ tmp6 = globalThis.Object.freeze([
//│   3
//│ ]);
//│ f7(1, 2, ...tmp6);
//│ tmp7 = globalThis.Object.freeze([ 4 ]);
//│ return f7(1, 2, 3, ...tmp7)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 3
//│ > [3]
//│ > 3
//│ > [3]
//│ > 3
//│ > [3, 4]


// Multiple return points
:sjs
:expect true
fun f() =
  fun g(x) =
    if x is true do return true
    return false
  g(true)
f()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f8; f8 = function f() { return true }; return true
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = true

:inlineThreshold 10
:soir
:expect true
fun f() =
  fun g(x) =
    if x is true do return true
    return false
  g(g(true))
f()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f¹⁴; define f¹⁴ as fun f¹⁵() { return true }; return true
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = true


// Inline annotations
open annotations

// f1 does not inline into f, despite being small enough
// The threshold for inlining this is separate and stricter than the usual limit
// The call to f is inlined
:sjs
:inlineThreshold 100
fun f1(a, b, c) = (a + b + c + 1) * 2
@inline fun f(a)(b)(c) = f1(a, b, c)
f(1)(2)(3)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f10, f11;
//│ f11 = function f1(a, b, c3) {
//│   let tmp8, tmp9, tmp10;
//│   tmp8 = a + b;
//│   tmp9 = tmp8 + c3;
//│   tmp10 = tmp9 + 1;
//│   return tmp10 * 2
//│ };
//│ f10 = function f(a) { return (b) => { return (c3) => { return f11(a, b, c3) } } };
//│ return 14
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 14

// lifter wrapper uses inline annotation under the hood
// currently no inlining happens because multi-call isn't recognized
:soir
:lift
:inlineThreshold 100
fun foo(x)(y) =
  let lam = z => x + y + z
  print(lam(4))
  lam
foo(1)(2)(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let foo⁰, lam$⁰, foo$worker⁰;
//│ @inline @private
//│ define lam$⁰ as fun lam$¹(x, y)(z) {
//│   let tmp;
//│   set tmp = +⁰(x, y);
//│   return +⁰(tmp, z)
//│ };
//│ @inline
//│ define foo⁰ as fun foo¹(x)(y) {
//│   return foo$worker¹(x, y)
//│ };
//│ define foo$worker⁰ as fun foo$worker¹(x, y) {
//│   let inlinedVal, tmp;
//│   set tmp = +⁰(x, y);
//│   set inlinedVal = +⁰(tmp, 4);
//│   do Predef⁰.print⁰(inlinedVal);
//│   return lam$¹(x, y)
//│ };
//│ do Predef⁰.print⁰(7);
//│ return 6
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 7
//│ = 6

// Pathological cases
:soir
:noTailRec
@inline fun f() = f()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f¹⁶; @inline define f¹⁶ as fun f¹⁷() { return f¹⁷() }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// inlining done inside function with inline annotation
:soir
@inline fun f() = 1
@inline fun g() = f()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f¹⁸, g⁰;
//│ @inline
//│ define f¹⁸ as fun f¹⁹() { return 1 };
//│ @inline
//│ define g⁰ as fun g¹() { return 1 };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// Methods (not implemented currently)
// NOTE: only final (ie, non-virtual) method may be inlined, as they could be overriden

:sjs
:soir
:inlineThreshold 10
module A with
  fun f() = 1
  fun g() = A.f()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let A1;
//│ (class A {
//│   static {
//│     A1 = this
//│   }
//│   static f() {
//│     return 1
//│   }
//│   static g() {
//│     return A1.f()
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "A"];
//│ });
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let A⁰;
//│ define A⁰ as class A¹
//│ module A² { method f²⁰ = fun f²¹() { return 1 } method g² = fun g³() { return A².f²¹() } };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// Inlining limits
:soir
:inlineThreshold 10
fun f() = if hide(false) do f() + 1
f()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f²²;
//│ define f²² as fun f²³() {
//│   let scrut;
//│   set scrut = Predef⁰.hide⁰(false);
//│   match scrut
//│     true =>
//│       do f²³();
//│       return runtime⁰.Unit⁰
//│     else
//│       return runtime⁰.Unit⁰
//│   end
//│ };
//│ return f²³()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// Pathological case of inlining
:soir
fun g() =
  fun f() = f()
  f()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let g⁴; define g⁴ as fun g⁵() { let f; define f as fun f²⁴() { return f²⁴() }; return f²⁴() }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


