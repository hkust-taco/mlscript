:js

:sjs
fun f() = 0
f()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f; f = function f() { return 0 }; 0
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

:sjs
fun f(x) = x
f(100)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f1, x; f1 = function f(x1) { return x1 }; x = 100; x
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 100


:sjs
fun f() =
  let done(x) = x
  done
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f2;
//│ f2 = function f() {
//│   let done, done1;
//│   done1 = function done(x1) { return x1 };
//│   done = done1;
//│   return done
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sir
:inlineThreshold 10
fun f(a, b, c) = a + b + c
f(1, 2, 3)
f(1, 2, ...[1])
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f⁰, tmp, a⁰, b⁰, c⁰, tmp1;
//│ define f⁰ as fun f¹(a, b, c) {
//│   let tmp2;
//│   set tmp2 = +⁰(a, b);
//│   return +⁰(tmp2, c)
//│ };
//│ set a⁰ = 1;
//│ set b⁰ = 2;
//│ set c⁰ = 3;
//│ set tmp1 = +⁰(a⁰, b⁰);
//│ set tmp = [1];
//│ f¹(1, 2, ...tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 4


// All inlined
:sir
:inlineThreshold 10
fun f(a, b, ...c) =
  print(a + b)
  print(c)
f(1, 2)
f(1, 2, 3)
f(1, 2, 3, 4)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f², a¹, b¹, c¹, tmp, a², b², c², tmp1, a³, b³, c³, tmp2;
//│ define f² as fun f³(a, b) {
//│   let tmp3;
//│   set tmp3 = +⁰(a, b);
//│   do Predef⁰.print⁰(tmp3);
//│   return Predef⁰.print⁰(c⁴)
//│ };
//│ set a¹ = 1;
//│ set b¹ = 2;
//│ set c¹ = mut [];
//│ set tmp = +⁰(a¹, b¹);
//│ do Predef⁰.print⁰(tmp);
//│ do Predef⁰.print⁰(c¹);
//│ set a² = 1;
//│ set b² = 2;
//│ set c² = mut [3];
//│ set tmp1 = +⁰(a², b²);
//│ do Predef⁰.print⁰(tmp1);
//│ do Predef⁰.print⁰(c²);
//│ set a³ = 1;
//│ set b³ = 2;
//│ set c³ = mut [3, 4];
//│ set tmp2 = +⁰(a³, b³);
//│ do Predef⁰.print⁰(tmp2);
//│ Predef⁰.print⁰(c³)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 3
//│ > []
//│ > 3
//│ > [3]
//│ > 3
//│ > [3, 4]

// only inline perfect match when spread is used
:sjs
:inlineThreshold 10
fun f(a, b, ...c) =
  print(a + b)
  print(c)
f(1, ...[2, 3])
f(1, 2, ...[3])
f(1, 2, 3, ...[4])
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f5, tmp4, tmp5, tmp6, a3, b3, c3, tmp7;
//│ f5 = function f(a4, b4, ...c4) {
//│   let tmp8;
//│   tmp8 = a4 + b4;
//│   Predef.print(tmp8);
//│   return Predef.print(c4)
//│ };
//│ tmp4 = globalThis.Object.freeze([
//│   2,
//│   3
//│ ]);
//│ f5(1, ...tmp4);
//│ tmp5 = globalThis.Object.freeze([
//│   3
//│ ]);
//│ a3 = 1;
//│ b3 = 2;
//│ c3 = tmp5;
//│ tmp7 = a3 + b3;
//│ Predef.print(tmp7);
//│ Predef.print(c3);
//│ tmp6 = globalThis.Object.freeze([ 4 ]);
//│ f5(1, 2, 3, ...tmp6)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 3
//│ > [3]
//│ > 3
//│ > [3]
//│ > 3
//│ > [3, 4]



:sjs
:lot
:inlineThreshold 10
module A with
  fun f() = 1
  fun g() = A.f()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let A1;
//│ (class A {
//│   static {
//│     A1 = this
//│   }
//│   constructor() {
//│     runtime.Unit;
//│   }
//│   static f() {
//│     return 1
//│   } 
//│   static g() {
//│     return A1.f()
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "A"]; 
//│ });
//│ —————————————| Lowered IR Tree |————————————————————————————————————————————————————————————————————
//│ Program:
//│   imports = Nil
//│   main = Scoped(syms = {member:A⁰}): 
//│     body = Define:
//│       defn = ClsLikeDefn:
//│         owner = N
//│         isym = class:A¹
//│         sym = member:A⁰
//│         ctorSym = N
//│         k = Cls
//│         paramsOpt = N
//│         auxParams = Nil
//│         parentPath = N
//│         methods = Nil
//│         privateFields = Nil
//│         publicFields = Nil
//│         preCtor = End of ""
//│         ctor = Return:
//│           res = Select{sym=object:Unit⁰}:
//│             qual = Ref:
//│               l = tmp:runtime⁰
//│               disamb = N
//│             name = Ident of "Unit"
//│           implct = true
//│         companion = S of ClsLikeBody:
//│           isym = module:A²
//│           methods = Ls of 
//│             FunDefn:
//│               owner = S of module:A²
//│               sym = member:f⁴
//│               dSym = term:A²/f⁵
//│               params = Ls of 
//│                 ParamList:
//│                   flags = ()
//│                   params = Nil
//│                   restParam = N
//│               body = Return:
//│                 res = Lit of IntLit of 1
//│                 implct = false
//│             FunDefn:
//│               owner = S of module:A²
//│               sym = member:g⁰
//│               dSym = term:A²/g¹
//│               params = Ls of 
//│                 ParamList:
//│                   flags = ()
//│                   params = Nil
//│                   restParam = N
//│               body = Return:
//│                 res = Call:
//│                   fun = Select{sym=term:A²/f⁵}:
//│                     qual = Ref{disamb=module:A²}:
//│                       l = member:A⁰
//│                       disamb = S of module:A²
//│                     name = Ident of "f"
//│                   args = Nil
//│                 implct = false
//│           privateFields = Nil
//│           publicFields = Nil
//│           ctor = End of ""
//│         bufferable = N
//│       rest = End of ""
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
