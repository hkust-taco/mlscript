:js

:sjs
fun f() = 0
f()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f, inlinedVal; f = function f() { return 0 }; inlinedVal = 0; inlinedVal
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

:sjs
fun f(x) = x
f(100)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f1, x, inlinedVal1; f1 = function f(x1) { return x1 }; x = 100; inlinedVal1 = x; inlinedVal1
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 100


:sjs
fun f() =
  let done(x) = x
  done
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f2;
//│ f2 = function f() {
//│   let done, done1;
//│   done1 = function done(x1) { return x1 };
//│   done = done1;
//│   return done
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:soir
:inlineThreshold 10
fun f(a, b, c) = a + b + c
print(f(1, 2, 3))
print(f(1, 2, ...[1]))
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁰, tmp, tmp1, tmp2, a⁰, b⁰, c⁰, inlinedVal, tmp3;
//│ define f⁰ as fun f¹(a, b, c) {
//│   let tmp4;
//│   set tmp4 = +⁰(a, b);
//│   return +⁰(tmp4, c)
//│ };
//│ set a⁰ = 1;
//│ set b⁰ = 2;
//│ set c⁰ = 3;
//│ begin
//│   set tmp3 = +⁰(a⁰, b⁰);
//│   set inlinedVal = +⁰(tmp3, c⁰);
//│   end;
//│   set tmp = inlinedVal;
//│   do Predef⁰.print⁰(tmp);
//│   set tmp1 = [1];
//│   set tmp2 = f¹(1, 2, ...tmp1);
//│   Predef⁰.print⁰(tmp2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 6
//│ > 4


// All inlined
:soir
:inlineThreshold 10
fun f(a, b, ...c) =
  print(a + b)
  print(c)
f(1, 2)
f(1, 2, 3)
f(1, 2, 3, 4)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f², a¹, b¹, c¹, a², b², c², a³, b³, c³, inlinedVal, tmp, tmp1, tmp2;
//│ define f² as fun f³(a, b) {
//│   let tmp3;
//│   set tmp3 = +⁰(a, b);
//│   do Predef⁰.print⁰(tmp3);
//│   return Predef⁰.print⁰(c⁴)
//│ };
//│ set a¹ = 1;
//│ set b¹ = 2;
//│ set c¹ = mut [];
//│ begin
//│   set tmp2 = +⁰(a¹, b¹);
//│   do Predef⁰.print⁰(tmp2);
//│   do Predef⁰.print⁰(c¹);
//│   end;
//│   set a² = 1;
//│   set b² = 2;
//│   set c² = mut [3];
//│   begin
//│     set tmp1 = +⁰(a², b²);
//│     do Predef⁰.print⁰(tmp1);
//│     do Predef⁰.print⁰(c²);
//│     end;
//│     set a³ = 1;
//│     set b³ = 2;
//│     set c³ = mut [3, 4];
//│     begin
//│       set tmp = +⁰(a³, b³);
//│       do Predef⁰.print⁰(tmp);
//│       set inlinedVal = Predef⁰.print⁰(c³);
//│       end;
//│       inlinedVal
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 3
//│ > []
//│ > 3
//│ > [3]
//│ > 3
//│ > [3, 4]

// only inline perfect match when spread is used
:sjs
:inlineThreshold 10
fun f(a, b, ...c) =
  print(a + b)
  print(c)
f(1, ...[2, 3])
f(1, 2, ...[3])
f(1, 2, 3, ...[4])
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f5, tmp7, tmp8, tmp9, a4, b4, c4, tmp10;
//│ f5 = function f(a5, b5, ...c5) {
//│   let tmp11;
//│   tmp11 = a5 + b5;
//│   Predef.print(tmp11);
//│   return Predef.print(c5)
//│ };
//│ tmp7 = globalThis.Object.freeze([
//│   2,
//│   3
//│ ]);
//│ f5(1, ...tmp7);
//│ tmp8 = globalThis.Object.freeze([
//│   3
//│ ]);
//│ a4 = 1;
//│ b4 = 2;
//│ c4 = tmp8;
//│ tmp10 = a4 + b4;
//│ Predef.print(tmp10);
//│ Predef.print(c4);
//│ tmp9 = globalThis.Object.freeze([ 4 ]);
//│ f5(1, 2, 3, ...tmp9)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 3
//│ > [3]
//│ > 3
//│ > [3]
//│ > 3
//│ > [3, 4]


// Multiple return points
:sjs
:expect true
fun f() =
  fun g(x) =
    if x is true do return true
    return false
  g(true)
f()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f6;
//│ f6 = function f() {
//│   let x1, inlinedVal4;
//│   x1 = true;
//│   inlinedLbl: {
//│     if (x1 === true) {
//│       inlinedVal4 = true;
//│       break inlinedLbl
//│     }
//│     inlinedVal4 = false;
//│   }
//│   return inlinedVal4
//│ };
//│ f6()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = true


// Methods (not implemented currently)
// NOTE: only final method may be inlined, as they could be overriden

:sjs
:soir
:inlineThreshold 10
module A with
  fun f() = 1
  fun g() = A.f()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let A1;
//│ (class A {
//│   static {
//│     A1 = this
//│   }
//│   static f() {
//│     return 1
//│   } 
//│   static g() {
//│     return A1.f()
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "A"]; 
//│ });
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let A⁰;
//│ define A⁰ as class A¹
//│ module A² { method f⁴ = fun f⁵() { return 1 } method g⁰ = fun g¹() { return A².f⁵() } };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// Inlining limits
:soir
:inlineThreshold 10
fun f() = if false do f() + 1
f()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁶;
//│ define f⁶ as fun f⁷() {
//│   let scrut;
//│   set scrut = false;
//│   match scrut
//│     true =>
//│       do f⁷();
//│       end
//│   return runtime⁰.Unit⁰
//│ };
//│ f⁷()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// Pathological case of inlining
:soir
fun g() =
  fun f() = f()
  f()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let g²; define g² as fun g³() { let f; define f as fun f⁸() { return f⁸() }; return f⁸() }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
