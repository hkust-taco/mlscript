:js


open annotations


fun foo(x) = x + 1

// * `foo` is still inlined
:soir
@noInline
fun bar(x) = foo(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @noInline define bar⁰ as fun bar¹(x) { return +⁰(x, 1) }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// * `bar` is not inlined
:soir
fun baz(x) = bar(x) + 1
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define baz⁰ as fun baz¹(x) { let tmp; set tmp = bar¹(x); return +⁰(tmp, 1) }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// * `baz` is still inlined
:soir
baz(42)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp; set tmp = bar¹(42); return +⁰(tmp, 1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 44


