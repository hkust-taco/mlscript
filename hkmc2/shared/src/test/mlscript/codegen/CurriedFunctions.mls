:js


:soir
fun foo(x)(y) = z => x + y + z
foo(1)(2)(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let foo$worker, x, y, z, inlinedVal, tmp;
//│ @inline
//│ define foo⁰ as fun foo¹(x1)(y1) {
//│   return foo$worker⁰(x1, y1)
//│ };
//│ define foo$worker as fun foo$worker⁰(x1, y1) {
//│   let lambda;
//│   @private
//│   define lambda as fun lambda⁰(z1) {
//│     let tmp1;
//│     set tmp1 = +⁰(x1, y1);
//│     return +⁰(tmp1, z1)
//│   };
//│   return lambda⁰
//│ };
//│ set x = 1;
//│ set y = 2;
//│ set z = 3;
//│ set tmp = 3;
//│ return 6
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 6

// * Note: the lambda$¹ function is not inlined because it is only partially applied
// * (it is a lambda-lifted closure).
:sir
:soir
:lift
fun foo(x)(y) = z => x + y + z
foo(1)(2)(3)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let baseCall, lambda, lambda$;
//│ @inline @private
//│ define lambda$ as fun lambda$⁰(x, y)(z) {
//│   return lambda¹(x, y, z)
//│ };
//│ @private
//│ define lambda as fun lambda¹(x, y, z) {
//│   let tmp;
//│   set tmp = +⁰(x, y);
//│   return +⁰(tmp, z)
//│ };
//│ define foo² as fun foo³(x)(y) {
//│   let lambda$here;
//│   set lambda$here = lambda$⁰(x, y);
//│   return lambda$here
//│ };
//│ set baseCall = foo³(1)(2);
//│ return baseCall(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let lambda$;
//│ @inline @private
//│ define lambda$ as fun lambda$⁰(x, y)(z) {
//│   let tmp;
//│   set tmp = +⁰(x, y);
//│   return +⁰(tmp, z)
//│ };
//│ @inline
//│ define foo² as fun foo³(x)(y) { return lambda$⁰(x, y) };
//│ return 6
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 6


fun loudly(x) =
  print("hi", x)
  x

fun foo(x)(y) =
  print("hello")
  z =>
    print("world")
    a => print(x, y, z, a)

// * Notice that the side effects should happen in the correct order
:sir
foo(loudly(1))(loudly(2))(loudly(3))(loudly(4))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, baseCall, tmp2, callPrefix, tmp3;
//│ set tmp = loudly⁰(1);
//│ set tmp1 = loudly⁰(2);
//│ set baseCall = foo⁴(tmp)(tmp1);
//│ set tmp2 = loudly⁰(3);
//│ set callPrefix = baseCall(tmp2);
//│ set tmp3 = loudly⁰(4);
//│ return callPrefix(tmp3)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi 1
//│ > hi 2
//│ > hello
//│ > hi 3
//│ > world
//│ > hi 4
//│ > 1 2 3 4


