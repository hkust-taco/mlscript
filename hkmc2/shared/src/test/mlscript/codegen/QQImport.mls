//│ Term = module Term {Symbol: fun Symbol, ConstructorLike: class ConstructorLike, SymbolCons: fun SymbolCons, StringJoin: class StringJoin, TupleCapacity: fun TupleCapacity, Instantiation: fun Instantiation, LocalPattern: fun LocalPattern, Parameter: fun Parameter, Nested: fun Nested, PatternStub: class PatternStub, LiteralStub: fun LiteralStub, CharClass: fun CharClass, ClassLikeStub: fun ClassLikeStub, Wildcard: class Wildcard, DebrujinSplit: class DebrujinSplit, Binder: fun Binder, DebrujinBranch: fun DebrujinBranch, Accept: fun Accept, Reject: class Reject, Pattern: class Pattern, LitPattern: fun LitPattern, Var: fun Var, ClassLike: fun ClassLike, Synonym: fun Synonym, Tuple: fun Tuple, Record: fun Record, Branch: fun Branch, Split: class Split, Cons: fun Cons, Let: fun Let, Else: fun Else, End: class End, Keyword: module Keyword {If: If, While: While}, Statement: class Statement, LetDecl: fun LetDecl, DefineVar: fun DefineVar, Term: class Term1, Lit: fun Lit, Builtin: fun Builtin, Ref: fun Ref, CSRef: fun CSRef, App: fun App, Sel: fun Sel, DynSel: fun DynSel, Tup: fun Tup, IfLike: fun IfLike, Lam: fun Lam, Blk: fun Blk, New: fun New, Region: fun Region, RegRef: fun RegRef, Assgn: fun Assgn, Deref: fun Deref, SetRef: fun SetRef, Ret: fun Ret, Throw: fun Throw, Try: fun Try, Context: fun Context}

Term.print
//│ = fun print


Term.print(`42)
//│ > 42


Term.print(`+)
//│ > +


Term.print(`1 `+ `2)
//│ > (+)(1, 2)


Term.print(x `=> x)
//│ > (x_0) =>
//│ >   x_0


Term.print((x, y) `=> x `+ y)
//│ > (x_0, y_0) =>
//│ >   (+)(x_0, y_0)


Term.print(`let x = `42 `in x)
//│ > let x_0
//│ > x_0 = 42
//│ > x_0


Term.print(`if `true then `true else `false)
//│ > if 
//│ >   let scrut_0 = true
//│ >   scrut_0 is true then true
//│ >   else false


Term.print(x `=> `if x `== `0.0 then `1.0 else x)
//│ > (x_0) =>
//│ >   if 
//│ >     let scrut_0 = (==)(x_0, 0)
//│ >     scrut_0 is true then 1
//│ >     else x_0


