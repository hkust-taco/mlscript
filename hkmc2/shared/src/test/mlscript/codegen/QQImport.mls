:js
:qq



meta.print
//│ = fun print


meta.print(`42)
//│ > 42


meta.print(`+)
//│ > +


meta.print(`1 `+ `2)
//│ > (+)(1, 2)


meta.print(x `=> x)
//│ > (x_0) =>
//│ >   x_0


meta.print((x, y) `=> x `+ y)
//│ > (x_0, y_0) =>
//│ >   (+)(x_0, y_0)


meta.print(`let x = `42 `in x)
//│ > let x_0
//│ > x_0 = 42
//│ > x_0


meta.print(`if `true then `true else `false)
//│ > if 
//│ >   let scrut_0 = true
//│ >   scrut_0 is true then true
//│ >   else false


meta.print(x `=> `if x `=== `0.0 then `1.0 else x)
//│ > (x_0) =>
//│ >   if 
//│ >     let scrut_0 = (===)(x_0, 0)
//│ >     scrut_0 is true then 1
//│ >     else x_0


