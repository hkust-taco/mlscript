import "../../mlscript-compile/Option.mjs"


:e
Option.isDefined(new Option.Some(1))
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.9: 	Option.isDefined(new Option.Some(1))
//│ ║       	                 ^^^^^^^^^^^^^^^^^^
//│ ╙── Dynamic value cannot be instantiated with keyword 'new'.
//│ ╔══[COMPILATION ERROR] Cannot resolve the class instantiated here
//│ ║  l.9: 	Option.isDefined(new Option.Some(1))
//│ ╙──     	                     ^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

Option.isDefined(new! Option.Some(1))
//│ = true

Option.isDefined(new! Option.Some.class(1))
//│ = true

Option.isDefined(Option.None)
//│ = false


(new! Option.Some(1)) Option.isDefined()
//│ = true

Option.None Option.isDefined()
//│ = false


Option.None
//│ = None

new! Option.Some(1)
//│ = Some(1)

new! Option.Both(1, 2)
//│ = Both(1, 2)


Option.None
//│ = None

// * This used to misbehave due to inadequately handling the weird precedence of `new`
new! Option.Some(1)
//│ = Some(1)


