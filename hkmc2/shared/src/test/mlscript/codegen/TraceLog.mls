fun f(x) = g(x)
fun g(x) = h(x)
fun h(x) = fib(x)
f(5)
//│ > calling: f(5)
//│ > | calling: g(5)
//│ > | | calling: h(5)
//│ > | | | calling: fib(5)
//│ > | | | | calling: fib(4)
//│ > | | | | | calling: fib(3)
//│ > | | | | | | calling: fib(2)
//│ > | | | | | | | calling: fib(1)
//│ > | | | | | | | return: 1
//│ > | | | | | | | calling: fib(0)
//│ > | | | | | | | return: 0
//│ > | | | | | | return: 1
//│ > | | | | | | calling: fib(1)
//│ > | | | | | | return: 1
//│ > | | | | | return: 2
//│ > | | | | | calling: fib(2)
