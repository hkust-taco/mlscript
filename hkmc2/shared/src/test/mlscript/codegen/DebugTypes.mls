:js


:silent
val debugTypesDir = "hkmc2/shared/src/test/mlscript/codegen/"
fs.rmSync(debugTypesDir + "DebugTypesElaboration.log", {force: true})
fs.rmSync(debugTypesDir + "DebugTypesLowering.log", {force: true})


// Type definitions trace their parameters and bodies, including nested methods.
:silent
@dbg('elaboration, showUids: false, out: File("DebugTypesElaboration.log"))
class ElaborationClass(value: Int) with
  fun answer() = 1101
@dbg('elaboration, showUids: false, out: File("DebugTypesElaboration.log"))
module ElaborationModule with
  fun answer() = 1102


:silent
:expect true
val elaborationLog = fs.readFileSync(debugTypesDir + "DebugTypesElaboration.log", "utf8")
elaborationLog.includes("Elaborating ParamTree") && elaborationLog.includes("IntLit(1101)") && elaborationLog.includes("IntLit(1102)")


// A class is lowered at its companion's definition. Both annotations must take effect.
:silent
@dbg('lowering, showUids: false, out: File("DebugTypesLowering.log"))
class LoweringCompanion(value) with
  fun answer() = 1201
@dbg('lowering, showUids: false, out: File("DebugTypesLowering.log"))
module LoweringCompanion with
  fun answer() = 1202
@dbg('lowering, showUids: false, out: File("DebugTypesLowering.log"))
module LoweringModule with
  fun answer() = 1203


:silent
:expect true
val loweringLog = fs.readFileSync(debugTypesDir + "DebugTypesLowering.log", "utf8")
loweringLog.includes("Lowering.term 1201") && loweringLog.includes("Lowering.term 1202") && loweringLog.includes("Lowering.term 1203")


// New resolution runs during elaboration; class tracing includes superclass lowering too.
#lang(0.3.x)

:silent
class DebugBase(value: Int)
@dbg('resolution, showUids: false, out: File("DebugTypesElaboration.log"))
module ResolutionModule with
  fun answer() = 1301
@dbg('resolution, 'lowering, showUids: false, out: File("DebugTypesLowering.log"))
class ResolutionClass extends DebugBase(1302) with
  fun answer() = 1303


:silent
:expect true
val newResolutionLog = fs.readFileSync(debugTypesDir + "DebugTypesLowering.log", "utf8")
fs.readFileSync(debugTypesDir + "DebugTypesElaboration.log", "utf8").includes("IntLit(1301)") && newResolutionLog.includes("IntLit(1303)") && newResolutionLog.includes("Lowering.term 1302") && newResolutionLog.includes("Lowering.term 1303")


:silent
fs.rmSync(debugTypesDir + "DebugTypesElaboration.log", {force: true})
fs.rmSync(debugTypesDir + "DebugTypesLowering.log", {force: true})
