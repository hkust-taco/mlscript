module Foo with
  val f = x => x


Foo.f(1)
//│ = 1

module Bar with
  fun h(x) = x + 1
  fun w(y) = y(0)
  fun f(x) = w(h) + x

Bar.f(0)
//│ = 1

module Foo with
  fun f(x) = x + 1
  module Bar with
    fun g1(h) = h(0)
    fun g2(x) = g1(Foo.f) + x


Foo.Bar.g2(1)
//│ = 2


