//│     this.b = b;
//│   }
//│   #Lambda$$cap;
//│   call(z) {
//│     return lambda1(this.y, this.b, z)
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Lambda$"]; 
//│ });
//│ (class Lambda$1 extends globalThis.Function {
//│   static {
//│     Lambda$2 = this
//│   }
//│   constructor(x) {
//│     super();
//│     this.x = x;
//│   }
//│   #Lambda$$cap;
//│   call(z) {
//│     return lambda(this.x, z)
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Lambda$"]; 
//│ });
//│ lambda$1 = (undefined, function (x) {
//│   return globalThis.Object.freeze(new Lambda$2(x))
//│ });
//│ lambda$ = (undefined, function (y, b) {
//│   return globalThis.Object.freeze(new Lambda$3(y, b))
//│ });
//│ lambda = (undefined, function (x, z) {
//│   return x + z
//│ });
//│ lambda1 = (undefined, function (y, b, z) {
//│   if (b === true) {
//│     return y + z
//│   } else {
//│     return y - z
//│   }
//│ });
//│ f = function f(x, y, b) {
//│   let tmp, tmp1, lambda$here, lambda$here1;
