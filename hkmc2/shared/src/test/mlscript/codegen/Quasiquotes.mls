//│     Lit(true),
//│     Cons(
//│       Branch(Ref(Symbol("scrut")), LitPattern(true), Else(Lit(true))),
//│       Else(Lit(false))
//│     )
//│   )
//│ )


x `=> `if x `== `0.0 then `1.0 else x
//│ = Lam(
//│   [Symbol("x")],
//│   IfLike(
//│     If,
//│     Let(
