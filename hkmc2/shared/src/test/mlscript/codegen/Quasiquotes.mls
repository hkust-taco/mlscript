:sjs
x `=>
  print(x)
  x
//│ JS (unsanitized):
//│ let x1, tmp8, tmp9, tmp10, arr2;
//│ tmp8 = globalThis.Object.freeze(new Term.Symbol("x"));
//│ x1 = globalThis.Object.freeze(new Term.Ref(tmp8));
//│ tmp9 = Predef.print(x1);
//│ arr2 = globalThis.Object.freeze([
//│   tmp8
//│ ]);
//│ tmp10 = x1;
//│ globalThis.Object.freeze(new Term.Lam(arr2, tmp10))
//│ > Ref(Symbol("x"))
//│ = Lam([Symbol("x")], Ref(Symbol("x")))


let f = x `=> x `+ `1
//│ f = Lam([Symbol("x")], App(Builtin("+"), Tup([Ref(Symbol("x")), Lit(1)])))


f`(`0)
//│ = App(
//│   Lam([Symbol("x")], App(Builtin("+"), Tup([Ref(Symbol("x")), Lit(1)]))),
//│   Tup([Lit(0)])
//│ )


`let x = `42 `in x
//│ = Blk(
