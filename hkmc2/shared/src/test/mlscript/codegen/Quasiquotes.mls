:js


`42
//│ = Lit(42)


`3.14
//│ = Lit(3.14)


`true
//│ = Lit(true)


`"abc"
//│ = Lit("abc")


`+
//│ = Ref(Symbol("+"))


`1 `+ `2
//│ = App(Ref(Symbol("+")), Tup([Lit(1), Lit(2)]))


x `=> x
//│ = Lam([Symbol("x_0")], Ref(Symbol("x_0")))


:sjs
x `=>
  print(x)
  x
//│ JS (unsanitized):
//│ let tmp8, x1, tmp9, tmp10, tmp11;
//│ tmp8 = this.Predef.term.freshName("x");
//│ x1 = new this.Predef.term.Symbol(tmp8);
//│ tmp9 = new this.Predef.term.Ref(x1);
//│ tmp10 = Predef.print(tmp9);
//│ tmp11 = new this.Predef.term.Ref(x1);
//│ new this.Predef.term.Lam([
//│   x1
//│ ], tmp11)
//│ > Ref(Symbol("x_1"))
//│ = Lam([Symbol("x_1")], Ref(Symbol("x_1")))


let f = x `=> x `+ `1
//│ f = Lam([Symbol("x_2")], App(Ref(Symbol("+")), Tup([Ref(Symbol("x_2")), Lit(1)])))


f`(`0)
//│ = App(Lam([Symbol("x_2")], App(Ref(Symbol("+")), Tup([Ref(Symbol("x_2")), Lit(1)]))), Tup([Lit(0)]))


`let x = `42 `in x
//│ = Blk([LetDecl(Symbol("x_3")), DefineVar(Symbol("x_3"), Lit(42))], Ref(Symbol("x_3")))


`let x = `42 `in print(x); x
//│ > Ref(Symbol("x_4"))
//│ = Blk([LetDecl(Symbol("x_4")), DefineVar(Symbol("x_4"), Lit(42))], Ref(Symbol("x_4")))


:sjs
`if `true then `true else `false
//│ JS (unsanitized):
//│ let tmp36, tmp37, tmp38, tmp39, tmp40, tmp41, tmp42, tmp43, tmp44, tmp45, tmp46, tmp47;
//│ tmp36 = this.Predef.term.freshName("scrut");
//│ tmp37 = new this.Predef.term.Symbol(tmp36);
//│ tmp38 = new this.Predef.term.Lit(true);
//│ tmp39 = new this.Predef.term.Ref(tmp37);
//│ tmp40 = new this.Predef.term.LitPattern(true);
//│ tmp41 = new this.Predef.term.Lit(true);
//│ tmp42 = new this.Predef.term.Else(tmp41);
//│ tmp43 = new this.Predef.term.Branch(tmp39, tmp40, tmp42);
//│ tmp44 = new this.Predef.term.Lit(false);
//│ tmp45 = new this.Predef.term.Else(tmp44);
//│ tmp46 = new this.Predef.term.Cons(tmp43, tmp45);
//│ tmp47 = new this.Predef.term.Let(tmp37, tmp38, tmp46);
//│ new this.Predef.term.IfLike(this.Predef.term.KeywordIf, tmp47)
//│ = IfLike(KeywordIf, Let(Symbol("scrut_0"), Lit(true), Cons(Branch(Ref(Symbol("scrut_0")), LitPattern(true), Else(Lit(true))), Else(Lit(false)))))


x `=> `if x `== `0.0 then `1.0 else x
//│ = Lam([Symbol("x_5")], IfLike(KeywordIf, Let(Symbol("scrut_1"), App(Ref(Symbol("==")), Tup([Ref(Symbol("x_5")), Lit(0)])), Cons(Branch(Ref(Symbol("scrut_1")), LitPattern(true), Else(Lit(1))), Else(Ref(Symbol("x_5")))))))


term.print
//│ = [function print]


term.print(`42)
//│ > 42


term.print(`+)
//│ > +


term.print(`1 `+ `2)
//│ > (+)(1, 2)


term.print(x `=> x)
//│ > (x_6) =>
//│ >   x_6


term.print((x, y) `=> x `+ y)
//│ > (x_7, y_0) =>
//│ >   (+)(x_7, y_0)


term.print(`let x = `42 `in x)
//│ > let x_8
//│ > x_8 = 42
//│ > x_8


term.print(`if `true then `true else `false)
//│ > if 
//│ >   let scrut_2 = true
//│ >   scrut_2 is true then true
//│ >   else false


term.print(x `=> `if x `== `0.0 then `1.0 else x)
//│ > (x_9) =>
//│ >   if 
//│ >     let scrut_3 = (==)(x_9, 0)
//│ >     scrut_3 is true then 1
//│ >     else x_9
