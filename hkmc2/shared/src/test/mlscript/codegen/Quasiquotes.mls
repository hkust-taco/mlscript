let f = x `=> x `+ `1
//│ f = Lam([Symbol("x_2")], App(Builtin("+"), Tup([Ref(Symbol("x_2")), Lit(1)])))


f`(`0)
//│ = App(Lam([Symbol("x_2")], App(Builtin("+"), Tup([Ref(Symbol("x_2")), Lit(1)]))), Tup([Lit(0)]))


`let x = `42 `in x
//│ = Blk([LetDecl(Symbol("x_3")), DefineVar(Symbol("x_3"), Lit(42))], Ref(Symbol("x_3")))


`let x = `42 `in print(x); x
//│ > Ref(Symbol("x_4"))
//│ = Blk([LetDecl(Symbol("x_4")), DefineVar(Symbol("x_4"), Lit(42))], Ref(Symbol("x_4")))


