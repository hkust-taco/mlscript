:js
:qq

//│ Term = Term

`42
//│ = Lit(42)


`3.14
//│ = Lit(3.14)


`true
//│ = Lit(true)


`"abc"
//│ = Lit("abc")


`+
//│ = Builtin("+")


`1 `+ `2
//│ = App(Builtin("+"), Tup([Lit(1), Lit(2)]))


x `=> x
//│ = Lam([Symbol("x_0")], Ref(Symbol("x_0")))


:sjs
x `=>
  print(x)
  x
//│ JS (unsanitized):
//│ let x1, tmp7, tmp8, tmp9, tmp10;
//│ tmp7 = Term.freshName("x");
//│ tmp8 = new Term.Symbol(tmp7);
//│ x1 = new Term.Ref(tmp8);
//│ tmp9 = Predef.print(x1);
//│ tmp10 = x1;
//│ new Term.Lam([
//│   tmp8
//│ ], tmp10)
//│ > Ref(Symbol("x_1"))
//│ = Lam([Symbol("x_1")], Ref(Symbol("x_1")))


let f = x `=> x `+ `1
//│ f = Lam([Symbol("x_2")], App(Builtin("+"), Tup([Ref(Symbol("x_2")), Lit(1)])))


f`(`0)
//│ = App(Lam([Symbol("x_2")], App(Builtin("+"), Tup([Ref(Symbol("x_2")), Lit(1)]))), Tup([Lit(0)]))


`let x = `42 `in x
//│ = Blk([LetDecl(Symbol("x_3")), DefineVar(Symbol("x_3"), Lit(42))], Ref(Symbol("x_3")))


`let x = `42 `in print(x); x
//│ > Ref(Symbol("x_4"))
//│ = Blk([LetDecl(Symbol("x_4")), DefineVar(Symbol("x_4"), Lit(42))], Ref(Symbol("x_4")))


:sjs
`if `true then `true else `false
//│ JS (unsanitized):
