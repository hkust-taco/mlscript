//│ tmp8 = x1;
//│ new Term.Lam([
//│   tmp6
//│ ], tmp8)
//│ > Ref(Symbol("x"))
//│ = Lam([Symbol("x")], Ref(Symbol("x")))


let f = x `=> x `+ `1
//│ f = Lam([Symbol("x")], App(Builtin("+"), Tup([Ref(Symbol("x")), Lit(1)])))


f`(`0)
//│ = App(Lam([Symbol("x")], App(Builtin("+"), Tup([Ref(Symbol("x")), Lit(1)]))), Tup([Lit(0)]))


