`let x = `42 `in print(x); x
//│ > Ref(Symbol("x"))
//│ = Blk(
//│   [LetDecl(Symbol("x")), DefineVar(Symbol("x"), Lit(42))],
//│   Ref(Symbol("x"))
//│ )


