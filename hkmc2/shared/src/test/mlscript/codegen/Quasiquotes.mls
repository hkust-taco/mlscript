:js


`42
//│ = Lit(42)


`3.14
//│ = Lit(3.14)


`true
//│ = Lit(true)


`"abc"
//│ = Lit("abc")


`+
//│ = Builtin("+")


`1 `+ `2
//│ = App(Builtin("+"), Tup([Lit(1), Lit(2)]))


x `=> x
//│ = Lam([Symbol("x_0")], Ref(Symbol("x_0")))


:sjs
x `=>
  print(x)
  x
//│ JS (unsanitized):
//│ let tmp6, x1, tmp7, tmp8, tmp9;
