//│ scrut = globalThis.Object.freeze(new Term.Ref(tmp22));
//│ tmp23 = globalThis.Object.freeze(new Term.Lit(true));
//│ tmp26 = globalThis.Object.freeze(new Term.LitPattern(true));
//│ tmp31 = globalThis.Object.freeze(new Term.Lit(true));
//│ tmp27 = globalThis.Object.freeze(new Term.Else(tmp31));
