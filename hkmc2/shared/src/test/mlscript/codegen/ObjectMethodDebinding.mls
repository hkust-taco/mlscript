// * Which also works well no matter where the object is defined:

fun test() =
  object Test with
    fun bar = 1
    fun foo() = Test.bar + 1
  [Test]
//│ FAILURE: Unexpected warning
//│ FAILURE LOCATION: createMetadata (Lifter.scala:196)
//│ ╔══[WARNING] Objects are not yet lifted.
