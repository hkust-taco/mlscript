data class Cons(hd, tl)

:sjs
fun f(ls) =
  while ls is
    Cons(h, tl) then
      set ls = tl
      print(h)
  else print("Done!")
//│ JS (unsanitized):
//│ let f;
//│ f = function f(ls) {
//│   let while10, tmp18, tmp19, tmp20;
//│   tmp18 = undefined;
//│   while10 = (undefined, function () {
//│     let tl, h, argument0$, argument1$;
//│     if (ls instanceof Cons1.class) {
//│       argument0$ = ls.hd;
//│       argument1$ = ls.tl;
//│       tl = argument1$;
//│       h = argument0$;
//│       ls = tl;
//│       tmp18 = Predef.print(h);
//│       return while10()
//│     } else {
//│       tmp18 = Predef.print("Done!");
//│     }
//│     return runtime.LoopEnd
//│   });
//│   tmp19 = while10();
//│   tmp20 = tmp19 !== runtime.LoopEnd;
//│   if (tmp20 === true) { return tmp19 } else { return tmp18 }
//│ };

f(0)
//│ > Done!

f(Cons(1, 0))
//│ > 1
//│ > Done!

f(Cons(1, Cons(2, Cons(3, 0))))
//│ > 1
//│ > 2
//│ > 3
//│ > Done!

fun f(ls) =
  while
    do print(ls)
    ls is Cons(h, tl) do set ls = tl

f(Cons(1, Cons(2, Cons(3, 0))))
//│ > Cons(1, Cons(2, Cons(3, 0)))
//│ > Cons(2, Cons(3, 0))
//│ > Cons(3, 0)
//│ > 0

