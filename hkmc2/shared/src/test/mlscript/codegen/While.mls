:sjs
while x
  then
    print("Hello World")
    set x = false
  else 42
//│ JS (unsanitized):
//│ let while3, tmp4, tmp5;
//│ tmp4 = undefined;
//│ while3 = (undefined, function () {
//│   let tmp6;
//│   if (x2 === true) {
//│     tmp6 = Predef.print("Hello World");
//│     x2 = false;
//│     tmp4 = runtime.Unit;
//│     return while3()
//│   } else { tmp4 = 42; }
//│   return runtime.LoopEnd
//│ });
//│ tmp5 = while3();
//│ tmp4
//│ > Hello World
//│ = 42

