//│ ╙──       	                       ^^^^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define newIntoPlain⁰ as fun newIntoPlain¹(): ? {
//│   let tmp: rsc C²;
//│   set tmp = new rsc C²();
//│   return h¹(tmp)
//│ };
//│ end

fun mkMutNew() = new mut rsc C()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define mkMutNew⁰ as fun mkMutNew¹(): ? { return new mut rsc C²() }; end

:e
fun newWrongOrder() = new rsc mut C()
