// A partial application returns a closure, which is `rsc?` like any other function
// value, so it takes a checked cast into either kind of function slot.

fun curried(x)(y) = y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define curried⁰ as fun curried¹(x: ?)(y: ?): ? { return y }; end

fun useRscFn(g: rsc (C) -> C) = g
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useRscFn⁰ as fun useRscFn¹(g: rsc Function⁰): ? { return g }; end

fun usePlainFn(g: (C) -> C) = g
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define usePlainFn⁰ as fun usePlainFn¹(g: Function⁰): ? { return g }; end

fun partialIntoRsc(a) = useRscFn(curried(a))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define partialIntoRsc⁰ as fun partialIntoRsc¹(a: ?): ? {
//│   let tmp: rsc? Function⁰;
//│   set tmp = curried¹(a);
//│   return useRscFn¹((tmp as! rsc Function⁰))
//│ };
//│ end

fun partialIntoPlain(a) = usePlainFn(curried(a))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define partialIntoPlain⁰ as fun partialIntoPlain¹(a: ?): ? {
//│   let tmp: rsc? Function⁰;
//│   set tmp = curried¹(a);
//│   return usePlainFn¹((tmp as! Function⁰))
//│ };
//│ end
