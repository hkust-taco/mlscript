:sir
:siret

//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ import "..." as Predef; end

class C()
class D()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define C⁰ as class C² { constructor C¹ }; define D⁰ as class D² { constructor D¹ }; end


// The modifier reaches the IR as the `rsc` of the erased type.

fun f(x: rsc C) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define f⁰ as fun f¹(x: rsc C²): ? { return x }; end

fun g(x: rsc? C) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define g⁰ as fun g¹(x: rsc? C²): ? { return x }; end

fun h(x: C) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define h⁰ as fun h¹(x: C²): ? { return x }; end


// Inside the parameter list the modifier marks the parameter, which is not supported yet: a
// function type erases without its parameter types, and a separately written signature's
// parameter types are not yet carried over to the definition's own parameters. The
// separately written signature is elaborated twice, so the error is reported twice.

:ge
fun l: (rsc C) -> C
fun l(x) = x
//│ ╔══[COMPILATION ERROR] Resource modifiers inside the parameters of a function type are not supported yet.
//│ ║  l.34: 	fun l: (rsc C) -> C
//│ ╙──      	            ^
//│ ╔══[COMPILATION ERROR] Resource modifiers inside the parameters of a function type are not supported yet.
//│ ║  l.34: 	fun l: (rsc C) -> C
//│ ╙──      	            ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define l⁰ as fun l¹(x: ?): C² { return (x as! C²) }; end


// A signature that is not a function type has no parameter list to strip the modifier
// with, so the modifier stays on the result type, even when the definition writes a
// parameter list of its own.

declare fun mkRsc: rsc C
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end

fun getter: rsc C
fun getter = mkRsc
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define getter⁰ as fun getter¹(): rsc C² { return globalThis⁰.mkRsc⁰ }; end

fun noFunTy: rsc C
fun noFunTy(x) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define noFunTy⁰ as fun noFunTy¹(x: ?): rsc C² { return (x as! rsc C²) }; end


// `Anything` follows the same rule as any other class.

fun m(x: Anything) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define m⁰ as fun m¹(x: Unknown): ? { return x }; end

fun n(x: rsc Anything) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define n⁰ as fun n¹(x: rsc Unknown): ? { return x }; end

fun n2(x: rsc? Anything) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define n2⁰ as fun n2¹(x: rsc? Unknown): ? { return x }; end


// A union carries its members' resource-ness through the join: kept when they agree,
// and unresolved (`rsc?`) when they do not.

fun o(x: rsc C | rsc D) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define o⁰ as fun o¹(x: rsc Object⁰): ? { return x }; end

fun p(x: rsc C | D) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define p⁰ as fun p¹(x: rsc? Object⁰): ? { return x }; end


// A resource does not fit a bare `Anything` slot, but it does fit `rsc? Anything`.

:ge
fun intoAny(x: rsc C) = m(x)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'rsc C' at an unrelated type 'Unknown'
//│ ║  l.95: 	fun intoAny(x: rsc C) = m(x)
//│ ╙──      	                          ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define intoAny⁰ as fun intoAny¹(x: rsc C²): ? { return m¹(x) }; end

fun intoMaybeAny(x: rsc C) = n2(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define intoMaybeAny⁰ as fun intoMaybeAny¹(x: rsc C²): ? { return n2¹(x) }; end


// A join across the primitive/Object divide widens to `Unknown`.

fun v(x: Int | C) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define v⁰ as fun v¹(x: Unknown): ? { return x }; end

fun w(x: rsc C | rsc Int) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define w⁰ as fun w¹(x: rsc Unknown): ? { return x }; end


// Widening into `rsc?` is free; narrowing back out is checked.

fun useMaybe(x: rsc? C) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useMaybe⁰ as fun useMaybe¹(x: rsc? C²): ? { return x }; end

fun useRsc(x: rsc C) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useRsc⁰ as fun useRsc¹(x: rsc C²): ? { return x }; end

fun r(x: rsc C) = useMaybe(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define r⁰ as fun r¹(x: rsc C²): ? { return useMaybe¹(x) }; end

fun s(x: rsc? C) = useRsc(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define s⁰ as fun s¹(x: rsc? C²): ? { return useRsc¹((x as! rsc C²)) }; end


// `new rsc` creates a resource instance, with the modifier after any `mut`.

fun mkNew() = new rsc C()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define mkNew⁰ as fun mkNew¹(): ? { return new rsc C²() }; end

fun newIntoRsc() = useRsc(new rsc C())
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define newIntoRsc⁰ as fun newIntoRsc¹(): ? {
//│   let tmp: rsc C²;
//│   set tmp = new rsc C²();
//│   return useRsc¹(tmp)
//│ };
//│ end

fun newIntoMaybe() = useMaybe(new rsc C())
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define newIntoMaybe⁰ as fun newIntoMaybe¹(): ? {
//│   let tmp: rsc C²;
//│   set tmp = new rsc C²();
//│   return useMaybe¹(tmp)
//│ };
//│ end

:ge
fun newIntoPlain() = h(new rsc C())
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'rsc C' at an unrelated type 'C'
