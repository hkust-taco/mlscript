// A function type whose parameter list the definition does not consume is its result, so a
// modifier on it describes the function the definition returns rather than the definition
// itself. A paramless `fun` consumes none, even though at block level it compiles to a
// nullary function.

fun resultRsc(x): rsc (C) -> C = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define resultRsc⁰ as fun resultRsc¹(x: ?): rsc Function⁰ { return (x as! rsc Function⁰) }; end

:ge
val resultRscNarrowed: Str = resultRsc
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'rsc? Function' at an unrelated type 'Str'
//│ ║  l.505: 	val resultRscNarrowed: Str = resultRsc
//│ ╙──       	                             ^^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define resultRscNarrowed⁰ as val resultRscNarrowed¹: Str⁰ = resultRsc¹; end

fun paramlessRsc: rsc (C) -> C
fun paramlessRsc = resultRsc(0)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define paramlessRsc⁰ as fun paramlessRsc¹(): rsc Function⁰ { return resultRsc¹(0) }; end


// Every parameter list a curried definition consumes is one of its own, so a modifier on
// an inner function type is rejected too.

:e
fun curriedInner: (C) -> rsc (C) -> C
fun curriedInner(x)(y) = y
//│ ╔══[COMPILATION ERROR] Resource modifiers apply to function values, not to a function definition's parameter lists.
//│ ║  l.522: 	fun curriedInner: (C) -> rsc (C) -> C
