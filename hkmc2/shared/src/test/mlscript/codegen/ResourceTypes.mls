// In expression position the modifier is not a type annotation at all, and is
// reported like any other annotation that has no effect there.

:w
fun u() = rsc 1
//│ ╔══[WARNING] This annotation has no effect.
//│ ╟── This annotation is not supported on integer literal terms.
//│ ║  l.291: 	fun u() = rsc 1
//│ ╙──       	              ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define u⁰ as fun u¹(): ? { return 1 }; end


// A module is a singleton, so it can never be refcounted and `rsc module M` is
// nonsense. It is rejected, but only incidentally: `Elaborator` unwraps `module` only
// when it is the outermost form of the signature, so the modifier hides it and the
// declaration reaches term position - hence a message about the declaration.

module M
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define M⁰ as class M¹ module M²; end

fun modOf: module M
fun modOf = M
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define modOf⁰ as fun modOf¹(): module M² { return M² }; end

:ge
fun rscModOf: rsc module M
fun rscModOf = M
