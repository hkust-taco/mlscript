//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define newMaybe⁰ as fun newMaybe¹(): ? { return new C²() }; end

:e
fun newDyn() = new! rsc C()
//│ ╔══[COMPILATION ERROR] Resource instantiation with 'new!' is not supported yet.
