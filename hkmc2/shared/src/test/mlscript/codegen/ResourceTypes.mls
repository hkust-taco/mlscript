//│ ╙──       	                    ^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define newDyn⁰ as fun newDyn¹(): ? { return new C¹() }; end

:e
class Q
fun newRefined() = new rsc Q with {}
