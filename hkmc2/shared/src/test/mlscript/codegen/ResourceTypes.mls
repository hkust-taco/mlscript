// Any class can be instantiated with `new rsc`, so `this` is `rsc?`: it takes a checked
// cast into a resource or a plain slot, and none into an `rsc?` one.

class Sub() extends C() with
  fun intoRsc() = useRsc(this)
  fun intoMaybe() = useMaybe(this)
  fun intoPlain() = h(this)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Sub⁰ as class Sub² extends C² {
//│   constructor Sub¹
//│   method intoRsc⁰ = fun intoRsc¹(): ? {
//│     return useRsc¹((Sub².this as! rsc C²))
//│   }
//│   method intoMaybe⁰ = fun intoMaybe¹(): ? {
//│     return useMaybe¹(Sub².this)
//│   }
//│   method intoPlain⁰ = fun intoPlain¹(): ? { return h¹((Sub².this as! C²)) }
//│ };
//│ end


// In type-argument position the modifier is rejected, as type arguments are erased, so
// it would not reach the erased type. Generic resource-ness is future work.

class Box[A](value: A)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Box⁰ as class Box² {
//│   private val value⁰: ?;
//│   constructor Box¹(value: ?) { set Box².this.value⁰ = value; end }
//│ };
//│ end

:ge
fun t(b: Box[rsc C]) = b
//│ ╔══[COMPILATION ERROR] Resource modifiers inside a type argument are not supported yet.
//│ ║  l.268: 	fun t(b: Box[rsc C]) = b
//│ ╙──       	                 ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define t⁰ as fun t¹(b: Box²): ? { return b }; end


// A non-`rsc` value does not fit an `rsc` slot.

:ge
fun q(x: C) = useRsc(x)
