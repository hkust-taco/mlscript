//│ define u⁰ as fun u¹(): ? { return 1 }; end


// A module is a singleton, so it can never be refcounted and `rsc module M` is
// nonsense. It is rejected, but only incidentally: `Elaborator` unwraps `module` only
// when it is the outermost form of the signature, so the modifier hides it and the
// declaration reaches term position - hence a message about the declaration.

module M
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define M⁰ as class M¹ module M²; end

fun modOf: module M
fun modOf = M
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define modOf⁰ as fun modOf¹(): module M² { return M² }; end

:ge
fun rscModOf: rsc module M
fun rscModOf = M
//│ ╔══[COMPILATION ERROR] Illegal type declaration in term position.
//│ ║  l.401: 	fun rscModOf: rsc module M
//│ ╙──       	                  ^^^^^^^^
//│ ╔══[COMPILATION ERROR] Expected a type, got ‹error›
//│ ║  l.401: 	fun rscModOf: rsc module M
//│ ╙──       	                  ^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define rscModOf⁰ as fun rscModOf¹(): ? { return M² }; end


// A written function type's parameter list becomes the definition's own, which has no
// resource-ness to state, so a modifier on that function type is rejected. `kControl` is
// the same shape without one; `kForall` puts a quantifier between the modifier and the
// function type, `kMaybe` uses `rsc?`, and the paramless `declare`d `kDeclared` consumes
// every parameter list its signature has.

:e
fun k: rsc (C) -> C
fun k(x) = x
//│ ╔══[COMPILATION ERROR] Resource modifiers apply to function values, not to a function definition's parameter lists.
//│ ║  l.420: 	fun k: rsc (C) -> C
//│ ╙──       	           ^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define k⁰ as fun k¹(x: ?): C² { return (x as! C²) }; end

fun kControl: (C) -> C
fun kControl(x) = x
