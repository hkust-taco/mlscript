module Foo with
  val a = 1
  val b = 2
  module Bar with
    val c = 3
    val d = 4

open Foo.
  a
  b

a + b
//│ = 3

open Foo.Bar.c

open Foo.Bar.{ c, d }

c + d
//│ = 7


open Foo.{ a, b, Bar.{ c, d } }

a + b + c + d
//│ = 10

open Foo.
  a
  b
  Bar.
    c, d

a + b + c + d
//│ = 10


:e
open Foo.{ a, b, Bar.{ c, d } } as F
//│ ╔══[COMPILATION ERROR] Illegal 'open' statement base.
//│ ║  l.+1: 	open Foo.{ a, b, Bar.{ c, d } } as F
//│ ╙──      	     ^^^^^^^^^^^^^^^^^^^^^^^^^^

open Foo as F

F.{a + b}
//│ = 3


