:js
#lang(0.2.x)


// * Optional and trailing parameters with the legacy resolver.

fun foo(x, y?) = [x, y]
[foo(1), foo(1, 2)]
//│ = [[1, undefined], [1, 2]]

fun bar(x, y?, ...xs, w) = [x, y, xs, w]
[bar(1, 2), bar(1, 2, 3, 4)]
//│ = [[1, undefined, [], 2], [1, 2, [3], 4]]


// * Separate signatures must agree with the implementation on which parameters are optional.

:e
fun sig: (Int, Int?) -> Int
fun sig(x, y) = x
//│ ╔══[COMPILATION ERROR] Parameter 'y' is required...
//│ ║  l.20: 	fun sig(x, y) = x
//│ ║        	           ^
//│ ╟── ...but the corresponding parameter of the function's signature is optional.
//│ ║  l.19: 	fun sig: (Int, Int?) -> Int
//│ ╙──      	               ^^^^

:e
fun sig2: (Int, Int) -> Int
fun sig2(x, y?) = x
//│ ╔══[COMPILATION ERROR] Parameter 'y' is optional...
//│ ║  l.30: 	fun sig2(x, y?) = x
//│ ║        	            ^^
//│ ╟── ...but the corresponding parameter of the function's signature is required.
//│ ║  l.29: 	fun sig2: (Int, Int) -> Int
//│ ╙──      	                ^^^

fun sig3: (Int, Int?) -> Int
fun sig3(x, y?) = x


// * Eta-expansion for implicit arguments.

fun withOpt(x, y?)(using I: Int) = [x, y, I]
fun withRest(x, ...xs)(using I: Int) = [x, xs, I]
fun withTrailing(x, ...xs, y)(using I: Int) = [x, xs, y, I]

using Int = 42

:expect [[1, undefined, 42], [1, 2, 42]]
let f = withOpt
[f(1), f(1, 2)]
//│ = [[1, undefined, 42], [1, 2, 42]]
//│ f = fun f

// FIXME: The eta-expansion only forwards the leading parameters (see `Resolver`),
// so the rest arguments are lost.
:fixme
:expect [1, [2, 3], 42]
let g = withRest
g(1, 2, 3)
//│ ═══[RUNTIME ERROR] Expected: '[1, [2, 3], 42]', got: '[1, [], 42]'
//│ = [1, [], 42]
//│ g = fun g

// FIXME: The trailing arguments are lost too, and the call then fails.
:fixme
:expect [1, [2], 3, 42]
let h = withTrailing
h(1, 2, 3)
//│ ═══[RUNTIME ERROR] Error: Function 'withTrailing' expected at least 2 arguments but got 1
//│ ═══[RUNTIME ERROR] Expected: '[1, [2], 3, 42]', got: 'undefined'
//│ h = fun h
