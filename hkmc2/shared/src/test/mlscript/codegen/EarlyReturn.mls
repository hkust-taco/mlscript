:js


fun f() =
  print("--- pre ---")
  return 1
  print("--- post ---")
  

f()
//│ > --- pre ---
//│ = 1

:sjs
fun f(x) =
  if x < 0 do
    print("whoops")
    return 0
  x + 1
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f1;
//│ f1 = function f(x) {
//│   let scrut;
//│   scrut = x < 0;
//│   if (scrut === true) { Predef.print("whoops"); return 0 }
//│   return x + 1;
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(1)
//│ = 2

f(-1)
//│ > whoops
//│ = 0


