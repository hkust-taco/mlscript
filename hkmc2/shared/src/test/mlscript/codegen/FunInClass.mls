:js


fun test() =
  data class C(a) with { fun f() = a }
  C(0).f()

test()
//│ = 0


:sjs
fun test(a) =
  data class Inner(b) with
    print(a)
    fun f(c) = [a, b, c]
    fun g(d) =
      fun h(e) = [a, b, d, e]
      h(d)
  Inner(42)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let Inner1, test1;
//│ Inner1 = function Inner(b) {
//│   return globalThis.Object.freeze(new Inner.class(b));
//│ };
//│ (class Inner {
//│   static {
//│     Inner1.class = this
//│   }
//│   constructor(b, a) {
//│     this.#a = a;
//│     this.b = b;
//│     Predef.print(this.#a);
//│   }
//│   #a;
//│   f(c) {
//│     return globalThis.Object.freeze([
//│       this.#a,
//│       this.b,
//│       c
//│     ])
//│   }
//│   g(d) {
//│     let a1;
//│     a1 = this.#a;
//│     return globalThis.Object.freeze([
//│       a1,
//│       this.b,
//│       d,
//│       d
//│     ])
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Inner", ["b"]];
//│ });
//│ test1 = function test(a) { return globalThis.Object.freeze(new Inner1.class(42, a)) };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let i = test(100)
//│ > 100
//│ i = Inner(42)

i.f(200)
//│ = [100, 42, 200]

i.g(200)
//│ = [100, 42, 200, 200]


:sjs
fun test(a) =
  data class C1(b) with
    print of [a, b]
  data class C2(b) with
    print of [a, b]
  [C1(1), C2(2)]
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let C12, C21, test2;
//│ C12 = function C1(b) {
//│   return globalThis.Object.freeze(new C1.class(b));
//│ };
//│ (class C11 {
//│   static {
//│     C12.class = this
//│   }
//│   constructor(b, a) {
//│     let tmp;
//│     this.#a = a;
//│     this.b = b;
//│     tmp = globalThis.Object.freeze([
//│       this.#a,
//│       this.b
//│     ]);
//│     Predef.print(tmp);
//│   }
//│   #a;
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "C1", ["b"]];
//│ });
//│ C21 = function C2(b) {
//│   return globalThis.Object.freeze(new C2.class(b));
//│ };
//│ (class C2 {
//│   static {
//│     C21.class = this
//│   }
//│   constructor(b, a) {
//│     let tmp;
//│     this.#a = a;
//│     this.b = b;
//│     tmp = globalThis.Object.freeze([
//│       this.#a,
//│       this.b
//│     ]);
//│     Predef.print(tmp);
//│   }
//│   #a;
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "C2", ["b"]];
//│ });
//│ test2 = function test(a) {
//│   let tmp, tmp1;
//│   tmp = globalThis.Object.freeze(new C12.class(1, a));
//│   tmp1 = globalThis.Object.freeze(new C21.class(2, a));
//│   return globalThis.Object.freeze([ tmp, tmp1 ])
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

test(123)
//│ > [123, 1]
//│ > [123, 2]
//│ = [C1(1), C2(2)]


// Inlining is disabled to test this proxy
:sjs
:noInline
data class Foo(a) with
  fun foo() =
    fun bar() = a
    fun baz() = a
    bar()
    baz()
  foo()
Foo(123)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let bar, baz, Foo1;
//│ bar = function bar(Foo2) {
//│   return Foo2.a
//│ };
//│ baz = function baz(Foo2) {
//│   return Foo2.a
//│ };
//│ Foo1 = function Foo(a) {
//│   return globalThis.Object.freeze(new Foo.class(a));
//│ };
//│ (class Foo {
//│   static {
//│     Foo1.class = this
//│   }
//│   constructor(a) {
//│     this.a = a;
//│     this.foo();
//│   }
//│   foo() {
//│     bar(this);
//│     return baz(this)
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Foo", ["a"]];
//│ });
//│ return Foo1(123)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = Foo(123)

:sjs
data class Bar(x) with
  fun foo()() =
    fun bar() =
      x
    bar()
  foo()()
Bar(1)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let Bar1;
//│ Bar1 = function Bar(x) {
//│   return globalThis.Object.freeze(new Bar.class(x));
//│ };
//│ (class Bar {
//│   static {
//│     Bar1.class = this
//│   }
//│   constructor(x) {
//│     this.x = x;
//│     this.foo()();
//│   }
//│   foo() {
//│     return () => {
//│       return this.x
//│     }
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Bar", ["x"]];
//│ });
//│ return Bar1(1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = Bar(1)
