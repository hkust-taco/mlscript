data class C(a)

fun f(x) = if x is C(a) then a else 0

f(C(27))
//│ = 27


fun f(x) = if x is C then 1 else 0

f(C(27))
//│ = 1


object M with
  data class D(a)
  val d = D(27)

M.d
//│ = D(27)

fun f(x) = if x is M.D then 1 else 0

M.D.class
//│ = class D

M is M.D
//│ = false

f(M.d)
//│ = 1

f(M.D(27))
//│ = 1


fun f(x) = if x is M.D(a) then a else 0

f(M.d)
//│ = 27

f(M.D(27))
//│ = 27


// TODO dedup branches duplicated by UCS normalization
:sjs
fun f(x) = if x is
  Some(x) and x > 0 then 42
  None then "ok"
  else print("oops")
//│ JS (unsanitized):
//│ let f4;
//│ f4 = function f(x3) {
//│   let x4, scrut1, argument0$4, tmp5;
//│   split_root$1: {
//│     split_1$: {
//│       if (x3 instanceof Some1.class) {
//│         argument0$4 = x3.value;
//│         x4 = argument0$4;
//│         scrut1 = x4 > 0;
//│         if (scrut1 === true) {
//│           tmp5 = 42;
//│           break split_root$1
//│         } else {
//│           break split_1$
//│         }
//│       } else if (x3 instanceof None1.class) {
//│         tmp5 = "ok";
//│         break split_root$1
//│       } else { break split_1$ }
//│     }
//│     tmp5 = Predef.print("oops");
//│   }
//│   return tmp5
//│ };

f(Some(0))
//│ > oops

f(Some(1))
//│ = 42

f(None)
//│ = "ok"

f(0)
//│ > oops


data class Pair[out A, out B](fst: A, snd: B)


:sjs
fun f(x) = if x is
  Some(u) then u
  Pair(a, b) then a + b
//│ JS (unsanitized):
//│ let f5;
//│ f5 = function f(x3) {
//│   let u, a, b, argument0$4, argument1$;
//│   if (x3 instanceof Some1.class) {
//│     argument0$4 = x3.value;
//│     u = argument0$4;
//│     return u
//│   } else if (x3 instanceof Pair1.class) {
//│     argument0$4 = x3.fst;
//│     argument1$ = x3.snd;
//│     b = argument1$;
//│     a = argument0$4;
//│     return a + b
//│   } else { throw globalThis.Object.freeze(new globalThis.Error("match error")) }
//│ };

f(Some(123))
//│ = 123

f(Pair(10, 5))
//│ = 15


