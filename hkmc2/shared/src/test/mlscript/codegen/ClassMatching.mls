//│ });
//│ lambda
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun


data class C(a)

fun f(x) = if x is C(a) then a else 0

f(C(27))
//│ = 27


fun f(x) = if x is C then 1 else 0

f(C(27))
//│ = 1


object M with
  data class D(a)
  val d = D(27)

M.d
//│ = D(27)

fun f(x) = if x is M.D then 1 else 0

M.D.class
//│ = class D

M is M.D
//│ = false

f(M.d)
//│ = 1

f(M.D(27))
//│ = 1


fun f(x) = if x is M.D(a) then a else 0

f(M.d)
//│ = 27

f(M.D(27))
//│ = 27


// TODO dedup branches duplicated by UCS normalization
:sjs
fun f(x) = if x is
  Some(x) and x > 0 then 42
  None then "ok"
  else print("oops")
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f4;
//│ f4 = function f(x) {
//│   let scrut1, arg$Some$0$4;
//│   if (x instanceof Some1.class) {
//│     arg$Some$0$4 = x.value;
//│     scrut1 = arg$Some$0$4 > 0;
//│     if (scrut1 === true) {
//│       return 42
//│     }
//│     return Predef.print("oops");
//│   } else if (x instanceof None1.class) { return "ok" }
//│   return Predef.print("oops");
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(Some(0))
//│ > oops

f(Some(1))
//│ = 42

f(None)
//│ = "ok"

f(0)
//│ > oops


data class Pair[out A, out B](fst: A, snd: B)


:sjs
fun f(x) = if x is
  Some(u) then u
  Pair(a, b) then a + b
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f5;
//│ f5 = function f(x) {
//│   let arg$Pair$0$, arg$Pair$1$, arg$Some$0$4;
//│   if (x instanceof Some1.class) {
//│     arg$Some$0$4 = x.value;
//│     return arg$Some$0$4
//│   } else if (x instanceof Pair1.class) {
//│     arg$Pair$0$ = x.fst;
//│     arg$Pair$1$ = x.snd;
//│     return arg$Pair$0$ + arg$Pair$1$
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(Some(123))
//│ = 123

f(Pair(10, 5))
//│ = 15


// UCS term not in tail position
:sjs
fun f(x) = print of if x is
  Some(0) then "0"
  None then "ok"
  else "oops"
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f6;
//│ f6 = function f(x) {
//│   let arg$Some$0$4;
//│   if (x instanceof Some1.class) {
//│     arg$Some$0$4 = x.value;
//│     if (arg$Some$0$4 === 0) {
//│       return Predef.print("0")
//│     }
//│     return Predef.print("oops");
//│   } else if (x instanceof None1.class) { return Predef.print("ok") }
//│   return Predef.print("oops");
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(Some(0))
//│ > 0

f(Some(1))
//│ > oops

f(None)
//│ > ok

f(0)
//│ > oops



