:.
:js

open annotations { noInline }

// A computed parent does not have a fixed nominal symbol in the lowered IR.
// Its subclass and companion must still share their private-name container.

class Base with
  val value = 11
@noInline fun computedParent() = Base

:expect [11, 7]
let parent = computedParent()
class Child extends parent with
  let x = 3
  fun getX = x
module Child with
  let x = 4
  fun sum(child) = child.getX + x
[new Child().value, Child.sum(new Child)]
//│ = [11, 7]
//│ parent = class Base
