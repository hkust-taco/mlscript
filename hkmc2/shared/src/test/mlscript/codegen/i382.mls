:js

// https://github.com/hkust-taco/mlscript/issues/382


// "Full example to demonstrate that changing else branch affect the loop behaviour"


// * These are infinite loops, now...

() =>
  let x = 1
  while x ===
    1 do
      set x = 2
    2 do
      set x = 3
      print("valid")
  else
    set x = 2
  print("not inf loop")
//│ = fun

() =>
  let x = 1
  while x ===
    1 do
      set x = 2
    2 do
      set x = 3
      print("valid")
  else
    set x = 3
  print("not inf loop")
//│ = fun


// * Variation:

let x = 1
while x ===
  1 do
    set x += 1
  2 do
    set x = 3
    print("valid")
  3 do
    set x += 1
//│ x = 2

:rewriteWhile
let x = 1
while x ===
  1 do
    set x = 2
  2 do
    set x = 3
    print("valid")
  3 do
    set x += 1
//│ > valid
//│ x = 4


