:js

:global
:sjs


:silent
declare val console
//│ JS (unsanitized):
//│ 


console.log("a")
console.log("b")
123
//│ JS (unsanitized):
//│ let tmp, tmp1;
//│ tmp = runtime.safeCall(globalThis.console.log("a"));
//│ tmp1 = runtime.safeCall(globalThis.console.log("b"));
//│ 123
//│ > a
//│ > b
//│ = 123

let l = console.log
l(123)
//│ JS (unsanitized):
//│ let l; l = globalThis.console.log; runtime.safeCall(l(123))
//│ > 123
//│ l = fun log

42
//│ JS (unsanitized):
//│ 42
//│ = 42


console.log("a")
//│ JS (unsanitized):
//│ runtime.safeCall(globalThis.console.log("a"))
//│ > a


let x =
  console.log("a")
  123
console.log("b")
let y = x + 1
console.log("c")
y * 2
//│ JS (unsanitized):
//│ let x, y, tmp2, tmp3, tmp4, tmp5;
//│ tmp2 = runtime.safeCall(globalThis.console.log("a"));
//│ x = 123;
//│ tmp3 = runtime.safeCall(globalThis.console.log("b"));
//│ tmp4 = x + 1;
//│ y = tmp4;
//│ tmp5 = runtime.safeCall(globalThis.console.log("c"));
//│ y * 2
//│ > a
//│ > b
//│ > c
//│ = 248
//│ x = 123
//│ y = 124


