:js

:global
:sjs


:silent
declare val console
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ 
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


console.log("a")
console.log("b")
123
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ runtime.safeCall(globalThis.console.log("a")); runtime.safeCall(globalThis.console.log("b")); 123
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > a
//│ > b
//│ = 123

let l = console.log
l(123)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let l; l = globalThis.console.log; runtime.safeCall(l(123))
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123
//│ l = fun log

42
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


console.log("a")
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ runtime.safeCall(globalThis.console.log("a"))
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > a


let x =
  console.log("a")
  123
console.log("b")
let y = x + 1
console.log("c")
y * 2
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let x, y;
//│ runtime.safeCall(globalThis.console.log("a"));
//│ x = 123;
//│ runtime.safeCall(globalThis.console.log("b"));
//│ y = 124;
//│ runtime.safeCall(globalThis.console.log("c"));
//│ 248
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > a
//│ > b
//│ > c
//│ = 248
//│ x = 123
//│ y = 124


