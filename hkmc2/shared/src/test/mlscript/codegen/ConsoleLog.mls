//│ runtime.safeCall(globalThis.console.log("b"));
//│ block$res2 = 123;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > a
//│ > b
//│ = 123

let l = console.log
l(123)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
