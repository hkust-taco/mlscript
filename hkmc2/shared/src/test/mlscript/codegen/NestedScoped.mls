let z = 114
scope.locally of (
  let y = 514
  y
)
//│ = 514
//│ z = 114


// :sjs
let z = 2
scope.locally of (
  let y = () => 1
  y
)
//│ = fun y
//│ z = 2



// NOTE: `z2` (bms) should be declared in the same place as `z3`
:sjs
fun f(x) =
  if x then
    let y = 2
    scope.locally of (
      let z = () => 3
      z
    )
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f2;
//│ f2 = function f(x) {
//│   if (x === true) {
//│     let z2;
//│     z2 = function z() {
//│       return 3
//│     };
//│     return z2
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————



:lift
scope.locally of scope.locally of (
  fun h() =
    fun f() = g()
    fun g() = f()
    4
  3
)
//│ = 3

// :sjs
let x = 3
() => x
//│ = fun
//│ x = 3

:sjs
fun f(x) =
  if x then
    () => 4
