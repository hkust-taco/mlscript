:sjs
fun f() =
  if true then
    scope.locally of () =>
      let a = 4
      a + 4
  else
    let b = 5
    b + 9
//│ JS (unsanitized):
//│ let f; /** scoped **/
//│ f = function f() {
//│   let scrut, b; /** scoped **/
//│   scrut = true;
//│   if (scrut === true) { let a; /** scoped **/ a = 4; return a + 4 } else { b = 5; return b + 9 }
//│ };


f()
//│ = 8


:sjs
fun f() =
  if false then
    let a = 4
    a + 4
  else
    scope.locally of () =>
      let b = 5
      b + 9
//│ JS (unsanitized):
//│ let f1; /** scoped **/
//│ f1 = function f() {
//│   let scrut, a; /** scoped **/
//│   scrut = false;
//│   if (scrut === true) { a = 4; return a + 4 } else { let b; /** scoped **/ b = 5; return b + 9 }
//│ };


f()
//│ = 14


