// NOTE: later passes may destroy nested Scoped blocks
:sjs
let z = 2
scope.locally of (
  let y = () => 1
  y
)
//│ JS (unsanitized):
//│ let z1, y1; let y2; z1 = 2; y2 = function y() { return 1 }; y1 = y2; y1
//│ = fun y
//│ z = 2



// NOTE: `z2` (bms) should be declared at the same place with `z3`
