:sjs
fun foo(x, y) =
  let z = [1, 2, 3]
  if not x > z.0 do
    print("rua")
  let m = x + y
  scope.locally of () =>
    let w1 = z.1 + m
    let w2 = z.2 - m
    if w1 == w2 do
      print("ruarua")
//│ JS (unsanitized):
//│ let foo1; /** scoped **/
//│ foo1 = function foo(x1, y) {
//│   let z, scrut, m, tmp, tmp1; /** scoped **/{
//│     let w1, w2, scrut1; /** scoped **/
