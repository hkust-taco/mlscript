scope.locally of (let x = 1 in x), (let y = 2 in y)
//│ ╔══[COMPILATION ERROR] Unsupported form for scope.locally.
//│ ║  l.174: 	scope.locally of (let x = 1 in x), (let y = 2 in y)
//│ ╙──       	^^^^^^^^^^^^^


:e
:ge
scope.locally of (let x = 1 in x), (let y = 2 in x)
//│ ╔══[ERROR] Name not found: x
//│ ║  l.182: 	scope.locally of (let x = 1 in x), (let y = 2 in x)
//│ ╙──       	                                                 ^
//│ ╔══[COMPILATION ERROR] Unsupported form for scope.locally.
//│ ║  l.182: 	scope.locally of (let x = 1 in x), (let y = 2 in x)
//│ ╙──       	^^^^^^^^^^^^^


let z = 114
scope.locally of (
  let y = 514
  y
)
//│ = 514
//│ z = 114


// :sjs
let z = 2
scope.locally of (
  let y = () => 1
  y
)
//│ = fun y
//│ z = 2



// NOTE: `z2` (bms) should be declared in the same place as `z3`
:sjs
fun f(x) =
  if x then
    let y = 2
    scope.locally of (
      let z = () => 3
      z
    )
//│ JS (unsanitized):
//│ let f2;
//│ f2 = function f(x3) {
//│   let y3;
//│   if (x3 === true) {
//│     let z2, z3;
//│     y3 = 2;
//│     z3 = function z() {
//│       return 3
//│     };
//│     z2 = z3;
//│     return z2
//│   } else { throw globalThis.Object.freeze(new globalThis.Error("match error")) }
//│ };



