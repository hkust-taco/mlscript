//│       1,
//│       2,
//│       3
//│     ]);
//│     tmp = x1 > z[0];
//│     scrut = ! tmp;
//│     if (scrut === true) {
//│       tmp1 = Predef.print("rua");
//│     } else {
//│       tmp1 = runtime.Unit;
//│     }
//│     m = x1 + y;
//│     w1 = z[1] + m;
//│     w2 = z[2] - m;
//│     scrut1 = w1 == w2;
//│     if (scrut1 === true) { return Predef.print("ruarua") } else { return runtime.Unit }
//│   }
//│ };

