scope.locally of (
  let y = 514
  y
)
//│ = 514
//│ z = 114


// :sjs
let z = 2
scope.locally of (
  let y = () => 1
  y
)
//│ = fun y
//│ z = 2



// NOTE: `z2` (bms) should be declared in the same place as `z3`
:sjs
fun f(x) =
  if x then
    let y = 2
    scope.locally of (
      let z = () => 3
      z
    )
//│ JS (unsanitized):
//│ let f2;
//│ f2 = function f(x3) {
//│   let y3;
//│   if (x3 === true) {
//│     let z2, z3;
//│     y3 = 2;
//│     z3 = function z() {
//│       return 3
//│     };
//│     z2 = z3;
//│     return z2
//│   } else { throw globalThis.Object.freeze(new globalThis.Error("match error")) }
//│ };



:lift
scope.locally of scope.locally of (
  fun h() =
    fun f() = g()
    fun g() = f()
    4
  3
)
//│ = 3

// :sjs
let x = 3
() => x
//│ = fun
//│ x = 3

