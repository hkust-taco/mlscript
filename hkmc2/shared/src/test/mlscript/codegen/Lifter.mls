// preserve order
:sjs
fun f(a1, a2, a3, a4, a5, a6) =
  fun g = a1 + a2 + a3 + a4 + a5 + a6  
  g
f(1,2,3,4,5,6)
//│ JS (unsanitized):
//│ let f9, g9;
//│ g9 = function g(a1, a2, a3, a4, a5, a6) {
//│   return () => {
//│     let tmp1, tmp2, tmp3, tmp4;
//│     tmp1 = a1 + a2;
//│     tmp2 = tmp1 + a3;
//│     tmp3 = tmp2 + a4;
//│     tmp4 = tmp3 + a5;
//│     return tmp4 + a6;
//│   };
//│ };
//│ f9 = function f(a1, a2, a3, a4, a5, a6) {
//│   let tmp1, g$this;
//│   g$this = g9(a1, a2, a3, a4, a5, a6) ?? null;
//│   tmp1 = g$this();
//│   return tmp1;
//│ };
//│ f9(1, 2, 3, 4, 5, 6)
//│ = 21

:expect '01'
:sjs
class Tuple(a, b)
fun f() =
  let a = 0
  fun g() = set a = 1
  fun h() = a
  Tuple(g, h) 
let ret = f()
let f1 = ret.a
let f2 = ret.b
let x = f2().toString()
f1()
let y = f2().toString()
x + y
//│ JS (unsanitized):
//│ let f11, Tuple1, g11, h3, ret, f12, f21, x, y, tmp1, tmp2, tmp3, tmp4, tmp5, tmp6, f$capture1;
//│ g11 = function g(f$capture2) {
//│   return () => {
//│     f$capture2.a0$ = 1;
//│     return null;
//│   };
//│ };
//│ h3 = function h(f$capture2) {
//│   return () => {
//│     return f$capture2.a0$;
//│   };
//│ };
//│ f$capture1 = function f$capture(a0$1) {
//│   return new f$capture.class(a0$1);
//│ };
//│ f$capture1.class = class f$capture {
//│   constructor(a0$) {
//│     this.a0$ = a0$;
//│   }
//│   toString() { return "f$capture(" + this.a0$ + ")"; }
//│ };
//│ f11 = function f() {
//│   let capture, g$this, h$this;
//│   capture = new f$capture1();
//│   capture.a0$ = 0;
//│   g$this = g11(capture) ?? null;
//│   h$this = h3(capture) ?? null;
//│   return Tuple1(g$this, h$this);
//│ };
//│ Tuple1 = function Tuple(a1, b1) {
