:expect '01'
:sjs
class Tuple(a, b)
fun f() =
  let a = 0
  fun g() = set a = 1
  fun h() = a
  Tuple(g, h) 
let ret = f()
let f1 = ret.a
let f2 = ret.b
let x = f2().toString()
f1()
let y = f2().toString()
x + y
