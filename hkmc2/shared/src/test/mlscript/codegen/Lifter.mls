// preserve order
:sjs
fun f(a1, a2, a3, a4, a5, a6) =
  fun g = a1 + a2 + a3 + a4 + a5 + a6  
  g
f(1,2,3,4,5,6)
//│ JS (unsanitized):
//│ let f7, g7;
//│ g7 = function g(a1, a2, a3, a4, a5, a6) {
//│   return () => {
//│     let tmp, tmp1, tmp2, tmp3;
//│     tmp = a1 + a2;
//│     tmp1 = tmp + a3;
//│     tmp2 = tmp1 + a4;
//│     tmp3 = tmp2 + a5;
//│     return tmp3 + a6;
//│   };
//│ };
//│ f7 = function f(a1, a2, a3, a4, a5, a6) {
//│   let tmp, g$this;
//│   g$this = g7(a1, a2, a3, a4, a5, a6) ?? null;
//│   tmp = g$this();
//│   return tmp;
//│ };
//│ f7(1, 2, 3, 4, 5, 6)
//│ = 21

:expect '01'
:sjs
class Tuple(a, b)
fun f() =
  let a = 0
  fun g() = set a = 1
  fun h() = a
  Tuple(g, h) 
let ret = f()
let f1 = ret.a
let f2 = ret.b
let x = f2().toString()
f1()
let y = f2().toString()
x + y
//│ JS (unsanitized):
//│ let f9, Tuple1, g9, h1, ret, f11, f21, x, y, tmp, tmp1, tmp2, tmp3, tmp4, tmp5, f$capture1;
//│ g9 = function g(f$capture2) {
//│   return () => {
//│     f$capture2.a0$ = 1;
//│     return null;
//│   };
//│ };
//│ h1 = function h(f$capture2) {
//│   return () => {
//│     return f$capture2.a0$;
//│   };
//│ };
//│ f$capture1 = function f$capture(a0$1) {
//│   return new f$capture.class(a0$1);
//│ };
//│ f$capture1.class = class f$capture {
//│   constructor(a0$) {
//│     this.a0$ = a0$;
//│   }
//│   toString() { return "f$capture(" + this.a0$ + ")"; }
//│ };
//│ f9 = function f() {
//│   let capture, g$this, h$this;
//│   capture = new f$capture1(null);
//│   capture.a0$ = 0;
//│   g$this = g9(capture) ?? null;
//│   h$this = h1(capture) ?? null;
//│   return Tuple1(g$this, h$this);
//│ };
//│ Tuple1 = function Tuple(a1, b1) {
//│   return new Tuple.class(a1, b1);
//│ };
//│ Tuple1.class = class Tuple {
//│   constructor(a, b) {
//│     this.a = a;
//│     this.b = b;
//│   }
//│   toString() { return "Tuple(" + this.a + ", " + this.b + ")"; }
//│ };
//│ tmp = f9();
//│ ret = tmp;
//│ f11 = ret.a;
//│ f21 = ret.b;
//│ tmp1 = f21() ?? null;
//│ tmp2 = tmp1.toString() ?? null;
//│ x = tmp2;
//│ tmp3 = f11() ?? null;
//│ tmp4 = f21() ?? null;
//│ tmp5 = tmp4.toString() ?? null;
//│ y = tmp5;
//│ x + y
//│ = '01'
//│ f1 = [Function (anonymous)]
//│ f2 = [Function (anonymous)]
//│ ret = Tuple { a: [Function (anonymous)], b: [Function (anonymous)] }
//│ x = '0'
//│ y = '1'

class Tuple(a, b)
fun f(used1) =
  fun g1(used2) =
    fun h() = 
      set used1 = 10
      set used2 = 100
    fun i() = used1 + used2
    Tuple(h, i)
  fun g22() = used1
  Tuple(g1(10), g22)

:expect '11110110'
let ret = f(1)
let gRet = ret.a
let g2 = ret.b
let hFun = gRet.a
let iFun = gRet.b
let a = iFun()
let b = g2()
hFun()
let c = g2()
let d = iFun()
a.toString() + b + c + d
//│ = '11110110'
//│ a = 11
//│ b = 1
//│ c = 10
//│ d = 110
//│ g2 = [Function (anonymous)]
//│ gRet = Tuple { a: [Function (anonymous)], b: [Function (anonymous)] }
//│ hFun = [Function (anonymous)]
//│ iFun = [Function (anonymous)]
//│ > Tuple {
//│ >   a: Tuple { a: [Function (anonymous)], b: [Function (anonymous)] },
//│ >   b: [Function (anonymous)]
//│ ret = }

// some variables mutated, some not
:sjs
:expect 7
fun f(unused, immutable, mutated) =
  fun g() =
    set mutated = 2
    immutable + mutated
  fun h() = mutated
  let a = g()
  a + h() + unused
f(1, 2, 1000)
