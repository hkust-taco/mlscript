//│ };
//│ f3 = function f(used1, unused1) {
//│   let used2, unused2, tmp;
//│   used2 = unused1;
//│   unused2 = 2;
//│   tmp = g3(used2);
//│   return tmp + unused2;
//│ };
//│ f3(1, 2)
//│ = 5

