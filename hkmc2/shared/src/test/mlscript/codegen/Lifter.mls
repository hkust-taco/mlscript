class Tuple(a, b)
fun f(used1) =
  fun g1(used2) =
    fun h() = 
      set used1 = 10
      set used2 = 100
    fun i() = used1 + used2
    Tuple(h, i)
  fun g22() = used1
  Tuple(g1(10), g22)

:expect '11110110'
let ret = f(1)
let gRet = ret.a
let g2 = ret.b
let hFun = gRet.a
let iFun = gRet.b
let a = iFun()
let b = g2()
hFun()
let c = g2()
let d = iFun()
a.toString() + b + c + d
//│ = '11110110'
//│ a = 11
//│ b = 1
//│ c = 10
//│ d = 110
//│ g2 = [Function (anonymous)]
//│ gRet = Tuple { a: [Function (anonymous)], b: [Function (anonymous)] }
//│ hFun = [Function (anonymous)]
//│ iFun = [Function (anonymous)]
//│ > Tuple {
//│ >   a: Tuple { a: [Function (anonymous)], b: [Function (anonymous)] },
//│ >   b: [Function (anonymous)]
//│ ret = }

// some variables mutated, some not
:sjs
:expect 7
fun f(unused, immutable, mutated) =
  fun g() =
    set mutated = 2
    immutable + mutated
  fun h() = mutated
  let a = g()
  a + h() + unused
f(1, 2, 1000)
//│ JS (unsanitized):
//│ let f16, g15, h7, f$capture5;
//│ g15 = function g(immutable, f$capture6) {
//│   return () => {
//│     f$capture6.mutated0$ = 2;
//│     return immutable + f$capture6.mutated0$;
//│   };
//│ };
//│ h7 = function h(immutable, f$capture6) {
//│   return () => {
//│     return f$capture6.mutated0$;
//│   };
//│ };
//│ f$capture5 = function f$capture(mutated0$1) {
//│   return new f$capture.class(mutated0$1);
//│ };
//│ f$capture5.class = class f$capture {
//│   constructor(mutated0$) {
//│     this.mutated0$ = mutated0$;
//│   }
//│   toString() { return "f$capture(" + this.mutated0$ + ")"; }
//│ };
//│ f16 = function f(unused, immutable, mutated) {
