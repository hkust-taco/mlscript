:lift
:js

:expect 5
:sjs
fun f(used1, unused1) =
  let used2 = unused1
  fun g(g_arg) =
    let used3 = 2
    used1 + used2
  let unused2 = 2
  g(used2) + unused2
f(1, 2)
//│ JS (unsanitized):
//│ let f1, g1;
//│ g1 = function g(used1, used2) {
//│   return (g$_arg) => {
//│     let used3;
//│     used3 = 2;
//│     return used1 + used2;
//│   };
//│ };
//│ f1 = function f(used1, unused1) {
//│   let used2, unused2, tmp, g$this;
//│   used2 = unused1;
//│   unused2 = 2;
//│   g$this = g1(used1, used2) ?? null;
//│   tmp = g$this(used2);
//│   return tmp + unused2;
//│ };
//│ f1(1, 2)
//│ = 5

