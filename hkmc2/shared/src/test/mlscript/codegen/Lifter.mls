//│ f1(1, 2)
//│ = 5

// don't touch g if not needed
:sjs
fun f(used1, unused1) =
  let used2 = unused1
  fun g(g_arg) = g_arg + 1
  let unused2 = 2
  g(used2) + unused2
f(1, 2)
//│ JS (unsanitized):
//│ let f3, g3;
//│ g3 = function g(g$_arg) {
