//│ tmp1 = f11();
//│ ret = tmp1;
//│ f12 = ret.a;
//│ f21 = ret.b;
//│ tmp2 = f21() ?? null;
//│ tmp3 = tmp2.toString() ?? null;
//│ x = tmp3;
//│ tmp4 = f12() ?? null;
//│ tmp5 = f21() ?? null;
