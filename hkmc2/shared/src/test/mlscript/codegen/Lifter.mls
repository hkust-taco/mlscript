//│ = 5

// don't touch g if not needed
:sjs
fun f(used1, unused1) =
  let used2 = unused1
  fun g(g_arg) = g_arg + 1
  let unused2 = 2
  g(used2) + unused2
f(1, 2)
//│ JS (unsanitized):
//│ let f5, g5;
//│ g5 = function g(g$_arg) {
//│   return g$_arg + 1;
//│ };
//│ f5 = function f(used1, unused1) {
//│   let used2, unused2, tmp;
//│   used2 = unused1;
//│   unused2 = 2;
//│   tmp = g5(used2);
//│   return tmp + unused2;
//│ };
//│ f5(1, 2)
//│ = 5

