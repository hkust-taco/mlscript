class Tuple(a, b)
fun f(used1) =
  fun g1(used2) =
    fun h() = 
      set used1 = 10
      set used2 = 100
    fun i() = used1 + used2
    Tuple(h, i)
  fun g22() = used1
  Tuple(g1(10), g22)

:expect '11110110'
let ret = f(1)
let gRet = ret.a
let g2 = ret.b
let hFun = gRet.a
let iFun = gRet.b
let a = iFun()
let b = g2()
hFun()
let c = g2()
let d = iFun()
a.toString() + b + c + d
//│ = '11110110'
//│ a = 11
//│ b = 1
//│ c = 10
//│ d = 110
//│ g2 = [Function (anonymous)]
//│ gRet = Tuple { a: [Function (anonymous)], b: [Function (anonymous)] }
