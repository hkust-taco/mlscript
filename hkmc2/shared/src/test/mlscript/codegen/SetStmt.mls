:js


let g = [0]
//│ g = [0]

set g = g.concat of [1]

set g |>= (_.concat of [2])

g
//│ = [0, 1, 2]

set g.0 += 1

set g.0 = g.0 + 1

g
//│ = [2, 1, 2]

set g.0 |>= Math.sign

// Without parentheses, the placeholder abstracts the entire assignment;
// its body would pass a number to the pipe operator as a function.
:e
set g.2 |>= Math.pow(_, 5)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Num' at an unrelated type 'Function'
//│ ║  l.26: 	set g.2 |>= Math.pow(_, 5)
//│ ╙──      	            ^^^^^^^^^^^^^^
//│ = fun

g
//│ = [1, 1, 2]


// Parenthesizing the callback scopes the placeholder to Math.pow.
set g.2 |>= (Math.pow(_, 5))

:expect [1, 1, 32]
g
//│ = [1, 1, 32]
