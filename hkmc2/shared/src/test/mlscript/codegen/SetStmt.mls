:js

#lang(0.3.x)


let g = [0]
//│ g = [0]

set g = g.concat of [1]

set g |>= (_.concat of [2])

g
//│ = [0, 1, 2]

set g.0 += 1

set g.0 = g.0 + 1

g
//│ = [2, 1, 2]

set g.0 |>= Math.sign

// The RHS of `|>=` delimits the placeholder, as for `|>`.
set g.2 |>= Math.pow(_, 5)

:expect [1, 1, 32]
g
//│ = [1, 1, 32]


// Parentheses do not delimit placeholders in the new syntax.
set g.2 |>= (Math.pow(_, 2))

:expect [1, 1, 1024]
g
//│ = [1, 1, 1024]

