:js

open annotations

:sjs
@generator
fun f() =
  let x = yield 1
  print(x)
  x
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f; f = function* f() { let x; x = yield 1; Predef.print(x); return x };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sjs
class B with
  @generator
  fun f() =
    yield 1
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let B1;
//│ (class B {
//│   static {
//│     B1 = this
//│   }
//│   *f() {
//│     return yield 1
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "B"];
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

@generator
fun g() =
  yield* f()

let test = g()
//│ test =  {}

test.next()
//│ = {value: 1, done: false}

test.next(123)
//│ > 123
//│ = {value: 123, done: true}


:sjs
@generator
fun g() =
  g()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let g1; g1 = function* g() { return g1() };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

