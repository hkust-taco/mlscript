:js

open annotations

:ge
yield 1
//│ ╔══[COMPILATION ERROR] Yield expressions are not allowed in this context.
//│ ║  l.6: 	yield 1
//│ ╙──     	^^^^^^^
//│ = 1

:w
@generator
() => 3
//│ ╔══[WARNING] This annotation has no effect.
//│ ╟── This annotation is not supported on function literal terms.
//│ ║  l.14: 	() => 3
//│ ╙──      	^^^^^^^
//│ = fun


:sjs
@generator
fun f() =
  let x = yield 1
  print(x)
  x
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f; f = function* f() { let x; x = yield 1; Predef.print(x); return x };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sjs
class B with
  @generator
  fun f() =
    yield 1
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let B1;
//│ (class B {
//│   static {
//│     B1 = this
//│   }
//│   *f() {
//│     return yield 1
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "B"];
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:ge
class C with
  @generator
  fun f =
    yield 1
//│ ╔══[COMPILATION ERROR] Generators are not supported on functions without a parameter list
//│ ║  l.54: 	  fun f =
//│ ║        	  ^^^^^^^
//│ ║  l.55: 	    yield 1
//│ ╙──      	^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Yield expressions are not allowed in this context.
//│ ║  l.55: 	    yield 1
//│ ╙──      	    ^^^^^^^

:ge
@generator
fun bad = 1
//│ ╔══[COMPILATION ERROR] Generators are not supported on functions without a parameter list
//│ ║  l.67: 	fun bad = 1
//│ ╙──      	^^^^^^^^^^^

@generator
fun g() =
  yield* f()

let test = g()
//│ test =  {}

test.next()
//│ = {value: 1, done: false}

test.next(123)
//│ > 123
//│ = {value: 123, done: true}
