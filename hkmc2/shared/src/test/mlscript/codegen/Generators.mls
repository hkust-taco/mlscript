:sjs
@generator
fun f() =
  let x = yield 1
  print(x)
  x
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f; f = function* f() { let x; x = yield 1; Predef.print(x); return x };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sjs
