:ge
class C with
  @generator
  fun f =
    yield 1
//│ ╔══[COMPILATION ERROR] Generators are not supported on functions without a parameter list
//│ ║  l.59: 	  fun f =
//│ ║        	  ^^^^^^^
//│ ║  l.60: 	    yield 1
//│ ╙──      	^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Yield expressions are not allowed in this context.
//│ ║  l.60: 	    yield 1
//│ ╙──      	    ^^^^^^^

@generator
fun g() =
  yield* f()

let test = g()
//│ test =  {}

test.next()
//│ = {value: 1, done: false}

test.next(123)
//│ > 123
//│ = {value: 123, done: true}
