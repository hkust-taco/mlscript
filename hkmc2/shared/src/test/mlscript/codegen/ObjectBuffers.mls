//│         params = Ls of 
//│           Param:
//│             flags = ()
//│             sym = x
//│             sign = N
//│             modulefulness = Modulefulness of N
//│         restParam = N
//│       auxParams = Nil
//│       parentPath = N
//│       methods = Nil
//│       privateFields = Ls of 
//│         class:A.x
//│       publicFields = Nil
//│       preCtor = End of ""
//│       ctor = Assign:
//│         lhs = class:A.x
//│         rhs = Ref of x
//│         rest = End of ""
