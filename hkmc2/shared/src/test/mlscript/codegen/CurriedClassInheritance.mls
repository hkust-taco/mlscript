:js


class Foo(val x)(val y)

:e
:sjs
class Bar(val a)(val d) extends Foo(a)
//│ ═══[COMPILATION ERROR] Extending a partially applied class is not supported
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let Bar1;
//│ Bar1 = function Bar(a) {
//│   return (d) => {
//│     return globalThis.Object.freeze(new Bar.class(a, d));
//│   }
//│ };
//│ (class Bar extends Foo1.class {
//│   static {
//│     Bar1.class = this
//│   }
//│   constructor(a, d) {
//│     super(a);
//│     this.a = a;
//│     this.d = d;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Bar", ["a"]];
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let b = Bar(123)(1234)
//│ b = Bar(123)

b.a
//│ = 123

:re
let c = b(100)
//│ ═══[RUNTIME ERROR] TypeError: b is not a function
//│ c = undefined

:fixme
c.a
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'a')

:fixme
Bar(123)(1234)(100).a
//│ ═══[RUNTIME ERROR] TypeError: baseCall is not a function

:re
[c.x, c.y]
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'x')

let b0 = Bar
//│ b0 = fun Bar { class: class Bar }

let b1 = b0(123)
//│ b1 = fun

:re
b1.a
//│ ═══[RUNTIME ERROR] Error: Access to required field 'a' yielded 'undefined'

let b = b1(1234)
//│ b = Bar(123)

b.a
//│ = 123

:re
let c = b(100)
//│ ═══[RUNTIME ERROR] TypeError: b2 is not a function
//│ c = undefined

:fixme
c.a
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'a')

:re
[c.x, c.y]
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'x')


class Baz(a)(val d) extends Foo(a)(a + 1)

let b = Baz(123)(1234)
//│ b = Baz(_)

:re
let c = b(100)
