//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let b = Bar(123)(1234)
//│ b = fun { a: 123, d: 1234 }

b.a
//│ = 123

let c = b(100)
//│ c = Bar(undefined)

:fixme
c.a
//│ ═══[RUNTIME ERROR] Error: Access to required field 'a' yielded 'undefined'

:fixme
Bar(123)(1234)(100).a
//│ ═══[RUNTIME ERROR] Error: Access to required field 'a' yielded 'undefined'

[c.x, c.y]
//│ = [123, 100]

let b0 = Bar
