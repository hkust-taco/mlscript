:sjs
fun test(a) =
  class C with { val x = a }
  new C
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let C1, test;
//│ (class C {
//│   static {
//│     C1 = this
//│   }
//│   constructor(a) {
//│     this.#a = a;
//│     this.x = this.#a;
//│   }
//│   #a;
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "C"];
//│ });
//│ test = function test(a) { return globalThis.Object.freeze(new C1(a)) };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

test(12)
//│ = C { x: 12 }

fun test(x) =
  data class Foo(x)
  Foo(x)

test(3)
//│ = Foo(3)

:sjs
fun test(x) =
  data class Foo(a, b)
  Foo(x, x + 1)
