:expect NaN
:ssjs
:noSanityCheck
data class Cls(x, y) with
  fun f(z, p) = x + y + z + p
id(Cls(1, 2)).f(3)
//│ JS:
//│ Cls1 = function Cls(x, y) {
//│   return globalThis.Object.freeze(new Cls.class(x, y));
//│ };
//│ globalThis.Object.freeze(class Cls {
//│   static {
//│     Cls1.class = this
//│   }
//│   constructor(x, y) {
//│     this.x = x;
//│     this.y = y;
//│   }
//│   f(z, p) {
//│     let tmp6, tmp7;
//│     tmp6 = this.x + this.y;
//│     tmp7 = tmp6 + z;
//│     return tmp7 + p
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Cls", ["x", "y"]]; 
//│ });
//│ tmp4 = Cls1(1, 2);
//│ tmp5 = Predef.id(tmp4);
//│ block$res7 = runtime.safeCall(tmp5.f(3));
//│ undefined
//│ = NaN

