:js

// * In this test, we use `id` to wrap functions so that compile-time arity checks get bypassed.


:ssjs
fun f(x, y) = x + y
f(2, 3)
//│ JS:
//│ f = function f(...args) {
//│   runtime.checkArgs("f", 2, true, args.length);
//│   let x = args[0];
//│   let y = args[1];
//│   return x + y
//│ };
//│ block$res1 = runtime.checkCall(f(2, 3));
//│ undefined
//│ = 5


:expect NaN
:ssjs
:noSanityCheck
fun f2(x, y) = x + y
id(f2)(2)
//│ JS:
//│ f2 = function f2(x, y) {
//│   return x + y
//│ };
//│ tmp = Predef.id(f2);
//│ block$res2 = runtime.safeCall(tmp(2));
//│ undefined
//│ = NaN

:ssjs
:re
id(f)(2)
//│ JS:
//│ tmp1 = runtime.checkCall(Predef.id(f)); block$res3 = runtime.safeCall(tmp1(2)); undefined
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected 2 arguments but got 1


