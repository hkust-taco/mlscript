:js

// * In this test, we use `id` to wrap functions so that compile-time arity checks get bypassed.


:ssjs
fun f(x, y) = x + y
f(2, 3)
//│ JS:
//│ let f;
//│ f = function f(x, y) {
//│   runtime.checkArgs("f", 2, true, arguments.length);
//│   return x + y
//│ };
//│ block$res1 = runtime.checkCall(f(2, 3));
//│ undefined
//│ = 5


:ssjs
let f = (x, y) => x + y
f(2, 3)
//│ JS:
//│ let f1, f2;
//│ f2 = function f(x, y) {
//│   runtime.checkArgs("f", 2, true, arguments.length);
//│   return x + y
//│ };
//│ f1 = f2;
//│ block$res2 = runtime.safeCall(f1(2, 3));
//│ undefined
//│ = 5
//│ f = fun f

:re
f(2)
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected 2 arguments but got 1

:re
f(2, 3, 4)
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected 2 arguments but got 3


:ssjs
:expect NaN
:noSanityCheck
fun f2(x, y) = x + y
id(f2)(2)
//│ JS:
//│ let f21, tmp;
//│ f21 = function f2(x, y) {
//│   return x + y
//│ };
//│ tmp = Predef.id(f21);
//│ block$res5 = runtime.safeCall(tmp(2));
//│ undefined
//│ = NaN

:ssjs
:re
id(f)(2)
//│ JS:
//│ let tmp1;
//│ tmp1 = runtime.checkCall(Predef.id(f1)); block$res6 = runtime.safeCall(tmp1(2)); undefined
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected 2 arguments but got 1


:ssjs
// :re // Argument numbers are no longer checked for lambdas, including extra parameter lists
fun f(x)(y, z) = x + y + z
id(f)(3)(4)
//│ JS:
//│ let f3, tmp2, tmp3;
//│ f3 = function f(x) {
//│   runtime.checkArgs("f", 1, true, arguments.length);
//│   return (y, z) => {
//│     let tmp4;
//│     tmp4 = x + y;
//│     return tmp4 + z
//│   }
//│ };
//│ tmp2 = runtime.checkCall(Predef.id(f3));
//│ tmp3 = runtime.safeCall(tmp2(3));
//│ block$res7 = runtime.safeCall(tmp3(4));
//│ undefined
//│ = NaN


// :ssjs
:expect NaN
:noSanityCheck
let f = (x, y) => x + y in f(2)
//│ = NaN

// :ssjs
:re
let f = (x, y) => x + y
f(2)
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected 2 arguments but got 1
//│ f = fun f


// :ssjs
:expect NaN
:noSanityCheck
data class Cls(x, y) with
  fun f(z, p) = x + y + z + p
id(Cls(1, 2)).f(3)
//│ = NaN

// :ssjs
:re
data class Cls(x, y) with
  fun f(z, p) = x + y + z + p
id(Cls(1, 2)).f(3)
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected 2 arguments but got 1


:ssjs
:expect NaN
// :re // Argument numbers are no longer checked for lambdas, including extra parameter lists
data class Cls(x, y) with
  fun f(z, p)(q, s) = x + y + z + p + q + s
id(Cls(1, 2)).f(3, 4)(5)
//│ JS:
//│ let Cls5, tmp8, tmp9, tmp10;
//│ Cls5 = function Cls(x, y) {
//│   return globalThis.Object.freeze(new Cls.class(x, y));
//│ };
//│ globalThis.Object.freeze(class Cls4 {
//│   static {
//│     Cls5.class = this
//│   }
//│   constructor(x, y) {
//│     this.x = x;
//│     this.y = y;
//│   }
//│   get f$__checkNotMethod() { runtime.deboundMethod("f", "Cls"); }
//│   f(z, p) {
//│     runtime.checkArgs("f", 2, true, arguments.length);
//│     return (q, s) => {
//│       let tmp11, tmp12, tmp13, tmp14;
//│       tmp11 = this.x + this.y;
//│       tmp12 = tmp11 + z;
//│       tmp13 = tmp12 + p;
//│       tmp14 = tmp13 + q;
//│       return tmp14 + s
//│     }
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Cls", ["x", "y"]]; 
//│ });
//│ tmp8 = runtime.checkCall(Cls5(1, 2));
//│ tmp9 = runtime.checkCall(Predef.id(tmp8));
//│ tmp10 = tmp9.f(3, 4);
//│ block$res12 = runtime.safeCall(tmp10(5));
//│ undefined
//│ = NaN


// :ssjs
console.log(1)
//│ > 1


// :ssjs
:re
globalThis.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

// :ssjs
:re
globalThis.x()
//│ ═══[RUNTIME ERROR] TypeError: globalThis.x is not a function




module M with
  data class A(x) with
    fun f(y) = x + y

:ssjs
:re
if M.A(1).y is
  x and x == 1 then x
  else 0
//│ JS:
//│ let scrut, x, scrut1, tmp11, selRes1;
