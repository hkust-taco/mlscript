:js

// * In this test, we use `id` to wrap functions so that compile-time arity checks get bypassed.


:ssjs
fun f(x, y) = x + y
f(2, 3)
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ let f;
//│ f = function f(x, y) {
//│   runtime.checkArgs("f", 2, true, arguments.length);
//│   return x + y
//│ };
//│ block$res1 = 5;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 5


:ssjs
let f = (x, y) => x + y
f(2, 3)
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ let f1, f2;
//│ f2 = function f(x, y) {
//│   runtime.checkArgs("f", 2, true, arguments.length);
//│   return x + y
//│ };
//│ f1 = f2;
//│ block$res2 = 5;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 5
//│ f = fun f

:re
f(2)
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected 2 arguments but got 1

:re
f(2, 3, 4)
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected 2 arguments but got 3


:ssjs
:expect NaN
:noSanityCheck
fun f2(x, y) = x + y
id(f2)(2)
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ let f21;
//│ f21 = function f2(x, y) { return x + y }; block$res5 = runtime.safeCall(f21(2));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = NaN

:ssjs
:re
id(f)(2)
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ block$res6 = runtime.safeCall(f1(2));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected 2 arguments but got 1


:ssjs
// :re // Argument numbers are no longer checked for lambdas, including extra parameter lists
fun f(x)(y, z) = x + y + z
id(f)(3)(4)
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ let f3;
//│ f3 = function f(x) {
//│   runtime.checkArgs("f", 1, true, arguments.length);
//│   return (y, z) => {
//│     let tmp;
//│     tmp = x + y;
//│     return tmp + z
//│   }
//│ };
//│ block$res7 = runtime.safeCall(f3(3)(4));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = NaN


// :ssjs
:expect NaN
:noSanityCheck
let f = (x, y) => x + y in f(2)
//│ = NaN

// :ssjs
:re
let f = (x, y) => x + y
f(2)
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected 2 arguments but got 1
//│ f = fun f


// :ssjs
:expect NaN
:noSanityCheck
data class Cls(x, y) with
  fun f(z, p) = x + y + z + p
id(Cls(1, 2)).f(3)
//│ = NaN

// :ssjs
:re
data class Cls(x, y) with
  fun f(z, p) = x + y + z + p
id(Cls(1, 2)).f(3)
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected 2 arguments but got 1


:ssjs
:expect NaN
// :re // Argument numbers are no longer checked for lambdas, including extra parameter lists
data class Cls(x, y) with
  fun f(z, p)(q, s) = x + y + z + p + q + s
id(Cls(1, 2)).f(3, 4)(5)
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ let Cls5, tmp2, callPrefix;
//│ Cls5 = function Cls(x, y) {
//│   return globalThis.Object.freeze(new Cls.class(x, y));
//│ };
//│ globalThis.Object.freeze(class Cls4 {
//│   static {
//│     Cls5.class = this
//│   }
//│   constructor(x, y) {
//│     this.x = x;
//│     this.y = y;
//│   }
//│   get f$__checkNotMethod() { runtime.deboundMethod("f", "Cls"); }
//│   f(z, p) {
//│     runtime.checkArgs("f", 2, true, arguments.length);
//│     return (q, s) => {
//│       let tmp3, tmp4, tmp5, tmp6;
//│       tmp3 = this.x + this.y;
//│       tmp4 = tmp3 + z;
//│       tmp5 = tmp4 + p;
//│       tmp6 = tmp5 + q;
//│       return tmp6 + s
//│     }
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Cls", ["x", "y"]];
//│ });
//│ tmp2 = runtime.checkCall(Cls5(1, 2));
//│ callPrefix = runtime.safeCall(tmp2.f(3, 4));
//│ block$res12 = runtime.safeCall(callPrefix(5));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = NaN


// :ssjs
console.log(1)
//│ > 1


// :ssjs
:re
globalThis.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

// :ssjs
:re
globalThis.x()
//│ ═══[RUNTIME ERROR] TypeError: globalThis.x is not a function




module M with
  data class A(x) with
    fun f(y) = x + y
  fun g(x, y) = x + y

:ssjs
:re
if M.A(1).y is
  x and x == 1 then x
  else 0
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ let scrut, scrut1, tmp3;
//│ tmp3 = runtime.checkCall(M1.A(1));
//│ scrut = runtime.checkSelect(tmp3.y, "y", tmp3);
//│ scrut1 = runtime.checkCall(Predef.equals(scrut, 1));
//│ if (scrut1 === true) { block$res17 = scrut; } else { block$res17 = 0; }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] Error: Access to required field 'y' yielded 'undefined'



// :ssjs
:re
M.A(1).y
  console.log()
//│ ═══[RUNTIME ERROR] Error: Access to required field 'y' yielded 'undefined'



// :ssjs
:noSanityCheck
M.A(1).y
  console.log()
//│ > undefined

:noSanityCheck
:expect false
M.A(2).y > 1
//│ = false

:re
M.A(2).y > 1
//│ ═══[RUNTIME ERROR] Error: Access to required field 'y' yielded 'undefined'

// :ssjs
:re
M.A(1).g(0)
//│ ═══[RUNTIME ERROR] TypeError: tmp8.g is not a function



// :ssjs
M.A(1).f(0)
//│ = 1



:ssjs
M.g(1, 2)
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ block$res24 = 3;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 3


val outFilePath = "out/test.md"
//│ outFilePath = "out/test.md"

:sjs
fun w(txt) =
  fs.writeFileSync(outFilePath, txt)
  // ()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let w;
//│ w = function w(txt) { return runtime.safeCall(globalThis.fs.writeFileSync(outFilePath, txt)) };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

w("whoops")
