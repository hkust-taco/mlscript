module M with
  data class A(x) with
    fun f(y) = x + y
  fun g(x, y) = x + y

:ssjs
:re
if unchecked(M.A(1)).y is
  x and x == 1 then x
  else 0
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
