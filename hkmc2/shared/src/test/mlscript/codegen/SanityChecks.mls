:.
:js

// * Use dynamic values to exercise runtime checks even for statically invalid operations.
fun unchecked(x): dyn = x


:ssjs
fun f(x, y) = x + y
f(2, 3)
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ let f;
//│ f = function f(x, y) {
//│   runtime.checkArgs("f", 2, true, arguments.length);
//│   return x + y
//│ };
//│ block$res2 = 5;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 5


:ssjs
let f = (x, y) => x + y
f(2, 3)
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ let f1, f2;
//│ f2 = function f(x, y) {
//│   runtime.checkArgs("f", 2, true, arguments.length);
//│   return x + y
//│ };
//│ f1 = f2;
//│ block$res3 = 5;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 5
//│ f = fun f

:re
unchecked(f)(2)
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected 2 arguments but got 1

:re
unchecked(f)(2, 3, 4)
//│ ═══[RUNTIME ERROR] Error: Function 'f' expected 2 arguments but got 3


:ssjs
:expect NaN
:noSanityCheck
