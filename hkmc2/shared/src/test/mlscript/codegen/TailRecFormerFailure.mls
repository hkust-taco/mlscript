:js


import "../../mlscript-compile/Stack.mls"
open Stack


// Note: tail-rec optimized
:soir
fun go(x) = if x is
  Cons(_, _) then "Z"
  n then go([])
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define go⁰ as fun go¹(x) {
//│   loop loopLabel:
//│     let tmp;
//│     match x
//│       Cons⁰ =>
//│         return "Z"
//│       else
//│         set tmp = [];
//│         set x = tmp;
//│         continue loopLabel
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// Note: tail-rec optimized
:soir
fun go(x) = if x is
  Cons(_, Nil) then "Z"
  n then go([])
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define go² as fun go³(x) {
//│   loop loopLabel:
//│     let arg$Cons$1$, tmp, tmp1;
//│     match x
//│       Cons⁰ =>
//│         set arg$Cons$1$ = x.tail⁰;
//│         match arg$Cons$1$
//│           Nil⁰ =>
//│             return "Z"
//│           else
//│             set tmp = [];
//│             set x = tmp;
//│             continue loopLabel
//│         end
//│       else
//│         set tmp1 = [];
//│         set x = tmp1;
//│         continue loopLabel
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// Note: Used not to be tail-rec optimized; now fixed
:soir
:patMatConsequentSharingThreshold 1
 // ^ The default value allowed duplicating "Z" in the above version
fun go(x) = if x is
  Cons(_, Nil) then "Z"
  n then go([])
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
