:js


module M with
  fun (~) concat(a, b) = a + b

open M

:sjs
fun foo() =
  "a" ~ "b" ~ "c"
foo()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let foo; foo = function foo() { return "abc" }; return "abc"
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "abc"

let name = "_"
//│ name = "_"

let display(balance) = balance
//│ display = fun display

"b" ~ display("-")
//│ = "b-"


