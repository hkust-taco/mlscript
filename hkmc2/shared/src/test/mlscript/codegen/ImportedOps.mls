:js


module M with
  fun (~) concat(a, b) = a + b

open M

:sjs
fun foo() =
  "a" ~ "b" ~ "c"
foo()
//│ JS (unsanitized):
//│ let foo; /** scoped **/
//│ foo = function foo() {{
//│     let tmp; /** scoped **/
//│     tmp = M.concat("a", "b");
//│     return M.concat(tmp, "c")
//│   }
//│ };
//│ foo()
//│ = "abc"

let name = "_"
//│ name = "_"

let display(balance) = balance
//│ display = fun display

"b" ~ display("-")
//│ = "b-"


