// * Peculiarity (should not be a problem): notice that we have `BB.y`, and not `AA.BB.y`
:sjs
module AA with
  val x = 1
  module BB with
    val y = 2
    [x, y]
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
