// * Note: `case`/`do` works analogously to `if`/`do`
:sjs
case
  0 do print(1)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let lambda4;
//│ lambda4 = (undefined, function (caseScrut) {
