(case x then x) of 1
//│ = 1

1 |> case x then x
//│ = 1

1 |> id of case x then x
//│ = 1

[1] |> case [x] then x
//│ = 1

1 |> (2 |> case x then case y then [x, y]) |> case [a, b] then [b, a]
//│ = [1, 2]

