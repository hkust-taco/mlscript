:sjs
id(~)(2)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ return ~ 2
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = -3

2 |> ~
//│ = -3


typeof
//│ = fun

typeof(1)
//│ = "number"

typeof("a")
//│ = "string"


