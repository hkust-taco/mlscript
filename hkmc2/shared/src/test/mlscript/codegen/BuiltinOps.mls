:js


:sjs
2 + 2
//│ JS (unsanitized):
//│ 2 + 2
//│ = 4

:sjs
2 +. 2
//│ JS (unsanitized):
//│ 2 + 2
//│ = 4

:sjs
+2
//│ JS (unsanitized):
//│ + 2
//│ = 2

+
//│ = fun

// * A bit confusing... but at least there's a warning!
:w
+(2, 3)
//│ ╔══[WARNING] Pure expression in statement position
//│ ║  l.27: 	+(2, 3)
//│ ╙──      	  ^
//│ = 3

*(2, 3)
//│ = 6

:ge
*(1)
//│ ╔══[COMPILATION ERROR] Builtin '*' is not a unary operator
//│ ║  l.37: 	*(1)
//│ ╙──      	^^^^
//│ ═══[COMPILATION ERROR] Cannot call non-unary builtin symbol '*'
//│ ═══[RUNTIME ERROR] Error: Cannot call non-unary builtin symbol '*'

(+)
//│ = fun

(+)(2, 3)
//│ = 5

(*)(2, 3)
//│ = 6

:ge
(*)(2)
//│ ╔══[COMPILATION ERROR] Builtin '*' is not a unary operator
//│ ║  l.54: 	(*)(2)
//│ ╙──      	^^^^^^
//│ ═══[COMPILATION ERROR] Cannot call non-unary builtin symbol '*'
//│ ═══[RUNTIME ERROR] Error: Cannot call non-unary builtin symbol '*'

id(+)
//│ = fun

id(+)(1, 2)
//│ = 3

(+ 1)
//│ = 1

(+)(1)
//│ = 1

:sjs
:re
id(+)(1)
//│ JS (unsanitized):
//│ let tmp3, tmp4, lambda4;
//│ lambda4 = (undefined, function (arg1, arg2) {
//│   return arg1 + arg2
//│ });
//│ tmp3 = lambda4;
//│ tmp4 = Predef.id(tmp3);
//│ runtime.safeCall(tmp4(1))
//│ ═══[RUNTIME ERROR] Error: Function expected 2 arguments but got 1


fun (+) lol(a, b) = [a, b]

:sjs
1 + 2
//│ JS (unsanitized):
//│ lol(1, 2)
//│ = [1, 2]


:sjs
id(~)(2)
//│ JS (unsanitized):
//│ let tmp5, tmp6, lambda5;
//│ lambda5 = (undefined, function (arg) {
//│   return ~ arg
//│ });
//│ tmp5 = lambda5;
//│ tmp6 = Predef.id(tmp5);
//│ runtime.safeCall(tmp6(2))
//│ = -3

2 |> ~
//│ = -3


typeof
//│ = fun

typeof(1)
//│ = "number"

typeof("a")
//│ = "string"


