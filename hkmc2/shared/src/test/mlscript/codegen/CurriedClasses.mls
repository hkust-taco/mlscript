:js


:sir
:sjs
class A(val x)(val y)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let A1;
//│ A1 = function A(x) {
//│   return (y) => {
//│     return globalThis.Object.freeze(new A.class(x, y));
//│   }
//│ };
//│ (class A {
//│   static {
//│     A1.class = this
//│   }
//│   constructor(x, y) {
//│     this.x = x;
//│     this.y = y;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "A", ["x"]];
//│ });
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define A⁰ as class A² {
//│   val x⁰;
//│   val y⁰;
//│   constructor A¹(x, y) { define x⁰ as val x¹ = x; define y⁰ as val y¹ = y; end }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


let w = new A(1)
//│ w = fun w

let h = w(2)
h.y
//│ = 2
//│ h = A(1)

:sjs
:expect 2
A(1)(2).y
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp; tmp = globalThis.Object.freeze(new A1.class(1, 2)); return tmp.y
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2

:expect 3
let h2 = w(3)
h2.y
//│ = 3
//│ h2 = A(1)

// * This used to return 3, but we now make sure instantiations are always saturated
:expect 2
h.y
//│ = 2

:sjs
:expect 5
new A(...[4])(...[5]).y
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp1, tmp2, tmp3;
//│ tmp1 = globalThis.Object.freeze([
//│   4
//│ ]);
//│ tmp2 = globalThis.Object.freeze([
//│   5
//│ ]);
//│ tmp3 = globalThis.Object.freeze(new A1.class(...tmp1, ...tmp2));
//│ return tmp3.y
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 5


// * First-class class value; FIXME: should be forbidden
let a = A.class
//│ a = class A

// * Dynamic instantiation of a raw JS class is not eta-expanded.
let w = new! a(1)
//│ w = A(1)

:re
let h = w(2)
h.y
//│ ═══[RUNTIME ERROR] TypeError: w2 is not a function
//│ h = undefined

:re
let h2 = w(3)
h2.y
//│ ═══[RUNTIME ERROR] TypeError: w2 is not a function
//│ h2 = undefined

:re
h.y
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'y')


