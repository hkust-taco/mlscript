// * Make sure effect handlers with stack safety can be enabled in one go:

// * Here, handlers are not enabled
:sir
fun foo(x) = { x.call(), print(42) }
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let foo²; define foo² as fun foo³(x) { do x.call﹖(); return Predef⁰.print⁰(42) }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


#config(effectHandlers: Some(EffectHandlers()))
handle h = Object with {}
foo(h)
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: mkQuery (JSBackendDiffMaker.scala:222)
//│ ═══[RUNTIME ERROR] TypeError: x.call is not a function
//│     at foo (REPL31:1:117)
//│     at handleBlock$ (REPL34:1:632)
//│     at Runtime.enterHandleBlock (file:///home/runner/work/mlscript/mlscript/hkmc2/shared/src/test/mlscript-compile/Runtime.mjs:937:28)
//│     at REPL34:1:659
//│     at ContextifyScript.runInThisContext (node:vm:137:12)
//│     at REPLServer.defaultEval (node:repl:552:22)
//│     at bound (node:domain:433:15)
//│     at REPLServer.runBound [as eval] (node:domain:444:12)
//│     at REPLServer.onLine (node:repl:887:10)
//│     at REPLServer.emit (node:events:508:28)


#config(effectHandlers: Some(EffectHandlers(stackSafety: Some(StackSafety(100)))))
#config(liftDefns: Some(LiftDefns)) // * Needed by effect handlers instrumentation

// * Now, they are
fun foo(x) = { x.call(), print(42) }
handle h = Object with
  fun call()(resume) = "Aborted!"
foo(h)
//│ = "Aborted!"


print(42)
#config(liftDefns: None)
//│ > 42


