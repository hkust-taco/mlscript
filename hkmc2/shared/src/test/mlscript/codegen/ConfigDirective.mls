// Test 4: @config local annotation - disable tailRecOpt for one function only
:sir
@config(tailRecOpt: false)
fun foo(n, acc) = if n == 0 then acc else foo(n - 1, n + acc)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let foo⁰;
//│ define foo⁰ as fun foo¹(n, acc) {
//│   let scrut, tmp, tmp1;
//│   set scrut = Predef⁰.equals⁰(n, 0);
//│   match scrut
//│     true =>
//│       return acc
//│     else
//│       set tmp = -⁰(n, 1);
//│       set tmp1 = +⁰(n, acc);
//│       return foo¹(tmp, tmp1)
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// Test 5: bar (no annotation) should still have tailRecOpt
:sir
fun bar(n, acc) = if n == 0 then acc else bar(n - 1, n + acc)
