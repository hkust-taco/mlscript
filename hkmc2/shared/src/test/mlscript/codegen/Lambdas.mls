:sjs
(acc, _) => acc
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let lambda1; lambda1 = (undefined, function (acc, _) { return acc }); return lambda1
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun


let f = (b, c) => b and c
//│ f = fun

f(true, false)
//│ = false

f(true, true)
//│ = true


