:js

:global
:sjs


x =>
  let y = x
  y
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let lambda; lambda = (undefined, function (x) { return x }); return lambda
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun


(acc, _) => acc
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let lambda1; lambda1 = (undefined, function (acc, _) { return acc }); return lambda1
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun


