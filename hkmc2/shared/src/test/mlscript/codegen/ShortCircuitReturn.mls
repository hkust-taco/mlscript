:js

// Regression test: && and || should use Match blocks instead of short_and/short_or function calls.
// This ensures that `return` inside && works correctly.

:elt
:sir
fun test =
  true && return 42
  43
//│ —————————————| Elaborated tree |————————————————————————————————————————————————————————————————————
//│ Blk:
//│   stats = Ls of 
//│     TermDefinition:
//│       k = Fun
//│       sym = member:test⁰
//│       tsym = term:test¹
//│       body = S of Blk:
//│         stats = Ls of 
//│           App:
//│             lhs = Ref{sym=builtin:&&⁰} of builtin:&&⁰
//│             rhs = Tup of Ls of 
//│               Fld:
//│                 term = Lit of BoolLit of true
//│               Fld:
//│                 term = Ret of Lit of IntLit of 42
//│         res = Lit of IntLit of 43
//│       modulefulness = Modulefulness of N
//│   res = Lit of UnitLit of false
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let test⁰; define test⁰ as fun test¹() { match true true => return 42 else return 43 end }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect 42
test // should be 42
//│ = 42
