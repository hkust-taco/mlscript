:js


42 print()
//│ > 42

print(42)
//│ > 42

42 console.log()
//│ > 42


fun inc(x) = x + 1

42 inc()
//│ = 43

42 inc() inc()
//│ = 44

42 inc() inc() print()
//│ > 44

inc(42) inc() print()
//│ > 44


fun add(x, y) = x + y

42 add(2)
//│ = 44

42 add(2) inc()
//│ = 45

