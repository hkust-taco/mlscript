:sjs
let x = 1
let f = () => x
let x = 2
f()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let x, f, x1, f1; x = 1; f1 = function f() { return x }; f = f1; x1 = 2; return x
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1
//│ f = fun f
//│ x = 2


