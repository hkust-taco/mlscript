// * Note how we avoid the name clash between the internal name `Test` of the class
// * and the external name `Test1` of its singleton instance.
:sjs
object Test with
  val x = 12
  fun foo() =
    print(Test)
    Test.x
//│ JS (unsanitized):
//│ let Test1;
//│ const Test$class = class Test {
//│   constructor() {
//│     this.x = 12;
//│     Object.defineProperty(this, "class", {
//│       value: Test
//│     })
//│   }
//│   foo() {
//│     let tmp;
//│     tmp = Predef.print(Test1);
//│     return Test1.x
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["object", "Test"]; 
//│ }; Test1 = globalThis.Object.freeze(new Test$class);

Test
//│ = Test { x: 12, class: object Test }

print(Test)
//│ > Test { x: 12, class: object Test }

:sjs
Test.foo()
//│ JS (unsanitized):
//│ Test1.foo()
//│ > Test { x: 12, class: object Test }
//│ = 12

