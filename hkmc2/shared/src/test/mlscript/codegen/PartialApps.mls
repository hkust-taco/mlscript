let j = _.x in j(x: 123)
//│ = 123

let j = _.x(123) in j(x: print)
//│ > 123


let j = _.x(1, _) in j((x: tuple), 0)
//│ = [1, 0]

// ie
let j = (obj, arg) => obj.x(1, arg) in j((x: tuple), 0)
//│ = [1, 0]

// TODO: really support this?
let j = _.x.y(1, _) in j((x: y: tuple), 0)
//│ = [1, 0]


