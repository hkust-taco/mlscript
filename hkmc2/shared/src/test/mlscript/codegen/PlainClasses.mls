class Foo with
  val x = 1
  fun foo(y) = x + y
  fun bar(z) = foo(z) + 1
//│ JS (unsanitized):
//│ let Foo10;
//│ globalThis.Object.freeze(class Foo9 {
//│   static {
//│     Foo10 = this
//│   }
