:js


// A method must use the same definition-local lowering trace as a free function.
#dbg(showUids: false)
module DebugMethods with
  @dbg('lowering) fun selected(x) = x
  fun sibling(x) = x
//│ Lowering.term x⁰ – symbol x
//│ Expanding term Ref(x)
//│ ~> Ref(x)

:expect 7
DebugMethods.selected(7)
//│ = 7


// Changing only UID display should retain the outer definition's trace flag.
@dbg('lowering, showUids: false) fun debug_outer() =
  @dbg(showUids: false) fun debug_inner() = 42
  debug_inner()
//│ Lowering.term { fun member:debug_inner() = 42; member:debug_inner⁰() }
//│ Lowering.term 42
//│ Lowering.term member:debug_inner⁰()
//│ Expanding term App(Ref(member:debug_inner),Tup(List()))
//│ ~> App(Ref(member:debug_inner),Tup(List()))
//│ Expanding term Ref(member:debug_inner)
//│ ~> Resolved(Ref(member:debug_inner),term:debug_inner)
//│ Lowering.term member:debug_inner⁰‹term:debug_inner› – symbol term:debug_inner
//│ Expanding term Resolved(Ref(member:debug_inner),term:debug_inner)
//│ ~> Resolved(Ref(member:debug_inner),term:debug_inner)


// Diff-test debug commands trace the whole block. A definition's @dbg annotation that does not
// enable the corresponding phase must not mute them inside that definition.
:dl
@dbg(showUids: false) fun command_lowering() = 1601
//│ Lowering.term 1601
//│ Lowering.term undefined
//│ avoidNames Scoped(Set(member:command_lowering),Define(FunDefn(None,member:command_lowering,term:command_lowerin...
//│ | avoidNames Define(FunDefn(None,member:command_lowering,term:command_lowering,List(ParamList(‹›,List(),None)),Re...
//│ | | avoidNames Return(Lit(IntLit(1601)))...
//│ | | avoidNames End()...

:noCodeGen
:de
@dbg('lowering) fun command_elaboration(x) = x
//│ Elab block List(Annotated(App(Ident(dbg),Tup(List(Ident('lowering)))),TermDef(Fun,App(Ident(command_elaboration[...] LocalScope(block:6)
//│ | Processing term definition App(Ident(command_elaboration),Tup(List(Ident(x))))
//│ | Elaborating ParamTree: ParamTree(‹›,Ident(x),None,None,Set())
//│ | Elab term Ident(x)
//│ | | Elab subterm Ident(x)
//│ | | ~> x¹
//│ | ~> x¹
//│ ~> { fun member:command_elaboration(x¹) = x¹; }

:noCodeGen
:dr
@dbg('lowering) fun command_resolution(x) = x
//│ Traversing block: Blk(List(TermDefinition(Fun,member:command_resolution,term:command_resolution,List(ParamList(‹›,List(Param(‹›,x,None,Modulefulness(None))),None)),None,None,Some(Ref(x)),‹›,Modulefulness(None),List(Debug(...)),None)),Lit(UnitLit(false)))
//│ | Traversing statement: TermDefinition(Fun,member:command_resolution,term:command_resolution,List(ParamList(‹›,List(Param(‹›,x,None,Modulefulness(None))),None)),None,None,Some(Ref(x)),‹›,Modulefulness(None),List(Debug(...)),None)
//│ | Resolving definition: TermDefinition(Fun,member:command_resolution,term:command_resolution,List(ParamList(‹›,List(Param(‹›,x,None,Modulefulness(None))),None)),None,None,Some(Ref(x)),‹›,Modulefulness(None),List(Debug(...)),None)
//│ | | Resolving function definition TermDefinition(Fun,member:command_resolution,term:command_resolution,List(ParamList(‹›,List(Param(‹›,x,None,Modulefulness(None))),None)),None,None,Some(Ref(x)),‹›,Modulefulness(None),List(Debug(...)),None)
//│ | | Resolving parameter x²
//│ | | Traversing term: Ref(x) (expect = NonModule)
//│ | | | Resolving resolvable term: Ref(x), (prefer = NonModule, inAppPrefix = false, inCtxPrefix = false, inTyPrefix = false)
//│ | | | | Resolving symbol for term: Ref(x) (prefer = NonModule)
//│ | | | | -> (sym = Some(x), typ = None)
//│ | | | | Resolving the type for term: Ref(x) (prefer = NonModule, sym = Some(x))
//│ | | | | | Declaration: Some(Param(‹›,x,None,Modulefulness(None)))
//│ | | | | -> typ = None
//│ | | | | Resolving resolvable term Ref(x) with sym = Some(x), typ = None
//│ | | | ~> Ref(x) (sym = Some(x), typ = None)
//│ | | | Checking Ref(x): expect NonModule, evalsToModule = false, evalsToStaticClass = false
//│ | Traversing term: Lit(UnitLit(false)) (expect = Any)
//│ | | Checking Lit(UnitLit(false)): expect Any, evalsToModule = false, evalsToStaticClass = false


// A class's lowering trace covers the evaluation of its superclass,
// but not the statements that follow the class definition.
class DebugParent
@dbg('lowering, showUids: false) class DebugChild extends DebugParent
print(1701)
//│ Lowering.term member:DebugParent⁰ – symbol class:DebugParent
//│ Expanding term Ref(member:DebugParent)
//│ ~> Resolved(Ref(member:DebugParent),class:DebugParent)
//│ Lowering.term { } (in stmt)
//│ Lowering.term undefined (in stmt)
//│ Lowering.term (member:Predef⁰.)print‹member:print›(1701)
//│ Expanding term App(SynthSel(Ref(member:Predef),Ident(print)),Tup(List(Fld(‹›,Lit(IntLit(1701)),None))))
//│ ~> App(SynthSel(Ref(member:Predef),Ident(print)),Tup(List(Fld(‹›,Lit(IntLit(1701)),None))))
//│ Expanding term SynthSel(Ref(member:Predef),Ident(print))
//│ ~> Resolved(SynthSel(Ref(member:Predef),Ident(print)),term:Predef/print)
//│ Lowering.term (member:Predef⁰.)print‹term:Predef/print› – symbol term:Predef/print
//│ Expanding term Resolved(SynthSel(Ref(member:Predef),Ident(print)),term:Predef/print)
//│ ~> Resolved(SynthSel(Ref(member:Predef),Ident(print)),term:Predef/print)
//│ Lowering.term member:Predef⁰ – symbol module:Predef
//│ Expanding term Ref(member:Predef)
//│ ~> Resolved(Ref(member:Predef),module:Predef)
//│ Lowering.term 1701
//│ > 1701
