let x =
  let y = 1 + 3 * 4
  y + 4
//│ JS (unsanitized):
//│ let x, y, tmp; /** scoped **/ tmp = 3 * 4; y = 1 + tmp; x = y + 4;
//│ x = 17


:sjs
fun f() =
  if true then
    let a = 4
    a + 4
  else
    let b = 5
    b + 9
//│ JS (unsanitized):
//│ let f; /** scoped **/
//│ f = function f() {
//│   let scrut, a, b; /** scoped **/
//│   scrut = true;
//│   if (scrut === true) { a = 4; return a + 4 } else { b = 5; return b + 9 }
//│ };


