// nested lets should not create nested scopes
:lot
let x =
  let y = 1 + 3 * 4
  y + 4
//│ Lowered:
//│ Program:
//│   imports = Nil
//│   main = Scoped($tmp__630, x__623, y__624):
//│     Assign:
//│       lhs = $tmp__630
