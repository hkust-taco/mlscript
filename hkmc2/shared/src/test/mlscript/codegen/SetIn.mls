:sjs
set x += 1 in print(x)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let old, tmp1, tmp2, tmp3;
//│ old = x1;
//│ try {
//│   tmp2 = x1 + 1;
//│   x1 = tmp2;
//│   tmp3 = Predef.print(tmp2);
//│   tmp1 = tmp3;
//│ } finally { x1 = old; }
//│ return tmp1
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2

x
//│ = 1


fun example() =
  let x = 0
  let get_x() = x
  let x += 1
  print(x)
  print(get_x())
example()
//│ > 1
//│ > 0

fun example() =
  let x = 0
  let get_x() = x
  set x += 1
  print(x)
  print(get_x())
example()
//│ > 1
//│ > 1

:sjs
fun example() =
  let x = 0
  let get_x() = x
  set x += 1 in print(x); print(get_x())
  print(x)
  print(get_x())
example()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let example2, Capture$scope03, get_x$;
//│ (class Capture$scope02 {
//│   static {
//│     Capture$scope03 = this
//│   }
//│   constructor(x$0) {
//│     this.x$0 = x$0;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Capture$scope0"];
//│ });
//│ get_x$ = function get_x$(scope0$cap) {
//│   return () => {
//│     return scope0$cap.x$0
//│   }
//│ };
//│ example2 = function example() {
//│   let get_x, old1, tmp4, tmp5, scope0$cap;
//│   scope0$cap = new Capture$scope03(undefined);
//│   scope0$cap.x$0 = 0;
//│   get_x = get_x$(scope0$cap);
//│   old1 = scope0$cap.x$0;
//│   try {
//│     {
//│       let inlinedVal;
//│       tmp4 = scope0$cap.x$0 + 1;
//│       scope0$cap.x$0 = tmp4;
//│       Predef.print(scope0$cap.x$0);
//│       inlinedVal = scope0$cap.x$0;
//│       Predef.print(inlinedVal);
//│     }
//│   } finally {
//│     scope0$cap.x$0 = old1;
//│   }
//│   Predef.print(scope0$cap.x$0);
//│   tmp5 = runtime.safeCall(get_x());
//│   return Predef.print(tmp5)
//│ };
//│ return example2()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ > 1
//│ > 0
//│ > 0

:soir
fun example() =
  let x = 0
  let get_x() = x
  let y =
    set x += 1 in print(x); x
  print(x)
  print(get_x())
  y
example()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let example⁰, Capture$scope0⁰, get_x$⁰;
//│ define Capture$scope0⁰ as class Capture$scope0² {
//│   constructor Capture$scope0¹(x$0) {
//│     define x$0⁰ as val x$0¹ = x$0;
//│     end
//│   }
//│ };
//│ @inline @private
//│ define get_x$⁰ as fun get_x$¹(scope0$cap)() {
//│   return scope0$cap.x$0¹
//│ };
//│ define example⁰ as fun example¹() {
//│   let get_x, old, tmp, tmp1, tmp2, tmp3, scope0$cap;
//│   set scope0$cap = new mut Capture$scope0²(undefined);
//│   set scope0$cap.x$0¹ = 0;
//│   set get_x = get_x$¹(scope0$cap);
//│   set old = scope0$cap.x$0¹;
//│   try
//│     set tmp1 = +⁰(scope0$cap.x$0¹, 1);
//│     set scope0$cap.x$0¹ = tmp1;
//│     do Predef⁰.print⁰(scope0$cap.x$0¹);
//│     set tmp2 = scope0$cap.x$0¹;
//│     set tmp = tmp2;
//│     end
//│   finally
//│     set scope0$cap.x$0¹ = old;
//│     end;
//│     do Predef⁰.print⁰(scope0$cap.x$0¹);
//│   set tmp3 = get_x();
//│   do Predef⁰.print⁰(tmp3);
//│   return tmp
//│ };
//│ return example¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ > 0
//│ > 0
//│ = 1

