:js


let x = 0
//│ x = 0

:sjs
let x += 1
//│ JS (unsanitized):
//│ let x1, tmp; tmp = x + 1; x1 = tmp;
//│ x = 1

x
//│ = 1

:sjs
set x = 0
//│ JS (unsanitized):
//│ x1 = 0; runtime.Unit

:sjs
set x += 1
//│ JS (unsanitized):
//│ let tmp1; tmp1 = x1 + 1; x1 = tmp1; runtime.Unit

x
//│ = 1


:sjs
set x += 1 in print(x)
//│ JS (unsanitized):
//│ let old, tmp2, tmp3, tmp4;
//│ old = x1;
//│ try { tmp3 = x1 + 1; x1 = tmp3; tmp4 = Predef.print(x1); tmp2 = tmp4; } finally { x1 = old; }
//│ tmp2
//│ > 2

x
//│ = 1


fun example() =
  let x = 0
  let get_x() = x
  let x += 1
  print(x)
  print(get_x())
example()
//│ > 1
//│ > 0

fun example() =
  let x = 0
  let get_x() = x
  set x += 1
  print(x)
  print(get_x())
example()
//│ > 1
//│ > 1

:sjs
fun example() =
  let x = 0
  let get_x() = x
  set x += 1 in print(x); print(get_x())
  print(x)
  print(get_x())
example()
//│ JS (unsanitized):
//│ let example2;
//│ example2 = function example() {
//│   let x2, get_x, old1, tmp5, tmp6, tmp7, tmp8, tmp9, tmp10, tmp11, tmp12, tmp13, lambda;
//│   x2 = 0;
//│   lambda = (undefined, function () {
//│     return x2
//│   });
//│   tmp5 = lambda;
//│   get_x = tmp5;
//│   old1 = x2;
//│   try {
//│     tmp7 = x2 + 1;
//│     x2 = tmp7;
//│     tmp8 = Predef.print(x2);
//│     tmp9 = runtime.safeCall(get_x());
//│     tmp10 = Predef.print(tmp9);
//│     tmp11 = (tmp8 , tmp10);
//│     tmp6 = tmp11;
//│   } finally {
//│     x2 = old1;
//│   }
//│   tmp12 = Predef.print(x2);
//│   tmp13 = runtime.safeCall(get_x());
//│   return Predef.print(tmp13)
//│ };
//│ example2()
//│ > 1
//│ > 1
//│ > 0
//│ > 0

:sjs
fun example() =
  let x = 0
  let get_x() = x
  let y =
    set x += 1 in print(x); x
  print(x)
  print(get_x())
  y
example()
//│ JS (unsanitized):
//│ let example3;
//│ example3 = function example() {
//│   let x2, get_x, y, old1, tmp5, tmp6, tmp7, tmp8, tmp9, tmp10, tmp11, tmp12, lambda;
//│   x2 = 0;
//│   lambda = (undefined, function () {
//│     return x2
//│   });
//│   tmp5 = lambda;
//│   get_x = tmp5;
//│   old1 = x2;
//│   try {
//│     tmp7 = x2 + 1;
//│     x2 = tmp7;
//│     tmp8 = Predef.print(x2);
//│     tmp9 = (tmp8 , x2);
//│     tmp6 = tmp9;
//│   } finally {
//│     x2 = old1;
//│   }
//│   y = tmp6;
//│   tmp10 = Predef.print(x2);
//│   tmp11 = runtime.safeCall(get_x());
//│   tmp12 = Predef.print(tmp11);
//│   return y
//│ };
//│ example3()
//│ > 1
//│ > 0
//│ > 0
//│ = 1

