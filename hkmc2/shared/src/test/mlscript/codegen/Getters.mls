//│ (class Foo {
//│   static {
//│     Foo1.class = this
//│   }
//│   constructor(x) {
//│     this.x = x;
//│   }
//│   get oops() {
//│     return this.x;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Foo", ["x"]]; 
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


fun foo(f) =
  f.oops


foo(Foo(42))
//│ = 42


fun foo(f) =
  f.oops

