:sjs
fun baz() =
  fun w = 1
  fun z = 2
  (x, y) => x + y + w + z
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let baz;
//│ baz = function baz() {
//│   let w, z, lambda;
//│   w = function w() {
//│     return 1
//│   };
//│   z = function z() {
//│     return 2
//│   };
//│   lambda = (undefined, function (x, y) {
//│     let tmp, tmp1, tmp2, tmp3;
//│     tmp = x + y;
//│     tmp1 = w();
//│     tmp2 = tmp + tmp1;
//│     tmp3 = z();
//│     return tmp2 + tmp3
//│   });
//│   return lambda
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


baz()(3, 4)
//│ = 10


