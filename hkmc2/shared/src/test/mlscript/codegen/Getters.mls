:sjs
data class Foo(x) with
  fun oops = x
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let Foo1;
//│ Foo1 = function Foo(x) {
//│   return globalThis.Object.freeze(new Foo.class(x));
//│ };
//│ (class Foo {
//│   static {
//│     Foo1.class = this
//│   }
//│   constructor(x) {
//│     this.x = x;
//│   }
//│   get oops() {
//│     return this.x;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Foo", ["x"]];
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


fun foo(f) =
  f.oops


foo(Foo(42))
//│ = 42


fun foo(f) =
  f.oops

data class Foo(x) with
  fun oops = x

foo(Foo(42))
//│ = 42

:re
foo(Foo(42))()
