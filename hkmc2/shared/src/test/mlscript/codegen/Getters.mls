:js
:noInline


:sjs
fun t = 42
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let t; t = function t() { return 42 };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


:expect 42
:sjs
t
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ return t()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


fun main() =
  let n = 0
  fun foo =
    print("ok")
    set n += 1
    n
  foo + foo

:expect 3
main()
//│ > ok
//│ > ok
//│ = 3


:sjs
fun test() =
  fun whoops =
    print("ok")
    42
  whoops + whoops
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let whoops, test;
//│ whoops = function whoops() {
//│   Predef.print("ok");
//│   return 42
//│ };
//│ test = function test() { let tmp, tmp1; tmp = whoops(); tmp1 = whoops(); return tmp + tmp1 };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

test()
//│ > ok
//│ > ok
//│ = 84


:sjs
module T with
  fun t() = 1
  fun p = 2
  val a = t
  val b = this.t
  val c = p
  val d = this.p
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let T1;
//│ (class T {
//│   static {
//│     T1 = this
//│   }
//│   static {
//│     T.a = T.t;
//│     T.b = T.t;
//│     T.c = T.p;
//│     T.d = T.p;
//│   }
//│   static t() {
//│     return 1
//│   }
//│   static get p() {
//│     return 2;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "T"];
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


T.a
//│ = fun t

T.b
//│ = fun t

T.c
//│ = 2

T.d
//│ = 2


