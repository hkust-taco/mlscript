:sjs
fun bar() =
  fun baz() = 42
  baz
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let baz, bar; baz = function baz() { return 42 }; bar = function bar() { return baz };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


:sjs
fun baz() =
  fun w = 1
  fun z = 2
  (x, y) => x + y + w + z
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let w, z, baz1, lambda;
//│ w = function w() {
//│   return 1
//│ };
//│ z = function z() {
//│   return 2
//│ };
//│ lambda = (undefined, function (x, y) {
//│   let tmp, tmp1, tmp2, tmp3;
//│   tmp = x + y;
//│   tmp1 = w();
//│   tmp2 = tmp + tmp1;
//│   tmp3 = z();
//│   return tmp2 + tmp3
//│ });
//│ baz1 = function baz() { return lambda };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


baz()(3, 4)
//│ = 10


:sjs
fun a() =
  fun b = 1
  fun c() =
    fun d = 2
    b + d
  c
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let d, b, c, a;
//│ d = function d() {
//│   return 2
//│ };
