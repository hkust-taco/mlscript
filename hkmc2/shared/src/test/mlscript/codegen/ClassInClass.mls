val o = Outer(100, 200)
//│ > 100
//│ > 100
//│ > [200, 100, 100]
//│ > 100
//│ > [200, 100, 1]
//│ o = Outer(100, 200)

o.o1(30)
//│ > 100
//│ > 30
//│ > [200, 30, 100]
