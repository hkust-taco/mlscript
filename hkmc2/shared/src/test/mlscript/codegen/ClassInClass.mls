val o = Outer(100, 200)
//│ > 100
//│ > 100
//│ > [200, 100, 100]
//│ > 100
//│ > [200, 100, 1]
//│ o = Outer(100, 200)

o.o1(30)
//│ > 100
//│ > 30
//│ > [200, 30, 100]
//│ = Inner(30)

o.o2(30, 40)
//│ > 100
//│ > 30
//│ > [200, 30, 100]
//│ = [200, 30, 40]

o.i
//│ = Inner(100)


