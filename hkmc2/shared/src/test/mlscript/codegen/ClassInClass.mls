:js


:sjs
data class Outer(a, b) with
  data class Inner(c) with
    fun i1(d) = [b, c, d]
    print(a)
    print(c)
    print(i1(a))
  fun o1(c) = Inner(c)
  fun o2(c, d) = Inner(c).i1(d)
  val i = Inner(a)
  print(i.c)
  print(i.i1(1))
