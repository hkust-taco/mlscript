:.
:js

#config(commentGeneratedCode: true)


object A
object B
object C
object D
object E


let a = A
let b = B
//│ a = A
//│ b = B

:sjs
if a is
  A then 1
  B then 2
  C then 3
  D then 4
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let scrut;
//│ scrut = a;
//│ if (scrut instanceof A1.class) {
//│   return 1
//│ } else if (scrut instanceof B1.class) {
//│   return 2
//│ } else if (scrut instanceof C1.class) {
//│   return 3
//│ } else if (scrut instanceof D1.class) {
//│   return 4
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// manually written `else if`s branches on the same scrut is also merged 
:sjs
if a is
  A then 1
  else
    if a is
      B then 2
      C then 3
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let scrut1, scrut2;
//│ scrut1 = a;
//│ if (scrut1 instanceof A1.class) {
//│   return 1
//│ }
//│ scrut2 = a;
//│ if (scrut2 instanceof B1.class) {
//│   return 2
//│ } else if (scrut2 instanceof C1.class) {
//│   return 3
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


:sjs
if a is
  A and b is
    A then 1
    B then 2
  B then 2
  C then 3
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let scrut3, scrut4;
//│ scrut3 = a;
//│ if (scrut3 instanceof A1.class) {
//│   scrut4 = b;
//│   if (scrut4 instanceof A1.class) {
//│     return 1
//│   } else if (scrut4 instanceof B1.class) {
//│     return 2
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ } else if (scrut3 instanceof B1.class) {
//│   return 2
//│ } else if (scrut3 instanceof C1.class) {
//│   return 3
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2

// The match arms here are still merged because
// `let tmp = 3` is moved out so that it does not get into the way
// and `print("done")` is duplicated and moved into match arm bodies
:sjs
let x = if a is
  A then 1
  B then 2
  C then 3
  else
    let tmp = 3
    if a is
      D then
        if a is
         A then 1 + tmp
         B then 2 + tmp
      E then 5
    print("done")
print(x)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let x, scrut5, scrut6, scrut7, tmp;
//│ scrut5 = a;
//│ if (scrut5 instanceof A1.class) {
//│   tmp = 1;
//│ } else if (scrut5 instanceof B1.class) {
//│   tmp = 2;
//│ } else if (scrut5 instanceof C1.class) {
//│   tmp = 3;
//│ } else {
//│   scrut6 = a;
//│   if (scrut6 instanceof D1.class) {
//│     scrut7 = a;
//│     if (scrut7 instanceof A1.class) {
//│       /* Rest moved to non-abortive branch(es) */
//│     } else if (scrut7 instanceof B1.class) {
//│       /* Rest moved to non-abortive branch(es) */
//│     } else {
//│       throw globalThis.Object.freeze(new globalThis.Error("match error"))
//│     }
//│     /* Rest moved to non-abortive branch(es) */
//│   } else if (scrut6 instanceof E1.class) {} else {
//│     throw globalThis.Object.freeze(new globalThis.Error("match error"))
//│   }
//│   tmp = Predef.print("done");
//│ }
//│ x = tmp;
//│ return Predef.print(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1


// The match arms here are still merged because
// `let tmp = 2` is moved out so that it does not get into the way
:sjs
if a is
  A then 1
  let tmp = 2
  B then 2 + tmp
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let scrut8;
//│ scrut8 = a;
//│ if (scrut8 instanceof A1.class) {
//│   return 1
//│ } else if (scrut8 instanceof B1.class) {
//│   return 4
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


fun printAndId(x) =
  print(x)
  x

// `let tmp = printAndId(3)` is not moved out
// because the rhs is not trivial
:sjs
if a is
  A then 1
  let tmp = printAndId(3)
  B then 2 + tmp
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let scrut9;
//│ scrut9 = a;
//│ if (scrut9 instanceof A1.class) {
//│   return 1
//│ }
//│ Predef.print(3);
//│ if (scrut9 instanceof B1.class) {
//│   return 5
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// The match arms here are still merged because
// `print(x)` is duplicated and moved into match arm bodies
:sjs
if a is
  A then 1
  else
    let x = if a is
      B then 2
      C then 3
    print(x)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let scrut10, scrut11;
//│ scrut10 = a;
//│ if (scrut10 instanceof A1.class) {
//│   return 1
//│ }
//│ scrut11 = a;
//│ if (scrut11 instanceof B1.class) {
//│   return Predef.print(2)
//│ } else if (scrut11 instanceof C1.class) {
//│   return Predef.print(3)
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ /* Rest moved to non-abortive branch(es) */
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// The match arms are not merged because
// `print(x); print(x + 1); print(x + 2)` is
// not moved into match arm bodies for being too big
:sjs
if a is
  B then 1
  else
    let x = if a is
      A then 2
      C then 3
    print(x)
    print(x + 1)
    print(x + 2)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let scrut12, scrut13, tmp1, tmp2, tmp3;
//│ scrut12 = a;
//│ if (scrut12 instanceof B1.class) {
//│   return 1
//│ }
//│ scrut13 = a;
//│ if (scrut13 instanceof A1.class) {
//│   tmp1 = 2;
//│ } else if (scrut13 instanceof C1.class) {
//│   tmp1 = 3;
//│ } else {
//│   throw globalThis.Object.freeze(new globalThis.Error("match error"))
//│ }
//│ Predef.print(tmp1);
//│ tmp2 = tmp1 + 1;
//│ Predef.print(tmp2);
//│ tmp3 = tmp1 + 2;
//│ return Predef.print(tmp3);
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ > 3
//│ > 4


:soir
fun f(x) =
  let acc = ""
  if x is 5 then
    return acc
  else
    if x is
      8 then print("8")
      else print("?")
    print("hi")
    acc
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define f⁰ as fun f¹(x) {
//│   match x
//│     5 =>
//│       return ""
//│     else
//│       match x
//│         8 =>
//│           do Predef⁰.print⁰("8");
//│           end
//│         else
//│           do Predef⁰.print⁰("?");
//│           end
//│       do Predef⁰.print⁰("hi");
//│       return ""
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(5)
//│ = ""

f(6)
//│ > ?
//│ > hi
//│ = ""

f(8)
//│ > 8
//│ > hi
//│ = ""


