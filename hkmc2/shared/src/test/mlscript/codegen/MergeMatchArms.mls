:.
:js

#config(commentGeneratedCode: true)


object A
object B
object C
object D
object E


let a = A
let b = B
//│ a = A
//│ b = B

:sjs
if a is
  A then 1
  B then 2
  C then 3
  D then 4
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp;
//│ tmp = a;
//│ if (tmp instanceof A1.class) {
//│   return 1
//│ } else if (tmp instanceof B1.class) {
//│   return 2
//│ } else if (tmp instanceof C1.class) {
//│   return 3
//│ } else if (tmp instanceof D1.class) {
//│   return 4
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// manually written `else if`s branches on the same scrut is also merged 
:sjs
if a is
  A then 1
  else
    if a is
      B then 2
      C then 3
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp1, tmp2;
//│ tmp1 = a;
//│ if (tmp1 instanceof A1.class) {
//│   return 1
//│ }
//│ tmp2 = a;
//│ if (tmp2 instanceof B1.class) {
//│   return 2
//│ } else if (tmp2 instanceof C1.class) {
//│   return 3
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


:sjs
if a is
  A and b is
    A then 1
    B then 2
  B then 2
  C then 3
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp3, tmp4;
//│ tmp3 = a;
//│ if (tmp3 instanceof A1.class) {
//│   tmp4 = b;
//│   if (tmp4 instanceof A1.class) {
//│     return 1
//│   } else if (tmp4 instanceof B1.class) {
//│     return 2
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ } else if (tmp3 instanceof B1.class) {
//│   return 2
//│ } else if (tmp3 instanceof C1.class) {
//│   return 3
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2

// The match arms here are still merged because
// `let tmp = 3` is moved out so that it does not get into the way
// and `print("done")` is duplicated and moved into match arm bodies
:sjs
let x = if a is
  A then 1
  B then 2
  C then 3
  else
    let t = 3
    if a is
      D then
        if a is
          A then 1 + t
          B then 2 + t
      E then 5
    print("done")
    t
print(x)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let x, tmp5, tmp6, tmp7, tmp8;
//│ tmp5 = a;
//│ if (tmp5 instanceof A1.class) {
//│   tmp6 = 1;
//│ } else if (tmp5 instanceof B1.class) {
//│   tmp6 = 2;
//│ } else if (tmp5 instanceof C1.class) {
//│   tmp6 = 3;
//│ } else {
//│   tmp7 = a;
//│   if (tmp7 instanceof D1.class) {
//│     tmp8 = a;
//│     if (tmp8 instanceof A1.class) {
//│       /* Rest moved to non-abortive branch(es) */
//│     } else if (tmp8 instanceof B1.class) {
//│       /* Rest moved to non-abortive branch(es) */
//│     } else {
//│       throw globalThis.Object.freeze(new globalThis.Error("match error"))
//│     }
//│     /* Rest moved to non-abortive branch(es) */
//│   } else if (tmp7 instanceof E1.class) {} else {
//│     throw globalThis.Object.freeze(new globalThis.Error("match error"))
//│   }
//│   Predef.print("done");
//│   tmp6 = 3;
//│ }
//│ x = tmp6;
//│ return Predef.print(tmp6)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1


// The match arms here are still merged because
// `let tmp = 2` is moved out so that it does not get into the way
:sjs
if a is
  A then 1
  let tmp = 2
  B then 2 + tmp
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
