//│ block$res11 = Option.isDefined(tmp3);
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = true

new Some(1) isDefined()
//│ = true

new Some(1)
  isDefined()
//│ = true


open Option { Some, None, isDefined }

(new Some(1)) isDefined()
//│ = true

None isDefined()
//│ = false

None == Option.None
//│ = true


