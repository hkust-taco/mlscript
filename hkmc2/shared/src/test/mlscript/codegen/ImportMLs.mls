:js


import "../../mlscript-compile/Option.mls"


open Option { isDefined }

Option.None isDefined()
//│ = false

Option.Some(1) isDefined()
//│ = true


open Option
  Some, None
  isDefined

:sjs
None isDefined()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ block$res6 = Option.isDefined(Option.None);
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = false

case Some(x) then x
//│ = fun

case { Some(x) then x }
//│ = fun

Some(1) isDefined()
//│ = true

Some(1)
  isDefined()
//│ = true

:sjs
(new Some(1)) isDefined()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
