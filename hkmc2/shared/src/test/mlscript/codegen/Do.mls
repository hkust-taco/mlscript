:js


:elt
do ()
//│ —————————————| Elaborated tree |————————————————————————————————————————————————————————————————————
//│ Blk:
//│   res = Blk:
//│     stats = Ls of
//│       UnitVal
//│     res = UnitVal
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

do console.log("ok")
//│ > ok

:w
do 1
//│ ╔══[WARNING] Pure expression in statement position
//│ ║  l.18: 	do 1
//│ ╙──      	   ^

do
  let hello = 1
  ()

:re
print(globalThis.hello)
//│ ═══[RUNTIME ERROR] Error: Access to required field 'hello' yielded 'undefined'

:ucs desugared
val f = case
  0 then "null"
  do console.log("non-null")
  1 then "unit"
  let res = "other"
  do print(res)
  _ then res
//│ Split with nested patterns:
//│ >  case
//│ >    caseScrut is 0 then "null"
//│ >    let tmp:unused = member:console⁰.log‹member:log›("non-null")
//│ >    caseScrut is 1 then "unit"
//│ >    let res = "other"
//│ >    let tmp:unused = (member:Predef⁰.)print‹member:print›(res⁰)
//│ >    caseScrut is _ then res⁰
//│ Expanded split with flattened patterns:
//│ >  ‹if|while›
//│ >    caseScrut is 0 then "null"
//│ >    let tmp:unused = member:console⁰.log‹member:log›("non-null")
//│ >    caseScrut is 1 then "unit"
//│ >    let res = "other"
//│ >    let tmp:unused = (member:Predef⁰.)print‹member:print›(res⁰)
//│ >    else res⁰
//│ f = fun

f(0)
//│ = "null"

f(1)
//│ > non-null
//│ = "unit"

f(2)
//│ > non-null
//│ > other
//│ = "other"


