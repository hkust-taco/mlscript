:.
:js
open annotations

// Marker annotations have separate locations for each occurrence.
:w
@inline
class First
@inline
class Second
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	@inline
//│ ╙──      	^^^^^^^
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+3: 	@inline
//│ ╙──      	^^^^^^^

// Annotations on let bindings point to the annotation occurrence.
:w
@tailrec
let value = 1
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+1: 	@tailrec
//│ ╙──      	^^^^^^^^
//│ value = 1

// Annotations on bodyless functions retain their own locations.
:w
@inline
fun abstractFunction()
//│ ╔══[WARNING] Only functions with a body may be marked as @inline.
//│ ║  l.+1: 	@inline
//│ ╙──      	^^^^^^^

// A dynamic callee remains callable after lowering its prefix to a temporary.
:ftc
:expect 1
let index = 0
[(x => x)].(index)(1)
//│ = 1
//│ index = 0
