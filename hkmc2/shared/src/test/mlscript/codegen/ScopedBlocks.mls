module M
data class A(a, b)
data class B(a, b)
data object Nil



fun f() = if x is
  A(a, b) and a > b then true
  B(c, d) then false



fun f() = if A(1, Nil) is
  A(1, Nil) then 3




fun f(x) =
  x = while x is
    A(a, _) then a()
    B(a, _) then a()
  else
    x()
  x




fun f() =
  let y = x + 1
  while y is
    A(z, a) and
      false and true do
        set y = z + 1
      else
        y = a



fun f(x, y) =
  while x && y do
    f(0, 0) + 4




class A with
  val x = 1 + 2


let state = 0
//│ state = 0


class Foo() with // the class definition is moved to the location of its companion
  fun foo() = state
set state += 1
module Foo with
  val res = Foo().foo()



