//│   stats = Ls of
//│     SetConfig of ...
//│   res = Lit of IntLit of 42
//│ —————————————| Elaborated term |————————————————————————————————————————————————————————————————————
//│ #config(...), 42
//│ —————————————| Lowered IR Tree |————————————————————————————————————————————————————————————————————
//│ Program:
//│   main = Return of Lit of IntLit of 42
