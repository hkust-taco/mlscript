//│ return 42
//│ ⬤ Simplif. iter. 1
//│ Captured variables: Set()
//│ ⬤ Simplif. iter. 1
//│ Captured variables: Set()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ return 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42

#dbg(showParsedTree: false, showElaboratedTree: false, showElaboratedTerm: false, showLoweredTree: false, showIR: false, showOptimizedIR: false, optimizations: false)
