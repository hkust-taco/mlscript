:js

:global
:sjs


data class Foo()
//│ JS (unsanitized):
//│ let Foo1;
//│ Foo1 = function Foo() {
//│   return globalThis.Object.freeze(new Foo.class());
//│ };
//│ globalThis.Object.freeze(class Foo {
//│   static {
//│     Foo1.class = this
//│   }
//│   constructor() {}
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Foo", []]; 
//│ });

Foo
//│ JS (unsanitized):
//│ Foo1
//│ = fun Foo { class: class Foo }

Foo()
//│ JS (unsanitized):
//│ Foo1()
//│ = Foo()

Foo.class
//│ JS (unsanitized):
//│ Foo1.class
//│ = class Foo


data class Foo(a)
//│ JS (unsanitized):
//│ let Foo3;
//│ Foo3 = function Foo(a) {
//│   return globalThis.Object.freeze(new Foo.class(a));
//│ };
//│ globalThis.Object.freeze(class Foo2 {
//│   static {
//│     Foo3.class = this
//│   }
//│   constructor(a) {
//│     this.a = a;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Foo", ["a"]]; 
//│ });

Foo
//│ JS (unsanitized):
//│ Foo3
//│ = fun Foo { class: class Foo }

Foo(1)
//│ JS (unsanitized):
//│ Foo3(1)
//│ = Foo(1)

Foo(1).a
//│ JS (unsanitized):
//│ let tmp; tmp = Foo3(1); tmp.a
//│ = 1

fun foo(y) = Foo(y)
foo(27)
//│ JS (unsanitized):
//│ let foo; foo = function foo(y) { return Foo3(y) }; foo(27)
//│ = Foo(27)


data class Foo(a, b)
//│ JS (unsanitized):
//│ let Foo5;
//│ Foo5 = function Foo(a, b) {
//│   return globalThis.Object.freeze(new Foo.class(a, b));
//│ };
//│ globalThis.Object.freeze(class Foo4 {
//│   static {
//│     Foo5.class = this
//│   }
//│   constructor(a, b) {
//│     this.a = a;
//│     this.b = b;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Foo", ["a", "b"]]; 
//│ });

let foo = Foo
//│ JS (unsanitized):
//│ let foo1; foo1 = Foo5;
//│ foo = fun Foo { class: class Foo }

let f = foo(1, 2)
//│ JS (unsanitized):
//│ let f; f = runtime.safeCall(foo1(1, 2));
//│ f = Foo(1, 2)

let f = new! foo(1, 2)
//│ JS (unsanitized):
//│ let f1; f1 = globalThis.Object.freeze(new foo1(1, 2));
//│ f = Foo(1, 2)

f.a
//│ JS (unsanitized):
//│ f1.a
//│ = 1

f.b
//│ JS (unsanitized):
//│ f1.b
//│ = 2

let f = Foo(1, 2)
//│ JS (unsanitized):
//│ let f2; f2 = Foo5(1, 2);
//│ f = Foo(1, 2)

f.a
//│ JS (unsanitized):
//│ f2.a
//│ = 1

f.b
//│ JS (unsanitized):
//│ f2.b
//│ = 2

Foo(print(1), print(2))
//│ JS (unsanitized):
//│ let tmp1, tmp2; tmp1 = Predef.print(1); tmp2 = Predef.print(2); Foo5(tmp1, tmp2)
//│ > 1
//│ > 2
//│ = Foo((), ())


data class Inner(c) with
  fun i1(d) = c + d
  print(c)
//│ JS (unsanitized):
//│ let Inner1;
//│ Inner1 = function Inner(c) {
//│   return globalThis.Object.freeze(new Inner.class(c));
//│ };
//│ globalThis.Object.freeze(class Inner {
//│   static {
//│     Inner1.class = this
//│   }
//│   constructor(c) {
//│     this.c = c;
//│     Predef.print(this.c);
//│   }
//│   i1(d) {
//│     return this.c + d
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Inner", ["c"]]; 
//│ });

let i = new Inner(100)
//│ JS (unsanitized):
//│ let i; i = globalThis.Object.freeze(new Inner1.class(100));
//│ > 100
//│ i = Inner(100)

i.i1(20)
//│ JS (unsanitized):
//│ runtime.safeCall(i.i1(20))
//│ = 120


// * This is strange, but does not need to be an error
class Foo(x, val y, z, val z, z) with
  let x = 1
  let y += 1
  print("x = " + x)
  print("y = " + y)
  print("this.y = " + this.y)
  print("z = " + z)
  print("this.z = " + this.z)
//│ JS (unsanitized):
//│ let Foo7;
//│ Foo7 = function Foo(x, y, z, z1, z2) {
//│   return globalThis.Object.freeze(new Foo.class(x, y, z, z1, z2));
//│ };
//│ globalThis.Object.freeze(class Foo6 {
//│   static {
//│     Foo7.class = this
//│   }
//│   constructor(x, y, z, z1, z2) {
//│     let tmp3, tmp4, tmp5, tmp6, tmp7, tmp8, tmp9, tmp10, tmp11;
//│     this.#x = x;
//│     this.y = y;
//│     this.#z = z;
//│     this.z = z1;
//│     this.#z1 = z2;
//│     this.#x1 = 1;
//│     this.#y = this.y + 1;
//│     tmp3 = "x = " + this.#x1;
//│     tmp4 = Predef.print(tmp3);
//│     tmp5 = "y = " + this.#y;
//│     tmp6 = Predef.print(tmp5);
//│     tmp7 = "this.y = " + this.y;
//│     tmp8 = Predef.print(tmp7);
//│     tmp9 = "z = " + this.#z1;
//│     tmp10 = Predef.print(tmp9);
//│     tmp11 = "this.z = " + this.z;
//│     Predef.print(tmp11);
//│   }
//│   #x;
//│   #z;
//│   #z1;
//│   #x1;
//│   #y;
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Foo", [null, "y", null, "z", null]]; 
//│ });

Foo(10, 20, 30, 40, 50)
//│ JS (unsanitized):
//│ Foo7(10, 20, 30, 40, 50)
//│ > x = 1
//│ > y = 21
//│ > this.y = 20
//│ > z = 50
//│ > this.z = 40
//│ = Foo(_, 20, _, 40, _)


