:js


:sir
data class Foo()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @data define Foo⁰ as class Foo² { constructor Foo¹ }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// * Notice that `Foo¹` correctly refers to the ClassCtorSymbol of `Foo` shown above
:sir
Foo
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ return Foo¹
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun Foo { class: class Foo }

Foo()
//│ = Foo()

Foo.class
//│ = class Foo


:sir
object Foo with
  class C()
  print(C)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Foo³ as object Foo⁴ {
//│   constructor() {
//│     define C⁰ as class C² { constructor C¹ };
//│     do Predef⁰.print⁰(Foo⁴.this.C¹);
//│     end
//│   }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > fun C { class: class C }

// * The owner of the C¹ constructor function is correctly identified as Foo
:lot
Foo.C
//│ —————————————| Lowered IR Tree |————————————————————————————————————————————————————————————————————
//│ Program:
//│   main = Return of Select{sym=term:Foo⁴/C¹}:
//│     qual = MemberRef{disamb=object:Foo⁴}:
//│       bms = member:Foo³
//│       disamb = object:Foo⁴
//│     name = Ident of "C"
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun C { class: class C }


data class Foo(a)

Foo
//│ = fun Foo { class: class Foo }

Foo(1)
//│ = Foo(1)

Foo(1).a
//│ = 1

fun foo(y) = Foo(y)
foo(27)
//│ = Foo(27)


data class Foo(a, b)

let foo = Foo
//│ foo = fun Foo { class: class Foo }

let f = foo(1, 2)
//│ f = Foo(1, 2)

let f = new! foo(1, 2)
//│ f = Foo(1, 2)

f.a
//│ = 1

f.b
//│ = 2

let f = Foo(1, 2)
//│ f = Foo(1, 2)

f.a
//│ = 1

f.b
//│ = 2

Foo(print(1), print(2))
//│ > 1
//│ > 2
//│ = Foo((), ())


data class Inner(c) with
  fun i1(d) = c + d
  print(c)

let i = new Inner(100)
//│ > 100
//│ i = Inner(100)

i.i1(20)
//│ = 120


// * This is strange, but does not need to be an error
:sjs
class Foo(x, val y, z, val z, z) with
  let x = 1
  let y += 1
  print("x = " + x)
  print("y = " + y)
  print("this.y = " + this.y)
  print("z = " + z)
  print("this.z = " + this.z)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let Foo9;
//│ Foo9 = function Foo(x, y, z, z1, z2) {
//│   return globalThis.Object.freeze(new Foo.class(x, y, z, z1, z2));
//│ };
//│ (class Foo8 {
//│   static {
//│     Foo9.class = this
//│   }
//│   constructor(x, y, z, z1, z2) {
//│     let tmp3, tmp4, tmp5, tmp6, tmp7;
//│     this.y = y;
//│     this.z = z1;
//│     this.#z = z2;
//│     this.#x = 1;
//│     this.#y = this.y + 1;
//│     tmp3 = "x = " + this.#x;
//│     Predef.print(tmp3);
//│     tmp4 = "y = " + this.#y;
//│     Predef.print(tmp4);
//│     tmp5 = "this.y = " + this.y;
//│     Predef.print(tmp5);
//│     tmp6 = "z = " + this.#z;
//│     Predef.print(tmp6);
//│     tmp7 = "this.z = " + this.z;
//│     Predef.print(tmp7);
//│   }
//│   #z;
//│   #x;
//│   #y;
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Foo", [null, "y", null, "z", null]];
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

Foo(10, 20, 30, 40, 50)
//│ > x = 1
//│ > y = 21
//│ > this.y = 20
//│ > z = 50
//│ > this.z = 40
//│ = Foo(_, 20, _, 40, _)


:e
class Foo(val z, val z)
//│ ╔══[COMPILATION ERROR] Duplicate definition of member named 'z'.
//│ ╟── Defined at: 
//│ ║  l.170: 	class Foo(val z, val z)
//│ ║         	              ^
//│ ╟── Defined at: 
//│ ║  l.170: 	class Foo(val z, val z)
//│ ╙──       	                     ^

Foo(1, 2)
//│ = Foo(undefined, undefined)


