//│ };
//│ end


// `@untyped` reaches *every* shape of term, since the value is bound to a local declared at the top type.
// A bare reference is erased to `Unknown` just like the call above.
fun refUntyped(x: Int): Str = @untyped x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define refUntyped⁰ as fun refUntyped¹(x: Int⁰): Str⁰ {
//│   let tmp: Unknown;
//│   set tmp = x;
//│   return (tmp as! Str⁰)
//│ };
//│ end

:ge
fun refTyped(x: Int): Str = x
