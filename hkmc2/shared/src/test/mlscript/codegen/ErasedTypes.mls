
:global
:sir
:siret


// Note: Needed for `@tailrec`
open annotations
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end


// Erased types come only from explicit type annotations. An unannotated local - even one bound to a
// literal - carries no erased type.
fun main =
  let i = 1
  let f = 1.5
  let s = "str"
  let b = true
  let t = [i, s]
  let r = {x: i, y: s}
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define main⁰ as fun main¹(): ? {
//│   let i: ?, f: ?, s: ?, b: ?, t: ?, r: ?, x: ?, y: ?;
//│   set i = 1;
//│   set f = 1.5;
//│   set s = "str";
//│   set b = true;
//│   set t = [i, s];
//│   set x = i;
//│   set y = s;
//│   set r = { "x": x, "y": y };
//│   return runtime⁰.Unit⁰
//│ };
//│ end


// An annotated slot does carry one, whatever binds it: each `val` below is typed from its annotation, and
// so is the temporary the array literal spills into.
val i: Int = 1
val f: Num = 1.5
val s: Str = "str"
val b: Bool = true
val a: Array[Int] = [1, 2, 3]
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Array⁰;
//│ define i⁰ as val i¹: Int⁰ = 1;
//│ define f⁰ as val f¹: Num⁰ = 1.5;
//│ define s⁰ as val s¹: Str⁰ = "str";
//│ define b⁰ as val b¹: Bool⁰ = true;
//│ set tmp = [1, 2, 3];
//│ define a⁰ as val a¹: Array⁰ = tmp;
//│ end


// The `Array` erasure is shared by every annotated slot, so an array literal needs no cast into a
// parameter, result, or field of an array-annotated type. Only `Array` itself is annotated here: the
// element type is erased along with the rest.
fun firstOf(a: Array[Int]): Int = 0
firstOf([9])
class ArrBox(val arr: Array[Str])
val box: ArrBox = new ArrBox(["x"])
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Array⁰, tmp1: Array⁰, tmp2: ArrBox⁰;
//│ define firstOf⁰ as fun firstOf¹(a: Array⁰): Int⁰ {
//│   return 0
//│ };
//│ set tmp = [9];
//│ do firstOf¹(tmp);
//│ define ArrBox¹ as class ArrBox⁰ {
//│   val arr⁰: Array⁰;
//│   constructor ArrBox²(arr: Array⁰) {
//│     define arr⁰ as val arr¹: Array⁰ = arr;
//│     end
//│   }
//│ };
//│ set tmp1 = ["x"];
//│ set tmp2 = new ArrBox⁰(tmp1);
//│ define box⁰ as val box¹: ArrBox⁰ = tmp2;
//│ end


// The narrowing target must be a reference type: `Int` is not under `Object`, so narrowing to it would be
// an unrelated-types error rather than a cast.
class Boxed(v: Int)
fun mkObj(): Object = new Boxed(1)
val o: Object = mkObj()
val n: Boxed = o
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Object⁰;
//│ define mkObj⁰ as fun mkObj¹(): Object⁰ {
//│   return new Boxed⁰(1)
//│ };
//│ define Boxed¹ as class Boxed⁰ {
//│   private val v⁰: Int⁰;
//│   constructor Boxed²(v: Int⁰) {
//│     set Boxed⁰.this.v⁰ = v;
//│     end
//│   }
//│ };
//│ set tmp = mkObj¹();
//│ define o⁰ as val o¹: Object⁰ = tmp;
//│ define n⁰ as val n¹: Boxed⁰ = (o¹ as! Boxed⁰);
//│ end


// A `val` is a block member, so a reference to it is a `MemberRef` carrying its type on its `TermSymbol`.
// Reading one into a same-typed slot therefore takes no coercion: the call below lowers with no cast on the
// reference, so a typed reference that still coerced would be visible here.
fun takeInt(m: Int): Int = m
val vi: Int = 1
takeInt(vi)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define takeInt⁰ as fun takeInt¹(m: Int⁰): Int⁰ {
//│   return m
//│ };
//│ define vi⁰ as val vi¹: Int⁰ = 1;
//│ return takeInt¹(vi¹)


// A written `()` erases to `Unit` in every position - parameter, result and argument alike. The unit value
// lowers to `runtime.Unit`, which is itself typed, so passing it into a `()` slot takes no coercion.
fun retUnit(): () = ()
fun takesUnit(u: ()): () = u
fun passUnit(): () = takesUnit(())
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define retUnit⁰ as fun retUnit¹(): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define takesUnit⁰ as fun takesUnit¹(u: Unit⁰): Unit⁰ {
//│   return u
//│ };
//│ define passUnit⁰ as fun passUnit¹(): Unit⁰ { return takesUnit¹(runtime⁰.Unit⁰) };
//│ end


// Class parameters and `val` fields keep their annotations - the private backing field, the public field and
// the constructor parameter alike.
class Foo(x: Int)
class Bar(val y: Str)
fun main =
  let foo = new Foo(123)
  let bar = new Bar("hi")
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define main² as fun main³(): ? {
//│   let foo: ?, bar: ?;
//│   set foo = new Foo⁰(123);
//│   set bar = new Bar⁰("hi");
//│   return runtime⁰.Unit⁰
//│ };
//│ define Foo¹ as class Foo⁰ {
//│   private val x⁰: Int⁰;
//│   constructor Foo²(x: Int⁰) {
//│     set Foo⁰.this.x⁰ = x;
//│     end
//│   }
//│ };
//│ define Bar¹ as class Bar⁰ {
//│   val y⁰: Str⁰;
//│   constructor Bar²(y: Str⁰) { define y⁰ as val y¹: Str⁰ = y; end }
//│ };
//│ end


// An unannotated parameter is `?`, so the call may pass anything; the narrowing lands where the value reaches
// a typed slot instead - here on the constructor argument.
fun mk(a) = new Bar(a)
fun main =
  let made = mk(1)
  made.y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define mk⁰ as fun mk¹(a: ?): ? {
//│   return new Bar⁰((a as! Str⁰))
//│ };
//│ define main⁴ as fun main⁵(): ? { let made: ?; set made = mk¹(1); return made.y﹖ };
//│ end


// A result annotation is checked against the body, and `Str` is unrelated to `Int`, so this is an error rather
// than a cast. The definition is still lowered - uncast - so the blocks after it keep compiling.
:ge
fun test(x: Int): Int = "oops"
//│ ═══[COMPILATION ERROR] Cannot use a value of type 'Str' at an unrelated type 'Int'
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define test⁰ as fun test¹(x: Int⁰): Int⁰ { return "oops" }; end


// The return coercion is what an annotated result buys. `(+)` is a builtin and carries no erased type, so
// `add2` narrows its result to `Int` while `add1`, having nothing to narrow to, leaves it alone.
fun add1(x: Int, y: Int) = x + y
fun add2(x: Int, y: Int): Int = x + y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define add1⁰ as fun add1¹(x: Int⁰, y: Int⁰): ? {
//│   return +⁰(x, y)
//│ };
//│ define add2⁰ as fun add2¹(x: Int⁰, y: Int⁰): Int⁰ { return (+⁰(x, y) as! Int⁰) };
//│ end


// A parameter keeps its annotated type regardless of a later reassignment.
fun keep(x: Int) =
  set x = 5
  x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define keep⁰ as fun keep¹(x: Int⁰): ? { set x = 5; return x }; end


// One class, four facets of the same rule:
//
// - `put` - a `mut val` field keeps its annotation, so a write through an unannotated parameter narrows at
//   the assignment rather than at the call;
// - `get` - reading the field back needs no cast, since the selection carries the member's type. The result
//   annotation is what makes that observable: without it the golden is identical either way;
// - `twice` - an annotated method result narrows the `(+)` call, exactly as the top-level `add2` does above;
// - `whatever` - an unannotated one has nothing to narrow to.
class Cell(mut val v: Int) with
  fun put(x) = set v = x
  fun get(): Int = v
  fun twice(x: Int): Int = x + x
  fun whatever(a) = a
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Cell⁰ as class Cell² {
//│   val v¹: Int⁰;
//│   constructor Cell¹(v: Int⁰) {
//│     define v¹ as val v²: Int⁰ = v;
//│     end
//│   }
//│   method put⁰ = fun put¹(x: ?): ? {
//│     set Cell².this.v² = (x as! Int⁰);
//│     return runtime⁰.Unit⁰
//│   }
//│   method get⁰ = fun get¹(): Int⁰ {
//│     return Cell².this.v²
//│   }
//│   method twice⁰ = fun twice¹(x: Int⁰): Int⁰ {
//│     return (+⁰(x, x) as! Int⁰)
//│   }
//│   method whatever⁰ = fun whatever¹(a: ?): ? { return a }
//│ };
//│ end


// A rest parameter has no annotation to erase, so both it and the list it binds stay `?`.
fun rest(a, ...xs) = xs
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define rest⁰ as fun rest¹(a: ?, ...xs: ?): ? { return xs }; end


// Closure capture (`:lift`): the captured local `n` is unannotated, so the generated capture class and its
// field have no type to inherit and stay `: ?`. The next block is the same shape with an annotated local.
:lift
fun counter(x: Int) =
  let n = 0
  fun bump() = set n = n + x
  bump()
  n
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let bump, Capture$scope0;
//│ define Capture$scope0 as class Capture$scope0¹ {
//│   constructor Capture$scope0⁰(n$0: ?) {
//│     define n$0⁰ as val n$0¹: ? = n$0;
//│     end
//│   }
//│ };
//│ define bump as fun bump⁰(scope0$cap: Capture$scope0¹, x: Int⁰): ? {
//│   let tmp: ?;
//│   set tmp = +⁰(scope0$cap.n$0¹, x);
//│   set scope0$cap.n$0¹ = tmp;
//│   return runtime⁰.Unit⁰
//│ };
//│ define counter⁰ as fun counter¹(x: Int⁰): ? {
//│   let n: ?, scope0$cap: Capture$scope0¹;
//│   set scope0$cap = new mut Capture$scope0¹(n);
//│   set scope0$cap.n$0¹ = 0;
//│   do bump⁰(scope0$cap, x);
//│   return scope0$cap.n$0¹
//│ };
//│ end


// When the captured slot keeps a definite erased type (the parameter `x` is annotated `Int`),
// the generated capture field inherits it: both the constructor parameter `x$0` and the
// `val x$0` field are typed `Int`, and the auxiliary parameter of the lifted function is
// typed as well. Without this, the capture class is untyped and the field reads are `?`.
:lift
fun resetCounter(x: Int): Int =
  fun reset() = set x = x + 1
  reset()
  x
resetCounter(41)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let reset, Capture$resetCounter;
//│ define reset as fun reset⁰(resetCounter$cap: Capture$resetCounter⁰): ? {
//│   let tmp: ?;
//│   set tmp = +⁰(resetCounter$cap.x$0⁰, 1);
//│   set resetCounter$cap.x$0⁰ = (tmp as! Int⁰);
//│   return runtime⁰.Unit⁰
//│ };
//│ define Capture$resetCounter as class Capture$resetCounter⁰ {
//│   constructor Capture$resetCounter¹(x$0: Int⁰) {
//│     define x$0¹ as val x$0⁰: Int⁰ = x$0;
//│     end
//│   }
//│ };
//│ define resetCounter⁰ as fun resetCounter¹(x: Int⁰): Int⁰ {
//│   let resetCounter$cap: Capture$resetCounter⁰;
//│   set resetCounter$cap = new mut Capture$resetCounter⁰(x);
//│   do reset⁰(resetCounter$cap);
//│   return resetCounter$cap.x$0⁰
//│ };
//│ return resetCounter¹(41)


// `Int` and `Int32` are both represented as host primitives, so both are *siblings* of `Object` rather than
// descendants of it: neither direction is a widening or a narrowing, and all four crossings below are
// rejected. What separates the two is the fifth error: an `Int` is boxed and still reaches the top type,
// while an `Int32` cannot - so returning `Int32` from `f`, whose result is unannotated and therefore
// `Unknown`, is rejected where returning an `Int` would not be.
:ge
fun useObj(o: Object) = o
fun useInt(n: Int) = n
fun useInt32(n: Int32): Int32 = n
fun f(o: Object, i: Int, x: Int32) =
  useObj(i)
  useInt(o)
  useObj(x)
  useInt32(o)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int' at an unrelated type 'Object'
//│ ║  l.324: 	  useObj(i)
//│ ╙──       	         ^
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Object' at an unrelated type 'Int'
//│ ║  l.325: 	  useInt(o)
//│ ╙──       	         ^
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int32' at an unrelated type 'Object'
//│ ║  l.326: 	  useObj(x)
//│ ╙──       	         ^
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Object' at an unrelated type 'Int32'
//│ ║  l.327: 	  useInt32(o)
//│ ╙──       	           ^
//│ ═══[COMPILATION ERROR] Cannot use a value of type 'Int32' at an unrelated type 'Unknown'
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useObj⁰ as fun useObj¹(o: Object⁰): ? {
//│   return o
//│ };
//│ define useInt⁰ as fun useInt¹(n: Int⁰): ? {
//│   return n
//│ };
//│ define useInt32⁰ as fun useInt32¹(n: Int32): Int32 {
//│   return n
//│ };
//│ define f² as fun f³(o: Object⁰, i: Int⁰, x: Int32): ? {
//│   do useObj¹(i);
//│   do useInt¹(o);
//│   do useObj¹(x);
//│   return useInt32¹(o)
//│ };
//│ end


// Similar to the above test case, but passing `Int32` into `Anything` instead of `Object`.
:ge
fun id(x: Anything) = ()
fun f(x: Int32) = id(x)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int32' at an unrelated type 'Unknown'
//│ ║  l.363: 	fun f(x: Int32) = id(x)
//│ ╙──       	                     ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define id⁰ as fun id¹(x: Unknown): ? {
//│   return runtime⁰.Unit⁰
//│ };
//│ define f⁴ as fun f⁵(x: Int32): ? { return id¹(x) };
//│ end


// Passing `Int31` or `Int` to `id(Anything)` is legal, since `Anything` erases to `Unknown` (which is the top type
// for all reference types). `f3` shows the same erasure in result position: `Anything` becomes `Unknown`, not
// `AnyRef(_, Anything)` - which would have printed as `Anything⁰`.
fun f1(x: Int31) = id(x)
fun f2(x: Int) = id(x)
fun f3(x: Anything): Anything = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define f1⁰ as fun f1¹(x: Int31⁰): ? {
//│   return id¹(x)
//│ };
//│ define f2⁰ as fun f2¹(x: Int⁰): ? {
//│   return id¹(x)
//│ };
//│ define f3⁰ as fun f3¹(x: Unknown): Unknown { return x };
//│ end


// Two classes that merely share a name are unrelated: the `Shape` nested in `Encl` shadows the outer one, so
// `bad` passes an `Encl.Shape` where the outer `Shape` is declared. The diagnostic qualifies both by owner,
// which is the only thing distinguishing them in the message.
:ge
class Shape
fun useShape(x: Shape) = x
module Encl with
  class Shape
  fun bad(x: Shape) = useShape(x)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Encl.Shape' at an unrelated type 'Shape'
//│ ║  l.400: 	  fun bad(x: Shape) = useShape(x)
//│ ╙──       	                               ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useShape⁰ as fun useShape¹(x: Shape⁰): ? {
//│   return x
//│ };
//│ define Shape¹ as class Shape⁰;
//│ define Encl⁰ as class Encl¹
//│ module Encl² {
//│   constructor {
//│     define Shape² as class Shape³;
//│     end
//│   }
//│   method bad⁰ = fun bad¹(x: Shape³): ? { return useShape¹(x) }
//│ };
//│ end


// `Int31 <: Int`, so widening is free while narrowing back to `Int31` takes a checked cast.
fun useInt31(n: Int31) = n
fun g(i: Int, i31: Int31) =
  useInt(i31)
  useInt31(i)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useInt31⁰ as fun useInt31¹(n: Int31⁰): ? {
//│   return n
//│ };
//│ define g⁰ as fun g¹(i: Int⁰, i31: Int31⁰): ? {
//│   do useInt¹(i31);
//│   return useInt31¹((i as! Int31⁰))
//│ };
//│ end


// Aliases are resolved at cast sites, so passing between `Foo` and `FooAlias` - or down a chain - is free.
// The erased type itself keeps the alias symbol and resolves it lazily, but `print` canonicalizes every erased type
// before rendering, so an alias always prints as its target.
class Foo(x: Int)
type FooAlias = Foo
type MyInt = Int
type MyInt2 = MyInt
val w: MyInt2 = 2
fun narrow(f: FooAlias): Foo = f
fun widen(f: Foo): FooAlias = f
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define narrow⁰ as fun narrow¹(f: Foo³): Foo³ {
//│   return f
//│ };
//│ define widen⁰ as fun widen¹(f: Foo³): Foo³ {
//│   return f
//│ };
//│ define Foo⁴ as class Foo³ {
//│   private val x¹: Int⁰;
//│   constructor Foo⁵(x: Int⁰) { set Foo³.this.x¹ = x; end }
//│ };
//│ define w⁰ as val w¹: Int⁰ = 2;
//│ end


// An alias to a primitive resolves the same way - notably without raising the `Unrelated` error a primitive
// mismatch would.
fun useI32(n: Int32): Int32 = n
type MyI32 = Int32
fun useMyI32(x: MyI32): Int32 = useI32(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useI32⁰ as fun useI32¹(n: Int32): Int32 {
//│   return n
//│ };
//│ define useMyI32⁰ as fun useMyI32¹(x: Int32): Int32 { return useI32¹(x) };
//│ end


// An alias whose right-hand side does not resolve to a single type symbol behaves as the top type during
// hierarchy analysis. A cycle is such a case; a union is not, since it erases to its members' LUB.
type Cyclic = Cyclic
class P
class Q
type Union = P | Q
fun useCyclic(x: Cyclic): Cyclic = x
fun useUnion(x: Union): Union = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useCyclic⁰ as fun useCyclic¹(x: Unknown): Unknown {
//│   return x
//│ };
//│ define useUnion⁰ as fun useUnion¹(x: Object⁰): Object⁰ {
//│   return x
//│ };
//│ define P⁰ as class P¹;
//│ define Q⁰ as class Q¹;
//│ end


// A union that already contains its own upper bound collapses to it, and casts are then decided against the
// collapsed type: `A | B | Base` and `A | B` both erase to `Base`, so only `A | B -> A` is a downcast.
class Base
class A extends Base
class B extends Base
fun threeOf(x: A | B | Base): Int = 0
fun takesBase(b: Base): () = ()
fun takesUnion(u: A | B): () = ()
fun takesSubtype(a: A): () = ()
fun unionIntoBase(x: A | B) = takesBase(x)
fun memberIntoUnion(a: A) = takesUnion(a)
fun baseIntoUnion(b: Base) = takesUnion(b)
fun unionIntoSubtype(x: A | B) = takesSubtype(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define threeOf⁰ as fun threeOf¹(x: Base⁰): Int⁰ {
//│   return 0
//│ };
//│ define takesBase⁰ as fun takesBase¹(b: Base⁰): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define takesUnion⁰ as fun takesUnion¹(u: Base⁰): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define takesSubtype⁰ as fun takesSubtype¹(a: A⁰): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define unionIntoBase⁰ as fun unionIntoBase¹(x: Base⁰): ? {
//│   return takesBase¹(x)
//│ };
//│ define memberIntoUnion⁰ as fun memberIntoUnion¹(a: A⁰): ? {
//│   return takesUnion¹(a)
//│ };
//│ define baseIntoUnion⁰ as fun baseIntoUnion¹(b: Base⁰): ? {
//│   return takesUnion¹(b)
//│ };
//│ define unionIntoSubtype⁰ as fun unionIntoSubtype¹(x: Base⁰): ? {
//│   return takesSubtype¹((x as! A⁰))
//│ };
//│ define Base¹ as class Base⁰;
//│ define A¹ as class A⁰ extends Base⁰ {};
//│ define B⁰ as class B¹ extends Base⁰ {};
//│ end


// The primitives are roots of the erased hierarchy, so a union mixing one with any distinct type - another
// primitive included - has no upper bound to erase to. Note that declaring such a slot is legal, only
// passing an argument into it is not. With a third member, the pair that *first* had no upper bound is the one
// kept, not the last one folded in.
fun mixed(x: Int32 | Str) = 0
fun twoPrims(x: Int32 | Int64) = 0
fun mixedThree(x: Int32 | Str | Bool) = 0
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define mixed⁰ as fun mixed¹(x: ‹incompatible(Int32, Str⁰)›): ? {
//│   return 0
//│ };
//│ define twoPrims⁰ as fun twoPrims¹(x: ‹incompatible(Int32, Int64)›): ? {
//│   return 0
//│ };
//│ define mixedThree⁰ as fun mixedThree¹(x: ‹incompatible(Int32, Str⁰)›): ? { return 0 };
//│ end


// The error lands where a value crosses the slot, not where the type is written: the LUB is computed inside
// `canonicalize`, which cannot report anything.
:ge
fun intoMixed(n: Int32) = mixed(n)
//│ ╔══[COMPILATION ERROR] Types 'Int32' and 'Str' have no common representation
//│ ║  l.559: 	fun intoMixed(n: Int32) = mixed(n)
//│ ╙──       	                                ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define intoMixed⁰ as fun intoMixed¹(n: Int32): ? { return mixed¹(n) }; end


// Widening fails too: an unrepresentable value cannot enter an `Object` slot either. Both errors are
// unlocated - `returnedTerm` passes no location to `castTo`, a pre-existing gap that affects every return.
:ge
fun outOfMixed(x: Int32 | Str): Str = x
fun mixedIntoObject(x: Int32 | Str): Object = x
