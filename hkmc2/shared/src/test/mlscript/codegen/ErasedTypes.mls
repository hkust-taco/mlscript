//│ end

:ge
fun selTyped(): Int = Plain.f
//│ ═══[COMPILATION ERROR] Cannot use a value of type 'Function' at an unrelated type 'Int'
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define selTyped⁰ as fun selTyped¹(): Int⁰ { return Plain².f⁶ }; end


// A lambda is disclaimed too: it reaches `LambdaRewriter` as the binding's RHS and is floated into a
// definition there, the same shaping any other residual lambda gets.
fun lamUntyped(): Int = @untyped ((x: Int) => x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define lamUntyped⁰ as fun lamUntyped¹(): Int⁰ {
//│   let tmp: Unknown, lambda;
//│   @private
//│   define lambda as fun lambda⁴(x: Int⁰): ? {
//│     return x
//│   };
//│   set tmp = lambda⁴;
//│   return (tmp as! Int⁰)
//│ };
//│ end


// The simplifier propagates a cast literal to its use sites as the whole `Cast` node; the price is that a
// `Cast` now sits between a literal and its consumers, so a consumer that wants the literal has to look
// through it.
// The two sites below are where that is a correctness matter: without the look-through they emit `42.whoami`
// and `42.length`, which are syntax errors - the `.` parses as a decimal point.
:js
class Wrapper with
  val whoami = "wrapper"
fun fortyTwo = 42
fun asWrapper(x: Wrapper): Wrapper = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define fortyTwo⁰ as fun fortyTwo¹(): ? {
//│   return 42
//│ };
//│ define asWrapper⁰ as fun asWrapper¹(x: Wrapper⁰): Wrapper⁰ {
//│   return x
//│ };
//│ define Wrapper¹ as class Wrapper⁰ {
//│   val whoami⁰: ?;
//│   constructor() { define whoami⁰ as val whoami¹: ? = "wrapper"; end }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// A cast literal as a property-access receiver.
:noCheckCasts
:js
:sjs
asWrapper(fortyTwo).whoami
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: ?, tmp1: Wrapper⁰;
//│ set tmp = fortyTwo¹();
//│ set tmp1 = asWrapper¹((tmp as!! Wrapper⁰));
//│ return tmp1.whoami¹
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ return (42).whoami
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// A cast literal as a tuple-pattern scrutinee, whose test reads `.length` off it.
:noCheckCasts
:js
:sjs
if asWrapper(fortyTwo) is
  [a, b] then "pair"
  else "other"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut: ?, a: ?, b: ?, element1$: ?, element0$: ?, tmp: ?;
//│ set tmp = fortyTwo¹();
//│ set scrut = asWrapper¹((tmp as!! Wrapper⁰));
//│ match scrut
//│   Array(2) =>
//│     set element0$ = runtime⁰.Tuple⁰.get²(scrut, 0);
//│     set element1$ = runtime⁰.Tuple⁰.get²(scrut, 1);
//│     set b = element1$;
//│     set a = element0$;
//│     return "pair"
//│   else
//│     return "other"
//│ end
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (runtime.Tuple.isArrayLike(42) && (42).length === 2) {
//│   runtime.Tuple.get(42, 0);
//│   runtime.Tuple.get(42, 1);
//│   return "pair"
//│ }
//│ return "other";
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "other"


// A lifted function that refers to the enclosing class's `this` receives it as an auxiliary parameter. That parameter
// stands for the same slot as the `this` passed into it, so it takes the enclosing class's type.
:lift
class Box(content: Int) with
  fun unwrap() =
    fun peek() = this
    peek()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let peek;
//│ define peek as fun peek⁰(Box: Box⁰): ? {
//│   return Box
//│ };
//│ define Box¹ as class Box⁰ {
//│   private val content⁰: Int⁰;
//│   constructor Box²(content: Int⁰) {
//│     set Box⁰.this.content⁰ = content;
//│     end
//│   }
//│   method unwrap⁰ = fun unwrap¹(): ? { return peek⁰(Box⁰.this) }
//│ };
//│ end


// The same holds for a local `object` reached by name: the lifted function receives the object's symbol as an
// auxiliary parameter, typed with the object's own type.
:w
:lift
fun tagged(x: Int) =
  object Tag with
    fun label() = "tag"
  fun describe() = Tag.label()
  describe()
//│ ╔══[WARNING] Objects are not yet lifted.
//│ ║  l.1251: 	  object Tag with
//│ ╙──        	         ^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let describe;
//│ define describe as fun describe⁰(Tag: Tag⁰): ? {
//│   return Tag.label⁰()
//│ };
//│ define tagged⁰ as fun tagged¹(x: Int⁰): ? {
//│   let Tag;
//│   define Tag as object Tag⁰ {
//│     method label¹ = fun label⁰(): ? { return "tag" }
//│   };
//│   return describe⁰(Tag⁰)
//│ };
//│ end


// A lifted *class* takes its passed locals as constructor parameters and private fields, which are typed the same way.
:w
:lift
fun mk() =
  object Tag with
    fun label() = "tag"
  class Holder with
    fun get() = Tag.label()
  new Holder
//│ ╔══[WARNING] Objects are not yet lifted.
//│ ║  l.1277: 	  object Tag with
//│ ╙──        	         ^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let Holder;
//│ define Holder as class Holder⁰ {
//│   private val Tag¹: Tag²;
//│   constructor(Tag: Tag²) {
//│     set Holder⁰.this.Tag¹ = Tag;
//│     end
//│   }
//│   method get³ = fun get⁴(): ? {
//│     return Holder⁰.this.Tag¹.label²()
//│   }
//│ };
//│ define mk⁴ as fun mk⁵(): ? {
//│   let Tag;
//│   define Tag as object Tag² {
//│     method label³ = fun label²(): ? { return "tag" }
//│   };
//│   return new Holder⁰(Tag²)
//│ };
//│ end


// A parameter captured by a nested definition is copied into the merged loop, so that the definition captures
// the parameter's value at that iteration rather than the slot the next iteration overwrites. The copy stands
// for the same slot as the parameter, so it takes the parameter's type.
:noInline
:soir
fun capturingLoop(n: Int, acc: Str) =
  if n <= 0 then acc
  else
    let g = () => acc
    let h = g
    capturingLoop(n - 1, h())
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define capturingLoop⁰ as fun capturingLoop¹(n: Int⁰, acc: Str⁰): ? {
//│   let scrut: ?, g: ?, h: ?, tmp: ?, tmp1: ?;
//│   set scrut = <=⁰(n, 0);
//│   match scrut
//│     true =>
//│       return acc
//│     else
//│       let g1;
//│       @private
//│       define g1 as fun g⁴(): ? {
//│         return acc
//│       };
//│       set g = g⁴;
//│       set h = g;
//│       set tmp = -⁰(n, 1);
//│       set tmp1 = h();
//│       return capturingLoop¹((tmp as! Int⁰), (tmp1 as! Str⁰))
//│   end
//│ };
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define capturingLoop⁰ as fun capturingLoop¹(n: Int⁰, acc: Str⁰): ? {
//│   loop loopLabel:
//│     let scrut: ?, tmp: ?, tmp1: ?, acc1: Str⁰;
//│     set acc1 = acc;
//│     set scrut = <=⁰(n, 0);
//│     match scrut
//│       true =>
//│         return acc1
//│       else
//│         let g;
//│         @private
//│         define g as fun g⁴(): ? {
//│           return acc1
//│         };
//│         set tmp = -⁰(n, 1);
//│         set tmp1 = g⁴();
//│         set n = (tmp as! Int⁰);
//│         set acc = (tmp1 as! Str⁰);
//│         continue loopLabel
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ end
