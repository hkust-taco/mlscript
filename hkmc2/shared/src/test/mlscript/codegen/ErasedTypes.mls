// Folding `sccF`'s tail call into the merged dispatcher loses its `as Int` coercion, and the loop can exit
// through `sccG`'s arm with a `Num`, so the cast is deferred to the exit.
:soir
fun sccF(): Int = sccG()
fun sccG(): Num = sccF() + 1
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define sccF⁰ as fun sccF¹(): Int⁰ {
//│   return (sccG⁰() as! Int⁰)
//│ };
//│ define sccG¹ as fun sccG⁰(): Num⁰ {
//│   let tmp: Int⁰;
//│   set tmp = sccF¹();
//│   return (+⁰(tmp, 1) as! Num⁰)
//│ };
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let sccF_sccG;
//│ @private
//│ define sccF_sccG as fun sccF_sccG⁰(id: Int⁰): Num⁰ {
//│   let sccF$deferred: Bool⁰;
//│   set sccF$deferred = false;
//│   loop loopLabel:
//│     match id
//│       0 =>
//│         set sccF$deferred = true;
//│         set id = 1;
//│         continue loopLabel
//│       1 =>
//│         let tmp: Int⁰, exitResult: Num⁰;
//│         set tmp = (sccF_sccG⁰(0) as! Int⁰);
//│         set exitResult = (+⁰(tmp, 1) as! Num⁰);
//│         match sccF$deferred
//│           true =>
//│             return (exitResult as! Int⁰)
//│           else
//│             return exitResult
//│         end
//│       else
//│         unreachable /* dispatch tag is always a merged member id */
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ @inline
//│ define sccF⁰ as fun sccF¹(): Int⁰ {
//│   return (sccF_sccG⁰(0) as! Int⁰)
//│ };
//│ @inline
//│ define sccG¹ as fun sccG⁰(): Num⁰ { return sccF_sccG⁰(1) };
//│ end


// Checks whether `annotLoop(n - 1)` still produces a tail call even though it is wrapped in a `Cast` node.
:soir
:js
@tailrec
fun annotLoop(n: Int): () = annotHelper(n)
fun annotHelper(n) = if n <= 0 then () else annotLoop(n - 1)
annotHelper(100000)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @tailrec
//│ define annotLoop⁰ as fun annotLoop¹(n: Int⁰): Unit⁰ {
//│   return (annotHelper⁰(n) as! Unit⁰)
//│ };
//│ define annotHelper¹ as fun annotHelper⁰(n: ?): ? {
//│   let scrut: ?, tmp: ?;
//│   set scrut = <=⁰(n, 0);
//│   match scrut
//│     true =>
//│       return runtime⁰.Unit⁰
//│     else
//│       set tmp = -⁰(n, 1);
//│       return annotLoop¹((tmp as! Int⁰))
//│   end
//│ };
//│ return annotHelper⁰(100000)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let annotLoop_annotHelper;
//│ @private
//│ define annotLoop_annotHelper as fun annotLoop_annotHelper⁰(id: Int⁰, param0: ?): ? {
//│   loop loopLabel:
//│     match id
//│       0 =>
//│         set id = 1;
//│         continue loopLabel
//│       1 =>
//│         let scrut: ?, tmp: ?;
//│         set scrut = <=⁰(param0, 0);
//│         match scrut
//│           true =>
//│             return runtime⁰.Unit⁰
//│           else
//│             set tmp = -⁰(param0, 1);
//│             set param0 = (tmp as! Int⁰);
//│             set id = 0;
//│             continue loopLabel
//│         end
//│       else
//│         unreachable /* dispatch tag is always a merged member id */
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ @inline @tailrec
//│ define annotLoop⁰ as fun annotLoop¹(n: Int⁰): Unit⁰ {
//│   return (annotLoop_annotHelper⁰(0, n) as! Unit⁰)
//│ };
//│ @inline
//│ define annotHelper¹ as fun annotHelper⁰(n: ?): ? {
//│   return annotLoop_annotHelper⁰(1, n)
//│ };
//│ return annotLoop_annotHelper⁰(1, 100000)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// Checks whether the let-bound tail call `r` still produces a tail call even though it is wrapped in a `Cast` node.
// A dropped return coercion is re-placed on the stub of the function that dropped it.
:soir
:js
@tailrec
fun sccLoop(n: Int): Int =
  let r = sccHelper(n)
  r
fun sccHelper(n: Int): Num = if n <= 0 then 0 else sccLoop(n - 1)
sccHelper(100000)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @tailrec
//│ define sccLoop⁰ as fun sccLoop¹(n: Int⁰): Int⁰ {
//│   let r: ?;
//│   set r = sccHelper⁰(n);
//│   return (r as! Int⁰)
//│ };
//│ define sccHelper¹ as fun sccHelper⁰(n: Int⁰): Num⁰ {
//│   let scrut: ?, tmp: ?;
//│   set scrut = <=⁰(n, 0);
//│   match scrut
//│     true =>
//│       return 0
//│     else
//│       set tmp = -⁰(n, 1);
//│       return sccLoop¹((tmp as! Int⁰))
//│   end
//│ };
//│ return sccHelper⁰(100000)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let sccLoop_sccHelper;
//│ @private
//│ define sccLoop_sccHelper as fun sccLoop_sccHelper⁰(id: Int⁰, param0: ?): Num⁰ {
//│   loop loopLabel:
//│     match id
//│       0 =>
//│         set id = 1;
//│         continue loopLabel
//│       1 =>
//│         let scrut: ?, tmp: ?;
//│         set scrut = <=⁰(param0, 0);
//│         match scrut
//│           true =>
//│             return 0
//│           else
//│             set tmp = -⁰(param0, 1);
//│             set param0 = (tmp as! Int⁰);
//│             set id = 0;
//│             continue loopLabel
//│         end
//│       else
//│         unreachable /* dispatch tag is always a merged member id */
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ @inline @tailrec
//│ define sccLoop⁰ as fun sccLoop¹(n: Int⁰): Int⁰ {
//│   return (sccLoop_sccHelper⁰(0, n) as! Int⁰)
//│ };
//│ @inline
//│ define sccHelper¹ as fun sccHelper⁰(n: Int⁰): Num⁰ {
//│   return sccLoop_sccHelper⁰(1, n)
//│ };
//│ return sccLoop_sccHelper⁰(1, 100000)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0


// A call is typed as the callee's result only when saturated: `curried(1)` supplies one of two declared
// parameter lists, so it is the residual function, not an `Int`.
fun curried(a: Int)(b: Int): Int = a + b
fun useFn(g: Function) = g(1)
useFn(curried(1))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Function⁰;
//│ define curried⁰ as fun curried¹(a: Int⁰)(b: Int⁰): Int⁰ {
//│   return (+⁰(a, b) as! Int⁰)
//│ };
//│ define useFn⁰ as fun useFn¹(g: Function⁰): ? {
//│   return g(1)
//│ };
//│ set tmp = curried¹(1);
//│ return useFn¹(tmp)

val done: Int = curried(1)(2)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Int⁰; set tmp = curried¹(1)(2); define done⁰ as val done¹: Int⁰ = tmp; end


// Counting lists must account for normalization: a `fun` with no parameter list keeps `Nil` in its
// signature, but lowering gives it one empty list and calls it with one empty argument list. `thunk()` is
// therefore saturated, and only the further `(2)` needs narrowing to `Int`.
fun thunk: Function = (b: Int) => b + 1
val over: Int = thunk(2)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Function⁰, tmp1: ?;
//│ define thunk⁰ as fun thunk¹(): Function⁰ {
//│   let lambda;
//│   @private
//│   define lambda as fun lambda⁰(b: Int⁰): ? {
//│     return +⁰(b, 1)
//│   };
//│   return (lambda⁰ as! Function⁰)
//│ };
//│ set tmp = thunk¹();
//│ set tmp1 = tmp(2);
//│ define over⁰ as val over¹: Int⁰ = (tmp1 as! Int⁰);
//│ end

// A saturated `thunk` keeps the type `Function`, so narrowing it to `Str` is an unrelated-types error.
:ge
val bad: Str = thunk
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Function' at an unrelated type 'Str'
//│ ║  l.808: 	val bad: Str = thunk
//│ ╙──       	               ^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Function⁰; set tmp = thunk¹(); define bad² as val bad³: Str⁰ = tmp; end


// *No* parameter list must stay distinct from *one empty* one: only the former is auto-invoked, so a bare
// `called` is the function itself rather than its result, and narrowing it to `Str` is likewise an error.
:ge
fun called() = 3
val notCalled: Str = called
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Function' at an unrelated type 'Str'
//│ ║  l.820: 	val notCalled: Str = called
//│ ╙──       	                     ^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define called⁰ as fun called¹(): ? {
//│   return 3
//│ };
//│ define notCalled⁰ as val notCalled¹: Str⁰ = called¹;
//│ end


// The two forms nonetheless agree on what they are *compiled to*: a source `fun` with no parameter list is
// given an implicitly-added empty one at block level, so it is lowered exactly like `called` above and its
// erased type says so. As a class-like member it instead becomes a getter, which has no parameter list at
// all - and it is that difference, not the source form, that the erased type has to follow.
fun localGetter: Int = 1
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define localGetter⁰ as fun localGetter¹(): Int⁰ { return 1 }; end

module M with
  fun memberGetter: Int = 1
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define M⁰ as class M¹ module M² { method memberGetter⁰ = fun memberGetter¹: Int⁰ { return 1 } }; end

fun useLocal: Int = localGetter
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useLocal⁰ as fun useLocal¹(): Int⁰ { return localGetter¹() }; end

fun useMember: Int = M.memberGetter
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useMember⁰ as fun useMember¹(): Int⁰ { return M².memberGetter¹ }; end

// Applying the getter applies its *result*, which its signature says nothing about, so the call is untyped
// and returning it from `: Int` needs a cast. Were the call read as the getter's own auto-invocation, this
// would silently take the getter's result type and the cast would be dropped.
fun callMember: Int = M.memberGetter()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define callMember⁰ as fun callMember¹(): Int⁰ { return (M².memberGetter¹() as! Int⁰) }; end


// An instantiation is typed as its class, so it cannot fill a primitive slot. Were the `Instantiate` type
// lost, this would silently become an ordinary downcast instead of the error below.
:ge
fun badInst() = useInt(new Bar("x"))
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Bar' at an unrelated type 'Int'
//│ ║  l.864: 	fun badInst() = useInt(new Bar("x"))
//│ ╙──       	                       ^^^^^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define badInst⁰ as fun badInst¹(): ? {
//│   let tmp: Bar⁰;
//│   set tmp = new Bar⁰("x");
//│   return useInt¹(tmp)
//│ };
//│ end


// A reference to a `fun` is already a function value, so returning one at `Function` takes no coercion. An
// instantiation is typed as its class instead, so the same annotation makes the coercion real.
fun test: Function = id
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define test² as fun test³(): Function⁰ { return id¹ }; end

fun test: Function = new Object
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define test⁴ as fun test⁵(): Function⁰ { return (new globalThis⁰.Object⁰() as! Function⁰) }; end


// A written arrow type erases to `Function` in every position it can be written - parameter, result and `val`
// alike - and the parameter and result shapes erase away with it. A lambda flowing into such a slot is cast
// into a `Function` on the way.
fun applyF(f: Int -> Int): Int = f(1)
applyF((x: Int) => x)
fun mk: Int -> Int = (x: Int) => x
val g: Int -> Int = (x: Int) => x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let lambda, lambda1;
//│ define applyF⁰ as fun applyF¹(f: Function⁰): Int⁰ {
//│   return (f(1) as! Int⁰)
//│ };
//│ define mk² as fun mk³(): Function⁰ {
//│   let lambda2;
//│   @private
//│   define lambda2 as fun lambda¹(x: Int⁰): ? {
//│     return x
//│   };
//│   return (lambda¹ as! Function⁰)
//│ };
//│ define lambda as fun lambda²(x: Int⁰): ? {
//│   return x
//│ };
//│ do applyF¹((lambda² as! Function⁰));
//│ define lambda1 as fun lambda³(x: Int⁰): ? {
//│   return x
//│ };
//│ define g² as val g³: Function⁰ = (lambda³ as! Function⁰);
//│ end


// The narrowing is what makes an arrow-annotated slot *typed*: without it this would pass as `Unknown`.
:ge
fun badFn() = applyF(42)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int' at an unrelated type 'Function'
//│ ║  l.921: 	fun badFn() = applyF(42)
//│ ╙──       	                     ^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define badFn⁰ as fun badFn¹(): ? { return applyF¹(42) }; end


// A `Str`-typed helper for the `declare fun` blocks below.
fun useStr(s: Str) = s
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useStr⁰ as fun useStr¹(s: Str⁰): ? { return s }; end


// A `declare`d function is never auto-invoked - `Lowering.ref` lowers the reference to a `globalThis`
// selection - so its arrows are *its own parameter lists*, and the chain's last component is its result.
declare fun addInts: (Int, Int) -> Int
fun useAdd() = useInt(addInts(1, 2))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useAdd⁰ as fun useAdd¹(): ? {
//│   let tmp: Int⁰;
//│   set tmp = globalThis⁰.addInts⁰(1, 2);
//│   return useInt¹(tmp)
//│ };
//│ end


// That result is genuinely typed, so a wrong use is rejected rather than silently accepted.
:ge
fun badAdd() = useStr(addInts(1, 2))
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int' at an unrelated type 'Str'
//│ ║  l.950: 	fun badAdd() = useStr(addInts(1, 2))
//│ ╙──       	                      ^^^^^^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define badAdd⁰ as fun badAdd¹(): ? {
//│   let tmp: Int⁰;
//│   set tmp = globalThis⁰.addInts⁰(1, 2);
//│   return useStr¹(tmp)
//│ };
//│ end


// An unparenthesized left-hand side is a single parameter, as in `declare fun log: Str -> Any`.
declare fun showInt: Int -> Str
fun useShow() = useStr(showInt(1))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useShow⁰ as fun useShow¹(): ? {
//│   let tmp: Str⁰;
//│   set tmp = globalThis⁰.showInt⁰(1);
//│   return useStr¹(tmp)
//│ };
//│ end


// Each arrow is a separate parameter list, so an under-applied call yields a function over those remaining.
// A local's slot holds an erased *value* type, which cannot carry them, so `useCurried`'s intermediate is
// only a `Function` and its final application still needs a cast.
declare fun curried: Int -> Int -> Int
fun useCurried() = useInt(curried(1)(2))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useCurried⁰ as fun useCurried¹(): ? {
//│   let callPrefix: Function⁰, tmp: ?;
//│   set callPrefix = globalThis⁰.curried²(1);
//│   set tmp = callPrefix(2);
//│   return useInt¹((tmp as! Int⁰))
//│ };
//│ end

fun usePartial() = useFn(curried(1))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define usePartial⁰ as fun usePartial¹(): ? {
//│   let tmp: Function⁰;
//│   set tmp = globalThis⁰.curried²(1);
//│   return useFn¹(tmp)
//│ };
//│ end


// A `declare`d function writing its own parameter lists keeps them, and its annotation is the result.
declare fun parseIt(s: Str, radix: Int): Int
fun useParse() = useInt(parseIt("1", 10))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useParse⁰ as fun useParse¹(): ? {
//│   let tmp: Int⁰;
//│   set tmp = globalThis⁰.parseIt⁰("1", 10);
//│   return useInt¹(tmp)
//│ };
//│ end


// A *non*-`declare`d `fun` writing no parameter lists is a getter: referencing it calls it, so its arrows
// are the *result*. Reading them as parameters would type `getFn` as `Int` when it yields a function.
fun getFn: Int -> Int
fun useGetFn() = useFn(getFn)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useGetFn⁰ as fun useGetFn¹(): ? {
//│   let tmp: Function⁰;
//│   set tmp = getFn⁰();
//│   return useFn¹(tmp)
//│ };
//│ end


// `@untyped` disclaims the callee's declared result, so the call erases to the top type and reaches a
// differently-typed slot as a checked downcast. This is what lets an interop body call a mistyped operator.
fun viaUntyped(x, y): Str = @untyped addInts(x, y)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define viaUntyped⁰ as fun viaUntyped¹(x: ?, y: ?): Str⁰ {
//│   let tmp: Unknown;
//│   set tmp = globalThis⁰.addInts⁰(x, y);
//│   return (tmp as! Str⁰)
//│ };
//│ end


// Without the annotation the same body is rejected - the guard rail doing its job.
:ge
fun viaTyped(x, y): Str = addInts(x, y)
//│ ═══[COMPILATION ERROR] Cannot use a value of type 'Int' at an unrelated type 'Str'
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define viaTyped⁰ as fun viaTyped¹(x: ?, y: ?): Str⁰ { return globalThis⁰.addInts⁰(x, y) }; end


// A member is reached by *selection*, which - unlike a bare reference - is never auto-invoked, so its
// signature is its own type.
module Plain with
  fun f: Int -> Int
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Plain⁰ as class Plain¹ module Plain²; end

declare module Ext with
  fun member: Int -> Int
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end


// Selecting the member yields the function value the signature describes.
fun useExt() = useFn(Ext.member)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useExt⁰ as fun useExt¹(): ? { return useFn¹(globalThis⁰.Ext⁰.member⁰) }; end

fun usePlain() = useFn(Plain.f)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define usePlain⁰ as fun usePlain¹(): ? { return useFn¹(Plain².f⁶) }; end


// *Applying* the selected member is a call on that function value, and since `Function` does not store its
// result types, a checked downcast is inserted at the use site.
fun applyExt() = useInt(Ext.member(1))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define applyExt⁰ as fun applyExt¹(): ? {
//│   let tmp: ?;
//│   set tmp = globalThis⁰.Ext⁰.member⁰(1);
//│   return useInt¹((tmp as! Int⁰))
//│ };
//│ end

fun applyPlain() = useInt(Plain.f(1))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define applyPlain⁰ as fun applyPlain¹(): ? {
//│   let tmp: ?;
//│   set tmp = Plain².f⁶(1);
//│   return useInt¹((tmp as! Int⁰))
//│ };
//│ end


// The bare-reference case *is* auto-invoked and keeps its result type; applying that result goes through a
// local, which carries no parameter lists to match.
fun applyGetFn() = useInt(getFn(1))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define applyGetFn⁰ as fun applyGetFn¹(): ? {
