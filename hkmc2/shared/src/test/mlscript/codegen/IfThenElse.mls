x => if x > 0 then log("Hi") else log("Bye")
//│ = [Function (anonymous)]

x => log(if true then "Hi" else "Bye")
//│ = [Function (anonymous)]

x => log(if x + 1 > 0 then "Hi" else "Bye")
//│ = [Function (anonymous)]

x =>
  let str = concat(if x + 1 > 0 then "Hello" else "Bye", "World")
  log(str)
//│ = [Function (anonymous)]


fun f(x, y) =
  if x
    then y

f(true, 42)
//│ = 42

:re
f(false, 42)
//│ ═══[RUNTIME ERROR] Error: match error


fun f(x, y, z) = if x then y else z

f(true, 0, 1)
//│ = 0


fun f(x, y, z) =
  if x
    then y
    else z

f(true, 1, 0)
//│ = 1

f(false, 1, 0)
//│ = 0


if true then
  100
//│ = 100

if true then
  100
else
  0
//│ = 100

if true then
  100
else
  fun f(x) = x
  f(3)
//│ = 100

if true then
  fun f(x) = x
  f(3)
else
  100
//│ = 3


