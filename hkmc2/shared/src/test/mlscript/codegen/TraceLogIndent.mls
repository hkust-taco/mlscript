:traceJS
fun g(z) =
  if
    z == 0 then throw Error("oops")
    z == 1 then 0
    z > 0 then g(z - 1)
fun f(x, y)(z) =
  x + y + g(z)

:re
f(1,2)(0)
//│ ═══[RUNTIME ERROR] Error: oops


f(1,1)(1)
//│ > calling: f(1, 1)
//│ > return: [Function: traceLogRes]
//│ > calling: [arrow function](1)
//│ > | calling: g(1)
//│ > | return: 0
//│ > return: 2
//│ = 2

