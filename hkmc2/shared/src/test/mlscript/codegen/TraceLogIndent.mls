:js

fun plus(x, y) = x + y

:traceJS
fun g(z) =
  if
    z < -1 then g(z + 1)
    z == -1 then 42
    z == 0 then plus(0)
    z > 0 then g(z - 1)

fun f(x, y)(z) =
  x + y + g(z)

:traceJS
fun h(x) =
  f(1,2)(x)


:re
h(3)
//│ ═══[RUNTIME ERROR] Error: Function 'plus' expected 2 arguments but got 1

h(-2)
//│ > | | | | | calling: h(-2)
//│ > | | | | | | calling: g(-2)
//│ > | | | | | | | calling: g(-1)
//│ > | | | | | | | return: 42
//│ > | | | | | | return: 42
//│ > | | | | | return: 45
//│ = 45

f(1,1)(-2)
//│ > | | | | | calling: g(-2)
//│ > | | | | | | calling: g(-1)
//│ > | | | | | | return: 42
//│ > | | | | | return: 42
//│ = 44

:re
f(1,2)(3)
//│ ═══[RUNTIME ERROR] Error: Function 'plus' expected 2 arguments but got 1

f(1,2)(-3)
//│ > | | | | | | | | | calling: g(-3)
//│ > | | | | | | | | | | calling: g(-2)
//│ > | | | | | | | | | | | calling: g(-1)
//│ > | | | | | | | | | | | return: 42
//│ > | | | | | | | | | | return: 42
//│ > | | | | | | | | | return: 42
//│ = 45

