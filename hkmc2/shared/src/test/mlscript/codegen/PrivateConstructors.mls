class Bar with
  private constructor
    Baz
  fun foo = 42
//│ ╔══[WARNING] This annotation has no effect
//│ ║  l.46: 	  private constructor
//│ ║        	  ^^^^^^^
//│ ╟── Annotations are not supported on constructor terms.
//│ ║  l.46: 	  private constructor
//│ ║        	          ^^^^^^^^^^^
//│ ║  l.47: 	    Baz
//│ ╙──      	^^^^^^^

:expect 42
(new Bar).foo
//│ = 42

