// * Other references to the class do not access its constructor.

fun test(x) = x is Foo
fun test2(x: Foo) = x.x
fun test3 = Foo.class

:expect [true, 2]
[test(Foo.make(1)), test2(Foo.make(2))]
//│ = [true, 2]


// * Instantiating a class through a variable also accesses its constructor.

class Baz with
  private constructor

let cls = Baz
//│ cls = class Baz

:e
new cls
//│ ╔══[COMPILATION ERROR] Cannot access the private constructor of class 'Baz' outside the class
//│ ║  l.+1: 	new cls
//│ ║        	^^^^^^^
//│ ╟── private constructor declared here
//│ ║  l.XX: 	  private constructor
//│ ╙──      	  ^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// * The constructor is private when any of its declarations is.

class Qux with
  private constructor(x)
  constructor(y)
  fun sum = x + y

:e
new Qux(1)(2)
//│ ╔══[COMPILATION ERROR] Cannot access the private constructor of class 'Qux' outside the class
//│ ║  l.+1: 	new Qux(1)(2)
//│ ║        	^^^^^^^^^^^^^
//│ ╟── private constructor declared here
//│ ║  l.XX: 	  private constructor(x)
//│ ╙──      	  ^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

data class Point(x, y) with
  private constructor
module Point with
  val origin = Point(0, 0)

:expect 0
if Point.origin is Point(px, py) then px + py
//│ = 0

:e
Point(1, 2)
