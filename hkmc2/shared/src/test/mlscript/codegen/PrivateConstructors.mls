// * Annotations on constructor declarations other than `private` are reported as unused.

:w
class Foo with
  declare constructor(x)
//│ ╔══[WARNING] This annotation has no effect
//│ ║  l.+2: 	  declare constructor(x)
//│ ║        	  ^^^^^^^
//│ ╟── Annotations are not supported on constructor terms.
//│ ║  l.+2: 	  declare constructor(x)
//│ ╙──      	          ^^^^^^^^^^^^^^

// * Constructors can only be declared directly in class bodies.

:e
:w
class Foo with
  fun foo =
    private constructor
    42
//│ ╔══[WARNING] This annotation has no effect
//│ ║  l.+3: 	    private constructor
//│ ║        	    ^^^^^^^
//│ ╟── Annotations are not supported on constructor terms.
//│ ║  l.+3: 	    private constructor
//│ ╙──      	            ^^^^^^^^^^^
