// * Annotations on constructor declarations must not apply to the statement that follows the constructor:
// * the members declared after the constructors below stay public.

declare class BigInt2 {
  private constructor()
  fun toString(...radix): Str
}

// * `toString` is called as a public method, not through a private accessor symbol.
:sjs
fun f(x: BigInt2) = x.toString(16)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f; f = function f(x) { return runtime.safeCall(x.toString(16)) };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// * Constructor blocks, which define sibling classes, do not support annotations.
:w
class Bar with
  private constructor
    Baz
  fun foo = 42
//│ ╔══[WARNING] This annotation has no effect
//│ ║  l.+2: 	  private constructor
//│ ║        	  ^^^^^^^
//│ ╟── Annotations are not supported on constructor terms.
//│ ║  l.+2: 	  private constructor
//│ ║        	          ^^^^^^^^^^^
//│ ║  l.+3: 	    Baz
//│ ╙──      	^^^^^^^

:expect 42
new Bar().foo
//│ = 42

// * The annotation is ignored, but the constructors of the block are still defined.
:expect true
(new Baz) is Bar
//│ = true

:e
:w
module M with
  private constructor(x)
  fun foo = 42
//│ ╔══[WARNING] This annotation has no effect
//│ ║  l.+2: 	  private constructor(x)
//│ ║        	  ^^^^^^^
//│ ╟── Annotations are not supported on constructor terms.
//│ ║  l.+2: 	  private constructor(x)
//│ ╙──      	          ^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] 'constructor(...)' declarations are only allowed in class bodies
//│ ║  l.+2: 	  private constructor(x)
//│ ╙──      	          ^^^^^^^^^^^^^^

:expect 42
M.foo
//│ = 42


// * A `private` modifier on a constructor declaration, which may or may not add parameter lists,
// * makes the class's constructor private. All the parameter lists of a class form a single
// * constructor, which is then only accessible from within the class and its companion.

:sr
class Foo { private constructor }
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   class Foo⁰::Foo¹ @private constructor {  }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:e
new Foo
//│ ╔══[COMPILATION ERROR] Cannot access the private constructor of class 'Foo' outside the class
//│ ║  l.+1: 	new Foo
//│ ║        	^^^^^^^
//│ ╟── private constructor declared here
//│ ║  l.XX: 	class Foo { private constructor }
//│ ╙──      	            ^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:sr
class Foo { private constructor(val x) }
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   fun Foo² class Foo³::Foo⁴ @private constructor(val x⁰) { val x¹::x² ‹flow:x⁰› = x⁰^x² }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

