// * The class and its companion can access the constructor.

class Foo(val x) with
  private constructor
  fun withX(x) = Foo(x)
  fun withNewX(x) = new Foo(x)
module Foo with
  fun make(x) = Foo(x)
  fun makeNew(x) = new Foo(x)
  class Sub(y) extends Foo(y + 1)
  fun makeSub(y) = new Sub(y)
  val ctor = Foo

:expect [1, 2, 3, 4, 6]
[Foo.make(1).x, Foo.makeNew(2).x, Foo.make(0).withX(3).x, Foo.make(0).withNewX(4).x, Foo.makeSub(5).x]
//│ = [1, 2, 3, 4, 6]

// * A constructor function obtained from the companion can be called from anywhere.
:expect 1
Foo.ctor(1).x
//│ = 1

// * Referring to the constructor function, instantiating the class, and extending it access the constructor.

:e
let mk = Foo
//│ ╔══[COMPILATION ERROR] Cannot access the private constructor of class 'Foo' outside the class
//│ ║  l.+1: 	let mk = Foo
//│ ║        	         ^^^
//│ ╟── private constructor declared here
//│ ║  l.XX: 	  private constructor
//│ ╙──      	  ^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ mk = undefined

