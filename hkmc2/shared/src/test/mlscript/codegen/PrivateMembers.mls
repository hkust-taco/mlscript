:js


class Foo with
  private val x = 1
  private fun y() = x + 1
  fun z = y() + 1

let f = new Foo
//│ f = Foo

:re
f.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

:re
f.y()
//│ ═══[RUNTIME ERROR] TypeError: f.y is not a function

:expect 3
f.z
//│ = 3


object PrivateObject with
  private val x = 40
  private fun inc() = x + 2
  fun read = inc()
PrivateObject.read
//│ = 42

:lift
:expect 42
object LiftedPrivateObject with
  private fun inc(x) = x + 1
  fun mkInc = x => inc(x)
LiftedPrivateObject.mkInc(41)
//│ = 42

:e
PrivateObject.x
//│ ╔══[COMPILATION ERROR] Cannot access private member 'x' outside its declaring owner
//│ ║  l.41: 	PrivateObject.x
//│ ║        	             ^^
//│ ╟── private member declared here
//│ ║  l.26: 	  private val x = 40
//│ ╙──      	              ^

:e
PrivateObject.inc()
//│ ╔══[COMPILATION ERROR] Cannot access private member 'inc' outside its declaring owner
//│ ║  l.50: 	PrivateObject.inc()
//│ ║        	             ^^^^
//│ ╟── private member declared here
//│ ║  l.27: 	  private fun inc() = x + 2
//│ ╙──      	              ^^^
//│ ═══[RUNTIME ERROR] TypeError: PrivateObject1[inc$accessorSymbol1] is not a function
