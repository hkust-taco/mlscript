// A resource modifier in a contextual parameter list applies to the type it is written
// on, even when that type is not a bare identifier.

fun fc1(using rsc (C)) = 0
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define fc1⁰ as fun fc1¹(tmp: rsc C²): ? { return 0 }; end

// A spread parameter is named, so a modifier written on it is the parameter's.

:ge
fun fs1(using rsc ...a) = 0
//│ ╔══[COMPILATION ERROR] Resource modifiers apply to types, not to parameters.
