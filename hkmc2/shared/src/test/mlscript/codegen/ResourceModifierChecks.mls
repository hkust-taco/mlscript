//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Box⁰ as class Box² {
//│   val x⁴: C²;
//│   constructor Box¹(x: C²) { define x⁴ as val x⁵: C² = x; end }
//│ };
//│ end

:ge
fun fp(rsc x: C) = x
//│ ╔══[COMPILATION ERROR] Resource modifiers apply to types, not to parameters.
