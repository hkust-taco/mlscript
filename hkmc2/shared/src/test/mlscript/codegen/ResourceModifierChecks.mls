//│ ╙──       	                  ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define sig⁰ as fun sig¹(): rsc C² { return (C¹() as! rsc C²) }; end


// A resource modifier on a definition is rejected, and the definition compiles without it.

:ge
rsc class E()
