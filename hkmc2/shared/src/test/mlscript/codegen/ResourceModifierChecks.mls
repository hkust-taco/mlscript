// In a contextual parameter list a bare tree is the parameter's type, so a resource
// modifier written there belongs to the type rather than to the parameter.

fun fu1(using rsc C) = 0
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define fu1⁰ as fun fu1¹(tmp: rsc C²): ? { return 0 }; end

fun fu2(using x: rsc C) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define fu2⁰ as fun fu2¹(x: rsc C²): ? { return x }; end

// Naming the parameter after the modifier makes the whole tree the parameter's type,
// which is then rejected as a malformed type rather than as a misplaced modifier.

:ge
fun fu3(using rsc x: C) = 0
//│ ╔══[COMPILATION ERROR] Resource modifiers apply to types, not to parameters.
//│ ║  l.274: 	fun fu3(using rsc x: C) = 0
//│ ╙──       	              ^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define fu3⁰ as fun fu3¹(x: C²): ? { return 0 }; end

// Every resource modifier written on a parameter is reported separately.

:ge
fun fm(rsc rsc? x: C) = x
//│ ╔══[COMPILATION ERROR] Resource modifiers apply to types, not to parameters.
