// A type takes at most one resource modifier: a modifier within an outer modifier's reach
// is rejected. A function type ends the reach, as the outer modifier marks the function
// value.

:ge
fun q1(x: rsc rsc? C) = x
//│ ╔══[COMPILATION ERROR] A type takes at most one resource modifier.
//│ ║  l.72: 	fun q1(x: rsc rsc? C) = x
//│ ╙──      	                   ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define q1⁰ as fun q1¹(x: rsc? C²): ? { return x }; end

:ge
fun q2(x: rsc ((rsc C) | D)) = x
//│ ╔══[COMPILATION ERROR] A type takes at most one resource modifier.
//│ ║  l.80: 	fun q2(x: rsc ((rsc C) | D)) = x
//│ ╙──      	                    ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define q2⁰ as fun q2¹(x: rsc Object⁰): ? { return x }; end

fun q3(x: (rsc C) | D) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define q3⁰ as fun q3¹(x: rsc? Object⁰): ? { return x }; end

fun q4(x: rsc (C -> rsc D)) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define q4⁰ as fun q4¹(x: rsc Function⁰): ? { return x }; end


// Resource modifiers inside an intersection are not supported yet, as an intersection
