:sir
:siret

//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ import "..." as Predef; end

class C()
class D()
type I = Int32
type U = Int32 | C
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define C⁰ as class C² { constructor C¹ }; define D⁰ as class D² { constructor D¹ }; end


// A resource modifier applies to the types it reaches through unions. A
// primitive is never a resource, whether it is written directly or through an alias.

:ge
fun p1(x: rsc Int32): Int32 = x
//│ ╔══[COMPILATION ERROR] Primitive type 'Int32' cannot be a resource.
//│ ║  l.19: 	fun p1(x: rsc Int32): Int32 = x
//│ ╙──      	              ^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define p1⁰ as fun p1¹(x: Int32): Int32 { return x }; end

:w
fun p2(x: rsc? Int32): Int32 = x
//│ ╔══[WARNING] Primitive type 'Int32' is never a resource, so 'rsc?' has no effect.
//│ ║  l.27: 	fun p2(x: rsc? Int32): Int32 = x
//│ ╙──      	               ^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define p2⁰ as fun p2¹(x: Int32): Int32 { return x }; end

:ge
fun p3(x: rsc I): Int32 = x
//│ ╔══[COMPILATION ERROR] Primitive type 'Int32' cannot be a resource.
//│ ║  l.35: 	fun p3(x: rsc I): Int32 = x
//│ ╙──      	              ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define p3⁰ as fun p3¹(x: Int32): Int32 { return x }; end

:ge
fun p4(x: rsc U) = x
//│ ╔══[COMPILATION ERROR] Primitive type 'Int32' cannot be a resource.
//│ ║  l.43: 	fun p4(x: rsc U) = x
//│ ╙──      	              ^
//│ ═══[COMPILATION ERROR] Types 'Int32' and 'rsc C' have no common representation
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define p4⁰ as fun p4¹(x: ‹incompatible(Int32, rsc C²)›): ? { return x }; end

:ge
fun p5(x: rsc (C | Int32)) = x
