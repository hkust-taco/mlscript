// A resource modifier on a use of a type parameter applies as written: the parameter erases
// to the top type under that modifier. Nothing relates the type argument to it, so the
// argument itself has to fit the slot: a non-resource value does not, whatever the type argument.

fun rscIdentity[A](x: rsc A) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define rscIdentity⁰ as fun rscIdentity¹(x: rsc Unknown): ? { return x }; end

:ge
rscIdentity[Int32](1)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int' at an unrelated type 'rsc Unknown'
//│ ║  l.423: 	rscIdentity[Int32](1)
//│ ╙──       	                   ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ return rscIdentity¹(1)

fun rscMaybeIdentity[A](x: rsc? A) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define rscMaybeIdentity⁰ as fun rscMaybeIdentity¹(x: rsc? Unknown): ? { return x }; end

