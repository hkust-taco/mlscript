// `Int` is a class, not a primitive.

fun p6(x: rsc Int) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define p6⁰ as fun p6¹(x: rsc Int⁰): ? { return x }; end


// A type takes at most one resource modifier written directly on it. A modifier on a union's
// member combines with the outer one as a modifier inside an alias does: `rsc` overrides it,
// and `rsc?` keeps it, warning when every member is a resource. A function type ends the
// reach, as the outer modifier marks the function value.

:ge
fun q1(x: rsc rsc? C) = x
//│ ╔══[COMPILATION ERROR] A type takes at most one resource modifier.
//│ ║  l.73: 	fun q1(x: rsc rsc? C) = x
//│ ╙──      	                   ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define q1⁰ as fun q1¹(x: rsc C²): ? { return x }; end

fun q2(x: rsc ((rsc C) | D)) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define q2⁰ as fun q2¹(x: rsc Object⁰): ? { return x }; end

fun q3(x: (rsc C) | D) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define q3⁰ as fun q3¹(x: rsc? Object⁰): ? { return x }; end

fun q4(x: rsc (C -> rsc D)) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define q4⁰ as fun q4¹(x: rsc Function⁰): ? { return x }; end

fun q5(x: rsc ((rsc? C) | D)) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define q5⁰ as fun q5¹(x: rsc Object⁰): ? { return x }; end

fun q6(x: rsc? ((rsc C) | D)) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define q6⁰ as fun q6¹(x: rsc? Object⁰): ? { return x }; end

:w
fun q7(x: rsc? ((rsc C) | (rsc D))) = x
//│ ╔══[WARNING] Every member of this type is a resource, so 'rsc?' has no effect.
//│ ║  l.101: 	fun q7(x: rsc? ((rsc C) | (rsc D))) = x
//│ ╙──       	                     ^^^^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define q7⁰ as fun q7¹(x: rsc Object⁰): ? { return x }; end


