//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define fs1⁰ as fun fs1¹(...a: ?): ? { return 0 }; end


// A `val` parameter carries its modifier as a lifted annotation rather than a modifier
// tree, and names the parameter, so it is rejected in a contextual parameter list too.

:ge
class K(using c: C, rsc val x: C)
//│ ╔══[COMPILATION ERROR] Resource modifiers apply to types, not to parameters.
//│ ║  l.307: 	class K(using c: C, rsc val x: C)
//│ ╙──       	                    ^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define K⁰ as class K² {
//│   private val c⁰: C²;
//│   val x⁶: C²;
//│   constructor K¹(c: C², x: C²) { set K².this.c⁰ = c; define x⁶ as val x⁷: C² = x; end }
//│ };
//│ end


