:sir
:siret

//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ import "..." as Predef; end

class C()
class D()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define C⁰ as class C² { constructor C¹ }; define D⁰ as class D² { constructor D¹ }; end


// An alias may write resource modifiers on the types it denotes. Each member takes the one
// written on it, as in a signature.

type R = rsc C
type M = rsc? C
type X = (rsc C) | D
type Z = R
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end

fun r(x: R) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define r⁰ as fun r¹(x: rsc C²): ? { return x }; end

fun m(x: M) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define m⁰ as fun m¹(x: rsc? C²): ? { return x }; end

fun ux(x: X) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define ux⁰ as fun ux¹(x: rsc? Object⁰): ? { return x }; end

fun z(x: Z) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define z⁰ as fun z¹(x: rsc C²): ? { return x }; end


// A member that cannot be resolved (a recursive occurrence, a type parameter, or an alias
// without a definition) makes the alias erase to `Unknown`, but keeps the resource-ness
// of the members.

type T = (rsc C) | T
declare type Opaque
type O = rsc Opaque
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end

// A resource modifier on a use of a type parameter applies as written; the alias erases as
// described above, as the type parameter cannot be resolved.

type Rsc[A] = rsc A
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end

fun t(x: T) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define t⁰ as fun t¹(x: rsc? Unknown): ? { return x }; end

fun rs(x: Rsc[C]) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define rs⁰ as fun rs¹(x: rsc Unknown): ? { return x }; end

fun o(x: O) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define o⁰ as fun o¹(x: rsc Unknown): ? { return x }; end

fun rs2(x: Rsc[Int32]) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define rs2⁰ as fun rs2¹(x: rsc Unknown): ? { return x }; end

type T3 = (rsc C) | U3
type U3 = T3
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end

fun t3(x: U3) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define t3⁰ as fun t3¹(x: rsc? Unknown): ? { return x }; end

// Without modifiers, erasure is unchanged.

type T2 = T2 | C
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end

fun t2(x: T2) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define t2⁰ as fun t2¹(x: Unknown): ? { return x }; end

// A function type erases to `Function` on the right-hand side, as it does when written
// directly, including under a `forall` and as a member of a union.

type FnP = C -> C
fun fp(g: FnP) = g
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define fp⁰ as fun fp¹(g: Function⁰): ? { return g }; end

fun fpInline(g: C -> C) = g
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define fpInline⁰ as fun fpInline¹(g: Function⁰): ? { return g }; end

type FnR = rsc (C -> C)
fun ff(g: FnR) = g
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define ff⁰ as fun ff¹(g: rsc Function⁰): ? { return g }; end

fun ffInline(g: rsc (C -> C)) = g
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define ffInline⁰ as fun ffInline¹(g: rsc Function⁰): ? { return g }; end

type FnG = [A] -> (A) -> A
fun fg(g: rsc FnG) = g
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define fg⁰ as fun fg¹(g: rsc Function⁰): ? { return g }; end

type FnU = (rsc (C -> C)) | (C -> C)
fun fh(g: FnU) = g
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define fh⁰ as fun fh¹(g: rsc? Function⁰): ? { return g }; end


// A modifier on a reference to an alias combines with the ones written on its members, even
// through a chain of aliases: `rsc` overrides them, as it asserts that the whole type is a
// resource, while `rsc?` leaves a member's own modifier in place, warning when every member is
// a resource. The members are still erased to their LUB.

fun e9(x: rsc M) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e9⁰ as fun e9¹(x: rsc C²): ? { return x }; end

fun e14(x: rsc X) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e14⁰ as fun e14¹(x: rsc Object⁰): ? { return x }; end

fun e2(x: rsc? X) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e2⁰ as fun e2¹(x: rsc? Object⁰): ? { return x }; end

:w
fun e5(x: rsc? R) = x
//│ ╔══[WARNING] Every member of this type is a resource, so 'rsc?' has no effect.
//│ ║  l.142: 	fun e5(x: rsc? R) = x
//│ ╙──       	               ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e5⁰ as fun e5¹(x: rsc C²): ? { return x }; end

:w
type RM = rsc M
type MR = rsc? R
//│ ╔══[WARNING] Every member of this type is a resource, so 'rsc?' has no effect.
//│ ║  l.151: 	type MR = rsc? R
//│ ╙──       	               ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end

fun e10(x: RM) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e10⁰ as fun e10¹(x: rsc C²): ? { return x }; end

fun e11(x: MR) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e11⁰ as fun e11¹(x: rsc C²): ? { return x }; end

type P = C | D
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end

fun e7(x: rsc P) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e7⁰ as fun e7¹(x: rsc Object⁰): ? { return x }; end

// The rule leaves these unchanged: the same modifier on both sides, whether written directly
// or through a chain of aliases, and members that cannot be resolved.

fun e1(x: rsc R) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e1⁰ as fun e1¹(x: rsc C²): ? { return x }; end

fun e6(x: rsc Z) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e6⁰ as fun e6¹(x: rsc C²): ? { return x }; end

fun e3(x: rsc Rsc[C]) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e3⁰ as fun e3¹(x: rsc Unknown): ? { return x }; end

fun e4(x: rsc T) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e4⁰ as fun e4¹(x: rsc Unknown): ? { return x }; end


// The right-hand side of an alias is checked.

:ge
type P1 = rsc Int32
//│ ╔══[COMPILATION ERROR] Primitive type 'Int32' cannot be a resource.
//│ ║  l.197: 	type P1 = rsc Int32
//│ ╙──       	              ^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end

:w
type P2 = rsc? Int32
//│ ╔══[WARNING] Primitive type 'Int32' is never a resource, so 'rsc?' has no effect.
//│ ║  l.205: 	type P2 = rsc? Int32
//│ ╙──       	               ^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end

:ge
type P3 = rsc rsc? C
//│ ╔══[COMPILATION ERROR] A type takes at most one resource modifier.
//│ ║  l.213: 	type P3 = rsc rsc? C
//│ ╙──       	                   ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end

:ge
type P4 = (rsc C) & D
//│ ╔══[COMPILATION ERROR] Resource modifiers inside an intersection type are not supported yet.
//│ ║  l.221: 	type P4 = (rsc C) & D
//│ ╙──       	               ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end

// A modifier on an alias reference on the right-hand side combines the same way, including
// on a recursive occurrence of an alias that writes its own modifier.

type P5 = rsc R
fun e15(x: P5) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e15⁰ as fun e15¹(x: rsc C²): ? { return x }; end

type P6 = rsc P6 | C
fun e16(x: P6) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e16⁰ as fun e16¹(x: rsc? Unknown): ? { return x }; end

fun e18(x: rsc P6) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e18⁰ as fun e18¹(x: rsc Unknown): ? { return x }; end

type P7 = rsc P8 | C
type P8 = rsc P7 | D
fun e17(x: P7) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e17⁰ as fun e17¹(x: rsc? Unknown): ? { return x }; end


// A member with a modifier of its own is checked where its alias is defined. As `rsc`
// overrides a member's `rsc?`, the primitive is reported as an error under it; a member
// that is already `rsc` is not reported again.

:ge
fun e8(x: rsc P2): Int32 = x
//│ ╔══[COMPILATION ERROR] Primitive type 'Int32' cannot be a resource.
//│ ║  l.257: 	fun e8(x: rsc P2): Int32 = x
//│ ╙──       	              ^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e8⁰ as fun e8¹(x: Int32): Int32 { return x }; end

fun e12(x: rsc P1): Int32 = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e12⁰ as fun e12¹(x: Int32): Int32 { return x }; end

fun e13(x: rsc? P2): Int32 = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define e13⁰ as fun e13¹(x: Int32): Int32 { return x }; end


// A type alias in value position never represents a legal value, so it does not have an erased type and is
// defaulted to `rsc? Unknown`, and both tests below insert a checked cast to coerce it to the parameter's
// expected type.
class C()
module M with
  type Num2 = Int
  type R = rsc C
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define C³ as class C⁵ { constructor C⁴ }; define M⁰ as class M¹ module M²; end

fun takeInt(x: Int): Int = x
takeInt(M.Num2)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define takeInt⁰ as fun takeInt¹(x: Int⁰): Int⁰ { return x }; return takeInt¹((M².Num2⁰ as! Int⁰))

fun takeC(x: C): C = x
takeC(M.R)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define takeC⁰ as fun takeC¹(x: C⁵): C⁵ { return x }; return takeC¹((M².R⁰ as! C⁵))
