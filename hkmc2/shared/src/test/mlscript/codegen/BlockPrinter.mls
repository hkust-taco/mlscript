fun f(x) =
  let y = 1 in x + y
//│ Lowered:
//│ let f⁰; define f⁰ as fun (x) { let y; set y = 1; return +⁰(x, y) }; end

fun f(x) =
  let y = 1 in x + y
//│ Lowered:
//│ let f¹; define f¹ as fun (x) { let y; set y = 1; return +⁰(x, y) }; end


fun incr(n) = n + 1
fun (|>) pipe(x, f) = f(x)
//│ Lowered:
//│ let incr⁰, pipe⁰;
//│ define incr⁰ as fun (n) { return +⁰(n, 1) };
//│ define pipe⁰ as fun (x, f) { return f(x) };
//│ end

