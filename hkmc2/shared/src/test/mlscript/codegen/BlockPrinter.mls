let x = [1, 2, 3]
x.0
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let x¹⁴, selRes;
//│ set x¹⁴ = [1, 2, 3];
//│ set selRes = x¹⁴.0﹖;
//│ do x¹⁴.0$__checkNotMethod﹖;
//│ match selRes
//│   undefined =>
//│     throw new globalThis⁰.Error﹖("Access to required field '0' yielded 'undefined'")
//│   else
//│     return selRes
//│ end /* (Unreachable:) rest of abortive match */
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1
//│ x = [1, 2, 3]

let y = { x: 2 }
y!x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let y³, x¹⁵; set x¹⁵ = 2; set y³ = { "x": x¹⁵ }; return y³!"x"
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2
//│ y = {x: 2}


