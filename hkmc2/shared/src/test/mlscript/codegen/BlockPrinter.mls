:slot
fun incr(n) = n + 1
fun (|>) pipe(x, f) = f(x)
//│ Pretty Lowered:
//│   define fun incr(n) { return +(n, 1) } in define fun pipe(x1, f) { return f(x1) } in set block$res2 = undefined in end

:slot
