:js


:silent
val debugFile = "hkmc2/shared/src/test/mlscript/codegen/DebugDestinations.log"
fs.rmSync(debugFile, {force: true})


// Nested annotations inherit the enclosing phase and destination. Siblings do not.
@dbg('lowering, showUids: false, out: File("DebugDestinations.log"))
fun selected_file() =
  @dbg(showUids: false) fun nested_file() = 42
  @dbg(lowering: false) fun muted_file() = 43
  nested_file()
fun unrelated_file() = 44


:silent
:expect true
let trace = fs.readFileSync(debugFile, "utf8")
trace.includes("Lowering.term 42\n") and
  not(trace.includes("Lowering.term 43\n")) and
  not(trace.includes("Lowering.term 44\n"))


// Methods route to the same output handler as free functions.
module FileMethods with
  @dbg('lowering, showUids: false, out: File("DebugDestinations.log"))
  fun selected() = 45
  fun unrelated() = 46

:silent
:expect true
let trace = fs.readFileSync(debugFile, "utf8")
trace.includes("Lowering.term 42\n") and
  trace.includes("Lowering.term 45\n") and
  not(trace.includes("Lowering.term 46\n"))


:silent
fs.rmSync(debugFile, {force: true})


// A discovery parse and its traced replay must report each syntax error only once.
:noCodeGen
:pe
#dbg('parsing, out: File("DebugDestinationsParse.log"))
fun broken(x) = )
//│ ╔══[PARSE ERROR] Unexpected closing parenthesis
//│ ║  l.48: 	fun broken(x) = )
//│ ╙──      	                ^
//│ ╔══[PARSE ERROR] Expected expression or block after 'fun' binding equals sign; found end of input instead
//│ ║  l.48: 	fun broken(x) = )
//│ ╙──      	                ^

#dbg(parsing: false, out: StdIO)

:silent
:expect true
fs.readFileSync("hkmc2/shared/src/test/mlscript/codegen/DebugDestinationsParse.log", "utf8").includes("blockOf")

:silent
fs.rmSync("hkmc2/shared/src/test/mlscript/codegen/DebugDestinationsParse.log", {force: true})


// Diff-test commands write to the test output, even when #dbg selects a file destination.
:silent
fs.rmSync("hkmc2/shared/src/test/mlscript/codegen/DebugDestinationsCommand.log", {force: true})

:noCodeGen
#dbg(out: File("DebugDestinationsCommand.log"))

:noCodeGen
:dp
1
//│ ┊1┊
//│ @ blockOf(start of expression,allowNewlines = true)    [at syntax/Parser.scala:66]
//│ │ ? blockOfImpl		inspects ┊1┊    [at syntax/Parser.scala:340]
//│ │ @ simpleExpr(1)    [at syntax/Parser.scala:429]
//│ │ │ ! simpleExprImpl		consumes ┊1┊    [at syntax/Parser.scala:674]
//│ │ │ @ exprCont(1,`IntLit(1)`,true)    [at syntax/Parser.scala:675]
//│ │ │ │ ? exprContImpl		inspects ┊┊    [at syntax/Parser.scala:931]
//│ │ │ │ @ exprJux(1,`IntLit(1)`,false)    [at syntax/Parser.scala:1203]
//│ │ │ │ │ ? exprJuxImpl		inspects ┊┊    [at syntax/Parser.scala:1210]
//│ │ │ │ │ stops at the end of input
//│ │ │ │ = IntLit(1)
//│ │ │ = IntLit(1)
//│ │ = IntLit(1)
//│ │ @ parseRule(1,expression ::= End(),allowNewlines = true)    [at syntax/Parser.scala:431]
//│ │ = Some(())
//│ = List(IntLit(1))
//│ ? parseAll		inspects ┊┊    [at syntax/Parser.scala:261]

#dbg(out: StdIO)

:expect false
fs.existsSync("hkmc2/shared/src/test/mlscript/codegen/DebugDestinationsCommand.log")
//│ = false

:silent
fs.rmSync("hkmc2/shared/src/test/mlscript/codegen/DebugDestinationsCommand.log", {force: true})


// Absolute file destinations are not resolved against the base directory, as for imports.
:silent
val absoluteDebugFile = "/tmp/mlscript-DebugDestinationsAbsolute.log"
fs.rmSync(absoluteDebugFile, {force: true})

:fixme
@dbg('lowering, showUids: false, out: File("/tmp/mlscript-DebugDestinationsAbsolute.log"))
fun absolute_file() = 1801
//│ /!!!\ Uncaught error: java.lang.IllegalArgumentException: requirement failed: /tmp/mlscript-DebugDestinationsAbsolute.log is not a relative path

:fixme
:expect true
fs.existsSync(absoluteDebugFile) and fs.readFileSync(absoluteDebugFile, "utf8").includes("Lowering.term 1801\n")
//│ ═══[RUNTIME ERROR] Expected: 'true', got: 'false'
//│ = false

:silent
fs.rmSync(absoluteDebugFile, {force: true})
