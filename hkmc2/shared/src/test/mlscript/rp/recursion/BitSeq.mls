:js
:cp

class Pair[A, B](val first: A, val second: B)

pattern Bit = 0 | 1

:expect true
0 is Bit
//│ = true

:expect true
1 is Bit
//│ = true

:expect false
42 is Bit
//│ = false

pattern BitSeq = null | Pair(Bit, BitSeq)

null is BitSeq
//│ = true

Pair(0, null) is BitSeq
//│ = true

Pair(1, Pair(0, null)) is BitSeq
//│ = true

Pair(2, null) is BitSeq
//│ = false
