:js

class Pair[A, B](val first: A, val second: B)

pattern Null = null

:cp
[null is Null, 0 is Null, false is Null]
//│ = [ true, false, false ]

pattern Tree = Null | Pair(Tree, Tree)

fun (##) concat(a, b) = Pair(a, b)

0 ## 1
//│ = Pair { first: 0, second: 1 }

// Positive Test Cases
// ===================

:global
:expect true

:cp
null is Tree
//│ = true

:cp
null ## null is Tree
//│ = true

:cp
((null ## null) ## null) is Tree
//│ = true

:cp
null ## (null ## null) is Tree
//│ = true

:cp
:todo
((null ## null) ## (null ## null)) is Tree
//│ ═══[RUNTIME ERROR] Expected: true, got: false

// Negative Test Cases
// ===================

:global
:expect false

:cp
0 is Tree
//│ = false

:cp
0 ## 0 is Tree
//│ = false

:cp
0 ## null is Tree
//│ = false

:cp
null ## 0 is Tree
//│ = false
