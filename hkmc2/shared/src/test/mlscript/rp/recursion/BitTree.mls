:js

class Pair[A, B](val first: A, val second: B)

pattern Bit = 0 | 1

:cp
:expect true
0 is Bit
//│ = true

:cp
:expect true
1 is Bit
//│ = true

:cp
:expect false
42 is Bit
//│ = false

:ucs rp:elaborated
pattern BitTree = null | Pair(Bit | BitTree, Bit | BitTree)
//│ elaborated nameless split:
//│ >  a => 
//│ >    a is null -> accept 0
//│ >    a is class:Pair -> b => c => 
//│ >      b is pattern:Bit -> 
//│ >        c is pattern:Bit -> accept 0
//│ >        c is pattern:BitTree -> accept 0
//│ >      b is pattern:BitTree -> 
//│ >        c is pattern:Bit -> accept 0
//│ >        c is pattern:BitTree -> accept 0

:cp
null is BitTree
//│ = true

