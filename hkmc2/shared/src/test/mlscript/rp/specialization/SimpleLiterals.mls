:js
:cp

pattern Zero = "0"
pattern One = "1"
pattern Two = "2"

:ucs normalized
fun checkZeroOneTwo(x) = if x is
  Zero then 0
  One then 1
  Two then 2
  else ()
//│ Normalized:
//│ >  if
//│ >    x is "0" then 0
//│ >    x is "1" then 1
//│ >    x is "2" then 2
//│ >    else null

import "../../../mlscript-compile/Option.mls"
open Option

:ucs normalized
fun checkSomeZeroOneTwo(x) = if x is
  Some(Zero) then 0
  Some(One) then 1
  Some(Two) then 2
  else ()
//│ Normalized:
//│ >  if
//│ >    x is Some($param0) and
//│ >      $param0 is "0" then 0
//│ >      $param0 is "1" then 1
//│ >      $param0 is "2" then 2
//│ >      else null
//│ >    else null

pattern ManyZero = ("0" ~ (ManyZero | "")) | ""

let res = "1" is ManyZero
//│ res = false

