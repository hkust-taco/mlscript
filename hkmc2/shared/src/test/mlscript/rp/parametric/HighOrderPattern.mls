pattern Nullable(pattern T) = null | T

null is @compile Nullable(A)
//│ = true

A is @compile Nullable(A)
//│ = true

2 is @compile Nullable(1 | 2)
//│ = true

class Pair[A, B](val first: A, val second: B)

pattern Chain(pattern T) = null | Pair(T, Chain(T))

