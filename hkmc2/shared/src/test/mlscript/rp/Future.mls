pattern LineSep(pattern P) = case
  "" then Nil
  L(...nd) ~
    ""                   then nd :: Nil
    "\n" ~ LineSep(P, t) then nd :: t
//│ /!!!\ Uncaught error: scala.MatchError: TypeDef(Pat,Ident(P),None,None) (of class hkmc2.syntax.Tree$TypeDef)

:todo
pattern Lines(pattern L) = case
  "" then []
  pattern Tail = case
    "" then []
    "\n" ~ (Lines of L) as t then t
  L as h ~ Tail as t then [h, ...t]
  
