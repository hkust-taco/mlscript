:js

class Pair[A, B](val first: A, val second: B)

pattern Bit = 0 | 1

:cp
:expect true
0 is Bit
//│ = true

:cp
:expect true
1 is Bit
//│ = true

:cp
:expect false
42 is Bit
//│ = false

// :ucs rp:elaborated
pattern BitTree = null | Pair(Bit | BitTree, Bit | BitTree)

:todo
null is BitTree
//│ = true

:todo
Pair(null, null) is BitTree
//│ = true

