staged class Bar(val x) with
  fun bar() = x
staged class Foo(val x) with
  fun foo(b) =
    if b is
      1 then x.bar() + 1
      2 then x.bar() + 2
      else x.bar()

staged module Dispatching2 with
  fun baz(b) = Foo(Bar(1)).foo(b)

Dispatching2."baz_gen"(mkDyn())
//│ = ["baz", {Lit(1),Lit(2),Lit(3)}]

staged class A(val x: Int) with
  fun f(y: Int) = x + y
staged class B(val x: Int) with
  fun f(y: A) = x + y.f(x)

staged module This with
  fun test(x) = B(x).f(A(1))
  fun test2(y) = B(1).x + y

This."test_gen"(mkLit(1))
This."test2_gen"(mkLit(1))
print(This."cache$This")
//│ > module This with
//│ >   ()
//│ > fun test2_This_sp_0(y) = 2
//│ > fun test_This_sp_0(x) = 3

print(A.class."class$cache$A")
print(B.class."class$cache$B")
//│ > class A(val x) with
//│ >   ()
//│ > fun f_A_sp_0(self, y) = 2
//│ > class B(val x) with
//│ >   ()
//│ > fun f_B_sp_0(self, y) = 3

staged class B(val x, val y) with
  val z = x + y

staged class D(val x, val y) extends B(x + 1, x + 2)

staged module Inheritance with
  fun test() = 
    let d = D(1, 2)
    if d is
      B then d.z
      else "not B"

Inheritance."test_gen"()
//│ = ["test", {Lit(5)}]

staged module NonTermination with
  fun f(x, y) = if y
    == x then 0
    else f(x, y + 1)

:re
// NonTermination."f_gen"(mkDyn(), mkLit(0))

fun g(x, y) = x + y

staged module GlobalFunction with
  fun test(x) = g(x, x)

GlobalFunction."test_gen"(mkLit(1))
//│ = ["test_GlobalFunction_sp_0", {Dyn()}]

staged module Comparison with
  fun test(x) = x < 5

Comparison."test_gen"(union(mkLit(3), mkLit(4)))
