class C
module Opaque with
  fun f() = new C
staged module M with
  fun f() = Opaque.f()
M."f_gen"()
//│ = ["f", {Dyn()}]

staged module M with
  fun f(x, y) = x * y
  fun g(y) = f(2, y)

M."propagate"()

