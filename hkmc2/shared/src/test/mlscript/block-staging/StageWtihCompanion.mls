//│ >       paramsOpt: None {},
//│ >       auxParams: []
//│ >     }
//│ >   },
//│ >   moduleMap: Map(1) {
//│ >     [class M] {
//│ >       'cache$M': [FunCache],
//│ >       'generatorMap$M': [Map],
//│ >       'class$cache$M': [FunCache],
//│ >       'class$generatorMap$M': [Map]
//│ >     } => ModuleSymbol { name: 'M', value: [Function] }
//│ >   }
//│ > }

