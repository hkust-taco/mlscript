Transform3D.model([[10], [0], [0]], [5, 0, 0], [0.5, 0.5, 0.5], [0, 0, 3.1415926535 / 2.0])
//│ = [5.000000000224483, 5, 0]


Transform3D.model0([[10], [0], [0]])
