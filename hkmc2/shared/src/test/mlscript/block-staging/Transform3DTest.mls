//│   [
//│     0.00004632679487995776,
//│     0,
//│     0.999999998926914,
//│     0,
//│     0,
//│     1,
//│     0,
//│     0,
//│     -0.999999998926914,
//│     0,
//│     0.00004632679487995776,
//│     0,
//│     0,
//│     0,
//│     0,
//│     1
//│   ],
//│   4,
//│   4
//│ )

Transform3D.rotateZ(3.1415 / 2)
//│ = Matrix(
//│   [
//│     0.00004632679487995776,
//│     -0.999999998926914,
//│     0,
