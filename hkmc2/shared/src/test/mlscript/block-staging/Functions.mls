//│ >     [class A2] { 'cache$A': [FunCache], 'generatorMap$A': [Map] } => ModuleSymbol { name: 'A', value: [Function] }
//│ >   }
//│ > }

// nested module
module A with
  staged module B with
    fun f() = 1
//│ > module B with
//│ >   ()
//│ >   fun f() = 1
//│ > Map(1) { 'f' => [Function: f_gen] }
//│ > SymbolMap {
//│ >   classMap: Map(0) {},
//│ >   moduleMap: Map(1) {
//│ >     [class B] { 'cache$B': [FunCache], 'generatorMap$B': [Map] } => ModuleSymbol { name: 'B', value: [Function] }
//│ >   }
//│ > }

