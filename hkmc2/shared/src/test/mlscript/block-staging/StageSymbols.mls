:js
:staging
:noModuleCheck

staged module M with
  class C with
    fun f() = 1
    fun g() = f()

staged module A with
  fun f() = 1
module B with
  fun f() = 1
class C(val a, b)(c)(d)
staged module D with
  class E
  fun f() =
    A.f()
    B.f is Bool
  fun matching() =
    1 is Int
    1 is C

module A with
  module B with
    class C(a)
staged module M with
  class E
  fun f() = 
    let x = D.E
    x = A.B.C
    A.B.C(2)
    E

:e
staged module M with
  fun g()() = 1
//│ ╔══[COMPILATION ERROR] :ftc must be enabled to desugar functions with multiple parameter lists.
//│ ║  l.37: 	  fun g()() = 1
//│ ╙──      	  ^^^^^^^^^^^^^

:ftc
staged module M with
  fun f() = x => x
  fun g()() = 1

:noModuleCheck
:silent
let x = M."f_instr"().body.rest.rhs.cls.l
let y = M."g_instr"().body.rest.rhs.cls.l
assert x.value != y.value
// check that the two functions will be printed differently
assert x.name != y.name

staged module Shadowing with
  fun f(x, x) = x

staged module RetUnit with
  fun f() = ()

// should use same symbol across compilation units
import "../../mlscript-compile/Runtime.mls"
module M with
  fun f() = 1

staged module One with
  fun f() = M.f()

staged module Two with
  fun f() = M.f()

:silent
let x = One."f_instr"().body.res._fun.qual.l
let y = Two."f_instr"().body.res._fun.qual.l
assert x === y

:fixme Array should be skipped for redirection
staged module M with
  val a = Math.cos(1) is Array // doesn't handle Array
