//│         )
//│       ),
//│       [Arg(ValueLit(1)), Arg(ValueLit(2))]
//│     ),
//│     End()
//│   ),
//│   ValueSimpleRef(Symbol("obj_2"))
//│ ]

shapeset2path(sov(TestClass(1, [1,2])), mut [])
//│ = [
