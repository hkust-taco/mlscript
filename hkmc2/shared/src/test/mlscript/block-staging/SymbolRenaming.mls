:js
:staging

staged module TempVariable with
  fun f(x, x) =
    let x
    let x
    x
//│ > module TempVariable with
//│ >   ()
//│ >   fun f(x, x) =
//│ >     let {x, x}
//│ >     x
//│ > Map(1) { 'f' => [Function: f_gen] }
//│ > SymbolMap {
//│ >   classMap: Map(0) {},
//│ >   moduleMap: Map(1) {
//│ >     [class TempVariable] {
//│ >       'cache$TempVariable': [FunCache],
//│ >       'generatorMap$TempVariable': [Map]
//│ >     } => ModuleSymbol { name: 'TempVariable', value: [Function] }
//│ >   }
//│ > }

