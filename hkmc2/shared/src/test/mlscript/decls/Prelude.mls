declare class Int extends Num
declare class Str with
  val length: Int
  fun toString(): Str
  fun at(index: Int): Str | undefined
  fun charAt(index: Int): Str
  fun charCodeAt(index: Int): Num
  fun codePointAt(index: Int): Int | undefined
  fun indexOf(value: Str, ...from): Int
  fun lastIndexOf(value: Str, ...from): Int
  fun includes(value: Str, ...from): Bool
  fun startsWith(value: Str, ...from): Bool
  fun endsWith(value: Str, ...until): Bool
  fun slice(...bounds): Str
  fun substring(...bounds): Str
  fun split(...separatorAndLimit): Array[Str]
  fun repeat(count: Int): Str
  fun toUpperCase(): Str
  fun toLowerCase(): Str
  fun trim(): Str
declare class Class

// The `Array` class/function is a footgun:
//    > Array()
//    []
//    > Array(1)
//    [ <1 empty item> ]
//    > Array(1, 2)
//    [ 1, 2 ]
// Expose only the length-taking constructor; use tuple literals for initial elements.
// Foreign constructor signatures describe the native binding and do not introduce
// the `.class` storage used by generated MLscript constructor functions.
// The `val length` parameter also supports matching with `Array(length)`.
declare class Array[T](val length: Int): Array[T] with
  fun join(...separators): Str
  fun reverse(): Array[T]
  fun sort(...compare): Array[T]
  fun slice(...bounds): Array[T]
  fun at(index: Int): T | undefined
  fun fill(value: T, ...bounds): Array[T]
  fun splice(start: Int, ...items): Array[T]
  fun push(...items: Array[T]): Int
  fun unshift(...items: Array[T]): Int
  fun pop(): T | undefined
  fun shift(): T | undefined
  fun concat(...arrays): Array[Any]
  fun map[U](f: (T, Int, Array[T]) -> U): Array[U]
  fun forEach(f: (T, Int, Array[T]) -> Any): undefined
  fun filter(f: (T, Int, Array[T]) -> Bool): Array[T]
  fun every(f: (T, Int, Array[T]) -> Bool): Bool
  fun some(f: (T, Int, Array[T]) -> Bool): Bool
  // Without an initial value, the first element becomes the accumulator, so the
  // accumulator type would also have to include T. Methods cannot be overloaded
  // by arity, so only the form with an initial value is declared.
  fun reduce[U](f: (U, T, Int, Array[T]) -> U, initial: U): U
  fun indexOf(value: T, ...from): Int
  fun lastIndexOf(value: T, ...from): Int
  fun includes(value: T, ...from): Bool
  fun toString(): Str
declare module Array with
  fun from(...args): Array[Any]
  fun
    concat
    isArray
  val prototype: Array[Any]

declare class Symbol
declare module Symbol with
  // The `TermDef` needs `rhs` to be defined to be recognized as `isMLsFun`.
  // Otherwise, it would be wrapped in `runtime.safeCall`, which accesses the
  // uninitialized `runtime` in the `Rendering` module.
  fun for: Str -> Any = ()
  val iterator: Any

