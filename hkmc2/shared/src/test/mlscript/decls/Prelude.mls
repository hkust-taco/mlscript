      abs: Num -> Num
      acos: Num -> Num
      acosh: Num -> Num
      asin: Num -> Num
      asinh: Num -> Num
      atan: Num -> Num
      atan2: (Num, Num) -> Num
      atanh: Num -> Num
      cbrt: Num -> Num
      ceil: Num -> Num
      clz32: Num -> Int
      cos: Num -> Num
      cosh: Num -> Num
      exp: Num -> Num
      expm1: Num -> Num
      floor: Num -> Num
      f16round: Num -> Num
      fround: Num -> Num
      hypot(...values): Num
      imul: (Num, Num) -> Int
      log: Num -> Num
      log10: Num -> Num
      log1p: Num -> Num
      log2: Num -> Num
      max(...values): Num
      min(...values): Num
      pow: (Num, Num) -> Num
      random: () -> Num
      round: Num -> Num
      sign: Num -> (-1 | 0 | 1)
      sin: Num -> Num
      sinh: Num -> Num
      sqrt: Num -> Num
      tan: Num -> Num
      tanh: Num -> Num
      trunc: Num -> Num

