:js

#config(inlining: None, liftDefns: Some(LiftDefn), flowBasedOpt: Some(FlowBasedOpt(logEffects: true, mono: true)))
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > <<< effect-analysis results <<<



// * Mutating a state is an effect.
let state = 0
fun mutate() =
  set state = 42
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function mutate⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<
//│ state = 0


// * Mutating a local (unescaped) variable is pure.
fun mutate_local() =
  let local = 0
  set local = 42
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function mutate_local⁰#0 @ <root> -> Pure
//│ flow-analysis > <<< effect-analysis results <<<


// * Reassigning a local copy does not mutate the input binding.
fun mutate_alias(value) =
  let local = value
  set local = 42
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function mutate_alias⁰#0 @ <root> -> Pure
//│ flow-analysis > <<< effect-analysis results <<<


// * Mutating a local (escaped, captured) variable is an effect.
fun mutate_captured() =
  let local = 0
  () =>
    set local = 42
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function lambda$⁰#0 @ <root> -> Pure
//│ flow-analysis > function lambda$⁰#1 @ <root> -> UnsafeEta
//│ flow-analysis > function lambda⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function mutate_captured⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call lambda$⁰@result⁰ @ <root> -> Pure
//│ flow-analysis > call lambda⁰@result¹ @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<


// * Mutating a state field is an effect.
let state = mut { value: 0 }
fun mutate_field() =
  set state.value = 42
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function mutate_field⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<
//│ state = {value: 0}

// * Mutating a state element is an effect.
let state = mut [0]
fun mutate_element() =
  set state.[0] = 42
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function mutate_element⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<
//│ state = [0]


// * Mutating a local field/element is pure.
// TODO: this shouldn't be an effect because the local is unescaped
//       to be refined by a "capture-tracking-based local mutation escape analysis"
fun mutate_local_field() =
  let local = mut { value: 0 }
  set local.value = 42
fun mutate_local_element() =
  let local = mut [0]
  set local.[0] = 42
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function mutate_local_element⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function mutate_local_field⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<


// * Mutating an aliased field/element is an effect.
fun mutate_alias_field(obj) =
  let local = obj
  set local.value = 42
fun mutate_alias_element(xs) =
  let local = xs
  set local.[0] = 42
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function mutate_alias_element⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function mutate_alias_field⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<


// * Observing a state is an effect.
