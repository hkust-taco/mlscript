//│ flow-analysis > function observe_alias⁰#0 @ <root> -> Pure
//│ flow-analysis > <<< effect-analysis results <<<


// * Observing a local (escaped, captured) variable is pure.
fun observe_captured() =
  let local = 0
  () =>
    local
