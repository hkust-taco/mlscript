// * Some edge cases...
// * Spreading a tuple or record is an effect because it is equivalent to accesses.
// TODO: the same refinement as above
fun tup_spread_local() = 
  let xs = [42]
  [...xs]
fun rec_spread_local() =
  let obj = { value: 42 }
  {...obj}
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function rec_spread_local⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function tup_spread_local⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<
let xs = [42]
fun tup_spread_nonlocal() =
  [...xs]
let obj = { value: 42 }
fun rec_spread_nonlocal() =
  {...obj}
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function rec_spread_nonlocal⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function tup_spread_nonlocal⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<
//│ obj = {value: 42}
//│ xs = [42]


// * Reading a shared capture is an effect even though only the other closure writes it.
fun shared_captures() =
  let local = 0
  fun observe() =
    local
  fun mutate() =
    set local = 42
  [observe, mutate]
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function mutate$⁰#0 @ <root> -> Pure
//│ flow-analysis > function mutate$⁰#1 @ <root> -> UnsafeEta
//│ flow-analysis > function mutate⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function observe$⁰#0 @ <root> -> Pure
//│ flow-analysis > function observe$⁰#1 @ <root> -> UnsafeEta
//│ flow-analysis > function observe⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function shared_captures⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call mutate$⁰@result⁰ @ <root> -> Pure
//│ flow-analysis > call mutate⁰@result² @ <root> -> UnsafeEta
//│ flow-analysis > call observe$⁰@result¹ @ <root> -> Pure
//│ flow-analysis > call observe⁰@result³ @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<


// * Conditional branches retain shared writes.
let state = 0
fun mutate_if(cond) =
  if cond do set state = 42
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function mutate_if⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<
//│ state = 0


// * Conditional local mutation remains pure.
fun mutate_local_if(cond) =
  let local = 0
  if cond do set local = 42
  local
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function mutate_local_if⁰#0 @ <root> -> Pure
//│ flow-analysis > <<< effect-analysis results <<<


// * Loops retain shared writes.
let state = 0
fun mutate_loop(again) =
  while again do
    set state = 42
    set again = false
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function mutate_loop⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<
//│ state = 0


// * Local mutation in a loop remains pure.
fun mutate_local_loop(again) =
  let local = 0
  while again do
    set local = 42
    set again = false
  local
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function mutate_local_loop⁰#0 @ <root> -> Pure
//│ flow-analysis > <<< effect-analysis results <<<


// * Regressions

// * A getter from an earlier block is unsafe.
module M with
  fun get = set state = 42
