#config(flowBasedOpt: Some(FlowBasedOpt(logEffects: true, mono: false)))
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > <<< effect-analysis results <<<


// * Propagation through higher-order calls (polymorphic).
fun answer() = 42
fun leaf_pure_public(x) = x()
private fun leaf_pure_private(x) = x()
fun leaf_unsafe_public(x) = x()
private fun leaf_unsafe_private(x) = x()
fun node() = 
  leaf_pure_public(answer)
  leaf_pure_private(answer)
  leaf_unsafe_public(unsafe)
  leaf_unsafe_private(unsafe)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function answer#0 @ answer@answer -> Pure
//│ flow-analysis > function answer#0 @ node@node.answer@answer -> Pure
//│ flow-analysis > function answer#0 @ node@node.answer@answer -> Pure
//│ flow-analysis > function leaf_pure_private#0 @ leaf_pure_private@leaf_pure_private -> UnsafeEta
//│ flow-analysis > function leaf_pure_private#0 @ node@node.leaf_pure_private@leaf_pure_private -> Pure
//│ flow-analysis > function leaf_pure_public#0 @ leaf_pure_public@leaf_pure_public -> UnsafeEta
//│ flow-analysis > function leaf_pure_public#0 @ node@node.leaf_pure_public@leaf_pure_public -> Pure
//│ flow-analysis > function leaf_unsafe_private#0 @ leaf_unsafe_private@leaf_unsafe_private -> UnsafeEta
//│ flow-analysis > function leaf_unsafe_private#0 @ node@node.leaf_unsafe_private@leaf_unsafe_private -> UnsafeEta
//│ flow-analysis > function leaf_unsafe_public#0 @ leaf_unsafe_public@leaf_unsafe_public -> UnsafeEta
//│ flow-analysis > function leaf_unsafe_public#0 @ node@node.leaf_unsafe_public@leaf_unsafe_public -> UnsafeEta
//│ flow-analysis > function node#0 @ node@node -> UnsafeEta
//│ flow-analysis > call leaf_pure_private@result @ node@node -> Pure
//│ flow-analysis > call leaf_pure_public@result @ node@node -> Pure
//│ flow-analysis > call leaf_unsafe_private@result @ node@node -> UnsafeEta
//│ flow-analysis > call leaf_unsafe_public@result @ node@node -> UnsafeEta
//│ flow-analysis > call x@result @ leaf_pure_private@leaf_pure_private -> UnsafeEta
//│ flow-analysis > call x@result @ leaf_pure_public@leaf_pure_public -> UnsafeEta
//│ flow-analysis > call x@result @ leaf_unsafe_private@leaf_unsafe_private -> UnsafeEta
//│ flow-analysis > call x@result @ leaf_unsafe_public@leaf_unsafe_public -> UnsafeEta
//│ flow-analysis > call x@result @ node@node.leaf_pure_private@leaf_pure_private -> Pure
//│ flow-analysis > call x@result @ node@node.leaf_pure_public@leaf_pure_public -> Pure
//│ flow-analysis > call x@result @ node@node.leaf_unsafe_private@leaf_unsafe_private -> UnsafeEta
//│ flow-analysis > call x@result @ node@node.leaf_unsafe_public@leaf_unsafe_public -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<
