private fun node_direct_effectful() = leaf_effectful(0)
private fun node_pure(f, x) = f(x)
private fun node_effectful(f, x) = f(x)
private fun caller_pure() = node_pure(leaf_pure, 0)
private fun caller_effectful() = node_effectful(leaf_effectful, 0)
