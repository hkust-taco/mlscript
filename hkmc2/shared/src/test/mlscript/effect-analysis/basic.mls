// Explicit latent overrides node to direct and higher-order calls; body calls retain their summaries.
@pure
private fun leaf_pure(x) = effect()
@effectful
private fun leaf_effectful(x) = x
private fun node_direct_pure() = leaf_pure(0)
private fun node_direct_effectful() = leaf_effectful(0)
private fun node_pure(f, x) = f(x)
private fun node_effectful(f, x) = f(x)
private fun caller_pure() = node_pure(leaf_pure, 0)
private fun caller_effectful() = node_effectful(leaf_effectful, 0)
node_direct_pure()
node_direct_effectful()
caller_pure()
caller_effectful()
