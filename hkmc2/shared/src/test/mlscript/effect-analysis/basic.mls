open annotations { effectful }
@effectful
declare fun effect(): Anything
//│ effect-analysis > >>> effect-analysis results >>>
//│ effect-analysis > <<< effect-analysis results <<<

fun leaf_pure(x) = x + 1
fun node_pure(x) = leaf_pure(x)
//│ effect-analysis > >>> effect-analysis results >>>
//│ effect-analysis > function leaf_pure#0 @ <root> -> Pure
//│ effect-analysis > function node_pure#0 @ <root> -> Pure
