//│ effect-analysis > call print@1 @ <root> -> MayRaise
//│ effect-analysis > <<< effect-analysis results <<<

fun node_recursive_pure(x) = node_recursive_pure(x)
fun node_recursive_effectful(x) = node_recursive_effectful(leaf_effectful())
