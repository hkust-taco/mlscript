:js
:lift

#config(deforest: Some(Deforest(debug: false)), flowBasedOpt: Some(FlowBasedOpt(logEffects: true)))
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > <<< effect-analysis results <<<

data class (::) Cons(h, t)
data object Nil
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > <<< effect-analysis results <<<


// * The unannotated counterpart of deforest/eta-expansion/recursive.mls.
// * Track inferred effects while that test overrides them with @pure.
:expect 3
:aggressive
fun append(xs, ys) = if xs is
  Nil then ys
  h :: t then h :: append(t, ys)
fun flatten(xss) = if xss is
  Nil then Nil
  h :: t then append(h, flatten(t))
fun len(ls) = if ls is
  Nil then 0
  h :: t then 1 + len(t)
len(flatten(id((1 :: 2 :: Nil) :: (3 :: Nil) :: Nil)))
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function append⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function flatten⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function len⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call +⁰@result³#0 @ <root> -> Pure
//│ flow-analysis > call append⁰@result⁵#0 @ <root> -> UnsafeEta
//│ flow-analysis > call append⁰@result⁷#0 @ <root> -> UnsafeEta
//│ flow-analysis > call flatten⁰@result¹#0 @ <root> -> UnsafeEta
//│ flow-analysis > call flatten⁰@result⁶#0 @ <root> -> UnsafeEta
//│ flow-analysis > call id@result²#0 @ <root> -> UnsafeEta
//│ flow-analysis > call len⁰@result⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call len⁰@result⁴#0 @ <root> -> UnsafeEta
