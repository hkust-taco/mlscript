:.
// The test harness imports and opens Predef.mls; print's body is outside this program.
:lift
#config(flowBasedOpt: Some(FlowBasedOpt(logEffects: true, mono: true)), inlining: None)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > <<< effect-analysis results <<<


// Isolate print so another effectful call cannot mask a missing imported-call effect.
fun leaf(x) = print(x)
fun node(x) = leaf(x)
fun qualified(x) = Predef.print(x)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function leaf⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function node⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function qualified⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call leaf⁰@result¹#0 @ <root> -> UnsafeEta
//│ flow-analysis > call print@result²#0 @ <root> -> UnsafeEta
//│ flow-analysis > call print@result⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<


// Passing an imported function as a value must also propagate its unknown effect.
private fun invoke(f, x) = f(x)
fun indirect(x) = invoke(print, x)
fun pure_callback(x) = invoke(y => y, x)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function indirect⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function invoke⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function lambda⁰#0 @ <root> -> Pure
//│ flow-analysis > function pure_callback⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call f⁰@result⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call invoke⁰@result²#0 @ <root> -> UnsafeEta
//│ flow-analysis > call invoke⁰@result¹#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<


#config(flowBasedOpt: Some(FlowBasedOpt(logEffects: true, mono: false)))
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > <<< effect-analysis results <<<


fun leaf(x) = print(x)
fun node(x) = leaf(x)
fun qualified(x) = Predef.print(x)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function leaf⁰#0 @ leaf¹ -> UnsafeEta
//│ flow-analysis > function leaf⁰#0 @ node¹.leaf² -> UnsafeEta
//│ flow-analysis > function node⁰#0 @ node¹ -> UnsafeEta
//│ flow-analysis > function qualified⁰#0 @ qualified¹ -> UnsafeEta
//│ flow-analysis > call leaf⁰@result¹#0 @ node¹ -> UnsafeEta
//│ flow-analysis > call print@result²#0 @ qualified¹ -> UnsafeEta
//│ flow-analysis > call print@result⁰#0 @ leaf¹ -> UnsafeEta
//│ flow-analysis > call print@result⁰#0 @ node¹.leaf² -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<


// Poly mode keeps the pure callback separate from the imported print callback.
private fun invoke(f, x) = f(x)
fun indirect(x) = invoke(print, x)
fun pure_callback(x) = invoke(y => y, x)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function indirect⁰#0 @ indirect¹ -> UnsafeEta
//│ flow-analysis > function invoke⁰#0 @ indirect¹.invoke² -> UnsafeEta
//│ flow-analysis > function invoke⁰#0 @ invoke¹ -> UnsafeEta
//│ flow-analysis > function invoke⁰#0 @ pure_callback¹.invoke³ -> Pure
//│ flow-analysis > function lambda⁰#0 @ lambda¹ -> Pure
//│ flow-analysis > function lambda⁰#0 @ pure_callback¹.lambda² -> Pure
//│ flow-analysis > function pure_callback⁰#0 @ pure_callback¹ -> Pure
//│ flow-analysis > call f⁰@result⁰#0 @ indirect¹.invoke² -> UnsafeEta
//│ flow-analysis > call f⁰@result⁰#0 @ invoke¹ -> UnsafeEta
//│ flow-analysis > call f⁰@result⁰#0 @ pure_callback¹.invoke³ -> Pure
//│ flow-analysis > call invoke⁰@result²#0 @ pure_callback¹ -> Pure
//│ flow-analysis > call invoke⁰@result¹#0 @ indirect¹ -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<
