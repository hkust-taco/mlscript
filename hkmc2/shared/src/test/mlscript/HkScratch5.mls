pattern MultiSet(pattern Head, pattern Rest) =
  | ((Head as h) :: (Rest as r)) => h :: r
  | ((h0 :: (Head as h) :: r) where ((h0 :: r) is (Rest as rst))) => h :: rst
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: subterm (Elaborator.scala:482)
//│ ╔══[ERROR] Name not found: rst
//│ ║  l.84: 	  | ((h0 :: (Head as h) :: r) where ((h0 :: r) is (Rest as rst))) => h :: rst
//│ ╙──      	                                                                          ^^^

  // | ((h0 :: (Head as h) :: r) and ((h0 :: r) is (Rest as rst))) => h :: rst


pattern MultiSet(pattern Head, pattern Rest) =
  | ((Head as h) :: (Rest as r)) => h :: r
  | (((h0 :: h :: r) => h0 :: h :: r) as MultiSet(Head, Rest) as res) => res

[1,2,3] is
  MultiSet(2, MultiSet(1, 3))
//│ = false




