import "../mlscript-compile/Stack.mls"
open Stack


pattern Bin =
  (0 => false) | (1 => true) | ([Bin as b] => b)

fun f(x) = if x is
  Bin as b then b
  ~Bin as c then [c]

f(0)
//│ = false

f(1)
//│ = true

f(2)
//│ = [2]

f([1])
//│ = true

f([[[0]]])
//│ = false

if [1,1] is
  [x,y] and x == y then "all equal"
//│ = "all equal"


pattern Sym =
  ([x,y] where (x == y))
