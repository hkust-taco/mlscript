:js


import "../mlscript-compile/Stack.mls"
open Stack


pattern Bin =
  (0 => false) | (1 => true) | ([Bin as b] => b)

fun f(x) = if x is
  Bin as b then b
  ~Bin as c then [c]

f(0)
//│ = false

f(1)
//│ = true

f(2)
//│ = [2]

f([1])
//│ = true

f([[[0]]])
//│ = false

if [1,1] is
  [x,y] and x == y then "all equal"
//│ = "all equal"


:fixme
pattern Sym =
  ([x,y] where (x == y))
//│ ╔══[WARNING] Useless pattern binding: x.
//│ ║  l.37: 	  ([x,y] where (x == y))
//│ ╙──      	    ^
//│ ╔══[WARNING] Useless pattern binding: y.
//│ ║  l.37: 	  ([x,y] where (x == y))
//│ ╙──      	      ^






















let arr = fromArray of [1,2,3]
//│ arr = Cons(3, Cons(2, Cons(1, Nil)))


pattern Find(pattern P) =
  | ((P as p) :: t) => [p, t]
  | (h :: (Find(P) as [res, t])) => [res, h :: t]

if arr is
  Find(1) as res then res
//│ = [1, Cons(3, Cons(2, Nil))]
if arr is
  Find(2) as res then res
//│ = [2, Cons(3, Cons(1, Nil))]


pattern MultiSet(pattern Head, pattern Rest) =
  | Find(Head) as [h, Rest as t] => h :: t

arr is
  MultiSet(1, _)
//│ = true
arr is
  MultiSet(3, _)
//│ = true
arr is
  MultiSet(3, MultiSet(1, MultiSet(2, Nil)))
//│ = true
arr is
  MultiSet(3, MultiSet(0, _))
//│ = false





/////////////////


:fixme // ?
pattern MultiSet(pattern Head, pattern Rest) =
  | ((Head as h) :: (Rest as r)) => h :: r
  | ((h0 :: (Head as h) :: r) where ((h0 :: r) is (Rest as rst))) => h :: rst
//│ ╔══[COMPILATION ERROR] Name not found: rst
//│ ║  l.108: 	  | ((h0 :: (Head as h) :: r) where ((h0 :: r) is (Rest as rst))) => h :: rst
//│ ╙──       	                                                                          ^^^

  // | ((h0 :: (Head as h) :: r) and ((h0 :: r) is (Rest as rst))) => h :: rst


pattern MultiSet(pattern Head, pattern Rest) =
  | ((Head as h) :: (Rest as r)) => h :: r
  | (((h0 :: h :: r) => h :: h0 :: r) as MultiSet(Head, Rest) as res) => res

:re
arr is
  MultiSet(1, _)
//│ ═══[RUNTIME ERROR] RangeError: Maximum call stack size exceeded

arr is
  MultiSet(2, MultiSet(1, _))
//│ = true

:re
arr is
  MultiSet(1, MultiSet(_, _))
//│ ═══[RUNTIME ERROR] RangeError: Maximum call stack size exceeded

:fixme
if [1,2,3] is
  MultiSet(2, MultiSet(1, x)) do print(x)
//│ ╔══[COMPILATION ERROR] No definition found in scope for member 'x'
//│ ║  l.136: 	  MultiSet(2, MultiSet(1, x)) do print(x)
//│ ╙──       	                                       ^

pattern Id = _

:fixme
if [1,2,3] is
