pattern P = (x :: xs) => [x, xs]

1 :: Nil is P
//│ = true

let f = case
  P as extr then extr
//│ f = fun
f(1 :: 2 :: 3 :: Nil)
//│ = [1, Cons(2, Cons(3, Nil))]


pattern P(x, xs) = x :: xs


1 :: Nil is P
//│ = true

1 :: Nil is P(a, b)
//│ = true


let f = case
  P(x, xs) then [x, xs]
//│ f = fun
f(1 :: 2 :: 3 :: Nil)
//│ = [1, Cons(2, Cons(3, Nil))]

let f = case
  P as extracted then extracted
//│ f = fun
f(1 :: 2 :: 3 :: Nil)
//│ = [1, Cons(2, Cons(3, Nil))]


