import "../mlscript-compile/Iter.mls"


// :dp
// 1 * 2


2 + 2
//│ = 4

1 + 2
  * 3
//│ = 7

1 + 2
  * 2
  * 2
//│ = 9

1 + 2
  * 3 + 1
//│ = 8

1 + 2
  * 3
    + 1
//│ = 8

:pe
1 + 2
  * 3 + 1
  * 3
//│ ╔══[PARSE ERROR] Operator cannot be used inside this operator split
//│ ║  l.42: 	  * 3 + 1
//│ ║        	      ^
//│ ╟── as it has lower precedence than the splitting operator here
//│ ║  l.42: 	  * 3 + 1
//│ ╙──      	  ^
//│ = 28

// :pe
1 + 2
  * 3
  * 3 + 1
//│ = 8

1 + 2
  + 3
  * 3 + 1
//│ = 19


fun inc(x) = x + 1

42
  \inc()
  \inc()
//│ = 44


[1, 2, 3] \Iter.mapping(inc) \Iter.toStack()
//│ = Cons(2, Cons(3, Cons(4, Nil)))

[1, 2, 3]
  \Iter.mapping(inc)
  \Iter.toStack()
//│ = Cons(2, Cons(3, Cons(4, Nil)))


1\inc()
//│ = 2


let x = 1
//│ x = 1

if x is
  0 then "zero"
  1 then "one"
//│ = "one"


:p
if x >
  0 then true
//│ |if| |x| |>|→|0| |then| |true|←|
//│ Parsed:
//│ 	IfLike(keyword 'if',None,OpApp(Ident(x),Ident(>),List(Block(List(InfixApp(IntLit(0),keyword 'then',BoolLit(true)))))))
//│ = true

:w
x >
  1
  0
//│ ╔══[WARNING] Pure expression in statement position
//│ ║  l.104: 	  1
//│ ╙──       	  ^
//│ = true

:p
