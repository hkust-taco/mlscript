// :dp
// 1 * 2


2 + 2
//│ = 4

1 + 2
  * 3
//│ = 7

1 + 2
  * 2
  * 2
//│ = 9

1 + 2
  * 3 + 1
//│ = 8

1 + 2
  * 3
    + 1
//│ = 8

:pe
1 + 2
  * 3 + 1
  * 3
