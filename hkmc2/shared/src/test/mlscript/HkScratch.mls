// Test merging branches
:ucs normalized
fun foo(x) = if x is
  Pair(A, A) then 0
  Pair(B, B) then 1
//│ Normalized:
//│ >  if x is Pair.class(param0, param1) and
//│ >    $param0 is A $param1 is A then 0
//│ >    $param0 is B $param1 is B then 1

:ucs normalized
fun foo(x) = if x is
  Pair(A, A) then 0
  Pair(A, B) then 1
//│ Normalized:
//│ >  if x is Pair.class(param0, param1) and $param0 is A and
//│ >    $param1 is A then 0
//│ >    $param1 is B then 1

:ucs normalized
fun foo(x) = if x is
  Pair(A, A) then 0
  Pair(A, B) then 1
  Pair(B, A) then 2
  Pair(B, B) then 3
//│ Normalized:
//│ >  if x is Pair.class(param0, param1) and
//│ >    $param0 is A and
//│ >      $param1 is A then 0
//│ >      $param1 is B then 1
//│ >    $param0 is B and
//│ >      $param1 is A then 2
//│ >      $param1 is B then 3

let aa = Pair(new A, new A)
//│ aa = Pair(A, A)

foo(aa)
//│ = 0

import "../mlscript-compile/Runtime.mls"

fun foo(x) = if x is Runtime.MatchResult(y) then y else 0
