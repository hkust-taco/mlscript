class Eff

:effectHandlers
:sjs
:lift
fun foo(h) = h.perform
handle h = Eff with
  fun perform(resume) =
    let fuck = ()
    set fuck = n =>
      if n <= 0 then 0
      else n + fuck(n-1)
    resume(fuck(10000))
foo(h)
