:sir
:sjs
object Foo with
  fun test() =
    () => this
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let Foo1;
//│ (class Foo {
//│   static {
//│     new this
//│   }
//│   constructor() {
//│     Foo1 = this;
//│     Object.defineProperty(this, "class", {
//│       value: Foo
//│     });
//│     globalThis.Object.freeze(this);
//│   }
//│   test() {
//│     let lambda;
//│     const this$Foo = this;
//│     lambda = (undefined, function () {
//│       return this$Foo
//│     });
//│     return lambda
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["object", "Foo"]; 
//│ });
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let Foo⁰;
//│ define Foo⁰ as object Foo¹ {
//│   method test⁰ = fun test¹() {
//│     let lambda;
//│     define lambda as fun lambda⁰() { return Foo¹.this };
//│     return lambda⁰
//│   }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

