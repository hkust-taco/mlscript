data class Pair(x, y)

// Less parameters should also work.
fun foo(x) = if x is Pair(y) then y
//│ ╔══[ERROR] mismatched arity: expect 2, found 1
//│ ║  l.42: 	fun foo(x) = if x is Pair(y) then y
//│ ╙──      	                          ^

// More parameters should not be generated.
