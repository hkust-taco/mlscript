
:global
:wasm


class A
class B extends A
//│ Wasm result:
//│ = {}


class A(val x)
class B(val y) extends A(1)
B(2).y
//│ Wasm result:
//│ = 2


class A(val x)
class B(val y) extends A(y + 1)
let b = B(2)
b.x
//│ Wasm result:
//│ = 3


class A(val x)
class B(val y) extends A(1)
B(2).x
//│ Wasm result:
//│ = 1


class A(val x)
class B(val y) extends A(1)
fun getX(b: B) = b.x
getX(B(2))
//│ Wasm result:
//│ = 1


class A(val x)
class B(val y) extends A(1) with
  val z = this.x
B(2).z
//│ Wasm result:
//│ = 1


class A(val x)
class B(val y) extends A(y) with
    val z = this.y
B(1).z
//│ Wasm result:
//│ = 1


:wat
class Plain(val x) with
  val y = this.x
Plain(42).y
//│ Wat:
//│ (module
//│   (type $Object (sub (struct (field $$tag (mut i32)))))
//│   (type $Plain (sub $Object (struct (field $$tag (mut i32)) (field $x (mut (ref null any))) (field $y (mut (ref null any))))))
//│   (type $Plain_ctor (func (param $x (ref null any)) (result (ref null any))))
//│   (type $entry1 (func (result (ref null any))))
//│   (func $Plain_ctor (type $Plain_ctor) (param $x (ref null any)) (result (ref null any))
//│     (local $this (ref null any))
//│     (block (result (ref null any))
//│       (local.set $this
//│         (struct.new_default $Plain))
//│       (struct.set $Plain $$tag
//│         (ref.cast (ref $Plain)
//│           (local.get $this))
//│         (i32.const 1))
//│       (block
//│         (struct.set $Plain $x
//│           (ref.cast (ref $Plain)
//│             (local.get $this))
//│           (local.get $x))
//│         (block
//│           (struct.set $Plain $y
//│             (ref.cast (ref $Plain)
//│               (local.get $this))
//│             (struct.get $Plain $x
//│               (ref.cast (ref $Plain)
//│                 (local.get $this))))
//│           (nop)))
//│       (return
//│         (local.get $this))))
//│   (export "Plain_ctor" (func $Plain_ctor))
//│   (elem declare func $Plain_ctor)
//│   (func $entry (type $entry1) (result (ref null any))
//│     (local $Plain (ref null any))
//│     (local $tmp (ref null any))
//│     (block (result (ref null any))
//│       (nop)
//│       (block (result (ref null any))
//│         (local.set $tmp
//│           (call $Plain_ctor
//│             (ref.i31
//│               (i32.const 42))))
//│         (struct.get $Plain $y
//│           (ref.cast (ref $Plain)
//│             (local.get $tmp))))))
//│   (export "entry" (func $entry))
//│   (elem declare func $entry))
//│ Wasm result:
//│ = 42


class A(val x)
class B(val y) extends A(y)
class C(val z) extends B(z)
fun getX(c: C) = c.x
getX(C(3))
//│ Wasm result:
//│ = 3


class A(val x)
class B(val y) extends A(y)
B(1).y === A(1).x
//│ Wasm result:
//│ = 1


class A(val x)
class B(val y) extends A(y)
B(1).x === A(1).x
//│ Wasm result:
//│ = 1


class A(val x) with
    set x += 1
class B(val y) extends A(y)
B(1).x
//│ Wasm result:
//│ = 2


class A(val x)
class B(val y) extends A(y + 1)
B(1).x
//│ Wasm result:
//│ = 2


class A(val x)
class B(val y) extends A(y + 1) with
  val z = this.x
B(1).z
//│ Wasm result:
//│ = 2


class A(val x) with
  val s = x + 1
class B(val y) extends A(y + 1) with
  set this.s += 1
B(1).s
//│ Wasm result:
//│ = 4


class A(val x) with
  val s = x + 1
class B(val y) extends A(y + 1)
let b = B(1)
set b.s = 5
b.s
//│ Wasm result:
//│ = 5


class A()
class B() extends A()
B() is A
//│ Wasm result:
//│ = 1


class A()
class B() extends A()
let b = B()
if b is A then 1 else 0
//│ Wasm result:
//│ = 1


class A(val x)
class B(val y) extends A(1)
if B(2) is A(a) then a else 0
//│ Wasm result:
//│ = 1


class Bar(val a)
class Foo(val x, val y) extends Bar(x + y)
if Foo(1,2) is Foo(x,y) then Foo(1,2).a
//│ Wasm result:
//│ = 3


class Bar(val a)
class Foo(val x) extends Bar(x * 2)
fun getXor(f) = if f is Foo(z) then f.a else 0
getXor(Foo(42))
//│ Wasm result:
//│ = 84


class Foo(val x)
class Bar(val y) extends Foo(y + y)
class Baz(val z) extends Bar(z - 1)
if Baz(10) is
  Foo(a) then a
  Bar(b) then b
  Baz(c) then c
  else 0
//│ Wasm result:
//│ = 18


class Bar(val y)
class Baz(val z) extends Bar(not z)
if Baz(true) is
  Bar(a) then if a then Bar(a).y else a
  Baz(b) then b
  else 2
//│ Wasm result:
//│ = 0


:fixme
