class A(val a) with
  virtual fun f(x) = x + a
class B(val b) extends A(b) with
  fun f(x) = x * b
class C(val c) extends B(c) with
  fun f(x) = x - c
C(3).f(5)
//│ Wasm result:
//│ = 2
