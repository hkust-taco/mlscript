class A(val a) with
  open fun f(x) = x + a
class B(val b) extends A(b) with
  open override fun f(x) = x * b
class C(val c) extends B(c) with
  override fun f(x) = x - c
C(3).f(5)
//│ Wasm result:
//│ = 2


class A() with
  open fun f() = 1
class B() extends A() with
  open fun g() = 2
class C() extends B() with
  override fun f() = 10
  override fun g() = 20
fun callF(a: A) = a.f()
fun callG(b: B) = b.g()
callF(C()) + callG(C())
//│ Wasm result:
//│ = 30


