// An override must produce only representations of the inherited result. `Producer.get`'s result is inferred
// from its body, so an override returning a string is rejected, rather than trapping when its result is cast
// to the result type of the shared slot.
:ge
class Producer() with
  open fun get() = new Producer()
class StrProducer() extends Producer() with
  override fun get() = "str"
fun produce(p) = p.get()
produce(StrProducer())
//│ ╔══[COMPILATION ERROR] Overriding member 'get' produces values represented as 'Str', which the member it overrides cannot produce: its results are represented as 'Producer'
//│ ║  l.+4: 	  override fun get() = "str"
//│ ║        	               ^^^
//│ ╟── The overridden member 'get' is defined here
//│ ║  l.+2: 	  open fun get() = new Producer()
//│ ╙──      	           ^^^
//│ Wasm result:
//│ ═══[RUNTIME ERROR] RuntimeError: illegal cast


// An unannotated parameter of an override takes the inherited representation, inferred here from calls through
// `Consumer`. A direct call passing a string is rejected, rather than trapping on the cast to the shared slot's
// parameter type.
:ge
class Consumer() with
  open fun take(x) = x
class EchoConsumer() extends Consumer() with
  override fun take(x) = x
fun consume(c) = c.take(1)
consume(Consumer())
consume(EchoConsumer())
EchoConsumer().take("s")
