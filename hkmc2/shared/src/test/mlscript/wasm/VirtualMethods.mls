// Boxed types are bridged by casts, so they need not match
class R1() with
  open fun h(x: Int): Anything = x
class R2() extends R1() with
  override fun h(x) = x
R2().h(3)
//│ Wasm result:
//│ = 3


// The vtable slot carries the base declaration's result, which erases to `anyref`. Since `Child` declares
// `get(): Child`, the call `c.get()` must return a `Child`, so the call result is narrowed back with a
// checked cast that traps if it does not.
:noInline
:wat
