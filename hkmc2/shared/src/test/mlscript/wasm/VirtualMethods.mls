// Overrides share the slot's Wasm function type, so primitives must match exactly - here in the result.
:ge
class M1() with
  open fun f(m: Int32): Int32 = m
class M2() extends M1() with
  override fun f(m: Int32): Int = 0
M2().f(1)
//│ ╔══[COMPILATION ERROR] Overriding member 'f' produces values represented as 'Int', which the member it overrides cannot produce: its results are represented as 'Int32'
//│ ║  l.+4: 	  override fun f(m: Int32): Int = 0
//│ ║        	               ^
//│ ╟── The overridden member 'f' is defined here
//│ ║  l.+2: 	  open fun f(m: Int32): Int32 = m
//│ ╙──      	           ^
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int' at an unrelated type 'Int32'
//│ ║  l.+5: 	M2().f(1)
//│ ╙──      	       ^
//│ ╔══[COMPILATION ERROR] Overriding method `f` declares result as `(ref null i31)`, but the method it overrides declares `i32`
//│ ║  l.+4: 	  override fun f(m: Int32): Int = 0
//│ ╙──      	           ^^^^^^^^^^^^^^^^^^^^^^^^


// The same rule on a parameter. An unannotated parameter of an override takes the inherited
// representation, so only a declared one can differ: here `m: Int` erases to `anyref` rather than `i32`.
:ge
class N1() with
  open fun g(m: Int32): Int32 = m
class N2() extends N1() with
  override fun g(m: Int): Int32 = n32
N2().g(n32)
