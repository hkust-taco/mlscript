:.
:noInline



data class Box(x)
//│ Wasm result:
//│ = {}


// A cast proved to succeed does not keep an otherwise-unused allocation live.
:flowBasedOpt mono
:soir
fun cast() =
  let x = Box(1)
  val unused: Box = x as Object
  42
cast()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define cast⁰ as fun cast¹() { return 42 }; return cast¹()
//│ Wasm result:
//│ = 42

:flowBasedOpt mono
:soir
fun cast() =
  let x = Box(1)
  val unused = x as Object
  val tmp: Box = unused
  42
cast()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define cast² as fun cast³() { do (undefined as! Box⁰); return 42 }; return cast³()
//│ Wasm result:
//│ = 42



:flowBasedOpt mono
:soir
fun f() =
  fun mk(): Box = Box(1)
  val u: Box = mk()
  42
f()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define f⁰ as fun f¹() {
//│   let mk;
//│   define mk as fun mk⁰() { return undefined };
//│   do mk⁰();
//│   return 42
//│ };
//│ return f¹()
//│ Wasm result:
//│ = 42



// A known identity call also permits removal of its unused argument and allocation.
:flowBasedOpt mono
:soir
fun f() =
  fun take(b: Box) = b
  val u = take(Box(1))
  42
f()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define f² as fun f³() {
//│   let take;
//│   define take as fun take⁰() { return undefined };
//│   do take⁰();
//│   return 42
//│ };
//│ return f³()
//│ Wasm result:
//│ = 42
