
:global
:wasm

[]
//│ Wasm result:
//│ = {}

[0, 1, 2]
//│ Wasm result:
//│ = {}

fun makePair(x, y) = [x, y]
makePair(1, 2).[1]
//│ Wasm result:
//│ = 2

class Foo(val x, val y)
let b = [Foo(0, 1), true, 2]
if b.[0] is Foo(x, y) then x else 3
//│ Wasm result:
//│ = 0

let nums = [1, 2, 3]
nums.[-1]
//│ Wasm result:
//│ = 3

let nums = mut [1, 2, 3]
set nums.[0] = 0
nums.[0]
//│ Wasm result:
//│ = 0

:re
let nums = [1, 2, 3]
set nums.[0] = 0
nums.[0]
//│ Wasm result:
//│ ═══[RUNTIME ERROR] RuntimeError: illegal cast

:re
let nums = [1, 2, 3]
nums.[3]
//│ Wasm result:
//│ ═══[RUNTIME ERROR] RuntimeError: array element access out of bounds


:wat
let c = [10, 20, 30, 40]
c.[3]
//│ Wat:
//│ (module
//│   (type $TypeInfoBase (sub (struct (field $$tag i32) (field $$parent (ref null $TypeInfoBase)))))
