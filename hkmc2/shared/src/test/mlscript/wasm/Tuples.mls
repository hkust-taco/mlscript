//│         (array.new_fixed $TupleArray 4
//│           (ref.i31
//│             (i32.const 10))
//│           (ref.i31
//│             (i32.const 20))
//│           (ref.i31
//│             (i32.const 30))
//│           (ref.i31
//│             (i32.const 40))))
//│       (return
//│         (if (result (ref null any))
//│           (ref.test (ref null $TupleArrayMut)
//│             (local.tee $tuple
//│               (global.get $c)))
//│           (then
//│             (array.get $TupleArrayMut
//│               (ref.cast (ref $TupleArrayMut)
//│                 (local.get $tuple))
//│               (i32.const 3)))
//│           (else
//│             (array.get $TupleArray
//│               (ref.cast (ref $TupleArray)
//│                 (local.get $tuple))
//│               (i32.const 3)))))))
//│   (elem $entry declare func $entry))
