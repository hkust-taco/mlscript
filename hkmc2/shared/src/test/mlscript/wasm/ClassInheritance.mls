
:global
:wasm


class A
class B extends A
//│ Wasm result:
//│ = {}


class A(val x)
class B(val y) extends A(1)
B(2).y
//│ Wasm result:
//│ = 2


class A()
class B() extends A()
B() is A
//│ Wasm result:
//│ = 1


class A()
class B() extends A()
let b = B()
if b is A then 1 else 0
//│ Wasm result:
//│ = 1


class A(val x)
class B(val y) extends A(1)
if B(2) is A(a) then a else 0
//│ Wasm result:
//│ = 1


class Bar(val a)
class Foo(val x, val y) extends Bar(x + y)
if Foo(1,2) is Foo(x,y) then Foo(1,2).a
//│ Wasm result:
//│ = 3


class Bar(val a)
class Foo(val x) extends Bar(x * 2)
fun getXor(f) = if f is Foo(z) then f.a else 0
getXor(Foo(42))
//│ Wasm result:
//│ = 84


