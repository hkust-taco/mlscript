
:global
:wasm


class A(val x)
class B(val y) extends A(y + 1)
let b = B(1)
b.A#x
//│ Wasm result:
//│ = 2


class A(val x)
class B(val y) extends A(1)
B(2).A#x
//│ Wasm result:
//│ = 1


:wat
// Parent type/init/ctor appear before child
let c = Child(2)
class Child(val y) extends Parent(y + 1)
class Parent(val x)
c.Parent#x + (c is Parent)
//│ Wat:
//│ (module
//│   (type $TypeInfoBase (sub (struct (field $$tag i32) (field $$parent (ref null $TypeInfoBase)))))
//│   (type $Object (sub (struct (field $$typeinfo (mut (ref $TypeInfoBase))))))
//│   (type $Parent (sub $Object (struct (field $$typeinfo (mut (ref $TypeInfoBase))) (field $x (mut (ref null any))))))
//│   (type $Child (sub $Parent (struct (field $$typeinfo (mut (ref $TypeInfoBase))) (field $x (mut (ref null any))) (field $y (mut (ref null any))))))
//│   (type $Parent_typeinfo (sub $TypeInfoBase (struct (field $$tag i32) (field $$parent (ref null $TypeInfoBase)))))
//│   (type $Parent_init (func (param $this (ref $Parent)) (param $x (ref null any)) (result (ref $Parent))))
//│   (type $Parent_ctor (func (param $x (ref null any)) (result (ref $Parent))))
//│   (type $Child_typeinfo (sub $Parent_typeinfo (struct (field $$tag i32) (field $$parent (ref null $TypeInfoBase)))))
//│   (type $Child_init (func (param $this (ref $Child)) (param $y (ref null any)) (result (ref $Child))))
//│   (type $Child_ctor (func (param $y (ref null any)) (result (ref $Child))))
//│   (type $plus_impl (func (param $lhs (ref null any)) (param $rhs (ref null any)) (result (ref null any))))
//│   (type $entry (func (result (ref null any))))
//│   (import "system" "plus_impl" (func $plus_impl (type $plus_impl)))
//│   (global $c (export "c") (mut (ref null any)) (ref.null any))
//│   (global $Parent_typeinfo (export "Parent_typeinfo") (ref $Parent_typeinfo) (struct.new $Parent_typeinfo
//│     (i32.const 1)
//│     (ref.null $TypeInfoBase)))
//│   (global $Child_typeinfo (export "Child_typeinfo") (ref $Child_typeinfo) (struct.new $Child_typeinfo
//│     (i32.const 2)
//│     (global.get $Parent_typeinfo)))
//│   (func $Parent_init (type $Parent_init) (param $this (ref $Parent)) (param $x (ref null any)) (result (ref $Parent))
//│     (block (result (ref $Parent))
//│       (struct.set $Parent $x
//│         (local.get $this)
//│         (local.get $x))
//│       (return
//│         (ref.cast (ref $Parent)
//│           (local.get $this)))))
//│   (func $Parent_ctor (export "Parent") (type $Parent_ctor) (param $x (ref null any)) (result (ref $Parent))
//│     (local $this (ref $Parent))
//│     (block (result (ref $Parent))
//│       (local.set $this
//│         (struct.new $Parent
//│           (global.get $Parent_typeinfo)
//│           (ref.null any)))
//│       (drop
//│         (call $Parent_init
//│           (local.get $this)
//│           (local.get $x)))
//│       (return
//│         (local.get $this))))
//│   (func $Child_init (type $Child_init) (param $this (ref $Child)) (param $y (ref null any)) (result (ref $Child))
//│     (local $tmp (ref null any))
//│     (block (result (ref $Child))
//│       (local.set $tmp
//│         (call $plus_impl
//│           (local.get $y)
//│           (ref.i31
//│             (i32.const 1))))
//│       (drop
//│         (call $Parent_init
//│           (local.get $this)
//│           (local.get $tmp)))
//│       (struct.set $Child $y
//│         (local.get $this)
//│         (local.get $y))
//│       (return
//│         (ref.cast (ref $Child)
//│           (local.get $this)))))
//│   (func $Child_ctor (export "Child") (type $Child_ctor) (param $y (ref null any)) (result (ref $Child))
//│     (local $this (ref $Child))
//│     (block (result (ref $Child))
//│       (local.set $this
//│         (struct.new $Child
//│           (global.get $Child_typeinfo)
//│           (ref.null any)
//│           (ref.null any)))
//│       (drop
//│         (call $Child_init
//│           (local.get $this)
//│           (local.get $y)))
//│       (return
//│         (local.get $this))))
//│   (func $entry (export "entry") (type $entry) (result (ref null any))
//│     (local $matchRes (ref null any))
//│     (local $currentTypeInfo (ref null any))
//│     (local $targetTypeInfo (ref null any))
//│     (local $typeInfoMatch (ref null i31))
//│     (block
//│       (global.set $c
//│         (call $Child_ctor
//│           (ref.i31
//│             (i32.const 2))))
//│       (block $match
//│         (local.set $matchRes
//│           (ref.null any))
//│         (if
//│           (ref.test (ref $Object)
//│             (global.get $c))
//│           (then
//│             (if
//│               (block (result i32)
//│                 (local.set $currentTypeInfo
//│                   (struct.get $Object $$typeinfo
//│                     (ref.cast (ref $Object)
//│                       (global.get $c))))
//│                 (local.set $targetTypeInfo
//│                   (global.get $Parent_typeinfo))
//│                 (local.set $typeInfoMatch
//│                   (ref.i31
//│                     (i32.const 0)))
//│                 (block $typeInfo
//│                   (loop $typeInfo_cont
//│                     (if
//│                       (ref.is_null
//│                         (local.get $currentTypeInfo))
//│                       (then
//│                         (br $typeInfo)))
//│                     (if
//│                       (ref.eq
//│                         (ref.cast (ref null eq)
//│                           (local.get $currentTypeInfo))
//│                         (ref.cast (ref null eq)
//│                           (local.get $targetTypeInfo)))
//│                       (then
//│                         (block
//│                           (local.set $typeInfoMatch
//│                             (ref.i31
//│                               (i32.const 1)))
//│                           (br $typeInfo))))
//│                     (local.set $currentTypeInfo
//│                       (struct.get $TypeInfoBase $$parent
//│                         (ref.cast (ref $TypeInfoBase)
//│                           (local.get $currentTypeInfo))))
//│                     (br $typeInfo_cont)))
//│                 (i31.get_s
//│                   (ref.cast (ref null i31)
//│                     (local.get $typeInfoMatch))))
//│               (then
//│                 (block $arm
//│                   (return
//│                     (call $plus_impl
//│                       (struct.get $Parent $x
//│                         (ref.cast (ref $Parent)
//│                           (global.get $c)))
//│                       (ref.i31
//│                         (i32.const 1)))))))))
//│         (return
//│           (call $plus_impl
//│             (struct.get $Parent $x
//│               (ref.cast (ref $Parent)
//│                 (global.get $c)))
//│             (ref.i31
//│               (i32.const 0)))))
//│       (unreachable)))
//│   (elem $Parent_init declare func $Parent_init)
//│   (elem $Parent_ctor declare func $Parent_ctor)
//│   (elem $Child_init declare func $Child_init)
//│   (elem $Child_ctor declare func $Child_ctor)
//│   (elem $entry declare func $entry))
//│ Wasm result:
//│ = 4


class A(val x)
class B(val y) extends A(y + 1)
class C(val z) extends B(z + 1)
let c = C(1)
c.A#x
//│ Wasm result:
//│ = 3


class A()
class B() extends A()
B() is A
//│ Wasm result:
//│ = 1


class B() extends A()
class A()
let b = B()
if b is A then 1 else 0
//│ Wasm result:
//│ = 1


class A(val x)
class B(val y) extends A(1)
if B(2) is A(a) then a else 0
//│ Wasm result:
//│ = 1


class Bar(val a)
class Foo(val x, val y) extends Bar(x + y)
if Foo(1,2) is Foo(x,y) then Foo(1,2).Bar#a
//│ Wasm result:
//│ = 3


class Bar(val a)
class Foo(val x) extends Bar(x * 2)
fun getXor(f) = if f is Foo(z) then f.Bar#a else 0
getXor(Foo(42))
//│ Wasm result:
//│ = 84


class Foo(val x)
class Bar(val y) extends Foo(y + y)
class Baz(val z) extends Bar(z - 1)
if Baz(10) is
  Foo(a) then a
  Bar(b) then b
  Baz(c) then c
  else 0
//│ Wasm result:
//│ = 18


class Bar(val y)
class Baz(val z) extends Bar(not z)
if Baz(true) is
  Bar(a) then if a then Bar(a).Bar#y else a
  Baz(b) then b
  else 2
//│ Wasm result:
//│ = 0


class A()
class B()
B() is A
//│ Wasm result:
//│ = 0


// Unrelated top-level classes preserve their source order in type declaration.
// :wat // too much needless wat output
class A 
class B
//│ Wasm result:
//│ = {}


:ge
class A extends B
class B extends A
//│ ╔══[COMPILATION ERROR] Inheritance cycles are not supported.
//│ ║  l.267: 	class A extends B
//│ ╙──       	^^^^^^^^^^^^^^^^^


// Forward references resolve because class identities are allocated before any layout is built, and
// class types are emitted in dependency order. Otherwise `b` is typed `anyref`, or `$Forward` is
// declared before the `$Later` it references, and the emitted module is invalid wasm.
:noInline
class Forward(val b: Later) with
  fun get(): Later = b
class Later(val n: Int)
fun readForward(f: Forward): Later = f.get()
readForward(new Forward(new Later(7))).n
//│ Wasm result:
//│ = 7


// A self-reference resolves through the same mechanism: the class's own identity already exists
// when its layout is built. Otherwise `next` is stored as `anyref` and `get` is rejected at
// compilation.
:noInline
class SelfNode() with
  val next: SelfNode = this
  fun get(): SelfNode = next
if new SelfNode().get() is SelfNode then 1 else 0
//│ Wasm result:
//│ = 1


// Field dependencies put these classes in one recursive group. Traversing Ancestor's field discovers
// Descendant before Middle, but Wasm still requires each superclass to precede its subclasses in the group.
:noInline
class Ancestor(val child: Descendant)
class Middle(d: Descendant) extends Ancestor(d)
class Descendant() extends Middle(this)
if new Descendant() is Middle then 1 else 0
//│ Wasm result:
//│ = 1
