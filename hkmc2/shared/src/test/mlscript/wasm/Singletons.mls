fun test() =
  object Test with
    fun bar = 1
    fun foo() = Test.bar + 2
  Test.foo()
test()
//│ Wasm result:
//│ = 3


object Example with
  val a = 1
  fun f(x) = [x, a]
Example.f(2).[1]
//│ Wasm result:
//│ = 1


