// Two classes referencing each other form a cycle in the type graph. A cycle has no valid declaration
// order, so the layouts are emitted as one `(rec ...)` group instead of being sorted.
:noInline
class Ping(val other: Pong)
class Pong(val other: Ping)
()
//│ Wasm result:
//│ = {}


