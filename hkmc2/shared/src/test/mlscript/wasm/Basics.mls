// A primitive result has no `anyref` representation, so it cannot be widened and must be annotated. The IR
// rejects the widening; the backend reports it again, since a rejected value is left in place uncast. This is
// the unannotated-*result* case; `wasm/Casts.mls` covers the same rule for a value crossing an opaque call.
:ge
fun takeTop(m: Int32) = m
takeTop(1)
