
:global
:wasm

false
//│ Wasm result:
//│ = 0


true
//│ Wasm result:
//│ = 1


2
//│ Wasm result:
//│ = 2


1 + 1
//│ Wasm result:
//│ = 2


let x = 0
x
//│ Wasm result:
//│ = 0


:ge
fun foo() = 42
foo
//│ ╔══[COMPILATION ERROR] Returning function instances is not supported
//│ ║  l.33: 	foo
//│ ╙──      	^^^


fun foo() = 42
foo()
//│ Wasm result:
//│ = 42


fun foo() = 42
foo() + foo()
//│ Wasm result:
//│ = 84


fun foo(x) = x + 1
foo(41)
//│ Wasm result:
//│ = 42


class Foo(val x)
new Foo(0)
//│ Wasm result:
//│ = [Object: null prototype] {}


class Foo(val a)
(new Foo(42)).Foo#a
//│ Wasm result:
//│ = 42
