:.

:global
:wasm


// * Wasm functions have a fixed arity, so optional parameters are rejected.
:e
fun opt(x, y?) = x
opt(1)
//│ ╔══[COMPILATION ERROR] Optional parameters are not supported by the WebAssembly backend.
//│ ║  l.9: 	fun opt(x, y?) = x
//│ ╙──     	       ^^^^^^^

// * Nor can they take a variable number of arguments.
:e
fun rest(x, ...xs) = xs
rest(1, 2)
//│ ╔══[COMPILATION ERROR] Variadic parameters are not supported by the WebAssembly backend.
//│ ║  l.17: 	fun rest(x, ...xs) = xs
//│ ╙──      	            ^^^^^

// * Trailing parameters are lowered into a rest parameter, which is rejected in the same way.
:e
fun trailing(x, ...xs, y) = y
trailing(1, 2, 3)
//│ ╔══[COMPILATION ERROR] Variadic parameters are not supported by the WebAssembly backend.
//│ ║  l.25: 	fun trailing(x, ...xs, y) = y
//│ ╙──      	            ^^^^^^^^^^^^^

// * Constructor parameter lists obey the same backend restriction.
:e
class OptionalConstructor(val value?)
new OptionalConstructor()
//│ ╔══[COMPILATION ERROR] Optional parameters are not supported by the WebAssembly backend.
//│ ║  l.33: 	class OptionalConstructor(val value?)
//│ ╙──      	                         ^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Optional parameters are not supported by the WebAssembly backend.
//│ ║  l.33: 	class OptionalConstructor(val value?)
//│ ╙──      	                         ^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] WatBackend::result for Lit expression not implemented yet
//│ ║  l.34: 	new OptionalConstructor()
//│ ╙──      	                       ^^
