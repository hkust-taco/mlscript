//│ = {}


// Two members of one loop can defer casts at the same time, and the flags carry them independently.
// Entering at `wideOf` traverses both deferring edges, so the exit performs each in turn; the returned `Tip`
// satisfies both and passes through unharmed. `mkWide` declares the wider type so that the exits cannot show
// either cast redundant statically, which is what keeps both flags alive.
:noInline
:soir
class Wide()
class Middle() extends Wide()
class Tip() extends Middle()
fun tipOf(n: Int): Tip = midOf(n)
fun midOf(n: Int): Middle = wideOf(n)
fun wideOf(n: Int): Wide =
  if n <= 0 then
    val w: Wide = new Tip()
    w
  else tipOf(n - 1)
wideOf(2)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tipOf_midOf_wideOf;
//│ @private
//│ define tipOf_midOf_wideOf as fun tipOf_midOf_wideOf⁰(id, param0) {
//│   let tipOf$deferred, midOf$deferred;
//│   set tipOf$deferred = false;
//│   set midOf$deferred = false;
//│   loop loopLabel:
//│     match id
//│       0 =>
//│         set tipOf$deferred = true;
//│         set id = 1;
//│         continue loopLabel
//│       1 =>
//│         set midOf$deferred = true;
//│         set id = 2;
//│         continue loopLabel
//│       2 =>
//│         let w, scrut, tmp, tmp1;
//│         set scrut = wasm⁰.le_impl﹖(param0, 0);
//│         match scrut
//│           true =>
//│             let exitResult;
//│             set tmp = new Tip⁰();
//│             define w as val w⁰ = tmp;
//│             set exitResult = w⁰;
//│             match tipOf$deferred
//│               true =>
//│                 set exitResult = (w⁰ as! Tip⁰);
//│                 end
//│             match midOf$deferred
//│               true =>
//│                 return (exitResult as! Middle⁰)
//│               else
//│                 return exitResult
//│             end
//│           else
//│             set tmp1 = wasm⁰.minus_impl﹖(param0, 1);
//│             set param0 = (tmp1 as! Int⁰);
//│             set id = 0;
//│             continue loopLabel
//│         end
//│       else
//│         unreachable /* dispatch tag is always a merged member id */
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ @inline
//│ define tipOf⁰ as fun tipOf¹(n) {
//│   return (tipOf_midOf_wideOf⁰(0, n) as! Tip⁰)
//│ };
//│ @inline
//│ define midOf⁰ as fun midOf¹(n) {
//│   return (tipOf_midOf_wideOf⁰(1, n) as! Middle⁰)
//│ };
//│ @inline
//│ define wideOf⁰ as fun wideOf¹(n) {
//│   return tipOf_midOf_wideOf⁰(2, n)
//│ };
//│ define Wide⁰ as class Wide² {
//│   constructor Wide¹
//│ };
//│ define Middle¹ as class Middle⁰ extends Wide² {
//│   constructor Middle²
//│ };
//│ define Tip¹ as class Tip⁰ extends Middle⁰ { constructor Tip² };
//│ return wideOf¹(2)
//│ Wasm result:
//│ = {}


// Forward references must resolve consistently in class layouts and constructor signatures.
// Class identities are allocated before any layout is resolved, and class types are emitted in
// dependency order, so the field and the signatures reading it agree on `(ref $Later)`.
:noInline
class Forward(val b: Later) with
  fun get(): Later = b
class Later(val n: Int)
fun readForward(f: Forward): Later = f.get()
readForward(new Forward(new Later(7)))
//│ Wasm result:
//│ = {}


// An inhabited self-reference exposes the same ordering problem in field storage.
// A class resolves against its own identity, so next is stored as `(ref null $SelfNode)`.
:noInline
class SelfNode() with
  val next: SelfNode = this
  fun get(): SelfNode = next
if new SelfNode().get() is SelfNode then 1 else 0
//│ Wasm result:
//│ = 1


// Typed IR knows the covariant override's return type, while the virtual slot uses Object.
// The dispatch result is adapted to the resolved method's declared result, so readChild returns a Child.
:noInline
class Parent() with
  virtual fun get(): Object = new Parent()
class Child() extends Parent() with
  fun get(): Child = new Child()
fun readChild(c: Child): Child = c.get()
readChild(new Child())
//│ Wasm result:
//│ = {}


// Control: an Int32 conditional can already be returned directly.
:noInline
fun chooseDirect(b: Bool): Int32 = if b then wasm.i32.const(1) else wasm.i32.const(2)
chooseDirect(true)
//│ Wasm result:
//│ = 1


// Introducing an explicitly typed local must preserve the same primitive representation.
// The temporary holding the conditional's result takes the join of its branches' representations,
// so both i32 branches keep it instead of being forced through anyref.
:noInline
fun chooseLocal(b: Bool): Int32 =
  val x: Int32 = if b then wasm.i32.const(1) else wasm.i32.const(2)
  x
chooseLocal(true)
//│ Wasm result:
//│ = 1


// The same contract must be enforced when the loop leaves through a *call* rather than an instantiation.
// `TailCallShape` matches such a `Return` too, so recognizing it as a jump is not enough: when the callee
// lies outside the SCC the exit stays an exit, and it must still perform the casts the loop deferred.
:noInline
:soir
:re
class NarrowExit(val n: Int)
class OtherExit()
fun mkExit(): Object = new OtherExit()
fun narrowExit(n: Int): NarrowExit = broadExit(n)
fun broadExit(n: Int): Object = if n <= 0 then mkExit() else narrowExit(n - 1)
broadExit(1)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let narrowExit_broadExit;
//│ @private
//│ define narrowExit_broadExit as fun narrowExit_broadExit⁰(id, param0) {
//│   let narrowExit$deferred;
//│   set narrowExit$deferred = false;
//│   loop loopLabel:
//│     match id
//│       0 =>
//│         set narrowExit$deferred = true;
//│         set id = 1;
//│         continue loopLabel
//│       1 =>
//│         let scrut, tmp;
//│         set scrut = wasm⁰.le_impl﹖(param0, 0);
//│         match scrut
//│           true =>
//│             let exitResult;
//│             set exitResult = mkExit⁰();
//│             match narrowExit$deferred
//│               true =>
//│                 return (exitResult as! NarrowExit⁰)
//│               else
//│                 return exitResult
//│             end
//│           else
//│             set tmp = wasm⁰.minus_impl﹖(param0, 1);
//│             set param0 = (tmp as! Int⁰);
//│             set id = 0;
//│             continue loopLabel
//│         end
//│       else
//│         unreachable /* dispatch tag is always a merged member id */
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ define mkExit¹ as fun mkExit⁰() {
//│   return new OtherExit⁰()
//│ };
//│ @inline
//│ define narrowExit⁰ as fun narrowExit¹(n) {
//│   return (narrowExit_broadExit⁰(0, n) as! NarrowExit⁰)
//│ };
//│ @inline
//│ define broadExit⁰ as fun broadExit¹(n) {
//│   return narrowExit_broadExit⁰(1, n)
//│ };
//│ define NarrowExit¹ as class NarrowExit⁰ {
//│   val n⁴;
//│   constructor NarrowExit²(n) {
//│     define n⁴ as val n⁵ = n;
//│     end
//│   }
//│ };
//│ define OtherExit¹ as class OtherExit⁰ { constructor OtherExit² };
//│ return broadExit¹(1)
//│ Wasm result:
//│ ═══[RUNTIME ERROR] RuntimeError: illegal cast
