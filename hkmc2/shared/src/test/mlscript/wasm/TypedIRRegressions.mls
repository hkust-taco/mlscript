
:global
:wasm


// A class used only by a runtime cast must remain reachable after lifting. The cast records Local as a
// dependency, so it survives optimization and narrowLocal(42) traps instead of returning 42.
:noInline
:lift
:sir
:soir
:re
fun narrowLocal(x): Object =
  class Local()
  val y: Local = x
  y
narrowLocal(42)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let Local;
//│ define Local as class Local¹ {
//│   constructor Local⁰
//│ };
//│ define narrowLocal⁰ as fun narrowLocal¹(x) {
//│   let y;
//│   define y as val y⁰ = (x as! Local¹);
//│   return y⁰
//│ };
//│ return narrowLocal¹(42)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let Local;
//│ define Local as class Local¹ {
//│   constructor Local⁰
//│ };
//│ define narrowLocal⁰ as fun narrowLocal¹(x) {
//│   let y;
//│   define y as val y⁰ = (x as! Local¹);
//│   return y⁰
//│ };
//│ return narrowLocal¹(42)
//│ Wasm result:
//│ ═══[RUNTIME ERROR] RuntimeError: illegal cast


// The same dependency must be recorded when the cast is *returned* rather than bound to a val: the two
// arrive at different traversal entry points, and only one of them is a path. Lifting then floats Lifted
// out alongside the function that casts to it.
:noInline
:lift
:soir
:re
fun liftedNarrow(x): Object =
  class Lifted()
  fun narrow(y): Lifted = y
  narrow(x)
liftedNarrow(42)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let Lifted, narrow;
//│ define narrow as fun narrow⁰(y) {
//│   return (y as! Lifted⁰)
//│ };
//│ define Lifted as class Lifted⁰ {
//│   constructor Lifted¹
//│ };
//│ define liftedNarrow⁰ as fun liftedNarrow¹(x) { return narrow⁰(x) };
//│ return liftedNarrow¹(42)
//│ Wasm result:
//│ ═══[RUNTIME ERROR] RuntimeError: illegal cast


// Entering the broad member of this SCC must still enforce narrow's return contract.
// The different class layouts ensure that Wasm's structural type identity cannot mask the cast.
// Currently, TailRecOpt drops the intermediate cast and returns an Other.
:noInline
:soir
:re
:breakme // Entry-stub casts do not preserve intermediate return coercions.
class Narrow(val n: Int)
class Other()
fun narrow(n: Int): Narrow = broad(n)
fun broad(n: Int): Object = if n <= 0 then new Other() else narrow(n - 1)
broad(1)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let narrow_broad;
//│ @private
//│ define narrow_broad as fun narrow_broad⁰(id, param0) {
//│   loop loopLabel:
//│     match id
//│       0 =>
//│         set id = 1;
//│         continue loopLabel
//│       1 =>
//│         let scrut, tmp;
//│         set scrut = wasm⁰.le_impl﹖(param0, 0);
//│         match scrut
//│           true =>
//│             return new Other⁰()
//│           else
//│             set tmp = wasm⁰.minus_impl﹖(param0, 1);
//│             set param0 = (tmp as! Int⁰);
//│             set id = 0;
//│             continue loopLabel
//│         end
//│       else
//│         unreachable /* dispatch tag is always a merged member id */
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ @inline
//│ define narrow¹ as fun narrow²(n) {
//│   return (narrow_broad⁰(0, n) as! Narrow⁰)
//│ };
//│ @inline
//│ define broad⁰ as fun broad¹(n) {
//│   return narrow_broad⁰(1, n)
//│ };
//│ define Narrow¹ as class Narrow⁰ {
//│   val n⁰;
//│   constructor Narrow²(n) {
//│     define n⁰ as val n¹ = n;
//│     end
//│   }
//│ };
//│ define Other¹ as class Other⁰ { constructor Other² };
//│ return broad¹(1)
//│ Wasm result:
//│ = {}


// Control: without tail-recursion optimization, the same call traps as required.
:noInline
:noTailRec
:re
class NarrowControl(val n: Int)
class OtherControl()
fun narrowControl(n: Int): NarrowControl = broadControl(n)
fun broadControl(n: Int): Object = if n <= 0 then new OtherControl() else narrowControl(n - 1)
broadControl(1)
//│ Wasm result:
//│ ═══[RUNTIME ERROR] RuntimeError: illegal cast


// Forward references must resolve consistently in class layouts and constructor signatures.
// Class identities are allocated before any layout is resolved, and class types are emitted in
// dependency order, so the field and the signatures reading it agree on `(ref $Later)`.
:noInline
class Forward(val b: Later) with
  fun get(): Later = b
class Later(val n: Int)
fun readForward(f: Forward): Later = f.get()
readForward(new Forward(new Later(7)))
//│ Wasm result:
//│ = {}


// An inhabited self-reference exposes the same ordering problem in field storage.
// A class resolves against its own identity, so next is stored as `(ref null $SelfNode)`.
:noInline
class SelfNode() with
  val next: SelfNode = this
  fun get(): SelfNode = next
if new SelfNode().get() is SelfNode then 1 else 0
//│ Wasm result:
//│ = 1


// Typed IR knows the covariant override's return type, while the virtual slot uses Object.
// The dispatch result is adapted to the resolved method's declared result, so readChild returns a Child.
:noInline
class Parent() with
  virtual fun get(): Object = new Parent()
class Child() extends Parent() with
  fun get(): Child = new Child()
fun readChild(c: Child): Child = c.get()
readChild(new Child())
//│ Wasm result:
//│ = {}


// Control: an Int32 conditional can already be returned directly.
:noInline
fun chooseDirect(b: Bool): Int32 = if b then wasm.i32.const(1) else wasm.i32.const(2)
chooseDirect(true)
//│ Wasm result:
//│ = 1


// Introducing an explicitly typed local must preserve the same primitive representation.
// The temporary holding the conditional's result takes the join of its branches' representations,
// so both i32 branches keep it instead of being forced through anyref.
:noInline
fun chooseLocal(b: Bool): Int32 =
  val x: Int32 = if b then wasm.i32.const(1) else wasm.i32.const(2)
  x
chooseLocal(true)
//│ Wasm result:
//│ = 1
