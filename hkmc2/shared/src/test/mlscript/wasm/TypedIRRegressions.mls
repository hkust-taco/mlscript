
:global
:wasm


// A class used only by a runtime cast must remain reachable after lifting. The cast records Local as a
// dependency, so it survives optimization and narrowLocal(42) traps instead of returning 42.
:noInline
:lift
:sir
:soir
:re
fun narrowLocal(x): Object =
  class Local()
  val y: Local = x
  y
narrowLocal(42)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let Local;
//│ define Local as class Local¹ {
//│   constructor Local⁰
//│ };
//│ define narrowLocal⁰ as fun narrowLocal¹(x) {
//│   let y;
//│   define y as val y⁰ = (x as! Local¹);
//│   return y⁰
//│ };
//│ return narrowLocal¹(42)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let Local;
//│ define Local as class Local¹ {
//│   constructor Local⁰
//│ };
//│ define narrowLocal⁰ as fun narrowLocal¹(x) {
//│   let y;
//│   define y as val y⁰ = (x as! Local¹);
//│   return y⁰
//│ };
//│ return narrowLocal¹(42)
//│ Wasm result:
//│ ═══[RUNTIME ERROR] RuntimeError: illegal cast


// The same dependency must be recorded when the cast is *returned* rather than bound to a val: the two
// arrive at different traversal entry points, and only one of them is a path. Lifting then floats Lifted
// out alongside the function that casts to it.
:noInline
:lift
:soir
:re
fun liftedNarrow(x): Object =
  class Lifted()
  fun narrow(y): Lifted = y
  narrow(x)
liftedNarrow(42)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let Lifted, narrow;
//│ define narrow as fun narrow⁰(y) {
//│   return (y as! Lifted⁰)
//│ };
//│ define Lifted as class Lifted⁰ {
//│   constructor Lifted¹
//│ };
//│ define liftedNarrow⁰ as fun liftedNarrow¹(x) { return narrow⁰(x) };
//│ return liftedNarrow¹(42)
//│ Wasm result:
//│ ═══[RUNTIME ERROR] RuntimeError: illegal cast


// Entering the broad member of this SCC must still enforce narrow's return contract.
// The different class layouts ensure that Wasm's structural type identity cannot mask the cast.
// TailRecOpt used to drop the intermediate cast and return an Other; the coercion is now carried to the exit.
:noInline
:soir
:re
class Narrow(val n: Int)
class Other()
fun narrow(n: Int): Narrow = broad(n)
fun broad(n: Int): Object = if n <= 0 then new Other() else narrow(n - 1)
broad(1)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let narrow_broad;
//│ @private
//│ define narrow_broad as fun narrow_broad⁰(id, param0) {
//│   let narrow$deferred;
//│   set narrow$deferred = false;
//│   loop loopLabel:
//│     match id
//│       0 =>
//│         set narrow$deferred = true;
//│         set id = 1;
//│         continue loopLabel
//│       1 =>
//│         let scrut, tmp;
//│         set scrut = wasm⁰.le_impl﹖(param0, 0);
//│         match scrut
//│           true =>
//│             let exitResult;
//│             set exitResult = new Other⁰();
//│             match narrow$deferred
//│               true =>
//│                 return (exitResult as! Narrow⁰)
//│               else
//│                 return exitResult
//│             end
//│           else
//│             set tmp = wasm⁰.minus_impl﹖(param0, 1);
//│             set param0 = (tmp as! Int⁰);
//│             set id = 0;
//│             continue loopLabel
//│         end
//│       else
//│         unreachable /* dispatch tag is always a merged member id */
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ @inline
//│ define narrow¹ as fun narrow²(n) {
//│   return (narrow_broad⁰(0, n) as! Narrow⁰)
//│ };
//│ @inline
//│ define broad⁰ as fun broad¹(n) {
//│   return narrow_broad⁰(1, n)
//│ };
//│ define Narrow¹ as class Narrow⁰ {
//│   val n⁰;
//│   constructor Narrow²(n) {
//│     define n⁰ as val n¹ = n;
//│     end
//│   }
//│ };
//│ define Other¹ as class Other⁰ { constructor Other² };
//│ return broad¹(1)
//│ Wasm result:
//│ ═══[RUNTIME ERROR] RuntimeError: illegal cast


// Control: without tail-recursion optimization, the same call traps as required.
:noInline
:noTailRec
:re
class NarrowControl(val n: Int)
class OtherControl()
fun narrowControl(n: Int): NarrowControl = broadControl(n)
fun broadControl(n: Int): Object = if n <= 0 then new OtherControl() else narrowControl(n - 1)
broadControl(1)
//│ Wasm result:
//│ ═══[RUNTIME ERROR] RuntimeError: illegal cast


// Entering the same loop through the member that defers nothing leaves its flag unset, so the exit returns
// its value unchanged rather than performing a cast the run never deferred.
:noInline
:soir
class NarrowUnset(val n: Int)
class OtherUnset()
fun narrowUnset(n: Int): NarrowUnset = broadUnset(n)
fun broadUnset(n: Int): Object = if n <= 0 then new OtherUnset() else narrowUnset(n - 1)
broadUnset(0)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let narrowUnset_broadUnset;
//│ @private
//│ define narrowUnset_broadUnset as fun narrowUnset_broadUnset⁰(id, param0) {
//│   let narrowUnset$deferred;
//│   set narrowUnset$deferred = false;
//│   loop loopLabel:
//│     match id
//│       0 =>
//│         set narrowUnset$deferred = true;
//│         set id = 1;
//│         continue loopLabel
//│       1 =>
//│         let scrut, tmp;
//│         set scrut = wasm⁰.le_impl﹖(param0, 0);
//│         match scrut
//│           true =>
//│             let exitResult;
//│             set exitResult = new OtherUnset⁰();
//│             match narrowUnset$deferred
//│               true =>
//│                 return (exitResult as! NarrowUnset⁰)
//│               else
//│                 return exitResult
//│             end
//│           else
//│             set tmp = wasm⁰.minus_impl﹖(param0, 1);
//│             set param0 = (tmp as! Int⁰);
//│             set id = 0;
//│             continue loopLabel
//│         end
//│       else
//│         unreachable /* dispatch tag is always a merged member id */
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ @inline
//│ define narrowUnset⁰ as fun narrowUnset¹(n) {
//│   return (narrowUnset_broadUnset⁰(0, n) as! NarrowUnset⁰)
//│ };
//│ @inline
//│ define broadUnset⁰ as fun broadUnset¹(n) {
//│   return narrowUnset_broadUnset⁰(1, n)
//│ };
//│ define NarrowUnset¹ as class NarrowUnset⁰ {
//│   val n²;
//│   constructor NarrowUnset²(n) {
//│     define n² as val n³ = n;
//│     end
//│   }
//│ };
//│ define OtherUnset¹ as class OtherUnset⁰ { constructor OtherUnset² };
//│ return broadUnset¹(0)
