
:global
:wasm


class A() with
  fun inc(x) = x + 1
class B() extends A()
B().inc(1)
//│ Wasm result:
//│ = 2


class A(val x) with 
  fun get = x
class B(val y) extends A(y + 1)
B(1).get
//│ Wasm result:
//│ = 2


class A(val x) with 
  fun get() = x
class B(val y) extends A(y + 2)
B(1).get()
//│ Wasm result:
//│ = 3


class A(val x) with 
  fun get = x
class B(val y) extends A(y + 1)
fun f(b: B) = b.get
f(B(1))
//│ Wasm result:
//│ = 2


class A(val x) with 
  fun get = x
class B(val y) extends A(y + 1) with 
  fun use = this.get
B(1).use
//│ Wasm result:
//│ = 2


