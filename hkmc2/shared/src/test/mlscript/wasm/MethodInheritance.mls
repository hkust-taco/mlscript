class A(val x)
class B(val z) extends A(z + 1) with
  fun sum() = this.x + z
B(20).sum()
//│ Wasm result:
//│ = 41


class A(val x) with
  fun add(y) = x + y
class B(val z) extends A(z + 1)
class C(val w) extends B(w)
C(1).add(40)
//│ Wasm result:
//│ = 42


class A(val x)
class B(val y) extends A(y + 1)
fun readA(a: A) = a.x
readA(B(41))
//│ Wasm result:
//│ = 42


