fun tailMatchStmtBranch(x) =
  let y = 0 in
    if x is
      0 then
        set y += 1
      else 42
tailMatchStmtBranch(0)
//│ Wasm result:
//│ = {}


fun tailMatchStmtDefault(x) =
  let y = 0 in
    if x is
      0 then 11
      else
        set y += 1
