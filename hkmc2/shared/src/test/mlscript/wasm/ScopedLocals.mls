//│             (i31.get_s
//│               (ref.cast (ref null i31)
//│                 (local.get $lhs)))
//│             (i31.get_s
//│               (ref.cast (ref null i31)
//│                 (local.get $rhs))))))
//│       (else
//│         (unreachable))))
//│   (func $entry (type 2) (result (ref null any))
//│     (local $topA (ref null any))
//│     (local $topB (ref null any))
