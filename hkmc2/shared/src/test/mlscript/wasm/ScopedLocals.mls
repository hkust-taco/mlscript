//│         (ref.test (ref null i31)
//│           (local.get $lhs))
//│         (ref.test (ref null i31)
//│           (local.get $rhs)))
//│       (then
//│         (ref.i31
//│           (i32.add
//│             (i31.get_s
//│               (ref.cast (ref null i31)
//│                 (local.get $lhs)))
//│             (i31.get_s
//│               (ref.cast (ref null i31)
//│                 (local.get $rhs))))))
//│       (else
//│         (unreachable))))
//│   (func $chain (type 2) (param $x (ref null any)) (result (ref null any))
//│     (local $a (ref null any))
//│     (local $b (ref null any))
//│     (block (result (ref null any))
//│       (local.set $a
//│         (call 0
//│           (local.get $x)
//│           (ref.i31
//│             (i32.const 1))))
//│       (block (result (ref null any))
//│         (local.set $b
//│           (call 0
//│             (local.get $a)
//│             (ref.i31
//│               (i32.const 1))))
//│         (return
//│           (call 0
//│             (local.get $a)
//│             (local.get $b))))))
//│   (export "chain" (func $chain))
//│   (elem declare func $chain)
//│   (func $entry (type 3) (result (ref null any))
//│     (local $chain (ref null any))
