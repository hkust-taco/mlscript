fun ifLocals(flag) =
  if flag then
    let a = 10
    a + 1
  else
    let b = 20
    b + 2
ifLocals(true)
ifLocals(false)
//│ Wasm result:
//│ = 22


fun litMatch(x) =
  if x is
    0 then
      let arm = 10
      arm
    1 then
      let arm = 20
      arm
    else
      let arm = 30
      arm
litMatch(0)
litMatch(1)
litMatch(9)
//│ Wasm result:
//│ = 30


fun nestedInArm(x) =
  if x is
    0 then
      let a = 40
      if true then
        let b = a + 2
        b
      else
        0
    else
      0
nestedInArm(0)
//│ Wasm result:
//│ = 42


