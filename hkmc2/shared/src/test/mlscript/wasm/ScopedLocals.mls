//│       (local.set $topA
//│         (ref.i31
//│           (i32.const 1)))
//│       (block (result (ref null any))
//│         (local.set $topB
//│           (ref.i31
//│             (i32.const 2)))
//│         (call 0
//│           (local.get $topA)
//│           (local.get $topB)))))
//│   (export "entry" (func $entry))
//│   (elem declare func $entry))
//│ Wasm result:
//│ = 3


:wat
fun chain(x) =
  let a = x + 1
  let b = a + 1
  a + b
chain(1)
//│ Wat:
//│ (module
//│   (type $Object (sub (struct (field $$tag (mut i32)))))
//│   (type (func (param $lhs (ref null any)) (param $rhs (ref null any)) (result (ref null any))))
