
:global
:classTags mono
:noFreeze
:wasm


// The pass currently emits unresolved fields even when the target is Wasm.
:fixme // Tags need resolved fields, or this configuration needs an explicit rejection.
class Box(val x)
private fun tagged() =
  let value = new Box(0)
  @matchShapes(Box(_)) shape.match of value, () => 1
tagged()
