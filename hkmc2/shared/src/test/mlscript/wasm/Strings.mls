
:global
:wasm

"Hello World!"
//│ Wasm result:
//│ = "Hello World!"
//│ // Standard Error:
//│ [wasm-validator error in function entry] function body type must match, if function returns, on 
//│ (string.const "Hello World!")
//│ Assertion failed
//│ 

let s = "mlx"
s
//│ Wasm result:
//│ = "mlx"
//│ // Standard Error:
