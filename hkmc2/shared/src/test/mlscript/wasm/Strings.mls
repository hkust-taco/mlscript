let s = "mlx"
s
//│ Wasm result:
//│ = "mlx"

let t = ["a", "b", "c"]
t.[1]
//│ Wasm result:
//│ = "b"

// For testing that function indices are stable
:wat
fun id(x) = x
let s2 = "hello"
if true then id(1) else s2
