//│                   (local.get $tmp1)))))))))
//│   (export "entry" (func $entry))
//│   (elem declare func $entry))
//│ Wasm result:
//│ = 1


class A(val x) with
    set x += 1
class B(val y) extends A(y)
B(1).x + B(1).y
//│ Wasm result:
//│ = 3


class A(val x)
class B(val y) extends A(y + 1) with
  val z = this.x
B(1).z
//│ Wasm result:
//│ = 2


class A(val x) with
  val s = x + 1
class B(val y) extends A(y + 1) with
  set this.s += 1
B(1).s
//│ Wasm result:
//│ = 4


class A(val x) with
  val s = x + 1
class B(val y) extends A(y + 1)
let b = B(1)
set b.s = 5
b.s
//│ Wasm result:
//│ = 5


// Confirms no ctor/init split
:wat
class Plain(val x) with
  val y = this.x
Plain(42).y
