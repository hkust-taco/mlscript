:fixme
class A(val x)
class B(val y) extends A(1) with
  val z = x
B(2).z
//│ ╔══[COMPILATION ERROR] Name not found: x
//│ ║  l.276: 	  val z = x
//│ ╙──       	          ^
//│ Wasm result:
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


