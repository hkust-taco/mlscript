//│     (block
//│       (nop)
//│       (block
//│         (struct.set $A $x
//│           (ref.cast (ref $A)
//│             (local.get $this))
//│           (local.get $x))
//│         (nop))))
//│   (elem declare func $A_init)
//│   (func $A_ctor (type $A_ctor) (param $x (ref null any)) (result (ref null any))
//│     (local $this (ref null any))
