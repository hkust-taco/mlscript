//│       (local.set $this
//│         (struct.new_default $A))
//│       (struct.set $A $$tag
//│         (ref.cast (ref $A)
//│           (local.get $this))
//│         (i32.const 1))
//│       (call $A_init
//│         (local.get $this)
//│         (local.get $x))
//│       (return
//│         (local.get $this))))
//│   (export "A_ctor" (func $A_ctor))
//│   (elem declare func $A_ctor)
//│   (func $B_init (type $B_init) (param $this (ref null any)) (param $y (ref null any))
//│     (block
//│       (nop)
//│       (call $A_init
//│         (local.get $this)
//│         (local.get $y))
//│       (block
//│         (struct.set $B $y
//│           (ref.cast (ref $B)
//│             (local.get $this))
//│           (local.get $y))
//│         (nop))))
//│   (elem declare func $B_init)
//│   (func $B_ctor (type $B_ctor) (param $y (ref null any)) (result (ref null any))
//│     (local $this (ref null any))
//│     (block (result (ref null any))
//│       (local.set $this
//│         (struct.new_default $B))
//│       (struct.set $B $$tag
//│         (ref.cast (ref $B)
//│           (local.get $this))
//│         (i32.const 2))
//│       (call $B_init
//│         (local.get $this)
//│         (local.get $y))
//│       (return
//│         (local.get $this))))
//│   (export "B_ctor" (func $B_ctor))
//│   (elem declare func $B_ctor)
//│   (func $eq_impl1 (type $eq_impl) (param $lhs (ref null any)) (param $rhs (ref null any)) (result (ref null any))
//│     (if (result (ref null any))
//│       (i32.and
//│         (ref.test (ref null i31)
//│           (local.get $lhs))
//│         (ref.test (ref null i31)
//│           (local.get $rhs)))
//│       (then
//│         (ref.i31
//│           (i32.eq
//│             (i31.get_s
//│               (ref.cast (ref null i31)
//│                 (local.get $lhs)))
//│             (i31.get_s
//│               (ref.cast (ref null i31)
//│                 (local.get $rhs))))))
//│       (else
//│         (unreachable))))
//│   (elem declare func $eq_impl1)
//│   (func $entry (type $entry1) (result (ref null any))
//│     (local $A (ref null any))
