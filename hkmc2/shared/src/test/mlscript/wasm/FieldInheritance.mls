
:global
:wasm


class A(val x)
class B(val y) extends A(y + 1)
let b = B(2)
b.x
//│ Wasm result:
//│ = 3


class A(val x)
class B(val y) extends A(1)
B(2).x
//│ Wasm result:
//│ = 1


class A(val x)
class B(val y) extends A(1)
fun getX(b: B) = b.x
getX(B(2))
//│ Wasm result:
//│ = 1


class A(val x)
class B(val y) extends A(1) with
  val z = this.x
B(2).z
//│ Wasm result:
//│ = 1


class A(val x)
class B(val y) extends A(y) with
    val z = this.y
B(1).z
//│ Wasm result:
//│ = 1


class A(val x)
class B(val y) extends A(y)
class C(val z) extends B(z)
fun getX(c: C) = c.x
getX(C(3))
//│ Wasm result:
//│ = 3


class A(val x)
class B(val y) extends A(y)
B(1).y === A(1).x
//│ Wasm result:
//│ = 1


:wat
class A(val x)
class B(val y) extends A(y)
B(1).x === A(1).x
