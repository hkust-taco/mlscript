class Parity() with
  fun even(n) =
    if n === 0 then true else odd(n - 1)
  fun odd(n) =
    if n === 0 then false else even(n - 1)
Parity().even(6)
//│ Wasm result:
//│ = 1


class Box(val x) with
    fun get() = x
    fun inc() = Box(x + 1).get()
Box(41).inc()
//│ Wasm result:
//│ = 42


class Prev(val y) with
    fun get() = y
class Box(val x) with
    fun mk() = Prev(x + 1).get()
Box(41).mk()
//│ Wasm result:
//│ = 42


class Box(val x) with
    fun mk() = Next(x + 1).get()
class Next(val y) with
    fun get() = y
Box(41).mk()
//│ Wasm result:
//│ = 42


class Counter(val x) with
  fun inc() = Counter(x + 1)
  fun double() = Counter(x + x)
  fun get() = x
let c = Counter(1)
c.Counter#inc().Counter#double().Counter#get()
//│ Wasm result:
//│ = 4


class Box(val x) with
  fun twice() = x * 2
  fun get() = this
let b = Box(1)
b.Box#get().Box#twice()
//│ Wasm result:
//│ = 2


class Counter(val x) with
  fun inc() = 
    set x += 1
    this
  fun double() =
    set x *= 2
    this
  fun get() = x
let c = Counter(1)
c.Counter#inc().Counter#double().Counter#get()
//│ Wasm result:
//│ = 4


class A(val x) with
  fun inc() = 
    set this.x += 1
    x
A(1).inc()
//│ Wasm result:
//│ = 2



