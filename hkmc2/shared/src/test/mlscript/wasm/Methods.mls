
:global
:wasm


class Foo() with
    fun inc(x) = x + 1
Foo().inc(1)
//│ Wasm result:
//│ = 2


class GetterBox(val x) with
  fun get = x
GetterBox(42).get
//│ Wasm result:
//│ = 42



class NullaryBox(val x) with
  fun get() = x
NullaryBox(42).get()
//│ Wasm result:
//│ = 42


class Foo(val x) with
  fun add(y) = x + y
Foo(40).add(2)
//│ Wasm result:
//│ = 42


class Box(val base) with
  fun inc(x) = x + base
  fun getinc(x) = inc(x)
Box(2).getinc(40)
//│ Wasm result:
//│ = 42


