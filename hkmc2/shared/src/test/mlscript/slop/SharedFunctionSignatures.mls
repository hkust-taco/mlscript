:.
#lang(0.3.x)
open annotations

// Dead-parameter elimination and eta expansion prepare one signature for both
// the original and each specialized copy, including the appended parameter bindings.
:noInline
:lift
:flowBasedOpt poly
:soir
:siret
:checkIR
:expect [42, 43]
@affine(1) fun add(first: Int)(second: Int): Int = first + second
private fun partial(unused: Str, value: Int): Int -> Int = add(value)
[partial("first", 40)(2), partial("second", 41)(2)]
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp: ?, tmp1: ?, partial$partial, partial$partial1;
//│ @private @private
//│ define partial$partial as fun partial$partial⁰(value: Int⁰)(eta$0$0: Int⁰): Int⁰ {
//│   return add⁰(value)(eta$0$0)
//│ };
//│ @private @private
//│ define partial$partial1 as fun partial$partial¹(value: Int⁰)(eta$0$0: Int⁰): Int⁰ {
//│   return add⁰(value)(eta$0$0)
//│ };
//│ @affine(1)
//│ define add¹ as fun add⁰(first: Int⁰)(second: Int⁰): Int⁰ {
//│   return +⁰(first, second)
//│ };
//│ @private
//│ define partial⁰ as fun partial¹(unused: Str⁰, value: Int⁰)(eta$0$0: Int⁰): Int⁰ {
//│   return add⁰(value)(eta$0$0)
//│ };
//│ set tmp = partial$partial¹(40)(2);
//│ set tmp1 = partial$partial⁰(41)(2);
//│ return [tmp, tmp1]
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [42, 43]

// Capture lifting introduces an immutable parameter. Tail-call conversion refreshes
// it into a mutable loop slot together with the function symbol. The forwarding
// wrapper must call that refreshed definition, including through partial application.
:noInline
:lift
:flowBasedOpt off
:soir
:siret
:checkIR
:expect [42, 43]
fun makeCountdown(result: Int): Int -> Int =
  fun countdown(remaining: Int): Int =
    if remaining == 0 then result else countdown(remaining - 1)
  countdown
let countdown = makeCountdown(42)
[countdown(3), makeCountdown(43)(4)]
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let countdown, tmp: ?, baseCall: Function⁰, tmp1: ?, countdown$;
//│ @inline
//│ define countdown$ as fun countdown$⁰(result: Int⁰)(remaining: Int⁰): Int⁰ {
//│   return countdown⁰(result, remaining)
//│ };
//│ define countdown as fun countdown⁰(result: Int⁰, remaining: Int⁰): Int⁰ {
//│   loop loopLabel:
//│     let scrut: ?, tmp2: Int⁰;
//│     set scrut = Predef⁰.equals⁰(remaining, 0);
//│     match scrut
//│       true =>
//│         return result
//│       else
//│         set tmp2 = -⁰(remaining, 1);
//│         set remaining = tmp2;
//│         continue loopLabel
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ define makeCountdown⁰ as fun makeCountdown¹(result: Int⁰): Function⁰ {
//│   return countdown$⁰(result)
//│ };
//│ set countdown¹ = makeCountdown¹(42);
//│ set tmp = countdown¹(3);
//│ set baseCall = makeCountdown¹(43);
//│ set tmp1 = baseCall(4);
//│ return [tmp, tmp1]
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [42, 43]
//│ countdown = fun

// A specialized outer function copies a nested function whose own parameter list changes.
// Keep the nested definition in place to exercise binding refresh without lifting.
:noInline
:flowBasedOpt poly
:soir
:siret
:checkIR
:expect [42, 43]
private fun nested(unused: Str, value: Int): Int =
  private fun inner(discard: Bool, n: Int): Int = n + 1
  inner(true, value)
[nested("first", 41), nested("second", 42)]
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp: Int⁰, tmp1: Int⁰, nested$nested, nested$nested1;
//│ @private @private
//│ define nested$nested as fun nested$nested⁰(value: Int⁰): Int⁰ {
//│   let inner;
//│   @private
//│   define inner as fun inner⁰(n: Int⁰): Int⁰ {
//│     return +⁰(n, 1)
//│   };
//│   return inner⁰(value)
//│ };
//│ @private @private
//│ define nested$nested1 as fun nested$nested¹(value: Int⁰): Int⁰ {
//│   let inner;
//│   @private
//│   define inner as fun inner¹(n: Int⁰): Int⁰ {
//│     return +⁰(n, 1)
//│   };
//│   return inner¹(value)
//│ };
//│ @private
//│ define nested⁰ as fun nested¹(unused: Str⁰, value: Int⁰): Int⁰ {
//│   let inner;
//│   @private
//│   define inner as fun inner²(n: Int⁰): Int⁰ {
//│     return +⁰(n, 1)
//│   };
//│   return inner²(value)
//│ };
//│ set tmp = nested$nested¹(41);
//│ set tmp1 = nested$nested⁰(42);
//│ return [tmp, tmp1]
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [42, 43]

// Recursive and forward calls must use the shortened convention before either body is rebuilt.
:noInline
:noTailRec
:flowBasedOpt poly
:soir
:siret
:checkIR
:expect [42, 43]
private fun forward(unused: Str, count: Int, value: Int): Int = backward(unused, count, value)
private fun backward(unused: Str, count: Int, value: Int): Int =
  if count == 0 then value else forward(unused, count - 1, value)
[forward("first", 2, 42), backward("second", 3, 43)]
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp: Int⁰, tmp1: Int⁰, backward$forward, forward$backward, backward$forward1, backward$backward, forward$forward, forward$backward1;
//│ @private @private
//│ define backward$forward as fun backward$forward⁰(count: Int⁰, value: Int⁰): Int⁰ {
//│   return backward⁰(undefined, count, value)
//│ };
//│ @private @private
//│ define forward$backward as fun forward$backward⁰(count: Int⁰, value: Int⁰): Int⁰ {
//│   let scrut: ?, tmp2: Int⁰;
//│   set scrut = Predef⁰.equals⁰(count, 0);
//│   match scrut
//│     true =>
//│       return value
//│     else
//│       set tmp2 = -⁰(count, 1);
//│       return forward⁰(undefined, tmp2, value)
//│   end
//│ };
//│ @private @private
//│ define backward$forward1 as fun backward$forward¹(count: Int⁰, value: Int⁰): Int⁰ {
//│   return backward$backward⁰(count, value)
//│ };
//│ @private @private
//│ define backward$backward as fun backward$backward⁰(count: Int⁰, value: Int⁰): Int⁰ {
//│   let scrut: ?, tmp2: Int⁰;
//│   set scrut = Predef⁰.equals⁰(count, 0);
//│   match scrut
//│     true =>
//│       return value
//│     else
//│       set tmp2 = -⁰(count, 1);
//│       return backward$forward¹(tmp2, value)
//│   end
//│ };
//│ @private @private
//│ define forward$forward as fun forward$forward⁰(count: Int⁰, value: Int⁰): Int⁰ {
//│   return forward$backward¹(count, value)
//│ };
//│ @private @private
//│ define forward$backward1 as fun forward$backward¹(count: Int⁰, value: Int⁰): Int⁰ {
//│   let scrut: ?, tmp2: Int⁰;
//│   set scrut = Predef⁰.equals⁰(count, 0);
//│   match scrut
//│     true =>
//│       return value
//│     else
//│       set tmp2 = -⁰(count, 1);
//│       return forward$forward⁰(tmp2, value)
//│   end
//│ };
//│ @private
//│ define forward¹ as fun forward⁰(unused: Str⁰, count: Int⁰, value: Int⁰): Int⁰ {
//│   return forward$backward⁰(count, value)
//│ };
//│ @private
//│ define backward¹ as fun backward⁰(unused: Str⁰, count: Int⁰, value: Int⁰): Int⁰ {
//│   let scrut: ?, tmp2: Int⁰;
//│   set scrut = Predef⁰.equals⁰(count, 0);
//│   match scrut
//│     true =>
//│       return value
//│     else
//│       set tmp2 = -⁰(count, 1);
//│       return backward$forward⁰(tmp2, value)
//│   end
//│ };
//│ set tmp = forward$forward⁰(2, 42);
//│ set tmp1 = backward$backward⁰(3, 43);
//│ return [tmp, tmp1]
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [42, 43]

// Optional parameters before a trailing variadic are extracted in the body; they are
// absent from the fixed physical prefix, including after capture lifting and currying.
:noInline
:lift
:flowBasedOpt off
:soir
:siret
:checkIR
:expect [42, 45]
fun capturedVariadic(base: Int) =
  fun sum(first: Int, optional?: Int, ...middle, last: Int)(extra: Int): Int =
    base + first + (if optional is Int then optional else 0) + middle.length + last + extra
  sum
let lifted = capturedVariadic(30)
[lifted(1, 9)(2), lifted(1, 2, 0, 9)(2)]
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let sum, callPrefix: ?, tmp: ?, callPrefix1: ?, tmp1: ?, sum$;
//│ @inline
//│ define sum$ as fun sum$⁰(base: Int⁰)(first: Int⁰, ...args: Array⁰): Function⁰ {
//│   return sum⁰(base, first, ...args)
//│ };
//│ define sum as fun sum⁰(base: Int⁰, first: Int⁰, ...args: Array⁰)(extra: Int⁰): Int⁰ {
//│   let optional: Unknown, middle: ?, last: Int⁰, tmp2: Int⁰, tmp3: Unknown, tmp4: Unknown, tmp5: Unknown, tmp6: Unknown, leadingArgs: Array⁰;
//│   do runtime⁰.checkVariadicArgs⁰("sum", 2, 1, args);
//│   set leadingArgs = runtime⁰.Tuple⁰.slice⁰(args, 0, 1);
//│   match leadingArgs
//│     Array(1+) =>
//│       set optional = leadingArgs.0;
//│       end
//│     else
//│       set optional = null;
//│       end
//│   set middle = runtime⁰.Tuple⁰.slice⁰(args, 1, 1);
//│   set last = args.-1;
//│   set tmp2 = +⁰(base, first);
//│   match optional
//│     Int⁰ =>
//│       set tmp3 = optional;
//│       end
//│     else
//│       set tmp3 = 0;
//│       end
//│   set tmp4 = +⁰(tmp2, tmp3);
//│   set tmp5 = +⁰(tmp4, middle.length⁰);
//│   set tmp6 = +⁰(tmp5, last);
//│   return (+⁰(tmp6, extra) as! Int⁰)
//│ };
//│ define capturedVariadic⁰ as fun capturedVariadic¹(base: Int⁰): ? {
//│   return sum$⁰(base)
//│ };
//│ set lifted⁰ = capturedVariadic¹(30);
//│ set callPrefix = lifted⁰(1, 9);
//│ set tmp = callPrefix(2);
//│ set callPrefix1 = lifted⁰(1, 2, 0, 9);
//│ set tmp1 = callPrefix1(2);
//│ return [tmp, tmp1]
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [42, 45]
//│ lifted = fun

// Body simplification and parameter refreshing preserve the chosen return boundary,
// even when two definitions have identical bodies and different declared result types.
:flowBasedOpt off
:soir
:siret
:checkIR
:expect [42, 43]
fun wide(value: Int): Any = if true then value else value + 1
fun narrow(value: Int): Int = if true then value else value + 1
[wide(42), narrow(43)]
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let inlinedVal: Unknown;
//│ define wide⁰ as fun wide¹(value: Int⁰): Unknown {
//│   match true
//│     true =>
//│       return value
//│     else
//│       return +⁰(value, 1)
//│   end
//│ };
//│ define narrow⁰ as fun narrow¹(value: Int⁰): Int⁰ {
//│   match true
//│     true =>
//│       return value
//│     else
//│       return +⁰(value, 1)
//│   end
//│ };
//│ match true
//│   true =>
//│     set inlinedVal = 42;
//│     end
//│   else
//│     set inlinedVal = 43;
//│     end
//│ match true
//│   true =>
//│     return [inlinedVal, 43]
//│   else
//│     return [inlinedVal, 44]
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [42, 43]
