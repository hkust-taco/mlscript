// Formerly in backlog/ForLLM.mls: mutation of the captured parameter was lost.
:ge
:noInline
fun counter(x)() =
  set x = x + 1
  x
let next = counter(0)
[next(), next()]
//│ ╔══[COMPILATION ERROR] Cannot assign to immutable parameter 'x'
//│ ║  l.+2: 	  set x = x + 1
//│ ║        	      ^^^^^^^^^
//│ ╟── Defined here:
//│ ║  l.+1: 	fun counter(x)() =
//│ ╙──      	            ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ next = fun


// A copy in the final body is fresh on every call, including through partial application.
:noInline
:expect [1, 1]
fun counter(x)() =
  let =x
  set x += 1
  x
let next = counter(0)
[next(), next()]
//│ = [1, 1]
//│ next = fun


// Allocate the local before returning the closure to retain state between calls.
:expect [1, 2, 11, 3]
fun counter(x) =
  let =x
  () =>
    set x += 1
    x
let next = counter(0)
let other = counter(10)
[next(), next(), other(), next()]
//│ = [1, 2, 11, 3]
//│ next = fun
//│ other = fun

:noInline
:expect [1, 2, 11, 3]
fun counter(x) =
  let =x
  () =>
    set x += 1
    x
let next = counter(0)
let other = counter(10)
[next(), next(), other(), next()]
//│ = [1, 2, 11, 3]
//│ next = fun
//│ other = fun


