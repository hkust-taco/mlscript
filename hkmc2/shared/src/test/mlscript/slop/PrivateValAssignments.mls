// Class privacy permits access to another instance, but does not permit mutation.
:ge
class OtherInstanceWrite with
  private val value = 0
  fun update(other: OtherInstanceWrite) = set other.value = 1
//│ ╔══[COMPILATION ERROR] Cannot assign to immutable field 'value'
//│ ║  l.+3: 	  fun update(other: OtherInstanceWrite) = set other.value = 1
//│ ║        	                                                   ^^^^^^
//│ ╟── Defined here:
//│ ║  l.+2: 	  private val value = 0
//│ ╙──      	              ^^^^^

