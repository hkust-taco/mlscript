// An ordinary private val must reject the same writes as stored parameters.
:ge
class DirectWrite with
  private val value = 0
  fun update() = set value = 1
//│ ╔══[COMPILATION ERROR] Cannot assign to immutable field 'value'
//│ ║  l.+3: 	  fun update() = set value = 1
//│ ║        	                     ^^^^^
//│ ╟── Defined here:
//│ ║  l.+2: 	  private val value = 0
//│ ╙──      	              ^^^^^

:ge
class QualifiedWrite with
  private val value = 0
  fun update() = set this.value += 1
