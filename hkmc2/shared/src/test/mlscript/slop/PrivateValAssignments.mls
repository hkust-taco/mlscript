// Initialization, private mut vals, and let-bound state remain valid on frozen instances.
:expect [[41, 1, 1], [41, 2, 2], [10, 1, 1]]
class State(initial: Int) with
  private val value = initial
  private mut val count = 0
  let local = 0
  fun next() =
    set this.count += 1
    set local += 1
    [value, count, local]
let first = new State(41)
let second = new State(10)
[first.next(), first.next(), second.next()]
//│ = [[41, 1, 1], [41, 2, 2], [10, 1, 1]]
//│ first = State(_)
//│ second = State(_)


