// A whole conditional block finishes the conditional; ordinary clause operands keep their continuations.
:expect [true, 3, 3, 3]
[
  if {true then 2, else 3} + 2 == 4
  if false then {1} + 2 else 3
  if false then {x: 1}.x else 3
  if false then {id}(1) else 3
]
//│ = [true, 3, 3, 3]

// Wrapping the condition preserves the boundary and precedence of the do operand.
:expect [0, 0, 2, 2]
fun ordinary(c) =
  let n = 0
  if c do {set n = 1}; set n = 2
  n
fun blockCondition(c) =
  let n = 0
  if {c} do {set n = 1}; set n = 2
  n
[ordinary(false), blockCondition(false), ordinary(true), blockCondition(true)]
//│ = [0, 0, 2, 2]

// Clause operands accept operator, selection, and call continuations before the fallback.
:expect 3
if {false} then {1} + 2 else 3
//│ = 3

:expect 3
if {false} then {x: 1}.x else 3
//│ = 3

:expect 3
if {false} then {id}(1) else 3
//│ = 3

:expect [3, 1, 1]
[
  if {true} then {1} + 2 else ???,
  if {true} then {x: 1}.x else ???,
  if {true} then {id}(1) else ???
]
//│ = [3, 1, 1]

// Braces around the clauses close the conditional before its result continuation.
:expect 4
if {false} {then ??? else 2} + 2
//│ = 4

// A fallback outside the clause's indentation section still attaches to the if.
:expect 2
if {false}
  then 1
else 2
//│ = 2

:expect 2
if {false}
  then
    1
else 2
//│ = 2

:expect 2
if
    false
  then 1
else 2
//│ = 2

if {false}
  do ()
else ()

:expect 2
if {false}
  then
    ???
  else 2
//│ = 2

:expect 2
if {false}
then ???
else 2
//│ = 2

// A same-indent newline do starts a statement, including after a closed conditional block.
:expect 3
let n = 0
if {true do set n = 1}
do set n += 2
n
//│ = 3
//│ n = 3

:expect 2
let n = 0
if {false}
  do ???
do set n += 2
n
//│ = 2
//│ n = 2

:expect [2, 3]
let n = 0
let total = 0
while {n < 2} do {set n += 1}; set total += n
[n, total]
//│ = [2, 3]
//│ n = 2
//│ total = 3

// Explicit grouping and indentation boundaries protect nested conditionals and their fallbacks.
:expect [2, 3, 2]
[
  if (if {false then true} else false)
    then 1
  else 2,
  if {false} then (if {true then 1} else 2) else 3,
  if {if {false then true, else false}} then 1 else 2
]
//│ = [2, 3, 2]

:expect [2, 3]
fun nested(c) =
  if {c}
    then
      if {false}
        then ???
      else 2
  else 3
[nested(true), nested(false)]
//│ = [2, 3]

:expect 3
if {false} then
  if {true then 1} else 2
else 3
//│ = 3

:expect 3
if {false} then (if {true} then
  1
else 2) else 3
//│ = 3

:expect 2
id(if {false}
  then 1
  else 2)
//│ = 2

// An added fallback does not replace one already present in the block.
:w
:expect 2
if {false then 1, else 2} else 3
//│ ╔══[WARNING] This catch-all clause makes the following branches unreachable.
//│ ║  l.+1: 	if {false then 1, else 2} else 3
//│ ║        	                  ^^^^^^
//│ ╟── This branch is unreachable.
//│ ║  l.+1: 	if {false then 1, else 2} else 3
//│ ╙──      	                          ^^^^^^
//│ = 2

