// A whole conditional block finishes the conditional; ordinary clause operands keep their continuations.
:expect [true, 3, 3, 3]
[
  if {true then 2, else 3} + 2 == 4,
  if false then {1} + 2 else 3,
  if false then {x: 1}.x else 3,
  if false then {id}(1) else 3
]
//│ = [true, 3, 3, 3]

// FIXME: wrapping the condition changes where the same do operand ends.
// Comparing the two forms records the asymmetry without choosing either boundary rule.
:fixme
:expect true
fun ordinary(c) =
  let n = 0
  if c do {set n = 1}; set n = 2
  n
fun blockCondition(c) =
  let n = 0
  if {c} do {set n = 1}; set n = 2
  n
ordinary(false) === blockCondition(false)
//│ ═══[RUNTIME ERROR] Expected: 'true', got: 'false'
//│ = false

