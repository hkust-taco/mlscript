//│ ╙──      	   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

if x { > 1}
  then ???
  else 1
//│ = 1


// Parentheses disable newline separators, but still allow an indented clause's else.
:expect 123
(if true
  then 123
  else 456)
//│ = 123

(if true
then 123
else 456)
//│ = 123

(if true
  then 123
else 456)
//│ = 123

(if true
then 123
  else 456)
//│ = 123

:expect 125
2 +
(if true
  then 123
  else 456)
//│ = 125

:expect 458
2 +
(if false
  then 123
  else 456)
//│ = 458

print(if true then
    123
  else 456)
//│ > 123

// :pe
print(if true then
    123
else 456)
//│ > 123

// :pe
2 +
(if true then
    123
else 456)
//│ = 125

2 +
(if true then
    123
  else 456)
//│ = 125

2 +
(if true
    then 123
  else 456)
//│ = 125

// :fixme
2 +
(if true
  then 123
  else 456)
//│ = 125

if true
  then 123
  else 456
//│ = 123


