// resolver's receiver-parent identity assertion, even with an empty input.
// This reproduces the failure in FingerTreeList_StressTest.concat without recursion.
:fixme
class Base[A]
class Tree[A] extends Base[A] with
  fun concat(...xs) = xs.reduce((acc, other) => acc, this)
(new Tree[Int]).concat()
