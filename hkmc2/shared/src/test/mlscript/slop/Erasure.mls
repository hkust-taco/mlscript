:.
#lang(0.3.x)
open annotations

// A generator override's callable returns Iterator, but its body's payload can have any representation.
:noInline
:sir
:siret
:expect {value: "payload", done: true}
private class GeneratorBase() with
  @annotations.generator
  open fun generate(value: Any): Any = value
private class GeneratorChild() extends GeneratorBase() with
  @annotations.generator
  override fun generate(value: Any) = value
GeneratorChild().generate("payload").next()
