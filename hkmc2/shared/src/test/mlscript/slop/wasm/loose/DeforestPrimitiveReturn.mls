// [Astra] Replacing a fused match with a call must preserve its unboxed result representation.
// [Astra] The generated call currently has an unknown result, which cannot be coerced to Int32.
:fixme
:expect 42
data class Empty()
private fun f(n: Int32): Int32 =
  let b = Empty()
  if b is Empty then n else n
wasm.ref.i31(f(wasm.i32.const(42)))
