:.

// See `slop/loose/ErasureAcrossBlocks.mls`: without strict resolution, worksheet blocks infer the
// representations of their public definitions from their own uses only.


fun ident(x) = x
ident(1)
//│ Wasm result:
//│ = 1

:ge
ident("a")
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Str' at an unrelated type 'Int'
//│ ║  l.+1: 	ident("a")
//│ ╙──      	      ^^^
//│ Wasm result:
//│ = "a"


class Foo
class Box(val v)
let b = Box(new Foo)
//│ Wasm result:
//│ = {}

// Reading this field requires the session module to import both Box's struct type and the Foo type
// used in its inferred field representation.
:expect {}
b.v
//│ Wasm result:
//│ = {}
