// A temporary joining only undefined branches has type Nothing. Its destination
// supplies the unboxed representation; evaluating the condition still has effects.
:noOpt
:expect 42
let branchCalls = 0
private fun branchFlag(): Bool =
  set branchCalls = branchCalls + 1
  true
private fun ignoreI32(value: Int32): Int = 41
ignoreI32(if branchFlag() then unsafe.undefined else unsafe.undefined) + branchCalls
//│ Wasm result:
//│ = 42


// A Nothing-returning call still executes when used in an unboxed result or argument slot.
:noInline
:expect 42
let bottomCalls = 0
private fun bottom(): Nothing =
  set bottomCalls = bottomCalls + 1
  unsafe.undefined
private fun bottomResult(): Float64 = bottom()
private fun ignoreI64(value: Int64): Int = 40
bottomResult()
ignoreI64(bottom()) + bottomCalls
//│ Wasm result:
//│ = 42


// Inlining substitutes undefined into an existing checked cast. Smart construction
// must collapse that cast while retaining the effects before the return.
:soir
:expect 42
open annotations
private class CastTarget()
let castCalls = 0
@inline private fun narrow(value: Any): CastTarget =
  set castCalls = castCalls + 1
  value
narrow(unsafe.undefined)
castCalls + 41
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp;
//│ @inline @private
//│ define narrow⁰ as fun narrow¹(value) {
//│   let tmp1;
//│   set tmp1 = +⁰(castCalls⁰, 1);
//│   set castCalls⁰ = tmp1;
//│   return (value as! CastTarget⁰)
//│ };
//│ @private
//│ define CastTarget¹ as class CastTarget⁰ {
//│   constructor CastTarget²
//│ };
//│ set castCalls⁰ = 0;
//│ set tmp = +⁰(castCalls⁰, 1);
//│ set castCalls⁰ = tmp;
//│ return +⁰(castCalls⁰, 41)
//│ Wasm result:
//│ = 42


// Undefined in an annotation leaves the representation of the other alternatives unchanged.
:noInline
:expect 3
private fun takeI32(value: Int32 | unsafe.undefined): Int32 = value
takeI32(unsafe.undefined)
takeI32(wasm.i32.const(3))
//│ Wasm result:
//│ = 3


// A valueless break gives its label the Unit result, like a plain `do` block.
:noInline
fun breakWithoutValue() = do lbl: lbl.break
breakWithoutValue()
//│ Wasm result:
//│ = {}


// Narrowing a value of unknown representation to Nothing is a cast. An unboxed slot receiving the cast's
// result materializes an unspecified value, which this test discards.
:noInline
:expect 42
private fun unknownResult() = 1
private fun claimNothing(): Nothing = unknownResult()
private fun discardI32(value: Int32): Int = 42
discardI32(claimNothing())
//│ Wasm result:
//│ = 42


// Inlining a narrowing function can expose a Nothing-typed temporary under its checked cast.
// Keep the bottom call's effects without requiring a non-null value for the cast target.
:soir
:expect 42
private class BottomCastTarget()
let bottomCastCalls = 0
@noInline private fun bottomForCast(): Nothing =
  set bottomCastCalls = bottomCastCalls + 1
  unsafe.undefined
@inline private fun narrowBottom(value: Any): BottomCastTarget = value
narrowBottom(bottomForCast())
bottomCastCalls + 41
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @noInline @private
//│ define bottomForCast⁰ as fun bottomForCast¹() {
//│   let tmp;
//│   set tmp = +⁰(bottomCastCalls⁰, 1);
//│   set bottomCastCalls⁰ = tmp;
//│   return undefined
//│ };
//│ @inline @private
//│ define narrowBottom⁰ as fun narrowBottom¹(value) {
//│   return (value as! BottomCastTarget⁰)
//│ };
//│ @private
//│ define BottomCastTarget¹ as class BottomCastTarget⁰ {
//│   constructor BottomCastTarget²
//│ };
//│ set bottomCastCalls⁰ = 0;
//│ do bottomForCast¹();
//│ return +⁰(bottomCastCalls⁰, 41)
//│ Wasm result:
//│ = 42


// Inlining through Nothing must retain the bottom boundary when the operand has a scalar representation.
:soir
:expect 42
private class ScalarCastTarget()
@inline private fun narrowScalarBottom(value: Any): ScalarCastTarget = value
@inline private fun scalarBottom(): Nothing = wasm.i32.const(7)
narrowScalarBottom(scalarBottom())
42
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @inline @private
//│ define narrowScalarBottom⁰ as fun narrowScalarBottom¹(value) {
//│   return (value as! ScalarCastTarget⁰)
//│ };
//│ @inline @private
//│ define scalarBottom⁰ as fun scalarBottom¹() {
//│   return (wasm⁰.i32⁰.const⁰(7) as! Nothing)
//│ };
//│ @private
//│ define ScalarCastTarget¹ as class ScalarCastTarget⁰ {
//│   constructor ScalarCastTarget²
//│ };
//│ do (wasm⁰.i32⁰.const⁰(7) as! Nothing);
//│ return 42
//│ Wasm result:
//│ = 42


// A bottom-typed entry still needs its physical reference result slot before lowering an inlined scalar cast.
// The returned value is unspecified; validation and execution must succeed.
:soir
@inline private fun entryBottom(): Nothing = wasm.i32.const(7)
entryBottom()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @inline @private
//│ define entryBottom⁰ as fun entryBottom¹() {
//│   return (wasm⁰.i32⁰.const⁰(7) as! Nothing)
//│ };
//│ return (wasm⁰.i32⁰.const⁰(7) as! Nothing)
//│ Wasm result:
//│ = null
