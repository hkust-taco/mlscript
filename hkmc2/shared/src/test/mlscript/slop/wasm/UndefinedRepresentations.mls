// Dead-parameter elimination introduces undefined after lowering. The functions'
// declared unboxed result slots must survive even when their results are unused.
:noInline
:flowBasedOpt mono
:soir
:expect 42
private fun discard(): Int =
  fun i32(value: Int32): Int32 = value
  fun i64(value: Int64): Int64 = value
  fun f32(value: Float32): Float32 = value
  fun f64(value: Float64): Float64 = value
  i32(wasm.i32.const(1))
  i64(wasm.i64.const(2))
  f32(wasm.f32.const(3.0))
  f64(wasm.f64.const(4.0))
  42
discard()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private
//│ define discard⁰ as fun discard¹() {
//│   let f32, f64, i64, i32;
//│   define i32 as fun i32⁰() {
//│     return undefined
//│   };
//│   define i64 as fun i64⁰() {
//│     return undefined
//│   };
//│   define f32 as fun f32⁰() {
//│     return undefined
//│   };
//│   define f64 as fun f64⁰() {
//│     return undefined
//│   };
//│   do wasm⁰.i32¹.const⁰(1);
//│   do i32⁰();
//│   do wasm⁰.i64¹.const¹(2);
//│   do i64⁰();
//│   do wasm⁰.f32¹.const²(3.0);
//│   do f32⁰();
//│   do wasm⁰.f64¹.const³(4.0);
//│   do f64⁰();
//│   return 42
//│ };
//│ return discard¹()
//│ Wasm result:
//│ = 42


// Calls returning undefined still run when used as arguments to another call.
:noInline
:expect 42
let effects = 0
private fun absent(): Int64 =
  set effects = effects + 1
  unsafe.undefined
private fun consume(value: Int64): Int = effects
consume(absent()) + 41
//│ Wasm result:
//│ = 42


// Virtual and super calls use the declared parameter and result slots.
:noInline
:expect 42
private class Base() with
  open fun take(value: Int32): Int32 = unsafe.undefined
private class Child() extends Base() with
  override fun take(value): Int32 = super.take(unsafe.undefined)
private fun dispatch(receiver: Base): Int32 = receiver.take(unsafe.undefined)
dispatch(Child())
42
//│ Wasm result:
//│ = 42


// Null remains an ordinary value and cannot fill an unboxed result slot.
:ge
private fun badNull(): Int32 = null
42
