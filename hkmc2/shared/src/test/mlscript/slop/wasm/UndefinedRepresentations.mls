// Undefined can fill scalar and nominal slots. Discard the unspecified values,
// but retain the calls' effects and compile the unused stores without optimization.
:noOpt
:expect 6
private class Token()
private class Slots(mut val a: Int32, val b: Int64, val c: Float32, val d: Float64, val ref: Token)
let calls = 0
private fun absentI32(): Int32 =
  set calls = calls + 1
  unsafe.undefined
private fun absentI64(): Int64 =
  set calls = calls + 1
  unsafe.undefined
private fun absentF32(): Float32 =
  set calls = calls + 1
  unsafe.undefined
private fun absentF64(): Float64 =
  set calls = calls + 1
  unsafe.undefined
private fun absentRef(): Token =
  set calls = calls + 1
  unsafe.undefined
private fun accept(a: Int32, b: Int64, c: Float32, d: Float64, ref: Token): Int =
  val local: Int32 = unsafe.undefined
  val slots = new mut Slots(unsafe.undefined, unsafe.undefined, unsafe.undefined, unsafe.undefined, unsafe.undefined)
  set slots.a = unsafe.undefined
  wasm.i32.add(unsafe.undefined, wasm.i32.const(0))
  set calls = calls + 1
  0
absentI32()
absentI64()
absentF32()
absentF64()
absentRef()
accept(unsafe.undefined, unsafe.undefined, unsafe.undefined, unsafe.undefined, unsafe.undefined)
calls
//│ Wasm result:
//│ = 6


// An undefined return must not constrain the concrete branch's representation.
:noInline
:expect 42
private fun choose(flag: Bool, value: Int32): Int32 =
  if flag do return value
  unsafe.undefined
choose(false, wasm.i32.const(1))
choose(true, wasm.i32.const(42))
//│ Wasm result:
//│ = 42


// The conditional temporary must keep the concrete branch's unboxed representation.
:noInline
:expect 42
private fun conditional(flag: Bool): Int32 =
  wasm.i32.add((if flag then wasm.i32.const(42) else unsafe.undefined), wasm.i32.const(0))
conditional(true)
//│ Wasm result:
//│ = 42


// FIXME: Top-level lowering drops the undefined branch's implicit return. Wasm then
// generates an anyref fallthrough value for an i32 entry function.
:fixme
:noInline
:expect 42
private fun flag(): Bool = true
if flag() then wasm.i32.const(42) else unsafe.undefined
