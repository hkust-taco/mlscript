// * File compilation and worksheet compilation share the backend's import validation.
// * An unsupported host import reports one cause, followed by the importing block's failure.
:ge
import "./HostImportFixture.mls"
//│ ═══[COMPILATION ERROR] Import of symbol `node:fs` not implemented yet
//│ ╔══[COMPILATION ERROR] Cannot compile this module: the imported file `HostImportFixture.mls` could not be compiled due to an error
