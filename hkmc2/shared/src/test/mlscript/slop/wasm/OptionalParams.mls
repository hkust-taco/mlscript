OptionalField(()).read()
//│ /!!!\ Uncaught error: java.lang.Exception: Internal Error: Missing field `term:OptionalField/read` in struct `member:OptionalField` with type `(type $OptionalField (sub $Object (struct (field $$typeinfo (mut (ref $TypeInfoBase))) (field $x (mut (ref null any))))))`

// A virtual call with a supplied optional argument preserves its value.
:expect 17
class SuppliedBase() {
  open fun pick(x?) = if x is null then 0 else x
}
class SuppliedChild() extends SuppliedBase() {
  override fun pick(x?) = if x is null then 0 else x
}
fun suppliedDispatch(base: SuppliedBase, x) = base.pick(x)
suppliedDispatch(SuppliedChild(), 17)
//│ Wasm result:
//│ = 17

:expect 1112
class SuppliedBase() {
  open fun pick(x?) = if x is null then 1 else x
}
class SuppliedChild() extends SuppliedBase() {
  override fun pick(x) = super.pick(x)
}
fun suppliedDispatch(base: SuppliedBase, x) = base.pick(x) + base.pick()
let c = SuppliedChild()
c.pick(10) + suppliedDispatch(c, 100) + suppliedDispatch(SuppliedBase(), 1000)
//│ Wasm result:
//│ = 1112

// Optional slots work with inlining and tail-call jumps as well as real calls.
#config(inlining: 100)
//│ Wasm result:
//│ = {}
:expect 1
@inline fun inlined(x?) = absent(x)
inlined(null) + inlined(()) * 10 + inlined(unsafe.undefined) * 100
//│ Wasm result:
//│ = 1

:expect 1
inlined()
//│ Wasm result:
//│ = 1

:expect 1
@tailrec fun countdown(n: Int, x?) =
  if n is 0 then absent(x) else countdown(n - 1)
countdown(3, 18)
//│ Wasm result:
//│ = 1

:expect 0
@tailrec fun keep(n: Int, x?) =
  if n is 0 then absent(x) else keep(n - 1, x)
keep(3, ())
//│ Wasm result:
//│ = 0


