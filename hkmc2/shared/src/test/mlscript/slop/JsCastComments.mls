:.
:js


// Turning comments off preserves the ordinary JS output even when the IR still contains a cast.
:noCastComments
:noInline
:sir
:sjs
:expect 42
fun quiet(x: Num, y: Int): Int = x + y
quiet(40, 2)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define quiet⁰ as fun quiet¹(x, y) { return (+⁰(x, y) as! Int⁰) }; return quiet¹(40, 2)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let quiet; quiet = function quiet(x, y) { return x + y }; return quiet(40, 2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


// Cast comments stay attached to callees, constructor arguments, and returned values after inlining.
// The operands come from a function that is not inlined, so the casts remain needed.
:sjs
:expect 42
class Box(val value: Int)
fun asFunction(value): Function = value
fun read(box: Box): Int = box.value
fun invoke(f, x) = asFunction(f)(x)
@annotations.noInline fun opaque(value) = value
invoke(opaque(x => read(new Box(x))), opaque(42))
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let read, asFunction, Box1, invoke, opaque, lambda, tmp, tmp1;
//│ asFunction = function asFunction(value) {
//│   return value /* as! Function */
//│ };
//│ read = function read(box) {
//│   return box.value
//│ };
//│ invoke = function invoke(f, x) {
//│   return runtime.safeCall(f /* as! Function */(x))
//│ };
//│ opaque = function opaque(value) {
//│   return value
//│ };
//│ Box1 = function Box(value) {
//│   return globalThis.Object.freeze(new Box.class(value));
//│ };
//│ (class Box {
//│   static {
//│     Box1.class = this
//│   }
//│   constructor(value) {
//│     this.value = value;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Box", ["value"]];
//│ });
//│ lambda = (undefined, function (x) {
//│   let tmp2;
//│   tmp2 = globalThis.Object.freeze(new Box1.class(x /* as! Int */));
//│   return tmp2.value
//│ });
//│ tmp = opaque(lambda);
//│ tmp1 = opaque(42);
//│ return runtime.safeCall(tmp /* as! Function */(tmp1))
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


// Looking through a commented cast must still parenthesize a negative literal used as a receiver.
// The simplifier drops a cast that the literal already fits, so the target here is unrelated
// to Int; the JS backend erases the cast, so the call still runs on the number.
:noCheckCasts
:sjs
:expect "-1"
fun asStr(value): Str = value
asStr(-1).toString()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let asStr;
//│ asStr = function asStr(value) {
//│   return value /* as!! Str */
//│ };
//│ return runtime.safeCall((-1 /* as!! Str */).toString())
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "-1"


// Type names can contain comment terminators and line separators through escaped identifiers.
// The generated comment must contain the entire name without terminating early or splitting the line.
:sjs
:expect 42
declare class id"Odd*/\n\u2028Type"
fun castOdd(value): id"Odd*/\n\u2028Type" = value
castOdd(42)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let castOdd;
//│ castOdd = function castOdd(value) {
//│   return value /* as! Odd* /\n\u2028Type */
//│ };
//│ return 42 /* as! Odd* /\n\u2028Type */
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42
