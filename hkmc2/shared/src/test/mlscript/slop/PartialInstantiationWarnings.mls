// Parameterless classes are constructed; required and multiple lists remain useful partial applications.
class Parameterless
class Required(val value)
class Curried()(val value)

:expect [true, 1, 2]
val required = new Required
val curried = new Curried
[new Parameterless is Parameterless, required(1).value, curried()(2).value]
//│ = [true, 1, 2]
//│ curried = fun
//│ required = fun

// The suggested factory suspends construction until each call.
:expect [0, 1, 2]
let count = 0
class Counted() { set count = count + 1 }
val factory = => new Counted()
let before = count
factory()
let after = count
factory()
[before, after, count]
//│ = [0, 1, 2]
//│ after = 1
//│ before = 0
//│ count = 2
//│ factory = fun

:expect [true, true]
val makeObject = => new Object()
[new Empty() is Empty, makeObject() is Object]
//│ = [true, true]
//│ makeObject = fun

// A refinement constructs a subclass, so it is not a partial constructor value.
:expect true
(new Empty() with {}) is Empty
//│ = true

