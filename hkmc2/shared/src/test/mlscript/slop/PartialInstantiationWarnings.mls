// Forward definitions and generic calls must not repeat the source warning.
:w
fun make[A]() = new Forward[A]
class Forward[A]()
[make[Int]()() is Forward, make[Str]()() is Forward]
//│ ╔══[WARNING] This 'new' expression partially applies class 'Forward' instead of constructing an instance.
//│ ║  l.+1: 	fun make[A]() = new Forward[A]
//│ ║        	                ^^^^^^^^^^^^^^
//│ ╟── Use `new Forward[A]()` to construct an instance, or `=> new Forward[A]()` to create an explicit zero-argument lambda.
//│ ╟── The constructor accepts an empty argument list.
//│ ║  l.+2: 	class Forward[A]()
//│ ╙──      	                ^^
//│ = [true, true]

