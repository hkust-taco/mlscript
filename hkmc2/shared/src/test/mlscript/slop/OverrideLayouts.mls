private abstract class AbstractMethod() with
  fun pick: (Int) -> Int

// The unparenthesized arrow in the type of a declared or abstract member spells out its
// parameter list, so a method overrides it, and calls through the base pass their arguments to it.
:noInline
:expect 4
declare class DeclaredMethod {
  declare fun pick: (Int) -> Int
}
declare class MethodOverDeclared extends DeclaredMethod {
  declare override fun pick(value: Int): Int
}
private class MethodOverAbstract() extends AbstractMethod() with
  override fun pick(value: Int): Int = value
private fun throughMethod(base: AbstractMethod) = base.pick(4)
throughMethod(MethodOverAbstract())
//│ = 4

// A member holding a function value has no parameter list, so it cannot implement such a method.
:ge
private class ValueOverAbstractMethod() extends AbstractMethod() with
  fun pick = (value: Int) => value * 10
//│ ╔══[COMPILATION ERROR] Overriding member 'pick' must preserve the number of parameter lists
//│ ║  l.+2: 	  fun pick = (value: Int) => value * 10
