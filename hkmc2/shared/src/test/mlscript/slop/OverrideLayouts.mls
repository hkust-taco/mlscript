//│ ╙──      	           ^^^^^^^

// Implementations may ignore inherited drop slots without shifting the retained inputs.
:noInline
:expect 5
private class DropSuffix() with
  open fun pick(value: Int, drop ignored: Any): Int = value
private class DroppedSuffix() extends DropSuffix() with
  override fun pick(renamed) = renamed
private fun throughDrop(base: DropSuffix) = base.pick(5, "ignored")
throughDrop(DroppedSuffix())
//│ = 5

// Dropping a middle slot would redirect its argument into a retained parameter.
:ge
private class DropMiddle() with
  open fun pick(first: Any, drop ignored: Any, last: Any): Any = last
private class ShiftedAfterDrop() extends DropMiddle() with
  override fun pick(first: Any, last: Any): Any = last
//│ ╔══[COMPILATION ERROR] Overriding member 'pick' must preserve the arguments bound to inherited parameter 'last'
//│ ║  l.+4: 	  override fun pick(first: Any, last: Any): Any = last
//│ ║        	                   ^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── The overridden member 'pick' is defined here
//│ ║  l.+2: 	  open fun pick(first: Any, drop ignored: Any, last: Any): Any = last
//│ ╙──      	           ^^^^

// A rest channel may be ignored only when no retained suffix changes its binding.
:noInline
:expect 6
private class DropRest() with
  open fun pick(first: Int, drop ...ignored: Array[Any]): Int = first
private class DroppedRest() extends DropRest() with
  override fun pick(first) = first
private fun throughRest(base: DropRest) = base.pick(6, 7, 8, 9)
throughRest(DroppedRest())
//│ = 6

:ge
private class DropMiddleRest() with
  open fun pick(first: Any, drop ...ignored: Array[Any], last: Any): Any = last
private class ShiftedAfterRest() extends DropMiddleRest() with
  override fun pick(first: Any, last: Any): Any = last
//│ ╔══[COMPILATION ERROR] Overriding member 'pick' must preserve the arguments bound to inherited parameter 'last'
