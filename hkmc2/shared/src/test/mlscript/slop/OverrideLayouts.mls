// Explicit arrow declarations carry the same optional/rest binding contract without
// having parameter symbols or executable method bodies.
:ge
declare class ArrowBase {
  declare fun pick: (Any, Any?) -> Any
}
declare class ArrowRebinding extends ArrowBase {
  declare override fun pick: (...Array[Any], Any) -> Any
}
//│ ╔══[COMPILATION ERROR] Overriding member 'pick' must preserve the arguments bound to inherited parameter 1
//│ ║  l.+5: 	  declare override fun pick: (...Array[Any], Any) -> Any
//│ ║        	                             ^^^^^^^^^^^^^^^^^^^^
//│ ╟── The overridden member 'pick' is defined here
//│ ║  l.+2: 	  declare fun pick: (Any, Any?) -> Any
//│ ╙──      	              ^^^^

// The same declaration-only path checks scalar representations after correspondence.
:ge
declare class ArrowTypedBase {
  declare fun pick: (Int) -> Int
}
declare class ArrowNarrowing extends ArrowTypedBase {
  declare override fun pick: (Str) -> Int
}
