// A signature that spells out a parameter list makes a method even with a body that is a function
// value: the method applies that value to its arguments. Overrides can thus write the list themselves.
:expect [7, 8]
private class FunctionGetter() with
  open fun get: (Int) -> Int = (value: Int) => value
private class RenamedGetter() extends FunctionGetter() with
  override fun get: (Int) -> Int = (renamed: Int) => renamed
private class WrittenGetter() extends FunctionGetter() with
  override fun get(written: Int) = written + 1
[RenamedGetter().get(7), WrittenGetter().get(7)]
//│ = [7, 8]

// With a parenthesized function type, the members return their whole function value.
:expect 7
private class FunctionValueGetter() with
  open fun get: ((Int) -> Int) = (value: Int) => value
private class RenamedValueGetter() extends FunctionValueGetter() with
  override fun get: ((Int) -> Int) = (renamed: Int) => renamed
RenamedValueGetter().get(7)
//│ = 7


// Dropping a fixed slot must preserve an optional successor's absence too.
:ge
private class DropBeforeOptional() with
  open fun pick(first: Any, drop ignored: Any, last?: Any): Any = last
private class FilledAbsentOptional() extends DropBeforeOptional() with
  override fun pick(first: Any, last?: Any): Any = last
