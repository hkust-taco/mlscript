// A supplied callable result can hide another binding layout behind a type parameter.
// Until that layout is instantiated, reject it instead of accepting changed second-stage bindings.
type ReturnFn[R] = (Int) -> R
type ResultIdentity[R] = R
declare class GenericResultBase {
  declare fun pick: ReturnFn[(Any, Any?) -> Any]
}

:ge
declare class GenericResultRebinding extends GenericResultBase {
  declare override fun pick: ReturnFn[ResultIdentity[(...Array[Any], Any) -> Any]]
}
//│ ╔══[COMPILATION ERROR] Overriding member 'pick' has a declared callable type whose parameter layout cannot be determined
//│ ║  l.XX: 	type ReturnFn[R] = (Int) -> R
//│ ║        	                            ^
//│ ╟── The overridden member 'pick' is defined here
//│ ║  l.XX: 	  declare fun pick: ReturnFn[(Any, Any?) -> Any]
//│ ╙──      	              ^^^^

// Non-callable supplied results retain ordinary generic erasure, including alias forwarding.
declare class GenericValueBase {
  declare fun pick: ReturnFn[Int]
}
declare class GenericValueOverride extends GenericValueBase {
  declare override fun pick: ReturnFn[ResultIdentity[Int]]
}

