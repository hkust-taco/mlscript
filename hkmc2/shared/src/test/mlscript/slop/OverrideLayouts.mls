//│ ╟── The overridden member 'pick' is defined here
//│ ║  l.+2: 	  declare fun pick: (Int) -> Int
//│ ╙──      	              ^^^^

// A written method does not override a getter-shaped declaration in the current
// member model; that existing diagnostic must not be bypassed by layout checking.
:ge
private class WrittenOverArrow() extends ArrowTypedBase with
  override fun pick(value: Int): Int = value
//│ ╔══[COMPILATION ERROR] Overriding member 'pick' must preserve whether the member is a field, getter, or method
//│ ║  l.+2: 	  override fun pick(value: Int): Int = value
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Inherited member 'pick' is defined here
