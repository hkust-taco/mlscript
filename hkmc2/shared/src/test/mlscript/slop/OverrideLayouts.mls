// Aliases preserve the same physical arrow contract, including optional input flags.
type AliasedLayout = (Int, Str?) -> Any
type SameAliasedLayout = AliasedLayout
declare class AliasedLayoutBase {
  declare fun pick: SameAliasedLayout
}
declare class SameAliasOverride extends AliasedLayoutBase {
  declare override fun pick: (Int, Str?) -> Int
}

:ge
type RequiredAliasedLayout = (Int, Str) -> Int
declare class NarrowedAliasOverride extends AliasedLayoutBase {
  declare override fun pick: RequiredAliasedLayout
}
//│ ╔══[COMPILATION ERROR] Overriding member 'pick' requires at least 2 arguments, but the overridden member permits 1
//│ ║  l.+1: 	type RequiredAliasedLayout = (Int, Str) -> Int
//│ ║        	                             ^^^^^^^^^^
//│ ╟── The overridden member 'pick' is defined here
//│ ║  l.XX: 	  declare fun pick: SameAliasedLayout
//│ ╙──      	              ^^^^


// A compound callback result is one returned value, not another physical parameter list.
type NullableCallback = ((Str) -> Str) | null
type ReturnsNullableCallback = (Int) -> NullableCallback
declare class CallbackResultBase {
  declare fun make: ReturnsNullableCallback
}
declare class CallbackResultOverride extends CallbackResultBase {
  declare override fun make: ReturnsNullableCallback
}


