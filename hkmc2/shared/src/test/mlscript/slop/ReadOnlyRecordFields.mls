:.

// Without strict resolution, an assignment to a record field is an error when none of the records that
// reach it has the field mutable (see strictres/MixedRecords.mls for strict resolution).

:ge
let fixed = {count: 0, label: "count"}
set fixed.count = 1
//│ ╔══[COMPILATION ERROR] Cannot assign to immutable field 'count'
//│ ║  l.+2: 	set fixed.count = 1
//│ ║        	         ^^^^^^
//│ ╟── Defined here:
//│ ║  l.+1: 	let fixed = {count: 0, label: "count"}
//│ ╙──      	             ^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ fixed = {count: 0, label: "count"}

:ge
let mixed = {mut count: 0, label: "count"}
set mixed.label = "changed"
//│ ╔══[COMPILATION ERROR] Cannot assign to immutable field 'label'
//│ ║  l.+2: 	set mixed.label = "changed"
//│ ║        	         ^^^^^^
//│ ╟── Defined here:
//│ ║  l.+1: 	let mixed = {mut count: 0, label: "count"}
//│ ╙──      	                           ^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ mixed = {count: 0, label: "count"}

:expect 1
let counter = {mut count: 0, label: "count"}
set counter.count = 1
counter.count
//│ = 1
//│ counter = {count: 1, label: "count"}

// The assignment is accepted if one of the records that reach it has the field mutable. The other record
// below is frozen, and ignores it.
:expect [1, 0]
private fun bump(record) = set record.count = record.count + 1
let bumped = {mut count: 0}
let unchanged = {count: 0}
bump(bumped)
bump(unchanged)
[bumped.count, unchanged.count]
//│ = [1, 0]
//│ bumped = {count: 1}
//│ unchanged = {count: 0}

// It is rejected if none of them does.
:ge
private fun bumpFixed(record) = set record.count = record.count + 1
bumpFixed({count: 0})
bumpFixed({count: 1, label: "one"})
//│ ╔══[COMPILATION ERROR] Cannot assign to immutable field 'count'
//│ ║  l.+1: 	private fun bumpFixed(record) = set record.count = record.count + 1
//│ ║        	                                          ^^^^^^
//│ ╟── Defined here:
//│ ║  l.+2: 	bumpFixed({count: 0})
//│ ╙──      	           ^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// So does a mutable copy of a record make the assignment acceptable for the record that it copies.
:expect [0, 1]
private fun bumpCopies(record) = set record.count = record.count + 1
let original = {count: 0}
let copied = mut {...original}
bumpCopies(original)
bumpCopies(copied)
[original.count, copied.count]
//│ = [0, 1]
//│ copied = {count: 1}
//│ original = {count: 0}

// The components of a union of record types follow the same rule.
private fun writeEither(target: {mut count: Int} | {count: Int}) = set target.count = 1

:ge
private fun writeNeither(target: {count: Int} | {count: Int, label: Str}) = set target.count = 1
//│ ╔══[COMPILATION ERROR] Cannot assign to immutable field 'count'
//│ ║  l.+1: 	private fun writeNeither(target: {count: Int} | {count: Int, label: Str}) = set target.count = 1
//│ ║        	                                                                                      ^^^^^^
//│ ╟── Defined here:
//│ ║  l.+1: 	private fun writeNeither(target: {count: Int} | {count: Int, label: Str}) = set target.count = 1
//│ ╙──      	                                  ^^^^^

// A value of unknown shape does not count as a record that has the field mutable.
:ge
private fun partlyDynamic(record: dyn, choose: Bool) =
  let target = if choose then record else {count: 0}
  set target.count = 1
//│ ╔══[COMPILATION ERROR] Cannot assign to immutable field 'count'
//│ ║  l.+3: 	  set target.count = 1
//│ ║        	            ^^^^^^
//│ ╟── Defined here:
//│ ║  l.+2: 	  let target = if choose then record else {count: 0}
//│ ╙──      	                                           ^^^^^
