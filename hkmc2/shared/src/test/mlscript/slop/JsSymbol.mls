// The annotation is a prelude declaration, usable through ordinary opens.
:expect [50, 51]
private fun opened() =
  open annotations { jsSymbol }
  class Opened {
    @jsSymbol(Keys.first) fun read() = 50
  }
  (new Opened).read()
private fun wildcard() =
  open annotations
  class Wildcard {
    @jsSymbol(Keys.second) fun read() = 51
  }
  (new Wildcard).read()
[opened(), wildcard()]
//│ = [50, 51]

// A user function with the same spelling does not change a method's key.
:w
:expect 52
private fun shadowed() =
  fun jsSymbol(key) = key
  class Ordinary {
    @jsSymbol(Keys.first) fun read() = 52
  }
  (new Ordinary).("read")()
shadowed()
//│ ╔══[WARNING] This annotation has no effect.
//│ ║  l.+4: 	    @jsSymbol(Keys.first) fun read() = 52
//│ ╙──      	    ^^^^^^^^^^^^^^^^^^^^^
//│ = 52

// An escaping instance can't refer back to the local key.
// Hoisting the key would incorrectly share it between different invocations.
@noInline
private fun escaping(value) =
  @fresh val localKey = Symbol("escaping")
  class Escaped {
    @jsSymbol(localKey) fun read() = value
  }
  new Escaped

// Lowering must report the unavailable key without emitting an out-of-scope reference.
:sir
:e
escaping(54).read()
//│ ╔══[COMPILATION ERROR] Cannot use @jsSymbol key 'localKey' here: 'localKey' is not in scope.
//│ ║  l.+1: 	escaping(54).read()
