// A structural field needs its key for both reading and writing.
@noInline
private fun localCell(value) =
  @fresh val cellKey = Symbol("cell")
  type Cell = {@jsSymbol(cellKey) value: Int}
  val cell: Cell = mut {(cellKey): value}
  cell

