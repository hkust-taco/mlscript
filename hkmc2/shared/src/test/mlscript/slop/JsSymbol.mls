// The annotation's unqualified module reference needs its enclosing path at the caller.
:expect [68, 69]
module OuterKeys {
  module Nested {
    @fresh val key = Symbol("nested key")
    class Reader {
      @jsSymbol(key) fun read() = 69
    }
  }
}
[new SymbolKeyLibrary.Nested.Reader().read(), new OuterKeys.Nested.Reader().read()]
//│ = [68, 69]

// Sibling scopes may use a module defined in their common lexical parent.
:expect [70, 71]
@noInline
private fun siblingReaders(value) =
  module Local {
    @fresh val key = Symbol("sibling key")
    class Reader {
      @jsSymbol(key) fun read() = value
    }
  }
  fun make() = new Local.Reader
  fun read() = make().read()
  read()
[siblingReaders(70), siblingReaders(71)]
//│ = [70, 71]

