:.
:js


// Async lowering moves the body to a helper with fresh bindings.
// Reads and writes of a mutable local copy must use the same binding.
:await
:expect 42
@annotations.async
fun increment(n: Int): Int =
  let =n
  set n += 1
  n
increment(41)
//│ = 42


// A suspended computation must resume with the updated local value.
:await
:expect 42
@annotations.async
fun incrementAfterAwait(n: Int): Int =
  let =n
  set n += handlers.await(Promise.resolve(1))
  n
incrementAfterAwait(41)
//│ = 42

// Nested closures must write the same binding that their enclosing body reads.
:await
:expect 42
@annotations.async
fun incrementInClosure(n: Int): Int =
  let =n
  let update = () => set n += 1
  update()
  n
incrementInClosure(41)
//│ = 42
