//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── defined here
//│ ║  l.+1: 	fun lateCurried(x) = x
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^
//│ ╙── Only a signature without parameter lists (`fun f: T`) can be written apart from a definition
//│ = 1

:e
fun lateBare(x) = x
fun lateBare
lateBare(1)
//│ ╔══[COMPILATION ERROR] A declaration of 'lateBare' cannot follow its definition
//│ ║  l.+2: 	fun lateBare
//│ ║        	^^^^^^^^^^^^
//│ ╟── defined here
//│ ║  l.+1: 	fun lateBare(x) = x
//│ ║        	^^^^^^^^^^^^^^^^^^^
//│ ╙── Only a signature without parameter lists (`fun f: T`) can be written apart from a definition
//│ = 1

:e
val lateBareVal = 1
val lateBareVal
lateBareVal
//│ ╔══[COMPILATION ERROR] A declaration of 'lateBareVal' cannot follow its definition
//│ ║  l.+2: 	val lateBareVal
//│ ║        	^^^^^^^^^^^^^^^
//│ ╟── defined here
//│ ║  l.+1: 	val lateBareVal = 1
//│ ║        	^^^^^^^^^^^^^^^^^^^
//│ ╙── Only a signature without parameter lists (`fun f: T`) can be written apart from a definition
