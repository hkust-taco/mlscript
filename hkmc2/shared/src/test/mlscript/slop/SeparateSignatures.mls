// The reported location excludes the modifier.
:e
class KBare with
  fun k(x) = x
  open fun k(x: Int): Int
(new KBare).k(1)
//│ ╔══[COMPILATION ERROR] A declaration of 'k' cannot follow its definition
//│ ║  l.+3: 	  open fun k(x: Int): Int
//│ ║        	       ^^^^^^^^^^^^^^^^^^
//│ ╟── defined here
//│ ║  l.+2: 	  fun k(x) = x
//│ ║        	  ^^^^^^^^^^^^
//│ ╙── Only a signature without parameter lists (`fun f: T`) can be written apart from a definition
//│ = 1

// A skipped declaration still reports a malformed symbolic name.
:e
fun lateSymbolic(x) = x
fun (class Lol) lateSymbolic: Int
lateSymbolic(1)
//│ ╔══[COMPILATION ERROR] This type definition is not a valid symbolic name
//│ ║  l.+2: 	fun (class Lol) lateSymbolic: Int
//│ ╙──      	     ^^^^^^^^^
//│ ╔══[COMPILATION ERROR] The signature of 'lateSymbolic' must be written before its definition
//│ ║  l.+2: 	fun (class Lol) lateSymbolic: Int
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── defined here
//│ ║  l.+1: 	fun lateSymbolic(x) = x
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^
//│ = 1


// The definition elaborates its separate signature once, without the definition's value parameters in scope.
:e
fun notFound: Foo -> Int
fun notFound(x) = x
//│ ╔══[COMPILATION ERROR] Name not found: Foo
//│ ║  l.+1: 	fun notFound: Foo -> Int
//│ ╙──      	              ^^^

class D()
fun paramNamedLikeClass: D -> D
fun paramNamedLikeClass(D) = D
paramNamedLikeClass(D())
//│ = D()

// Its names resolve where it is written, so an `open` between the two does not reach it.
module Opened with
  class Hidden(val y: Int)
  class Shadow(val y: Int)

:e
fun openedLater: Hidden -> Int
open Opened.{ Hidden }
fun openedLater(h) = h.y
//│ ╔══[COMPILATION ERROR] Name not found: Hidden
//│ ║  l.+1: 	fun openedLater: Hidden -> Int
//│ ╙──      	                 ^^^^^^
//│ ╔══[COMPILATION ERROR] This selection of member 'y' has no resolved target
//│ ║  l.+3: 	fun openedLater(h) = h.y
//│ ╙──      	                     ^^^

class Shadow(val x: Int)

// The signature's `Shadow` is the outer class, which has `x`; the opened one has `y`.
fun shadowed() =
  fun h: Shadow -> Int
  open Opened.{ Shadow }
  fun h(s) = s.x
  h
shadowed()(Shadow(1))
//│ = 1

// Each body gets its own signature and type parameters when definitions arrive in reverse order.
:expect [1, 2]
class LeftField(val left: Int)
class RightField(val right: Int)
fun interleaved() =
  fun left[A]: (LeftField, A) -> Int
  fun right[A]: (RightField, A) -> Int
  fun right[A](obj, value: A) = obj.right
  fun left[A](obj, value: A) = obj.left
  [left(LeftField(1), true), right(RightField(2), "ok")]
interleaved()
//│ = [1, 2]

// A use between the signature and the definition calls the definition.
fun usedBetween: Int -> Int
val usedBetweenResult = usedBetween(1)
fun usedBetween(x) = x + 1
usedBetweenResult
//│ = 2
//│ usedBetweenResult = 2

:expect 42
fun moduleResult: module ResultModule
module ResultModule with
  val answer = 42
fun moduleResult = ResultModule
moduleResult.answer
//│ = 42

private fun bothPrivate: Int -> Int
private fun bothPrivate(x) = x
bothPrivate(1)
//│ = 1

// Visibility belongs on the signature.
private fun privateSignature: Int -> Int
fun privateSignature(x) = x
privateSignature(1)
//│ = 1

:w
fun privateDefinition: Int -> Int
private fun privateDefinition(x) = x
//│ ╔══[WARNING] This modifier belongs on the signature of 'privateDefinition', not on its definition
//│ ║  l.+2: 	private fun privateDefinition(x) = x
//│ ║        	^^^^^^^
//│ ╟── signature here
//│ ║  l.+1: 	fun privateDefinition: Int -> Int
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

// Different visibilities written on the two sides contradict each other.
:e
private fun contradictoryVisibility: Int -> Int
public fun contradictoryVisibility(x) = x
//│ ╔══[COMPILATION ERROR] The signature and the definition of 'contradictoryVisibility' must have the same visibility
//│ ╟── signature here
//│ ║  l.+1: 	private fun contradictoryVisibility: Int -> Int
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── definition here
//│ ║  l.+2: 	public fun contradictoryVisibility(x) = x
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

:e
declare fun declared: Int -> Int
fun declared(x) = x
//│ ╔══[COMPILATION ERROR] A 'declare'd signature cannot have a definition
//│ ║  l.+1: 	declare fun declared: Int -> Int
//│ ║        	^^^^^^^
//│ ╟── definition here
//│ ║  l.+2: 	fun declared(x) = x
//│ ╙──      	^^^^^^^^^^^^^^^^^^^

:expect 42
fun annotatedResult: Int -> Int
fun annotatedResult(x): Int = x
annotatedResult(42)
//│ = 42

open annotations.{ * }

// An annotation on the wrong side warns but still applies.
:w
@tailrec fun tailrecSignature: Int -> Int
fun tailrecSignature(x) = x
//│ ╔══[WARNING] This annotation belongs on the definition of 'tailrecSignature', not on its signature
//│ ║  l.+1: 	@tailrec fun tailrecSignature: Int -> Int
//│ ║        	^^^^^^^^
//│ ╟── definition here
//│ ║  l.+2: 	fun tailrecSignature(x) = x
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[WARNING] This function is marked @tailrec but has no direct self-recursion.
//│ ║  l.+2: 	fun tailrecSignature(x) = x
//│ ╙──      	    ^^^^^^^^^^^^^^^^

:e
fun tailrecDefinition: Int -> Int
@tailrec fun tailrecDefinition(x) = tailrecDefinition(x) + 1
//│ ╔══[COMPILATION ERROR] This function is marked @tailrec but is not tail recursive.
//│ ║  l.+2: 	@tailrec fun tailrecDefinition(x) = tailrecDefinition(x) + 1
//│ ║        	             ^^^^^^^^^^^^^^^^^
//│ ╟── It could self-recurse through this call, which is not a tail call.
//│ ║  l.+2: 	@tailrec fun tailrecDefinition(x) = tailrecDefinition(x) + 1
//│ ╙──      	                                    ^^^^^^^^^^^^^^^^^^^^

// The definition's settings override the signature's: `count` becomes a loop.
:w
:soir
@config(tailRecOpt: false) fun count: Int -> Int
@config(tailRecOpt: true) fun count(n) = if n > 0 then count(n - 1) else 0
//│ ╔══[WARNING] This annotation belongs on the definition of 'count', not on its signature
//│ ║  l.+1: 	@config(tailRecOpt: false) fun count: Int -> Int
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── definition here
//│ ║  l.+2: 	@config(tailRecOpt: true) fun count(n) = if n > 0 then count(n - 1) else 0
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[WARNING] This annotation is written on both the signature and the definition of 'count'
//│ ║  l.+1: 	@config(tailRecOpt: false) fun count: Int -> Int
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── also written here
//│ ║  l.+2: 	@config(tailRecOpt: true) fun count(n) = if n > 0 then count(n - 1) else 0
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @config(...) @config(...)
//│ define count⁰ as fun count¹(n) {
//│   loop loopLabel:
//│     let scrut, tmp;
//│     set scrut = >⁰(n, 0);
//│     match scrut
//│       true =>
//│         set tmp = -⁰(n, 1);
//│         set n = tmp;
//│         continue loopLabel
//│       else
//│         return 0
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:w
fun pureDefinition: Int -> Int
@pure fun pureDefinition(x) = x
//│ ╔══[WARNING] This annotation belongs on the signature of 'pureDefinition', not on its definition
//│ ║  l.+2: 	@pure fun pureDefinition(x) = x
//│ ║        	^^^^^
//│ ╟── signature here
//│ ║  l.+1: 	fun pureDefinition: Int -> Int
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

@pure fun pureSignature: Int -> Int
fun pureSignature(x) = x
pureSignature(1)
//│ = 1

// An annotation on both sides warns and is kept twice, as when written twice on one side.
:w
:sir
@pure fun pureBoth: Int -> Int
@pure fun pureBoth(x) = x
//│ ╔══[WARNING] This annotation is written on both the signature and the definition of 'pureBoth'
//│ ║  l.+1: 	@pure fun pureBoth: Int -> Int
//│ ║        	^^^^^
//│ ╟── also written here
//│ ║  l.+2: 	@pure fun pureBoth(x) = x
//│ ╙──      	^^^^^
//│ ╔══[WARNING] This annotation belongs on the signature of 'pureBoth', not on its definition
//│ ║  l.+2: 	@pure fun pureBoth(x) = x
//│ ║        	^^^^^
//│ ╟── signature here
//│ ║  l.+1: 	@pure fun pureBoth: Int -> Int
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @pure @pure define pureBoth⁰ as fun pureBoth¹(x) { return x }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// Different arguments on the two sides: both are kept.
:w
:sir
@affine(0) fun affineBoth: Int -> Int -> Int
@affine(1) fun affineBoth(x)(y) = x
//│ ╔══[WARNING] This annotation belongs on the signature of 'affineBoth', not on its definition
//│ ║  l.+2: 	@affine(1) fun affineBoth(x)(y) = x
//│ ║        	^^^^^^^^^^
//│ ╟── signature here
//│ ║  l.+1: 	@affine(0) fun affineBoth: Int -> Int -> Int
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @affine(0) @affine(1) define affineBoth⁰ as fun affineBoth¹(x)(y) { return x }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

module Keys with
  @fresh val key = Symbol("key")
  @fresh val other = Symbol("other")

// `@jsSymbol` on both sides is an error.
:e
:w
class WithKey with
  @jsSymbol(Keys.key) fun keyed: () -> Int
  @jsSymbol(Keys.key) fun keyed() = 1
(new WithKey).(Keys.key)()
//│ ╔══[COMPILATION ERROR] This annotation must be written only on the signature of 'keyed'
//│ ║  l.+3: 	  @jsSymbol(Keys.key) fun keyed() = 1
//│ ║        	  ^^^^^^^^^^^^^^^^^^^
//│ ╟── signature's annotation here
//│ ║  l.+2: 	  @jsSymbol(Keys.key) fun keyed: () -> Int
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^
//│ ╔══[WARNING] This annotation belongs on the signature of 'keyed', not on its definition
//│ ║  l.+3: 	  @jsSymbol(Keys.key) fun keyed() = 1
//│ ║        	  ^^^^^^^^^^^^^^^^^^^
//│ ╟── signature here
//│ ║  l.+2: 	  @jsSymbol(Keys.key) fun keyed: () -> Int
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = 1

// Different keys are rejected as well, since the member is installed under only one key.
:e
:w
class WithKeys with
  @jsSymbol(Keys.key) fun keyed: () -> Int
  @jsSymbol(Keys.other) fun keyed() = 1
(new WithKeys).(Keys.key)()
//│ ╔══[COMPILATION ERROR] This annotation must be written only on the signature of 'keyed'
//│ ║  l.+3: 	  @jsSymbol(Keys.other) fun keyed() = 1
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^
//│ ╟── signature's annotation here
//│ ║  l.+2: 	  @jsSymbol(Keys.key) fun keyed: () -> Int
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^
//│ ╔══[WARNING] This annotation belongs on the signature of 'keyed', not on its definition
//│ ║  l.+3: 	  @jsSymbol(Keys.other) fun keyed() = 1
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^
//│ ╟── signature here
//│ ║  l.+2: 	  @jsSymbol(Keys.key) fun keyed: () -> Int
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = 1

// `@async` and `@generator` may be written on either side: the signature describes the body's result.
:await
:expect 1
fun asyncDefinition: Int -> Int
@async fun asyncDefinition(x) = x
asyncDefinition(1)
//│ = 1

:expect 1
@generator fun generatorSignature: Int -> Int
fun generatorSignature(x) =
  yield x
  x
generatorSignature(1).next().value
//│ = 1

// On both sides, it warns as any other annotation does, and both copies are kept.
:w
:await
:expect 1
@async fun asyncBoth: Int -> Int
@async fun asyncBoth(x) = x
asyncBoth(1)
//│ ╔══[WARNING] This annotation is written on both the signature and the definition of 'asyncBoth'
//│ ║  l.+1: 	@async fun asyncBoth: Int -> Int
//│ ║        	^^^^^^
//│ ╟── also written here
//│ ║  l.+2: 	@async fun asyncBoth(x) = x
//│ ╙──      	^^^^^^
//│ = 1

