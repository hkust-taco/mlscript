// A successful Child check on the call result also establishes Base.
:sir
class Base
class Child extends Base
fun narrowCall(f: () -> Any): Child = f() as Base
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define narrowCall⁰ as fun narrowCall¹(f) {
//│   return (f() as! Child⁰)
//│ };
//│ define Base⁰ as class Base¹;
//│ define Child¹ as class Child⁰ extends Base¹ {};
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// An ascription cannot convert between unboxed numeric representations.
:ge
fun invalid(x: Int32) = x as Float64
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int32' at an unrelated type 'Float64'
//│ ║  l.+1: 	fun invalid(x: Int32) = x as Float64
//│ ╙──      	                        ^^^^^^^^^^^^

// The call returns a struct. The inner check for Int must trap before the cast back to Box.
:!js
:wasm
:re
class Box()
fun box(): Box = new Box()
(box() as Int) as Box
