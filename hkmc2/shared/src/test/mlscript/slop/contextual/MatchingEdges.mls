:.

class Parent
class Child extends Parent
abstract class Accept[A] with
  fun label: Str
class ParentAccept extends Accept[Parent] with
  fun label: Str = "parent"
class UnionAccept extends Accept[Int | Str] with
  fun label: Str = "union"
class TopAccept extends Accept[Any] with
  fun label: Str = "top"
fun accept[A](value: A)(using a: Accept[A]) = a.label
using Accept[Parent] = new ParentAccept

:expect "parent"
accept(new Child)
//│ = "parent"

using Accept[Int | Str] = new UnionAccept

:expect "union"
[accept(1), accept("text")].(0)
//│ = "union"

using Accept[Any] = new TopAccept

:expect "top"
accept(new Child)
//│ = "top"

// §3.4 currently accepts structural forms at candidate argument positions.
class FunctionAccept extends Accept[Int -> Int] with
  fun label: Str = "function"
using Accept[Int -> Int] = new FunctionAccept

// TODO: §3.4 deliberately permits structural candidate arguments for now.
:expect "function"
accept((x: Int) => x)
//│ = "function"

// Several matching instances in one clause are ambiguous, including subclass heads.
class Specialized extends Accept[Int] with
  fun label: Str = "specialized"

:e
fun sameTier(using Accept[Int], Specialized) = accept(1)
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
//│ ║  l.+1: 	fun sameTier(using Accept[Int], Specialized) = accept(1)
//│ ║        	                                               ^^^^^^^^^
//│ ╟── Ambiguous instances for the contextual parameter 'a' of type Accept[A].
//│ ║  l.+1: 	fun sameTier(using Accept[Int], Specialized) = accept(1)
//│ ║        	                                               ^^^^^^^^^
//│ ╟── The contextual parameter is declared here.
//│ ║  l.XX: 	fun accept[A](value: A)(using a: Accept[A]) = a.label
//│ ║        	                        ^^^^^^^^^^^^^^^^^^
//│ ╟── This lexical instance of type Accept[Int] matches.
//│ ╙── This lexical instance of type Specialized matches.

// A later incompatible value cannot change the selected candidate.
class IntAccept extends Accept[Int] with
  fun label: Str = "int"
using Accept[Int] = new IntAccept

:expect "int"
fun unannotated(value) = accept(value)
unannotated(1)
//│ = "int"

:e
unannotated("later")
//│ ╔══[COMPILATION ERROR] This expression makes a value reach the type of the contextual parameter 'a' after its instance was selected.
//│ ║  l.+1: 	unannotated("later")
//│ ║        	^^^^^^^^^^^^^^^^^^^^
//│ ╟── The selected instance of type Accept[Int] does not accept this value.
//│ ║  l.+1: 	unannotated("later")
//│ ║        	            ^^^^^^^
//│ ╟── The instance was selected here.
//│ ║  l.XX: 	fun unannotated(value) = accept(value)
//│ ║        	                         ^^^^^^^^^^^^^
//│ ╟── The contextual parameter is declared here.
//│ ║  l.XX: 	fun accept[A](value: A)(using a: Accept[A]) = a.label
//│ ║        	                        ^^^^^^^^^^^^^^^^^^
//│ ╟── The selected instance is declared here.
//│ ║  l.XX: 	using Accept[Int] = new IntAccept
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = "int"
