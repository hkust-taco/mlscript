// Cyclic value observations become finite flow types by cutting the current path with ?.
:!js
:e
fun cyclic() = List(cyclic())
fun cycleCheck() =
  using fun loop[A](using inner: Show[A]): Show[A] = inner
  display(cyclic())
cycleCheck()
