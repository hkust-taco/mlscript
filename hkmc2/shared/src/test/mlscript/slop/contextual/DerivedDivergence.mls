// A query can start with an unknown position; its frozen snapshot must not grow
// when the derived function's nested requirements introduce List positions.
:e
fun unspecified() =
  using fun bad[A](using inner: Show[List[A]]): Show[A] = Show[A](inner.label)
  fun request[A](using show: Show[A]) = show.label
  request
