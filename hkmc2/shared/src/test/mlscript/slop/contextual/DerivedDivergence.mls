class Rose(val kids: List[Rose])

:e
fun rose(value: Rose) =
  using fun list[A](using inner: Show[A]): Show[List[A]] = Show[List[A]](inner.label)
  using fun tree(using inner: Show[List[Rose]]): Show[Rose] = Show[Rose](inner.label)
  display(value)
