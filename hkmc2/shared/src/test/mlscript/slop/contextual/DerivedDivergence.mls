:.

class List[A](val head: A)
class Pair[A, B](val first: A, val second: B)
class Show[A](val label: Str)
module Show with
  using Show[Int] = Show[Int]("int")
fun display[A](value: A)(using show: Show[A]) = show.label

// Equality excludes only the recursive candidate; the namespace instance remains.
:expect "loop(int)"
fun withAlternative() =
  using fun loop[A](using inner: Show[A]): Show[A] = Show[A]("loop(" + inner.label + ")")
  display(1)
withAlternative()
//│ = "loop(int)"

// No backtracking: failure of the selected function's argument is reported at this site.
:e
fun noAlternative() =
  using fun loop[A](using inner: Show[A]): Show[A] = inner
  display("missing")
noAlternative()
