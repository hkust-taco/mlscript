// A larger query using a different function does not trigger divergence.
:expect "outer(inner)"
fun different() =
  using fun inner[A]: Show[List[A]] = Show[List[A]]("inner")
  using fun enclosing(using inner: Show[List[Int]]): Show[Int] = Show[Int]("outer(" + inner.label + ")")
  display(1)
different()
//│ = "outer(inner)"

// Permutation repeats the original type after two steps.
:e
fun swap() =
  using fun pair[A, B](using inner: Show[Pair[B, A]]): Show[Pair[A, B]] = Show[Pair[A, B]](inner.label)
  display(Pair(1, "two"))
swap()
