// The same declaration reached through two argument namespaces is one candidate.
class Pair[A, B]
class Duplicated[A]
module Shared with
  class Left
  class Right
  using Duplicated[Pair[Left, Right]] = new Duplicated[Pair[Left, Right]]

:expect 43
fun duplicated(using Duplicated[Pair[Shared.Left, Shared.Right]]) = 43
duplicated
//│ = 43

// Ordinary values of the right type do not become instances.
class Ordinary
module Ordinary with
  val value = new Ordinary

:e
use[Ordinary]
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
