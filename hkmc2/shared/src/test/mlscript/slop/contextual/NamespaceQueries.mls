// Private instance access is allowed within its owner's scope.
class Private
module Private with
  private using Private = new Private
  fun read = use[Private]

:expect 44
fun privateRead(value: Private) = 44
privateRead(Private.read)
//│ = 44

// A parameter's declared alias retains its own companion before expansion.
class AliasBase
type AliasName = AliasBase
module AliasName with
  using AliasName = new AliasBase
fun aliasParameter(value: AliasName) = choose(value)

:expect 42
aliasParameter(new AliasBase)
//│ = 42

// An alias provider does not suppress the independent type-argument namespaces.
class AliasEvidence[A]
class Data
type Alias[A] = AliasEvidence[A]
module Alias with
  using AliasEvidence[Data] = new AliasEvidence[Data]
module Data with
  using AliasEvidence[Data] = new AliasEvidence[Data]

:e
fun aliasArguments(using Alias[Data]) = 45
aliasArguments
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
