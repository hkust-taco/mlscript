:.

// A declaration in a type's enclosing module provides without a companion.
module Enclosing with
  class Evidence
  using Evidence = new Evidence

:expect 42
fun enclosing(using Enclosing.Evidence) = 42
enclosing
//│ = 42

// Alias expansion must retain subclass heads for first-provider cutoff.
abstract class Base[A] with
  fun label: Str
module Base with
  class Derived extends Base[Int] with
    fun label: Str = "derived"
  type Alias = Derived
  using Alias = new Derived

:expect "derived"
fun aliased(using b: Base[Int]) = b.label
aliased
//│ = "derived"

// The same provider cuts off traversal even for incompatible argument flows.
:e
fun incompatible(using Base[Str]) = 42
incompatible
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
//│ ║  l.+2: 	incompatible
//│ ║        	^^^^^^^^^^^^
//│ ╟── No instance is compatible with the type of the contextual argument supplied implicitly here.
//│ ║  l.+2: 	incompatible
//│ ║        	^^^^^^^^^^^^
//│ ╟── The contextual argument is passed to this parameter.
//│ ║  l.+1: 	fun incompatible(using Base[Str]) = 42
//│ ║        	                 ^^^^^^^^^^^^^^^
//│ ╟── This instance from namespace 'Base' has an incompatible type, Derived.
//│ ║  l.XX: 	  using Alias = new Derived
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── A value of class 'Str' flows into the type of the contextual argument.
//│ ║  l.+1: 	fun incompatible(using Base[Str]) = 42
//│ ╙──      	                            ^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Nested written arguments contribute their data-type companions.
class Wrapped[A]
abstract class Nested[A] with
  fun label: Str
class Data
module Data with
  class Evidence extends Nested[Wrapped[Data]] with
    fun label: Str = "nested"
  using Nested[Wrapped[Data]] = new Evidence

:expect "nested"
fun nested(using n: Nested[Wrapped[Data]]) = n.label
nested
//│ = "nested"

// Imported modules contribute the same declaration index.
import "./mlscript-compile/ImportedInstances.mls"

:expect 42
fun imported(using ImportedInstances.Evidence) = 42
imported
//│ = 42

// A later subtype adds a provider, but its Child instance cannot accept the earlier Parent.
// It does not match the whole query, so §3.6 requires no late-namespace error.
class Parent with
  fun label: Str = "parent"
module Parent with
  using Parent = new Parent
class Child extends Parent
module Child with
  using Child = new Child

:expect "parent"
fun instanceFor[T](value: T)(using instance: T): T = instance
fun later(value) = instanceFor(value).label
later(new Parent)
//│ = "parent"

:expect "parent"
later(new Child)
//│ = "parent"
