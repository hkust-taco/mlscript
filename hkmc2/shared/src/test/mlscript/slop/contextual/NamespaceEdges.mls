// A later subtype adds a namespace whose instance would also have matched.
class Parent with
  fun label: Str = "parent"
module Parent with
  using Parent = new Parent
class Child extends Parent
module Child with
  using Child = new Child

:fixme // namespace selection (Phase 3)
:expect "parent"
fun later[T](value: T) = use[T].label
later(new Parent)
