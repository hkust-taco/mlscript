:.

class Evidence[A](val label: Str)
class First
class Second
module First with
  using Evidence[Any] = Evidence[Any]("first")
module Second with
  using Evidence[Any] = Evidence[Any]("second")
fun consume[A](value: A)(using e: Evidence[A]) = e.label

:expect "first"
fun generic[A](value: A) = consume(value)
generic(new First)
//│ = "first"

// Both instances accept all of the query's values, so the new provider must be diagnosed.
:e
generic(new Second)
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
//│ ║  l.XX: 	fun generic[A](value: A) = consume(value)
//│ ║        	                           ^^^^^^^^^^^^^^
//│ ╟── The contextual parameter 'e' of type Evidence[A] was resolved before flow revealed its implicit namespace module 'Second'.
//│ ║  l.XX: 	fun generic[A](value: A) = consume(value)
//│ ║        	                           ^^^^^^^^^^^^^^
//│ ╟── Here, the companion module 'Second' of class 'Second' provides this matching instance of type Evidence[Any].
//│ ║  l.XX: 	  using Evidence[Any] = Evidence[Any]("second")
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This value reveals the namespace.
//│ ║  l.+1: 	generic(new Second)
//│ ║        	        ^^^^^^^^^^
//│ ╟── This instance of type Evidence[Any] was selected earlier.
//│ ║  l.XX: 	  using Evidence[Any] = Evidence[Any]("first")
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = "first"

// Lexical selection does not consult or observe the namespace tier.
using Evidence[Any] = Evidence[Any]("lexical")

:expect "lexical"
fun lexical[A](value: A) = consume(value)
lexical(new First)
//│ = "lexical"

:expect "lexical"
lexical(new Second)
//│ = "lexical"
