:.

class Evidence[A](val label: Str)
class First
class Second
module First with
  using Evidence[Any] = Evidence[Any]("first")
module Second with
  using Evidence[Any] = Evidence[Any]("second")
fun consume[A](value: A)(using e: Evidence[A]) = e.label

// Callers' values reach an unannotated parameter, unlike an explicit type parameter.
:expect "first"
fun unannotated(value) = consume(value)
unannotated(new First)
//│ = "first"

// Both instances accept all of the query's values, so the new provider must be diagnosed.
:e
unannotated(new Second)
//│ ╔══[COMPILATION ERROR] Contextual argument resolution error in application
//│ ║  l.+1: 	unannotated(new Second)
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── The instance of the contextual argument supplied implicitly here was selected before flow revealed the implicit namespace module 'Second' of its type.
//│ ║  l.XX: 	fun unannotated(value) = consume(value)
//│ ║        	                         ^^^^^^^^^^^^^^
//│ ╟── The contextual argument is passed to this parameter.
//│ ║  l.XX: 	fun consume[A](value: A)(using e: Evidence[A]) = e.label
//│ ║        	                         ^^^^^^^^^^^^^^^^^^^^
//│ ╟── Here, the companion module 'Second' of class 'Second' provides this instance, which has a compatible type, Evidence[Any].
//│ ║  l.XX: 	  using Evidence[Any] = Evidence[Any]("second")
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This value reveals the namespace.
//│ ║  l.+1: 	unannotated(new Second)
//│ ║        	            ^^^^^^^^^^
//│ ╟── This instance, of type Evidence[Any], was selected earlier.
//│ ║  l.XX: 	  using Evidence[Any] = Evidence[Any]("first")
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = "first"

// Lexical selection does not consult or observe the namespace tier.
using Evidence[Any] = Evidence[Any]("lexical")

:expect "lexical"
fun lexical[A](value: A) = consume(value)
lexical(new First)
//│ = "lexical"

:expect "lexical"
lexical(new Second)
//│ = "lexical"
