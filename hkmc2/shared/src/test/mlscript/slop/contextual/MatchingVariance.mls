:.

class Animal
class Cat extends Animal
class Dog extends Animal
class Printer[in A](val label: Str)
fun printer[A](using p: Printer[A]) = p.label

using Printer[Animal] = Printer[Animal]("animal")

// A printer accepting every animal can serve a query for cats.
:expect "animal"
printer[Cat]
//│ = "animal"

using Printer[Dog] = Printer[Dog]("dog")

// TODO: The dog printer is incompatible and must not hide the earlier animal printer.
// Matching currently loses both input types by observing their Any output parts.
:todo
:expect "animal"
printer[Cat]
//│ ═══[RUNTIME ERROR] Expected: '"animal"', got: '"dog"'
//│ = "dog"

// TODO: Only the animal printer is applicable; the dog printer must not cause ambiguity.
// Both candidates occupy one tier, so this tests applicability rather than shadowing.
:todo
:expect "animal"
fun sameTier(using Printer[Animal], Printer[Dog]) = printer[Cat]
sameTier(using Printer[Animal]("animal"), Printer[Dog]("dog"))
