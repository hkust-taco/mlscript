class Source[out A](val label: Str)
fun source[A](using s: Source[A]) = s.label
using Source[Cat] = Source[Cat]("cat")

// TODO: A source producing cats can serve a query for a source of animals.
// Matching currently asks whether Cat accepts Animal, reversing the covariant relation.
