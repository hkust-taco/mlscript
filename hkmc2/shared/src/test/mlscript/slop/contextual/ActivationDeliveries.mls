:.

class Show[A](val label: Str)
module Show with
  using Show[Int] = Show[Int]("int")
  using Show[Str] = Show[Str]("str")
class C with
  fun show[T](value: T)(using s: Show[T]) = s.label

// The receiver `y` has values only in the activations of the two calls of `twice`. The
// application of `y.show` in each activation must reach the contextual site, whose query then
// sees both `Int` and `Str`; the site decides once for all activations and reports once.
:e
fun twice[A](value: A, y) = y.show(value)
[twice(1, new C), twice("text", new C)]
