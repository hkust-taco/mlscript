// Type-argument namespaces contribute instances.
abstract class Tag[A] with
  fun label: Str
class Point
module Point with
  class PointTag extends Tag[Point] with
    fun label: Str = "point"
  using Tag[Point] = new PointTag
fun tag[A](value: A)(using t: Tag[A]) = t.label

:fixme // namespace instance selection (Phase 3)
