:fixme // generic override representation check, independent of contextual insertion
// A lexical instance shadows the namespace tier.
:expect "lexical"
class LocalShow extends Show[Int] with
  fun show(value: Int): Str = "lexical"
using Show[Int] = new LocalShow
render(1)
//│ ╔══[COMPILATION ERROR] Parameter 'value' of overriding member 'show' is represented as 'Int', which cannot hold the values represented as 'Unknown' that the member it overrides accepts
