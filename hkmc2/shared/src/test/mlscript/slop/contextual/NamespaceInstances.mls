// Namespace ambiguity does not use specificity.
abstract class Both[A] with
  fun label: Str
class Thing
module Both with
  class First extends Both[Thing] with
    fun label: Str = "first"
  using Both[Thing] = new First
module Thing with
  class Second extends Both[Thing] with
    fun label: Str = "second"
  using Both[Thing] = new Second
fun both[A](value: A)(using b: Both[A]) = b.label

:breakme // contextual diagnostic not implemented yet
