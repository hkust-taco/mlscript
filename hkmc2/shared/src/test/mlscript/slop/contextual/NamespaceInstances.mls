// §3.3: type-class companion, including a subclass-only provider.
abstract class Show[A] with
  fun show(value: A): Str
class IntShow extends Show[Int] with
  fun show(value: Int): Str = "int"
module Show with
  using IntShow = new IntShow
fun render[A](value: A)(using show: Show[A]) = show.show(value)
//│ ╔══[COMPILATION ERROR] Parameter 'value' of overriding member 'show' is represented as 'Int', which cannot hold the values represented as 'Unknown' that the member it overrides accepts
