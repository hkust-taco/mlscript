:fixme // namespace instance selection (Phase 3)
// Declaration heads cut off the walk even when argument compatibility rejects them.
module Outer with
  abstract class Codec[A] with
    fun label: Str
  class IntCodec extends Codec[Int] with
    fun label: Str = "int"
  class StrCodec extends Codec[Str] with
    fun label: Str = "str"
  using Codec[Int] = new IntCodec
  module Codec with
    using Codec[Str] = new StrCodec
fun codec[A](value: A)(using c: Outer.Codec[A]) = c.label
//│ ═══[RUNTIME ERROR] TypeError: Class extends value undefined is not a constructor or null

