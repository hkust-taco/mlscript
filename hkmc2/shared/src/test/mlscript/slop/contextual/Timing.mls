// Publishing the first site's selected argument reveals the next site's namespace.
module Choices with
  class Choice(val label: Str)
  using Choice = Choice("chosen")
data class Wrapper[A](value: A)
using Wrapper[Choices.Choice] = Wrapper(Choices.Choice("wrapped"))
fun first[A](using wrapped: Wrapper[A]): A = wrapped.value
fun second[A](value: A)(using chosen: A) = chosen

