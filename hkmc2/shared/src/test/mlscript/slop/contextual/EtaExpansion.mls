//│     return 0
//│   }
//│   method main⁰ = fun main¹(tmp) {
//│     let contextualOperand, tmp1, contextualOperand1, lambda;
//│     set contextualOperand = Test².this;
//│     set tmp1 = [tmp];
//│     set contextualOperand1 = tmp1;
//│     @private
//│     define lambda as fun lambda¹(...arguments1) {
//│       return contextualOperand.test¹(...arguments1)(...contextualOperand1)
