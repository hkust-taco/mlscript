using Int = 42

fun foo()(using Int) = [use[Int]]

fun bar(x)(using Int) = [x, use[Int]]

fun baz(x)(using Int)(y)(using Num) = [x, use[Int], y, use[Num]]

:breakme // contextual diagnostic not implemented yet
:e
baz
//│ = fun baz


using Num = 0.42

// foo
// should be expanded to
// () => foo()
// and then resolved to
// () => foo()(<using> 42)
:sir
let f1 = foo
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ set f1⁰ = foo⁰; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f1 = fun foo

:expect [42]
f1()
//│ = [42]

// bar
// should be expanded to
// (x) => bar(x)
// and then resolved to
// (x) => bar(x)(<using> 42)
:sir
let f2 = bar
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ set f2⁰ = bar⁰; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f2 = fun bar

:expect [0.42, 42]
f2(0.42)
//│ = [0.42, 42]

// baz
// should be expanded to
// (x) => baz(x)
// and then resolved to
// (x) => baz(x)(<using> 42)
:sir
let f3 = baz
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ set f3⁰ = baz⁰; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f3 = fun baz

:expect [43, 42, 44, 0.42]
f3(43)(44)
//│ = [43, 42, 44, 0.42]

// This should not expand
:sir
foo()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp; set tmp = [contextual_instance_0⁰]; return foo⁰()(...tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [42]

// This should not expand
:sir
bar(0.42)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
