:.

using Int = 42

fun foo()(using Int) = [use[Int]]

fun bar(x)(using Int) = [x, use[Int]]

fun baz(x)(using Int)(y)(using Num) = [x, use[Int], y, use[Num]]

// Int is also a Num, so the current Int instance supplies both clauses.
:expect [1, 42, 2, 42]
let early = baz
early(1)(2)
//│ = [1, 42, 2, 42]
//│ early = fun early


using Num = 0.42

// foo
// should be expanded to
// () => foo()
// and then resolved to
// () => foo()(<using> 42)
:sir
let f1 = foo
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp, contextualOperand, f1;
//│ set tmp = [contextual_instance_0⁰];
//│ set contextualOperand = tmp;
//│ @private
//│ define f1 as fun f1⁰(...arguments1) {
//│   return foo⁰(...arguments1)(...contextualOperand)
//│ };
//│ set f1¹ = f1⁰;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f1 = fun f1

:expect [42]
f1()
//│ = [42]

// bar
// should be expanded to
// (x) => bar(x)
// and then resolved to
// (x) => bar(x)(<using> 42)
:sir
let f2 = bar
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp, contextualOperand, f2;
//│ set tmp = [contextual_instance_0⁰];
//│ set contextualOperand = tmp;
//│ @private
//│ define f2 as fun f2⁰(...arguments1) {
//│   return bar⁰(...arguments1)(...contextualOperand)
//│ };
//│ set f2¹ = f2⁰;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f2 = fun f2

:expect [0.42, 42]
f2(0.42)
//│ = [0.42, 42]

// baz
// should be expanded to
// (x) => baz(x)
// and then resolved to
// (x) => baz(x)(<using> 42)
:sir
let f3 = baz
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp, contextualOperand, tmp1, contextualOperand1, f3;
//│ set tmp = [contextual_instance_0⁰];
//│ set contextualOperand = tmp;
//│ set tmp1 = [contextual_instance_0¹];
//│ set contextualOperand1 = tmp1;
//│ @private
//│ define f3 as fun f3⁰(...arguments1) {
//│   let lambda;
//│   @private
//│   define lambda as fun lambda⁰(...arguments2) {
//│     return baz⁰(...arguments1)(...contextualOperand)(...arguments2)(...contextualOperand1)
//│   };
//│   return lambda⁰
//│ };
//│ set f3¹ = f3⁰;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f3 = fun f3

:expect [43, 42, 44, 0.42]
f3(43)(44)
//│ = [43, 42, 44, 0.42]

// This should not expand
:sir
foo()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp; set tmp = [contextual_instance_0⁰]; return foo⁰()(...tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [42]

// This should not expand
:sir
bar(0.42)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp; set tmp = [contextual_instance_0⁰]; return bar⁰(0.42)(...tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [0.42, 42]


:checkIR
:sir
module Test with
  fun test(j)(using Int) = 0
  fun main(using Int) = test
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Test⁰ as class Test¹
//│ module Test² {
