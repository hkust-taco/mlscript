:.

import "./mlscript-compile/DerivedLibrary.mls"
open DerivedLibrary { List, display, fixed }

:expect "list(list(int))"
display(List(List(1)))
//│ = "list(list(int))"

:expect "list(int)"
fixed(List(1))
//│ = "list(int)"

:e
fixed(List("late"))
//│ ╔══[COMPILATION ERROR] Contextual argument resolution error in application
