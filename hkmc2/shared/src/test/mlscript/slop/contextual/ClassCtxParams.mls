// An explicit contextual list in an `extends` clause reaches the parent constructor.
class Parent(using val n: Int)
class ExplicitChild extends Parent(using 7)

:expect 7
new ExplicitChild().n
//│ = 7

// TODO: `extends` clauses are class operands, not contextual sites, so they do not yet
// supply a parent constructor's contextual lists; lowering rejects the partial application.
:todo
class ImplicitChild extends Parent
//│ ╔══[COMPILATION ERROR] Extending a partially applied class is not supported
