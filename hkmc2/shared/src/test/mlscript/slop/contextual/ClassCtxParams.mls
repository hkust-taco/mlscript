fun summon(using i: Int) = i

class Foo(using Int) with
  fun foo = use[Int]
  fun bar = summon

using Int = 99

:expect Foo(_)
Foo
//│ = Foo(_)

:expect 99
Foo.foo
//│ = 99

:expect 99
Foo.bar
//│ = 99

