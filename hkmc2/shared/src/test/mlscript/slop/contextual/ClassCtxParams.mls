using Int = 42


class Foo(using val n: Int)

:expect Foo(42)
Foo
//│ = Foo(42)

:expect 42
Foo.n
//│ = 42


class Foo(using n: Int) with
  fun foo = n

:expect Foo(_)
Foo
//│ = Foo(_)

:expect 42
Foo.foo
//│ = 42


