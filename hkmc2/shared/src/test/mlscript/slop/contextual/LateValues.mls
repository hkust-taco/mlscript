:.

import "./mlscript-compile/LexicalQueries.mls"

// A completed imported body keeps validating its fixed instance selection.
:expect 42
LexicalQueries.unannotated(1)
//│ = 42

:e
LexicalQueries.unannotated("later")
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
//│ ║  l.XX: 	  fun unannotated(value) = consume(value)
//│ ║        	                           ^^^^^^^^^^^^^^
//│ ╟── This value reaches the type of the unnamed contextual parameter after its instance was selected; the selected instance of type Accept[Int] does not accept it.
//│ ║  l.XX: 	  fun unannotated(value) = consume(value)
//│ ║        	                           ^^^^^^^^^^^^^^
//│ ╟── The contextual parameter is declared here.
//│ ║  l.XX: 	  fun consume[A](value: A)(using Accept[A]) = 42
//│ ║        	                           ^^^^^^^^^^^^^^^
//│ ╟── The selected instance is declared here.
//│ ║  l.XX: 	  using Accept[Int] = new Accept[Int]
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This value is incompatible with the selected instance.
//│ ║  in LateValues.mls:+1
//│ ║  l.+1: 	LexicalQueries.unannotated("later")
//│ ╙──      	                           ^^^^^^^
//│ = 42

// Nested nominal argument positions must observe their declared element types.
class Box[A](val value: A)
class AcceptBox[A]
using AcceptBox[Box[Int]] = new AcceptBox[Box[Int]]
fun consumeBox[A](value: A)(using AcceptBox[A]) = 43

:expect 43
fun boxed(value) = consumeBox(value)
boxed(new Box[Int](1))
//│ = 43

:e
boxed(new Box[Str]("later"))
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
//│ ║  l.XX: 	fun boxed(value) = consumeBox(value)
//│ ║        	                   ^^^^^^^^^^^^^^^^^
//│ ╟── This value reaches the type of the unnamed contextual parameter after its instance was selected; the selected instance of type AcceptBox[Box[Int]] does not accept it.
//│ ║  l.XX: 	fun boxed(value) = consumeBox(value)
//│ ║        	                   ^^^^^^^^^^^^^^^^^
//│ ╟── The contextual parameter is declared here.
//│ ║  l.XX: 	fun consumeBox[A](value: A)(using AcceptBox[A]) = 43
//│ ║        	                            ^^^^^^^^^^^^^^^^^^
//│ ╟── The selected instance is declared here.
//│ ║  l.XX: 	using AcceptBox[Box[Int]] = new AcceptBox[Box[Int]]
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This value is incompatible with the selected instance.
//│ ║  l.+1: 	boxed(new Box[Str]("later"))
//│ ╙──      	              ^^^
//│ = 43

// Independent call-site instances must not be merged into one query position.
using AcceptBox[Box[Str]] = new AcceptBox[Box[Str]]

:expect [43, 43]
[consumeBox(new Box[Int](1)), consumeBox(new Box[Str]("text"))]
//│ = [43, 43]
