// A lexical derived instance shadows matching namespace instances.
:expect "local(local(int))"
fun local() =
  using fun wrap[A](using element: Show[A]): Show[List[A]] = Show[List[A]]("local(" + element.label + ")")
  display(List(List(1)))
local()
//│ = "local(local(int))"

// Declaration identity, not specificity, decides ambiguity within the namespace tier.
class Ambiguous[A](val label: Str)
module Ambiguous with
  using Ambiguous[List[Int]] = Ambiguous[List[Int]]("direct")
  using fun list[A]: Ambiguous[List[A]] = Ambiguous[List[A]]("derived")
fun ambiguous[A](value: A)(using instance: Ambiguous[A]) = instance.label

:e
ambiguous(List(1))
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
//│ ║  l.+1: 	ambiguous(List(1))
//│ ║        	^^^^^^^^^^^^^^^^^^
//│ ╟── Multiple instances are compatible with the type of the contextual argument supplied implicitly here.
//│ ║  l.+1: 	ambiguous(List(1))
//│ ║        	^^^^^^^^^^^^^^^^^^
//│ ╟── The contextual argument is passed to this parameter.
//│ ║  l.XX: 	fun ambiguous[A](value: A)(using instance: Ambiguous[A]) = instance.label
//│ ║        	                           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This instance from namespace 'Ambiguous' has a compatible type, Ambiguous[List[Int]].
//│ ║  l.XX: 	  using Ambiguous[List[Int]] = Ambiguous[List[Int]]("direct")
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This instance from namespace 'Ambiguous' has a compatible type, Ambiguous[List[A]].
