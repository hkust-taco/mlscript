// An explicit query type specializes a generic contextual parameter.
:expect "list(list(int))"
fun summon[A](using instance: A) = instance
summon[Show[List[List[Int]]]].label
//│ = "list(list(int))"

// A written result alias retains inference into the function's own type parameters.
type ShownList[A] = Show[List[A]]

:expect "alias:int"
fun aliasResult() =
  using fun throughAlias[A](using element: Show[A]): ShownList[A] = Show[List[A]]("alias:" + element.label)
  display(List(1))
aliasResult()
//│ = "alias:int"

// An unbound query parameter discovers the result class through its incoming value.
:expect "list(int)"
fun summonLike[A](value: A)(using instance: A) = instance
summonLike(Show[List[Int]]("input")).label
//│ = "list(int)"
