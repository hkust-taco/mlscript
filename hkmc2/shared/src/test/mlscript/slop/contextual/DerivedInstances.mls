:.

class List[A](val head: A)
class Show[A](val label: Str)
module Show with
  using Show[Int] = Show[Int]("int")
  using fun text: Show[Str] = Show[Str]("str")
  using fun list[A](using element: Show[A]): Show[List[A]] = Show[List[A]]("list(" + element.label + ")")
fun display[A](value: A)(using show: Show[A]) = show.label

:expect "list(int)"
display(List(1))
//│ = "list(int)"

:expect "list(list(int))"
display(List(List(1)))
//│ = "list(list(int))"

:expect "str"
display("hello")
//│ = "str"

:e
display(List(true))
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
