// A lexical derived instance shadows matching namespace instances.
:expect "local(local(int))"
fun local() =
  using fun wrap[A](using element: Show[A]): Show[List[A]] = Show[List[A]]("local(" + element.label + ")")
  display(List(List(1)))
local()
//│ = "local(local(int))"

// Declaration identity, not specificity, decides ambiguity within the namespace tier.
class Ambiguous[A](val label: Str)
module Ambiguous with
  using Ambiguous[List[Int]] = Ambiguous[List[Int]]("direct")
  using fun list[A]: Ambiguous[List[A]] = Ambiguous[List[A]]("derived")
fun ambiguous[A](value: A)(using instance: Ambiguous[A]) = instance.label

:e
ambiguous(List(1))
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
//│ ║  l.+1: 	ambiguous(List(1))
//│ ║        	^^^^^^^^^^^^^^^^^^
//│ ╟── Ambiguous instances for the contextual parameter 'instance' of type Ambiguous[A].
//│ ║  l.+1: 	ambiguous(List(1))
//│ ║        	^^^^^^^^^^^^^^^^^^
//│ ╟── The contextual parameter is declared here.
//│ ║  l.XX: 	fun ambiguous[A](value: A)(using instance: Ambiguous[A]) = instance.label
//│ ║        	                           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This instance of type Ambiguous[List[Int]] comes from namespace 'Ambiguous'.
//│ ║  l.XX: 	  using Ambiguous[List[Int]] = Ambiguous[List[Int]]("direct")
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This instance of type Ambiguous[List[A]] comes from namespace 'Ambiguous'.
//│ ║  l.XX: 	  using fun list[A]: Ambiguous[List[A]] = Ambiguous[List[A]]("derived")
//│ ╙──      	        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// An explicit query type specializes a generic contextual parameter.
:expect "list(list(int))"
fun summon[A](using instance: A) = instance
summon[Show[List[List[Int]]]].label
//│ = "list(list(int))"

// A written result alias retains inference into the function's own type parameters.
type ShownList[A] = Show[List[A]]

:expect "alias:int"
fun aliasResult() =
  using fun throughAlias[A](using element: Show[A]): ShownList[A] = Show[List[A]]("alias:" + element.label)
  display(List(1))
aliasResult()
//│ = "alias:int"

// An unbound query parameter discovers the result class through its incoming value.
:expect "list(int)"
fun summonLike[A](value: A)(using instance: A) = instance
summonLike(Show[List[Int]]("input")).label
//│ = "list(int)"
