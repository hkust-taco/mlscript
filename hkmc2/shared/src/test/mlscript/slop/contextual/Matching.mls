// §3.4: nominal inheritance at the query head and at its argument positions.
abstract class Box[A] with
  fun label: Str
class IntBox extends Box[Int] with
  fun label: Str = "int"
class NumBox extends Box[Num] with
  fun label: Str = "num"
fun box[A](value: A)(using b: Box[A]) = b.label
using IntBox = new IntBox

