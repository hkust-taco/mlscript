#lang(0.3.x)

module NamespaceFlow with
  class Evidence[A](val label: Str)
  class First
  class Second
  module First with
    using Evidence[Any] = Evidence[Any]("first")
  module Second with
    using Evidence[Any] = Evidence[Any]("second")
  fun consume[A](value: A)(using e: Evidence[A]) = e.label
  // Callers' values reach an unannotated parameter, unlike an explicit type parameter.
  fun unannotated(value) = consume(value)
  val seed = unannotated(new First)
