// FIXME: a class parameter carries the actual arguments of every construction into the
// class body, so they reach the method's query as late values, and through it the queries
// of other construction sites. Ordinary member lookup in the body does not use them.
:fixme
:expect ["int", "str"]
class Boxed[A](val value: A)(using s: Show[A]) with
  fun shown = display(value)
[Boxed(1).shown, Boxed("text").shown]
