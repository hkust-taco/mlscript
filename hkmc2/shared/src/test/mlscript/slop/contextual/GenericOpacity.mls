:.

class Show[A](val label: Str)
module Show with
  using Show[Int] = Show[Int]("int")
  using Show[Str] = Show[Str]("str")
fun display[A](value: A)(using show: Show[A]) = show.label

// Explicit type parameters are opaque: a generic body cannot select an instance from the
// types its callers pass, even when every caller passes an `Int`.
:e
fun opaque[A](value: A) = display(value)
opaque(1)
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
//│ ║  l.+1: 	fun opaque[A](value: A) = display(value)
//│ ║        	                          ^^^^^^^^^^^^^^
//│ ╟── No instance found for the contextual parameter 'show' of type Show[A].
//│ ║  l.+1: 	fun opaque[A](value: A) = display(value)
//│ ║        	                          ^^^^^^^^^^^^^^
//│ ╟── The contextual parameter is declared here.
//│ ║  l.XX: 	fun display[A](value: A)(using show: Show[A]) = show.label
//│ ║        	                         ^^^^^^^^^^^^^^^^^^^
//│ ╟── This instance of type Show[Int] from namespace 'Show' does not accept all values reaching the query.
//│ ║  l.XX: 	  using Show[Int] = Show[Int]("int")
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This instance of type Show[Str] from namespace 'Show' does not accept all values reaching the query.
