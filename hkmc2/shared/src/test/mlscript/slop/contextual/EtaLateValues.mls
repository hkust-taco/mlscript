:.

class Evidence[A](val label: Str)
using Evidence[Int] = Evidence[Int]("int")
fun consume[A](value: A)(using e: Evidence[A]) = e.label

// Calls of one stored expansion share its already selected contextual argument.
:expect "int"
let polymorphic = consume
polymorphic(1)
//│ = "int"
//│ polymorphic = fun polymorphic

:e
polymorphic("later")
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
//│ ║  l.XX: 	let polymorphic = consume
//│ ║        	                  ^^^^^^^
//│ ╟── This value reaches the type of the contextual parameter 'e' after its instance was selected; the selected instance of type Evidence[Int] does not accept it.
//│ ║  l.XX: 	let polymorphic = consume
//│ ║        	                  ^^^^^^^
//│ ╟── The contextual parameter is declared here.
//│ ║  l.XX: 	fun consume[A](value: A)(using e: Evidence[A]) = e.label
//│ ║        	                         ^^^^^^^^^^^^^^^^^^^^
//│ ╟── The selected instance is declared here.
//│ ║  l.XX: 	using Evidence[Int] = Evidence[Int]("int")
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This value is incompatible with the selected instance.
//│ ║  l.+1: 	polymorphic("later")
//│ ╙──      	            ^^^^^^^
//│ = "int"

// Explicit type parameters are opaque: a generic body's expansion cannot select an
// instance from its callers' types, so `Evidence[Int]` cannot serve `Evidence[A]`.
:e
fun generic[A](value: A) =
  fun local(other: A)(using e: Evidence[A]) = e.label
  local
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
//│ ║  l.+3: 	  local
//│ ║        	  ^^^^^
//│ ╟── No instance found for the contextual parameter 'e' of type Evidence[A].
//│ ║  l.+3: 	  local
//│ ║        	  ^^^^^
//│ ╟── The contextual parameter is declared here.
//│ ║  l.+2: 	  fun local(other: A)(using e: Evidence[A]) = e.label
//│ ╙──      	                      ^^^^^^^^^^^^^^^^^^^^

class Data
module Data with
  using Evidence[Data] = Evidence[Data]("data")

// Callers select the instance of a generic function's contextual parameter, here from the
// companion of `Data`; the generic body's expansion selects that parameter.
:expect "data"
fun namespaceGeneric[A](value: A)(using Evidence[A]) =
  fun local(other: A)(using e: Evidence[A]) = e.label
  local
let fromNamespace = namespaceGeneric(new Data)
fromNamespace(new Data)
//│ = "data"
//│ fromNamespace = fun

// A matching lexical instance prevents callers' companions from participating.
using Evidence[Any] = Evidence[Any]("lexical")

:expect ["lexical", "lexical"]
fun shadow[A](value: A) =
  fun local(other: A)(using e: Evidence[A]) = e.label
  local
[shadow(new Data)(new Data), shadow(1)(1)]
//│ = ["lexical", "lexical"]

// Unsupported queries are diagnosed at an expansion, before it is called.
:e
fun unsupported(x)(using f: (Int -> Int)) = x
let invalid = unsupported
//│ ╔══[COMPILATION ERROR] Resolution error in contextual argument
//│ ║  l.+2: 	let invalid = unsupported
//│ ║        	              ^^^^^^^^^^^
//│ ╟── Contextual parameter types must be named types or type parameters.
//│ ║  l.+2: 	let invalid = unsupported
//│ ║        	              ^^^^^^^^^^^
//│ ╟── The contextual parameter is declared here.
//│ ║  l.+1: 	fun unsupported(x)(using f: (Int -> Int)) = x
//│ ╙──      	                   ^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ invalid = undefined
