open annotations

// Non-local returns synthesize handlers; their methods and resume symbols are
// bindings too, even though the transformation's source only contains a closure.
// TODO: Lifting must add captured parameters to the copied body's erased signature.
// HandlerLowering must also coerce dynamic runtime reads when restoring typed state and local slots.
:fixme
pattern Escaping = x =>
  fun body() =
    let exit = () => return x + 1
    exit()
    0
  body()
