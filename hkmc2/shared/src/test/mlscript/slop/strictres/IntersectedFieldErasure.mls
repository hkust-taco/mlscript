:.

class Parent
class Child extends Parent
type Wide = {item: Parent}
type Narrow = {item: Child}

// Reading either spelling of the intersection already produces a Child.
:sir
:siret
fun wideFirst(r: Wide & Narrow): Child = r.item
fun narrowFirst(r: Narrow & Wide): Child = r.item
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define wideFirst⁰ as fun wideFirst¹(r: Unknown): Child⁰ {
//│   return r.item⁰
//│ };
//│ define narrowFirst⁰ as fun narrowFirst¹(r: Unknown): Child⁰ { return r.item⁰ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// Distinct unboxed representations have no common value. Reading this field in an unreachable
// function body must not require a conversion from either primitive to Str.
fun disjoint(r: {item: Int32} & {item: Int64}): Str = r.item
fun disjointReversed(r: {item: Int64} & {item: Int32}): Str = r.item

// The parameter, the result inferred from returning it, and the written field type all erase to Child.
:sir
:siret
type Both = Parent & Child
fun annotated(value: Child & Parent): Both = value
fun inferred(value: Both) = value
fun writtenField(r: {item: Parent & Child}): Child = r.item
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define annotated⁰ as fun annotated¹(value: Child⁰): Child⁰ {
//│   return value
//│ };
//│ define inferred⁰ as fun inferred¹(value: Child⁰): Child⁰ {
//│   return value
//│ };
//│ define writtenField⁰ as fun writtenField¹(r: Unknown): Child⁰ { return r.item¹ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// A record type places no constraint on the representation, and the join of a union is refined by the other
// component. Unrelated classes have no common instance, so their intersection has the bottom representation.
:sir
:siret
class Other
fun withRecord(value: Child & {tag: Int}) = value
fun withUnion(value: (Parent | Other) & Child) = value
fun unrelated(value: Parent & Other) = value
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define withRecord⁰ as fun withRecord¹(value: Child⁰): Child⁰ {
//│   return value
//│ };
//│ define withUnion⁰ as fun withUnion¹(value: Child⁰): Child⁰ {
//│   return value
//│ };
//│ define unrelated⁰ as fun unrelated¹(value: Nothing): Nothing {
//│   return value
//│ };
//│ define Other⁰ as class Other¹;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// Components of a union that intersect different record types select the field of the record types that they
// share. Like an intersection, this field does not depend on the order of its declarations: both reads
// produce a Child.
:sir
:siret
type Tagged = {item: Parent, tag: Int}
type WideAgain = {item: Parent}
type NarrowAgain = {item: Child}
fun sharedWideFirst(r: (Wide & Narrow) | (Wide & Narrow & Tagged)): Child = r.item
fun sharedNarrowFirst(r: (NarrowAgain & WideAgain) | (NarrowAgain & WideAgain & Tagged)): Child = r.item
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define sharedWideFirst⁰ as fun sharedWideFirst¹(r: Unknown): Child⁰ {
//│   return r.item⁰
//│ };
//│ define sharedNarrowFirst⁰ as fun sharedNarrowFirst¹(r: Unknown): Child⁰ { return r.item² };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
