//│ ║  l.+1: 	private fun lateMemberArgument(x) = x.only
//│ ║        	                                    ^^^^^^
//│ ╟── Cannot resolve member 'only' of a value with unknown shape.
//│ ╟── Parameter 'x' admits values of unknown shape.
//│ ║  l.+1: 	private fun lateMemberArgument(x) = x.only
//│ ║        	                               ^
//│ ╟── Type argument 'T' is inferred here.
//│ ║  l.XX: 	  fun get(): Cell = memberCell
//│ ║        	             ^^^^
//│ ╟── Member 'get' is accessible here.
//│ ║  l.XX: 	  fun get(): Cell = memberCell
//│ ║        	  ^^^^^^^^^^^^^^^
//│ ╟── 'cellReaderAgain' is exposed by this compilation unit.
//│ ║  l.+4: 	fun cellReaderAgain(): CellReader = new CellReader
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// A later write changes what callers receive from an already exported function.
private class Store(mut val f)
private val store = Store(x => 0)
fun current() = store.f
//│ store = Store(fun)

:e
private fun lateField(x) = x.only
set store.f = lateField
lateField({only: 1})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+1: 	private fun lateField(x) = x.only
//│ ║        	                           ^^^^^^
//│ ╟── Cannot resolve member 'only' of a value with unknown shape.
//│ ╟── Parameter 'x' admits values of unknown shape.
//│ ║  l.+1: 	private fun lateField(x) = x.only
//│ ║        	                      ^
//│ ╟── This value is returned here.
//│ ║  l.XX: 	fun current() = store.f
//│ ║        	                ^^^^^^^
//│ ╟── 'current' is exposed by this compilation unit.
//│ ║  l.XX: 	fun current() = store.f
//│ ╙──      	^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Written in one block, each of these cases is rejected.
