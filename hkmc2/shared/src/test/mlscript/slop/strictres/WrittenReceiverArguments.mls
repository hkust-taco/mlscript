// A rest parameter receives the arguments as a tuple.
:e
private fun firstOnly(t) = t.0.only
private class RestReader with
  fun all(...xs) = firstOnly(xs)
private fun readRest(p: RestReader) = p.all(null)
firstOnly([{only: 1}])
readRest(new RestReader)
