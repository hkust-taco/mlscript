// A handler implements the members of its effect class, so an effect call through the written
// effect type reaches the handler's implementation with its argument.
// TODO: Supply the effect call's argument to the handler's `question` parameter.
:effectHandlers
:lift
:breakme
:e
private abstract class Ask with
  fun ask(question)
private fun onlyOf(q) = q.only
private fun perform(effect: Ask) = effect.ask(null)
onlyOf({only: 1})
handle effect = Ask with
  fun ask(question)(resume) = resume(onlyOf(question))
perform(effect)
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of null (reading 'only')


