// The written receiver binds T to Item only in the signature of `app`. Its argument reaches the
// implementation without that binding, so the callback reads `v` at the opaque type T.
:e // TODO: allow?
private class Box[T](val v: T) with
  fun app(f) = f(v)
private fun incremented(b: Box[Item]) = b.app(x => x.n + 1)
incremented(Box(Item(3)))
