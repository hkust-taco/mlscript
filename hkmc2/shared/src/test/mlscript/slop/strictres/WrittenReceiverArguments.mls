// An abstract member supplies its argument to the implementation in a subclass.
:e
private abstract class Area with
  fun area(scale)
private class Square(val side: Int) extends Area with
  fun area(scale) = side * scale.factor
private fun totalArea(p: Area) = p.area(null)
Square(2).area({factor: 3})
totalArea(Square(2))
