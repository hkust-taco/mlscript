// The written subclass type reaches the inherited implementation.
:e
private class InheritedReader with
  fun read(x) = x.only
private class InheritingReader extends InheritedReader
private fun readInherited(p: InheritingReader) = p.read(null)
new InheritingReader().read({only: 7})
readInherited(new InheritingReader)
