// The second parameter list receives its argument after the first application.
:e
private class CurriedItems with
  fun add(a)(b) = a.n + b.n
private fun addFirst(p: CurriedItems) = p.add(Item(1))
new CurriedItems().add(Item(1))(Item(2))
addFirst(new CurriedItems)(null)
