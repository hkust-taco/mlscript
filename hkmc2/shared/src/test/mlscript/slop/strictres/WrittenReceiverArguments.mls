// A call through a written class type supplies its arguments to the unannotated parameters of
// every implementation that it can reach, whether or not the member has overrides.

private class Item(val n: Int)


// The member is final and has no override.
:e
private class FinalReader with
  fun read(x) = x.only
private fun readFinal(p: FinalReader) = p.read(null)
new FinalReader().read({only: 7})
readFinal(new FinalReader)
