//│ ║        	                    ^^^^
//│ ╟── This value is stored in this tuple.
//│ ║  l.+5: 	  [record, write]
//│ ║        	  ^^^^^^^^^^^^^^^
//│ ╟── This value is returned here.
//│ ║  l.+3: 	  let record = {mut item: 0}
//│ ║        	                    ^^^^^^^^
//│ ║  l.+4: 	  fun write() = set record.item = LateCell(1)
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
