// The copied field retains the paths of both returned spread records.
:ge
private class NestedCell(mut val value)
private fun original() = {item: 0}
private fun intermediate() = {...original()}
fun exportNestedCopy() =
  let copy = mut {...intermediate()}
  set copy.item = NestedCell(1)
  copy
//│ ╔══[COMPILATION ERROR] Mutable field 'value' is exposed to other compilation units, which can assign to it; annotate its type
//│ ║  l.+1: 	private class NestedCell(mut val value)
//│ ║        	                                 ^^^^^
//│ ╟── This value is stored in this record field.
//│ ║  l.+2: 	private fun original() = {item: 0}
//│ ║        	                          ^^^^
//│ ╟── This value is returned here.
//│ ║  l.+5: 	  let copy = mut {...intermediate()}
//│ ║        	                     ^^^^^^^^^^^^^^^
//│ ║  l.+6: 	  set copy.item = NestedCell(1)
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.+7: 	  copy
//│ ║        	^^^^^^
//│ ╟── 'exportNestedCopy' is exposed by this compilation unit.
//│ ║  l.+4: 	fun exportNestedCopy() =
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^


// An assigned closure retains its generic factory's substitution and scope exits.
:ge
private fun make[T](seed: T) =
  fun callback(value) = value.answer
  let record = {mut callback: 0}
  set record.callback = callback
  callback({answer: seed})
  record
fun exportGenericCallback() = make(42)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	  fun callback(value) = value.answer
