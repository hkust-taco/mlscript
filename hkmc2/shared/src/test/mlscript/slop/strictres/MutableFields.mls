// An escaping callback's unannotated input must admit external callers, even if its local calls
// all pass a record containing `answer`. Initializers already produce the required diagnostic.
:e
private fun initialCallback(value) = value.answer
fun exportInitialCallback() = {mut callback: initialCallback}
initialCallback({answer: 42})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+1: 	private fun initialCallback(value) = value.answer
//│ ║        	                                     ^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'answer' of a value with unknown shape.
//│ ╟── Parameter 'value' admits values of unknown shape.
//│ ║  l.+1: 	private fun initialCallback(value) = value.answer
//│ ║        	                            ^^^^^
//│ ╟── This value is stored in this record field.
//│ ║  l.+2: 	fun exportInitialCallback() = {mut callback: initialCallback}
//│ ║        	                                   ^^^^^^^^
//│ ╟── This value is returned here.
//│ ║  l.+2: 	fun exportInitialCallback() = {mut callback: initialCallback}
//│ ║        	                                   ^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── 'exportInitialCallback' is exposed by this compilation unit.
//│ ║  l.+2: 	fun exportInitialCallback() = {mut callback: initialCallback}
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


