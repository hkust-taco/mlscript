// A private field assigned by an exposed function and an exposed field take the same representation:
// other compilation units can store values of unknown shape in both.
:sir
:siret
module ViaSetter with
  private mut val state = 0
  fun update(value) = set state = value
module Direct with
  mut val state = 0
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define ViaSetter⁰ as class ViaSetter¹
//│ module ViaSetter² {
//│   private val state⁰: Unknown;
//│   constructor {
//│     @private
//│     define state¹ as val state⁰: Unknown = 0;
//│     end
//│   }
//│   method update⁰ = fun update¹(value: Unknown): Unit⁰ {
//│     set ViaSetter².this.state⁰ = value;
//│     return runtime⁰.Unit⁰
//│   }
//│ };
//│ define Direct⁰ as class Direct¹
//│ module Direct² {
//│   val state²: Unknown;
//│   constructor { define state² as val state³: Unknown = 0; end }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// The base initializes its own field before the subclass has installed its backing field.
// Once construction completes, reads and writes through the base dispatch to the override.
:expect ["child", 42, 42]
class BaseState with
  open mut val state = "base"
  fun read() = state
class ChildState extends BaseState with
  override mut val state = "child"
fun writeBase(base: BaseState) = set base.state = 42
let childState = new mut ChildState
let initial = childState.read()
writeBase(childState)
[initial, childState.read(), childState.state]
//│ = ["child", 42, 42]
//│ childState = ChildState
//│ initial = "child"

// The base constructor calls a method that reads the overriding field through its accessor,
// before JavaScript has installed the private field that stores it in the subclass.
// TODO: This read should not fail. The same read of an immutable field returns the base's value.
:fixme
class EarlyReader with
  open mut val state = "base"
  fun read() = state
  val early = read()
class LateState extends EarlyReader with
  override mut val state = "child"
new mut LateState().early
//│ ═══[RUNTIME ERROR] TypeError: Cannot read private member #state from an object whose class did not declare it

:expect "base"
class EarlyValueReader with
  open val state = "base"
  fun read() = state
  val early = read()
class LateValue extends EarlyValueReader with
  override val state = "child"
new LateValue().early
//│ = "base"

// Other compilation units cannot assign to a private field.
:expect 1
class Counter with
  private mut val count = 0
  fun increment() =
    set count += 1
    count
new Counter().increment()
//│ = 1

