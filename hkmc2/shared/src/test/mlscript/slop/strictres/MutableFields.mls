//│ ╟── 'exportGenericCallback' is exposed by this compilation unit.
//│ ║  l.+7: 	fun exportGenericCallback() = make(42)
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^


// Exposing a writer can publish assignments after the containing record was first visited.
:ge
private class LateCell(mut val value)
fun exportWriter() =
  let record = {mut item: 0}
  fun write() = set record.item = LateCell(1)
  [record, write]
//│ ╔══[COMPILATION ERROR] Mutable field 'value' is exposed to other compilation units, which can assign to it; annotate its type
//│ ║  l.+1: 	private class LateCell(mut val value)
