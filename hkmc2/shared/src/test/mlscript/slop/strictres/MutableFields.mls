:.

// A mutable field without a declared type takes the representation of its initializer and of the values
// assigned to it (see also ../wasm/MutableFields.mls). Other compilation units can assign values to the mutable
// fields that this compilation unit exposes. Such a field admits values of unknown representation, like the
// unannotated parameter of an exposed function, unless it declares its type.

// Several blocks below store this unboxed integer in a field. It has no common representation with unknown
// values, so the resulting errors show which fields are exposed, and how.
val input: Int32 = unsafe.undefined
//│ input = undefined


// A public class exposes the mutable fields of its instances, whether they are parameters or members.
// Without annotations, they take the unknown representation.
:sir
:siret
class Exposed(mut val param) with
  mut val member = 0
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Exposed⁰ as class Exposed² {
//│   val param⁰: Unknown;
//│   val member⁰: Unknown;
//│   constructor Exposed¹(param: Unknown) {
//│     define param⁰ as val param¹: Unknown = param;
//│     define member⁰ as val member¹: Unknown = 0;
//│     end
//│   }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

