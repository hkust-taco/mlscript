// A mutable spread copy also exposes values assigned through its copied fields.
:ge
private class CopiedCell(mut val value)
fun exportCopiedCell() =
  let source = {item: 0}
  let copy = mut {...source}
  set copy.item = CopiedCell(1)
  copy
