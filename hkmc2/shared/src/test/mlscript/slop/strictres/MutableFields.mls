// Clients can replace the field of the record they receive. A separate call keeps its own field.
:expect 7
private fun makeRecord(value) = mut {item: value}
fun publicRecord() = makeRecord({other: 2})
private val keptRecord = makeRecord({only: 7})
keptRecord.item.only
//│ = 7
//│ keptRecord = {item: {only: 7}}


// Calling a factory stored in a tuple allocates a record for each call.
:expect [null, 7]
private val factories = [x => mut {item: x}]
private val first = factories.0({only: 1})
private val second = factories.0({only: 7})
set first.item = null
[first.item, second.item.only]
//│ = [null, 7]
//│ factories = [fun]
//│ first = {item: null}
//│ second = {item: {only: 7}}


