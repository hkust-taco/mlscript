// Exposing an immutable source does not expose values assigned only to its mutable copy.
:expect 0
private class HiddenCell(mut val value)
fun exportSource() =
  let source = {item: 0}
  let copy = mut {...source}
  set copy.item = HiddenCell(1)
  source
exportSource().item
//│ = 0


// An annotated generic field value exposes only its substituted interface, including through nested spreads.
// Separate factory activations must keep their callback domains distinct instead of exposing either callback
// to arbitrary inputs.
:expect [4, 6]
private fun make[T](callback: T -> Int) =
  let record = {mut callback: 0}
  set record.callback = callback
  record
private fun length(value) = value.length
private fun increment(value) = value + 1
fun exportStringCallback() = {...{...make[Str](length)}}
fun exportIntCallback() = {...make[Int](increment)}
[length("abcd"), increment(5)]
//│ = [4, 6]


// A later field replaces a spread field completely. Exposure must not follow the discarded value and require
// annotations on mutable class fields that remain private.
:expect 0
private class OverwrittenCell(mut val value)
private val overwrittenSource = {hidden: OverwrittenCell(0)}
val overwrittenView = {...overwrittenSource, hidden: 0}
overwrittenView.hidden
//│ = 0
//│ overwrittenSource = {hidden: OverwrittenCell(0)}
//│ overwrittenView = {hidden: 0}


// The same last-write-wins rule applies to repeated direct fields and fields replaced by a later spread.
:expect [0, 1]
private class ReplacedCell(mut val value)
fun exportDirectReplacement() = {item: ReplacedCell(0), item: 0}
fun exportSpreadReplacement() = {item: ReplacedCell(0), ...{item: 1}}
[exportDirectReplacement().item, exportSpreadReplacement().item]
//│ = [0, 1]


// Neither an initializer nor values assigned to its mutable field escape after a nested copy overwrites it.
:expect 0
private class ReplacedAssignedCell(mut val value)
private fun originalWithAssignment() =
  let record = {mut item: ReplacedAssignedCell(0)}
  set record.item = ReplacedAssignedCell(1)
  record
private fun intermediateWithAssignment() = {...originalWithAssignment()}
fun exportAssignedReplacement() = mut {...intermediateWithAssignment(), item: 0}
exportAssignedReplacement().item
//│ = 0


// A computed key might leave earlier fields intact, so their values must still be exposed.
:ge
private class PossiblyRetainedCell(mut val value)
fun exportPossibleReplacement(key: Str) = {item: PossiblyRetainedCell(0), (key): 0}
//│ ╔══[COMPILATION ERROR] Mutable field 'value' is exposed to other compilation units, which can assign to it; annotate its type
//│ ║  l.+1: 	private class PossiblyRetainedCell(mut val value)
