//│ ║  l.+2: 	  mut val member = input
//│ ║        	          ^^^^^^
//│ ╟── The exposed interface admits values of unknown representation unless a type annotation restricts them.
//│ ╟── Field 'member' admits assigned values of unknown shape.
//│ ║  l.+2: 	  mut val member = input
//│ ║        	          ^^^^^^
//│ ╟── 'ExposedUnboxed' is exposed by this compilation unit.
//│ ║  l.+1: 	class ExposedUnboxed with
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

class Declared(mut val param: Int) with
  mut val member: Int = 0

