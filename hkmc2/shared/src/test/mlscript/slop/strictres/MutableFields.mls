//│ ║        	                                           ^^^^
//│ ╟── This value is returned here.
//│ ║  l.+2: 	fun exportPossibleReplacement(key: Str) = {item: PossiblyRetainedCell(0), (key): 0}
//│ ║        	                                           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── 'exportPossibleReplacement' is exposed by this compilation unit.
//│ ║  l.+2: 	fun exportPossibleReplacement(key: Str) = {item: PossiblyRetainedCell(0), (key): 0}
