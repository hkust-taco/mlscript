:.

// A mutable field without a declared type takes the representation of its initializer and of the values
// assigned to it (see also ../wasm/MutableFields.mls). Other compilation units can assign values to the mutable
// fields that this compilation unit exposes, so those must declare their types: their representations must not
// depend on the values that this compilation unit happens to assign to them.


// A public class exposes the mutable fields of its instances, whether they are parameters or members.
:ge
class Exposed(mut val param) with
  mut val member = 0
//│ ╔══[COMPILATION ERROR] Mutable field 'param' is exposed to other compilation units, which can assign to it; annotate its type
//│ ║  l.+1: 	class Exposed(mut val param) with
//│ ║        	                      ^^^^^
//│ ╟── 'Exposed' is exposed by this compilation unit.
//│ ║  l.+1: 	class Exposed(mut val param) with
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Mutable field 'member' is exposed to other compilation units, which can assign to it; annotate its type
//│ ║  l.+2: 	  mut val member = 0
//│ ║        	          ^^^^^^
//│ ╟── 'Exposed' is exposed by this compilation unit.
//│ ║  l.+1: 	class Exposed(mut val param) with
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^

class Declared(mut val param: Int) with
  mut val member: Int = 0

// The mutable fields of a public module are exposed too.
:ge
module Settings with
  mut val verbose = false
//│ ╔══[COMPILATION ERROR] Mutable field 'verbose' is exposed to other compilation units, which can assign to it; annotate its type
//│ ║  l.+2: 	  mut val verbose = false
//│ ║        	          ^^^^^^^
//│ ╟── 'Settings' is exposed by this compilation unit.
//│ ║  l.+1: 	module Settings with
//│ ╙──      	^^^^^^^^^^^^^^^

// Other compilation units cannot assign to a private field.
:expect 1
class Counter with
  private mut val count = 0
  fun increment() =
    set count += 1
    count
new Counter().increment()
//│ = 1

// The fields of a private class are exposed by the instances that escape the compilation unit,
// including through the classes that inherit them.
:ge
private class Hidden(mut val value)
fun makeHidden() = Hidden(0)
//│ ╔══[COMPILATION ERROR] Mutable field 'value' is exposed to other compilation units, which can assign to it; annotate its type
//│ ║  l.+1: 	private class Hidden(mut val value)
//│ ║        	                             ^^^^^
//│ ╟── This value is returned here.
//│ ║  l.+2: 	fun makeHidden() = Hidden(0)
//│ ║        	                   ^^^^^^^^^
//│ ╟── 'makeHidden' is exposed by this compilation unit.
//│ ║  l.+2: 	fun makeHidden() = Hidden(0)
//│ ╙──      	^^^^^^^^^^^^^^^^

:ge
private class Parent(mut val value)
class Child extends Parent(0)
//│ ╔══[COMPILATION ERROR] Mutable field 'value' is exposed to other compilation units, which can assign to it; annotate its type
//│ ║  l.+1: 	private class Parent(mut val value)
//│ ║        	                             ^^^^^
//│ ╟── This parent contributes inherited members.
//│ ║  l.+2: 	class Child extends Parent(0)
//│ ║        	                    ^^^^^^^^^
//│ ╟── 'Child' is exposed by this compilation unit.
//│ ║  l.+2: 	class Child extends Parent(0)
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

// A field whose values only come from this compilation unit is not exposed.
:expect 2
private class Local(mut val value)
private fun local() =
  let cell = Local(1)
  set cell.value = 2
  cell.value
local()
//│ = 2

// Values of unknown shape that this compilation unit receives from other compilation units
// can be assigned to a field that is not exposed, without declaring its type.
private class Store(mut val value)
private val store = Store(0)
fun put(value) = set store.value = value
//│ store = Store(0)


// Record fields declared `mut` can be assigned; other fields are immutable, unless their whole record is
// mutable (`mut {...}`). Reading a mutable field returns its initializer and the values assigned to it.
:expect [2, "count"]
private class Box(val value)
private fun replaceInner() =
  let record = {mut inner: Box(1), label: "count"}
  set record.inner = Box(2)
  [record.inner.value, record.label]
replaceInner()
//│ = [2, "count"]

// Assigning through a mutable copy of a record assigns the fields of the copied record,
// so the representations of those fields include the values assigned to them through the copy.
:expect "many"
private fun copy() =
  let source = {count: 0}
  let copied = mut {...source}
  set copied.count = "many"
  copied.count
copy()
//│ = "many"

// Copies of a record read the current values of its mutable fields.
:expect ["many", "many"]
private fun copyMutable() =
  let source = {mut count: 0}
  set source.count = "many"
  let copied = {...source}
  [source.count, copied.count]
copyMutable()
//│ = ["many", "many"]

// The fields of an exposed record that are mutable cannot declare types: they take the unknown representation.
val exposedRecord = {mut count: 0, label: "count"}
//│ exposedRecord = {count: 0, label: "count"}


// A record type can declare mutable fields too. The values it describes can be assigned values of these fields'
// types through it, so their own fields hold such values, just as the parameters of a callback hold values of the
// parameter types of its function type. Assignments through the record type need not be followed.
:expect 3
private class Holder(mut val item)
private fun put(holder: {mut item: Str}) = set holder.item = "str"
private fun structural() =
  let holder = Holder("abc")
  put(holder)
  holder.item.length
structural()
//│ = 3


// A value stored in an escaping record is exposed even when it is assigned after the record's
// construction. Clients can access its public fields and call its functions through that record.


// Initializers already expose their nested mutable fields, which must declare their types.
:ge
private class InitialCell(mut val value)
fun exportInitialCell() = {mut item: InitialCell(1)}
//│ ╔══[COMPILATION ERROR] Mutable field 'value' is exposed to other compilation units, which can assign to it; annotate its type
//│ ║  l.+1: 	private class InitialCell(mut val value)
//│ ║        	                                  ^^^^^
//│ ╟── This value is stored in this record field.
//│ ║  l.+2: 	fun exportInitialCell() = {mut item: InitialCell(1)}
//│ ║        	                               ^^^^
//│ ╟── This value is returned here.
//│ ║  l.+2: 	fun exportInitialCell() = {mut item: InitialCell(1)}
//│ ║        	                               ^^^^^^^^^^^^^^^^^^^^
//│ ╟── 'exportInitialCell' is exposed by this compilation unit.
//│ ║  l.+2: 	fun exportInitialCell() = {mut item: InitialCell(1)}
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^


// Assignment exposes the nested mutable field just like an initializer does.
:ge
private class AssignedCell(mut val value)
fun exportAssignedCell() =
  let record = {mut item: 0}
  set record.item = AssignedCell(1)
  record
