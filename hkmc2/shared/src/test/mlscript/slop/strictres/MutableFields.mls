// A frozen spread copy does not let clients write to the private mutable record that it copied.
:expect 3
private val privateMutableSource = {mut item: "abc"}
val exportedImmutableCopy = {...privateMutableSource}
privateMutableSource.item.length
//│ = 3
//│ exportedImmutableCopy = {item: "abc"}
//│ privateMutableSource = {item: "abc"}


