:.


// Overrides inherit the representations of an open member's parameters and result,
// so an exposed open member must annotate all of them.
:e
class Base() with
  open fun scale(x, y: Int) = x * y
//│ ╔══[COMPILATION ERROR] Open member 'scale' is exposed by this compilation unit, so it must annotate its result type and the types of its parameters.
//│ ║  l.+2: 	  open fun scale(x, y: Int) = x * y
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── 'Base' is exposed by this compilation unit.
//│ ║  l.+1: 	class Base() with
//│ ║        	^^^^^^^^^^^^
//│ ╟── Parameter 'x' has no type annotation.
//│ ║  l.+2: 	  open fun scale(x, y: Int) = x * y
//│ ╙──      	                 ^

// Abstract members and open fields are overridable too.
:e
abstract class Shape() with
  fun area()
  open val name = "shape"
//│ ╔══[COMPILATION ERROR] Open member 'area' is exposed by this compilation unit, so it must annotate its result type.
//│ ║  l.+2: 	  fun area()
//│ ║        	  ^^^^^^^^^^
//│ ╟── 'Shape' is exposed by this compilation unit.
//│ ║  l.+1: 	abstract class Shape() with
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Open member 'name' is exposed by this compilation unit, so it must annotate its type.
//│ ║  l.+3: 	  open val name = "shape"
//│ ║        	  ^^^^^^^^^^^^^
//│ ╟── 'Shape' is exposed by this compilation unit.
//│ ║  l.+1: 	abstract class Shape() with
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^

// A separate full signature types the written parameters.
class Signed() with
  open fun scale: (Int, Int) -> Int
  open fun scale(x, y) = x * y

// A later block that re-exposes `Base` through a subclass does not report it again.
class Child() extends Base() with
  override fun scale(x, y) = x + y
Child().scale(2, 3)
//│ = 5

// Open members that no exposure path reaches are overridden only in this unit.
private class LocalBase() with
  open fun scale(x) = x * 2
private class LocalChild() extends LocalBase() with
  override fun scale(x) = x * 3
LocalChild().scale(2)
//│ = 6

fun localClasses() =
  class Inner() with
    open fun get() = 1
  class InnerChild() extends Inner() with
    override fun get() = 2
  InnerChild().get()
localClasses()
//│ = 2

// Objects cannot be extended, so their open members have no overrides.
object Constant with
  open fun get() = 1
Constant.get()
//│ = 1
