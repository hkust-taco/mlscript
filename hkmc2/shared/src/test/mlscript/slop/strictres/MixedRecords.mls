// A record type that requires a `mut` field is not checked against the records that reach it. A union
// constrains a record against each of its components, and the record below is a valid value of the union.
:expect 0
private fun acceptEither(target: {mut count: Int} | {count: Int}) = 0
acceptEither({count: 1})
//│ = 0

// So resolution does not account for an assignment through a record type that requires a `mut` field, when
// the record declares that field read-only: the selection of `a` below reads a record without that field.
// TODO: the type checker should reject the call.
private fun store(target: {mut inner: {b: Int}}) = set target.inner = {b: 2}
private fun overwriteThroughType() =
  let record = {mut count: 0, inner: {a: 1}}
  store(record)
  [record.inner.a]
overwriteThroughType()
//│ = [undefined]

// Resolution does not account for an assignment through a computed key either, whether the record
// declares the assigned field `mut` or is mutable as a whole.
:breakme
:e
private fun overwriteThroughKey() =
  let record = {mut inner: {a: 1}}
  let key = "inner"
  set record.(key) = {b: 2}
  [record.inner.a]
overwriteThroughKey()
//│ = [undefined]
