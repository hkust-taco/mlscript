//│ ║        	                                                                ^^^^^
//│ ╟── target: record field 'count'
//│ ║  l.XX: 	type Counter = {mut count: Int}
//│ ╙──      	                    ^^^^^

// The assignment is rejected if a component of the union has the field immutable, like for a union of
// record types without intersections.
:ge
