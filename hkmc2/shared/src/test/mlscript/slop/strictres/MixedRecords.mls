// Reordering and regrouping the same field declarations in a union keeps the read and write unambiguous.
:expect 9
type Counter = {mut count: Int}
type LabelledCounter = {count: Int, label: Str}
type TimedCounter = {count: Int, time: Int}
type EitherCounter = ((Counter & LabelledCounter) & TimedCounter & {left: Int})
  | (TimedCounter & (LabelledCounter & Counter) & {right: Int})
private fun updateCount(target: EitherCounter) =
  set target.count = 9
  target.count
updateCount({mut count: 0, label: "count", time: 0, left: 1})
//│ = 9

// The components of a union can also intersect different record types. The declarations that all of them
// share identify the field, so the read and the write have one target.
:expect 7
private fun updateShared(target: (Counter & LabelledCounter) | (Counter & LabelledCounter & TimedCounter)) =
  set target.count = 7
  target.count
updateShared(mut {count: 0, label: "count"})
//│ = 7

// An intersection shares no declaration with a record type that declares the field separately. The error
// shows a declaration of each candidate.
:ge
private fun readSeparate(target: (Counter & LabelledCounter) | {count: Int, other: Int}) = target.count
//│ ╔══[COMPILATION ERROR] This selection of member 'count' is ambiguous, as it has multiple resolved targets
//│ ║  l.+1: 	private fun readSeparate(target: (Counter & LabelledCounter) | {count: Int, other: Int}) = target.count
//│ ║        	                                                                                           ^^^^^^^^^^^^
//│ ╟── target: record field 'count'
