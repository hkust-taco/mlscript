import "./ForeignOperationBase.mls" as Library

// A private override must admit calls even when the base unit published no exposure inputs.
:e
private class Inspect extends Library.Base with
  override fun inspect(x) = x.only
new Inspect().inspect({only: 1})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	  override fun inspect(x) = x.only
//│ ║        	                            ^^^^^^
//│ ╟── Cannot resolve member 'only' of a value with unknown shape.
//│ ╟── Parameter 'x' admits values of unknown shape.
//│ ║  in ForeignOperationBase.mls
//│ ║  l.XX: 	    open fun inspect(x) = 0
//│ ║        	                     ^
//│ ╟── Member 'inspect' is inherited from another compilation unit.
//│ ║  l.XX: 	    open fun inspect(x) = 0
//│ ╙──      	    ^^^^^^^^^^^^^^^^^^^

:e
private class Rest extends Library.Base with
  override fun rest(...xs) = xs.0.only
new Rest().rest({only: 2})
