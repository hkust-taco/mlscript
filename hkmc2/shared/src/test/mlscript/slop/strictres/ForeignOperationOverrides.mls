// Written arguments belong to this unit even when the generic class belongs to another.
:e
private class LocalPayload with
  fun inspect(x) = x.only
fun accept(x: Library.Typed[LocalPayload]) = 0
new LocalPayload().inspect({only: 1})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	  fun inspect(x) = x.only
//│ ║        	                   ^^^^^^
//│ ╟── Cannot resolve member 'only' of a value with unknown shape.
//│ ╟── Parameter 'x' admits values of unknown shape.
//│ ║  l.+2: 	  fun inspect(x) = x.only
//│ ║        	              ^
//│ ╟── Member 'inspect' is accessible here.
//│ ║  l.+2: 	  fun inspect(x) = x.only
//│ ║        	  ^^^^^^^^^^^^^^
//│ ╟── This type argument appears in an exposed annotation.
//│ ║  l.+3: 	fun accept(x: Library.Typed[LocalPayload]) = 0
//│ ║        	                            ^^^^^^^^^^^^
//│ ╟── 'accept' is exposed by this compilation unit.
//│ ║  l.+3: 	fun accept(x: Library.Typed[LocalPayload]) = 0
