// Both implementations satisfy this signature. Calling the native method via Function.prototype.call
// would consume its first argument as the receiver and bind the second parameter to null.
:ftc
:ge
private class ClassPair with
  fun pick(x?, y?) = if y is null then 0 else 5
private fun throughRecord(p: { pick: (Int, Int) -> Int }) = p.pick(2, 3)
[throughRecord({ pick: (x, y) => x + y }), throughRecord(new ClassPair)]
