// Merging field reads intersects their output types, and an immutable component adds no writes.
:expect 12
type Both = ({item: {left: Int}} & {mut item: {left: Int, right: Int}})
private fun read(record: Both) = record.item.left + record.item.right
private fun test() =
  let record = {mut item: {left: 5, right: 7}}
  read(record)
test()
//│ = 12


