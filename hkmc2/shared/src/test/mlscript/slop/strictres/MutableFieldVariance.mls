type CursorView = { mut position: in Int out (Int | Str), label: Str }

:expect ["start", 42, "cursor"]
private fun reset(cursor: CursorView) =
  let before = cursor.position
  set cursor.position = 42
  [before, cursor.position, cursor.label]
reset({mut position: "start", label: "cursor"})
//│ = ["start", 42, "cursor"]


