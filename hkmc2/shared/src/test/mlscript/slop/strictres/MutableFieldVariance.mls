  let record = {mut item: Child(13)}
  accept(record)
  record.item.value
test()
//│ = 13


// A field needs a write interface before it can declare an input bound.
:ge
class Base
class Child extends Base
type Immutable = {item: in Child out Base}
private fun read(record: Immutable) = record.item
