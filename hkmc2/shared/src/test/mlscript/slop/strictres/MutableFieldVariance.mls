// Forwarding a mutable structural interface must preserve its write constraints.
:ge
type IntervalCallback[T] = mut {callback: T}
class Base
class Child(val value: Int) extends Base
private fun assigned(value) = value.value
private fun store(record: IntervalCallback[in (Base -> Int) out (Child -> Int)]) =
  fun write() = set record.callback = assigned
  write()
private fun forward(record: IntervalCallback[in (Base -> Int) out (Child -> Int)]) = store(record)
private fun test() =
  let record = mut {callback: assigned}
  forward(record)
  assigned(Child(15))
test()
