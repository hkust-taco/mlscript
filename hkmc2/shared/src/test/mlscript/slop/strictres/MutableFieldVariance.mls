// The input to Receiver.accept reverses T's polarity. Its field can receive Base,
// even though the original record has only held Child values.
:ge
class Base
class Child(val value: Int) extends Base
class Receiver[T] with
  fun accept(record: {mut item: T}): () = ()
private fun test() =
  let receiver = (new Receiver as Receiver[in Child out Base])
  let record = {mut item: Child(3)}
  receiver.accept(record)
  record.item.value
test()
