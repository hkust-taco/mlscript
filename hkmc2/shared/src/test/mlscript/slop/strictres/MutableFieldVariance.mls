// Recursive fields retain finite, substituted input and output references.
:expect 14
type Chain[T] = {mut next: Chain[T], value: T}
private fun read[T](chain: Chain[T], count: Int): T =
  if count == 0 then chain.value else read(chain.next, count - 1)
private fun test() =
  let chain = {mut next: unsafe.undefined, value: 14}
  set chain.next = chain
  read(chain, 2)
test()
//│ = 14


// Forwarding a mutable structural interface must preserve its write constraints.
:ge
class Base
class Child(val value: Int) extends Base
private fun assigned(value) = value.value
private fun store(record: {mut callback: in (Base -> Int) out (Child -> Int)}) =
  fun write() = set record.callback = assigned
  write()
private fun forward(record: {mut callback: in (Base -> Int) out (Child -> Int)}) = store(record)
private fun test() =
  let record = {mut callback: assigned}
  forward(record)
  assigned(Child(15))
test()
