// The write bound is Child; the read bound Base must not be fed back into the local field.
:expect 1
type IntervalCell[T] = mut {item: T}
class Base
class Child(val value: Int) extends Base
private fun accept(record: IntervalCell[in Child out Base]) = ()
private fun test() =
  let record = mut {item: Child(1)}
  accept(record)
  record.item.value
test()
//│ = 1


