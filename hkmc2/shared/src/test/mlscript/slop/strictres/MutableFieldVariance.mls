// The write bound is Child; the read bound Base must not be fed back into the local field.
:expect 1
class Base
class Child(val value: Int) extends Base
private fun accept(record: {mut item: in Child out Base}) = ()
private fun test() =
  let record = {mut item: Child(1)}
  accept(record)
  record.item.value
test()
//│ = 1


