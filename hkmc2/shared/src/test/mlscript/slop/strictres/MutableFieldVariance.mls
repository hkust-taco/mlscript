// In positive position the same alias admits Child writes and exposes Base reads.
:expect 6
class Base
class Child(val value: Int) extends Base
type Cell[T] = {mut item: T}
private fun test() =
  let record = {mut item: Child(6)}
  let view = record as Cell[in Child out Base]
  record.item.value
test()
//│ = 6


// An output-only field admits no writes; Nothing must not become an unknown input.
