// An immutable destination only constrains the read; it must not widen the source's write type.
:expect 5
class Base
class Child(val value: Int) extends Base
class Holder[S](val record: {mut f: S})
private fun accept(record: {f: Base}) = ()
private fun test() =
  let holder = Holder({mut f: Child(5)})
  accept(holder.record)
  holder.record.f.value
test()
//│ = 5


