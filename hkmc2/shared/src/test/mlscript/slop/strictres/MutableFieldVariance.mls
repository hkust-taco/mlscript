// The corresponding immutable field admits no writes and retains its local value.
:expect 4
class Base
class Child(val value: Int) extends Base
class Receiver[T] with
  fun accept(record: {item: T}): () = ()
private fun test() =
  let receiver = (new Receiver as Receiver[in Child out Base])
  let record = {item: Child(4)}
  receiver.accept(record)
  record.item.value
test()
//│ = 4


