// Writes through a split interface check callbacks against the input bound, not its read bound.
:ge
class Base
class Child(val value: Int) extends Base
private fun assigned(value) = value.value
private fun store(record: {mut callback: in (Base -> Int) out (Child -> Int)}) =
  set record.callback = assigned
private fun test() =
  let record = {mut callback: assigned}
  store(record)
  assigned(Child(9))
test()
