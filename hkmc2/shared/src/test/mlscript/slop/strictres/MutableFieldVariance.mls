// A write through an override inherits the input bound of the receiver's field.
:ge
class Base
class Child(val value: Int) extends Base
private class Slot[T](seed: T) with
  open mut val item: T = seed
private class Middle[T](seed: T) extends Slot[T](seed) with
  override mut val item = seed
private fun assigned(value) = value.value
private fun store(p: Middle[in (Base -> Int) out (Child -> Int)]) = set p.item = assigned
store(new mut Middle[Child -> Int](x => 0))
assigned(Child(10))
