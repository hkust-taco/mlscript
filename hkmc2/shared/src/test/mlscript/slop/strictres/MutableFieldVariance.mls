// A nominal mutable field uses the negative occurrence of its substituted type as its write interface.
:ge
class Base
class Child(val value: Int) extends Base
class Cell[T](mut val callback: T)
private fun assigned(value) = value.value
private fun test() =
  let cell = Cell[Child -> Int](assigned)
  let view = cell as Cell[in (Base -> Int) out (Child -> Int)]
  set view.callback = assigned
  assigned(Child(10))
test()
