// The class is private, and a factory with a written result returns another instance.
:e
private class Hidden(val item)
private fun kept(x) = x.only
fun hidden(): Hidden = Hidden(x => 0)
private fun localHidden() = Hidden(kept).item({only: 3})
localHidden()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	private fun kept(x) = x.only
//│ ║        	                      ^^^^^^
//│ ╟── Cannot resolve member 'only' of a value with unknown shape.
//│ ╟── Parameter 'x' admits values of unknown shape.
//│ ║  l.+2: 	private fun kept(x) = x.only
//│ ║        	                 ^
//│ ╟── Member 'item' is accessible here.
//│ ║  l.+1: 	private class Hidden(val item)
//│ ║        	                     ^^^^^^^^
//│ ╟── 'hidden' is exposed by this compilation unit.
