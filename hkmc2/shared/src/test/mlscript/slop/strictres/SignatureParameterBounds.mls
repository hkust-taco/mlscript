:.

class Base(val value: Int)
class Child(val extra: Int) extends Base(extra)

type BoundedParts = ((Child, ...Array[in Child out Base]) -> Int) & ((...Array[in Child out Base], Child) -> Int)

// The first signature supplies the trailing parameter from an array element;
// the second supplies it from a fixed parameter. Both contribute its value type.
:expect 2
private fun compound: BoundedParts
fun compound(...rest, last) = last.value
compound(Child(1), Child(2))
//│ = 2

// The array's output bound is Base. Using its input bound would expose Child.extra
// on the trailing parameter, even though the array can contain other Base values.
:e
private fun hidden: BoundedParts
fun hidden(...rest, last) = last.extra
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	fun hidden(...rest, last) = last.extra
//│ ║        	                            ^^^^^^^^^^
//│ ╟── Value of type 'Base' does not contain member 'extra'
//│ ║  l.XX: 	type BoundedParts = ((Child, ...Array[in Child out Base]) -> Int) & ((...Array[in Child out Base], Child) -> Int)
//│ ╙──      	                                                   ^^^^

// A callback element keeps its output function type, including the domain used
// when checking a callback supplied directly at a fixed position.
:expect 3
type Callback = Child -> Int
type Callbacks = Array[in (Base -> Int) out Callback]
private fun callback: ((Callback, ...Callbacks) -> Int) & ((...Callbacks, Callback) -> Int)
fun callback(...rest, last) = last(Child(3))
callback(value => value.extra)
//│ = 3

// Extracting a higher-order callback must also use its output bound: the callback
// passed to last must accept every Base, so it cannot select Child.extra.
:e
type ChildConsumer = (Child -> Int) -> Int
type BaseConsumer = (Base -> Int) -> Int
type Consumers = Array[in ChildConsumer out BaseConsumer]
private fun higherOrder: ((ChildConsumer, ...Consumers) -> Int) & ((...Consumers, ChildConsumer) -> Int)
fun higherOrder(...rest, last) = last(value => value.extra)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+5: 	fun higherOrder(...rest, last) = last(value => value.extra)
//│ ║        	                                               ^^^^^^^^^^^
//│ ╟── Value of type 'Base' does not contain member 'extra'
//│ ║  l.+2: 	type BaseConsumer = (Base -> Int) -> Int
//│ ╙──      	                     ^^^^

// Later curried lists retain the same bounded-element projection through an alias.
:expect 4
private fun curried: Int -> BoundedParts
fun curried(n)(...rest, last) = n * last.value
curried(2)(Child(2))
//│ = 4
