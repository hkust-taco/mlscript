// A matching generic alias retains its parameter annotations.
:expect 3
type Unary[A, B] = (value: A) -> B
private fun length: Unary[Str, Int]
fun length(s) = s.length
length("abc")
//│ = 3

// A forward type alias can get its entire parameter list from its argument.
:e
private fun binary: ForwardSignature[(Int, Int) -> Int]
fun binary(x) = x
type ForwardSignature[A] = A
