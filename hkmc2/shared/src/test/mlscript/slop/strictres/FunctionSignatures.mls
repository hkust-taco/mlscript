// The body resolves its parameter and its returned lambda using the implementation annotations.
// Callers see the domain and result written on the declaration.
:expect 9
class Face(val field: Int)
class Detail(val detail: Int) extends Face(detail)
fun reader: Face -> (Face -> Face)
fun reader(x: Detail): Detail -> Detail = y => Detail(x.detail + y.detail)
reader(Detail(4))(Detail(5)).field
//│ = 9

:e
reader(Detail(4))(Detail(5)).detail
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+1: 	reader(Detail(4))(Detail(5)).detail
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Value of type 'Face' does not contain member 'detail'
//│ ║  l.XX: 	fun reader: Face -> (Face -> Face)
//│ ╙──      	                             ^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A caller's callback receives the publicly declared argument type.
