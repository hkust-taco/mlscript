:.

// *** Named function-type parameters ***

// Names in function types label parameters; their annotations supply the types.
:expect 3
fun named(f: (s: Str) -> Int) = f("abc")
named(s => s.length)
//│ = 3

// Optional named parameters retain both the annotation and the null case.
:expect [0, 3]
fun namedOptional(f: (s?: Str) -> Int) = [f(), f("abc")]
namedOptional((s?) => if s is ~null as s then s.length else 0)
//│ = [0, 3]

:e
fun missingNamed(f: (s?: Str) -> Int) = f()
missingNamed((s?) => s.length)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	missingNamed((s?) => s.length)
//│ ║        	                     ^^^^^^^^
//│ ╟── Null literal does not contain member 'length'
//│ ║  l.+2: 	missingNamed((s?) => s.length)
//│ ║        	              ^^
//│ ╟── Null literal does not contain member 'length'
//│ ║  l.+1: 	fun missingNamed(f: (s?: Str) -> Int) = f()
//│ ╙──      	                     ^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Normalization also applies through aliases, generics, and droppable parameters.
:expect 3
type Named[A] = (x: A, drop index: Int) -> Int
fun namedGeneric[A](x: A, f: Named[A]) = f(x, 0)
namedGeneric("abc", x => x.length)
//│ = 3

:expect [0, 3]
fun namedSignature: (text?: Str) -> Int
fun namedSignature(text?) = if text is ~null as text then text.length else 0
[namedSignature(), namedSignature("abc")]
//│ = [0, 3]


// *** Separate signatures ***

fun sig: (Int, Int?) -> Int
fun sig(x, y?) = x

:e
fun sig2: (Int, Int?) -> Int
fun sig2(x, y) = x
//│ ╔══[COMPILATION ERROR] Implementation parameter list does not match its separate signature.
//│ ║  l.+2: 	fun sig2(x, y) = x
//│ ║        	        ^^^^^^
//│ ╟── The signature has different required, optional, variadic, or trailing parameter positions.
//│ ║  l.+1: 	fun sig2: (Int, Int?) -> Int
//│ ╙──      	          ^^^^^^^^^^^^^^^^^^

// A separate signature determines how many arguments can be passed.
:e
sig()
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+1: 	sig()
//│ ║        	^^^^^
//│ ╟── Function 'sig' expected 1 to 2 arguments, but got 0
//│ ║  l.XX: 	fun sig(x, y?) = x
//│ ╙──      	^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] Error: Function 'sig' expected at least 1 argument but got 0

// Aliases must not hide a mismatch between a signature and its implementation.
type OptionalFn = (Int?) -> Int

:e
private fun aliased: OptionalFn
private fun aliased(x) = x
