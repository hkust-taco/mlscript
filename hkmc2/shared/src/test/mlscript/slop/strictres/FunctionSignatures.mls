// The incoming argument occupies the public parameter slot.
:expect 7
fun ignoreArgument: Int -> Int
fun ignoreArgument(x: Str): Int = 7
ignoreArgument(42)
//│ = 7

// Unrelated annotations alone are valid. A throwing body needs no return slot conversion.
private fun disagree: Int -> Str
fun disagree(x: Str): Int = throw "unused"

// A value returned normally must fit the public return slot.
:e
private fun badReturn: Int -> Str
fun badReturn(x): Int = 1
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int' at an unrelated type 'Str'
//│ ║  l.+2: 	fun badReturn(x): Int = 1
//│ ╙──      	                        ^
