// The base is the only declaration called. Its parent type arguments determine x in the leaf.
:expect "through base"
private class LocalReader[T] with
  open fun read(x: T): Str = ""
private class MiddleReader[T] extends LocalReader[T] with
  open override fun read(x) = ""
private class WordReader extends MiddleReader[Argument] with
  override fun read(x) = x.word
private fun readLocal(p: LocalReader[Argument]) = p.read(Argument("through base"))
readLocal(new WordReader)
//│ = "through base"


