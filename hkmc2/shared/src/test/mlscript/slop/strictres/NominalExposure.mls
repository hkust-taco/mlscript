// Extra subclass members and values hidden by a declared field type remain internal.
private class PublicView(val visible: Any)
private class Extra extends PublicView(42) with
  fun local(x) = x.a
private class Internal with
  fun read(x) = x.b
fun outward(): PublicView = new Extra
fun erased(): PublicView = PublicView(new Internal)
[new Extra().local({a: 1}), new Internal().read({b: 2})]
//│ = [1, 2]


// A typed domain reaches the unannotated override with the base's type argument.
private class Argument(val word: Str)
private class TypedService[T] with
  open fun inspect(x: Box[T]): Str = ""
private class TypedImplementation extends TypedService[Argument] with
  override fun inspect(x) = x.contents.word
fun typedService(): TypedService[Argument] = new TypedImplementation

:expect "typed"
typedService().inspect(Box(Argument("typed")))
//│ = "typed"

// Both operations inherit T through an unannotated override, then specialize U at the leaf.
private class ChainBase[T](seed: T) with
  open fun inspect(x: T): Str = ""
  open mut val item: T = seed
private class ChainMiddle[U](seed: U) extends ChainBase[U](seed) with
  open override fun inspect(x) = ""
  open override mut val item = seed
private class ChainLeaf extends ChainMiddle[Argument](Argument("initial")) with
  override fun inspect(x) = x.word
  override mut val item = Argument("leaf")
  fun read() = item.word
private val chainLeaf = new mut ChainLeaf
fun chainView(): ChainBase[Argument] = chainLeaf
//│ chainLeaf = ChainLeaf

:expect ["called", "written"]
set chainView().item = Argument("written")
[chainView().inspect(Argument("called")), chainLeaf.read()]
//│ = ["called", "written"]

// Writing Box in an exposed override leaves its contents unknown even when the base specifies them.
