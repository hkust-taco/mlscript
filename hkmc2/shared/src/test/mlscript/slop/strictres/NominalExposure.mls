// The receiver's type arguments also apply to parameters specified by a separate signature.
private class SignedService[T] with
  fun inspect: T -> Str
  open fun inspect(x) = ""
private class SignedImplementation extends SignedService[Argument] with
  override fun inspect(x) = x.word
fun signedService(): SignedService[Argument] = new SignedImplementation

:expect "signed"
signedService().inspect(Argument("signed"))
//│ = "signed"


