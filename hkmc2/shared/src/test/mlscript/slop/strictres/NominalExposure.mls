// The written Box on an overriding field also admits unknown contents.
:e
private class BoxFieldBase with
  open mut val slot: Box[Argument] = Box(Argument("base"))
private class BoxFieldChild extends BoxFieldBase with
  override mut val slot: Box = Box(Argument("initial"))
  fun read() = slot.contents.word
private val boxedChild = new mut BoxFieldChild
fun boxFieldView(): BoxFieldBase = boxedChild
set boxFieldView().slot = Box(Argument("later"))
boxedChild.read()
