:.
#lang(eagerResolution: false)

// Losing a conditional's correlation must not reject a call with a known target.
:expect 1
class Item(val value: Int)
private fun choose(flag: Bool) = if flag then () => Item(1) else {other: 0}
choose(true)().value
//│ = 1

// A non-callable candidate can arrive before a forward callable target.
:expect 2
private fun forward(flag: Bool) = (if flag then {other: 0} else later)()
private fun later() = Item(2)
forward(false).value
//│ = 2

// Callability does not depend on whether a callable publishes a result.
private fun never(flag: Bool) = (if flag then () => throw "stopped" else {other: 0})()

// With no callable target, lenient resolution still diagnoses the call.
:e
private fun invalid() = {other: 0}
invalid()()
//│ ╔══[COMPILATION ERROR] Resolution error in application
