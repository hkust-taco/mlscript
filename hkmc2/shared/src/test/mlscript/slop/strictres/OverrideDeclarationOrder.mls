// Calls through the leaf declaration inherit the same domain whether its parent was written first or last.
private class PublicLeaf extends InputMiddle[Payload] with
  override fun inspect(x) = x.key
private class InputMiddle[T] extends InputBase[T] with
  open override fun inspect(x) = 0
private class InputBase[T] with
  open fun inspect(x: T): Int = 0
private class Payload(val key: Int)
fun publicLeaf(): PublicLeaf = new PublicLeaf

// A private member with the same name has its own call interface.
:e
private class Shadow extends InputBase[Payload] with
  private fun inspect(x) = x.key
  fun callback() = inspect
fun escaped() = new Shadow().callback()
