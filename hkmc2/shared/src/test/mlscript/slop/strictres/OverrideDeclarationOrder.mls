// The overriding declarations precede the written result.
:e
private fun leafCallback(x) = x.only
private class Leaf extends Middle with
  override fun get() = leafCallback
private class Middle extends Root with
  open override fun get() = x => 0
private class Root with
  open fun get(): Any -> Int = x => 1
fun root(): Root = new Leaf
leafCallback({only: 42})
