// Returning the generator method exposes its iterator. The callback ending its body stays private.
:expect 42
private fun finalValue(x) = x.only
private class Generators with
  @generator open fun items() = finalValue
fun itemsMethod() = new Generators().items
finalValue({only: 42})
//│ = 42


