// The parent clause determines the callback domain even across an unannotated override.
private class Keyed(val key: Int)
private class Source[T] with
  open fun get(): T -> Int = x => 0
private class Forward[U] extends Source[U] with
  open override fun get() = x => 1
private class KeySource extends Forward[Keyed] with
  override fun get() = x => x.key
fun source(): Source[Keyed] = new KeySource

:expect 42
source().get()(Keyed(42))
//│ = 42

// Callers of an async override receive the inherited callback inside a promise.
:e
open annotations.{ * }
private fun fulfilled(x) = x.only
private class AsyncSource with
  @async open fun get(): Any -> Int = x => 0
private class AsyncImpl extends AsyncSource with
  @async override fun get() = fulfilled
fun asyncSource(): AsyncSource = new AsyncImpl
