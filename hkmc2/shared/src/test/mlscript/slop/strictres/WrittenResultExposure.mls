// The async override returns a promise that fulfills with a callback. Clients can pass it null.
:e
private fun promisedCallback(x) = x.key
private class AdoptingSource with
  @async open fun get(): Any -> Int = x => 0
private class Adopting extends AdoptingSource with
  @async override fun get() = Promise.resolve(promisedCallback)
