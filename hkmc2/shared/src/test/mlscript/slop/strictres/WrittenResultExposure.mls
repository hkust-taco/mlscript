// Calling get through AsyncBase can yield the callback from the deepest override.
:e
private fun asyncCallback(x) = x.only
private class AsyncBase with
  @async open fun get() = x => 0
private class AsyncMiddle extends AsyncBase with
  @async open override fun get() = x => 1
private class AsyncLeaf extends AsyncMiddle with
  @async override fun get() = asyncCallback
