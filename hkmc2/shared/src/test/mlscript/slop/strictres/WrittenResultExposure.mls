:expect 7
private fun iteratorCallback(x) = x.only
private class IteratorBase with
  @generator open fun items() = 0
private class IteratorChild extends IteratorBase with
  @generator override fun items() = iteratorCallback
fun iteratorBase(): IteratorBase = new IteratorChild
