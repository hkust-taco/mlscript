// Only the saved method escapes. Calling it through its base type can return the override's callback.
:e
private fun fromOverride(x) = x.only
private class Producer with
  open fun get() = (x => 0)
private class CallbackProducer extends Producer with
  override fun get() = fromOverride
private fun methodOf(p: Producer) = p.get
fun savedGet() = methodOf(new CallbackProducer)
