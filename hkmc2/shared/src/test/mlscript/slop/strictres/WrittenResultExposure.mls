// A separate signature describes both calls. The second arrow types the returned callback.
:expect 42
private type FactoryFor[A, B] = A -> B -> Int
private class Factory with
  fun get: FactoryFor[Int, Keyed]
  open fun get(n) = x => x.key
private class ReaderFactory extends Factory with
  override fun get(n) = x => x.key + n
fun factory(): Factory = new ReaderFactory
factory().get(2)(Keyed(40))
//│ = 42

// The implementation receives a Keyed, but the callback it returns must accept Any.
:e
private class AnyFactory with
  fun get: FactoryFor[Keyed, Any]
  open fun get(n) = x => n.key
private class UnsafeFactory extends AnyFactory with
  override fun get(n) = x => x.key
fun anyFactory(): AnyFactory = new UnsafeFactory
