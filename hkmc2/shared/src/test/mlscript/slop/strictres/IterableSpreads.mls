//│ ║  l.+1: 	fun namedOnly(xs: {iterator: () -> Iterator[Box]}) = [...xs].0.value
//│ ╙──      	                                                         ^^

// Iterator only promises next; iterable implementations supply their own method.
import "../../../mlscript-compile/Iter.mjs"

:expect [48, 49]
let count = 48
let iterator = Iter.IteratorImpl(() =>
  if count <= 49 then
    let value = count
    set count = count + 1
    {value: value, done: false}
  else {done: true})
[...iterator]
//│ = [48, 49]
//│ count = 50
//│ iterator = IteratorImpl(fun)

:e
