// The type parameters of an override correspond to those of its base by position.
// The override's B stands for the base's A, which types both `x` and the result.
:expect 7
private class PairBase with
  open fun first[A, B](x: A, y: B): A = x
private class SwappedNames extends PairBase with
  override fun first[B, A](x, y): B = x
new SwappedNames().first(Item(7), 0).n
//│ = 7


// An override inherits the positions from the base's separate signature, including
// when the base implementation repeats them under different names.
:expect 9
private class SplitBase with
  open fun first[A, B]: (A, B) -> A
  fun first[X, Y](x: X, y) = x
private class SplitChild extends SplitBase with
  override fun first[P, Q](x, y): P = x
new SplitChild().first(Item(9), 0).n
//│ = 9


