// An intermediate override can omit the binder on which the returned callback depends.
:e
private class CallbackRoot with
  open fun make[A, B](tag: Int): B -> Int = x => 0
private class CallbackMiddle extends CallbackRoot with
  open override fun make[P](tag) = x => 0
private class CallbackLeaf extends CallbackMiddle with
  override fun make[X](tag) = x => x.n
private fun throughRoot(root: CallbackRoot) = root.make[Int, Item](0)(Item(9))
throughRoot(new CallbackLeaf)
