// An implementing header may introduce a type parameter even when the public signature has none.
// A subclass inherits the declared Item domain.
:expect 10
private class ItemReader with
  open fun read: Item -> Int
  fun read[X](x: X) = 0
private class ItemValue extends ItemReader with
  override fun read(x) = x.n
new ItemValue().read(Item(10))
//│ = 10


// A base type parameter without a counterpart in the override remains opaque in its body.
:e
private class TwoParameters with
  open fun pick[A, B](x: A, y: B): Int = 0
private class OneParameter extends TwoParameters with
  override fun pick[C](x, y) = y.only
new OneParameter().pick(1, {only: 2})
