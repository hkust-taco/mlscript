:.

private class Item(val n: Int)


// An override that receives no direct call still inherits the written parameter type.
:e
private fun onlyOf(y) = y.only
private class AnyReader with
  open fun read(x: Any): Int = 0
private class ForwardingReader extends AnyReader with
  override fun read(x) = onlyOf(x)
private fun readAny(p: AnyReader) = p.read(null)
onlyOf({only: 1})
readAny(new ForwardingReader)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+1: 	private fun onlyOf(y) = y.only
//│ ║        	                        ^^^^^^
//│ ╟── Value with an empty interface does not contain member 'only'
//│ ║  l.+3: 	  open fun read(x: Any): Int = 0
//│ ║        	                   ^^^
//│ ╟── Type 'Any' is declared without a member interface.
//│ ║  in ../../decls/Prelude.mls
//│ ║  l.XX: 	declare type Any
//│ ╙──      	             ^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// A middle class without an override passes the base's written type on to the leaf.
:e
private class TypedRoot with
  open fun read(x: Any): Int = 0
private class PlainMiddle extends TypedRoot
private class TypedLeaf extends PlainMiddle with
  override fun read(x) = x.only
new TypedLeaf().read({only: 1})
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+5: 	  override fun read(x) = x.only
//│ ║        	                         ^^^^^^
//│ ╟── Value with an empty interface does not contain member 'only'
//│ ║  l.+2: 	  open fun read(x: Any): Int = 0
//│ ║        	                   ^^^
//│ ╟── Type 'Any' is declared without a member interface.
//│ ║  in ../../decls/Prelude.mls
//│ ║  l.XX: 	declare type Any
//│ ╙──      	             ^^^
