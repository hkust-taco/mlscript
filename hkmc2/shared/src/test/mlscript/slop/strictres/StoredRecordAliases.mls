//│ ╙──      	                 ^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ alias = {item: null}
//│ owner = RecordOwner(_)


:e
private class ClearedOwner(p) with
  val record = mut {item: p}
private fun clearRecord(o) = set o.record.item = null
private val cleared = ClearedOwner(Item(1))
clearRecord(cleared)
cleared.record.item.n
//│ ╔══[COMPILATION ERROR] Resolution error in selection
