:.

// A member val holds one record per instance, module, or object. A write through any reference
// to that record is visible to the later reads of the val.

private class Item(val n: Int)
private class Other(val other: Int)


:e
private class RecordOwner(p) with
  val record = mut {item: p}
private val owner = RecordOwner(Item(1))
private val alias = owner.record
set alias.item = null
owner.record.item.n
//│ ╔══[COMPILATION ERROR] Resolution error in selection
