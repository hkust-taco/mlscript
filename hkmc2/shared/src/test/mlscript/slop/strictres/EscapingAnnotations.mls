// Writing the argument specifies the contents.
:expect ["typed", "local", "sunk"]
private fun readTyped(box) = box.contents.word
private fun typedReader(): Box[Argument] -> Str = readTyped
private fun typedBox(): Box[Argument] = Box(Argument("local"))
private class TypedBoxSink extends Sink[Box[Argument]](box => box.contents.word)
fun typed() = [typedReader(), typedBox(), new TypedBoxSink]
[readTyped(Box(Argument("typed"))), typedBox().contents.word, new TypedBoxSink().accept(Box(Argument("sunk")))]
//│ = ["typed", "local", "sunk"]


