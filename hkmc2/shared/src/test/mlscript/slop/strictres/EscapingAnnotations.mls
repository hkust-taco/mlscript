:.

// A value escapes with the type written for it, even when the annotation is on a private definition
// and no exported signature names that type. Clients use the value at that type: they call a function
// with arguments of their own and write to a mutable record or instance. The written type restricts
// these inputs, except at the type arguments that it omits, which admit unknown values.

private class Argument(val word: Str)
private class Box[T](val contents: T)
private class Cell[T](mut val contents: T)
private class Sink[T](f: T -> Str) with
  fun accept(x: T) = f(x)
  fun self() = this


// The annotation of a private binding.
:e
private fun readBound(box) = box.contents.word
private val bound: (Box -> Str) = readBound
fun boundReader() = bound
readBound(Box(Argument("local")))
