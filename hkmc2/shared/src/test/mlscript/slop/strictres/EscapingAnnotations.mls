// The annotation is written in a generic function or in a method of a generic class, and the value
// escapes from one of its invocations.
:e
private fun readGeneric(box) = box.contents.word
private fun typedIn[A](x: A, f) = f as Box -> Str
fun genericReader() = typedIn(1, readGeneric)
