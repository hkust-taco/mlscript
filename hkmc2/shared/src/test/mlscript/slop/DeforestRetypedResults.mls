// A partial application coerces the arguments of the parameter lists that it applies.
:deforest mono
:expect 3
private fun curried(b: Box)(n: Int): Int = if b is Box(v) then v + n else n
private fun partial() =
  let g = curried(Box(1))
  g(2)
partial()
//│ deforest > >>> fusing >>>
//│ deforest > Box⁰(1) ->
//│ deforest > 	match: b⁰
//│ deforest > 	fields: b⁰.v⁰
//│ deforest > <<< fusing <<<
//│ = 3


// A method is rewritten in place at the root, and its calls reach functions retyped there.
:deforest mono
:expect 42
private fun produce(n: Int): Box = if n == 0 then Box(42) else produce(n - 1)
private fun consume(box: Box): Int = if box is Box(value) then value
class Caller with
  fun run() = consume(produce(2))
new Caller().run()
//│ deforest > >>> fusing >>>
//│ deforest > Box⁰(42) ->
//│ deforest > 	match: box⁰
//│ deforest > 	fields: box⁰.v⁰
//│ deforest > <<< fusing <<<
//│ = 42


// An indirect call can return either producer's object. Reading its field must use the call's
// result even when projection would change the result of both producers to an unboxed word.
declare module Math with
  declare fun imul(x: Int, y: Int): Int32
  declare fun abs(x: Int32): Int
data class Word(bits: Int32)

// FIXME: make() loses its Int32 result after fusion and passes undefined to read.
:fixme
:deforest
:expect 49
private fun first(): Word = Word(Math.imul(42, 1))
private fun second(): Word = Word(Math.imul(7, 1))
private fun read(w: Word): Int = Math.abs(w.bits)
private fun choose(c: Bool): Int =
  let make = if c then first else second
  read(make())
choose(true) + choose(false)
//│ deforest > >>> fusing >>>
//│ deforest > Word⁰(tmp⁰) ->
//│ deforest > 	select: bits
//│ deforest > Word⁰(tmp¹) ->
//│ deforest > 	select: bits
//│ deforest > Word⁰(tmp⁰) ->
//│ deforest > 	select: bits
//│ deforest > Word⁰(tmp¹) ->
//│ deforest > 	select: bits
//│ deforest > Word⁰(tmp⁰) ->
//│ deforest > 	select: bits
//│ deforest > Word⁰(tmp¹) ->
//│ deforest > 	select: bits
//│ deforest > <<< fusing <<<
//│ ═══[RUNTIME ERROR] Expected: '49', got: 'NaN'
//│ = NaN


// In the other direction, a projected word reaches both readers as the argument of a call through a
// function value. Such a call passes its arguments unchanged, so each reader receives the unboxed word.
:deforest
:expect 49
private fun readA(w: Word): Int = Math.abs(w.bits)
private fun readB(w: Word): Int = Math.abs(w.bits) + 7
private fun pass(c: Bool): Int =
  let reader = if c then readA else readB
  reader(Word(Math.imul(21, 1)))
pass(true) + pass(false)
//│ deforest > >>> fusing >>>
//│ deforest > Word⁰(tmp²) ->
//│ deforest > 	select: bits
//│ deforest > Word⁰(tmp²) ->
//│ deforest > 	select: bits
//│ deforest > Word⁰(tmp²) ->
//│ deforest > 	select: bits
//│ deforest > <<< fusing <<<
//│ = 49


// In mono mode the readers are retyped in place: their parameter becomes an Int32.
:deforest mono
:sir
:siret
:expect 49
private fun readC(w: Word): Int = Math.abs(w.bits)
private fun readD(w: Word): Int = Math.abs(w.bits) + 7
private fun passMono(c: Bool): Int =
  let reader = if c then readC else readD
  reader(Word(Math.imul(21, 1)))
passMono(true) + passMono(false)
//│ deforest > >>> fusing >>>
//│ deforest > Word⁰(tmp³) ->
//│ deforest > 	select: bits
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Int⁰, tmp1: Int⁰;
//│ @private
//│ define readC⁰ as fun readC¹(w: Int32): Int⁰ {
//│   return globalThis⁰.Math⁰.abs⁰(w)
//│ };
//│ @private
//│ define readD⁰ as fun readD¹(w: Int32): Int⁰ {
//│   let tmp2: Int⁰;
//│   set tmp2 = globalThis⁰.Math⁰.abs⁰(w);
//│   return +⁰(tmp2, 7)
//│ };
//│ @private
//│ define passMono⁰ as fun passMono¹(c: Bool⁰): Int⁰ {
//│   let reader: Function⁰, tmp2: Function⁰, tmp3: Int32, tmp4: Int32, Word_bits: Int32;
//│   match c
//│     true =>
//│       set tmp2 = readC¹;
//│       end
//│     else
//│       set tmp2 = readD¹;
//│       end
//│   set reader = tmp2;
//│   set tmp3 = globalThis⁰.Math⁰.imul⁰(21, 1);
//│   set Word_bits = tmp3;
//│   set tmp4 = Word_bits;
//│   return (reader(tmp4) as! Int⁰)
//│ };
//│ set tmp = passMono¹(true);
//│ set tmp1 = passMono¹(false);
//│ return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 49


// A continuation extracted from a function returns for that function. Here fusion turns the result of
// `route` into a closure, while the join continuation `σ` only returns the result of a call that never
// returns, of the unrelated type `Away`. The continuation drops that value as `route` itself does, so
// the calls to the continuation in `route` have a result that fits the closure type.
:deforest mono
:patMatConsequentSharingThreshold 1
:sir
:siret
:expect 0
object Away
data class Step(x: Int)
private fun stop(): Away = throw Error("stop")
private fun halt(): Away = throw Error("halt")
private fun route(c, d, n) =
  if d then Away
  else
    let s = Step(n)
    if
      c and s is Step(x) and x > 0 then halt()
      else stop()
private fun arrived(a) = if a is Away then 0 else 1
arrived(route(true, true, 1))
//│ deforest > >>> fusing >>>
//│ deforest > Step⁰(n¹) ->
//│ deforest > 	match: s⁰
//│ deforest > 	fields: s⁰.x¹
//│ deforest > Away⁰ ->
//│ deforest > 	match: a⁰
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let $s_Step, $s_rest, $c_rest, $σ_rest, $d_rest, $a_Away, $a_rest, tmp: Function⁰;
//│ @affine(1) @private
//│ define $s_Step as fun $s_Step⁰(Step_x: Int⁰)(fv_arg$Step$0$: Int⁰, fv_x: Int⁰, fv_scrut: Bool⁰): Nothing {
//│   set fv_arg$Step$0$ = Step_x;
//│   set fv_x = fv_arg$Step$0$;
//│   set fv_scrut = >⁰(fv_x, 0);
//│   match fv_scrut
//│     true =>
//│       do halt⁰();
//│       return undefined
//│     else
//│       return $σ_rest⁰()
//│   end
//│ };
//│ @affine(1) @private
//│ define $a_Away as fun $a_Away⁰()(): Int⁰ {
//│   return 0
//│ };
//│ @private
//│ define $s_rest as fun $s_rest⁰(): Nothing {
//│   return $c_rest¹()
//│ };
//│ @private
//│ define $c_rest as fun $c_rest¹(): Nothing {
//│   return $σ_rest⁰()
//│ };
//│ @private
//│ define $σ_rest as fun $σ_rest⁰(): Nothing {
//│   do stop⁰();
//│   return undefined
//│ };
//│ @private
//│ define $d_rest as fun $d_rest⁰(): Unknown {
//│   return null
//│ };
//│ @private
//│ define $a_rest as fun $a_rest⁰(): Unknown {
//│   return null
//│ };
//│ @private
//│ define stop¹ as fun stop⁰(): Away⁰ {
//│   throw globalThis⁰.Error⁰("stop")
//│ };
//│ @private
//│ define halt¹ as fun halt⁰(): Away⁰ {
//│   throw globalThis⁰.Error⁰("halt")
//│ };
//│ @private
//│ define route⁰ as fun route¹(c: Bool⁰, d: Bool⁰, n: Int⁰): Function⁰ {
//│   let x: Int⁰, scrut: Bool⁰, arg$Step$0$: Int⁰, s: Function⁰;
//│   match d
//│     true =>
//│       return $a_Away⁰()
//│     else
//│       let Step_x: Int⁰;
//│       set Step_x = n;
//│       set s = $s_Step⁰(Step_x);
//│       block σ:
//│         match c
//│           true =>
//│             return (s(arg$Step$0$, x, scrut) as! Function⁰)
//│           else
//│             return $σ_rest⁰()
//│         end
//│       do stop⁰();
//│       return undefined
//│   end
//│ };
//│ @private
//│ define arrived⁰ as fun arrived¹(a: Function⁰): Int⁰ {
//│   return (a() as! Int⁰)
//│ };
//│ define Away¹ as object Away⁰;
//│ @data
//│ define Step¹ as class Step² {
//│   val x²: Int⁰;
//│   constructor Step⁰(x: Int⁰) {
//│     define x² as val x¹: Int⁰ = x;
//│     end
//│   }
//│ };
//│ set tmp = (route¹(true, true, 1) as!! Function⁰);
//│ return arrived¹(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0


// In poly mode, the instance of `route` that returns a closure and the original one each call
// their own continuations.
:deforest
:patMatConsequentSharingThreshold 1
:expect 0
object AwayP
data class StepP(x: Int)
private fun stopP(): AwayP = throw Error("stop")
private fun haltP(): AwayP = throw Error("halt")
private fun routeP(c, d, n) =
  if d then AwayP
  else
    let s = StepP(n)
    if
      c and s is StepP(x) and x > 0 then haltP()
      else stopP()
private fun arrivedP(a) = if a is AwayP then 0 else 1
arrivedP(routeP(true, true, 1))
//│ deforest > >>> fusing >>>
//│ deforest > StepP⁰(n²) ->
//│ deforest > 	match: s¹
//│ deforest > 	fields: s¹.x³
//│ deforest > StepP⁰(n²) ->
//│ deforest > 	match: s¹
//│ deforest > 	fields: s¹.x³
//│ deforest > AwayP⁰ ->
//│ deforest > 	match: a¹
//│ deforest > <<< fusing <<<
//│ = 0


// A match fused inside the branch of another one returns for the same function. The call that replaces
// it in the extracted branch is coerced to the result of `nested`, which gives the branch function
// that result type.
:deforest mono
:sir
:siret
:expect 2
private fun nested(n: Int): Int =
  let a = Box(n)
  if a is Box(x) then
    let b = Box(x + 1)
    if b is Box(y) then y else 0
  else 0
nested(1)
