:.
:lift
:noInline
:checkIR

// Fusion can change what a function returns. The signature of every instance of the function
// then has to follow, including instances that no call reaches and definitions without parameter lists.

data class Box(v: Int)


// In mono mode, nothing marks the result of an uncalled private function as escaping. The constructor
// that one path matches and the other returns is fused, so the result type admits its closure.
:deforest mono
:sir
:siret
:expect 42
private fun uncalled(n: Int, c: Bool): Box =
  let x = Box(n)
  if c then
    if x is Box(v) then Box(v + 1) else Box(0)
  else x
42
//│ deforest > >>> fusing >>>
//│ deforest > Box⁰(n⁰) ->
//│ deforest > 	match: x⁰
//│ deforest > 	fields: x⁰.v⁰
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let $x_Box, $x_rest, $c_rest;
//│ @affine(1) @private
//│ define $x_Box as fun $x_Box⁰(Box_v: Int⁰)(fv_arg$Box$0$: Int⁰, fv_v: Int⁰, fv_tmp: Int⁰): Box¹ {
//│   set fv_arg$Box$0$ = Box_v;
//│   set fv_v = fv_arg$Box$0$;
//│   set fv_tmp = +⁰(fv_v, 1);
//│   return Box⁰(fv_tmp)
//│ };
//│ @private
//│ define $x_rest as fun $x_rest⁰(): Unknown {
//│   return $c_rest⁰()
//│ };
//│ @private
//│ define $c_rest as fun $c_rest⁰(): Unknown {
//│   return null
//│ };
//│ @private
//│ define uncalled⁰ as fun uncalled¹(n: Int⁰, c: Bool⁰): Object⁰ {
//│   let v: Int⁰, arg$Box$0$: Int⁰, tmp: Int⁰, x: Function⁰, Box_v: Int⁰;
//│   set Box_v = n;
//│   set x = $x_Box⁰(Box_v);
//│   match c
//│     true =>
//│       return (x(arg$Box$0$, v, tmp) as! Object⁰)
//│     else
//│       return x
//│   end
//│ };
//│ return 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


// A definition without parameter lists returns into the variable of its own symbol. Its result is
// retyped like that of any other function, and a read through the retained symbol takes the new type.
:deforest mono
:sir
:siret
:expect 1
module Mono with
  private fun boxed = Box(1)
  fun read = if boxed is Box(v) then v else 0
Mono.read
//│ deforest > >>> fusing >>>
//│ deforest > Box⁰(1) ->
//│ deforest > 	match: scrut⁰
//│ deforest > 	fields: scrut⁰.v⁰
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let $scrut_Box, $scrut_rest;
//│ @affine(1) @private
//│ define $scrut_Box as fun $scrut_Box⁰(Box_v: Int⁰)(fv_arg$Box$0$: Int⁰, fv_v: Int⁰): Int⁰ {
//│   set fv_arg$Box$0$ = Box_v;
//│   set fv_v = fv_arg$Box$0$;
//│   return fv_v
//│ };
//│ @private
//│ define $scrut_rest as fun $scrut_rest⁰(): Unknown {
//│   return null
//│ };
//│ define Mono⁰ as class Mono¹
//│ module Mono² {
//│   method boxed⁰ = fun boxed¹: Function⁰ {
//│     let Box_v: Int⁰;
//│     set Box_v = 1;
//│     return $scrut_Box⁰(Box_v)
//│   }
//│   method read⁰ = fun read¹: Int⁰ {
//│     let v: Int⁰, arg$Box$0$: Int⁰, scrut: Function⁰;
//│     set scrut = (Mono².this.boxed¹ as!! Function⁰);
//│     return (scrut(arg$Box$0$, v) as! Int⁰)
//│   }
//│ };
//│ return Mono².read¹
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// In poly mode, the instance that returns a closure is a copy whose signature has that result, and the
// read of the copy has it too. Taking the read for a value of the previous type would drop it as unreachable.
// FIXME: the JavaScript backend rejects the top-level copy of a definition without parameter lists.
// That failure predates the retyping of fused values.
:fixme
:deforest
:sir
:siret
:expect 1
module Poly with
  private fun boxed = Box(1)
  fun read() = if boxed is Box(v) then v else 0
Poly.read()
//│ deforest > >>> fusing >>>
