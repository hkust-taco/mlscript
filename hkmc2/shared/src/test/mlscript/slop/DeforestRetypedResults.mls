//│ define $a_Box as fun $a_Box⁰(Box_v: Int⁰)(fv_arg$Box$0$: Int⁰, fv_x: Int⁰, fv_tmp: Int⁰, fv_b: Function⁰, fv_arg$Box$0$1: Int⁰, fv_y: Int⁰): Int⁰ {
