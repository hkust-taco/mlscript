:.
#lang(strictResolution: true, eagerResolution: true)

// A required prefix and a variable tail still expose Array members before calls.
private fun nonEmpty(...xs: [Int, ...Array[Int]]) = xs.length
private fun sum(...xs: [Int, ...Array[Int]]) = xs.reduce(=> _ + _, 0)

:expect [1, 3, 6]
[nonEmpty(1), nonEmpty(1, 2, 3), sum(1, 2, 3)]
//│ = [1, 3, 6]

// Spreads retain their annotated element interfaces and exact fixed positions.
:expect [4, 2, true]
type Pair = [Int, Str]
private fun fixed(xs: [...Pair, Bool]) = [xs.0 + 1, xs.1.length, xs.2]
fixed([3, "hi", true])
//│ = [4, 2, true]

// Generic tail inference must exclude the fixed prefix and suffix.
:expect [[5, 6], [7]]
class Item(val value: Int)
private fun tail[T](...xs: [Int, ...Array[T]]): Array[T] = xs.slice(1)
private fun middle[T](xs: [Int, ...Array[T], Str]): Array[T] = xs.slice(1, -1)
[tail(0, Item(5), Item(6)).map(x => x.value),
 middle([0, Item(7), "end"]).map(x => x.value)]
//│ = [[5, 6], [7]]

// Adjacent fixed tuple spreads retain separate generic inference positions.
:expect [8, 9]
class Left(val left: Int)
class Right(val right: Int)
private fun pair[A, B](xs: [...[A], ...[B]]): [A, B] = xs
let result = pair([Left(8), Right(9)])
[result.0.left, result.1.right]
//│ = [8, 9]
//│ result = [Left(8), Right(9)]

// Several variable spreads retain the fixed fields around and between them.
:expect [1, 5]
private fun many(xs: [Int, ...Array[Int], Int, ...Array[Int], Int]) = [xs.0, xs.length]
many([1, 2, 3, 4, 5])
//│ = [1, 5]

// The spread does not erase the required prefix when forwarding arguments.
:ge
private fun zero() = 0
private fun forward(...xs: [Int, ...Array[Int]]) = zero(...xs)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+2: 	private fun forward(...xs: [Int, ...Array[Int]]) = zero(...xs)
//│ ║        	                                                   ^^^^^^^^^^^
//│ ╟── Function 'zero' expected 0 arguments, but got at least 1
//│ ║  l.+1: 	private fun zero() = 0
//│ ╙──      	^^^^^^^^^^^^^^^^^^

// Annotation boundaries still hide members of supplied implementation types.
:ge
class Base
class Child(val extra: Int) extends Base
private fun annotated(...xs: [Base, ...Array[Base]]) = xs.map(x => x.extra)
annotated(Child(10))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+3: 	private fun annotated(...xs: [Base, ...Array[Base]]) = xs.map(x => x.extra)
//│ ║        	                                                                   ^^^^^^^
//│ ╟── Value of type 'Base' does not contain member 'extra'
//│ ║  l.+3: 	private fun annotated(...xs: [Base, ...Array[Base]]) = xs.map(x => x.extra)
//│ ╙──      	                              ^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Splicing an alias into itself does not guard its recursion.
:ge
type Loop = [Int, ...Loop]
private fun loop(xs: Loop) = xs.length
//│ ╔══[COMPILATION ERROR] Resolution error in tuple literal
//│ ║  l.+1: 	type Loop = [Int, ...Loop]
//│ ║        	            ^^^^^^^^^^^^^^
//│ ╟── Unguarded recursive type alias 'Loop'.
//│ ║  l.+1: 	type Loop = [Int, ...Loop]
//│ ║        	                     ^^^^
//│ ╟── Recursive references must pass through a record, tuple, function, or nominal type.
//│ ║  l.+1: 	type Loop = [Int, ...Loop]
//│ ╙──      	     ^^^^
//│ ╔══[COMPILATION ERROR] This selection of member 'length' has no resolved target
