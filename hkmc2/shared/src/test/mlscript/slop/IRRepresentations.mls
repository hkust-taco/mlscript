:.
:js
open annotations

// Known representations agree across definitions, calls, assignments and returns.
// Widening to a parent, explicit narrowing, and unannotated reference slots are all legitimate.
:checkIR
:noInline
:expect [42, 43, 44]
class Parent
class Child extends Parent
fun widen(value: Child): Parent = value
fun narrow(value: Any): Int = value
fun unknown(value) = value
val result: Int = narrow(42)
[if widen(new Child) is Parent then result else 0, narrow(43), unknown(44)]
//│ = [42, 43, 44]
//│ result = 42

// Dynamic tuple reads enter annotated slots through an explicit narrowing cast.
:checkIR
:noOpt
:expect 43
fun checkedRead(values: Array[Any]): Int =
  val element: Int = values.[0]
  element
val checked: Int = checkedRead([43])
checked
//│ = 43
//│ checked = 43

// Variadic extraction narrows dynamic tuple reads before assigning typed parameter slots.
:checkIR
:noOpt
:expect 42
fun extractedLast(...middle: Array[Any], last: Int): Int = last
extractedLast(1, 42)
//│ = 42

// Missing body-result information and undefined do not prove an incompatible representation.
:checkIR
:noInline
fun unconstrained(value) = value
fun undefinedResult(): Int = unsafe.undefined
fun acceptUndefined(value: Int): Int = 0
acceptUndefined(unsafe.undefined)
//│ = 0

// Returning a local nominal value is valid even outside the class's lexical scope.
:checkIR
:noInline
fun escaping() =
  class Local
  new Local
escaping()
//│ = Local

// A spread ends the known positional prefix. The following Bool is the last
// argument, not the Str slot immediately after the first argument.
:checkIR
:noInline
:expect [true, false]
fun spreadTarget(first: Int, second: Str, last: Bool): Bool = last
fun spreadAll(values: Array[Any]) = spreadTarget(...values, true)
fun spreadAfterFirst(values: Array[Any]) = spreadTarget(1, ...values, false)
[spreadAll([1, "two"]), spreadAfterFirst(["two"])]
//│ = [true, false]

// Nested closures and constructors have their own return boundaries.
:checkIR
:noOpt
:expect 42
fun nestedReturns(): Int =
  let text = (value: Str) => value
  class Nested with
    fun text(): Str = "hello"
  if text(new Nested().text()) == "hello" then 42 else 0
nestedReturns()
//│ = 42

// Inlining propagates the literal into the coercion to the parameter's class. A cast between
// unrelated reference types fails at run time but still has a representation, unlike a cast
// involving an unboxed primitive.
:checkIR
:soir
class Wrapper
fun fortyTwo = 42
fun asWrapper(value: Wrapper): Wrapper = value
fun mismatch() = asWrapper(fortyTwo)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define fortyTwo⁰ as fun fortyTwo¹() {
//│   return 42
//│ };
//│ define asWrapper⁰ as fun asWrapper¹(value) {
//│   return value
//│ };
//│ define mismatch⁰ as fun mismatch¹() {
//│   return (42 as! Wrapper⁰)
//│ };
//│ define Wrapper¹ as class Wrapper⁰;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// Declaring a parameter whose type has no common representation is legal; moving a value into it
// is the error. The binding and the signature agree on that type, so the definition is valid.
:checkIR
fun mixed(value: Int32 | Str) = 0

// TODO: SymbolRefresher must rename nominal types alongside the classes it copies.
// Each inlined construction must agree with its own temporary and parameter slots.
:fixme
:checkIR
@inline fun copiedNominal() =
  class Local
  @noInline fun identity(value: Local): Local = value
  identity(new Local)
[copiedNominal(), copiedNominal()]
//│ ╔══[INTERNAL ERROR] Invalid IR: incompatible representations at assignment to 'tmp'
//│ ╙── The value and its destination refer to different copies of type 'Local'
//│ ╔══[INTERNAL ERROR] Invalid IR: incompatible representations at assignment to 'tmp'
//│ ╙── The value and its destination refer to different copies of type 'Local'
//│ = [Local, Local]

// TODO: String range patterns store the extracted head in a Str temporary without a cast.
:fixme
:checkIR
pattern Lower = "a"..="z"
//│ ╔══[INTERNAL ERROR] Invalid IR: a missing cast at assignment to 'stringHead'
//│ ╙── The value has type 'Unknown', but its destination requires 'Str'

// TODO: Tail-call rewriting assigns the spread argument to the Array-typed rest parameter without a cast.
:fixme
:checkIR
@tailrec fun count(n)(...rest) = if rest is
  [] then n
  [_, ...more] then count(n + 1)(...more)
//│ ╔══[INTERNAL ERROR] Invalid IR: a missing cast at assignment to 'rest'
//│ ║  l.+1: 	@tailrec fun count(n)(...rest) = if rest is
//│ ║        	                         ^^^^
//│ ╟── The value has type 'Unknown', but its destination requires 'Array'
//│ ║  l.+1: 	@tailrec fun count(n)(...rest) = if rest is
//│ ╙──      	                         ^^^^

// TODO: Inlining `|>` turns a call of a function value into a direct call to `describe`,
// but does not coerce the argument to the type of the callee's parameter.
:fixme
:checkIR
@noInline fun describe(text: Str): Str = text
@noInline fun produce(value) = value
produce("a") |> describe
//│ ╔══[INTERNAL ERROR] Invalid IR: a missing cast at a call argument
//│ ╙── The value has type 'Unknown', but its destination requires 'Str'
//│ = "a"
