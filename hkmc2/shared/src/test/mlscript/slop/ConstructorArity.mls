//│ ╟── Class value expected 0 arguments, but got at least 1
//│ ║  l.16: 	class Empty {
//│ ╙──      	^^^^^^^^^^^


// Qualified and aliased classes must retain their constructor's arity.
module Classes { class Empty }
val Alias = Classes.Empty
//│ Alias = class Empty

:e
fun qualified() = new Classes.Empty(1)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
