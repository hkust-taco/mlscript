// Auxiliary constructor lists count even when absent from the class header.
class Auxiliary {
  constructor(val first)
  constructor(val second)
  fun values() = [first, second]
}

:expect [5, 6]
new Auxiliary(5)(6).values()
//│ = [5, 6]

:e
fun extraAuxiliaryList() = new Auxiliary(5)(6)()
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.143: 	fun extraAuxiliaryList() = new Auxiliary(5)(6)()
//│ ║         	                           ^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class 'Auxiliary' expected at most 2 argument lists, but got 3
//│ ║  l.132: 	class Auxiliary {
//│ ║         	^^^^^^^^^^^^^^^
//│ ╟── The constructor is declared here.
//│ ║  l.133: 	  constructor(val first)
//│ ║         	  ^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.134: 	  constructor(val second)
//│ ╙──       	^^^^^^^^^^^^^^^^^^^^^^^^^


// Refinements forward their written arguments to the parent constructor.
:expect [7, 8]
(new Pair(7)(8) with {}).values()
//│ = [7, 8]

