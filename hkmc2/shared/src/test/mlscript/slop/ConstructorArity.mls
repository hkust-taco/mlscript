// Foreign constructors use their declared parameter lists. Their optional slots
// preserve undefined so native defaults run before any values reach MLscript code.
:expect ["NaN", "NaN", "NaN"]
val NativeNumber = Number.class
[String(new Number()), String(new Number(unsafe.undefined)), String(new NativeNumber())]
//│ = ["NaN", "NaN", "NaN"]
//│ NativeNumber = class Number

:noInline
:expect ["NaN", "NaN", "NaN", "NaN"]
:w
val makeNumber = new Number
val makeNativeNumber = new NativeNumber
[String(makeNumber()), String(makeNumber(unsafe.undefined)),
 String(makeNativeNumber()), String(makeNativeNumber(unsafe.undefined))]
//│ ╔══[WARNING] This 'new' expression partially applies class 'Number' instead of constructing an instance.
//│ ║  l.+1: 	val makeNumber = new Number
//│ ║        	                 ^^^^^^^^^^
//│ ╟── Use `new Number()` to construct an instance, or `=> new Number()` to create an explicit zero-argument lambda.
//│ ╟── The constructor accepts an empty argument list.
//│ ║  in ../decls/Prelude.mls
//│ ║  l.XX: 	  constructor(value?)
//│ ╙──      	              ^^^^^^
//│ ╔══[WARNING] This 'new' expression partially applies class 'Number' instead of constructing an instance.
//│ ║  l.+2: 	val makeNativeNumber = new NativeNumber
//│ ║        	                       ^^^^^^^^^^^^^^^^
//│ ╟── Use `new NativeNumber()` to construct an instance, or `=> new NativeNumber()` to create an explicit zero-argument lambda.
//│ ╟── The constructor accepts an empty argument list.
//│ ║  in ../decls/Prelude.mls
//│ ║  l.XX: 	  constructor(value?)
//│ ╙──      	              ^^^^^^
//│ = ["NaN", "NaN", "NaN", "NaN"]
//│ makeNativeNumber = fun
//│ makeNumber = fun

:expect "message"
new Error("message").message
//│ = "message"

:expect ["", "message", "message"]
[new Error().message, new Error("message", {}).message, new TypeError("message").message]
//│ = ["", "message", "message"]

:e
fun extraErrorArgument() = new Error("message", {}, 3)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	fun extraErrorArgument() = new Error("message", {}, 3)
//│ ║        	                           ^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Constructor of class 'Error' expected 0 to 2 arguments, but got 3
//│ ║  in ../decls/Prelude.mls
//│ ║  l.XX: 	declare class Error {
//│ ║        	^^^^^^^^^^^^^^^^^^^
//│ ╟── The constructor is declared here.
//│ ║  l.XX: 	  constructor(message?, options?)
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

// Foreign classes without a constructor list do not accept arbitrary arguments.
declare class NoConstructor

:e
fun undeclaredConstructor() = new NoConstructor(1)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	fun undeclaredConstructor() = new NoConstructor(1)
//│ ║        	                              ^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class value expected 0 arguments, but got 1
//│ ║  l.XX: 	declare class NoConstructor
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^

// Written foreign constructor parameter lists are still checked.
declare class String with
  constructor(value: Str)
  val length: Int

:expect 5
new String("hello").length
//│ = 5

:e
fun extraForeignArgument() = new String("hello", "world")
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	fun extraForeignArgument() = new String("hello", "world")
//│ ║        	                             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Constructor of class 'String' expected 1 argument, but got 2
//│ ║  l.XX: 	declare class String with
//│ ║        	^^^^^^^^^^^^^^^^^^^^
//│ ╟── The constructor is declared here.
//│ ║  l.XX: 	  constructor(value: Str)
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^

:e
fun extraForeignList() = new String("hello")()
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	fun extraForeignList() = new String("hello")()
//│ ║        	                         ^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class 'String' expected at most 1 argument list, but got 2
//│ ║  l.XX: 	declare class String with
//│ ║        	^^^^^^^^^^^^^^^^^^^^
//│ ╟── The constructor is declared here.
//│ ║  l.XX: 	  constructor(value: Str)
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^


// Obvious constructor arity mistakes are also errors in lenient resolution.
#lang(strictResolution: false, eagerResolution: false)

:e
fun LooseStack[A](...xs: Array[A]) = new LooseStack(1,2,3)
class LooseStack[out A]
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	fun LooseStack[A](...xs: Array[A]) = new LooseStack(1,2,3)
//│ ║        	                                     ^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class value expected 0 arguments, but got 3
//│ ║  l.+2: 	class LooseStack[out A]
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^
