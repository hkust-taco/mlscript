// Foreign classes without a constructor list do not accept arbitrary arguments.
declare class NoConstructor

:e
fun undeclaredConstructor() = new NoConstructor(1)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.247: 	fun undeclaredConstructor() = new NoConstructor(1)
//│ ║         	                              ^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class value expected 0 arguments, but got 1
//│ ║  l.244: 	declare class NoConstructor
//│ ╙──       	^^^^^^^^^^^^^^^^^^^^^^^^^^^

// Written foreign constructor parameter lists are still checked.
declare class String with
  constructor(value: Str)
  val length: Int

:expect 5
new String("hello").length
//│ = 5

:e
fun extraForeignArgument() = new String("hello", "world")
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.265: 	fun extraForeignArgument() = new String("hello", "world")
//│ ║         	                             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Constructor of class 'String' expected 1 argument, but got 2
//│ ║  l.256: 	declare class String with
//│ ║         	^^^^^^^^^^^^^^^^^^^^
//│ ╟── The constructor is declared here.
//│ ║  l.257: 	  constructor(value: Str)
//│ ╙──       	  ^^^^^^^^^^^^^^^^^^^^^^^

:e
