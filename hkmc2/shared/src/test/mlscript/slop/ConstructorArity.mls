// Foreign constructors use their declared parameter lists. Their optional slots
// preserve undefined so native defaults run before any values reach MLscript code.
:expect ["NaN", "NaN", "NaN"]
val NativeNumber = Number.class
[String(new Number()), String(new Number(unsafe.undefined)), String(new NativeNumber())]
//│ = ["NaN", "NaN", "NaN"]
//│ NativeNumber = class Number

:noInline
:expect ["NaN", "NaN", "NaN", "NaN"]
:w
val makeNumber = new Number
val makeNativeNumber = new NativeNumber
[String(makeNumber()), String(makeNumber(unsafe.undefined)),
 String(makeNativeNumber()), String(makeNativeNumber(unsafe.undefined))]
//│ ╔══[WARNING] This 'new' expression partially applies class 'Number' instead of constructing an instance.
//│ ║  l.198: 	val makeNumber = new Number
//│ ║         	                 ^^^^^^^^^^
//│ ╟── Use `new Number()` to construct an instance, or `=> new Number()` to create an explicit zero-argument lambda.
//│ ╟── The constructor accepts an empty argument list.
//│ ║  in ../decls/Prelude.mls
//│ ║  l.32: 	  constructor(value?)
//│ ╙──      	              ^^^^^^
//│ ╔══[WARNING] This 'new' expression partially applies class 'Number' instead of constructing an instance.
//│ ║  l.199: 	val makeNativeNumber = new NativeNumber
//│ ║         	                       ^^^^^^^^^^^^^^^^
//│ ╟── Use `new NativeNumber()` to construct an instance, or `=> new NativeNumber()` to create an explicit zero-argument lambda.
//│ ╟── The constructor accepts an empty argument list.
//│ ║  in ../decls/Prelude.mls
//│ ║  l.32: 	  constructor(value?)
//│ ╙──      	              ^^^^^^
//│ = ["NaN", "NaN", "NaN", "NaN"]
//│ makeNativeNumber = fun
//│ makeNumber = fun

:expect "message"
new Error("message").message
//│ = "message"

:expect ["", "message", "message"]
[new Error().message, new Error("message", {}).message, new TypeError("message").message]
//│ = ["", "message", "message"]

