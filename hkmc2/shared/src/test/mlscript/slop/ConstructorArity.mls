:.


// `new` checks the class constructor, independently of a function companion.
:e
fun Stack[A](...xs: Array[A]) = new Stack(1,2,3)
class Stack[out A]
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	fun Stack[A](...xs: Array[A]) = new Stack(1,2,3)
//│ ║        	                                ^^^^^^^^^^^^^^^^
//│ ╟── Class value expected 0 arguments, but got 3
//│ ║  l.+2: 	class Stack[out A]
//│ ╙──      	^^^^^^^^^^^^^^^^^


class Empty {
  fun answer() = 42
}

:expect [42, 42]
[(new Empty).answer(), new Empty().answer()]
//│ = [42, 42]

:e
fun extraArgument() = new Empty(1)
