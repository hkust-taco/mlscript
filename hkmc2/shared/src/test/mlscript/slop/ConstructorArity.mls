// Spreads use the same tuple arity checking as ordinary function applications.
:e
fun nonemptySpread() = new Empty(...[1, 2])
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.44: 	fun nonemptySpread() = new Empty(...[1, 2])
//│ ║        	                       ^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class value expected 0 arguments, but got 2
//│ ║  l.16: 	class Empty {
//│ ╙──      	^^^^^^^^^^^

:expect 42
new Empty(...[]).answer()
//│ = 42

// An unknown spread length is accepted unless known elements exceed the arity.
fun uncertainSpread(xs: Array[Int]) = new Empty(...xs)

:expect 42
uncertainSpread([]).answer()
//│ = 42

:e
fun knownExtraWithSpread(xs: Array[Int]) = new Empty(1, ...xs)
