class Pair(val first)(val second) {
  fun values() = [first, second]
}

// Partial construction remains callable until all parameter lists are supplied.
:expect [1, 2]
val partial = new Pair(1)
partial(2).values()
//│ = [1, 2]
//│ partial = fun

:expect [3, 4]
new Pair(3)(4).values()
//│ = [3, 4]

:e
fun tooManyLists() = new Pair(1)(2)(3)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.113: 	fun tooManyLists() = new Pair(1)(2)(3)
//│ ║         	                     ^^^^^^^^^^^^^^^^^
//│ ╟── Class 'Pair' expected at most 2 argument lists, but got 3
//│ ║  l.97: 	class Pair(val first)(val second) {
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

:e
