// Obvious constructor arity mistakes are also errors in lenient resolution.
#lang(strictResolution: false, eagerResolution: false)

:e
fun LooseStack[A](...xs: Array[A]) = new LooseStack(1,2,3)
class LooseStack[out A]
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
