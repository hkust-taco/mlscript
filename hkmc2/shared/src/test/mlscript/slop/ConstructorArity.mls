// Spreads use the same tuple arity checking as ordinary function applications.
:e
fun nonemptySpread() = new Empty(...[1, 2])
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	fun nonemptySpread() = new Empty(...[1, 2])
//│ ║        	                       ^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class value expected 0 arguments, but got 2
//│ ║  l.XX: 	class Empty {
//│ ╙──      	^^^^^^^^^^^

:expect 42
new Empty(...[]).answer()
//│ = 42

// An unknown spread length is accepted unless known elements exceed the arity.
fun uncertainSpread(xs: Array[Int]) = new Empty(...xs)

:expect 42
uncertainSpread([]).answer()
//│ = 42

:e
fun knownExtraWithSpread(xs: Array[Int]) = new Empty(1, ...xs)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	fun knownExtraWithSpread(xs: Array[Int]) = new Empty(1, ...xs)
//│ ║        	                                           ^^^^^^^^^^^^^^^^^^^
//│ ╟── Class value expected 0 arguments, but got at least 1
//│ ║  l.XX: 	class Empty {
//│ ╙──      	^^^^^^^^^^^


// Qualified and aliased classes must retain their constructor's arity.
module Classes { class Empty }
val Alias = Classes.Empty
//│ Alias = class Empty

:e
fun qualified() = new Classes.Empty(1)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	fun qualified() = new Classes.Empty(1)
//│ ║        	                  ^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class value expected 0 arguments, but got 1
//│ ║  l.XX: 	module Classes { class Empty }
//│ ╙──      	                 ^^^^^^^^^^^

:e
fun aliased() = new Alias(1)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	fun aliased() = new Alias(1)
//│ ║        	                ^^^^^^^^^^^^
//│ ╟── Class value expected 0 arguments, but got 1
//│ ║  l.XX: 	module Classes { class Empty }
//│ ╙──      	                 ^^^^^^^^^^^


class Pair(val first)(val second) {
  fun values() = [first, second]
}

// Partial construction remains callable until all parameter lists are supplied.
:expect [1, 2]
val partial = new Pair(1)
partial(2).values()
//│ = [1, 2]
//│ partial = fun

:expect [3, 4]
new Pair(3)(4).values()
//│ = [3, 4]

:e
fun tooManyLists() = new Pair(1)(2)(3)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	fun tooManyLists() = new Pair(1)(2)(3)
//│ ║        	                     ^^^^^^^^^^^^^^^^^
//│ ╟── Class 'Pair' expected at most 2 argument lists, but got 3
//│ ║  l.XX: 	class Pair(val first)(val second) {
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

:e
fun tooManyArguments() = new Pair(1, 2)(3)
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	fun tooManyArguments() = new Pair(1, 2)(3)
//│ ║        	                         ^^^^^^^^^^^^^^^^^
//│ ╟── Constructor of class 'Pair' expected 1 argument, but got 2
//│ ║  l.XX: 	class Pair(val first)(val second) {
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^


// Auxiliary constructor lists count even when absent from the class header.
class Auxiliary {
  constructor(val first)
  constructor(val second)
  fun values() = [first, second]
}

:expect [5, 6]
new Auxiliary(5)(6).values()
//│ = [5, 6]

:e
fun extraAuxiliaryList() = new Auxiliary(5)(6)()
//│ ╔══[COMPILATION ERROR] Resolution error in object instantiation
//│ ║  l.+1: 	fun extraAuxiliaryList() = new Auxiliary(5)(6)()
//│ ║        	                           ^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class 'Auxiliary' expected at most 2 argument lists, but got 3
//│ ║  l.XX: 	class Auxiliary {
//│ ║        	^^^^^^^^^^^^^^^
//│ ╟── The constructor is declared here.
//│ ║  l.XX: 	  constructor(val first)
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.XX: 	  constructor(val second)
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^


// Refinements forward their written arguments to the parent constructor.
:expect [7, 8]
(new Pair(7)(8) with {}).values()
//│ = [7, 8]

:e
