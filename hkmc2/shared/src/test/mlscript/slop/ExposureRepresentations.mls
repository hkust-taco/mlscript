//│ ╟── Parameter 'value' admits values of unknown shape.
//│ ║  l.+1: 	private fun callback(value) = value
//│ ║        	                     ^^^^^
//│ ╟── This value is stored in this tuple.
//│ ║  l.+3: 	val callbacks = [callback]
//│ ║        	                ^^^^^^^^^^
//│ ╟── 'callbacks' is exposed by this compilation unit.
//│ ║  l.+3: 	val callbacks = [callback]
