data class MutableInputBox(value: Int)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @data
//│ define MutableInputBox⁰ as class MutableInputBox² {
//│   val value⁰;
//│   constructor MutableInputBox¹(value) { define value⁰ as val value¹ = value; end }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// The value crossing the extracted match boundary is already initialized. Its
// update must remain a reassignment, unlike the initialization of pattern slots.
:expect 41
@annotations.noInline
fun updateInitialized(n: Int) =
  let current = n
  let box = MutableInputBox(1)
  if box is MutableInputBox(value) then
    set current = current + value
    current
updateInitialized(40)
