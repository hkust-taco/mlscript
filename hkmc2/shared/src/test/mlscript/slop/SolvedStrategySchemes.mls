:.
:js
:noInline
:lift
:deforest

data class SchemeBox(value: Int)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<


// The boxes stay inside their callees. Their fusion metadata and local slot
// types must survive both instantiation steps, even though only Ints escape.
:checkIR
:soir
:siret
:expect 41
private fun localField(n: Int): Int =
  let box = SchemeBox(n)
  box.value
private fun localMatch(n: Int): Int =
  let box = SchemeBox(n)
  if box is SchemeBox(value) then value else 0
private fun nested(n: Int): Int = localField(n) + localMatch(n + 1)
nested(20)
//│ deforest > >>> fusing >>>
