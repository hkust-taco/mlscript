// Recursive members share one solved scheme graph, while separate references
// to that group still get independent instantiations.
:checkIR
:expect 42
private fun evenBox(n: Int): SchemeBox =
  if n == 0 then SchemeBox(21) else oddBox(n - 1)
private fun oddBox(n: Int): SchemeBox = evenBox(n)
let fromMatch = if oddBox(1) is SchemeBox(value) then value else 0
evenBox(2).value + fromMatch
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = 42
//│ fromMatch = 21


// Bounds crossing into a shared top-level value must remain connected when
// several function schemes are instantiated in different contexts.
:checkIR
:expect [40, 20]
val sharedSchemeBox = SchemeBox(20)
private fun sharedField(): Int = sharedSchemeBox.value
private fun sharedMatch(): Int =
  if sharedSchemeBox is SchemeBox(value) then value else 0
private fun sumShared(): Int = sharedField() + sharedMatch()
[sumShared(), sharedField()]
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = [40, 20]
//│ sharedSchemeBox = SchemeBox(20)


// A higher-order call is instantiated with both a pure and an effectful
// callback. The effectful callback must still run exactly once.
:checkIR
:expect [20, 21, 1]
let calls = 0
private fun applyCallback(callback, value: Int) = callback(value)
private fun pureCallback(value: Int): Int = value
private fun effectfulCallback(value: Int): Int =
  set calls += 1
  value + 1
let first = applyCallback(pureCallback, 20)
let second = applyCallback(effectfulCallback, 20)
[first, second, calls]
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = [20, 21, 1]
//│ calls = 1
//│ first = 20
//│ second = 21
