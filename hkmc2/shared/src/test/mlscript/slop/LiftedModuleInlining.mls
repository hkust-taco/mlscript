:.
:js


// Import under an alias so the worksheet cannot mask an escaped module receiver
// with a global binding having the same name as the compiled module's class.
import "../../mlscript-compile/ModuleReceiverCapture.mls" as Captures

// The lifted recursive worker captures Nested. Inlining read into it must also
// preserve read's reference to the enclosing ModuleReceiverCapture.
:expect 41
Captures.Nested.run(3)
//│ = 41

:expect 42
set Captures.value = 42
Captures.Nested.run(3)
//│ = 42

// The import alias is immutable, even though fields of the imported module may change.
:e
set Captures = Captures
//│ ╔══[COMPILATION ERROR] Cannot assign to symbol 'Captures'
//│ ║  l.+1: 	set Captures = Captures
//│ ║        	    ^^^^^^^^^^^^^^^^^^^
//│ ╟── Defined here:
//│ ║  l.XX: 	import "../../mlscript-compile/ModuleReceiverCapture.mls" as Captures
//│ ╙──      	                                                             ^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// An imported alias must also preserve the enclosing receiver when calling read directly.
:soir
:expect 42
Captures.Nested.read()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ return Captures⁰.value⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42
