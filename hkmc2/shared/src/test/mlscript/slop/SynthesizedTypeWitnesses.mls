// Transporting equal input-only views through the same alias must not reuse
// the first parameter's diagnostic location for the second parameter.
type Items[A] = Array[A]

:e
fun inputs(first: Items[in Int], second: Items[in Int]) =
  [(() => first)().[0].missing, (() => second)().[0].missing]
