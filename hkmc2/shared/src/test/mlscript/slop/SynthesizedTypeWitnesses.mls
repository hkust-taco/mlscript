:.
#lang(eagerResolution: true)

type Left[A] = A
module Left with
  val Pick = 1
type Right[A] = A
module Right with
  val Pick = 2

// Repeated variance interpretation must keep equal underlying types' different
// alias namespaces, including when the order of the calls is reversed.
class Box[out A](val value: A)
fun left(box: Box[Left[Int]]) = box.value
fun right(box: Box[Right[Int]]) = box.value

:expect [1, 2, 2, 1]
[left(Box(Pick)), right(Box(Pick)), right(Box(Pick)), left(Box(Pick))]
//│ = [1, 2, 2, 1]

// These annotations have equal canonical formulas. Their observations must
// retain both their own written witnesses and their reversed operand order.
:e
fun use[A, B](first: Left[A] | Right[B], second: Right[B] | Left[A]) = ()
use(Pick, Pick)
