#config(language: Language(typeCheck: TypeChecking()))
//│ Type: undefined

declare fun (+): (Int, Int) -> Int
//│ Type: undefined

fun ib: Int | Bool
fun si: Str | Int
fun sib: Str | Int | Bool
fun rev: Str -> Str
fun neg: Bool -> Bool
//│ Type: undefined

fun f(x) = if x is
  Int then 0
  Bool then x
f
//│ Type: [outer] -> ('x) ->{out 'eff} out 'res

f(ib) as (Int | Bool)
//│ Type: Int ∨ Bool

f(f(ib)) as (Int | Bool)
//│ Type: Int ∨ Bool

// FIXME
f(f(ib))
//│ Type: 'app
//│ Where:
//│   0 <: 'app

// FIXME
// :e
f(si)
//│ Type: 'app
//│ Where:
//│   0 <: 'app


// order-dependent (expected)

fun f(x, y) = if
  x is Int then 1
  y is Str then ""
f(1, "")
//│ Type: 'app
//│ Where:
//│   1 <: 'app

f(1, sib)
//│ Type: 'app
//│ Where:
//│   1 <: 'app

fun f(x, y) = if
  y is Str then ""
  x is Int then 1
f(1, "")
//│ Type: 'app
//│ Where:
//│   "" <: 'app

f(1, sib)
//│ Type: 'app
//│ Where:
//│   "" <: 'app
//│   1 <: 'app

