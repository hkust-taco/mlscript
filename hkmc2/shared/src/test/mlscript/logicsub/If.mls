#config(language: Language(typeCheck: TypeChecking()))
//│ Type: undefined

declare fun (+): (Int, Int) -> Int
//│ Type: undefined

fun ib: Int | Bool
fun si: Str | Int
fun sib: Str | Int | Bool
fun rev: Str -> Str
fun neg: Bool -> Bool
//│ Type: undefined

fun f(x) = if x is
  Int then 0
  Bool then x
f
//│ Type: [outer, 'x, 'eff, 'res] -> ('x) ->{out 'eff} out 'res
//│ Where:
//│   'x <: Int ∨ ('x ∧ ¬Int <: Bool ∨ (⊤ <: ⊥))
//│   'x <: Int ∨ ('x ∧ ¬Int <: ¬Bool ∨ (⊥ <: 'eff))
//│   'x <: Int ∨ ('x ∧ ¬Int <: ¬Bool ∨ (('x ∧ ¬Int) ∧ Bool <: 'res))
//│   'x <: ¬Int ∨ (⊥ <: 'eff)
//│   'x <: ¬Int ∨ (0 <: 'res)

f(ib) as (Int | Bool)
//│ Type: Int ∨ Bool

f(f(ib)) as (Int | Bool)
//│ Type: Int ∨ Bool

f(f(ib))
//│ Type: 'app
//│ Where:
//│   0 <: 'app
//│   Bool ∧ ¬Int <: 'app

:e
f(si)
//│ ╔══[COMPILATION ERROR] Type error in application
//│ ║  l.+1: 	f(si)
//│ ║        	^^^^^
//│ ╟── because: cannot constrain  ('x) ->{out 'eff} out 'res  <:  (Str ∨ Int) ->{out 'eff1} out 'app
//│ ╟── because: cannot constrain  Array & {0: Str ∨ Int}  <:  Array & {0: 'x}
//│ ╟── because: cannot constrain  Str ∨ Int  <:  'x
//│ ╟── because: cannot constrain  Str  <:  'x
//│ ╟── because: cannot constrain  Str  <:  Int
//│ ╟── because: cannot constrain  ¬Int ∧ 'x  <:  Bool
//│ ╟── because: cannot constrain  'x  <:  Int ∨ Bool
//│ ╟── because: cannot constrain  Str  <:  Int ∨ Bool
//│ ╙── because: cannot constrain  ⊤  <:  ⊥
//│ Type: 'app
//│ Where:
//│   0 <: 'app


// order-dependent (expected)

fun f(x, y) = if
  x is Int then 1
  y is Str then ""
f(1, "")
//│ Type: 'app
//│ Where:
//│   1 <: 'app

f(1, sib)
//│ Type: 'app
//│ Where:
//│   1 <: 'app

fun f(x, y) = if
  y is Str then ""
  x is Int then 1
f(1, "")
//│ Type: 'app
//│ Where:
//│   "" <: 'app

f(1, sib)
//│ Type: 'app
//│ Where:
//│   "" <: 'app
//│   1 <: 'app

fun foorec(x, y, r) = if
  x is Int and y is Int then x + y
  x is Str then neg(y)
  y is Str then r(y, x, r)
//│ Type: undefined

fun foo(x, y) = foorec(x, y, foorec)
//│ Type: undefined

foo(true, "")
//│ Type: 'app
//│ Where:
//│   Bool <: 'app

foo(1, 2)
//│ Type: 'app
//│ Where:
//│   Int <: 'app

foo as (Int, Int) -> Int
//│ Type: (Int, Int) ->{⊥} Int

foo as (Str, Bool) -> Bool
//│ Type: (Str, Bool) ->{⊥} Bool

(x => foo(x, true)) as Str -> Bool
//│ Type: (Str) ->{⊥} Bool

(x => foo(x, "")) as Bool -> Bool
//│ Type: (Bool) ->{⊥} Bool

:e
foo(1, "")
//│ ╔══[COMPILATION ERROR] Type error in application
//│ ║  l.+1: 	foo(1, "")
//│ ║        	^^^^^^^^^^
//│ ╟── because: cannot constrain  ('x, 'y) ->{out 'eff} out 'app  <:  (1, "") ->{out 'eff1} out 'app1
//│ ╟── because: cannot constrain  Array & {0: 1, 1: ""}  <:  Array & {0: 'x, 1: 'y}
//│ ╟── because: cannot constrain  ""  <:  'y
//│ ╟── because: cannot constrain  ""  <:  'y1
//│ ╟── because: cannot constrain  ""  <:  Int
//│ ╟── because: cannot constrain  Int ∧ 'x1  <:  Str
//│ ╟── because: cannot constrain  'x1  <:  ¬Int ∨ Str
//│ ╟── because: cannot constrain  1  <:  ¬Int ∨ Str
//│ ╟── because: cannot constrain  ¬Int ∧ 'y1  <:  ¬Str
//│ ╟── because: cannot constrain  'y1  <:  ¬Str ∨ Int
//│ ╟── because: cannot constrain  ""  <:  ¬Str ∨ Int
//│ ╟── because: cannot constrain  'r  <:  (('y1 ∧ ¬Int) ∧ Str, ('x1 ∧ Int) ∧ ¬Str, 'r) ->{out 'eff2} out 'app2
//│ ╟── because: cannot constrain  ('x2, 'y2, 'r1) ->{out 'eff3} out 'res  <:  (('y1 ∧ ¬Int) ∧ Str, ('x1 ∧ Int) ∧ ¬Str, 'r) ->{out 'eff2} out 'app2
//│ ╟── because: cannot constrain  Array & {0: ('y1 ∧ ¬Int) ∧ Str, 1: ('x1 ∧ Int) ∧ ¬Str, 2: 'r}  <:  Array & {0: 'x2, 1: 'y2, 2: 'r1}
//│ ╟── because: cannot constrain  (Int ∧ ¬Str) ∧ 'x1  <:  'y2
//│ ╟── because: cannot constrain  'x1  <:  (¬Int ∨ Str) ∨ 'y2
//│ ╟── because: cannot constrain  1  <:  (¬Int ∨ Str) ∨ 'y2
//│ ╟── because: cannot constrain  1 ∧ ¬Str  <:  'y2
//│ ╙── because: cannot constrain  1 ∧ ¬Str  <:  Bool
//│ Type: 'app1
//│ Where:
//│   Bool <: 'app1

fun increv(x) = if x is
  Int then x + 1
  else
    rev(x)
increv
//│ Type: [outer, 'x, 'eff, 'res] -> ('x) ->{out 'eff} out 'res
//│ Where:
//│   'x <: Int ∨ (⊥ <: 'eff)
//│   'x <: Int ∨ (Str <: 'res)
//│   'x <: Int ∨ ('x ∧ ¬Int <: Str)
//│   'x <: ¬Int ∨ (⊥ <: 'eff)
//│   'x <: ¬Int ∨ (Int <: 'res)
//│   'x <: ¬Int ∨ (1 <: Int)
//│   'x <: ¬Int ∨ ('x ∧ Int <: Int)

fun increv'(x) = if x is
  Int then x + 1
  Str then rev(x)
increv'
//│ Type: [outer, 'x, 'eff, 'res] -> ('x) ->{out 'eff} out 'res
//│ Where:
//│   'x <: Int ∨ ('x ∧ ¬Int <: Str ∨ (⊤ <: ⊥))
//│   'x <: Int ∨ ('x ∧ ¬Int <: ¬Str ∨ (⊥ <: 'eff))
//│   'x <: Int ∨ ('x ∧ ¬Int <: ¬Str ∨ (Str <: 'res))
//│   'x <: Int ∨ ('x ∧ ¬Int <: ¬Str ∨ (('x ∧ ¬Int) ∧ Str <: Str))
//│   'x <: ¬Int ∨ (⊥ <: 'eff)
//│   'x <: ¬Int ∨ (Int <: 'res)
//│   'x <: ¬Int ∨ (1 <: Int)
//│   'x <: ¬Int ∨ ('x ∧ Int <: Int)

increv(si)
//│ Type: 'app
//│ Where:
//│   Str <: 'app
//│   Int <: 'app

:e
increv(sib)
