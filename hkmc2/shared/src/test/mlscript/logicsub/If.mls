fun f(x, y) = if
  x is Int then y
  y is Str then 1
  x is Str then y + 1
  else
    neg(x)
f
//│ Type: [outer, 'x, 'y, 'eff, 'res] -> ('x, 'y) ->{out 'eff} out 'res
//│ Where:
//│   'x <: Int ∨ ('y <: Str ∨ ('x ∧ ¬Int <: Str ∨ (⊥ <: 'eff)))
//│   'x <: Int ∨ ('y <: Str ∨ ('x ∧ ¬Int <: Str ∨ (Bool <: 'res)))
//│   'x <: Int ∨ ('y <: Str ∨ ('x ∧ ¬Int <: Str ∨ (('x ∧ ¬Int) ∧ ¬Str <: Bool)))
//│   'x <: Int ∨ ('y <: Str ∨ ('x ∧ ¬Int <: ¬Str ∨ (⊥ <: 'eff)))
//│   'x <: Int ∨ ('y <: Str ∨ ('x ∧ ¬Int <: ¬Str ∨ (Int <: 'res)))
//│   'x <: Int ∨ ('y <: Str ∨ ('x ∧ ¬Int <: ¬Str ∨ (1 <: Int)))
//│   'x <: Int ∨ ('y <: Str ∨ ('x ∧ ¬Int <: ¬Str ∨ ('y ∧ ¬Str <: Int)))
//│   'x <: Int ∨ ('y <: ¬Str ∨ (⊥ <: 'eff))
//│   'x <: Int ∨ ('y <: ¬Str ∨ (1 <: 'res))
//│   'x <: ¬Int ∨ (⊥ <: 'eff)
//│   'x <: ¬Int ∨ ('y <: 'res)

f(ib, sib)
