fun increv(x) = if x is
  Int then x + 1
  else
    rev(x)
increv
//│ Type: [outer] -> ('x) ->{out 'eff} out 'res

fun increv'(x) = if x is
  Int then x + 1
  Str then rev(x)
increv'
//│ Type: [outer] -> ('x) ->{out 'eff} out 'res

