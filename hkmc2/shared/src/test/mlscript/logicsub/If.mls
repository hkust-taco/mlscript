// order dependent

fun f(x, y) = if
  x is Int then 1
  y is Str then ""
f(1, "")
//│ Type: Int

fun f(x, y) = if
  y is Str then ""
  x is Int then 1
f(1, "")
//│ Type: Str

f(1, sib)
//│ Type: Int ∨ Str


fun foorec(x, y, r) = if
  x is Int and y is Int then x + y
  x is Str then not(y)
  y is Str then r(y, x, r)
//│ Type: ⊤

fun foo(x, y) = foorec(x, y, foorec)
//│ Type: ⊤

foo(true, "")
foo(1, 2)
foo as (Int, Int) -> Int
foo as (Str, Bool) -> Bool
(x => foo(x, true)) as Str -> Bool
(x => foo(x, "")) as Bool -> Bool
//│ Type: (Bool) ->{⊥} Bool

