fun increv(x) = if x is
  Int then x + 1
  else
    rev(x)
increv
//│ Type: ['x, 'res, 'eff, 'x1] -> 'x ->{'eff} 'res
//│ Where:
//│   'x#Int ∨  ∧ Int ∧ 'x<:Int ∧ Int<:Int ∧ Int<:'res ∧ ⊥<:'eff
//│   'x#¬Int ∨  ∧ ¬Int ∧ 'x<:'x1 ∧ 'x1<:Str ∧ Str<:'res ∧ ⊥<:'eff

fun increv'(x) = if x is
  Int then x + 1
  Str then rev(x)
increv'
//│ Type: ['x, 'res, 'eff, 'x1] -> 'x ->{'eff} 'res
//│ Where:
//│   'x#Int ∨  ∧ Int ∧ 'x<:Int ∧ Int<:Int ∧ Int<:'res ∧ ⊥<:'eff
//│   'x#¬Int ∨ (  'x1#Str ∨  ∧ Str ∧ 'x1<:Str ∧ Str<:'res ∧ ⊥<:'eff) ∧ (  'x1#¬(Int ∨ Str) ∨  ∧ (¬Int ∧ ¬Str) ∧ 'x1<:'x1 ∧ ⊤<:⊥) ∧ ¬Int ∧ 'x<:'x1

