fun f(x, y) = if
  x is Int and y is Int then 1
  x is Bool then y
//│ Type: undefined

x => if x is
  true then 0
  false then 0
//│ Type: ('x) ->{'eff} 'res
//│ Where:
//│   'x <: true ∨ ('x ∧ ¬true <: false ∨ (⊤ <: ⊥))
//│   'x <: true ∨ ('x ∧ ¬true <: ¬false ∨ (⊥ <: 'eff))
//│   'x <: true ∨ ('x ∧ ¬true <: ¬false ∨ (0 <: 'res))
//│   'x <: ¬true ∨ (⊥ <: 'eff)
//│   'x <: ¬true ∨ (0 <: 'res)

// The solver does not recognize that the two singleton types cover Bool.
:fixme
(x => if x is
  true then 0
  false then 0) as Bool -> 0
//│ ╔══[COMPILATION ERROR] Type error in `if` expression with expected type 0
//│ ║  l.+1: 	(x => if x is
//│ ║        	         ^^^^
//│ ║  l.+2: 	  true then 0
//│ ║        	^^^^^^^^^^^^^
//│ ║  l.+3: 	  false then 0) as Bool -> 0
//│ ║        	^^^^^^^^^^^^^^
//│ ╟── because: cannot constrain  Bool  <:  true
//│ ╟── because: cannot constrain  Bool ∧ ¬true  <:  false
//│ ╙── because: cannot constrain  ⊤  <:  ⊥
//│ Type: (Bool) ->{⊥} 0

fun f(x) = if
  x is Int then x + 2
  x is Str then rev(x)
  else
    neg(x)
