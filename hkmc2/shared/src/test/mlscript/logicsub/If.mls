fun f(x) = if
  x is Int then x + 2
  x is Str then rev(x)
  else
    neg(x)
f
//│ Type: [outer] -> ('x) ->{out 'eff} out 'res

fun x:Int
x
//│ Type: Int

f(x)
//│ Type: 'app
//│ Where:
//│   Bool <: 'app

// f(sib)

fun f(x, y) = if
  x is Int then y
  y is Str then 1
  x is Str then y + 1
  else
    neg(x)
f
//│ Type: [outer] -> ('x, 'y) ->{out 'eff} out 'res

f(ib, sib)
//│ Type: 'app
//│ Where:
//│   Bool <: 'app

