fun throughSame(x, y) = if
  x is Int and y is Str then 3
  x is Str and y is Int then 4
  else same{as {((Int, Int) -> 1) & ((Str, Str) -> 2)}}(x, y)

throughSame as ((Int | Str, Int | Str) -> Int)
//│ Type: (Int | Str, Int | Str) -> Int

throughSame(10, 20)
//│ Type: 1

throughSame("a", "b")
//│ Type: 2

throughSame(10, "b")
//│ Type: 3

throughSame("a", 20)
//│ Type: 4

(x, y) => throughSame(x, y)
//│ Type: ('x, 'y) ->{'eff} 'res
//│ Where:
//│   'x <: Int | Str ∨
