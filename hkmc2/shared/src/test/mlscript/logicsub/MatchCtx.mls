fun same(x, y) = if
  x is Int and y is Int then 1
  x is Str and y is Str then 2
//│ Type: undefined

fun throughSame(x, y) = if
  x is Int and y is Str then 0
  x is Str and y is Int then 0
  else same(x, y)
//│ Type: undefined

