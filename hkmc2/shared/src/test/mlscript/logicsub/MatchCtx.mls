//│       'y <: Int ∨ ⊤ <: 'reach
//│       'y <: ¬Int ∨ 4 <: 'res
//│   'x <: ¬Int ∨
//│       'y <: Str ∨ ⊤ <: 'reach
//│       'y <: ¬Str ∨ 3 <: 'res

(x) => throughSame(x, x)
//│ Type: ('x) ->{'eff} 'res
//│ Where:
//│   'x <: Int ∨ 'x <: ¬Str ∨ ((Int, Int) -> 1) & ((Str, Str) -> 2) <: ('x & Str, 'x & ¬Int) ->{'eff1} 'app
