//│       'y1 <: Int
//│       'y1 <: ¬Int ∨ 1 <: 'res2
//│   'x <: ¬Str ∨
//│       ⊤ <: 'reach
//│       'x <: ¬Int ∨ 4 <: 'res
//│   'x <: ¬Int ∨
//│       ⊤ <: 'reach
//│       'x <: ¬Str ∨ 3 <: 'res
//│   'x <: Str ∨ 'x <: ¬Int ∨ ((Int, Int) -> 1) & ((Str, Str) -> 2) <: ('x & Int, 'x & ¬Str) ->{'eff1} 'app


fun throughSame(x, y) = if
  x is Int and y is Str then 3
  x is Str and y is Int then 4
  x is Int and y is Int then same(x, y)
  x is Str and y is Str then same(x, y)

throughSame as ((Int | Str, Int | Str) -> Int)
//│ Type: (Int | Str, Int | Str) -> Int

throughSame(10, 20)
//│ Type: 1

throughSame("a", "b")
//│ Type: 2

throughSame(10, "b")
//│ Type: 3

throughSame("a", 20)
//│ Type: 4

(x, y) => throughSame(x, y)
//│ Type: ('x, 'y) ->{'eff} 'res
//│ Where:
//│   'x <: Int | Str
//│   'x <: ¬Str ∨
//│       'y <: Int | Str
//│       'y <: ¬Str ∨
//│           'eff1 <: 'eff
//│           'app <: 'res
//│           ('x1, 'y1) -> 'res1 <: ('x & Str, 'y & Str) ->{'eff1} 'app
//│       'y <: ¬Int ∨ 4 <: 'res
//│   'x <: ¬Int ∨
//│       'y <: Str | Int
//│       'y <: ¬Int ∨
//│           'eff2 <: 'eff
//│           'app1 <: 'res
//│           ('x2, 'y2) -> 'res2 <: ('x & Int, 'y & Int) ->{'eff2} 'app1
//│       'y <: ¬Str ∨ 3 <: 'res
//│   'x1 <: Int | Str
//│   'x1 <: ¬Str ∨
//│       'y1 <: Str
//│       'y1 <: ¬Str ∨ 2 <: 'res1
//│   'x1 <: ¬Int ∨
//│       'y1 <: Int
//│       'y1 <: ¬Int ∨ 1 <: 'res1
//│   'x2 <: Int | Str
//│   'x2 <: ¬Str ∨
//│       'y2 <: Str
//│       'y2 <: ¬Str ∨ 2 <: 'res2
//│   'x2 <: ¬Int ∨
//│       'y2 <: Int
//│       'y2 <: ¬Int ∨ 1 <: 'res2

(x) => throughSame(x, x)
//│ Type: ('x) ->{'eff} 'res
//│ Where:
//│   'x <: Int | Str
//│   'x <: ¬Str ∨
//│       'eff1 <: 'eff
//│       'app <: 'res
//│       ('x1, 'y) -> 'res1 <: ('x & Str, 'x & Str) ->{'eff1} 'app
//│       'x <: ¬Int ∨ 4 <: 'res
//│   'x1 <: Int | Str
//│   'x1 <: ¬Str ∨
