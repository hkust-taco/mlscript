:.

// Each conjunction can fail on either scrutinee. All sixteen paths reach
// the same else expression, which contributes one result bound.
fun probe(x0, y0, x1, y1, x2, y2, x3, y3) = if
  x0 is Int and y0 is Str then 0
  x1 is Int and y1 is Str then 1
  x2 is Int and y2 is Str then 2
  x3 is Int and y3 is Str then 3
  else "miss"
probe
//│ Type: ['x0, 'reach, 'reach1, 'reach2, 'reach3, 'res, 'x3, 'y3, 'x2, 'y2, 'x1, 'y1, 'y0] -> ('x0, 'y0, 'x1, 'y1, 'x2, 'y2, 'x3, 'y3) -> 'res
//│ Where:
//│   'x0 <: Int ∨ ⊤ <: 'reach
//│   'reach <: ⊥ ∨
//│       'reach1 <: ⊥ ∨
//│           'reach2 <: ⊥ ∨
//│               'reach3 <: ⊥ ∨ "miss" <: 'res
//│               'x3 <: ¬Int ∨ 'y3 <: ¬Str ∨ 3 <: 'res
//│           'x2 <: ¬Int ∨ 'y2 <: ¬Str ∨ 2 <: 'res
//│       'x1 <: ¬Int ∨ 'y1 <: ¬Str ∨ 1 <: 'res
//│   'x3 <: Int ∨ ⊤ <: 'reach3
//│   'x3 <: ¬Int ∨ 'y3 <: Str ∨ ⊤ <: 'reach3
//│   'x2 <: Int ∨ ⊤ <: 'reach2
//│   'x2 <: ¬Int ∨ 'y2 <: Str ∨ ⊤ <: 'reach2
//│   'x1 <: Int ∨ ⊤ <: 'reach1
//│   'x1 <: ¬Int ∨ 'y1 <: Str ∨ ⊤ <: 'reach1
//│   'x0 <: ¬Int ∨
//│       'y0 <: Str ∨ ⊤ <: 'reach
//│       'y0 <: ¬Str ∨ 0 <: 'res

probe(0, 0, "", "", 2, "hit", 3, "later")
//│ Type: 2

probe("", "", 1, 1, "", "", 3, 3)
//│ Type: "miss"

// The first arm consumes the singleton part of the second arm's Int guard.
fun literal(x, y) = if
  x is 1 and y is Str then 0
  x is Int and y is Str then (if x is 1 then "unreachable" else 1)
  else 2

literal as ((Int, Str) -> Int)
//│ Type: (Int, Str) -> Int

literal(1, "")
//│ Type: 0

// When z is Int, missing the first inner arm forces x to be Int.
// The outer miss then forces y to be Str, so the final arm covers the input.
fun nestedJoin(x, y, z) = if
  x is Int and y is Int then 0
  else if
    x is Str and z is Int then 1
    y is Str then 2

nestedJoin as ((Int | Str, Int | Str, Int) -> Int)
//│ Type: (Int | Str, Int | Str, Int) -> Int

// The arguments to f must come from the same surviving pair.
fun callDiagonal(f, x, y) = if
  x is Int and y is Str then 0
  x is Str and y is Int then 0
  else f(x, y)

callDiagonal as ((((Int, Int) -> Int) & ((Str, Str) -> Int), Int | Str, Int | Str) -> Int)
//│ Type: (((Int, Int) -> Int) & ((Str, Str) -> Int), Int | Str, Int | Str) -> Int

