fun same(x, y) = if
  x is Int and y is Int then 1
  x is Str and y is Str then 2
//│ Type: undefined


fun throughSame(x, y) = if
  x is Int and y is Str then 3
  x is Str and y is Int then 4
  else same(x, y)
//│ Type: undefined

