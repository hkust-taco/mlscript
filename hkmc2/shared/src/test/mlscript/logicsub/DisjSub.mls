if 0 is
  Bool then ""
  Int then true
  Str then 0
//│ Type: Bool

fun not: Bool -> Bool
//│ Type: ⊤

fun foorec(x, y, r) = if
  x is Int and y is Int then x + y
  x is Str then not(y)
  y is Str then r(y, x, r)
//│ Type: ⊤

fun foo(x, y) = foorec(x, y, foorec)
//│ Type: ⊤

foo(true, "")
//│ Type: Bool

foo(1, 2)
//│ Type: Int

foo as (Int, Int) -> Int
//│ Type: (Int, Int) ->{⊥} Int

foo as (Str, Bool) -> Bool
//│ Type: (Str, Bool) ->{⊥} Bool

(x => foo(x, true)) as Str -> Bool
//│ Type: (Str) ->{⊥} Bool

(x => foo(x, "")) as Bool -> Bool
//│ Type: (Bool) ->{⊥} Bool

