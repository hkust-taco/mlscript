declare fun (&&): (Bool, Bool) -> Bool
declare fun (+): (Int, Int) -> Int



fun andt(x) = x && true
fun k(f: Nothing -> Bool) = 1
fun ap(f) = x => f(x)

k(andt)
//│ Type: 1

k(ap(andt))
//│ Type: 1

