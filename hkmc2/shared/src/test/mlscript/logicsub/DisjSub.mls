//│ Type: (Int) ->{⊥} Int

(x: Bool) =>
  idIB(x)
//│ Type: (Bool) ->{⊥} Bool

(x: Bool) =>
  idIB(idIB(x))
//│ Type: (Bool) ->{⊥} Bool

