//│ Type: ['x, 'res, 'eff, 'eff1] -> 'x ->{'eff} 'res
//│ Where:
//│   'x#Int ∨  ∧ ⊥<:'eff ∧ Int ∧ 'x<:Int ∧ Int<:Int ∧ Int<:'res
//│   'x#¬Int ∨  ∧ ⊥<:'eff1 ∧ 'x<:Str ∧ Str<:'res

fun increv'(x) = if x is
  Int then x + 1
  Str then rev(x)
