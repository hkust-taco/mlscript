//│ Type: ⊤

k("", if true then 1 else true)
//│ Type: Bool ∨ Int

fun k: ((Int, Int) -> Int) & ((Bool, Bool) -> Bool)
//│ Type: ⊤

x => k(x, x)
//│ Type: ('x) ->{'eff} 'app
//│ Where:
//│   'x#'x ∨ (  'x#Int ∨  ∧ Int<:'app ∧ ⊥<:'eff) ∧ (  'x#Bool ∨  ∧ Bool<:'app ∧ ⊥<:'eff) ∧ {0: 'x, 1: 'x}<:{0: Int, 1: Int} ∨ {0: Bool, 1: Bool}
