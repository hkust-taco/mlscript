fun idIB: (Int -> Int) & (Bool -> Bool)

idIB(1)
//│ Type: Int

idIB(true)
//│ Type: Bool

idIB(if true then 1 else true)
//│ Type: Int

x =>
  let y = x+1
  idIB(x)
//│ Type: ('x) ->{'eff} 'app
//│ Where:
//│   'x >:< Int => (Int) -> Int <: Function[in Array & {0: Int} & Array & {0: 'x}, out 'app, out 'eff]
//│   'x <: Int

(x: Int) =>
  let y = x + 1
  idIB(x)
//│ Type: (Int) -> Int

(x: Bool) =>
  idIB(x)
//│ Type: (Bool) -> Bool

(x: Bool) =>
  idIB(idIB(x))
//│ Type: (Bool) -> Bool

fun ap1(f)=f(1)
ap1(idIB)
//│ Type: Int

ap(idIB)(1)
//│ Type: Int

x => idIB(x)
//│ Type: ('x) ->{'eff} 'app
//│ Where:
//│   'x >:< Int => (Int) -> Int <: Function[in Array & {0: Int} & Array & {0: 'x}, out 'app, out 'eff]
//│   'x >:< Bool => (Bool) -> Bool <: Function[in Array & {0: Bool} & Array & {0: 'x}, out 'app, out 'eff]
//│   'x <: Int | Bool

fun forward(x) = idIB(x)
forward
//│ Type: ['x, 'app, 'eff] -> ('x) ->{'eff} 'app
