  a: f(x)
  b: f(y)
k
//│ Type: ['x, 'y, 'eff, 'app, 'eff1, 'app1] -> (('y ->{'eff1} 'app1) ∧ ('x ->{'eff} 'app)) -> (('x, 'y) ->{'eff ∨ 'eff1} {a: 'app, b: 'app1})

