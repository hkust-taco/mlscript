//│   'x >:< Int => (Int) -> Int <: Function[in Array & {0: Int} & Array & {0: 'x}, out 'app, out 'eff]
//│   'x >:< Bool => (Bool) -> Bool <: Function[in Array & {0: Bool} & Array & {0: 'x}, out 'app, out 'eff]
