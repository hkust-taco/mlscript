k("", if true then 1 else true)
//│ Type: Int

fun k: ((Int, Int) -> Int) & ((Bool, Bool) -> Bool)

x => k(x, x)
//│ Type: ('x) ->{'eff} 'app
//│ Where:
//│   'x >:< Int => Int & 'x <: ⊥ ∨ (Int, Int) -> Int <: Function[in Array & {0: Int, 1: Int} & Array & {0: 'x, 1: 'x}, out 'app, out 'eff]
//│   'x >:< Bool => Bool & 'x <: ⊥ ∨ (Bool, Bool) -> Bool <: Function[in Array & {0: Bool, 1: Bool} & Array & {0: 'x, 1: 'x}, out 'app, out 'eff]
//│   'x <: Int ∨ 'x <: Bool
//│   'x <: Int | Bool

// Recursive functions and higher-rank ascription from the BbML worksheets.
fun f(x) = f(x.a)

f => (let g = x => f(x(x)) in g) as [A] -> A -> A
//│ Type: (⊤) -> [outer, 'A] -> ('A) -> 'A
