//│ ╟── because: cannot constrain  ((Bool) -> Bool) & ((Int) -> Int)  <:  ('A) -> 'B
//│ ╟── because: cannot constrain  Array & {0: 'A}  <:  Array & {0: Bool} | Array & {0: Int}
//│ ╟── because: cannot constrain  'A  <:  Int | Bool
//│ ╟── because: cannot constrain  'A  <:  Int | Bool
//│ ╙── because: cannot constrain  Ls['A1]  <:  Int | Bool
//│ Type: Ls['B]
//│ Where:
//│   Int <: 'B
//│   Bool <: 'B

