data class Ls[A](prim: [R] -> (() -> R, (A, Ls[A]) -> R) -> R)
fun nil() = new Ls((n, _) => n())
fun cons(x, y) = new Ls((n, r) => r(x, y))
//│ Type: ⊤

fun map: [A, B, E] -> Ls[out A] -> (A -> B) -> Ls[out B]
//│ Type: ⊤

fun map: [A, B, E] -> Ls[A] -> (A -> B) -> Ls[B]
fun map = x => f => x.Ls#prim(() => nil(), (a, b) => cons(f(a), map(b)(f)))
//│ Type: ⊤

// fun map = x => f => new Ls((n, r) => x.Ls#prim(n, (a, b) => r(f(a), map(b)(f))))

x => map(x)(idIB)
//│ Type: (Ls['A]) ->{⊥} Ls['B]
//│ Where:
//│   'A#'A ∨ (  'A#Int ∨  ∧ Int<:'B ∧ ⊥<:⊥) ∧ (  'A#Bool ∨  ∧ Bool<:'B ∧ ⊥<:⊥) ∧ {0: 'A}<:{0: Int} ∨ {0: Bool}

map(nil())(idIB)
//│ Type: Ls['B]

map(nil())(idIB) as Ls[Str]
//│ Type: Ls[Str]

map(cons(1, nil()))(idIB)
//│ Type: Ls['B]
//│ Where:
//│   Int <: 'B

map(cons(1, cons(true, nil())))(idIB)
//│ Type: Ls['B]
//│ Where:
//│   Bool <: 'B
//│   Int <: 'B

