class
  Nil()
  Cons[A, B](val hd : A, val tl: B)
//│ Type: undefined

fun all2(x) = if x is
  Nil then tru
  Cons then both(x.Cons#hd, all2(x.Cons#tl))
//│ Type: undefined

let nil = new Nil()
fun cons(x,y) = new Cons(x,y)
//│ Type: undefined

all2(nil)
//│ Type: 'app
//│   >: ⊥

all2(cons(tru, nil))
//│ Type: 'app
//│   >: ⊥

all2(cons(tru, cons(tru, nil)))
//│ Type: 'app
//│   >: ⊥

all2(cons(tru, cons(fls, nil)))
//│ Type: 'app
//│   >: ⊥

fun test: Tru -> Tru
fun test(x) = all2(cons(tru, cons(x, nil)))
//│ Type: undefined

fun test: Fls -> Tru | Fls
fun test(x) = all2(cons(tru, cons(x, nil)))
//│ Type: undefined

fun foldLeft(xs, y, f) = if xs is
  Nil then y
  Cons then foldLeft(xs.Cons#tl, f(y,xs.Cons#hd), f)
//│ Type: undefined

fun all3(xs) = foldLeft(xs, tru, both)
//│ Type: undefined

all3 as Nil -> Tru
//│ Type: (Nil) ->{⊥} Tru

// FIXME
// all3 as Cons[Tru,Nil] -> Tru
// all3 as Cons[Tru|Fls,Nil] -> Tru | Fls

fun test: (Tru -> Tru) & (Fls -> Tru | Fls)
fun test(x) = all3(cons(tru, cons(x, nil)))
//│ Type: undefined



class
  None()
  Some[A](val x: A)
//│ Type: undefined

let none = new None()
//│ Type: undefined

fun headOption(x) = if x is
  Nil then none
  Cons then new Some(x.Cons#hd)
//│ Type: undefined

headOption
//│ Type: [outer] -> ['x] ->{out 'eff} out 'res
