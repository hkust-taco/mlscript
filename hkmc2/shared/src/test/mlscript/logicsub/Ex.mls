class
  Tru()
  Fls()
//│ Type: undefined

let
  tru = new Tru()
  fls = new Fls()
//│ Type: undefined

fun negImpl(x) = if x is
  Tru then fls
  Fls then tru
negImpl
//│ Type: [outer] -> ['x] ->{out 'eff} out 'res

fun negate: (Tru -> Fls) & (Fls -> Tru)
fun negate(x) = negImpl(x)
//│ Type: undefined

fun bothImpl(x,y) = if
  x is Tru and y is Tru then tru
  x is Tru and y is Fls then fls
  x is Fls and y is Tru then fls
  x is Fls and y is Fls then fls
//│ Type: undefined

fun both: ((Tru, Tru) -> Tru) & ((Tru, Fls) -> Fls) & ((Fls, Tru | Fls) -> Fls)
fun both(x, y) = bothImpl(x,y)
//│ Type: undefined


class Ls[A]()
//│ Type: undefined

fun foldLeft: [A,B] -> (Ls[A], B, (B, A) -> B) -> B
//│ Type: undefined

