declare class Str(length: Int, concat: Str -> Str)
declare fun (+): (Int, Int) -> Int

fun addImpl(x, y) = if x is
  Int then x + y
  Str then x.Str#concat(y)

fun add: ((Int,Int) -> Int) & ((Str,Str) -> Str)
fun add(x,y) = addImpl(x,y)

add(1, 2)
//│ Type: Int

// add("a", "b")

fun test(a,b,c,d) = add(a,add(b,add(c,d)))

test(0, 1, 2, 3)
//│ Type: Int

// test("A", "B", "C", "D")

// Expected type errors:
// test(0, 1, "oops", 3)

fun selfAdd1(x) = add(x, x)

fun intstr: Int | Str

// Expected type errors:
// selfAdd1(intstr)

fun selfAdd2(x) = if x is
  Int then add(x, x)
  Str then add(x, x)

// FIXME
// selfAdd2(intstr)

fun selfAdd3: (Int -> Int) & (Str -> Str)
fun selfAdd3(x) = selfAdd1(x)
selfAdd3(intstr)
//│ Type: Int | Str

// fun selfAdd4:  (Int | Str) -> (Int | Str)
// fun selfAdd4(x) = selfAdd1(x)

fun selfAdd5: (Int | Str) -> (Int | Str)
fun selfAdd5(x) = selfAdd3(x)

fun cast : ((Int -> Int) & (Str -> Str)) -> (Int | Str) -> (Int | Str)
fun cast(f) = f

