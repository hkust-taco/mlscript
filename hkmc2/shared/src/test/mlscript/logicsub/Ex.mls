#config(language: Language(typeCheck: TypeChecking()))
//│ Type: undefined

declare class Str(length: Int, concat: Str -> Str)
declare fun (+): (Int, Int) -> Int
//│ Type: undefined

fun addImpl(x, y) = if x is
  Int then x + y
  Str then x.Str#concat(y)
//│ Type: undefined

fun add: ((Int,Int) -> Int) & ((Str,Str) -> Str)
fun add(x,y) = addImpl(x,y)
//│ Type: undefined

// FIXME
add(1, 2)
//│ Type: 'app
//│   >: ⊥

