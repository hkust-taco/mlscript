// test(0, 1, "oops", 3)

fun selfAdd1(x) = add(x, x)
//│ Type: undefined

fun intstr: Int | Str
//│ Type: undefined

// Expected type errors:
// selfAdd1(intstr)

fun selfAdd2(x) = if x is
  Int then add(x, x)
  Str then add(x, x)
//│ Type: undefined

// FIXME
// selfAdd2(intstr)

fun selfAdd3: (Int -> Int) & (Str -> Str)
fun selfAdd3(x) = selfAdd1(x)
selfAdd3(intstr)
//│ Type: 'app
//│   >: Int ∨ Str

// fun selfAdd4:  (Int | Str) -> (Int | Str)
// fun selfAdd4(x) = selfAdd1(x)

fun selfAdd5: (Int | Str) -> (Int | Str)
fun selfAdd5(x) = selfAdd3(x)
//│ Type: undefined

fun cast : ((Int -> Int) & (Str -> Str)) -> (Int | Str) -> (Int | Str)
fun cast(f) = f
