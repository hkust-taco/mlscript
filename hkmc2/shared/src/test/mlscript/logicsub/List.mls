//│ ╟── because: cannot constrain  'app  <:  'xs
//│ ╟── because: cannot constrain  Cons['A, 'Tl]  <:  'xs
//│ ╟── because: cannot constrain  Cons['A, 'Tl]  <:  ¬Cons[?, ?]
//│ ╟── because: cannot constrain  Cons[?, ?] & 'xs  <:  Cons[?, out 'Tl1]
//│ ╟── because: cannot constrain  'xs  <:  ¬Cons[?, ?] | Cons[?, out 'Tl1]
//│ ╟── because: cannot constrain  Cons['A, 'Tl]  <:  ¬Cons[?, ?] | Cons[?, out 'Tl1]
//│ ╟── because: cannot constrain  'Tl  <:  'Tl1
//│ ╟── because: cannot constrain  2  <:  'Tl1
//│ ╟── because: cannot constrain  2  <:  'xs
//│ ╙── because: cannot constrain  2  <:  Nil | Cons[?, ?]
//│ Type: Cons['A1, 'Tl2]
//│ Where:
//│   1 <: 'A1
//│   Cons['A1, 'Tl2] <: 'Tl2

cons(1, cons("", nil)) map(x => cons(x, true))
//│ Type: Cons['A, 'Tl] | Nil
//│ Where:
//│   Cons['A1, 'Tl1] <: 'A
//│   "" <: 'A1
//│   1 <: 'A1
//│   true <: 'Tl1
//│   Nil <: 'Tl
//│   Cons['A, 'Tl] <: 'Tl


fun maprec(xs, f, r) =
  if xs is
    Nil then nil
    Cons then new Cons(f(xs.Cons#hd), r(xs.Cons#tl, f, r))
fun map(xs, f) = maprec(xs, f, maprec)
//│ Type: undefined


