//│   Cons['A3, 'Tl3] <: 'Tl3

cons(1, cons("", nil)) map(x => cons(x, true))
//│ Type: 'app
//│ Where:
//│   Cons['A, 'Tl1] <: 'app
//│   Cons['A1, 'Tl] <: 'A
//│   "" <: 'A1
//│   1 <: 'A1
//│   true <: 'Tl
//│   Nil <: 'Tl1
//│   Cons['A, 'Tl1] <: 'Tl1
//│   Nil <: 'app


fun maprec(xs, f, r) =
  if xs is
    Nil then nil
    Cons then new Cons(f(xs.Cons#hd), r(xs.Cons#tl, f, r))
fun map(xs, f) = maprec(xs, f, maprec)
//│ Type: undefined


nil map(x => x)
//│ Type: 'app
//│ Where:
//│   Nil <: 'app

