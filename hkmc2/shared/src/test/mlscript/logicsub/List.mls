:.
//│ Type: undefined

class
  Nil()
  Cons[A, Tl](val hd: A, val tl: Tl)
//│ Type: undefined

let nil = new Nil()
//│ Type: undefined

let cons(hd, tl) = new Cons(hd, tl)
//│ Type: undefined

cons(0, 0)
//│ Type: Cons['A, 'Tl]
//│ Where:
//│   0 <: 'A
//│   0 <: 'Tl

cons
//│ Type: ('A, 'Tl) ->{⊥} Cons['A, 'Tl]
//│ Where:
//│   0 <: 'A
//│   0 <: 'Tl

fun cons(hd, tl) = new Cons(hd, tl)
//│ Type: undefined

fun map(xs, f) =
  if xs is
    Nil then nil
    Cons then new Cons(f(xs.Cons#hd), map(xs.Cons#tl, f))
//│ Type: undefined

nil map(x => x)
//│ Type: Nil

let c = cons(1, nil)
c map(x => x)
//│ Type: Cons['A, 'Tl] | Nil
//│ Where:
//│   1 <: 'A
//│   Nil <: 'Tl
//│   Cons['A, 'Tl] <: 'Tl

:e
cons(1, 2) map(x => x)
