fun negate: (Int -> Int) & ((Tru | Fls) -> (Tru | Fls))
fun negate(x) = if x is
  Int then 0 - x
  Tru then neg(x)
  Fls then neg(x)

fun subtract: (Int, Int) -> Int
fun subtract(a, b) = if
  a is Int and b is Int then a + negate(b)

