// using direct type test instead of predicate functions

fun example14_(input, extra) = if
  input is Int and extra.fst is Int then input + extra.fst
  extra.fst is Int then input strlen() + extra.fst
  else new Z()
//│ Type: ⊤

example14_ as (Int | Str, [fst: ~Int, snd: Any]) -> Z
example14_ as (Int | Str, [fst: Int, snd: Any]) -> Int
example14_ as (~(Int | Str), [fst: ~Int, snd: Any]) -> Z
//│ Type: (¬Int & ¬Str, {fst: ¬Int, snd: ⊤}) ->{⊥} Z

