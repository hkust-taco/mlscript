data class Prod[A, B](val fst: A, val snd: B)
//│ Type: ⊤

class
  Tru()
  Fls()
  Z()
//│ Type: ⊤

let tru = new Tru()
let fls = new Fls()
//│ Type: ⊤

fun prod(p, q) = new Prod(p, q)
//│ Type: ⊤

fun y: Any -> Tru | Fls
//│ Type: ⊤

prod(y(x => x), y(x => x)) as Prod[Tru, Tru] | Prod[Fls, Fls]
//│ Type: Prod[Tru, Tru] | Prod[Fls, Fls]

:e
{ fst: y(x => x), snd: y(x => x) } as [ fst: Tru, snd: Tru ] | [ fst: Fls, snd: Fls ]
