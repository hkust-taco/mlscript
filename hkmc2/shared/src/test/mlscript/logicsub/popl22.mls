fun detailed_ex(a: (Int -> (Int | Bool)) | Prod[Int, Int | Bool], n: Int) = if
  a is Prod and a.Prod#fst is Int and a.Prod#snd is Int then a.Prod#fst == a.Prod#snd
  a is Prod then a.Prod#snd
  let x = a(n)
  x is Int then x < 42
  else x
//│ Type: ⊤

detailed_ex as ((Int -> Int | Bool) | Prod[Int, Int | Bool], Int) -> Int | Bool
