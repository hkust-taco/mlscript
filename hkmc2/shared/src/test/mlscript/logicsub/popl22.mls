fun is_int(x) =
  if x is Int then tru else fls

is_int as Int -> Tru
//│ Type: (Int) -> Tru

is_int as ~Int -> Fls
//│ Type: (¬Int) -> Fls

fun is_bool(x) = if x is
  Tru then tru
  Fls then tru
  else fls

is_bool as (Tru | Fls) -> Tru
//│ Type: (Tru | Fls) -> Tru

is_bool as ~(Tru | Fls) -> Fls
//│ Type: (¬Tru & ¬Fls) -> Fls

// Originally, the paper defines False, empty string "" and zero 0 as Falsy
// and ~Falsy as Truthy
// Here Fls and Z are treated as falsy, and otherwise truthy

fun not_(x) = if x is
  Fls then tru
  Z then tru
  else fls

not_ as (Fls | Z) -> Tru
//│ Type: (Fls | Z) -> Tru

not_ as ~(Fls | Z) -> Fls
//│ Type: (¬Fls & ¬Z) -> Fls

fun to_bool(x) = x not_() not_()

to_bool as (Fls | Z) -> Fls
//│ Type: (Fls | Z) -> Fls

to_bool as ~(Fls | Z) -> Tru
//│ Type: (¬Fls & ¬Z) -> Tru

fun and_(x, y) = if x is
  Fls then fls
  Z then fls
  else to_bool(y)

and_ as (Fls | Z, Any) -> Fls
//│ Type: (Fls | Z, ⊤) -> Fls

and_ as (~(Fls | Z), ~(Fls | Z)) -> Tru
//│ Type: (¬Fls & ¬Z, ¬Fls & ¬Z) -> Tru

and_ as (~(Fls | Z), Fls | Z) -> Fls
//│ Type: (¬Fls & ¬Z, Fls | Z) -> Fls


fun or_(x, y) = not_(x) and_(not_(y)) not_()

or_ as (~(Fls | Z), Any) -> Tru
//│ Type: (¬Fls & ¬Z, ⊤) -> Tru

or_ as (Fls | Z, ~(Fls | Z)) -> Tru
//│ Type: (Fls | Z, ¬Fls & ¬Z) -> Tru

or_ as (Fls | Z, Fls | Z) -> Fls
//│ Type: (Fls | Z, Fls | Z) -> Fls

