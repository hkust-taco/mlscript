fun a: (Int -> (Int | Bool)) | Prod[Int, Int | Bool]
fun n: Int

// type test `a(n) is Int` does not refine a and n, and thus a(n)

fun f(a, n) = if
  a is Prod and
    a.Prod#fst is Int and a.Prod#snd is Int then a.Prod#fst == a.Prod#snd
    else a.Prod#snd
  a(n) is Int then a(n) < 42
  else a(n)

// while a(n) is Int, in the then branch, a(n) still has type Int | Bool

:e
f(a, n)
//│ ╔══[COMPILATION ERROR] Type error in application
//│ ║  l.+1: 	f(a, n)
//│ ║        	^^^^^^^
//│ ╟── because: cannot constrain  ('a, 'n) ->{'eff} 'res  <:  (((Int) -> Int | Bool) | Prod[Int, Int | Bool], Int) ->{'eff1} 'app
//│ ╟── because: cannot constrain  Array & {0: ((Int) -> Int | Bool) | Prod[Int, Int | Bool], 1: Int}  <:  Array & {0: 'a, 1: 'n}
//│ ╟── because: cannot constrain  ((Int) -> Int | Bool) | Prod[Int, Int | Bool]  <:  'a
//│ ╟── because: cannot constrain  (Int) -> Int | Bool  <:  'a
//│ ╟── because: cannot constrain  (Int) -> Int | Bool  <:  Prod[?, ?]
//│ ╟── because: cannot constrain  ⊤  <:  ⊥
//│ ╟── because: cannot constrain  'a  <:  (('n) ->{'eff2} 'app1) | Prod[?, ?]
//│ ╟── because: cannot constrain  'a  <:  Prod[?, ?] | (('n) ->{'eff2} 'app1)
//│ ╟── because: cannot constrain  (Int) -> Int | Bool  <:  Prod[?, ?] | (('n) ->{'eff2} 'app1)
//│ ╟── because: cannot constrain  Int | Bool  <:  'app1
//│ ╟── because: cannot constrain  Int  <:  'app1
//│ ╟── because: cannot constrain  Int  <:  ¬Int
//│ ╟── because: cannot constrain  'app2  <:  Int
//│ ╙── because: cannot constrain  Bool  <:  Int
//│ Type: Bool | Int

// the following rewrite refines x

fun f(a, n) = if
  a is Prod and
    a.Prod#fst is Int and a.Prod#snd is Int then a.Prod#fst == a.Prod#snd
    else a.Prod#snd
  let x = a(n)
  x is Int then x < 42
  else x

