:bbml
//│ Type: ⊤
:js

//│ Type: ⊤


// * Sec. 9 of A Practical Subtyping System For Erlang
// * (https://homepages.inf.ed.ac.uk/wadler/papers/erlang/erlang.pdf)


class
  Tru()
  Fls()
//│ Type: ⊤

let
  tru = new Tru()
  fls = new Fls()
//│ fls = Fls()
//│ tru = Tru()
//│ Type: ⊤

// :ucs desugared
:ucs normalized
fun test(x, y) = if
  x is Tru and y is Tru then tru
  x is Fls then fls
  y is Fls then fls
test
//│ Normalized:
//│ >  if
//│ >    x is Tru and
//│ >      y is Tru then tru#666
//│ >      y is Fls then fls#666
//│ >    x is Fls then fls#666
//│ >    y is Fls then fls#666
//│ = [function test]
//│ Type: ['x, 'y, 'eff, 'cons, 'scrut, 'scrut1, 'eff1, 'eff2, 'cons1, 'eff3, 'cons2] -> ('x, 'y) ->{('eff ∨ 'eff2) ∨ 'eff3} (('cons ∨ 'cons1) ∨ 'cons2)
//│ Where:
//│   'x <: (¬Fls ∨ Fls) ∨ Tru
//│   'x <: ¬Tru ∨ Tru
//│   'x#Tru ∨ (  'scrut#Tru ∨  ∧ ⊥<:'eff ∧ Tru<:'cons) ∧ 'eff<:'eff1 ∧ 'y<:(Tru ∧ 'scrut) ∨ (¬Tru ∧ 'scrut1)
//│   'x#Fls ∨  ∧ ⊥<:'eff2 ∧ Fls<:'cons1
//│   'y <: ¬Fls ∨ Fls
//│   'y#Fls ∨  ∧ ⊥<:'eff3 ∧ Fls<:'cons2

test(tru, tru)
//│ = Tru()
//│ Type: Tru

test(tru, fls)
//│ = Fls()
//│ Type: Fls

test(fls, tru)
//│ = Fls()
//│ Type: Fls

test(fls, fls)
//│ = Fls()
//│ Type: Fls

test("hi", fls)
//│ = Fls()
//│ Type: Fls


:todo
:e
test(true, false)
//│ ═══[RUNTIME ERROR] Error: match error
//│ Type: ⊥


