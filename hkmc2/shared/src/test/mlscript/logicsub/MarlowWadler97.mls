// * Note: this version generates a large type

fun test(x, y) = if
  x is Tru and y is Tru then tru
  x is Fls and y is Tru then fls
  y is Fls then fls
// test
//│ Type: ⊤

// * Note: and this one even larger

fun test(x, y) = if
  x is Tru and y is Tru then tru
  x is Fls and y is Tru then fls
  y is Fls then fls
  y is Fls then fls
// test
//│ Type: ⊤


