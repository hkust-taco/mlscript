//│ Type: ⊥

// TODO: IntLit as label?
"0": rcd.foo
"1": rcd.bar
//│ Type: {0: Int, 1: Str}

fun id(x) = x
//│ Type: ⊤

id of (x: 1)
//│ Type: {x: Int}

:todo
id of { x: 1 }
//│ Type: Str

id of ({ x: 1 })
//│ Type: {x: Int}

id of ({ x: 1, y: 2 })
//│ Type: {x: Int, y: Int}

id of (x: 1, y: 2)
//│ Type: {x: Int, y: Int}

