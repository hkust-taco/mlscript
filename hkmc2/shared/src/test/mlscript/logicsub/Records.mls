:bbml
//│ Type: ⊤

//│ Type: ⊤

{}
//│ Type: ⊤

let r = {}
//│ Type: ⊤

{1}
//│ Type: Int

{1, 2}
//│ Type: Int

{foo: 1}
//│ Type: {foo: Int}

let rcd = { foo: 1, bar: "..." }
//│ Type: ⊤

:todo
[rcd.foo, rcd.bar]
//│ ╔══[ERROR] Term shape not yet supported by BbML: Tup(List(Fld(‹›,Sel(Ref(rcd),Ident(foo)),None), Fld(‹›,Sel(Ref(rcd),Ident(bar)),None)))
//│ ║  l.25: 	[rcd.foo, rcd.bar]
