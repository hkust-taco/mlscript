// Class not disjoint with itself

class Pair[A, B](val a: A, val b: B)
class Tri[A, B, C](val a: A, val b: B, val c: C)
//│ Type: undefined

// :fixme The checker accepts this ill-formed type.
:breakme
:e
fun ill: (Pair[Int, Int] -> Int) & (Pair[Str, Str] -> Str)
//│ Type: undefined

fun wf: [A] -> (Pair[A, Any] -> A) & (Tri[A, Any, Any] -> A)
fun wf(x) = if x is
  Pair then x.Pair#a
  Tri then x.Tri#a
//│ Type: undefined

wf(new Pair(0, ""))
//│ Type: 0

wf(new Tri(new Pair(0, ""), 0, ""))
//│ Type: Pair['A, 'B]
//│ Where:
//│   0 <: 'A
//│   "" <: 'B

