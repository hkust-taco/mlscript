#config(language: Language(typeCheck: TypeChecking()))
//│ Type: undefined

fun f: (1 -> 1) & (("a"|"B") -> ("a"|"B"|"c"))
fun f(x) = x
//│ Type: undefined

f(1)
//│ Type: 'app
//│ Where:
//│   1 <: 'app

f("a")
//│ Type: 'app
//│ Where:
//│   "c" <: 'app
//│   "B" <: 'app
//│   "a" <: 'app

fun g: (Int -> Int) & (Str -> Str)
//│ Type: undefined

g(1)
//│ Type: 'app
//│ Where:
//│   Int <: 'app

fun g: (1 -> 1) & (2 -> 2)
//│ Type: undefined

g(1)
//│ Type: 'app
//│ Where:
//│   1 <: 'app

fun neg: (true -> false) & (false -> true)
//│ Type: undefined

// TODO literal pattern
// fun a: (false -> Int) & (true -> Str)
// fun a(x) = if neg(x) then 1 else  ""

fun ns: Int | Str
//│ Type: undefined

fun nsb: Int | Str | Bool
//│ Type: undefined

fun idt: (Int -> Int) & (Str -> Str)
//│ Type: undefined

// TODO fix the :e flag
// :e
// idt(nsb)

idt(1)
//│ Type: 'app
//│ Where:
//│   Int <: 'app

(x => idt(x))(1)
//│ Type: 'app
//│ Where:
//│   Int <: 'app


idt(1 as Int)
//│ Type: 'app
//│ Where:
//│   Int <: 'app

idt(ns)
//│ Type: 'app
//│ Where:
//│   Int <: 'app
//│   Str <: 'app

fun singletons: (1 & Int) | (Str & "s") | (false & Bool) | (true & Str)
(x => x)(singletons)
//│ Type: 'x
//│ Where:
//│   false <: 'x
//│   "s" <: 'x
//│   1 <: 'x

// FIXME
(x => if x is
  Int then 1
  Str then "")(ns)
//│ Type: 'res
//│ Where:
//│   1 <: 'res

// TODO implement exhaustiveness check
// :e
(x => if x is
  Int then 1
  Str then "")(nsb)
//│ Type: 'res
//│ Where:
//│   "" <: 'res
//│   1 <: 'res
