:js

import "../../../mlscript-compile/apps/parsing/Test.mls"

open Test { example }

example of """
:tree
let x = 0 in
while x < 10 do
  print_int x;
  print_newline ();
  x <- x + 1
done
"""
//│ > LetIn:
//│ >   bindings = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`=`, 16, 16)
//│ >       lhs = Reference of "x"
//│ >       rhs = Literal#Integer of "0"
//│ >   body = Some of While:
//│ >     condition = Application:
//│ >       callee = Reference of "<"
//│ >       argument = Stack of 
//│ >         Reference of "x"
//│ >         Literal#Integer of "10"
//│ >     body = Sequence of Stack of 
//│ >       Application:
//│ >         callee = Reference of "print_int"
//│ >         argument = Reference of "x"
//│ >       Application:
//│ >         callee = Reference of "print_newline"
//│ >         argument = Tuple of Nil
//│ >       Infix:
//│ >         op = Keyword(`<-`, 9, 9)
//│ >         lhs = Reference of "x"
//│ >         rhs = Application:
//│ >           callee = Reference of "+"
//│ >           argument = Stack of 
//│ >             Reference of "x"
//│ >             Literal#Integer of "1"
//│ > «let x = 0 in while x < 10 do print_int x; print_newline (); x <- x + 1 done»

example of """
:tree
for i = 0 to 10 do
  print i
done
"""
//│ > For:
//│ >   head = Reference of "i"
//│ >   start = Literal#Integer of "0"
//│ >   end = Literal#Integer of "10"
//│ >   body = Application:
//│ >     callee = Reference of "print"
//│ >     argument = Reference of "i"
//│ > «for i = 0 to 10 do print i done»
