//│ > symbol `+` at 2:26-2:27
//│ > space at 2:27-2:28
//│ > reference `b` at 2:28-2:29

printLexed of lines of
  "let rec factorial x = // a simple factorial function"
  "  if x <= 1 then 1 else x * factorial (x - 1)"
  ""
  "let bool_of_string = function"
  "  | \"true\" -> true"
  "  | \"false\" -> false"
  "  | _ -> raise (Invalid_argument \"bool_of_string\")"
//│ > reference `let` at 1:1-1:4
//│ > space at 1:4-1:5
//│ > reference `rec` at 1:5-1:8
//│ > space at 1:8-1:9
//│ > reference `factorial` at 1:9-1:18
