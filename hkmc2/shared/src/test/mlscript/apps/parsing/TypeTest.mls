//│ >   kind = Type
//│ >   items = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`==`, 16, 16)
//│ >       lhs = Reference of "g"
//│ >       rhs = Infix:
//│ >         op = Keyword(`->`, 5, 3)
//│ >         lhs = Infix:
//│ >           op = Keyword(`->`, 5, 3)
//│ >           lhs = Reference of "a"
//│ >           rhs = Reference of "b"
//│ >         rhs = Reference of "c"
//│ > «type f == a -> b -> c»
//│ > «type g == a -> b -> c»

