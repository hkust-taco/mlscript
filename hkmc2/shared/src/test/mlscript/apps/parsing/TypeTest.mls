//│ >         op = Keyword(`->`, 5, 3)
//│ >         lhs = Reference of "a"
//│ >         rhs = Infix:
//│ >           op = Keyword(`->`, 5, 3)
//│ >           lhs = Reference of "b"
//│ >           rhs = Reference of "c"
