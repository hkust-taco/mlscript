example of """
:tree
type t = {decoration : string; substance : t'}
and t' = Int of int | List of t list
"""
//│ > Define:
//│ >   kind = Type
//│ >   items = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`=`, 16, 16)
//│ >       lhs = Reference of "t"
//│ >       rhs = Bracketed#Curly of Sequence of Stack of 
//│ >         Infix:
//│ >           op = Keyword(`:`, 4, 3)
//│ >           lhs = Reference of "decoration"
//│ >           rhs = Reference of "string"
//│ >         Infix:
//│ >           op = Keyword(`:`, 4, 3)
//│ >           lhs = Reference of "substance"
//│ >           rhs = Reference of "t'"
//│ >     Infix:
//│ >       op = Keyword(`=`, 16, 16)
//│ >       lhs = Reference of "t'"
//│ >       rhs = Infix:
//│ >         op = Keyword(`|`, 4, 4)
//│ >         lhs = Infix:
//│ >           op = Keyword(`of`, N/A, N/A)
//│ >           lhs = Reference of "Int"
//│ >           rhs = Reference of "int"
//│ >         rhs = Infix:
//│ >           op = Keyword(`of`, N/A, N/A)
//│ >           lhs = Reference of "List"
//│ >           rhs = Application:
//│ >             callee = Reference of "list"
//│ >             argument = Reference of "t"
//│ > «type t = {decoration : string; substance : t'} and t' = Int of int | List of list t»

