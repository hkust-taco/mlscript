example of """
:tree
exception E of int * string
"""
//│ > Define:
//│ >   kind = Exception
//│ >   items = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`of`, N/A, N/A)
//│ >       lhs = Reference of "E"
//│ >       rhs = Infix:
//│ >         op = Keyword(`*`, 22, 22)
//│ >         lhs = Reference of "int"
//│ >         rhs = Reference of "string"
//│ > «exception E of int * string»

example of """
type 'a bst = E | N of 'a * 'a bst * 'a bst
let rec insert x = function
  | E -> N (x, E, E)
  | N (y, l, r) ->
      if x < y then N (y, insert x l, r)
      else N (y, l, insert x r)
let rec min_elt = function
  | E -> failwith "min_elt called on empty tree"
  | N (x, E, _) -> x
  | N (_, l, _) -> min_elt l
let rec remove x = function
  | E -> E
  | N (y, l, r) ->
      if x < y then N (y, remove x l, r)
      else if x > y then N (y, l, remove x r)
      else
        match (l, r) with
        | (E, _) -> r
        | (_, E) -> l
        | _ ->
            let m = min_elt r in
            N (m, l, remove m r)
"""
//│ > «type bst ('a) = E | N of 'a * bst 'a * bst 'a»
//│ > «let rec insert x = function E -> N (x, E, E) | N (y, l, r) -> if x < y then N (y, insert x l, r) then N (y, l, insert x r)»
//│ > «let rec min_elt = function E -> failwith "min_e…" | N (x, E, _) -> x | N (_, l, _) -> min_elt l»
//│ > «let rec remove x = function E -> E | N (y, l, r) -> if x < y then N (y, remove x l, r) then if x > y then N (y, l, remove x r) then match (l, r) with (E, _) -> r | (_, E) -> l | _ -> let m = min_elt r in N (m, l, remove m r)»

