//│ >                 lhs = Application:
//│ >                   callee = Reference of ">"
//│ >                   argument = Stack of 
//│ >                     Reference of "m"
//│ >                     Reference of "n"
//│ >                 rhs = Literal#Boolean of "false"
//│ >                 body = Some of Application:
//│ >                   callee = Application:
//│ >                     callee = Reference of "belongs"
//│ >                     argument = Reference of "n"
//│ >                   argument = Reference of "rest"
//│ > Define:
//│ >   kind = Let(true)
//│ >   items = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`=`, 16, 16)
//│ >       lhs = Application:
//│ >         callee = Reference of "add"
//│ >         argument = Reference of "n"
//│ >       rhs = Match:
//│ >         scrutinee = Empty()
//│ >         branches = Stack of 
//│ >           Infix:
//│ >             op = Keyword(`->`, 5, 3)
//│ >             lhs = Bracketed#Square of Sequence of Nil
//│ >             rhs = Bracketed#Square of Reference of "n"
//│ >           Infix:
//│ >             op = Keyword(`->`, 5, 3)
//│ >             lhs = Infix:
//│ >               op = Keyword(`as`, 4, 4)
//│ >               lhs = Application:
