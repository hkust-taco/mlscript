//│ >                       lhs = Application:
//│ >                         callee = Reference of "<"
//│ >                         argument = Stack of 
//│ >                           Infix:
//│ >                             op = Keyword(`.`, 26, 26)
//│ >                             lhs = Infix:
//│ >                               op = Keyword(`.`, 26, 26)
//│ >                               lhs = Reference of "context"
//│ >                               rhs = Reference of "array"
//│ >                             rhs = Application:
//│ >                               callee = Reference of "+"
//│ >                               argument = Stack of 
//│ >                                 Reference of "i"
//│ >                                 Literal#Integer of "1"
//│ >                           Infix:
//│ >                             op = Keyword(`.`, 26, 26)
