// sources/examples/showsort/bubble.ml
// ====================================

example of """
:tree
let sort context =
  let ordered = ref true in
  let rec sweep i =
    if i + 1 >= vect_length context.array then
      if !ordered then
        Finished
      else begin
        ordered := false;
        sweep 0
      end
    else
      Pause(fun () ->
        if context.array.(i + 1) < context.array.(i) then begin
          exchange context i (i + 1);
          ordered := false
        end;
        sweep(i + 1))
  in sweep 0
;;
"""
//│ > Define:
//│ >   kind = Let(false)
//│ >   items = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`=`, 16, 16)
//│ >       lhs = Application:
//│ >         callee = Reference of "sort"
//│ >         argument = Reference of "context"
//│ >       rhs = LetIn:
//│ >         bindings = Stack of 
//│ >           Infix:
//│ >             op = Keyword(`=`, 16, 16)
//│ >             lhs = Reference of "ordered"
//│ >             rhs = Application:
//│ >               callee = Reference of "ref"
//│ >               argument = Literal#Boolean of "true"
//│ >         body = Some of LetIn:
//│ >           bindings = Stack of 
//│ >             Infix:
//│ >               op = Keyword(`=`, 16, 16)
