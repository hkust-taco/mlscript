//│ >                   name = Keyword(`if`, 10, 9)
//│ >                   lhs = Application:
//│ >                     callee = Reference of "!"
//│ >                     argument = Reference of "ordered"
//│ >                   rhs = Reference of "Finished"
//│ >                   body = Some of Sequence of Stack of 
//│ >                     Application:
//│ >                       callee = Reference of ":="
//│ >                       argument = Stack of 
//│ >                         Reference of "ordered"
//│ >                         Literal#Boolean of "false"
