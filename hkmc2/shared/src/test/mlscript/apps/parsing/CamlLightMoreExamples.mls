:js

import "../../../mlscript-compile/apps/parsing/Test.mls"

open Test { example }

// More examples ported from the official Caml Light example archive and source
// mirror. Each example uses `:tree` so the DiffTest records parser regressions
// in the full syntax tree, not only in the pretty summary.

// sources/examples/basics/fib.ml
// ==============================

example of """
:tree
let rec fib n =
  if n < 2 then 1 else fib(n-1) + fib(n-2)
;;
if sys__interactive then () else
if vect_length sys__command_line <> 2 then begin
  print_string "Usage: fib <number>";
  print_newline()
end else begin
  try
    print_int(fib(int_of_string sys__command_line.(1)));
    print_newline()
  with Failure "int_of_string" ->
    print_string "Bad integer constant";
    print_newline()
end
;;
"""
//│ > Define:
//│ >   kind = Let(true)
//│ >   items = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`=`, 16, 16)
//│ >       lhs = Application:
//│ >         callee = Reference of "fib"
//│ >         argument = Reference of "n"
//│ >       rhs = Ternary:
//│ >         name = Keyword(`if`, 10, 9)
//│ >         lhs = Application:
//│ >           callee = Reference of "<"
//│ >           argument = Stack of 
//│ >             Reference of "n"
//│ >             Literal#Integer of "2"
//│ >         rhs = Literal#Integer of "1"
//│ >         body = Some of Application:
//│ >           callee = Reference of "+"
//│ >           argument = Stack of 
//│ >             Application:
//│ >               callee = Reference of "fib"
//│ >               argument = Application:
//│ >                 callee = Reference of "-"
//│ >                 argument = Stack of 
//│ >                   Reference of "n"
//│ >                   Literal#Integer of "1"
//│ >             Application:
//│ >               callee = Reference of "fib"
//│ >               argument = Application:
//│ >                 callee = Reference of "-"
//│ >                 argument = Stack of 
//│ >                   Reference of "n"
//│ >                   Literal#Integer of "2"
//│ > Ternary:
//│ >   name = Keyword(`if`, 10, 9)
//│ >   lhs = Reference of "sys__interactive"
//│ >   rhs = Tuple of Nil
//│ >   body = Some of Ternary:
//│ >     name = Keyword(`if`, 10, 9)
//│ >     lhs = Application:
//│ >       callee = Reference of "<>"
//│ >       argument = Stack of 
//│ >         Application:
//│ >           callee = Reference of "vect_length"
//│ >           argument = Reference of "sys__command_line"
//│ >         Literal#Integer of "2"
//│ >     rhs = Sequence of Stack of 
//│ >       Application:
//│ >         callee = Reference of "print_string"
//│ >         argument = Literal#String of "Usage: fib <number>"
//│ >       Application:
//│ >         callee = Reference of "print_newline"
//│ >         argument = Tuple of Nil
//│ >     body = Some of Try:
//│ >       body = Sequence of Stack of 
//│ >         Application:
//│ >           callee = Reference of "print_int"
//│ >           argument = Application:
//│ >             callee = Reference of "fib"
//│ >             argument = Application:
//│ >               callee = Reference of "int_of_string"
//│ >               argument = Infix:
//│ >                 op = Keyword(`.`, 26, 26)
//│ >                 lhs = Reference of "sys__command_line"
//│ >                 rhs = Literal#Integer of "1"
//│ >         Application:
//│ >           callee = Reference of "print_newline"
//│ >           argument = Tuple of Nil
//│ >       branches = Stack of 
//│ >         Infix:
//│ >           op = Keyword(`->`, 5, 3)
//│ >           lhs = Application:
//│ >             callee = Reference of "Failure"
//│ >             argument = Literal#String of "int_of_string"
//│ >           rhs = Sequence of Stack of 
//│ >             Application:
//│ >               callee = Reference of "print_string"
//│ >               argument = Literal#String of "Bad integer constant"
//│ >             Application:
//│ >               callee = Reference of "print_newline"
//│ >               argument = Tuple of Nil
//│ > «let rec fib n = if n < 2 then 1 then fib (n - 1) + fib (n - 2)»
//│ > «if sys__interactive then () then if vect_length sys__command_line <> 2 then print_string "Usage…"; print_newline () then try print_int (fib (int_of_string sys__command_line . 1)); print_newline () with Failure "int_o…" -> print_string "Bad i…"; print_newline ()»

// sources/examples/basics/sieve.ml
// ================================

example of """
:tree
let rec interval min max =
  if min > max then [] else min :: interval (succ min) max
;;
let rec filter p = function
  | [] -> []
  | a :: r -> if p a then a :: filter p r else filter p r
;;
let remove_multiples_of n =
  filter (fun m -> m mod n <> 0)
;;
let sieve max =
  let rec filter_again = function
  | [] -> []
  | n :: r as l ->
      if n * n > max then l else n :: filter_again (remove_multiples_of n r)
  in
    filter_again (interval 2 max)
;;
"""
//│ > Define:
//│ >   kind = Let(true)
//│ >   items = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`=`, 16, 16)
//│ >       lhs = Application:
//│ >         callee = Application:
//│ >           callee = Reference of "interval"
//│ >           argument = Reference of "min"
//│ >         argument = Reference of "max"
//│ >       rhs = Ternary:
//│ >         name = Keyword(`if`, 10, 9)
//│ >         lhs = Application:
//│ >           callee = Reference of ">"
//│ >           argument = Stack of 
//│ >             Reference of "min"
//│ >             Reference of "max"
//│ >         rhs = Bracketed#Square of Sequence of Nil
//│ >         body = Some of Application:
//│ >           callee = Reference of "::"
//│ >           argument = Stack of 
//│ >             Reference of "min"
//│ >             Application:
//│ >               callee = Application:
//│ >                 callee = Reference of "interval"
//│ >                 argument = Application:
//│ >                   callee = Reference of "succ"
//│ >                   argument = Reference of "min"
//│ >               argument = Reference of "max"
//│ > Define:
//│ >   kind = Let(true)
//│ >   items = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`=`, 16, 16)
//│ >       lhs = Application:
//│ >         callee = Reference of "filter"
//│ >         argument = Reference of "p"
//│ >       rhs = Match:
//│ >         scrutinee = Empty()
//│ >         branches = Stack of 
//│ >           Infix:
//│ >             op = Keyword(`->`, 5, 3)
//│ >             lhs = Bracketed#Square of Sequence of Nil
//│ >             rhs = Bracketed#Square of Sequence of Nil
//│ >           Infix:
//│ >             op = Keyword(`->`, 5, 3)
//│ >             lhs = Application:
//│ >               callee = Reference of "::"
//│ >               argument = Stack of 
//│ >                 Reference of "a"
//│ >                 Reference of "r"
//│ >             rhs = Ternary:
//│ >               name = Keyword(`if`, 10, 9)
//│ >               lhs = Application:
//│ >                 callee = Reference of "p"
//│ >                 argument = Reference of "a"
//│ >               rhs = Application:
//│ >                 callee = Reference of "::"
//│ >                 argument = Stack of 
//│ >                   Reference of "a"
//│ >                   Application:
//│ >                     callee = Application:
//│ >                       callee = Reference of "filter"
//│ >                       argument = Reference of "p"
//│ >                     argument = Reference of "r"
//│ >               body = Some of Application:
//│ >                 callee = Application:
//│ >                   callee = Reference of "filter"
//│ >                   argument = Reference of "p"
//│ >                 argument = Reference of "r"
//│ > Define:
//│ >   kind = Let(false)
//│ >   items = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`=`, 16, 16)
//│ >       lhs = Application:
//│ >         callee = Reference of "remove_multiples_of"
//│ >         argument = Reference of "n"
//│ >       rhs = Application:
//│ >         callee = Reference of "filter"
