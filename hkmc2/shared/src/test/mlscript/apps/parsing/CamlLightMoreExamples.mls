// sources/examples/grep/ensent.ml
// ===============================

example of """
:tree
type t == int list;;
let empty = [];;
let rec belongs n = function
  | [] -> false
  | m :: rest ->
      if m = n then true else
        if m > n then false else belongs n rest
;;
let rec add n = function
  | [] -> [n]
  | m :: rest as set ->
      if m = n then set else
        if m > n then n :: set else m :: add n rest
;;
"""
//│ > Define:
//│ >   kind = Type
//│ >   items = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`==`, 16, 16)
//│ >       lhs = Reference of "t"
//│ >       rhs = Application:
//│ >         callee = Reference of "list"
//│ >         argument = Reference of "int"
