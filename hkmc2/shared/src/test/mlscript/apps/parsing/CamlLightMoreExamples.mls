//│ >                                 argument = Reference of "context"
//│ >                               argument = Reference of "i"
//│ >                             argument = Application:
//│ >                               callee = Reference of "+"
//│ >                               argument = Stack of 
//│ >                                 Reference of "i"
//│ >                                 Literal#Integer of "1"
//│ >                           Application:
//│ >                             callee = Reference of ":="
//│ >                             argument = Stack of 
