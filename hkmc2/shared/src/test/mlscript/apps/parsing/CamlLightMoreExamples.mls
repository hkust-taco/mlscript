//│ >       op = Keyword(`=`, 16, 16)
//│ >       lhs = Application:
//│ >         callee = Reference of "belongs"
//│ >         argument = Reference of "n"
//│ >       rhs = Match:
//│ >         scrutinee = Empty()
//│ >         branches = Stack of 
//│ >           Infix:
//│ >             op = Keyword(`->`, 5, 3)
//│ >             lhs = Bracketed#Square of Sequence of Nil
