//│ > «let rec interval min max = if min > max then [] then min :: interval (succ min) max»
//│ > «let rec filter p = function [] -> [] | a :: r -> if p a then a :: filter p r then filter p r»
//│ > «let remove_multiples_of n = filter (fun m -> (m mod n) <> 0)»
