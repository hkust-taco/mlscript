//│ >           Infix:
//│ >             op = Keyword(`->`, 5, 3)
//│ >             lhs = Application:
//│ >               callee = Reference of "::"
//│ >               argument = Stack of 
//│ >                 Reference of "m"
//│ >                 Reference of "rest"
//│ >             rhs = Ternary:
//│ >               name = Keyword(`if`, 10, 9)
//│ >               lhs = Infix:
//│ >                 op = Keyword(`=`, 16, 16)
//│ >                 lhs = Reference of "m"
//│ >                 rhs = Reference of "n"
//│ >               rhs = Literal#Boolean of "true"
//│ >               body = Some of Ternary:
