//│ >       op = Keyword(`=`, 16, 16)
//│ >       lhs = Application:
//│ >         callee = Reference of "read_value"
//│ >         argument = Tuple of Nil
//│ >       rhs = LetIn:
//│ >         bindings = Stack of 
//│ >           Infix:
//│ >             op = Keyword(`=`, 16, 16)
//│ >             lhs = Reference of "input"
//│ >             rhs = Application:
//│ >               callee = Reference of "read_line"
//│ >               argument = Tuple of Nil
//│ >         body = Some of Try:
