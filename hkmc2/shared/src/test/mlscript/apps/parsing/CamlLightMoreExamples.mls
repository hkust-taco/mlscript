let register_count = 32
and sp = 30
and ra = 31
and word_size = 4
;;
"""
//│ > Define:
//│ >   kind = Let(false)
//│ >   items = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`=`, 16, 16)
