fun example(input) =
  let tokens = lex of input, false
  print of "Tokens: " + TokenHelpers.panorama(tokens)
  let expr = parse of tokens
  print of "Parsed: " + expr.toString()
  print of "Pretty-printed: " + expr BasicExpr.prettyPrint()
