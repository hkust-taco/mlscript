:js

import "../../../mlscript-compile/MutMap.mls"
import "../../../mlscript-compile/Iter.mls"

import "../../../mlscript-compile/apps/parsing/Test.mls"
import "../../../mlscript-compile/apps/parsing/Rules.mls"
import "../../../mlscript-compile/apps/parsing/Keywords.mls"

open Test { example }

example of """
#open "hello";;
  
let f x = x + 1;;
  
let g x = x * 2;;
"""
//│ > «#open "hello"»
//│ > «let f x = x + 1»
//│ > «let g x = x * 2»

example of """
#keyword "hello" None None
#keyword "world" 34 None
"""
//│ > 

print of Keywords.extended |> MutMap.valuesIterator |. Iter.joined("\n")
//│ > Keyword(`hello`, N/A, N/A)
//│ > Keyword(`world`, 34, N/A)

example of """
#extend ["lol", [ keyword("hello"), ["lol", "tail"] ], [foo tail]]
#extend ["lol", [ keyword("world") ], [bar]]
#extend ["term", [ ["lol", "value"] ], [baz value]]
"""
//│ > 

Rules.getRuleByKind("lol").display print()
//│ > <lol> ::= 
//│ >   | "hello" <lol>
//│ >   | "world"

Rules.getRuleByKind("term").display print()
//│ > <prefix rules for expressions> ::= 
//│ >   | "let" ("rec" <let-bindings> ["in" <term>] | <let-bindings> ["in" <term>])
//│ >   | "fun" <term> "->" <term>
//│ >   | "match" <term> "with" ("|" <term> "->" <term> ["|" <simple-matching>] | <term> "->" <term> ["|" <simple-matching>])
//│ >   | "function" ("|" <term> "->" <term> ["|" <simple-matching>] | <term> "->" <term> ["|" <simple-matching>])
//│ >   | "if" <term> "then" <term> ["else" <term>]
//│ >   | "while" <term> "do" <term> "done"
//│ >   | "for" <term> "=" <term> ("to" <term> "do" <term> "done" | "downto" <term> "do" <term> "done")
//│ >   | "(" <term> ")"
//│ >   | "[" <term> "]"
//│ >   | "{" <term> "}"
//│ >   | "begin" <term> "end"
//│ >   | <term> ("," <term> | ";" <term> | "<-" <term> | "==" <term> | "*" <term> | "." ("(" <term> ")" | <term>) | ":" <type> | <operator> <term> | <term>)
//│ >   | "hello" <lol>
//│ >   | "world"

example of """
hello world
"""
//│ > «{}»
//│ > «⚠»
//│ > «⚠»

example of """
#keyword "assert" None None
#extend ["assert", [ keyword("assert"), ["term", "value"] ], [do_assert value]]
  
assert 0
"""
//│ > «⚠»
//│ > «⚠»

example of """
#keyword "hello" 3 3
#keyword "goodbye" None None
  
#extend ["greeting", [ keyword("hello"), ["string-literal", "name"], ["greeting", "tail"] ], [foo name tail]]
#extend ["greeting", [ keyword("goodbye") ], [bar]]
  
#extend ["decl", [ ["greeting", "value"] ], [baz value]]
  
  
hello "Rob" hello "Bob" goodbye
  
#diagram ""
"""
//│ > «baz (foo "Rob" (foo "Bob" bar))»
//│ > «#diagram ""»

Rules.getRuleByKind("term").display print()
//│ > <prefix rules for expressions> ::= 
//│ >   | "let" ("rec" <let-bindings> ["in" <term>] | <let-bindings> ["in" <term>])
//│ >   | "fun" <term> "->" <term>
//│ >   | "match" <term> "with" ("|" <term> "->" <term> ["|" <simple-matching>] | <term> "->" <term> ["|" <simple-matching>])
//│ >   | "function" ("|" <term> "->" <term> ["|" <simple-matching>] | <term> "->" <term> ["|" <simple-matching>])
//│ >   | "if" <term> "then" <term> ["else" <term>]
//│ >   | "while" <term> "do" <term> "done"
//│ >   | "for" <term> "=" <term> ("to" <term> "do" <term> "done" | "downto" <term> "do" <term> "done")
//│ >   | "(" <term> ")"
//│ >   | "[" <term> "]"
//│ >   | "{" <term> "}"
//│ >   | "begin" <term> "end"
//│ >   | <term> ("," <term> | ";" <term> | "<-" <term> | "==" <term> | "*" <term> | "." ("(" <term> ")" | <term>) | ":" <type> | <operator> <term> | <term>)
//│ >   | "hello" <lol>
//│ >   | "world"

example of """
#keyword "anyLit" None None
#keyword "stringLit" None None
#keyword "integerLit" None None
#keyword "decimalLit" None None
#keyword "booleanLit" None None
#extend ["decl", [ keyword("anyLit"), ["literal", "value"] ], [any value]]
#extend ["decl", [ keyword("stringLit"), ["string-literal", "value"] ], [str value]]
#extend ["decl", [ keyword("integerLit"), ["integer-literal", "value"] ], [int value]]
#extend ["decl", [ keyword("decimalLit"), ["decimal-literal", "value"] ], [dec value]]
#extend ["decl", [ keyword("booleanLit"), ["boolean-literal", "value"] ], [bool value]]
anyLit "ok";;
stringLit "ok";;
integerLit 42;;
decimalLit 3.25;;
booleanLit true
"""
//│ > «any "ok"»
//│ > «str "ok"»
//│ > «int 42»
//│ > «dec 3.25»
//│ > «bool true»
