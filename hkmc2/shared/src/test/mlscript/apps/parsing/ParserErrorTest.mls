:js

import "../../../mlscript-compile/apps/parsing/Test.mls"

open Test { example }

example of ":tree ((x) ==> x"
//│ > Error of "unexpected end of input"
//│ > «⚠»

example of ":tree ((x) ==> x))"
//│ > Application:
//│ >   callee = Reference of "==>"
//│ >   argument = Stack of 
//│ >     Reference of "x"
//│ >     Reference of "x"
//│ > Error of "unexpected token Symbol(\")\")"
//│ > «x ==> x»
//│ > «⚠»

example of """
type a = b and b = c
"""
//│ > «type a = b and b = c»

example of """
:tree
type test = Bar | Test | Foo
and test' = Bar' | Test' | Foo'
"""
//│ > Define:
//│ >   kind = Type
//│ >   items = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`=`, 3, 3)
//│ >       lhs = Reference of "test"
//│ >       rhs = Infix:
//│ >         op = Keyword(`|`, N/A, N/A)
//│ >         lhs = Reference of "Bar"
//│ >         rhs = Infix:
//│ >           op = Keyword(`|`, N/A, N/A)
//│ >           lhs = Reference of "Test"
//│ >           rhs = Reference of "Foo"
//│ >     Infix:
//│ >       op = Keyword(`=`, 3, 3)
//│ >       lhs = Reference of "test'"
//│ >       rhs = Infix:
//│ >         op = Keyword(`|`, N/A, N/A)
//│ >         lhs = Reference of "Bar'"
//│ >         rhs = Infix:
//│ >           op = Keyword(`|`, N/A, N/A)
//│ >           lhs = Reference of "Test'"
//│ >           rhs = Reference of "Foo'"
//│ > «type test = Bar | Test | Foo and test' = Bar' | Test' | Foo'»

example of """
:tree
-2 * 3
~2 * 3
"""
//│ > Application:
//│ >   callee = Reference of "*"
//│ >   argument = Stack of 
//│ >     Application:
//│ >       callee = Reference of "*"
//│ >       argument = Stack of 
//│ >         Application:
//│ >           callee = Reference of "-"
//│ >           argument = Literal#Integer of "2"
//│ >         Application:
//│ >           callee = Reference of "~"
//│ >           argument = Stack of 
//│ >             Literal#Integer of "3"
//│ >             Literal#Integer of "2"
//│ >     Literal#Integer of "3"
//│ > «(-2) * 3 ~ 2 * 3»

example of """
:tree
let foo = -2 * 3
2 * 3
"""
//│ > LetIn:
//│ >   bindings = Stack of 
//│ >     Infix:
//│ >       op = Keyword(`=`, 3, 3)
//│ >       lhs = Reference of "foo"
//│ >       rhs = Application:
//│ >         callee = Reference of "*"
//│ >         argument = Stack of 
//│ >           Application:
//│ >             callee = Reference of "*"
//│ >             argument = Stack of 
//│ >               Application:
//│ >                 callee = Reference of "-"
//│ >                 argument = Literal#Integer of "2"
//│ >               Application:
//│ >                 callee = Literal#Integer of "3"
//│ >                 argument = Literal#Integer of "2"
//│ >           Literal#Integer of "3"
//│ >   body = None
//│ > «let foo = (-2) * 3 2 * 3»



// TODO should fail
example of """
=> xx
"""
//│ > «=>xx»

example of """
:tree
id fun x -> x
"""
//│ > Reference of "id"
//│ > Error of "unexpected token Reference(\"fun\")"
//│ > Error of "unexpected token Reference(\"x\")"
//│ > Error of "unexpected token Symbol(\"->\")"
//│ > Error of "unexpected token Reference(\"x\")"
//│ > «id»
//│ > «⚠»
//│ > «⚠»
//│ > «⚠»
//│ > «⚠»

example of """
:tree
id if true then 1 else 0
"""
//│ > Reference of "id"
//│ > Error of "unexpected token Reference(\"if\")"
//│ > Error of "unexpected token Literal(Boolean, \"true\")"
//│ > Error of "unexpected token Reference(\"then\")"
//│ > Error of "unexpected token Literal(Integer, \"1\")"
//│ > Error of "unexpected token Reference(\"else\")"
//│ > Error of "unexpected token Literal(Integer, \"0\")"
//│ > «id»
//│ > «⚠»
//│ > «⚠»
//│ > «⚠»
//│ > «⚠»
//│ > «⚠»
//│ > «⚠»

example of """
type;;
"""
//│ > «⚠»

example of """
function;;
"""
//│ > «⚠»

example of """
let foo_bar = function;;
"""
//│ > «⚠»

example of """
let let = 0;;
"""
//│ > «⚠»
