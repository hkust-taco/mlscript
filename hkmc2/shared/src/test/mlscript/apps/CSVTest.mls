:js

import "../../mlscript-compile/apps/CSV.mls"


let csv = CSV(undefined)
//│ csv = CSV(",")


csv.strDelimiter
//│ = ","

csv.objPattern
//│ = /(\,|\r?\n|\r|^)(?:"([^"]*(?:""[^"]*)*)"|([^"\,\r\n]*))/gi

csv.toArrays("a,b,c")
//│ = [["a", "b", "c"]]

csv.toArrays("a,b,c\n1,2,3\n4,5,6")
//│ = [["a", "b", "c"], ["1", "2", "3"], ["4", "5", "6"]]

csv.toArrays("a,b,c\n\n1,2,3\n4,5,6\n")
//│ = [["a", "b", "c"], [""], ["1", "2", "3"], ["4", "5", "6"], [""]]

csv.toArrays(",")
//│ = [[""]]

csv.toArrays(",,")
//│ = [["", ""]]

csv.toArrays("1,\"2\"")
//│ = [["1", "2"]]

csv.toArrays("1,\"2,3\",4")
//│ = [["1", "2,3", "4"]]

csv.toArrays("1,\"\",4")
//│ = [["1", "", "4"]]

csv.toArrays("1,\",4")
//│ = [["1", "", "4"]]

csv.toArrays("1,\",4\"")
//│ = [["1", ",4"]]


// We would probably rather expect "A\\\"B", here
csv.toArrays("1,\"A\\\"B\",4").0.1
//│ = "A\\"


