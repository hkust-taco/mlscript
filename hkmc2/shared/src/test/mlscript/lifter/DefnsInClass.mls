:sir
class A with
  val x = 
    fun g() = 2
    g
(new A).x()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let g⁰, A³, tmp;
//│ define g⁰ as fun g¹() {
//│   return 2
//│ };
//│ define A³ as class A⁴ {
//│   val x²;
//│   constructor() { define x² as val x³ = g¹; end }
//│ };
//│ set tmp = new A⁴();
//│ return tmp.x³()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2

:expect 2
class A(a) with
  let x = 2
  fun f() =
    fun g() = x
    g()
A(2).f()
//│ = 2

class A with
  let x = 2
  val bruh = () => x
  fun f =
    fun g() =
      set x += 2
      this
    g
let a = new A
a.f()
a.f()
a.bruh()
//│ = 6
//│ a = A { bruh: fun }
