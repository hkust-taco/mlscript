class A with
  let x = 2
  val bruh = () => x
  fun f =
    fun g() =
      set x += 2
      this
    g
let a = new A
a.f()
a.f()
a.bruh()
//│ = 6
//│ a = A { A$cap: Capture$A { x$0: 6 }, bruh: fun }
