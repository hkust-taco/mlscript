:js


:inlineThreshold 0
:soir
:lift
fun main() =
  let x =
    if
      0 and maybe then 1
      _ then
        print("hi")
        print("hi")
  print("bye")
  print("bye")
  fun f() = x
  fun foo() = f()
  foo
