:js
:lift

// sanity check
:expect 5050
fun sum(n) =
  if n == 0 then 0
  else
    n + sum(n - 1)
sum(100)
//│ = 5050

// preserve tail calls
// MUST see "return hi1(tmp)" in the output
:stackSafe 5
:effectHandlers
:expect 0
:sjs
fun hi(n) =
  if n == 0 then 0
  else hi(n - 1)
