//│       tmp1 = super(null);
//│       this.n = n;
//│       this.tmp = tmp;
//│       this.pc = pc;
//│       return this;
//│     }
//│   }
//│   #n;
//│   #tmp;
//│   get n() { return this.#n; }
//│   set n(value) { this.#n = value; }
//│   get tmp() { return this.#tmp; }
