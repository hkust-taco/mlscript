//│         return this.n + this.tmp
//│       }
//│       break;
//│     }
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Cont$func$sum$"]; 
//│ });
//│ doUnwind$1 = function doUnwind$(n, tmp, res2, pc) {
