// some variables mutated, some not
:sjs
:expect 7
fun f(unused, immutable, mutated) =
  fun g() =
    set mutated = 2
    immutable + mutated
  fun h() = mutated
  let a = g()
  a + h() + unused
f(1, 2, 1000)
//│ JS (unsanitized):
//│ let f5;
//│ f5 = function f(unused, immutable, mutated) {
//│   let g, h, a, tmp1, tmp2;
//│   g = function g() {
//│     mutated = 2;
//│     return immutable + mutated
//│   };
//│   h = function h() {
//│     return mutated
//│   };
//│   a = g();
//│   tmp1 = h();
//│   tmp2 = a + tmp1;
//│   return tmp2 + unused
//│ };
//│ f5(1, 2, 1000)
//│ = 7

