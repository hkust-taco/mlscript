:sjs
fun g() =
  let y = 0
  fun f(x) =
    let k = 4
    set y = 2
    // set x = 3
    // just a dummy function to force class generation
    fun h() =
      set k = 5
      set x = 4
      x + y
    x
  f
g()(1)
