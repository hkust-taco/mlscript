:expect 5
:sjs
fun f(used1, unused1) =
  let used2 = unused1
  fun g(g_arg) =
    let used3 = 2
    used1 + used2
  let unused2 = 2
  let foo = g
  foo(used2) + unused2
f(1, 2)
//│ JS (unsanitized):
//│ let f3;
//│ f3 = function f(used1, unused1) {
//│   let g, used2, unused2, foo2, tmp1;
//│   g = function g(g_arg) {
//│     let used3;
//│     used3 = 2;
//│     return used1 + used2
//│   };
//│   used2 = unused1;
//│   unused2 = 2;
//│   foo2 = g;
//│   tmp1 = runtime.safeCall(foo2(used2));
//│   return tmp1 + unused2
//│ };
//│ f3(1, 2)
//│ = 5

// preserve order
:sjs
fun f(a1, a2, a3, a4, a5, a6) =
  fun g = a1 + a2 + a3 + a4 + a5 + a6  
  g
f(1,2,3,4,5,6)
//│ JS (unsanitized):
//│ let f4;
//│ f4 = function f(a1, a2, a3, a4, a5, a6) {
//│   let g, tmp1;
//│   g = function g() {
//│     let tmp2, tmp3, tmp4, tmp5;
//│     tmp2 = a1 + a2;
//│     tmp3 = tmp2 + a3;
//│     tmp4 = tmp3 + a4;
//│     tmp5 = tmp4 + a5;
//│     return tmp5 + a6
//│   };
//│   tmp1 = g();
//│   return tmp1
//│ };
//│ f4(1, 2, 3, 4, 5, 6)
//│ = 21

