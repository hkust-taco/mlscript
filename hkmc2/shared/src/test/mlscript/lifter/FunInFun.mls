// try to avoid creating multiple closures

fun f(x) =
  fun g() = x
  [g, g]

:sjs
fun f(x) =
  let y
  fun g() = y
  if x < 0 then
    set y = 1
    [g, g]
  else
    set y = 2
    [g, g]
