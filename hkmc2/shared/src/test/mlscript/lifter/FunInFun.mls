:sir
fun g() =
  let y = 0
  fun f(x) =
    let k = 4
    set y = 2
    // set x = 3
    // just a dummy function to force class generation
    fun h() =
      set k = 5
      set x = 4
      x + y
    x
  f
g()(1)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let h, f, baseCall, Capture$scope0, f$;
//│ define Capture$scope0 as class Capture$scope0¹ {
//│   constructor Capture$scope0⁰(y$0) {
//│     define y$0⁰ as val y$0¹ = y$0;
//│     end
//│   }
//│ };
//│ define h as fun h¹(scope0$cap, x, k) {
//│   set k = 5;
//│   set x = 4;
//│   return +⁰(x, scope0$cap.y$0¹)
//│ };
//│ @inline
//│ define f$ as fun f$⁰(scope0$cap)(x) {
//│   return f⁶(scope0$cap, x)
//│ };
//│ define f as fun f⁶(scope0$cap, x) {
//│   let k;
//│   set k = 4;
//│   set scope0$cap.y$0¹ = 2;
//│   return x
//│ };
//│ define g³ as fun g⁴() {
//│   let y, scope0$cap, f$here;
//│   set scope0$cap = new mut Capture$scope0¹(y);
//│   set scope0$cap.y$0¹ = 0;
//│   set f$here = f$⁰(scope0$cap);
//│   return f$here
//│ };
//│ set baseCall = g⁴();
//│ return baseCall(1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

