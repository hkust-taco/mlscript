:expect 5
fun f(used1, unused1) =
  let used2 = unused1
  fun g(g_arg) =
    let used3 = 2
    used1 + used2
  let unused2 = 2
  g(used2) + unused2
f(1, 2)
//│ = 5

:expect 9
fun f(used1, unused1) =
  let used2 = unused1
  fun g(g_arg)(g_arg2) =
    let used3 = 2
    used1 + used2 + g_arg + g_arg2
  let unused2 = 2
  g(used2)(used2) + unused2
f(1, 2)
//│ = 9

