:sir
fun f(x) =
  fun g() =
    set x += 1
    x
  if true do return g()
  set x += 1
  x
f(0)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let g;
//│ define g as fun g⁵(x) {
//│   let tmp;
