// preserve order
:sjs
fun f(a1, a2, a3, a4, a5, a6) =
  fun g = a1 + a2 + a3 + a4 + a5 + a6  
  g
f(1,2,3,4,5,6)
//│ JS (unsanitized):
//│ let g4, f4, g$4;
//│ g$4 = function g$(a1, a2, a3, a4, a5, a6) {
//│   let tmp, tmp1, tmp2, tmp3;
//│   tmp = a1 + a2;
//│   tmp1 = tmp + a3;
//│   tmp2 = tmp1 + a4;
//│   tmp3 = tmp2 + a5;
//│   return tmp3 + a6
//│ };
//│ g4 = function g(a1, a2, a3, a4, a5, a6) {
//│   return () => {
//│     return g$4(a1, a2, a3, a4, a5, a6)
//│   }
//│ };
//│ f4 = function f(a1, a2, a3, a4, a5, a6) {
//│   let tmp;
//│   tmp = g$4(a1, a2, a3, a4, a5, a6);
//│   return tmp
//│ };
//│ f4(1, 2, 3, 4, 5, 6)
//│ = 21

:expect "01"
:sjs
data class Tuple(a, b)
fun f() =
  let a = 0
  fun g() = set a = 1
  fun h() = a
  Tuple(g, h) 
let ret = f()
let f1 = ret.a
let f2 = ret.b
let x = f2().toString()
f1()
let y = f2().toString()
x + y
