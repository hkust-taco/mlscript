:lift
:js


:fixme
fun foo =
  let x
  fun bar = x
//│ FAILURE: Unexpected lack of error to fix

:expect 12
fun foo =
  let x
  fun bar = x
  x = 12
  bar
foo
//│ = 12


:expect 5
fun f(used1, unused1) =
  let used2 = unused1
  fun g(g_arg) =
    let used3 = 2
    used1 + used2
  let unused2 = 2
  g(used2) + unused2
f(1, 2)
//│ = 5

:expect 9
fun f(used1, unused1) =
  let used2 = unused1
  fun g(g_arg)(g_arg2) =
    let used3 = 2
    used1 + used2 + g_arg + g_arg2
  let unused2 = 2
  g(used2)(used2) + unused2
f(1, 2)
//│ = 9

:expect 9
fun f(used1, unused1) =
  let used2 = unused1
  fun g(g_arg)(g_arg2) =
    let used3 = 2
    used1 + used2 + g_arg + g_arg2
  let unused2 = 2
  let foo = g
  foo(used2)(used2) + unused2
f(1, 2)
//│ = 9

:expect 5
:sjs
fun f(used1, unused1) =
  let used2 = unused1
  fun g(g_arg) =
    let used3 = 2
    used1 + used2
  let unused2 = 2
  let foo = g
  foo(used2) + unused2
f(1, 2)
//│ JS (unsanitized):
//│ let g1, f3, g$3;
//│ g$3 = function g$(used1, used2, g_arg) {
//│   let used3;
//│   used3 = 2;
//│   return used1 + used2
//│ };
//│ g1 = function g(used1, used2) {
//│   return (g_arg) => {
//│     return g$3(used1, used2, g_arg)
//│   }
//│ };
//│ f3 = function f(used1, unused1) {
//│   let used2, unused2, foo2, tmp1, g$here;
//│   used2 = unused1;
//│   unused2 = 2;
//│   g$here = runtime.safeCall(g1(used1, used2));
//│   foo2 = g$here;
//│   tmp1 = runtime.safeCall(foo2(used2));
//│   return tmp1 + unused2
//│ };
//│ f3(1, 2)
//│ = 5

// preserve order
:sjs
fun f(a1, a2, a3, a4, a5, a6) =
  fun g = a1 + a2 + a3 + a4 + a5 + a6  
  g
f(1,2,3,4,5,6)
//│ JS (unsanitized):
//│ let f4, g$4;
//│ g$4 = function g$(a1, a2, a3, a4, a5, a6) {
//│   let tmp1, tmp2, tmp3, tmp4;
//│   tmp1 = a1 + a2;
//│   tmp2 = tmp1 + a3;
//│   tmp3 = tmp2 + a4;
//│   tmp4 = tmp3 + a5;
//│   return tmp4 + a6
//│ };
//│ f4 = function f(a1, a2, a3, a4, a5, a6) {
//│   let tmp1;
//│   tmp1 = g$4(a1, a2, a3, a4, a5, a6);
//│   return tmp1
//│ };
//│ f4(1, 2, 3, 4, 5, 6)
//│ = 21

:expect "01"
data class Tuple(a, b)
fun f() =
  let a = 0
  fun g() = set a = 1
  fun h() = a
  Tuple(g, h) 
let ret = f()
let f1 = ret.a
let f2 = ret.b
let x = f2().toString()
f1()
let y = f2().toString()
x + y
//│ = "01"
//│ f1 = fun
//│ f2 = fun
//│ ret = Tuple(fun, fun)
//│ x = "0"
//│ y = "1"


data class Tuple(a, b)
fun f(used1) =
  fun g1(used2) =
    fun h() = 
      set used1 = 10
      set used2 = 100
    fun i() = used1 + used2
    Tuple(h, i)
  fun g22() = used1
  Tuple(g1(10), g22)

:expect "11110110"
let ret = f(1)
let gRet = ret.a
let g2 = ret.b
let hFun = gRet.a
let iFun = gRet.b
let a = iFun()
let b = g2()
hFun()
let c = g2()
let d = iFun()
a.toString() + b + c + d
//│ = "11110110"
//│ a = 11
//│ b = 1
//│ c = 10
//│ d = 110
//│ g2 = fun
//│ gRet = Tuple(fun, fun)
//│ hFun = fun
//│ iFun = fun
//│ ret = Tuple(Tuple(fun, fun), fun)

// some variables mutated, some not
:sjs
:expect 7
fun f(unused, immutable, mutated) =
  fun g() =
    set mutated = 2
    immutable + mutated
  fun h() = mutated
  let a = g()
  a + h() + unused
f(1, 2, 1000)
//│ JS (unsanitized):
//│ let f7, h$2, g$6, f$capture5;
//│ g$6 = function g$(immutable, f$capture6) {
//│   f$capture6.mutated$capture$0 = 2;
//│   return immutable + f$capture6.mutated$capture$0
//│ };
//│ h$2 = function h$(f$capture6) {
//│   return f$capture6.mutated$capture$0
//│ };
//│ (class f$capture4 {
//│   static {
//│     f$capture5 = this
//│   }
//│   constructor(mutated$capture$0) {
//│     this.mutated$capture$0 = mutated$capture$0;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "f$capture"]; 
//│ });
//│ f7 = function f(unused, immutable, mutated) {
//│   let a1, tmp8, tmp9, capture;
//│   capture = new f$capture5(mutated);
//│   a1 = g$6(immutable, capture);
//│   tmp8 = h$2(capture);
//│   tmp9 = a1 + tmp8;
//│   return tmp9 + unused
//│ };
//│ f7(1, 2, 1000)
//│ = 7

// if used as a higher order function, pass closures
:expect 2
fun f() =
  let x = g
  let y = 2
  fun g() = y
  x()
f()
//│ = 2

:expect 2
fun f() =
  let y = 1
  fun g() = y
  let x = g
  set y = 2
  x()
f()
//│ = 2

:expect 2
fun f(arg) =
  fun g(n) = if n <= 0 then arg else h(n-1)
  fun h(n) = if n <= 0 then arg else g(n-1)
  h(5)
f(2)
//│ = 2

