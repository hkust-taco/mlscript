//│ y = "1"


data class Tuple(a, b)
fun f(used1) =
  fun g1(used2) =
    fun h() = 
      set used1 = 10
      set used2 = 100
    fun i() = used1 + used2
    Tuple(h, i)
  fun g22() = used1
  Tuple(g1(10), g22)

:sjs
:expect "11110110"
