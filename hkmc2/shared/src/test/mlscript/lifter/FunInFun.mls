// try to avoid creating multiple closures

fun f(x) =
  fun g() = x
  [g, g]

:sjs
fun f(x) =
  let y
  fun g() = y
  if x < 0 then
    set y = 1
    [g, g]
  else
    set y = 2
    [g, g]
//│ JS (unsanitized):
//│ let f18;
//│ f18 = function f(x) {
//│   let g2, y, scrut;
//│   g2 = function g() {
//│     return y
//│   };
//│   scrut = x < 0;
//│   if (scrut === true) {
//│     y = 1;
//│     return globalThis.Object.freeze([
//│       g2,
//│       g2
//│     ])
//│   } else { y = 2; return globalThis.Object.freeze([ g2, g2 ]) }
//│ };

