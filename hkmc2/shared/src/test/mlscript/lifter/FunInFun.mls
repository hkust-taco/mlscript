:expect 5
:sjs
fun f(used1, unused1) =
  let used2 = unused1
  fun g(g_arg) =
    let used3 = 2
    used1 + used2
  let unused2 = 2
  let foo = g
  foo(used2) + unused2
f(1, 2)
//│ JS (unsanitized):
//│ let g3, f3, g$3;
//│ g$3 = function g$(used1, used2, g_arg) {
//│   let used3;
//│   used3 = 2;
//│   return used1 + used2
//│ };
//│ g3 = function g(used1, used2) {
