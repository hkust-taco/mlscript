// try to avoid creating multiple closures

fun f(x) =
  fun g() = x
  [g, g]

:sjs
fun f(x) =
  let y
  fun g() = y
  if x < 0 then
    set y = 1
    [g, g]
  else
    set y = 2
    [g, g]
//│ JS (unsanitized):
//│ let f22;
//│ f22 = function f(x1) {
//│   let g3, y1, scrut;
//│   g3 = function g() {
//│     return y1
//│   };
//│   scrut = x1 < 0;
//│   if (scrut === true) {
//│     y1 = 1;
//│     return globalThis.Object.freeze([
//│       g3,
//│       g3
//│     ])
//│   } else { y1 = 2; return globalThis.Object.freeze([ g3, g3 ]) }
//│ };

:sjs
fun f(x) =
  fun g() = x
  let a = g
  set x += 1
  [a, g]
//│ JS (unsanitized):
//│ let f23;
//│ f23 = function f(x1) {
//│   let g3, a1, tmp11;
//│   g3 = function g() {
//│     return x1
//│   };
//│   a1 = g3;
//│   tmp11 = x1 + 1;
//│   x1 = tmp11;
//│   return globalThis.Object.freeze([ a1, g3 ])
//│ };

// Can be avoided in `h` by passing the initialized closure, but this is more complicated
// Note that automatically rewriting `fun h() = g` to `fun h() = a` would resolve this,
// but it requires some more analysis
fun f(x) =
  fun g() = x
  let a = g
  fun h() = g
  [a, h()]

// Requires analysis of all branches
fun f(x) =
  fun g() = x
  if true then
    g
  else
    g
  g
