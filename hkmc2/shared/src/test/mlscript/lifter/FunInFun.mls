:expect 5
:sjs
fun f(used1, unused1) =
  let used2 = unused1
  fun g(g_arg) =
    let used3 = 2
    used1 + used2
  let unused2 = 2
  let foo = g
  foo(used2) + unused2
f(1, 2)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f3, g$1;
//│ g$1 = function g$(used1, used2) {
//│   return (g_arg) => {
//│     let used11, used21, inlinedVal;
//│     used11 = used1;
//│     used21 = used2;
//│     inlinedLbl: {
//│       inlinedVal = used11 + used21;
//│       break inlinedLbl;
//│     }
//│     return inlinedVal
//│   }
//│ };
//│ f3 = function f(used1, unused1) {
//│   let used2, unused2, foo2, tmp1, g$here;
//│   used2 = unused1;
//│   unused2 = 2;
//│   g$here = g$1(used1, used2);
//│   foo2 = g$here;
//│   tmp1 = runtime.safeCall(foo2(used2));
//│   return tmp1 + unused2
//│ };
//│ f3(1, 2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 5

// preserve order
:sjs
fun f(a1, a2, a3, a4, a5, a6) =
  fun g = a1 + a2 + a3 + a4 + a5 + a6  
  g
f(1,2,3,4,5,6)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f4;
//│ f4 = function f(a1, a2, a3, a4, a5, a6) {
//│   let tmp1, a11, a21, a31, a41, a51, a61, inlinedVal;
//│   a11 = a1;
//│   a21 = a2;
//│   a31 = a3;
//│   a41 = a4;
//│   a51 = a5;
//│   a61 = a6;
//│   inlinedLbl: {
//│     let tmp2, tmp3, tmp4, tmp5;
//│     tmp2 = a11 + a21;
//│     tmp3 = tmp2 + a31;
//│     tmp4 = tmp3 + a41;
//│     tmp5 = tmp4 + a51;
//│     inlinedVal = tmp5 + a61;
//│     break inlinedLbl;
//│   }
//│   tmp1 = inlinedVal;
//│   return tmp1
//│ };
//│ f4(1, 2, 3, 4, 5, 6)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 21

:expect "01"
data class Tuple(a, b)
fun f() =
  let a = 0
  fun g() = set a = 1
  fun h() = a
  Tuple(g, h) 
let ret = f()
let f1 = ret.a
let f2 = ret.b
let x = f2().toString()
f1()
let y = f2().toString()
x + y
//│ = "01"
//│ f1 = fun
//│ f2 = fun
//│ ret = Tuple(fun, fun)
//│ x = "0"
//│ y = "1"


data class Tuple(a, b)
fun f(used1) =
  fun g1(used2) =
    fun h() = 
      set used1 = 10
      set used2 = 100
    fun i() = used1 + used2
    Tuple(h, i)
  fun g22() = used1
  Tuple(g1(10), g22)

:expect "11110110"
let ret = f(1)
let gRet = ret.a
let g2 = ret.b
let hFun = gRet.a
let iFun = gRet.b
let a = iFun()
let b = g2()
hFun()
let c = g2()
let d = iFun()
a.toString() + b + c + d
//│ = "11110110"
//│ a = 11
//│ b = 1
//│ c = 10
//│ d = 110
//│ g2 = fun
//│ gRet = Tuple(fun, fun)
//│ hFun = fun
//│ iFun = fun
//│ ret = Tuple(Tuple(fun, fun), fun)

// some variables mutated, some not
:sjs
:expect 7
fun f(unused, immutable, mutated) =
  fun g() =
    set mutated = 2
    immutable + mutated
  fun h() = mutated
  let a = g()
  a + h() + unused
f(1, 2, 1000)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f7, Capture$f3;
//│ (class Capture$f2 {
//│   static {
//│     Capture$f3 = this
//│   }
//│   constructor(mutated$0) {
//│     this.mutated$0 = mutated$0;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Capture$f"]; 
//│ });
//│ f7 = function f(unused, immutable, mutated) {
//│   let a1, tmp6, tmp7, f$cap, f$cap1, immutable1, inlinedVal, f$cap2, inlinedVal1;
//│   f$cap = new Capture$f3(mutated);
//│   f$cap1 = f$cap;
//│   immutable1 = immutable;
//│   inlinedLbl: {
//│     f$cap1.mutated$0 = 2;
//│     inlinedVal = immutable1 + f$cap1.mutated$0;
//│     break inlinedLbl;
//│   }
//│   a1 = inlinedVal;
//│   f$cap2 = f$cap;
//│   inlinedLbl1: {
//│     inlinedVal1 = f$cap2.mutated$0;
//│     break inlinedLbl1;
//│   }
//│   tmp6 = inlinedVal1;
//│   tmp7 = a1 + tmp6;
//│   return tmp7 + unused
//│ };
//│ f7(1, 2, 1000)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 7

