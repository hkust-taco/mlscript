:expect 5
:sjs
fun f(used1, unused1) =
  let used2 = unused1
  fun g(g_arg) =
    let used3 = 2
    used1 + used2
  let unused2 = 2
  let foo = g
  foo(used2) + unused2
f(1, 2)
//│ JS (unsanitized):
//│ let f3;
//│ f3 = function f(used1, unused1) {
//│   let g, used2, unused2, foo2, tmp1;
//│   g = function g(g_arg) {
//│     let used3;
//│     used3 = 2;
//│     return used1 + used2
//│   };
//│   used2 = unused1;
//│   unused2 = 2;
//│   foo2 = g;
//│   tmp1 = runtime.safeCall(foo2(used2));
//│   return tmp1 + unused2
//│ };
//│ f3(1, 2)
//│ = 5

// preserve order
:sjs
fun f(a1, a2, a3, a4, a5, a6) =
  fun g = a1 + a2 + a3 + a4 + a5 + a6  
  g
f(1,2,3,4,5,6)
//│ JS (unsanitized):
//│ let f4;
//│ f4 = function f(a1, a2, a3, a4, a5, a6) {
//│   let g, tmp1;
//│   g = function g() {
//│     let tmp2, tmp3, tmp4, tmp5;
//│     tmp2 = a1 + a2;
//│     tmp3 = tmp2 + a3;
//│     tmp4 = tmp3 + a4;
//│     tmp5 = tmp4 + a5;
//│     return tmp5 + a6
//│   };
//│   tmp1 = g();
//│   return tmp1
//│ };
//│ f4(1, 2, 3, 4, 5, 6)
//│ = 21

:expect "01"
data class Tuple(a, b)
fun f() =
  let a = 0
  fun g() = set a = 1
  fun h() = a
  Tuple(g, h) 
let ret = f()
let f1 = ret.a
let f2 = ret.b
let x = f2().toString()
f1()
let y = f2().toString()
x + y
//│ = "01"
//│ f1 = fun g
//│ f2 = fun h
//│ ret = Tuple(fun g, fun h)
//│ x = "0"
//│ y = "1"


data class Tuple(a, b)
fun f(used1) =
  fun g1(used2) =
    fun h() = 
      set used1 = 10
      set used2 = 100
    fun i() = used1 + used2
    Tuple(h, i)
  fun g22() = used1
  Tuple(g1(10), g22)

:expect "11110110"
let ret = f(1)
let gRet = ret.a
let g2 = ret.b
let hFun = gRet.a
let iFun = gRet.b
let a = iFun()
let b = g2()
hFun()
let c = g2()
let d = iFun()
a.toString() + b + c + d
//│ = "11110110"
//│ a = 11
//│ b = 1
//│ c = 10
//│ d = 110
//│ g2 = fun g22
//│ gRet = Tuple(fun h, fun i)
//│ hFun = fun h
//│ iFun = fun i
//│ ret = Tuple(Tuple(fun h, fun i), fun g22)

// some variables mutated, some not
:sjs
:expect 7
fun f(unused, immutable, mutated) =
  fun g() =
    set mutated = 2
    immutable + mutated
  fun h() = mutated
  let a = g()
  a + h() + unused
f(1, 2, 1000)
//│ JS (unsanitized):
//│ let f7;
//│ f7 = function f(unused, immutable, mutated) {
//│   let g, h, a1, tmp8, tmp9;
//│   g = function g() {
//│     mutated = 2;
//│     return immutable + mutated
//│   };
//│   h = function h() {
//│     return mutated
//│   };
//│   a1 = g();
//│   tmp8 = h();
//│   tmp9 = a1 + tmp8;
//│   return tmp9 + unused
//│ };
//│ f7(1, 2, 1000)
//│ = 7

