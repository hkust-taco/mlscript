//│   y1 = undefined;
//│   scrut = x1 < 0;
//│   if (scrut === true) {
//│     y1 = 1;
//│     g$here = runtime.safeCall(g19(y1));
//│     return globalThis.Object.freeze([
//│       g$here,
//│       g$here
//│     ])
//│   } else {
//│     y1 = 2;
//│     g$here = runtime.safeCall(g19(y1));
