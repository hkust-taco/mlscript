//│ f$capture1.class = class f$capture {
//│   constructor(a0$) {
//│     this.a0$ = a0$;
//│   }
//│   toString() { return "f$capture(" + globalThis.Predef.render(this.a0$) + ")"; }
//│ };
//│ f6 = function f() {
//│   let capture, g$this, h$this;
