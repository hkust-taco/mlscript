:expect 6
fun f(x, y, z) =
  fun g() =
    set x = 1
    h()
    x + y + z
  fun h() =
    set y = 2
    i()
  fun i() =
    set z = 3
  g
f(0, 0, 0)()
//│ = 6

fun f(x, cond) =
  set x = 1
  set x = 2
  if cond then
    () => x
  else
    set x = 3
    () => x

