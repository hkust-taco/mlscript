:js
:lift

fun f() = 3

:effectHandlers
:noSanityCheck
module A with
  data class Test with
    f()
    val a = 1

:effectHandlers
:noSanityCheck
class Test with
  f()
  val a = 1

class Eff

:effectHandlers
:expect 7
handle h = Eff with
  fun perform(x)(k) = k(x) + 1
let x = 5
h.perform(x) + 1
//│ /!!!\ Option ':effectHandlers' requires ':lift' and ':noSanityCheck'
//│ = 7
