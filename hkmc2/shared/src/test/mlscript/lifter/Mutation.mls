:lift
:js


let xs = mut []
//│ xs = []

:sjs
fun foo() =
  let x = 1
  fun bar() = x
  xs.push(bar)
  set x = 2
//│ JS (unsanitized):
//│ let foo;
//│ foo = function foo() {
//│   let bar, x, tmp;
//│   bar = function bar() {
//│     return x
//│   };
//│   x = 1;
//│   tmp = runtime.safeCall(xs.push(bar));
//│   x = 2;
//│   return runtime.Unit
//│ };

:expect 2
foo()
xs.0()
//│ = 2


