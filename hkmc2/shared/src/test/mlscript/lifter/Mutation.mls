:lift
:js


let xs = mut []
//│ xs = []

:sir
fun foo() =
  let x = 1
  fun bar() = x
  xs.push(bar)
  set x = 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let bar, Capture$scope0, bar$;
//│ define Capture$scope0 as class Capture$scope0¹ {
//│   constructor Capture$scope0⁰(x$0) {
//│     define x$0⁰ as val x$0¹ = x$0;
//│     end
//│   }
//│ };
//│ @inline
//│ define bar$ as fun bar$⁰(scope0$cap)() {
//│   return bar⁰(scope0$cap)
//│ };
//│ define bar as fun bar⁰(scope0$cap) {
//│   return scope0$cap.x$0¹
//│ };
//│ define foo⁰ as fun foo¹() {
//│   let x, scope0$cap, bar$here;
//│   set scope0$cap = new mut Capture$scope0¹(x);
//│   set scope0$cap.x$0¹ = 1;
//│   set bar$here = bar$⁰(scope0$cap);
//│   do xs⁰.push﹖(bar$here);
//│   set scope0$cap.x$0¹ = 2;
//│   return runtime⁰.Unit⁰
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect 2
foo()
xs.0()
//│ = 2


let xs = mut []
//│ xs = []

// :sir
fun foo() =
  let x
  fun bar() = x
  xs.push(bar)
  x = 2

:expect 2
foo()
xs.0()
//│ = 2


fun foo() =
  let x
  fun bar() =
    x = 2
  [bar, () => x]


:expect 2
let b_x = foo()
b_x.0()
b_x.1()
//│ = 2
//│ b_x = [fun, fun]


fun foo() =
  let x = undefined
  fun bar() =
    x = 2
  [bar, () => x]

:expect 2
let b_x = foo()
b_x.0()
b_x.1()
//│ = 2
//│ b_x = [fun, fun]


:sir
fun foo() =
  fun bar() =
    let x
    x
  bar
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let bar;
//│ define bar as fun bar¹() { let x; return x };
//│ define foo² as fun foo³() { return bar¹ };
//│ end
