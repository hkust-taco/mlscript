:expect 2
fun f(x) =
  class A() with
    fun newA() = A()
    fun foo() =
      set x += 1
      x
    fun getX() = x
  A()
let a = f(0)
a.foo()
let b = a.newA()
b.foo()
a.getX()
//│ = 2
//│ a = A()
//│ b = A()

// handler

:stackSafe 10
:effectHandlers
fun sum(n) =
  if n == 0 then 0
  else
    n + sum(n - 1)
