:lift
:js

// make sure class fields are discriminated properly for immutable captures when supported
:effectHandlers
abstract class Effect with
  fun perform()
handle h = Effect with
  fun perform()(k) = k()
fun f() =
  h.perform()
  1
f() + f() + f()
//│ = 3

:expect 1
:sjs
fun f(used1, unused1) =
  fun g(g_arg) =
    let used3 = 2
    fun h = used3
    used1 + h
  let unused2 = 2
  class Test(a) with
    fun get() = used1
  Test(unused1)
f(1, 2).get()
