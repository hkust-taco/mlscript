:lift
:js

// make sure class fields are discriminated properly for immutable captures when supported
:effectHandlers
abstract class Effect with
  fun perform()
handle h = Effect with
  fun perform()(k) = k()
fun f() =
  h.perform()
  1
f() + f() + f()
