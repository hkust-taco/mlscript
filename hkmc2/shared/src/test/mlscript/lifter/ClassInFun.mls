:fixme
:expect 2
class A(a) with
  let x = 2
  fun f() =
    fun g() = x
    g()
A(2).f()
//│ ═══[RUNTIME ERROR] Error: MLscript call unexpectedly returned `undefined`, the forbidden value.
//│ ═══[RUNTIME ERROR] Expected: '2', got: 'undefined'

:expect 2
fun f(x) =
  class A() with
    fun newA() = A()
    fun foo() =
      set x += 1
      x
    fun getX() = x
  A()
let a = f(0)
a.foo()
let b = a.newA()
b.foo()
a.getX()
//│ = 2
//│ a = A()
//│ b = A()

// handler

:stackSafe 10
:effectHandlers
fun sum(n) =
  if n == 0 then 0
  else
    n + sum(n - 1)
sum(100)
//│ = 5050

