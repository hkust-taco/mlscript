// *** Mutability ***


// * Trivial case
:sir
:noSanityCheck
fun main() =
  class C(val a)
  let c = new mut C(123)
  set c.a = 0
  set c.b = "hi"
  let d = new C(456)
  set d.a = 0
  let e = C(789)
  set e.a = 0
  [c.a, c.b, d.a, e.a]
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let C;
//│ define C as class C² {
//│   val a⁰;
//│   constructor C¹(a) {
//│     define a⁰ as val a¹ = a;
//│     end
//│   }
//│ };
//│ define main⁰ as fun main¹() {
//│   let c, d, e;
//│   set c = new mut C²(123);
//│   set c.a﹖ = 0;
//│   set c.b﹖ = "hi";
//│   set d = new C²(456);
//│   set d.a﹖ = 0;
//│   set e = C¹(789);
//│   set e.a﹖ = 0;
//│   return [c.a﹖, c.b﹖, d.a﹖, e.a﹖]
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// * Notice that the lifted class above behaves the same as the equivalent top-level class below:

class C(val a)

let c = new mut C(123)
set c.a = 0
set c.b = "hi"
let d = new C(456)
set d.a = 0
let e = C(789)
set e.a = 0
//│ c = C(0)
//│ d = C(456)
//│ e = C(789)

:expect [0, "hi", 456, 789]
[c.a, c.b, d.a, e.a]
//│ = [0, "hi", 456, 789]

// * Nontrivial case
:sir
:noSanityCheck
fun main(x) =
  class C(val a) with
    fun get = x + a
  let c = new mut C(123)
  set c.a = 0
  set c.b = "hi"
  let d = new C(456)
  set d.a = 0
  let e = C(789)
  set e.a = 0
  [c.a, c.b, d.a, e.a, c.get, d.get, e.get]
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let C;
//│ define C as class C⁴ {
//│   private val x²;
//│   val a²;
//│   constructor C³(a, x) {
//│     set C⁴.this.x² = x;
//│     define a² as val a³ = a;
//│     end
//│   }
//│   method get⁰ = fun get¹ {
//│     return +⁰(C⁴.this.x², C⁴.this.a³)
//│   }
//│ };
//│ define main² as fun main³(x) {
//│   let c, d, e;
//│   set c = new mut C⁴(123, x);
//│   set c.a﹖ = 0;
//│   set c.b﹖ = "hi";
//│   set d = new C⁴(456, x);
//│   set d.a﹖ = 0;
//│   set e = new C⁴(789, x);
//│   set e.a﹖ = 0;
//│   return [c.a﹖, c.b﹖, d.a﹖, e.a﹖, c.get﹖, d.get﹖, e.get﹖]
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect [0, "hi", 456, 789, 42, 498, 831]
main(42)
//│ = [0, "hi", 456, 789, 42, 498, 831]

// * The lifted class above should behave the same as the equivalent top-level class below:

let x = id(42)
class C(val a) with
  fun get = x + a
//│ x = 42

let c = new mut C(123)
set c.a = 0
set c.b = "hi"
let d = new C(456)
set d.a = 0
let e = C(789)
set e.a = 0
//│ c = C(0)
//│ d = C(456)
//│ e = C(789)

:expect [0, "hi", 456, 789, 42, 498, 831]
[c.a, c.b, d.a, e.a, c.get, d.get, e.get]
//│ = [0, "hi", 456, 789, 42, 498, 831]


// This used to raise a softTODO in DPE
// The error is because the type tree for classes store parameter list arity information,
// but the lifter modifies this information, and the equality is enforced by the middle-end
// flow analysis, which is used by dead param elimination. It would be a pain to change all the
// class symbols because they could be nested in other symbols at an arbitrary depth.
// :fixme
:deadParamElim 
fun f(x) =
  class A(y) with
    fun get = x + y
  new A(2)


// This used not to work due to the use of `super` on curried class parameter lists, but it now works.
:expect "B()"
fun test(x) =
  class A() with
    fun get = x
  class B() extends A() with
    fun bar = x
  B()
test(0).toString()
//│ = "B()"

// [The following comment refers to the old way of compiling such curried classes to JS:]
// In fact, the correct way (using the current "constructor returns a lambda" hack) is this:
// return (params) => {
//   let ret = super(parentMainParams)(parentAuxParams);
//   // ctor
//   return ret;
// }

:sir
fun f(x, y, z) =
  data class C(a) with
    fun getX = x
    fun getY = y
    fun setY = set y += 1
  class D extends C(y)
  [new C(0), new D]
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let C, D, Capture$f;
//│ @data
//│ define C as class C⁶ {
//│   private val f$cap⁰;
//│   private val x³;
//│   val a⁴;
//│   constructor C⁵(a, f$cap, x) {
//│     set C⁶.this.f$cap⁰ = f$cap;
//│     set C⁶.this.x³ = x;
//│     define a⁴ as val a⁵ = a;
//│     end
//│   }
//│   method getX⁰ = fun getX¹ {
//│     return C⁶.this.x³
//│   }
//│   method getY⁰ = fun getY¹ {
//│     return C⁶.this.f$cap⁰.y$0⁰
//│   }
//│   method setY⁰ = fun setY¹ {
//│     let tmp;
//│     set tmp = +⁰(C⁶.this.f$cap⁰.y$0⁰, 1);
//│     set C⁶.this.f$cap⁰.y$0⁰ = tmp;
//│     return runtime⁰.Unit⁰
//│   }
//│ };
//│ define D as class extends C⁶ D⁰ {
//│   private val f$cap¹;
//│   private val x⁴;
//│   constructor(f$cap, x) {
//│     do super⁰(f$cap².y$0⁰, f$cap², x⁵);
//│     end;
//│     set D⁰.this.f$cap¹ = f$cap;
//│     set D⁰.this.x⁴ = x;
//│     end
//│   }
//│ };
//│ define Capture$f as class Capture$f¹ {
//│   constructor Capture$f⁰(y$0) {
//│     define y$0¹ as val y$0⁰ = y$0;
//│     end
//│   }
//│ };
//│ define f⁴ as fun f⁵(x, y, z) {
//│   let tmp, tmp1, f$cap;
//│   set f$cap = new mut Capture$f¹(y);
//│   set tmp = new C⁶(0, f$cap, x);
//│   set tmp1 = new D⁰(f$cap, x);
//│   return [tmp, tmp1]
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect [2, (), 3, 2]
let res = f(1, 2, 3)
let c = res.0
let d = res.1
[c.getY, c.setY, c.getY, d.a]
//│ = [2, (), 3, 2]
//│ c = C(0)
//│ d = D { a: 2 }
//│ res = [C(0), D { a: 2 }]

:expect 0
class A(val x)
class B(y) extends A(y)
(new B(0)).x
//│ = 0

:expect [1, 2]
class A(val x)(val y)
class B extends A(1)(2)
[(new B).x, (new B).y]
//│ = [1, 2]

:w
:sir
fun f(x, y, z) =
  data class C(a) with
    fun getX = x
    fun getY = y
    fun setY = set y += 1
  class D extends C(y)
  let x = D // force D unlifted
  [new C(0), new D]
//│ ═══[WARNING] Cannot yet lift class `D` as it is used as a first-class class.
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let C, Capture$f;
//│ @data
//│ define C as class C⁸ {
//│   private val f$cap³;
//│   private val x⁶;
//│   val a⁶;
//│   constructor C⁷(a, f$cap, x) {
//│     set C⁸.this.f$cap³ = f$cap;
//│     set C⁸.this.x⁶ = x;
//│     define a⁶ as val a⁷ = a;
//│     end
//│   }
//│   method getX² = fun getX³ {
//│     return C⁸.this.x⁶
//│   }
//│   method getY² = fun getY³ {
//│     return C⁸.this.f$cap³.y$0²
//│   }
//│   method setY² = fun setY³ {
//│     let tmp;
//│     set tmp = +⁰(C⁸.this.f$cap³.y$0², 1);
//│     set C⁸.this.f$cap³.y$0² = tmp;
//│     return runtime⁰.Unit⁰
//│   }
//│ };
//│ define Capture$f as class Capture$f³ {
//│   constructor Capture$f²(y$0) {
//│     define y$0³ as val y$0² = y$0;
//│     end
//│   }
//│ };
//│ define f⁶ as fun f⁷(x, y, z) {
//│   let D, x1, tmp, tmp1, f$cap;
//│   set f$cap = new mut Capture$f³(y);
//│   define D as class extends C⁸ D¹ {};
//│   set x1 = D¹;
//│   set tmp = new C⁸(0, f$cap, x);
//│   set tmp1 = new D¹();
//│   return [tmp, tmp1]
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect [2, (), 3, 2]
let res = f(1, 2, 3)
let c = res.0
let d = res.1
[c.getY, c.setY, c.getY, d.a]
//│ = [2, (), 3, 2]
//│ c = C(0)
//│ d = D { a: 2 }
//│ res = [C(0), D { a: 2 }]

:w
fun f(x, y, z) =
  data class C(a) with
    fun getX = x
    fun getY = y
    fun setY = set y += 1
  class D extends C(y)
  if x is C do print("a") // force C unlifted
  [new C(0), new D]
//│ ═══[WARNING] Cannot yet lift class/module `C` as it is used in an instance check.
//│ ═══[WARNING] Cannot yet lift definition `D` as it extends an unliftable class.

:expect [2, (), 3, 2]
let res = f(1, 2, 3)
let c = res.0
let d = res.1
[c.getY, c.setY, c.getY, d.a]
//│ = [2, (), 3, 2]
//│ c = C(0)
//│ d = D { a: 2 }
//│ res = [C(0), D { a: 2 }]


:expect 3
class Box(val x) with
    fun get() = x
    fun inc() = Box(x + 1).get()
Box(2).inc()
//│ = 3
