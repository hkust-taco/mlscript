fun f(x) =
  class Test() with
    fun get() = x
  Test()
f(1).get()
//│ = 1

:expect 1
fun f(used1, unused1) =
  fun g(g_arg) =
    let used3 = 2
    fun h = used3
    used1 + h
  let unused2 = 2
  data class Test(a) with
    fun get() = used1
  Test(unused1)
f(1, 2).get()
//│ = 1

