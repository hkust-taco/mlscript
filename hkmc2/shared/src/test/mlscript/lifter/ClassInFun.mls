a.foo()
let b = a.newA()
b.foo()
a.getX()
//│ = 2
//│ a = A()
//│ b = A()

// handler

:stackSafe 10
:effectHandlers
fun sum(n) =
  if n == 0 then 0
  else
    n + sum(n - 1)
sum(100)
//│ = 5050

