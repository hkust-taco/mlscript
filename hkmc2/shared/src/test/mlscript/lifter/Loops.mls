:js
:lift
:todo // FIXME: Lifting should not require scope flattening (which doesn't handle loops)


let fs = mut []
//│ fs = []

fun foo() =
  let x = 1
  while x < 5 do
    set x += 1
    fs.push of () => x

:expect 5
foo()
fs.0()
//│ = 5


let fs = mut []
//│ fs = []

fun foo() =
  let i = 1
  while i < 5 do
    let x = i
    set i += 1
    fs.push of () => x

// * Note that this works with while loop rewriting
// * See [fixme:0] for cause of the issue
:todo
:expect 1
foo()
fs.0()
//│ = 1


