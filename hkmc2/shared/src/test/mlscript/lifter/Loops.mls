:js
:lift
:rewriteWhile // TODO: remove


let fs = mut []
//│ fs = []

fun foo() =
  let x = 1
  while x < 5 do
    set x += 1
    fs.push of () => x

:expect 5
foo()
fs.0()
//│ = 5


let fs = mut []
//│ fs = []

fun foo() =
  let i = 1
  while i < 5 do
    let x = i
    set i += 1
    fs.push of () => x

// * Note that this works with while loop rewriting
// * See [fixme:0] for cause of the issue
:todo
:expect 1
foo()
fs.0()
//│ = 1


:sjs
fun foo() =
  let x = 1
  while true do
    set x += 1
    return () => x
//│ JS (unsanitized):
//│ let foo2;
//│ foo2 = function foo() {
//│   let x, tmp2, tmp3, tmp4, while1;
//│   x = 1;
//│   tmp2 = undefined;
//│   while1 = (undefined, function () {
//│     let scrut, tmp5, lambda;
//│     scrut = true;
//│     if (scrut === true) {
//│       tmp5 = x + 1;
//│       x = tmp5;
//│       lambda = (undefined, function () {
//│         return x
//│       });
//│       return lambda
//│     } else {
//│       tmp2 = runtime.Unit;
//│     }
//│     return runtime.LoopEnd
//│   });
//│   tmp3 = while1();
//│   tmp4 = tmp3 !== runtime.LoopEnd;
//│   if (tmp4 === true) { return tmp3 } else { return tmp2 }
//│ };

:expect 2
foo()()
//│ = 2


