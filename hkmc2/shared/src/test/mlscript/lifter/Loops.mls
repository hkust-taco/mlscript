let fs = mut []
//│ fs = []

fun foo() =
  let i = 1
  while i < 5 do
    let x = i
    set i += 1
    fs.push of () => x

// * Note that this works with while loop rewriting
// * See [fixme:0] for cause of the issue
:fixme
:expect 1
foo()
fs.0()
//│ /!!!\ Uncaught error: java.util.NoSuchElementException: key not found: term:foo


