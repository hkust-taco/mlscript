:js
:lift


let fs = mut []
//│ fs = []

fun foo() =
  let x = 1
  while x < 5 do
    set x += 1
    fs.push of () => x

:expect 5
foo()
fs.0()
//│ = 5


let fs = mut []
//│ fs = []

fun foo() =
  let i = 1
  while i < 5 do
    let x = i
    set i += 1
    fs.push of () => x

// * Note that this works with while loop rewriting
// * See [fixme:0] for cause of the issue
:fixme
:expect 1
foo()
fs.0()
//│ ═══[RUNTIME ERROR] Expected: '1', got: '4'
//│ = 4


:sjs
fun foo() =
  let x = 1
  while true do
    set x += 1
    return () => x
