:js
:lift
:ignore // FIXME: Lifting should not require scope flattening (which doesn't handle loops)


let fs = mut []
//│ fs = []

fun foo() =
  let x = 1
  while x < 5 do
    set x += 1
    fs.push of () => x

:expect 5
foo()
fs.0()
//│ = 5


let fs = mut []
//│ fs = []

fun foo() =
  let i = 1
  while i < 5 do
    let x = i
    set i += 1
    fs.push of () => x

// * Note that this works with while loop rewriting
// * See [fixme:0] for cause of the issue
:expect 1
foo()
fs.0()
//│ = 1


:sir
fun foo() =
  let x = 1
  while true do
    set x += 1
    return () => x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let lambda, Capture$scope0, lambda$;
//│ @inline @private
//│ define lambda$ as fun lambda$⁰(scope0$cap)() {
//│   return lambda⁰(scope0$cap)
//│ };
//│ @private
//│ define lambda as fun lambda⁰(scope0$cap) {
//│   return scope0$cap.x$0⁰
//│ };
//│ define Capture$scope0 as class Capture$scope0¹ {
//│   constructor Capture$scope0⁰(x$0) {
//│     define x$0¹ as val x$0⁰ = x$0;
//│     end
//│   }
//│ };
//│ define foo⁰ as fun foo¹() {
//│   let x, scope0$cap;
//│   set scope0$cap = new mut Capture$scope0¹(x);
//│   set scope0$cap.x$0⁰ = 1;
//│   loop lbl:
//│     let scrut, tmp;
//│     set scrut = true;
//│     match scrut
//│       true =>
//│         let lambda$here;
//│         set tmp = +⁰(scope0$cap.x$0⁰, 1);
//│         set scope0$cap.x$0⁰ = tmp;
//│         set lambda$here = lambda$⁰(scope0$cap);
//│         return lambda$here
//│       else
//│         end
//│     end
//│   return runtime⁰.Unit⁰
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect 2
foo()()
//│ = 2


