//│     };
//│     this.A.class = class A7 {
//│       constructor() {}
//│       get get() {
//│         return M21.x + M20.x;
//│       }
//│       toString() { return "A(" + "" + ")"; }
//│     };
//│     scrut = M20.A();
//│     if (scrut instanceof M20.A.class) {
