:sjs
module M with
  class A() with
    fun get = M.x + x
  val x = if A() is A then 2 else 3
M.A().get
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let M14, tmp4;
//│ (class M13 {
//│   static {
//│     M14 = this
//│   }
//│   constructor() {
//│     runtime.Unit;
//│   }
//│   static #M_mod$cap;
//│   static {
//│     let scrut, tmp5;
//│     this.A = function A() {
//│       return globalThis.Object.freeze(new A.class());
//│     };
//│     (class A6 {
//│       static {
//│         M13.A.class = this
//│       }
//│       constructor() {}
//│       #A$cap;
//│       get get() {
//│         return M13.x + M13.x;
//│       }
//│       toString() { return runtime.render(this); }
//│       static [definitionMetadata] = ["class", "A", []]; 
//│     });
//│     scrut = M13.A();
//│     if (scrut instanceof M13.A.class) {
//│       tmp5 = 2;
//│     } else {
//│       tmp5 = 3;
//│     }
//│     this.x = tmp5;
//│   }
//│   #M$cap;
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "M"]; 
//│ });
//│ tmp4 = M14.A();
//│ tmp4.get
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 4

module M with
  val x = 2
  class A with
    fun get = x
  class B() extends A
M.B().get
//│ = 2

/// Top Level Modules ///

// newA should reference the class symbol
// newA_B should reference the BlockMemberSymbol
// note: no warning because A is not lifted
:lift
module M with
  data class A(x) with
    class B() with
      fun get = x
      fun newA_B(y) = A(y)
    fun newA = A(42)
    fun newB = B()
  0 is A
M.A(2).newB.newA_B(3).newB.get
//│ = 3

module M with
  class A
  object B extends A


