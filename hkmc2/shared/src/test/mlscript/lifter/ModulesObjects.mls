//│     tmp = globalThis.Object.freeze(new M2(y));
//│   }
//│   return tmp
//│ };
//│ (class M1 {
//│   static {
//│     M2 = this
//│   }
//│   constructor(y) {
//│     this.y = y;
//│   }
//│   #M$cap;
//│   foo() {
//│     this.y = 2;
//│     return runtime.Unit
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "M"]; 
//│ });
//│ foo1 = function foo(y) { let tmp; tmp = M$(false, y); return tmp.foo() };
//│ foo1(10)
