foo(123)
//│ = [true, [true, false], true]

module A with
  fun g = 1
  fun f = () => g
  f()

module A with
  val a = (() => 1)()

// This is related to the above, but it will look into the ignored bms map
module A with
  val x =
    fun f() = 1
    f()

module A with
  val x =
    fun f() = 1
    fun g() =
      fun h() = f()
      h()
    f() + g()
A.x
//│ = 2

// private fields in modules
module A with
  let x = 1
  fun mtd =
    fun nested() = x
    nested()
A.mtd
//│ = 1


