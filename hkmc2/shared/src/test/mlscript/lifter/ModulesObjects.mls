:sjs
class A(x) with
  object M with
    fun getB() = x
  fun getA() = M.getB()
//│ JS (unsanitized):
//│ let M11, A3;
//│ M11 = function M(A$instance$01) {
//│   return new M.class()(A$instance$01);
//│ };
//│ M11.class = class M10 {
//│   constructor() {
//│     return (A$instance$0) => {
//│       this.A$instance$0 = A$instance$0;
//│       return this;
//│     }
//│   }
//│   getB() {
//│     return this.A$instance$0.x
//│   }
//│   toString() { return "M"; }
//│ };
//│ A3 = function A(x1) {
//│   return new A.class(x1);
//│ };
//│ A3.class = class A2 {
//│   constructor(x) {
//│     this.x = x;
//│     this.M$ = M11(this);
//│   }
//│   getA() {
//│     return this.M$.getB()
//│   }
//│   toString() { return "A(" + globalThis.Predef.render(this.x) + ")"; }
//│ };

:expect 2
A(2).getA()
//│ = 2
