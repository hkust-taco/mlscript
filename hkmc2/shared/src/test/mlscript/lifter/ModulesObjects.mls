// the problem with all of these tests is that a Ref to a module's own ModuleSymbol 
// (let's say M) emits `M` instead of `this` in the codegen 

:todo
fun foo(x, y) =
  module M with
    val test = 2
    fun foo() =
      set y = 2
      x + y + test
  M.foo()
//│ ═══[WARNING] Modules are not yet properly lifted and will break.
//│ ═══[WARNING] Modules are not yet properly lifted and will break.
//│ > let M1, foo;try { M1 = class M {   static {     return (x$0, y$1) => {       this.x$0 = x$0;       this.y$1 = y$1;       this.test = 2;       return this;     }   }   static foo(...args) {     globalThis.Predef.checkArgs("foo", 0, true, args.length);     let tmp;     M.y$1 = 2;     tmp = M.x$0 + M.y$1;     return tmp + M.test   }   static toString() { return "M"; } }; foo = function foo(...args) {   globalThis.Predef.checkArgs("foo", 2, true, args.length);   let x = args[0];   let y = args[1];   let M$;   M$ = runtime.checkCall(M1(x, y));   return runtime.checkCall(M$.foo()) }; block$res1 = undefined; } catch (e) { console.log('\u200B' + e + '\u200B'); }
//│ >                                                 ^^^^^^
//│ ═══[COMPILATION ERROR] [Uncaught SyntaxError] Illegal return statement

:todo
