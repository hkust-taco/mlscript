fun foo(x, y) =
  object M with
    fun foo2() =
      set y = 2
      x + y
  fun foo3 = M.foo2()
  foo3
//│ ╔══[WARNING] Objects are not yet lifted.
//│ ║  l.105: 	  object M with
//│ ╙──       	         ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let foo3;
//│ define foo3 as fun foo3⁰(M) {
//│   return M.foo2⁰()
//│ };
//│ define foo⁴ as fun foo⁵(x, y) {
//│   let M;
//│   define M as object M¹ {
//│     method foo2¹ = fun foo2⁰() { set y = 2; return +⁰(x, y) }
//│   };
//│   return foo3⁰(M¹)
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect 12
foo(10, 0)
//│ = 12

