:lift
:js


// * Lifting an object may require it to gain some mutable fields

fun foo(x, y) =
  object M with
    val test = 2
    fun foo() =
      set y = 2
      x + y + test
  M.foo()

:expect 14
foo(10, 0)
//│ = 14

// * This works the same with classes.
// * Note that we currently generate accessors, which is not ideal;
// * When the captures are not accessed from the outside, we should be able to drop these.
:sjs
fun foo(y) =
  class M with
    fun foo() =
      set y = 2
  (new M).foo()
foo(10)
//│ JS (unsanitized):
//│ let M3, foo1, M$;
//│ M$ = function M$(isMut, y$0) {
//│   let tmp;
//│   if (isMut === true) {
//│     tmp = new M3(y$0);
//│   } else {
//│     tmp = globalThis.Object.freeze(new M3(y$0));
//│   }
//│   return tmp
//│ };
//│ M3 = class M2 {
//│   #y$0;
//│   get y$0() { return this.#y$0; }
//│   set y$0(value) { this.#y$0 = value; }
//│   constructor(y$0) {
//│     this.y$0 = y$0;
//│   }
//│   foo() {
//│     this.y$0 = 2;
//│     return runtime.Unit
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "M"]; 
//│ };
//│ foo1 = function foo(y) { let tmp; tmp = M$(false, y); return runtime.safeCall(tmp.foo()) };
//│ foo1(10)


// * `new mut` (or lack thereof) should be preserved by the lifter

fun foo(y) =
  class C with
    fun foo() =
      set y = 2
  [new C, new mut C]

let
  cc = foo(10)
  c0 = cc.0
  c1 = cc.1
//│ c0 = C
//│ c1 = C
//│ cc = [C, C]

:re
set c0.x = 1
c0.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

set c1.x = 1
c1.x
//│ = 1


// * Objects should remain non-`new mut`

fun foo(y) =
  object O with
    fun foo() =
      set y = 2
  O

let o = foo(10)
//│ o = O

:re
set o.x = 1
o.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'


:sjs
fun foo(x, y) =
  object M with
    fun foo2() =
      set y = 2
      x + y
  fun foo3 = M.foo2()
  foo3
//│ JS (unsanitized):
//│ let M5, foo31, foo4, foo3$, foo$capture3;
//│ foo3$ = function foo3$(M6, x, foo$capture4) {
//│   return M6.foo2()
//│ };
//│ foo31 = function foo3(M6, x, foo$capture4) {
//│   return () => {
//│     return foo3$(M6, x, foo$capture4)
//│   }
//│ };
//│ M5 = class M4 {
//│   #foo$capture$0;
//│   #x$1;
//│   get foo$capture$0() { return this.#foo$capture$0; }
//│   set foo$capture$0(value) { this.#foo$capture$0 = value; }
//│   get x$1() { return this.#x$1; }
//│   set x$1(value) { this.#x$1 = value; }
//│   constructor(x$1, foo$capture$0) {
//│     this.foo$capture$0 = foo$capture$0;
//│     this.x$1 = x$1;
//│   }
//│   foo2() {
//│     this.foo$capture$0.y0$ = 2;
//│     return this.x$1 + this.foo$capture$0.y0$
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "M"]; 
//│ };
//│ foo$capture3 = class foo$capture2 {
//│   constructor(y0$) {
//│     this.y0$ = y0$;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "foo$capture"]; 
//│ };
//│ foo4 = function foo(x, y) {
//│   let tmp2, M$1, capture;
//│   capture = new foo$capture3(y);
//│   M$1 = globalThis.Object.freeze(new M5(x, capture));
//│   tmp2 = foo3$(M$1, x, capture);
//│   return tmp2
//│ };

:expect 12
foo(10, 0)
//│ = 12


:sjs
data class A(x) with
  object M with
    fun getB() = x
  fun getA() = M.getB()
//│ JS (unsanitized):
//│ let M7, A1;
//│ M7 = class M6 {
//│   #A$instance$0;
//│   get A$instance$0() { return this.#A$instance$0; }
//│   set A$instance$0(value) { this.#A$instance$0 = value; }
//│   constructor(A$instance$0) {
//│     this.A$instance$0 = A$instance$0;
//│   }
//│   getB() {
//│     return this.A$instance$0.x
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "M"]; 
//│ };
//│ A1 = function A(x1) {
//│   return globalThis.Object.freeze(new A.class(x1));
//│ };
//│ Object.defineProperty(A1, "class", {
//│   enumerable: true,
//│   value: class A {
//│     constructor(x) {
//│       this.x = x;
//│       this.M$ = globalThis.Object.freeze(new M7(this));
//│     }
//│     getA() {
//│       return this.M$.getB()
//│     }
//│     toString() { return runtime.render(this); }
//│     static [definitionMetadata] = ["class", "A", ["x"]]; 
//│   }
//│ });

:expect 2
A(2).getA()
//│ = 2

// Classes and functions in modules //

:expect 2
module M with
  val x = 2
  class A() with
    fun get = x
  val hi = A()
M.hi.get
//│ = 2

:expect 2
module M with
  val x = 2
  fun f() =
    fun g() = x
    g
M.f()()
//│ = 2

:expect 2
object M with
  val x = 2
  class A() with
    fun get = x
  val hi = A()
M.hi.get
//│ = 2

:expect 2
object M with
  val x = 2
  fun f() =
    fun g() = x
    g
M.f()()
//│ = 2

:sjs
module M with
  class A() with
    fun get = M.x + x
  val x = if A() is A then 2 else 3
M.A().get
//│ JS (unsanitized):
//│ let M17, tmp5;
//│ (class M16 {
//│   static {
//│     M17 = M16;
//│     let scrut, tmp6;
//│     this.A = function A() {
//│       return globalThis.Object.freeze(new A.class());
//│     };
//│     Object.defineProperty(this.A, "class", {
//│       enumerable: true,
//│       value: class A5 {
//│         constructor() {}
//│         get get() {
//│           return M17.x + M16.x;
//│         }
//│         toString() { return runtime.render(this); }
//│         static [definitionMetadata] = ["class", "A", []]; 
//│       }
//│     });
//│     scrut = runtime.safeCall(M16.A());
//│     if (scrut instanceof M16.A.class) {
//│       tmp6 = 2;
//│     } else {
//│       tmp6 = 3;
//│     }
//│     this.x = tmp6;
//│   }
//│   static toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["module", "M"]; 
//│ });
//│ tmp5 = runtime.safeCall(M17.A());
//│ tmp5.get
//│ = 4

module M with
  val x = 2
  class A with
    fun get = x
  class B() extends A
M.B().get
//│ = 2

/// Top Level Modules ///

// newA should reference the class symbol
// newA_B should reference the BlockMemberSymbol
:lift
:sjs
module M with
  data class A(x) with
    class B() with
      fun get = x
      fun newA_B(y) = A(y)
    fun newA = A(42)
    fun newB = B()
  0 is A
M.A(2).newB.newA_B(3).newB.get
//│ JS (unsanitized):
//│ let B2, M21, tmp7, tmp8, B$;
//│ B$ = function B$(isMut, A$instance$0) {
//│   let tmp9, tmp10;
//│   if (isMut === true) {
//│     tmp9 = new B2.class();
//│   } else {
//│     tmp9 = globalThis.Object.freeze(new B2.class());
//│   }
//│   tmp10 = tmp9(A$instance$0);
//│   return tmp10
//│ };
//│ B2 = function B() {
//│   return (A$instance$01) => {
//│     return globalThis.Object.freeze(new B.class()(A$instance$01));
//│   }
//│ };
//│ Object.defineProperty(B2, "class", {
//│   enumerable: true,
//│   value: class B1 {
//│     #A$instance$0;
//│     get A$instance$0() { return this.#A$instance$0; }
//│     set A$instance$0(value) { this.#A$instance$0 = value; }
//│     constructor() {
//│       return (A$instance$0) => {
//│         this.A$instance$0 = A$instance$0;
//│         return this;
//│       }
//│     }
//│     get get() {
//│       return this.A$instance$0.x;
//│     } 
//│     newA_B(y) {
//│       return runtime.safeCall(M21.A(y))
//│     }
//│     toString() { return runtime.render(this); }
//│     static [definitionMetadata] = ["class", "B", []]; 
//│   }
//│ });
//│ (class M20 {
//│   static {
//│     M21 = M20;
//│     let scrut;
//│     this.A = function A(x1) {
//│       return globalThis.Object.freeze(new A.class(x1));
//│     };
//│     Object.defineProperty(this.A, "class", {
//│       enumerable: true,
//│       value: class A7 {
//│         constructor(x) {
//│           this.x = x;
//│         }
//│         get newA() {
//│           return runtime.safeCall(M20.A(42));
//│         } 
//│         get newB() {
//│           return B$(false, this);
//│         }
//│         toString() { return runtime.render(this); }
//│         static [definitionMetadata] = ["class", "A", ["x"]]; 
//│       }
//│     });
//│     scrut = 0;
//│     if (scrut instanceof M20.A.class) {
//│       true
//│     } else {
//│       false
//│     }
//│   }
//│   static toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["module", "M"]; 
//│ });
//│ tmp7 = runtime.safeCall(M21.A(2));
//│ tmp8 = runtime.safeCall(tmp7.newB.newA_B(3));
//│ tmp8.newB.get
//│ = 3

module M with
  class A
  object B extends A


:lift
fun foo(x) =
  object O with
    fun bar = x
    val baz = x
  [x === O.bar, set x += 1 in [x === O.bar, x === O.baz], x === O.bar]

foo(123)
//│ = [true, [true, false], true]

:sjs
module A with
  fun g = 1
  fun f = () => g
  f()
//│ JS (unsanitized):
//│ let A10, lambda;
//│ lambda = (undefined, function () {
//│   return A10.g
//│ });
//│ (class A9 {
//│   static {
//│     A10 = A9;
//│     A9.f();
//│   }
//│   static get g() {
//│     return 1;
//│   } 
//│   static get f() {
//│     return lambda;
//│   }
//│   static toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["module", "A"]; 
//│ });

module A with
  val a = (() => 1)()

// This is related to the above, but it will look into the ignored bms map
module A with
  val x =
    fun f() = 1
    f()

:sjs
module A with
  val x =
    fun f() = 1
    fun g() =
      fun h() = f()
      h()
    f() + g()
A.x
//│ JS (unsanitized):
//│ let h, A16, h$;
//│ h$ = function h$(f$member) {
//│   return f$member()
//│ };
//│ h = function h(f$member) {
//│   return () => {
//│     return h$(f$member)
//│   }
//│ };
//│ (class A15 {
//│   static {
//│     A16 = A15;
//│     let f, g2, tmp9, tmp10, tmp11;
//│     f = function f() {
//│       return 1
//│     };
//│     g2 = function g() {
//│       return h$(f)
//│     };
//│     tmp9 = f();
//│     tmp10 = g2();
//│     tmp11 = tmp9 + tmp10;
//│     this.x = tmp11;
//│   }
//│   static toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["module", "A"]; 
//│ });
//│ A16.x
//│ = 2

// private fields in modules
:fixme
module A with
  let x = 1
  fun mtd =
    fun nested() = x
    nested()
A.mtd
//│ ═══[COMPILATION ERROR] Uses of private fields cannot yet be lifted.
