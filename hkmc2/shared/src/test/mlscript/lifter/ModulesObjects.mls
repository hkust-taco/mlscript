//│     } else {
//│       tmp5 = 3;
//│     }
//│     this.x = tmp5;
//│   }
//│   static toString() { return "M"; }
//│ };
//│ tmp4 = M21.A();
//│ tmp4.get
//│ = 4

module M with
  val x = 2
  class A with
    fun get = x
  class B() extends A
M.B().get
//│ = 2

/// Top Level Modules ///

// newA should reference the class symbol
// newA_B should reference the BlockMemberSymbol
:lift
:sjs
module M with
  class A(x) with
    class B() with
      fun get = x
      fun newA_B(y) = A(y)
    fun newA = A()
    fun newB = B()
  0 is A
M.A(2).newB.newA_B(3).newB.get
