data class A(x) with
  object M with
    fun getB() = x
  fun getA() = M.getB()

:expect 2
A(2).getA()
//│ = 2

// Classes and functions in modules //

:expect 2
module M with
  val x = 2
  class A() with
    fun get = x
  val hi = A()
M.hi.get
//│ = 2

:expect 2
module M with
  val x = 2
  fun f() =
    fun g() = x
    g
M.f()()
//│ = 2

:expect 2
object M with
  val x = 2
  class A() with
    fun get = x
  val hi = A()
M.hi.get
