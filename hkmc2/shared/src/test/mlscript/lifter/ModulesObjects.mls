:lift
:js


// * Lifting an object may require it to gain some mutable fields

fun foo(x, y) =
  object M with
    val test = 2
    fun foo() =
      set y = 2
      x + y + test
  M.foo()
//│ FAILURE: Unexpected warning
//│ FAILURE LOCATION: applyValue (Lifter.scala:265)
//│ ═══[WARNING] Cannot yet lift class `M` as it is used as a first-class class.

:expect 14
foo(10, 0)
//│ = 14

// * This works the same with classes.
// * Note that we currently generate accessors, which is not ideal;
// * When the captures are not accessed from the outside, we should be able to drop these.
:sjs
fun foo(y) =
  class M with
    fun foo() =
      set y = 2
  (new M).foo()
foo(10)
//│ JS (unsanitized):
//│ let M2, foo1;
//│ (class M1 {
//│   static {
//│     M2 = this
//│   }
//│   constructor(y) {
//│     this.y = y;
//│   }
//│   #M$cap;
//│   foo() {
//│     this.y = 2;
//│     return runtime.Unit
//│   }
//│   toString() { return runtime.render(this); }
