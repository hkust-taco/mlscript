// * `new mut` (or lack thereof) should be preserved by the lifter

fun foo(y) =
  class C with
    fun foo() =
      set y = 2
  [new C, new mut C]

let
  cc = foo(10)
  c0 = cc.0
  c1 = cc.1
//│ c0 = C { foo$cap: Capture$foo { y$0: 10 } }
//│ c1 = C { foo$cap: Capture$foo { y$0: 10 } }
//│ cc = [
//│   C { foo$cap: Capture$foo { y$0: 10 } },
//│   C { foo$cap: Capture$foo { y$0: 10 } }
//│ ]

:re
set c0.x = 1
c0.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

set c1.x = 1
c1.x
//│ = 1


// * Objects should remain non-`new mut`

fun foo(y) =
  object O with
    fun foo() =
      set y = 2
  O

let o = foo(10)
//│ o = O { foo$cap: undefined, class: object O }

:re
set o.x = 1
o.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

