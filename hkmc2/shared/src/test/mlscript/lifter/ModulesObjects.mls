// Classes and functions in modules //

:expect 2
module M with
  val x = 2
  class A() with
    fun get = x
  val hi = A()
M.hi.get
//│ = 2

:expect 2
module M with
  val x = 2
  fun f() =
    fun g() = x
    g
M.f()()
//│ = 2

:expect 2
object M with
  val x = 2
  class A() with
    fun get = x
  val hi = A()
M.hi.get
//│ = 2

:expect 2
object M with
  val x = 2
  fun f() =
    fun g() = x
    g
M.f()()
//│ = 2

:sjs
module M with
  class A() with
    fun get = M.x + x
  val x = if A() is A then 2 else 3
M.A().get
