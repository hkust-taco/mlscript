// * Objects should remain non-`new mut`

fun foo(y) =
  object O with
    fun foo() =
      set y = 2
  O

let o = foo(10)
//│ o = O

:re
set o.x = 1
o.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

:sjs
fun foo(x, y) =
  object M with
    fun foo2() =
      set y = 2
      x + y
  fun foo3 = M.foo2()
  foo3
