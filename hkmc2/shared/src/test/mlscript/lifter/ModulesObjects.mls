fun foo(x, y) =
  object M with
    val test = 2
    fun foo() =
      set y = 2
      x + y + test
  M.foo()

:expect 14
foo(10, 0)
//│ = 14

:sjs
fun foo(x, y) =
  object M with
    fun foo2() =
      set y = 2
      x + y
  fun foo3 = M.foo2()
  foo3
//│ JS (unsanitized):
//│ let M9, foo31, foo4, foo3$, foo$capture1;
