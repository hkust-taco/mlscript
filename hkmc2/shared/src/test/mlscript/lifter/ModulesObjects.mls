:lift
:js


// * Lifting an object may require it to gain some mutable fields

fun foo(x, y) =
  object M with
    val test = 2
    fun foo() =
      set y = 2
      x + y + test
  M.foo()

:expect 14
foo(10, 0)
//│ = 14

// * This works the same with classes.
// * Note that we currently generate accessors, which is not ideal;
// * When the captures are not accessed from the outside, we should be able to drop these.
:sjs
fun foo(y) =
  class M with
    fun foo() =
      set y = 2
  (new M).foo()
foo(10)
//│ JS (unsanitized):
//│ let foo1;
//│ foo1 = function foo(y) {
//│   let M2, tmp;
//│   (class M1 {
//│     static {
//│       M2 = this
//│     }
//│     constructor() {}
//│     foo() {
//│       y = 2;
//│       return runtime.Unit
//│     }
//│     toString() { return runtime.render(this); }
//│     static [definitionMetadata] = ["class", "M"]; 
//│   });
//│   tmp = globalThis.Object.freeze(new M2());
//│   return tmp.foo()
//│ };
//│ foo1(10)


// * `new mut` (or lack thereof) should be preserved by the lifter

fun foo(y) =
  class C with
    fun foo() =
      set y = 2
  [new C, new mut C]

let
  cc = foo(10)
  c0 = cc.0
  c1 = cc.1
//│ c0 = C
//│ c1 = C
//│ cc = [C, C]

:re
set c0.x = 1
c0.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

set c1.x = 1
c1.x
//│ = 1


// * Objects should remain non-`new mut`

fun foo(y) =
  object O with
    fun foo() =
      set y = 2
  O

let o = foo(10)
//│ o = O

:re
set o.x = 1
o.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

:sjs
fun foo(x, y) =
  object M with
    fun foo2() =
      set y = 2
      x + y
  fun foo3 = M.foo2()
  foo3
//│ JS (unsanitized):
//│ let foo4;
//│ foo4 = function foo(x, y) {
//│   let M3, foo31, tmp;
//│   foo31 = function foo3() {
//│     return M3.foo2()
//│   };
//│   (class M2 {
//│     static {
//│       new this
//│     }
//│     constructor() {
//│       M3 = this;
//│       Object.defineProperty(this, "class", {
//│         value: M2
//│       });
//│       globalThis.Object.freeze(this);
//│     }
//│     foo2() {
//│       y = 2;
//│       return x + y
//│     }
//│     toString() { return runtime.render(this); }
//│     static [definitionMetadata] = ["object", "M"]; 
//│   });
//│   tmp = foo31();
//│   return tmp
//│ };

:expect 12
foo(10, 0)
//│ = 12


data class A(x) with
  object M with
    fun getB() = x
  fun getA() = M.getB()

:expect 2
A(2).getA()
//│ = 2

// Classes and functions in modules //

:expect 2
module M with
  val x = 2
  class A() with
    fun get = x
  val hi = A()
M.hi.get
//│ FAILURE: Unexpected warning
//│ FAILURE LOCATION: createMetadata (Lifter.scala:294)
//│ ╔══[WARNING] Modules are not yet lifted.
//│ ║  l.147: 	module M with
//│ ╙──       	       ^
//│ = 2

:expect 2
module M with
  val x = 2
  fun f() =
    fun g() = x
    g
M.f()()
//│ FAILURE: Unexpected warning
//│ FAILURE LOCATION: createMetadata (Lifter.scala:294)
//│ ╔══[WARNING] Modules are not yet lifted.
//│ ║  l.161: 	module M with
//│ ╙──       	       ^
//│ = 2

:expect 2
object M with
  val x = 2
  class A() with
    fun get = x
  val hi = A()
M.hi.get
//│ = 2

:expect 2
object M with
  val x = 2
  fun f() =
    fun g() = x
    g
M.f()()
//│ = 2

:sjs
module M with
  class A() with
    fun get = M.x + x
  val x = if A() is A then 2 else 3
M.A().get
