:..
:.


:expect 2
fun f(x) =
  let =x
  class A()() with
    fun newA() = A()()
    fun foo() =
      set x += 1
      x
    fun getX() = x
  A()()
let a = f(0)
a.foo()
let b = a.newA()
b.foo()
a.getX()
//│ = 2
//│ a = A()
//│ b = A()


// * Notice how the capture parameter `f$cap` is inserted before the aux param `z` but after the main param `y`
:soir
fun f(x) =
  let =x
  class A(val y)(val z) with
    fun newA() = new A(y + 1)(z + 1)
    fun foo() =
      set x += 1
      x
    fun getX() = x
  [new A(x + 1)(x + 2), A, A(x + 1), A(x + 1)(x + 2)]
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let A, Capture$scope0, A$;
//│ define Capture$scope0 as class Capture$scope0¹ {
//│   constructor Capture$scope0⁰(x$0) {
//│     define x$0⁰ as val x$0¹ = x$0;
//│     end
//│   }
//│ };
//│ @inline
//│ define A$ as fun A$⁰(scope0$cap)(y)(z) {
//│   return new A⁰(y, scope0$cap, z)
//│ };
//│ define A as class A⁰ {
//│   private val scope0$cap⁰;
//│   val y⁰;
//│   val z⁰;
//│   constructor A¹(y, scope0$cap, z) {
//│     set A⁰.this.scope0$cap⁰ = scope0$cap;
//│     define y⁰ as val y¹ = y;
//│     define z⁰ as val z¹ = z;
//│     end
//│   }
//│   method newA⁰ = fun newA¹() {
//│     let tmp, tmp1;
//│     set tmp = +⁰(A⁰.this.y¹, 1);
//│     set tmp1 = +⁰(A⁰.this.z¹, 1);
//│     return new A⁰(tmp, A⁰.this.scope0$cap⁰, tmp1)
//│   }
//│   method foo⁰ = fun foo¹() {
//│     let tmp;
//│     set tmp = +⁰(A⁰.this.scope0$cap⁰.x$0¹, 1);
//│     set A⁰.this.scope0$cap⁰.x$0¹ = tmp;
//│     return A⁰.this.scope0$cap⁰.x$0¹
//│   }
//│   method getX⁰ = fun getX¹() {
//│     return A⁰.this.scope0$cap⁰.x$0¹
//│   }
//│ };
//│ define f⁰ as fun f¹(x) {
//│   let tmp, tmp1, tmp2, tmp3, tmp4, tmp5, tmp6, tmp7, scope0$cap, A$here;
//│   set scope0$cap = new mut Capture$scope0¹(undefined);
//│   set scope0$cap.x$0¹ = x;
//│   set tmp = +⁰(scope0$cap.x$0¹, 1);
//│   set tmp1 = +⁰(scope0$cap.x$0¹, 2);
//│   set tmp2 = new A⁰(tmp, scope0$cap, tmp1);
//│   set tmp3 = +⁰(scope0$cap.x$0¹, 1);
//│   set tmp4 = A$⁰(scope0$cap)(tmp3);
//│   set tmp5 = +⁰(scope0$cap.x$0¹, 1);
//│   set tmp6 = +⁰(scope0$cap.x$0¹, 2);
//│   set tmp7 = new A⁰(tmp5, scope0$cap, tmp6);
//│   set A$here = A$⁰(scope0$cap);
//│   return [tmp2, A$here, tmp4, tmp7]
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let res = f(0)
//│ res = [A(1), fun, fun, A(1)]

:expect [2, 2]
let a = res.0
a.foo()
let b = a.newA()
b.foo()
[a.getX(), b.getX()]
//│ = [2, 2]
//│ a = A(1)
//│ b = A(2)

res.1(10)(20).foo()
//│ = 3

let a1 = res.2(20)
//│ a1 = A(1)

a1.foo()
//│ = 4

:expect 20
a1.z
//│ = 20

let a2 = res.2(30)
//│ a2 = A(1)

a2.z
//│ = 30

:expect 20
a1.z
//│ = 20

a.getX()
//│ = 4
