:.
:js


let arr = [true, false]
//│ arr = [true, false]


// * Array methods supply extra arguments, such as the index and the array itself,
// * which callbacks may ignore
arr.map(=> _ === false)
//│ = [false, true]

:sjs
arr.map((e, ...) => e === false)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let lambda1;
//│ lambda1 = (undefined, function (e, ..._) {
//│   return e === false
//│ });
//│ return runtime.safeCall(arr.map(lambda1))
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [false, true]

:sjs
arr.map((_, ...) => 1)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let lambda2;
//│ lambda2 = (undefined, function (_, ..._1) { return 1 });
//│ return runtime.safeCall(arr.map(lambda2))
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [1, 1]

:e
arr.map((..., ...) => 1)
//│ ╔══[COMPILATION ERROR] A parameter list cannot have more than one variadic parameter.
//│ ║  l.+1: 	arr.map((..., ...) => 1)
//│ ╙──      	              ^^^
//│ = [1, 1]

:expect [[true, false], [true, false]]
arr.map((..., e) => e)
//│ = [[true, false], [true, false]]

arr.map(pass1(=> _ === false))
//│ = [false, true]


[1,3,2].map((x, _, _) => x + 1).sort()
//│ = [2, 3, 4]

[1,3,2].map((x, _, _) => x + 1)
  .sort()
//│ = [2, 3, 4]


Array
//│ = class Array

Array(1)
//│ = [<1 empty items>]

:e
Array()
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+1: 	Array()
//│ ║        	^^^^^^^
//│ ╟── Constructor of class 'Array' expected 1 argument, but got 0
//│ ║  in ../decls/Prelude.mls
//│ ║  l.XX: 	declare class Array[T](val length: Int) {
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = []

:e
Array(1, 2, 3)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+1: 	Array(1, 2, 3)
//│ ║        	^^^^^^^^^^^^^^
//│ ╟── Constructor of class 'Array' expected 1 argument, but got 3
//│ ║  in ../decls/Prelude.mls
//│ ║  l.XX: 	declare class Array[T](val length: Int) {
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = [1, 2, 3]


if arr is Array then "ok"
//│ = "ok"

:expect 2
if arr is Array(n) then n
//│ = 2

