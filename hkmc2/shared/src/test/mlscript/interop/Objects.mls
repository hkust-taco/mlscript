:js


let rcd = { x: 0, y: undefined, z: null}
//│ rcd = {x: 0, y: undefined, z: null}

rcd.constructor
//│ = class Object

typeof(rcd.constructor)
//│ = "function"

Object.entries of rcd
//│ = [["x", 0], ["y", undefined], ["z", null]]


class Foo(val x, val y) with
  let z = 2
  val a = 3
  fun f = 4
  fun g() = 5

let foo = Foo(1,2)
//│ foo = Foo(1, 2)


Object.entries of Foo
//│ = [["class", class Foo]]

Object.entries of foo
//│ = [["x", 1], ["y", 2], ["a", 3]]

Foo.name
//│ = "Foo"

Foo.class.name
//│ = "Foo"

foo.constructor
//│ = class Foo

// ! will be changed by minification
foo.constructor.name
//│ = "Foo"

typeof(foo)
//│ = "object"

typeof(foo.constructor)
//│ = "function"


