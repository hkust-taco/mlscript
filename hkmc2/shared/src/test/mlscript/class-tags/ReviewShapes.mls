:classTags mono
:js
:noFreeze

class Box(val x)
class MutableBox(mut val x)
class A(val x)
class B(val x)

// Unknown incoming values must be rejected or checked, not silently discarded
// when proving exhaustiveness from the known constructor sources.
fun unknownAlternative(flag, external) =
  let value = if flag > 0 then new A(0) else if flag < 0 then new B(0) else external
  @matchShapes(A(_), B(_)) shape.match of value, () => 1, () => 2

:fixme // The untagged external B falls through both tag checks and returns unit.
:expect 2
unknownAlternative(0, new B(0))
//│ ═══[RUNTIME ERROR] Expected: '2', got: '()'
