class D(val x)
class E(val x)
class Pair(val x, val y)
fun pair(x, y) =
  let p = new Pair(
    if x then new D(1) else new E(2),
    if y then new D(3) else new E(4))
  @matchShapes(Pair(D(_), D(_)), Pair(D(_), E(_)), Pair(E(_), D(_)), Pair(E(_), E(_)))
  shape.match of p,
    () => 0
    () => 1
    () => 2
    () => 3
