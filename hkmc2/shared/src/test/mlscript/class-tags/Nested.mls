class C(val x)
class D(val x)
class E(val x)
fun foo(x, y) =
  let t = if y then new C(new D(x)) else new C(new E(1))
  foofoo(t)
private fun foofoo(t) =
  @matchShapes(C(D(_)), C(E(1))) shape.match of t,
    () => t.C#x.D#x + 1
    () => 0
