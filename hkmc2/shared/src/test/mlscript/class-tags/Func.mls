private fun foo(x) =
  if x then new C(0) else new D(0)
fun bar(x, y) =
  let t = foo(x)
  let m = if y then new Foo(t, 0) else new Bar(t)
  @matchShapes(Foo(C(0), 0), Bar(C(0)), Foo(D(0), 0), Bar(D(0))) shape.match of m,
    () => 1
    () => 2
    () => 3
    () => 4
