:ssjs
class Foo(val x, val y)
class Bar(val x)
fun f(x) =
  let t = if x then new Foo(x, 0) else new Bar(x)
  @matchShapes(Foo(_, 0), Bar(_)) shape.match of t,
    () => g(t)
    () => h(t)
private fun g(t) = t.Foo#x
private fun h(t) = t.Bar#x
