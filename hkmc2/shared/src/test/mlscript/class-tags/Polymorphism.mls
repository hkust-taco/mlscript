:classTags debug
:js
:noFreeze

//│ >>> start class-tags collection-phase
//│ <<< end class-tags collection-phase
//│ >>> start class-tags transform-phase
//│ <<< end class-tags transform-phase
class Box(val x)
class A(val x)
class B(val x)
//│ >>> start class-tags collection-phase
//│ <<< end class-tags collection-phase
//│ >>> start class-tags transform-phase
//│ <<< end class-tags transform-phase


:ssjs
private fun wrap(x) = new Box(x)
fun poly(flag) =
  let a = wrap(new A(0))
  let b = wrap(new B(0))
  let value = if flag then a else b
  @matchShapes(Box(A(_)), Box(B(_))) shape.match of value, () => 1, () => 2
