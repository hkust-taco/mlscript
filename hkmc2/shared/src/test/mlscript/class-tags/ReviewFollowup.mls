:classTags mono
:js

:ge
class Box(val x)
class A(val x)
class B(val x)
fun unknownThroughField(flag, external) =
  let local = new A(0)
  let holder = new Box(local)
  let _ = @matchShapes(Box(_)) shape.match of holder, () => 0
  let value = if flag then local else external
  @matchShapes(A(_), B(_)) shape.match of value, () => 1, () => 2
unknownThroughField(false, new B(0))
//│ ╔══[COMPILATION ERROR] The scrutinee of this shape.match may be a value built outside this module, which carries no class tag.
//│ ║  l.13: 	  @matchShapes(A(_), B(_)) shape.match of value, () => 1, () => 2
//│ ║        	               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Only values constructed in this module can be dispatched on by their class tags.
//│ ║  l.13: 	  @matchShapes(A(_), B(_)) shape.match of value, () => 1, () => 2
//│ ╙──      	                                          ^^^^^
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'match')


// Immutable parameter declarations do not prevent a constructor from writing a dynamic field.
class A(val x)
class B(val x)
class Rewritten(val x) with
  set this.("x") = new B(0)
fun rewrittenConstructor() =
  let value = new Rewritten(new A(0))
  @matchShapes(Rewritten(A(_)), Rewritten(B(_))) shape.match of value, () => 1, () => 2

:fixme
:expect 2
rewrittenConstructor()
//│ ═══[RUNTIME ERROR] Expected: '2', got: '1'
//│ = 1


// Every shape.match call must be checked, including calls with no branches.
:breakme
:ge
class Box(val x)
fun zeroBranches() =
  let value = new Box(0)
  @matchShapes(Box(_)) shape.match of value

:fixme
zeroBranches()
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'match')


class Box(val x)
fun returnedThunk() =
  let value = new Box(0)
  let result = @matchShapes(Box(_)) shape.match of value, () => () => 42
  result()

:expect 42
returnedThunk()
//│ = 42


// Anonymous branches preserve an ordinary recursive call without expanding it indefinitely.
class Box(val x)
fun recursiveLambdaBranch(n) =
  if n > 0 then
    let value = new Box(0)
    @matchShapes(Box(_)) shape.match of value, () => recursiveLambdaBranch(n - 1)
  else 42

:expect 42
recursiveLambdaBranch(2)
//│ = 42
