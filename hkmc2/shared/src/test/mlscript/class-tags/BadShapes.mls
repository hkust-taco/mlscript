// A tag derived from constructor arguments becomes stale after a field write.
// The flow analysis marks the escape, but web traversal still admits this producer.
:ge
class MutableBox(mut val x)
class A(val x)
class B(val x)
fun mutatedField() =
  let value = new MutableBox(new A(0))
  set value.MutableBox#x = new B(0)
  @matchShapes(MutableBox(A(_)), MutableBox(B(_))) shape.match of value, () => 1, () => 2
