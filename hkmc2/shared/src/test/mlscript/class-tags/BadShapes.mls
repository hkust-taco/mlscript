//│ ╙──       	                       ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ <<< end class-tags transform-phase


// this would not happen in the generated code
// since bar(false) should be specialized and become another function
:ge
private fun bar(x) =
  if x then new C(bar(false)) else new D(0)
fun foo() =
  let value = bar(true)
  @matchShapes(C(_), D(_)) shape.match of value,
    () => 1
    () => 0
