let remaining = 1
private fun recursiveBranch() =
  if remaining > 0 then
    set remaining = remaining - 1
    let value = new Box(0)
    @matchShapes(Box(_)) shape.match of value, recursiveBranch
  else 42
fun recursiveMatch() = recursiveBranch()
