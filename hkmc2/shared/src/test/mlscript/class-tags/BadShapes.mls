:ge
fun unknownAlternative(flag, external) =
  let value = if flag > 0 then new A(0) else if flag < 0 then new B(0) else external
  @matchShapes(A(_), B(_)) shape.match of value, () => 1, () => 2
//│ >>> start class-tags collection-phase
//│ <<< end class-tags collection-phase
//│ >>> start class-tags transform-phase
