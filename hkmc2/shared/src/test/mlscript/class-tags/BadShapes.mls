class MutableBox(mut val x)
class A(val x)
class B(val x)
//│ >>> start class-tags collection-phase
//│ <<< end class-tags collection-phase
//│ >>> start class-tags transform-phase
//│ <<< end class-tags transform-phase


// A tag derived from constructor arguments becomes stale after a field write.
// The flow analysis marks the escape, but web traversal still admits this producer.
:ge
fun mutatedField() =
  let value = new MutableBox(new A(0))
  set value.MutableBox#x = new B(0)
  @matchShapes(MutableBox(A(_)), MutableBox(B(_))) shape.match of value, () => 1, () => 2
//│ >>> start class-tags collection-phase
//│ <<< end class-tags collection-phase
//│ >>> start class-tags transform-phase
//│ ╔══[COMPILATION ERROR] Class tags do not support set operations yet.
//│ ║  l.133: 	  set value.MutableBox#x = new B(0)
//│ ╙──       	      ^^^^^
//│ class-tags transform-phase > match shapes MutableBox(x: A(x: _)), MutableBox(x: B(x: _)) against <none>
//│ ╔══[COMPILATION ERROR] Annotated shape.match has no tagged class shapes for its scrutinee.
//│ ║  l.134: 	  @matchShapes(MutableBox(A(_)), MutableBox(B(_))) shape.match of value, () => 1, () => 2
//│ ╙──       	               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ <<< end class-tags transform-phase


// Constructor bodies can change fields even before the tag is first assigned.
:ge
class Altered(mut val x) with
  set x = new B(0)
fun constructorMutation() =
  let value = new Altered(new A(0))
  @matchShapes(Altered(A(_)), Altered(B(_))) shape.match of value, () => 1, () => 2
//│ >>> start class-tags collection-phase
//│ class-tags collection-phase > track construction of Altered@1 in constructorMutation
//│ class-tags collection-phase > track consumption at match@2 in constructorMutation
//│ <<< end class-tags collection-phase
//│ >>> start class-tags web-computation-phase
