//│ ╙──       	               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ <<< end class-tags transform-phase


// A consumer must not pull a constructor that escapes the function back into a web.
:ge
fun escapingAlternative() =
  let value = new A(0)
  let _ = @matchShapes(A(_)) shape.match of value, () => 1
  value
//│ >>> start class-tags collection-phase
//│ <<< end class-tags collection-phase
