// Reusing a two-way union in nine fields would flatten to 2^9 concrete shapes.
:ge
class TooManyShapes(val a, val b, val c, val d, val e, val f, val g, val h, val i)
fun flattenBudget(flag) =
  let field = if flag then new A(0) else new B(0)
  let value = new TooManyShapes(field, field, field, field, field, field, field, field, field)
  @matchShapes(TooManyShapes(_, _, _, _, _, _, _, _, _)) shape.match of value, () => 1
