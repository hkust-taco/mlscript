:ssjs
fun foo(x, y) =
  let f = new Foo(x, y)
  baz(f)
fun bar(x) =
  let b = new Bar(x)
  baz(b)
private fun baz(t) =
  @matchShapes(Foo(_, _), Bar(_)) shape.match of t,
    () => t.Foo#x + t.Foo#y
    () => t.Bar#x
