module Baz with
  fun bar(x) = new Bar(x)
  private fun barr(x) =
    let f = new Foo(x, x)
    if f is
      Foo(x, y) then new Bar(x + y)
  fun baz(x) =
    let f = new Foo(x, x)
    @matchShapes(Foo(_, _)) shape.match of f, () => new Bar(f.Foo#x + f.Foo#y)
