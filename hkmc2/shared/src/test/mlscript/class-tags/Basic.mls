class C(val x)
fun tupleLength(flag, a, b, c) =
  let t = if flag then [a, b] else [a, b, c]
  let v = new C(t)
  @matchShapes(C([_, _]), C([_, _, _])) shape.match of v, () => "two", () => "three"
