:ssjs
fun foo(x, y) =
  let f = new Foo(x, y)
  bar(f) * baz(f)
private fun bar(f) =
  @matchShapes(Foo(_, _)) shape.match of f, () => f.Foo#x + f.Foo#y
private fun baz(f) =
  @matchShapes(Foo(_, _)) shape.match of f, () => f.Foo#x - f.Foo#y
