class C(val x)
class D(val x)
class E(val x)
class F(val x)
//│ >>> start class-tags collection-phase
//│ <<< end class-tags collection-phase
//│ >>> start class-tags transform-phase
//│ <<< end class-tags transform-phase

:ge
fun foo(x) = @matchShapes(C(D(_)), C(E(1)), F(_)) shape.match of x,
  () => x.C#x.D#x + 1,
  () => x.C#x.E#x - 1,
  () => x.F#x
