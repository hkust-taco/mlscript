:classTags mono
:js
:noFreeze

class Box(val x)
class A(val x)
class B(val x)


// One covered entry must not suppress every other independent entry in a function.
// Visiting inspect covers the Box web, but does not cover either the A or B web.
:fixme // Both independent matches are rejected as having no tagged class shapes.
private fun inspect(value) =
  @matchShapes(Box(_)) shape.match of value, () => 0
fun first() =
  inspect(new Box(0))
  let value = new A(0)
  @matchShapes(A(_)) shape.match of value, () => 1
fun second() =
  inspect(new Box(0))
  let value = new B(0)
  @matchShapes(B(_)) shape.match of value, () => 2
//│ ╔══[COMPILATION ERROR] Annotated shape.match has no tagged class shapes for its scrutinee.
//│ ║  l.18: 	  @matchShapes(A(_)) shape.match of value, () => 1
//│ ╙──      	               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Annotated shape.match has no tagged class shapes for its scrutinee.
//│ ║  l.22: 	  @matchShapes(B(_)) shape.match of value, () => 2
//│ ╙──      	               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
