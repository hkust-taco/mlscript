:ssjs
class C(val x)
class E(val x)
class F(val y) extends E(0)
fun foo(x, y) =
  let t = if y then new C(new E(x)) else new C(new F(1))
  inspect(t)
private fun inspect(t) =
  @matchShapes(C(F(_)), C(E(_))) shape.match of t,
    () => t.C#x.E#x
    () => t.C#x.F#y
