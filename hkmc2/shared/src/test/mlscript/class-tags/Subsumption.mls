class C(val x)
class D(val x)
class E(val x)
private fun foo(x, y) =
  let t = new C(if y then new D(x) else new E(1))
  inspect(t)
private fun inspect(t) =
  @matchShapes(C(_)) shape.match of t,
    () => t.C#x
