:todo
:sjs
abstract class List
class Nil extends List
class Cons(val head, val tail: List) extends List
fun (::) cons(spec head, tail: List) = Cons(head, tail)
fun fold(f, list, acc) = if list is
    Cons then fold(f, list.tail, f(acc, list.head))
    else acc
val l = 1 :: 2 :: 3 :: Nil
fun add(spec x, spec y) = x + y
val sum = fold(add, l, 0)
