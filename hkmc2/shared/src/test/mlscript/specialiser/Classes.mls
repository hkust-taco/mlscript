:js


class Simple(val x) with
    fun inner = x
val s = Simple(1)
s.inner
//│ = 1
//│ s = Simple(1)

abstract class Option
class None extends Option
class Some(val x) extends Option with
    fun unwrap = x
Some(1).unwrap
//│ = 1


