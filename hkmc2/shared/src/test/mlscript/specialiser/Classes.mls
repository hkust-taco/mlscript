abstract class List[T]
class Nil extends List
class Cons[T](val head: T, val tail: List[T]) extends List[T]
fun (::) cons[T](spec head: T, tail: List[T]) = Cons(head, tail)
1 :: 2 :: 3 :: Nil
//│ = Cons(1, Cons(2, Cons(3, class Nil extends List1 {   constructor() {     super();   }   toString() { return "Nil"; } })))
