fun assertModule(module m: ClsMod): module ClsMod = m

assertModule(ClsMod).whoami
//│ = "module"

assertModule(TypMod).whoami
//│ = "module"

:fixme
:noInline
print(assertModule(TrmMod).whoami)
//│ ═══[RUNTIME ERROR] TypeError: Class constructor TrmMod cannot be invoked without 'new'

// TODO: handle
print(assertModule(TrmMod).whoami)
//│ > undefined


fun assertNonModule(m) = m

// FIXME: should not resolve to module's `.whoami`, hence should be an error
:breakme
assertNonModule(ClsMod).whoami
//│ = "module"

// FIXME: should not resolve to module's `.whoami`, hence should be an error
:breakme
assertNonModule(TypMod).whoami
//│ = "module"

