fun assertModule(module m: ClsMod): module ClsMod = m

assertModule(ClsMod).whoami
//│ = "module"

assertModule(TypMod).whoami
//│ = "module"

assertModule(TrmMod).whoami
//│ = "module"


fun assertNonModule(m) = m

