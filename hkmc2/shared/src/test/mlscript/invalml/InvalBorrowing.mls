  use_(r)
  integers(r) of it =>
    use_(r)
    next(it)
  use_(r)
  r
//│ ╔══[COMPILATION ERROR] Type error in block
//│ ║  l.122: 	letreg of r =>
//│ ║         	^^^^^^^^^^^^^^
