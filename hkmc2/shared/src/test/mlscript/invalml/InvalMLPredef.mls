// InvalML-specific support extends the shared host declarations in decls/Prelude.mls.
// Staging and region types, and the operator signatures below, belong to its type system.

open annotations

declare class Unit

data
  class
    CodeBase[T, C, S]
    Region[T]
    Ref[T, S](reg: Region[T], value: S)

@untyped
set
  globalThis.CodeBase = CodeBase
  globalThis.Region = Region
  globalThis.Ref = (r, v) => new mut Ref(r, v)

declare fun run[T](code: CodeBase[out T, out Nothing, out Any]): T
declare fun log(message: Str): Any
declare fun error: Nothing

declare fun (+)(left: Int, right: Int): Int
declare fun (-)(left: Int, right: Int): Int
declare fun (*)(left: Int, right: Int): Int
declare fun (/)(left: Int, right: Int): Num
declare fun (+.)(left: Num, right: Num): Num
declare fun (-.)(left: Num, right: Num): Num
declare fun (*.)(left: Num, right: Num): Num
declare fun (/.)(left: Num, right: Num): Num

declare fun (<)(left: Int, right: Int): Bool
declare fun (>)(left: Int, right: Int): Bool
declare fun (<=)(left: Int, right: Int): Bool
declare fun (>=)(left: Int, right: Int): Bool
declare fun (==)[T](left: T, right: T): Bool
declare fun (!=)[T](left: T, right: T): Bool
declare fun (===)[T](left: T, right: T): Bool
declare fun (!==)[T](left: T, right: T): Bool

declare fun (&&)(left: Bool, right: Bool): Bool
declare fun (||)(left: Bool, right: Bool): Bool


fun print(value) = @untyped globalThis.console.log(value)
