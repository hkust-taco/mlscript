letreg of r =>
  use_(r)
  integers(r) of it =>
    next(it)
  use_(r)
  r
//│ Type: Reg[?, 'E]
//│ Where:
//│   'E <: ⊥

:e
letreg of r =>
  use_(r)
  integers(r) of it =>
    use_(r)
    next(it)
  use_(r)
  r
//│ ╔══[COMPILATION ERROR] Type error in block
//│ ║  l.130: 	letreg of r =>
//│ ║         	^^^^^^^^^^^^^^
//│ ║  l.131: 	  use_(r)
//│ ║         	^^^^^^^^^
