letreg of r0 =>
  letreg of r1 =>
    integers(r1) of it =>
      use_(r0)
      next(it)
    use_(r1)
    r1
//│ Type: Reg[?, in 'E]
//│ Where:
//│   'E <: ⊥


// * Can leak the iterator
:w
fun iterate_unsafe: [A, Rg, Br, Res] -> MutVec[A, Rg, Br] -> (Iter[A, Br] ->{Br} Res) ->{Br} Res
// * Eg:
letreg of r =>
  let b = mkVec(r)
  clear(b)
  let k = iterate_unsafe(b) of it =>
    next(it)
    123
    () => next(it)
  clear(b)
  k()
//│ ╔══[WARNING] Pure expression in statement position
//│ ║  l.177: 	    123
//│ ╙──       	    ^^^
//│ Type: ⊥

