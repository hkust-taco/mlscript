fun borrow: [Rg, Br, Res] -> Reg[Rg, Br] ->{Rg} (() ->{Br | ~Rg} Res) ->{Br} Res

letreg of r =>
  read(r)
  borrow(r) of () =>
    read(r)
  write(r)
//│ Type: Int


