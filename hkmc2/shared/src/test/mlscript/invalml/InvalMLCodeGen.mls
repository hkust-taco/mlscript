fun pow(x) = case
  0 then 1
  n then x * pow(x)(n-1)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let pow, lambda$, pow_lambda_lambda$;
//│ pow_lambda_lambda$ = function pow_lambda_lambda$(id, param0, param1) {
//│   loopLabel: while (true) {
//│     switch (id) {
//│       case 0:
//│         return lambda$(param0);
//│       case 1:
//│         {
//│           let baseCall, tmp, tmp1;
//│           if (param1 === 0) {
//│             return 1
//│           }
//│           baseCall = pow(param0);
//│           tmp = param1 - 1;
//│           tmp1 = runtime.safeCall(baseCall(tmp));
//│           return param0 * tmp1;
//│         }
//│       case 2:
//│         id = 1;
//│         continue loopLabel;
//│     }
//│     break;
//│   }
//│ };
//│ lambda$ = (undefined, function (x) {
//│   return (caseScrut) => {
//│     return pow_lambda_lambda$(2, x, caseScrut)
//│   }
//│ });
//│ pow = function pow(x) { return pow_lambda_lambda$(0, x, undefined) };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


