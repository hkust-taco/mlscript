:.


fun greet(name: Str, greeting?: Str) =
  (if greeting is null then "Hello, " else greeting + ", ") + name
print \ greet("Ana")             // prints: Hello, Ana
print \ greet("Ana", "Hi")       // prints: Hi, Ana
//│ > Hello, Ana
//│ > Hi, Ana

