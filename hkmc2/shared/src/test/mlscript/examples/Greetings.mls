:fixme
fun add(x, ...xs) = xs.reduce(=> _ + _, x)
//│ ╔══[COMPILATION ERROR] This selection of member 'reduce' has no resolved target
//│ ║  l.27: 	fun add(x, ...xs) = xs.reduce(=> _ + _, x)
//│ ╙──      	                    ^^^^^^^^^

fun add(x, ...xs: Array) = xs.reduce(=> _ + _, x)

fun greet(name, opts?) =
  add
  \ if opts is {:greeting} then greeting + ", " else "Hello, "
  \ name
  \ if opts is {:loud} and loud then "!" else ""

print \ greet("Ana")             // prints: Hello, Ana
print \ greet("Ana", greeting: "Hi")       // prints: Hi, Ana
print \ greet("Ana", loud: true)       // prints: Hi, Ana
//│ > Hello, Ana
//│ > Hi, Ana
//│ > Hello, Ana!

greet("Ana")
  \ greeting: "Hi"
  \ loud: true
//│ = "Hi, Ana!"


