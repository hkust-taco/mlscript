//│ x = 1

let x
= 1
//│ x = 1


2
  + 1
* 2
//│ = 6

2
  |> (a: _)
  .a
//│ = 2

:re
2
  |> (a: _)
    .a
//│ ═══[RUNTIME ERROR] Error: Access to required field 'a' yielded 'undefined'

:pe
2
  |> (a: _)
.a
//│ ╔══[PARSE ERROR] Expected an expression; found selector instead
//│ ║  l.154: 	.a
//│ ╙──       	^^
//│ ╔══[PARSE ERROR] Expected end of input; found selector instead
//│ ║  l.154: 	.a
//│ ╙──       	^^


// :dp
2
    * 1
  + 2
//│ = 4

// :dp
2
    * 1
      + 2
//│ = 4

2
    * 1
      + 2
      + 2
//│ = 6

2
    * 1
      + 2
    + 2
//│ = 6

// :dp
2 {+ 1} * 2
//│ = 4

{2
  + 1} * 2
//│ = 6

{2 { + 1 }} * 2
//│ = 6

2 { * 1 { + 2 } }
//│ = 4

// :dp
2
    + 1
      * 2
//│ = 4

2
    + 1
      * 2
      * 2
//│ = 6

2
    + 1
      * 2
    * 2
//│ = 8


2
    + 1
      |> print
//│ > 3

2
    + 1
    + 1
      |> print
//│ > 4

2
    + 1 |> print
//│ > 3

2
    + 1
    + 1 |> print
//│ > 4

2
    + 1
  |> print
//│ > 3

let incr = _ + 1
//│ incr = [function incr]

// :dp
2
    + 1
    + 1
  |> print
//│ > 4

2
    + 1
    + 1
  |> incr
  |> print
//│ > 5

2
    + 1
    + 1
  |> incr
    |> print
//│ > 5

2
      + 1
      + 1
    |> incr
  |> print
//│ > 5

// Uh...
2
      + 1
      !> print
      + 1
    |> incr
      !> print
  |> print
//│ > 3
//│ > 5
//│ > 5


