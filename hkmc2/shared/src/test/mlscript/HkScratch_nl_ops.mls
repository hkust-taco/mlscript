// :dp
2
    * 1
  + 2
//│ = 4

// :dp
2
    * 1
      + 2
//│ = 4

2
    * 1
      + 2
      + 2
//│ = 6

2
    * 1
      + 2
    + 2
//│ = 6

// :dp
2 {+ 1} * 2
//│ = 4

{2
  + 1} * 2
//│ = 6

{2 { + 1 }} * 2
//│ = 6

2 { * 1 { + 2 } }
//│ = 4

// :dp
2
    + 1
      * 2
//│ = 4

2
    + 1
      * 2
      * 2
//│ = 6

2
    + 1
      * 2
    * 2
//│ = 8


2
    + 1
      |> print
//│ > 3

2
    + 1
    + 1
      |> print
//│ > 4

2
    + 1 |> print
//│ > 3

2
    + 1
    + 1 |> print
//│ > 4

2
    + 1
  |> print
//│ > 3

let incr = _ + 1
//│ incr = [function incr]

// :dp
2
    + 1
    + 1
  |> print
//│ > 4

2
    + 1
    + 1
  |> incr
  |> print
//│ > 5

2
    + 1
    + 1
  |> incr
    |> print
//│ > 5

2
      + 1
      + 1
    |> incr
  |> print
//│ > 5

// Uh...
2
      + 1
      !> print
      + 1
    |> incr
      !> print
  |> print
//│ > 3
//│ > 5
//│ > 5


{1} + {1}
//│ = 2

