// TODO: Foo needs to be put in a mutable capture. Also, we need to pass the Foo instance itself into Foo
fun foo(x) =
  object Foo with
    fun self1 = this
    fun self2 = Foo
  class Bar extends Foo
  (new Bar).self2
foo(2)
//│ ╔══[ERROR] Expected a statically known class; found reference of type Foo.
//│ ║  l.245: 	  class Bar extends Foo
//│ ║         	                    ^^^
//│ ╙── The 'new' keyword requires a statically known class; use the 'new!' operator for dynamic instantiation.
//│ ═══[WARNING] Cannot yet lift definition `Bar` as it extends an expression.
//│ ═══[RUNTIME ERROR] TypeError: Class extends value [object Object] is not a constructor or null

// `h` is lifted out, but then cannot access the BlockMemberSymbol M.
:fixme
:w
fun f =
  module M with
    fun g =
      fun h = M.g
      h
  M.g
//│ ╔══[WARNING] Modules are not yet lifted.
//│ ║  l.259: 	  module M with
//│ ╙──       	         ^
//│ /!!!\ Uncaught error: scala.NotImplementedError: an implementation is missing


