// Since B extends A and A is not lifted, B cannot access A's BlockMemberSymbol. We can't lift B.
:todo
fun test(x) =
  class A with
    fun get = x
  class B() extends A
  0 is A
  B().get
test(2)
//│ ═══[WARNING] Cannot yet lift class/module `A` as it is used in an instance check.
//│ ═══[WARNING] Cannot yet lift definition `B` as it extends an unliftable class.
//│ = 2

:expect 2
class A(a) with
  let x = 2
  fun f() =
    fun g() = x
    g()
A(2).f()
