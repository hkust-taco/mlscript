let obj =
  new Object with
    val x = 12
//│ obj = $anon { x: 12 }

obj.x
//│ = 12


let n =
  new with
    val x = 12
//│ n = $anon { x: 12 }

n.x
//│ = 12


class Foo(x) with
  fun foo = x + 1
  print("Foo", x, foo)

new Foo(123) with { fun foo = 27 }
//│ > Foo 123 27
//│ = $anon

