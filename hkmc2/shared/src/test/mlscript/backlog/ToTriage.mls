// * Objects should not be allowed to have parameters...
// * Or these parameters should have default values.

:sjs
object Cls(val x) with
  fun huh = x
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let Cls1;
//│ (class Cls {
//│   static {
//│     new this
//│   }
//│   constructor(x1) {
//│     Cls1 = this;
//│     this.x = x1;
//│     Object.defineProperty(this, "class", {
//│       value: Cls
//│     });
//│     globalThis.Object.freeze(this);
//│   }
//│   get huh() {
//│     return this.x;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["object", "Cls"]; 
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:e
Cls.x
//│ ╔══[COMPILATION ERROR] Object 'Cls' does not contain member 'x'
//│ ║  l.121: 	Cls.x
//│ ╙──       	   ^^
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

// * Note: the access is not checked because the selection is resolved
// * (to an MLscript definition, which is not supposed to return `undefined`).
print(Cls.huh)
//│ > undefined

let c = new Cls(123)
