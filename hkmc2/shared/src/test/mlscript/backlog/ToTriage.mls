:sjs
object Cls(val x) with
  fun huh = x
//│ JS (unsanitized):
//│ let Cls1;
//│ globalThis.Object.freeze(class Cls {
//│   static {
//│     Cls1.class = globalThis.Object.freeze(new this)
//│   }
//│   constructor(x1) {
//│     this.x = x1;
//│     Object.defineProperty(this, "class", {
//│       value: Cls
//│     })
//│   }
//│   get huh() {
//│     return this.x;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["object", "Cls"]; 
//│ });
//│ ═══[RUNTIME ERROR] TypeError: Cannot set properties of undefined (setting 'class')

