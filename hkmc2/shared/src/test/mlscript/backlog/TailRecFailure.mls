// FIXME: not tail-rec optimized due to consequent-sharing
:sir
:patMatConsequentSharingThreshold 1
 // ^ The default value allowed duplicating "Z" in the above version
fun go(x) = if x is
  Cons(_, Nil) then "Z"
  n then go([])
