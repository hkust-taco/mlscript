:js


import "../../mlscript-compile/Stack.mls"
open Stack


// Note: tail-rec optimized
:sir
fun go(x) = if x is
  Cons(_, _) then "Z"
  n then go([])
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let go⁰;
//│ define go⁰ as fun go¹(x) {
//│   loop loopLabel:
//│     let n, arg$Cons$0$, arg$Cons$1$, tmp;
//│     match x
//│       Cons⁰ =>
//│         set arg$Cons$0$ = x.head⁰;
//│         set arg$Cons$1$ = x.tail⁰;
//│         return "Z"
//│       else
//│         set n = x;
//│         set tmp = [];
//│         set x = tmp;
//│         continue loopLabel
//│     end
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

