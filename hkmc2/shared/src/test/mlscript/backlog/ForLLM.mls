// FIXME: op-split has no split point!
// Parses as a prefix `do` in a split instead of an infix `do` that's part of the `if` expression!
:fixme
:pt
if maybe
  do 1
  else ???
//│ ———————————————| Parsed tree |——————————————————————————————————————————————————————————————————————
//│ IfLike:
//│   kw = Keywrd of keyword 'if'
//│   split = OpSplit:
//│     lhs = Ident of "maybe"
//│     ops_rhss = Ls of 
//│       PrefixApp:
//│         kw = Keywrd of keyword 'do'
//│         rhs = IntLit of 1
//│       PrefixApp:
//│         kw = Keywrd of keyword 'else'
//│         rhs = Ident of "???"
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] Error: Not implemented

// * NOTE: works!! (special-cased?)
:pt
if maybe
  then 1
  else ???
//│ ———————————————| Parsed tree |——————————————————————————————————————————————————————————————————————
//│ IfLike:
//│   kw = Keywrd of keyword 'if'
//│   split = Block of Ls of 
//│     InfixApp:
//│       lhs = Ident of "maybe"
//│       kw = Keywrd of keyword 'then'
//│       rhs = IntLit of 1
//│     PrefixApp:
//│       kw = Keywrd of keyword 'else'
//│       rhs = Ident of "???"
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

// * NOTE: works
:pt
if 2
  > 1 do print("hi")
  else ???
//│ ———————————————| Parsed tree |——————————————————————————————————————————————————————————————————————
//│ IfLike:
//│   kw = Keywrd of keyword 'if'
//│   split = OpSplit:
//│     lhs = IntLit of 2
//│     ops_rhss = Ls of 
//│       InfixApp:
//│         lhs = OpApp:
//│           lhs = SplitPoint
//│           op = Ident of ">"
//│           rhss = Ls of 
//│             IntLit of 1
//│         kw = Keywrd of keyword 'do'
//│         rhs = App:
//│           lhs = Ident of "print"
//│           rhs = Tup of Ls of 
//│             StrLit of "hi"
//│       PrefixApp:
//│         kw = Keywrd of keyword 'else'
//│         rhs = Ident of "???"
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi

