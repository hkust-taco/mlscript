// From ups/UpsBugsBacklog.mls

// * Problems happen with `..` destructuring of sequences (same happens with `...`)

fun go(stack) = if stack is
  [..stack, "+", "+"] then 0
  [..stack2, Str] then 1
  else print("Str??", stack is [..stack2, Str])

go([1, 2, "z"])
//│ > Str?? true

