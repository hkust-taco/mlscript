:fixme // `in` is taken as part of the `set`, as in `set..in`, instead of the `let`
:expect 42
let emptyItemCount = 0
let c() = set emptyItemCount += 1
in 42
//│ ═══[RUNTIME ERROR] Expected: '42', got: 'undefined'
//│ c = fun
//│ emptyItemCount = 0

// ——— ——— ———

// Works
let x = 1
in x
//│ = 1

// Doesn't work
:fixme
let
  x = 1
in x
//│ ╔══[COMPILATION ERROR] Illegal position for 'in' modifier.
//│ ║  l.28: 	in x
//│ ╙──      	^^
//│ = 1
//│ x = 1

