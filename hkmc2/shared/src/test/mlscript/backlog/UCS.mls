module Foo with
  class
    Bar
    Baz

fun foo(x) = if x is Foo.
  Bar then "Bar"
  Foo then "Foo"
//│ ╔══[PARSE ERROR] Expected end of input; found period instead
//│ ║  l.223: 	fun foo(x) = if x is Foo.
//│ ╙──       	                        ^
//│ ╔══[ERROR] Unrecognized pattern split (identifier).
//│ ║  l.223: 	fun foo(x) = if x is Foo.
//│ ╙──       	                     ^^^

fun foo(x) = if x is Foo
  .Bar then "Bar"
  .Foo then "Foo"
