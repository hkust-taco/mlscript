data class Tuple(a, b, c)

let foo =
  case
    Tuple(...elements) then elements
//│ ╔══[COMPILATION ERROR] Unrecognized pattern (spread).
//│ ║  l.83: 	    Tuple(...elements) then elements
//│ ╙──      	          ^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Name not found: elements
//│ ║  l.83: 	    Tuple(...elements) then elements
//│ ╙──      	                            ^^^^^^^^
//│ ╔══[COMPILATION ERROR] Expected three arguments, but found only one argument.
//│ ║  l.83: 	    Tuple(...elements) then elements
//│ ╙──      	    ^^^^^
//│ foo = fun

foo(Tuple(1, 2, 3))
