module Foo with
  class
    Bar
    Baz

fun foo(x) = if x is Foo.
  Bar then "Bar"
  Foo then "Foo"
//│ ╔══[PARSE ERROR] Expected end of input; found period instead
//│ ║  l.105: 	fun foo(x) = if x is Foo.
//│ ╙──       	                        ^
//│ ╔══[COMPILATION ERROR] Unrecognized pattern split (identifier).
//│ ║  l.105: 	fun foo(x) = if x is Foo.
//│ ╙──       	                     ^^^

fun foo(x) = if x is Foo
  .Bar then "Bar"
  .Foo then "Foo"
//│ ╔══[COMPILATION ERROR] Unrecognized pattern split (operator split).
//│ ║  l.115: 	fun foo(x) = if x is Foo
//│ ║         	                     ^^^
//│ ║  l.116: 	  .Bar then "Bar"
//│ ║         	^^^^^^^^^^^^^^^^^
