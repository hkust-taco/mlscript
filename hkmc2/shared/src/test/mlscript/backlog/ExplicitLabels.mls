:js


do exit:
  if true do exit.break 42
  0


let i = 0 in do loop:
  if i >= 3 do loop.break i
  set i += 1
  loop.continue


let i = 0 in do outer:
  do inner:
    if i >= 4 do outer.break i
    set i += 1
    outer.continue


