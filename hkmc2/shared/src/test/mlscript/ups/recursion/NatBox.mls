:js

open annotations { compile }

data class Box[A](val value: A)

pattern NatBox = null | Box(NatBox)

fun nat(n) = if n is 0 then null else Box(nat(n - 1))

fun int(n) = if n is
  null then 0
  Box(x) then 1 + int(x)

[nat(0), nat(1), nat(2), nat(3)]
//│ = [null, Box(null), Box(Box(null)), Box(Box(Box(null)))]

int(nat(42))
//│ = 42

// FIXME: why are we checking `Object` and `{ value }` patterns?
:sir
:expect true
nat(0) is @compile NatBox
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut, matcher__NatBox$, matchRecord, matchSuccess, patternOutput, bindings, lambda⁰;
//│ set scrut = nat⁰(0);
//│ define lambda⁰ as fun lambda¹(input) {
//│   let p_0$, value, emptyRecord$, value1, p_0$1, result0$, output0$, fieldBindings, bindings1, p_0$2, tmp, tmp1, tmp2, tmp3, tmp4, tmp5, tmp6, tmp7;
//│   match input
//│     null =>
//│       set tmp = {  };
//│       set tmp1 = new runtime⁰.MatchSuccess⁰(input, tmp);
//│       set p_0$ = tmp1;
//│       return { "p_0": p_0$ }
//│     Box⁰ =>
//│       set tmp2 = new runtime⁰.MatchFailure⁰("empty");
//│       set emptyRecord$ = { "p_0": tmp2 };
//│       match input
//│         Object⁰ =>
//│           match input
//│             { value } =>
//│               set value1 = input.value﹖;
//│               set tmp3 = matcher__NatBox$(value1);
//│               end
//│             else
//│               set tmp3 = emptyRecord$;
//│               end
//│           end
//│         else
//│           set tmp3 = emptyRecord$;
//│           end
//│       set value = tmp3;
//│       set result0$ = value.p_0﹖;
//│       match result0$
//│         MatchSuccess⁰ =>
//│           set output0$ = result0$.output⁰;
//│           set bindings1 = result0$.bindings⁰;
//│           set fieldBindings = {  };
//│           set tmp4 = { "value": output0$ };
//│           set tmp5 = { ...bindings1, ...fieldBindings };
//│           set tmp6 = new runtime⁰.MatchSuccess⁰(tmp4, tmp5);
//│           end
//│         else
//│           set tmp6 = new runtime⁰.MatchFailure⁰("topmost");
//│           end
//│       set p_0$1 = tmp6;
//│       return { "p_0": p_0$1 }
//│     else
//│       set tmp7 = new runtime⁰.MatchFailure⁰("never");
//│       set p_0$2 = tmp7;
//│       return { "p_0": p_0$2 }
//│   end
//│ };
//│ set matcher__NatBox$ = lambda¹;
//│ set matchRecord = matcher__NatBox$(scrut);
//│ set matchSuccess = matchRecord.p_0﹖;
//│ match matchSuccess
//│   MatchSuccess⁰ =>
//│     set patternOutput = matchSuccess.output⁰;
//│     set bindings = matchSuccess.bindings⁰;
//│     true
//│   else
//│     false
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = true

:expect true
nat(1) is @compile NatBox
//│ = true

:expect false
Box(0) is @compile NatBox
//│ = false

:expect true
nat(7) is @compile NatBox
//│ = true

:expect true
nat(14) is @compile NatBox
//│ = true

:expect false
Box(Box(Box(Box(Box(Box(Box(0))))))) is @compile NatBox
//│ = false

pattern PosNatBox = Box(null | NatBox)

:expect false
null is @compile PosNatBox
//│ = false

nat(1) is @compile PosNatBox
//│ = true

:expect true
nat(2) is @compile PosNatBox
//│ = true

:expect true
nat(3) is @compile PosNatBox
//│ = true

:expect false
Box(Box(Box(Box(42)))) is @compile PosNatBox
//│ = false

pattern EvenNatBox = Box(Box(null | EvenNatBox))

:expect false
nat(0) is @compile EvenNatBox
//│ = false

:expect false
nat(1) is @compile EvenNatBox
//│ = false

:expect true
nat(2) is @compile EvenNatBox
//│ = true

:expect false
nat(3) is @compile EvenNatBox
//│ = false

:expect true
nat(4) is @compile EvenNatBox
//│ = true

// Make the base case a new pattern.

pattern Zero = null

null is Zero
//│ = true

pattern OddNatBox = Box(Zero | Box(OddNatBox))

:expect false
nat(0) is @compile OddNatBox
//│ = false

:expect true
nat(1) is @compile OddNatBox
//│ = true

:expect false
nat(2) is @compile OddNatBox
//│ = false

:expect true
nat(3) is @compile OddNatBox
//│ = true

:expect false
nat(4) is @compile OddNatBox
//│ = false

:expect false
Box(Box(78)) is @compile OddNatBox
//│ = false
