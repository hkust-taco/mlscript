// Apply a pattern to a list, returns a list of unique elements if the output of
// each element is unique, and rejects the list otherwise.
pattern Unique(pattern P) =
  Nil | (
    ((((P as hd) :: (Unique(P) as tl)) =>
      let there = tl contains(hd)
      [there, if there then tl else hd :: tl]) as [false, list]) => list)
