fun evalByValue'(term) =
  while term is
    (@compile ByValue.Context(ByValue.Redex)) as [subterm, remake] then
      set term = remake(subterm)
    else term
//│ ╔══[ERROR] Pattern chaining is not supported in pattern compilation.
//│ ║  l.211: 	      App(Abs as lhs, Context(Hole) as [rhs, remake]) =>
//│ ╙──       	                      ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[ERROR] Pattern chaining is not supported in pattern compilation.
//│ ║  l.214: 	      App(Context(Hole) as [lhs, remake], Term as rhs) =>
//│ ╙──       	          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
