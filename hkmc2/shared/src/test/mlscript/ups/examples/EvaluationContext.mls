object ByValue with
  // This pattern matches a beta redex where the argument is a value and
  // performs the substitution.
  pattern Redex = App(Abs(Var(x), m), Value as n) => subst(m, x, n)
  
  // Call-by-value evaluation contexts
  //
  // E ::= □
  //     | E t
  //     | v E
  //
  // It matches any terms that can take at least one step and extracts the next
  // redex that we should make a progress and a function to reconstruct the term.
  pattern Context(pattern Hole) =
    (
      (Hole as hole) => [hole, id]
    ) | (
      App(Abs as lhs, Context(Hole) as [rhs, remake]) =>
        [rhs, App(lhs, _)]
    ) | (
      App(Context(Hole) as [lhs, remake], Term as rhs) =>
        [lhs, lhs' => App(remake(lhs'), rhs)]
    )
