fun subst(term, name, target) = if term is
  Var(name') and
    name === name' then target
    else term
  Abs(Var(name'), body) and
    name === name' then term
    let target' = if target.freeVars.has(name')
      then subst(target, name', target.freshVar(name'))
      else target
    else Abs(Var(name'), subst(body, name, target'))
  App(lhs, rhs) then App(subst(lhs, name, target), subst(rhs, name, target))
