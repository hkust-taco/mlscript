// Convert 24-hour time format to 12-hour format with AM/PM
pattern Time12Hour = ((
  hour: ((HourAM | HourPM) as hour) & (((HourAM => "AM") | (HourPM => "PM")) as flag),
  minute: Minute as minute
)) => hour + ":" + minute + " " + flag
