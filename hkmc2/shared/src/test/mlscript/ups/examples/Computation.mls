// This makes use of the chain pattern. It generates 29,232 lines of code!
pattern Time12Hour = ((
  hour: ((
    ((0 ..= 11) => "AM") |
    ((12 ..= 23) => "PM")
  ) & (
    (0 => 12) |
    (1 ..= 11) |
    12 |
    ((13 ..= 23) as h => h - 12)
  )) as [hour, flag],
  minute: Minute as minute
)) => hour + ":" + minute + " " + flag
