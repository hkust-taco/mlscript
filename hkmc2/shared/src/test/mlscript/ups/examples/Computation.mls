:js

open annotations

data class Celsius(value: Num)

data class Fahrenheit(value: Num)

pattern ToFahrenheit =
  ((Celsius(c)) => Fahrenheit((c * 9 / 5) + 32)) |
  ((Fahrenheit as f) => f)

pattern ToCelsius =
  ((Fahrenheit(f)) => Celsius((f - 32) * 5 / 9)) |
  ((Celsius as c) => c)

Celsius(0) is ToFahrenheit(Fahrenheit(32))
//│ = true

Fahrenheit(212) is ToCelsius(Celsius(100))
//│ = true

Celsius(100) is ToFahrenheit(Fahrenheit(212))
//│ = true

Fahrenheit(32) is ToCelsius(Celsius(0))
//│ = true

Celsius(-40) is ToFahrenheit(Fahrenheit(-40))
//│ = true

Fahrenheit(-40) is ToCelsius(Celsius(-40))
//│ = true

