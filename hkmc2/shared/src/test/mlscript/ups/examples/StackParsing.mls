import "../../../mlscript-compile/Stack.mls"
open Stack



pattern Identifier = ("a" ..= "z") ~ (Identifier | "")

data class Expr with
  constructor
    Ident(name: Str)
    Op(lhs: Expr, op: Str, rhs: Expr)

pattern Parse =
  (
    ((Identifier as name) :: rest)                => Ident(name) :: rest
  ) | (
    ((Expr as e1) :: "+" :: (Expr as e2) :: rest) => Op(e1, "+", e2) :: rest
  ) | (
    ((Expr as e1) :: "+" :: (Parse as rest))      => e1 :: "+" :: rest
  ) | (
    ("(" :: (Expr as e) :: ")" :: rest)           => e :: rest
  ) | (
    ("(" :: (Parse as rest))                      => "(" :: rest
  )

fun parse(tokens) =
  while tokens is
    Parse as stack do
      set tokens = stack
  print of ...
    if tokens is
      (Expr as e) :: Nil then ["Success:", e]
      toks then ["Failure: can't parse:", toks]

parse(Nil)
//│ > Failure: can't parse: Nil

parse("x" :: Nil)
//│ > Success: Ident("x")

let input = "x" :: "+" :: "y" :: Nil
//│ input = Cons("x", Cons("+", Cons("y", Nil)))

parse(input)
//│ > Success: Op(Ident("x"), "+", Ident("y"))

if input is Parse as rest then rest
//│ = Cons(Ident("x"), Cons("+", Cons("y", Nil)))

parse("(" :: "x" :: ")" :: Nil)
//│ > Success: Ident("x")

parse("a" :: "+" :: "(" :: "x" :: "+" :: "y" :: ")" :: Nil)
//│ > Success: Op(Ident("a"), "+", Op(Ident("x"), "+", Ident("y")))

parse("a" :: "+" :: "(" :: "b" :: "+" :: "x" :: "+" :: "y" :: ")" :: Nil)
//│ > Success: Op(Ident("a"), "+", Op(Op(Ident("b"), "+", Ident("x")), "+", Ident("y")))

parse("a" :: "+" :: "(" :: "b" :: "+" :: "(" :: "x" :: "+" :: "y" :: ")" :: ")" :: Nil)
//│ > Success: Op(Ident("a"), "+", Op(Ident("b"), "+", Op(Ident("x"), "+", Ident("y"))))





// * Interesting quirk:

print of ...
[1, 2]
//│ > [1, 2]

print of ...
  [1, 2]
//│ > 1 2



