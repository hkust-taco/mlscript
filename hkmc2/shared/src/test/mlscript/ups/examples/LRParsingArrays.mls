[""] is [..stack, Str as id]
//│ = true

[..[], ""] is [..stack, Str as id]
//│ = true

[..[..[""]], ""] is [..stack, Str as id]
//│ = true




pattern Identifier = ("a" ..= "z") ~ (Identifier | "")

data class Expr with
  constructor
    Ident(name: Str)
    Op(lhs: Expr, op: Str, rhs: Expr)

// pattern Parse =
//   (
//     ((Identifier as name) :: rest) => Ident(name) :: rest
//   ) | (
//     ((Expr as e1) :: "+" :: (Expr as e2) :: rest) => Op(e1, "+", e2) :: rest
//   ) | (
//     ((Expr as e1) :: "+" :: (Parse as rest)) => e1 :: "+" :: rest
//   ) | (
//     ("(" :: (Expr as e) :: ")" :: rest) => e :: rest
//   ) | (
//     ("(" :: (Parse as rest)) => "(" :: rest
//   )

// fun parse(stack, input) = if stack is
//   ((Expr as e2) :: "+" :: (Expr as e1) :: rest) then
//     parse((Op(e1, "+", e2) :: rest), input)

fun go(stack, input) = if stack is
  [..stack, Expr as e1, "+", Expr as e2] then
    go([..stack, Op(e1, "+", e2)], input)
  // [..stack, Expr, "+"] and input is [tok, ..input] then
  //   go([..stack, Expr, "+", tok], input)
  [..stack, Identifier as id] then
    go([..stack, Ident(id)], input)
  do print("not Identifier", stack)
  do print("not Identifier??", stack is [..stack, Identifier as id])
  // [..stack, Str as id] then
  //   ???
  do print("Str?", stack.at(-1), stack.at(-1) is Str)
  do print("Str??", stack is [..stack, Str as id])
  [Expr as res] and input is [] then
    Success: res
  _ and input is
    [tok, ..input] then
      go([..stack, tok], input)
    [] then
      Error: stack
  // ("+" :: (Expr as e2) :: stack) then

let Space = new RegExp of "(\\s+)"
//│ Space = /(\s+)/
fun parse(input) =
  let input = input.split(Space)
    \filtering of (_ !== "")
    \filtering of (_ \every of (_ !== " "))
    \toArray()
  go([], input)



