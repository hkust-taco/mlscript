import "../../../mlscript-compile/Stack.mls"
open Stack


pattern Stack = Cons | Nil


pattern Identifier = ("a" ..= "z") ~ (Identifier | "")

data class Expr with
  constructor
    Ident(name: Str)
    Op(lhs: Expr, op: Str, rhs: Expr)

pattern Parse = (x => go(x)) as Stack
fun go(stack) = if stack is
  ((Identifier as name) :: rest) then Ident(name) :: rest
  ((Expr as e1) :: "+" :: (Expr as e2) :: rest) then Op(e1, "+", e2) :: rest
  ((Expr as e1) :: "+" :: (Parse as rest)) then e1 :: "+" :: rest
  ("(" :: (Expr as e) :: ")" :: rest) then e :: rest
  ("(" :: (Parse as rest)) then "(" :: rest
  _ then
    Error: stack

fun parse(tokens) =
  while go(tokens) is
    Stack as stack do
      set tokens = stack
  print of ...
    if tokens is
      // Nil then ["Success:", 1]
      (Expr as e) :: Nil then ["Success:", e]
      toks then ["Failure: can't parse:", toks]

parse(Nil)
//│ > Failure: can't parse: Nil

parse("x" :: Nil)
//│ > Success: Ident("x")

parse("x" :: "+" :: "y" :: Nil)
//│ > Success: Op(Ident("x"), "+", Ident("y"))

parse("(" :: "x" :: ")" :: Nil)
//│ > Success: Ident("x")

parse("a" :: "+" :: "(" :: "x" :: "+" :: "y" :: ")" :: Nil)
//│ > Success: Op(Ident("a"), "+", Op(Ident("x"), "+", Ident("y")))

parse("a" :: "+" :: "(" :: "b" :: "+" :: "(" :: "x" :: "+" :: "y" :: ")" :: ")" :: Nil)
//│ > Success: Op(Ident("a"), "+", Op(Ident("b"), "+", Op(Ident("x"), "+", Ident("y"))))



// pattern Err = {Error: _}
fun go(stack) =
  // print(stack)
  if stack is...
  ((Identifier as name) :: rest)
    then go of Ident(name) :: rest
  ((Expr as e1) :: "+" :: (Expr as e2) :: rest)
    then go of Op(e1, "+", e2) :: rest
  ((Expr as e1) :: "+" :: rest)
    then go of e1 :: "+" :: go of rest
  ("(" :: (Expr as e) :: ")" :: rest) then
    go of e :: rest
  ("(" :: rest) then
    go of "(" :: go of rest
  // (Expr as res) :: Nil then
  //   Success: res
  // (Expr as res) :: Nil then
  //   stack
  // Err | {Success: _} then
  //   stack
  // _ then
  //   Error: stack
  _ then
    stack

fun parse(tokens) =
  if go(tokens) is
    (Expr as res) :: Nil then
      Success: res
    toks then
      Failure: toks

parse(Nil)
//│ = {Failure: Nil}

parse("x" :: Nil)
//│ = {Success: Ident("x")}

parse("x" :: "+" :: "y" :: Nil)
//│ = {Success: Op(Ident("x"), "+", Ident("y"))}

parse("(" :: "x" :: ")" :: Nil)
//│ = {Success: Ident("x")}

parse("a" :: "+" :: "(" :: "x" :: "+" :: "y" :: ")" :: Nil)
//│ = {Success: Op(Ident("a"), "+", Op(Ident("x"), "+", Ident("y")))}

parse("a" :: "+" :: "(" :: "b" :: "+" :: "x" :: "+" :: "y" :: ")" :: Nil)
//│ = {
//│   Success: Op(
//│     Ident("a"),
//│     "+",
//│     Op(Ident("b"), "+", Op(Ident("x"), "+", Ident("y")))
//│   )
//│ }

parse("a" :: "+" :: "(" :: "b" :: "+" :: "(" :: "x" :: "+" :: "y" :: ")" :: ")" :: Nil)
//│ = {
//│   Success: Op(
//│     Ident("a"),
//│     "+",
//│     Op(Ident("b"), "+", Op(Ident("x"), "+", Ident("y")))
//│   )
//│ }










