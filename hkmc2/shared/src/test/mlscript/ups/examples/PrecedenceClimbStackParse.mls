//│ ╙──       	                                               ^^^
//│ ╔══[COMPILATION ERROR] Name not found: prec
//│ ║  l.141: 	fun f(x) = assert x is str as AtPrec as prec, [str, prec]
//│ ╙──       	                                                    ^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


pattern Oper(str, prec) = str as AtPrec as prec

assert "+" is Oper as p, p
//│ = ["+", 5]

assert "+" is Oper(s, p), [s, p]
//│ = ["+", 5]

