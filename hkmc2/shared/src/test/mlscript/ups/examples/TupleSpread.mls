// Test if a list is a palindrome. This example is not very good because it
// outputs a boolean value, rather than rejecting the input.
pattern TestPalindrome =
  ([x, ...TestPalindrome as m, y] => m && x == y) |
  (([_] | []) => true) | (_ => false)
