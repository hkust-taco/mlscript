// Calculate the area of different shapes
pattern ShapeArea = 
  (((:radius)) => Math.PI * radius * radius) |  // Circle
  (((:width, :height)) => width * height) |     // Rectangle
  (((:base, :height)) => base * height / 2)     // Triangle
