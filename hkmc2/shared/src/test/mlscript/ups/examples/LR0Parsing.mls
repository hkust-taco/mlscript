import "../../../mlscript-compile/Stack.mls"
open Stack



pattern Identifier = ("a" ..= "z") ~ (Identifier | "")

// data class Expr with
//   constructor
//     Ident(name: Str)
//     Op(lhs: Sub, op: Str, rhs: Sub)
//     Sub(inner: Expr, prec: Int)

data class Subexpr with
  constructor
    Ident(name: Str)
    Op(lhs: Subexpr, op: Str, rhs: Subexpr)
data class Expr(sub: Subexpr, prec: Int)


pattern AtPrec(str, prec) = str as (
    ( "+" => 5 ) |
    ( "*" => 2 )
  ) as prec

fun f(x) = if x is AtPrec(op, p) then [op, p]
f("+")
//│ = ["+", 5]
f("*")
//│ = ["*", 2]

pattern Parse =
  (
    (Identifier(name) :: rest) =>
        Expr(Ident(name), 0) :: rest
  ) | (
    (Expr(e1, p1) :: AtPrec(op, p) :: rest where p1 < p) =>
        Expr(e1, p) :: op :: rest
  ) | (
    (Expr(e1, p1) :: AtPrec(op, p) :: Expr(e2, p2) :: rest where p1 >= p and p2 >= p) =>
        Expr(Op(e1, op, e2), p) :: rest
  ) | (
    ((Expr as e1) :: AtPrec(op, _) :: Parse(rest)) =>
        e1 :: op :: rest
  ) | (
    ((Expr as e1) :: AtPrec(op, p) :: Expr(e2, p2) :: rest where p2 < p) =>
        e1 :: op :: Expr(e2, p) :: rest
  ) | (
    ("(" :: Expr(e, p) :: ")" :: rest) =>
        Expr(e, 0) :: rest
  ) | (
    ("(" :: Parse(rest)) =>
        "(" :: rest
  )

fun parse(tokens) =
  fun go = case
    Parse as stack then go(stack)
    (Expr as e) :: Nil then ["Success:", e]
    toks then ["Failure: can't parse:", toks]
  print of ...go(tokens)

parse(Nil)
//│ > Failure: can't parse: Nil

parse("x" :: Nil)
//│ > Success: Expr(Ident("x"), 0)

let input = "x" :: "+" :: "y" :: Nil
//│ input = Cons("x", Cons("+", Cons("y", Nil)))

parse(input)
//│ > Success: Expr(Op(Ident("x"), "+", Ident("y")), 5)

if input is Parse as rest then rest
//│ = Cons(Expr(Ident("x"), 0), Cons("+", Cons("y", Nil)))

parse("(" :: "x" :: ")" :: Nil)
//│ > Success: Expr(Ident("x"), 0)

parse("a" :: "*" :: "x" :: "+" :: "y" :: Nil)
//│ > Success: Expr(Op(Op(Ident("a"), "*", Ident("x")), "+", Ident("y")), 5)

parse("a" :: "+" :: "x" :: "*" :: "y" :: Nil)
//│ > Success: Expr(Op(Ident("a"), "+", Op(Ident("x"), "*", Ident("y"))), 5)

parse("(" :: "x" :: "+" :: "y" :: ")" :: Nil)
//│ > Success: Expr(Op(Ident("x"), "+", Ident("y")), 0)

parse("a" :: "+" :: "(" :: "x" :: "+" :: "y" :: ")" :: Nil)
//│ > Success: Expr(Op(Ident("a"), "+", Op(Ident("x"), "+", Ident("y"))), 5)

parse("a" :: "+" :: "(" :: "b" :: "+" :: "x" :: "+" :: "y" :: ")" :: Nil)
//│ > Success: Expr(Op(Ident("a"), "+", Op(Op(Ident("b"), "+", Ident("x")), "+", Ident("y"))), 5)

parse("a" :: "+" :: "(" :: "b" :: "+" :: "(" :: "x" :: "+" :: "y" :: ")" :: ")" :: Nil)
//│ > Success: Expr(Op(Ident("a"), "+", Op(Ident("b"), "+", Op(Ident("x"), "+", Ident("y")))), 5)








// ———


pattern AtPrec =
  ( "+" => 5 ) |
  ( "*" => 2 )


fun f(x) = if x is str as AtPrec as prec then [str, prec]
f("+")
//│ = ["+", 5]
f("*")
//│ = ["*", 2]

if "+" is AtPrec(n) then n
//│ = 5

pattern Oper(str, prec) = str as AtPrec as prec

if "+" is Oper as p then p
//│ = ["+", 5]

if "+" is Oper(s, p) then [s, p]
//│ = ["+", 5]

