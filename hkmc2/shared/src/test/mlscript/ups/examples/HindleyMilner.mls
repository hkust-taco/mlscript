// Note: missing type arguments for `Map`.
data class Env(bindings: Map[Str, Scheme]) with
  fun lookup(name) =
    if bindings.has(name) then bindings.get(name)
    else throw new Error("Unbound variable: " + name)
  
  fun extend(name, scheme) =
    let newBindings = new Map(bindings)
    newBindings.set(name, scheme)
    Env(newBindings)
  
  fun freeVars =
    let vars = new Set([])
    bindings.values() Iter.each of scheme =>
      scheme => scheme.typ.freeVars Iter.each of v => vars.add(v)
    vars
  
  fun generalize(typ) =
    let envFree = freeVars
    let typeFree = typ.freeVars
    let genVars = new Set([])
    typeFree Iter.each of v =>
      if envFree.has(v) is false then genVars.add(v)
    Scheme(genVars, typ)
