class Gen with
  let counter = 0
  
  fun subscript =
    let
      value = counter
      text = ""
    while value > 0 || text.length === 0 do
      set text += String.fromCodePoint(0x2080 + value % 10)
      set value = Math.floor(value / 10)
    text
  
  fun fresh =
    let name = "t" + subscript
    set counter += 1
    TVar(name)
