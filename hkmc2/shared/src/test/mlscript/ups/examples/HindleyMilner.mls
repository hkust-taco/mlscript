// Substitution for types
data class Subst(map: Map[Str, Type]) with
  
  fun apply(typ) = if typ is
    TVar(name) and this is Subst(map) and
      map.has(name) then map.get(name)
      else typ
    TFun(lhs, rhs) then TFun(apply(lhs), apply(rhs))
    else typ
  
  fun applyScheme(scheme) = if scheme is Scheme(vars, typ) then
    let newMap = new Map()
    this.map Iter.each of case [key, value] then
      if vars.has(key) is false then newMap.set(key, value)
    Subst(newMap).apply(typ)
  
  fun compose(that) =
    let newMap = new Map()
    that.map Iter.each of case [key, value] then
      newMap.set(key, apply(value))
    this.map Iter.each of case [key, value] then
      newMap.set(key, value)
    Subst(newMap)
  
  fun show =
    let pairs = mut []
    map Iter.each of case [key, value] then
      pairs.push(key + " -> " + value.show)
    "{" + pairs.join(", ") + "}"
