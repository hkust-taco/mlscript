:ucs ups

// The right binding power of `=>` is lower than the left binding power of `|`.
// Therefore, if we want to union two transformations, we should parenthesize
// the second transformation.

pattern Test = 1 | 2
//│ elaborated pattern body: 1 ∨ 2

pattern Test = 1 | 2 => 3
//│ elaborated pattern body: 1 ∨ 2 => 3

// The following two examples are rejected because `4 => 8` is considered as a
// part of the right hand side term of `1 => 2`. Currently, our implementation
// does not support patterns as lambda parameters.

pattern Test = 1 => 2 | 4 => 8
//│ elaborated pattern body: 1 => 2 ∨ 4 => 8

pattern Test = 1 => 2 | (4 => 8)
//│ elaborated pattern body: 1 => 2 ∨ 4 => 8

pattern Test = (1 => 2) | 4 => 8
//│ elaborated pattern body: 1 => 2 ∨ 4 => 8

// The precedence of `as` is lower than `=>`.

pattern Test = 0 as x => 2
//│ elaborated pattern body: 0 as (x => 2)

pattern Test = (0 as x) => 2
//│ elaborated pattern body: (0 as x) => 2

pattern Test(x) = 0 as x | 1 as x
//│ elaborated pattern body: 0 as x ∨ 1 as x

pattern Test(x) = 0 as x | (1 as x)
//│ elaborated pattern body: 0 as x ∨ 1 as x

pattern Test(x) = 0 as x | (1 as x)
//│ elaborated pattern body: 0 as x ∨ 1 as x

pattern Test(x) = (0 as x) | (1 as x)
//│ elaborated pattern body: 0 as x ∨ 1 as x
