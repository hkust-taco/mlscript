:e
// Even if a certain class is under the selection of multiple modules, we should
// still be able to resolve it correctly.
fun y = HiddenCorner.m.m.k
pattern Naughty = HiddenCorner.m.m.YouCantSeeMe(n) => n + HiddenCorner.m.m.k
pattern Obedient = HiddenCorner.m.m.CantYouSeeMe(n) => n + HiddenCorner.m.m.k
module HiddenCorner with
  val m: module HiddenCorner = HiddenCorner
  class YouCantSeeMe(wow: Int)
  class CantYouSeeMe(val wow: Int)
  val k = 0
//│ ╔══[COMPILATION ERROR] This pattern cannot be matched
//│ ║  l.189: 	pattern Naughty = HiddenCorner.m.m.YouCantSeeMe(n) => n + HiddenCorner.m.m.k
//│ ║         	                                                ^
//│ ╟── because the corresponding parameter `wow` is not publicly accessible
//│ ║  l.193: 	  class YouCantSeeMe(wow: Int)
//│ ║         	                     ^^^
//│ ╟── Suggestion: use a wildcard pattern `_` in this position
//│ ╙── Suggestion: mark this parameter with `val` so it becomes accessible
