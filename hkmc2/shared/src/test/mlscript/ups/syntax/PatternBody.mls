import "../../../mlscript-compile/Stack.mls"

open Stack

class Pair[A, B](val fst: A, val snd: B)

:ucs ups
pattern PlainList(pattern T) = (null => Nil) | (Pair(T as hd, PlainList(T) as tl) => hd :: tl)
//│ elaborated pattern body: null => (member:Stack.)Nil‹member:Nil› ∨ member:Pair(T as hd, member:PlainList(T) as tl) => (member:Stack.)Cons‹member:Cons›(hd, tl)

