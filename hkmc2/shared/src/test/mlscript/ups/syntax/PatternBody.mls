:ucs ups
// Decide the operator precedence between `as` and `=>`.
// This is elaborated into `T as (x => x)`, which might not be what we want.
pattern Identity(pattern T) = T as x => x
//│ elaborated pattern body: T as (x => x)

:ucs ups
pattern Identity(pattern T) = (T as x) => x
//│ elaborated pattern body: (T as x) => x

pattern Identity = x => x

:ucs ups
pattern Sick = (0 as a as b as c as d as e as f) => a + b + c + d + e + f
//│ elaborated pattern body: ((((((0 as a) as b) as c) as d) as e) as f) => builtin:+(builtin:+(builtin:+(builtin:+(builtin:+(a, b), c), d), e), f)

:ucs ups
pattern PairLike = [fst, snd] => Pair(fst, snd)
//│ elaborated pattern body: [fst, snd] => member:Pair(fst, snd)

:ucs ups
pattern PairLike(fst, snd) = Pair(fst, snd) | [fst, snd]
//│ elaborated pattern body: Pair(fst, snd) ∨ [fst, snd]

