pattern BooleanLike = true | false | (0 => false) | (1 => true)
//│ elaborated pattern body: true ∨ false ∨ 0 => false ∨ 1 => true

import "../../../mlscript-compile/Stack.mls"

open Stack

class Pair[A, B](val fst: A, val snd: B)

:ucs ups
pattern PlainList(pattern T) = (null => Nil) | (Pair(T as hd, PlainList(T) as tl) => hd :: tl)
//│ elaborated pattern body: null => Nil‹open› ∨ member:Pair⁰(T⁰ as hd‹hd⁰›, member:PlainList⁰(T⁰) as tl‹tl⁰›) => ::‹open›(hd¹, tl¹)

