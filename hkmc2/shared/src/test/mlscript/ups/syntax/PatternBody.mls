// TODO: Decide on the relative operator precedence between `as` and `=>`.
//  This is elaborated into `T as (x => x)`, which might not be what we want.
pattern Identity(pattern T) = T as x => x
//│ elaborated pattern body: T¹ >> (x‹x⁰› => x¹)

:ucs ups
pattern Identity(pattern T) = (T as x) => x
//│ elaborated pattern body: (T² as x‹x²›) => x³

pattern Identity = x => x

