// Nested modifiers and annotations belong to the whole declaration span.
open annotations
@untyped
public data class AnnotatedPair(val first, val second)

:e
pattern WrongAnnotatedArity = AnnotatedPair("one")
//│ ╔══[COMPILATION ERROR] Resolution error in constructor
//│ ║  l.+1: 	pattern WrongAnnotatedArity = AnnotatedPair("one")
//│ ║        	                              ^^^^^^^^^^^^^^^^^^^^
//│ ╟── Class definition 'AnnotatedPair' expected 2 pattern arguments, but got 1
//│ ║  l.XX: 	public data class AnnotatedPair(val first, val second)
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

// A following declaration must not inherit the preceding annotation's span.
data class NextPair(val first, val second)

:e
pattern WrongNextArity = NextPair("one")
//│ ╔══[COMPILATION ERROR] Resolution error in constructor
//│ ║  l.+1: 	pattern WrongNextArity = NextPair("one")
