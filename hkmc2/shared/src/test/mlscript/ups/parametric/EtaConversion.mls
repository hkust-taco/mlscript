:js

pattern Nullable(pattern T) = T | null

// Using patterns as pattern argument directly should not create local objects.

pattern Zero = 0

:ucs normalized
0 is Nullable(Zero)
//│ Normalized:
//│ >  if
//│ >    let $scrut = 0
//│ >    let $patternArgument0$ = member:Zero
//│ >    let $unapplyResult = (member:Nullable.)unapply($patternArgument0$, $scrut)
//│ >    $unapplyResult is $runtime.MatchSuccess.class(output, bindings) then true
//│ >    else false
//│ = true

import "../../../mlscript-compile/Char.mls"

:ucs normalized
fun foo(x) = x is Nullable(Char.Letter)
//│ Normalized:
//│ >  if
//│ >    let $patternArgument0$ = (member:Char.)Letter‹member:Letter›
//│ >    let $unapplyResult = (member:Nullable.)unapply($patternArgument0$, x)
//│ >    $unapplyResult is $runtime.MatchSuccess.class(output, bindings) then true
//│ >    else false

foo of null
//│ = true

foo of "A"
//│ = true
