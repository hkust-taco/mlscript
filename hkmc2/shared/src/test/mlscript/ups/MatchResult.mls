//│                         end
//│                       else
//│                         set tmp6 = false;
//│                         end
//│                     end
//│                   else
//│                     set tmp6 = false;
//│                     end
//│                 end
//│             end
//│           else
//│             set result1$1 = left.result﹖;
//│             match result1$1
//│               true =>
//│                 set result3$ = right.result﹖.p_3﹖;
//│                 match result3$
//│                   true =>
//│                     set tmp6 = true;
//│                     end
//│                   else
//│                     set tmp6 = false;
//│                     end
//│                 end
//│               else
//│                 set tmp6 = false;
//│                 end
