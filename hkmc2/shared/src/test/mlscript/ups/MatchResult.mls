//│               { right } =>
//│                 set right1 = input.right﹖;
//│                 set tmp2 = matcher__0_1$(right1);
//│                 set tmp3 = { "input": right1, "result": tmp2 };
//│                 end
//│               else
//│                 set tmp4 = { "p_2": false, "p_3": false };
//│                 set tmp3 = { "input": null, "result": tmp4 };
//│                 end
//│             end
//│           else
//│             set tmp5 = { "p_2": false, "p_3": false };
//│             set tmp3 = { "input": null, "result": tmp5 };
//│             end
//│         set right = tmp3;
//│         set result1$ = left.result﹖;
//│         match result1$
//│           true =>
//│             set result2$ = right.result﹖.p_2﹖;
//│             match result2$
//│               true =>
//│                 set tmp6 = true;
//│                 end
//│               else
//│                 set result1$1 = left.result﹖;
//│                 match result1$1
//│                   true =>
//│                     set result3$ = right.result﹖.p_3﹖;
//│                     match result3$
//│                       true =>
//│                         set tmp6 = true;
//│                         end
//│                       else
//│                         set tmp6 = false;
//│                         end
//│                     end
//│                   else
//│                     set tmp6 = false;
//│                     end
//│                 end
//│             end
//│           else
//│             set result1$1 = left.result﹖;
//│             match result1$1
//│               true =>
//│                 set result3$ = right.result﹖.p_3﹖;
//│                 match result3$
//│                   true =>
//│                     set tmp6 = true;
//│                     end
//│                   else
//│                     set tmp6 = false;
//│                     end
//│                 end
//│               else
//│                 set tmp6 = false;
//│                 end
//│             end
//│         set p_0$ = tmp6;
//│         return p_0$
//│       else
//│         set tmp7 = false;
//│         set p_0$1 = tmp7;
//│         return p_0$1
//│     end
//│   };
//│   set matcher__BacktrackOnRight$ = lambda¹;
//│   define lambda1 as fun lambda²(input) {
//│     let p_1$, p_1$1, tmp, tmp1;
//│     match input
//│       "same" =>
//│         set tmp = true;
//│         set p_1$ = tmp;
