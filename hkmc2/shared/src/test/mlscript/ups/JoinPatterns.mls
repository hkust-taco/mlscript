:js

pattern SimpleJoin = ("abc" | "xyz") ~ ("def" | "")

:expect true
"abc" is SimpleJoin
//│ = true

:expect true
"abcdef" is SimpleJoin
//│ = true

:expect true
"xyzdef" is SimpleJoin
//│ = true

:expect true
"xyz" is SimpleJoin
//│ = true

:expect false
"abcxyzdef" is SimpleJoin
//│ = false

:todo
// If we want to get rid of exponential blowup here, we need to memoize the
// entire sub-split instead of the innermost consequents.
pattern Exponential = ("a" | "b") ~ ("c" | "d") ~ ("e" | "f") ~ ("g" | "h") // ~ ("i" | "j") ~ ("k" | "l") ~ ("m" | "n") ~ ("o" | "p") ~ ("q" | "r") ~ ("s" | "t") ~ ("u" | "v") ~ ("w" | "x") ~ ("y" | "z")

:expect true
"aceg" is Exponential
//│ = true

:expect true
"bcfh" is Exponential
//│ = true

"abcdefghijklm" is Exponential
//│ = false
