:js

open annotations

data class Pair[A, B](first: A, second: B)
pattern NumPair = Pair(Num, Num)
pattern SumPair = Pair((Num as x), (Num as y)) => x + y

// TLDR: This file tests the case where a compiled pattern's result is bound
// with `as`, but the pattern itself does not involve any transformations.
//
// `toNumPair` should still compile without creating `MatchSuccess` or
// `MatchFailure`: all matchers should return Boolean values, and the use site
// should set the output binding `s` to the original scrutinee `t`.
//
// `toSumPair` is the counterexample: because it has a transform and the use
// site binds the pattern's output, it still creates `MatchSuccess` and
// `MatchFailure`.

:sir
fun toNumPair(t) = if t is (@compile NumPair) as s then s else null
//│ Lowered:
//│ let toNumPair⁰;
//│ define toNumPair⁰ as fun (t) {
//│   let s, matcher__NumPair$, matcher__Num$, matchSuccess, lambda, lambda1;
//│   define lambda as fun (input) {
//│     let first, second, first1, second1, p_0$, result1$, result1$1, p_0$1, tmp, tmp1, tmp2, tmp3;
//│     match input
//│       Pair⁰ =>
//│         match input
//│           Object⁰ =>
//│             match input
//│               Field(first) =>
//│                 set first1 = input.first﹖;
//│                 set tmp = matcher__Num$(first1);
//│                 end
//│               else
//│                 set tmp = false;
//│                 end
//│             end
//│           else
//│             set tmp = false;
//│             end
//│         set first = tmp;
//│         match input
//│           Object⁰ =>
//│             match input
//│               Field(second) =>
//│                 set second1 = input.second﹖;
//│                 set tmp1 = matcher__Num$(second1);
//│                 end
//│               else
//│                 set tmp1 = false;
//│                 end
//│             end
//│           else
//│             set tmp1 = false;
//│             end
//│         set second = tmp1;
//│         set result1$1 = first;
//│         match result1$1
//│           true =>
//│             set result1$ = second;
//│             match result1$
//│               true =>
//│                 set tmp2 = true;
//│                 end
//│               else
//│                 set tmp2 = false;
//│                 end
//│             end
//│           else
//│             set tmp2 = false;
//│             end
//│         set p_0$ = tmp2;
//│         return p_0$
//│       else
//│         set tmp3 = false;
//│         set p_0$1 = tmp3;
//│         return p_0$1
//│     end
//│   };
//│   set matcher__NumPair$ = lambda⁰;
//│   define lambda1 as fun (input1) {
//│     let p_1$, p_1$1, tmp, tmp1;
//│     match input1
//│       Num⁰ =>
//│         set tmp = true;
//│         set p_1$ = tmp;
//│         return p_1$
//│       else
//│         set tmp1 = false;
//│         set p_1$1 = tmp1;
//│         return p_1$1
//│     end
//│   };
//│   set matcher__Num$ = lambda¹;
//│   set matchSuccess = matcher__NumPair$(t);
//│   match matchSuccess
//│     true =>
//│       set s = t;
//│       return s
//│     else
//│       return null
//│   end
//│ };
//│ end



:sir
