:js

// Fixed-point patterns may list extra non-recursive alternatives between
// the self-reference and the trailing wildcard:
//
//   pattern P = Q as P | a | _
//
// reads `Q as (P | a | _)`. The recursive alternative fails exactly when
// `Q` cannot step, so `a` is matched exactly once, against the final
// normal form: if it matches, its output replaces the result; otherwise
// the wildcard keeps the normal form.

open annotations { compile }

data class Box(val value) with
  print("new Box(" + render(value) + ")")
data class Tag(val value) with
  print("new Tag(" + render(value) + ")")

pattern UnBox = Box(x) => x

// Peel all boxes; if a tag remains, untag it as well.
pattern PeelThenUntag = UnBox as PeelThenUntag | (Tag(x) => x) | _

let boxedTag = Box(Box(Tag(5)))
//│ > new Tag(5)
//│ > new Box(Tag(5))
//│ > new Box(Box(Tag(5)))
//│ boxedTag = Box(Box(Tag(5)))

:expect 5
if boxedTag is PeelThenUntag(r) then r else -1
//│ = 5

:expect 5
if boxedTag is @compile PeelThenUntag(r) then r else -1
//│ = 5

// The middle alternative is not tried on intermediate results such as
// `Box(7)`, only on the normal form; here it fails and the wildcard keeps
// the normal form.
let boxedNum = Box(Box(7))
//│ > new Box(7)
//│ > new Box(Box(7))
//│ boxedNum = Box(Box(7))

:expect 7
if boxedNum is PeelThenUntag(r) then r else -1
//│ = 7

:expect 7
if boxedNum is @compile PeelThenUntag(r) then r else -1
//│ = 7

// Middle alternatives do not rescue a failed first step: the chain still
// requires one `UnBox` step, even though `Tag(5)` matches the middle
// alternative.
:expect -1
if Tag(5) is PeelThenUntag(r) then r else -1
//│ > new Tag(5)
//│ = -1

:expect -1
if Tag(5) is @compile PeelThenUntag(r) then r else -1
//│ > new Tag(5)
//│ = -1


// ————— With an evaluation-context step pattern —————

data class Lit(val value) with
  print("new Lit(" + render(value) + ")")
data class Add(val lhs, val rhs) with
  print("new Add(" + render(lhs) + ", " + render(rhs) + ")")

pattern Value = Lit

pattern Ctx(pattern Hole) =
  | Hole
  | Add(Ctx(Hole), _)
  | Add(Value, Ctx(Hole))

pattern Redex = Add(Lit(a), Lit(b)) => Lit(a + b)

// Evaluate the sum and unwrap the final literal.
pattern EvalToInt = Ctx(Redex) as EvalToInt | (Lit(n) => n) | _

let sum = Add(Add(Lit(1), Lit(2)), Lit(3))
//│ > new Lit(1)
//│ > new Lit(2)
//│ > new Add(Lit(1), Lit(2))
//│ > new Lit(3)
//│ > new Add(Add(Lit(1), Lit(2)), Lit(3))
//│ sum = Add(Add(Lit(1), Lit(2)), Lit(3))

:expect 6
if sum is EvalToInt(r) then r else -1
//│ > new Lit(3)
//│ > new Add(Lit(3), Lit(3))
//│ > new Lit(6)
//│ = 6

:expect 6
if sum is @compile EvalToInt(r) then r else -1
//│ > new Lit(3)
//│ > new Add(Lit(3), Lit(3))
//│ > new Lit(6)
//│ = 6

// A stuck term does not match the middle alternative; the wildcard keeps
// the partially reduced term.
let stuck = Add(Add(Lit(1), Lit(2)), Tag(9))
//│ > new Lit(1)
//│ > new Lit(2)
//│ > new Add(Lit(1), Lit(2))
//│ > new Tag(9)
//│ > new Add(Add(Lit(1), Lit(2)), Tag(9))
//│ stuck = Add(Add(Lit(1), Lit(2)), Tag(9))

:expect 3
if stuck is EvalToInt(r) and r is Add(Lit(n), Tag(_)) then n else -1
//│ > new Lit(3)
//│ > new Add(Lit(3), Tag(9))
//│ = 3

:expect 3
if stuck is @compile EvalToInt(r) and r is Add(Lit(n), Tag(_)) then n else -1
//│ > new Lit(3)
//│ > new Add(Lit(3), Tag(9))
//│ > new Add(Lit(3), Tag(9))
//│ = 3
