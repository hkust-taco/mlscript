:js

// Fixed-point patterns may recurse indirectly through other definitions:
//
//   pattern StepsA = UnBox as StepsB | _
//   pattern StepsB = UnTag as StepsA | _
//
// The semantics is strict alternation: the steps fire in cycle order
// (`UnBox`, `UnTag`, `UnBox`, ...), the first step must succeed, and
// whenever the next step fails, the alternatives of the last fired link
// process the current term.

open annotations { compile }

data class Box(val value)
data class Tag(val value)

pattern UnBox = Box(x) => x
pattern UnTag = Tag(x) => x

pattern StepsA = UnBox as StepsB | _
pattern StepsB = UnTag as StepsA | _

let mixed = Box(Tag(Box(42)))
//│ mixed = Box(Tag(Box(42)))

:expect 42
if mixed is StepsA(r) then r else -1
//│ = 42

:expect 42
if mixed is @compile StepsA(r) then r else -1
//│ = 42

// The alternation is strict: after a box, a tag must follow, so the second
// box is left alone.
let doubleBox = Box(Box(42))
//│ doubleBox = Box(Box(42))

:expect Box(42)
if doubleBox is StepsA(r) then r else "<no match>"
//│ = Box(42)

:expect Box(42)
if doubleBox is @compile StepsA(r) then r else "<no match>"
//│ = Box(42)

// The cycle can be entered at either definition; `StepsA` requires a box
// first, while `StepsB` starts by unwrapping a tag.
let tagged = Tag(Box(42))
//│ tagged = Tag(Box(42))

:expect "no match"
if tagged is StepsA(r) then "matched" else "no match"
//│ = "no match"

:expect "no match"
if tagged is @compile StepsA(r) then "matched" else "no match"
//│ = "no match"

:expect 42
if tagged is StepsB(r) then r else -1
//│ = 42

:expect 42
if tagged is @compile StepsB(r) then r else -1
//│ = 42


// ————— Non-catch-all links —————

// After unboxing, either a tag must follow or the result must be another
// box; after untagging, anything goes.
pattern PeelA = UnBox as PeelB | Box(_)
pattern PeelB = UnTag as PeelA | _

:expect Box(7)
if Box(Box(7)) is PeelA(r) then r else "<no match>"
//│ = Box(7)

:expect Box(7)
if Box(Box(7)) is @compile PeelA(r) then r else "<no match>"
//│ = Box(7)

:expect 7
if Box(Tag(7)) is PeelA(r) then r else "<no match>"
//│ = 7

:expect 7
if Box(Tag(7)) is @compile PeelA(r) then r else "<no match>"
//│ = 7

:expect "no match"
if Box(7) is PeelA(r) then "matched" else "no match"
//│ = "no match"

:expect "no match"
if Box(7) is @compile PeelA(r) then "matched" else "no match"
//│ = "no match"


// ————— A longer cycle —————

pattern Cycle1 = UnBox as Cycle2 | _
pattern Cycle2 = UnTag as Cycle3 | _
pattern Cycle3 = UnBox as Cycle1 | _

let chained = Box(Tag(Box(Box(Tag(Box(1))))))
//│ chained = Box(Tag(Box(Box(Tag(Box(1))))))

:expect 1
if chained is Cycle1(r) then r else -1
//│ = 1

:expect 1
if chained is @compile Cycle1(r) then r else -1
//│ = 1


// ————— Body-annotated links —————

// Annotating a link's right-hand side embeds the alternation machine in its
// generated `unapply`, so plain use sites get the machine.
pattern FastA = @compile (UnBox as FastB | _)
pattern FastB = UnTag as FastA | _

:expect 42
if mixed is FastA(r) then r else -1
//│ = 42

:expect Box(42)
if doubleBox is FastA(r) then r else "<no match>"
//│ = Box(42)
