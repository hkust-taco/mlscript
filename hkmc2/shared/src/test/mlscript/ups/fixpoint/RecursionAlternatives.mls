:js

// A fixed-point pattern may have several recursive alternatives:
//
//   pattern P = (Q as P) | (R as P) | _
//
// The steps are tried in order at every iteration: an `R` step is taken
// only when no `Q` step applies, and after it, `Q` regains priority. Note
// that unlike the chain shape, the trailing alternatives are disjuncts of
// the whole chains rather than of their tails, so a match with zero steps
// is allowed: the alternatives then process the original scrutinee.

open annotations { compile }

data class Box(val value)
data class Tag(val value)

pattern UnBox = Box(x) => x
pattern UnTag = Tag(x) => x

// Peel boxes and tags in any interleaving.
pattern PeelBoth = (UnBox as PeelBoth) | (UnTag as PeelBoth) | _

let wrapped = Box(Tag(Box(42)))
//│ wrapped = Box(Tag(Box(42)))

:expect 42
if wrapped is PeelBoth(r) then r else -1
//│ = 42

:expect 42
if wrapped is @compile PeelBoth(r) then r else -1
//│ = 42

// Zero steps are allowed: the wildcard accepts the unwrappable scrutinee.
:expect 7
if 7 is PeelBoth(r) then r else -1
//│ = 7

:expect 7
if 7 is @compile PeelBoth(r) then r else -1
//│ = 7


// ————— Step priority —————

data class Lit(val value)
data class Add(val lhs, val rhs)

pattern Value = Lit

pattern Ctx(pattern Hole) =
  | Hole
  | Add(Ctx(Hole), _)
  | Add(Value, Ctx(Hole))

// The proper step adds two literals; the sloppy step gives up on the right
// operand. Both match `Add(Lit(1), Lit(2))`, so the result tells which one
// was prioritized.
pattern ProperStep = Ctx(Add(Lit(a), Lit(b)) => Lit(a + b))
pattern SloppyStep = Ctx(Add(Lit(a), _) => Lit(a))

pattern EvalSloppy = (ProperStep as EvalSloppy) | (SloppyStep as EvalSloppy) | _

// Both operands are literals: the proper step must win.
:expect 3
if Add(Lit(1), Lit(2)) is EvalSloppy(r) and r is Lit(n) then n else -1
//│ = 3

:expect 3
if Add(Lit(1), Lit(2)) is @compile EvalSloppy(r) and r is Lit(n) then n else -1
//│ = 3

// The right operand is stuck: only the sloppy step applies.
:expect 1
if Add(Lit(1), Tag(9)) is EvalSloppy(r) and r is Lit(n) then n else -1
//│ = 1

:expect 1
if Add(Lit(1), Tag(9)) is @compile EvalSloppy(r) and r is Lit(n) then n else -1
//│ = 1

// The steps alternate as needed: the left sum is reduced properly before
// the sloppy step drops the stuck right operand.
:expect 3
if Add(Add(Lit(1), Lit(2)), Tag(9)) is EvalSloppy(r) and r is Lit(n) then n else -1
//│ = 3

:expect 3
if Add(Add(Lit(1), Lit(2)), Tag(9)) is @compile EvalSloppy(r) and r is Lit(n) then n else -1
//│ = 3


// ————— Without a catch-all —————

// Peel boxes and tags; the result must be a literal.
pattern PeelToLit = (UnBox as PeelToLit) | (UnTag as PeelToLit) | Lit(_)

:expect Lit(1)
if Box(Tag(Lit(1))) is PeelToLit(r) then r else "<no match>"
//│ = Lit(1)

:expect Lit(1)
if Box(Tag(Lit(1))) is @compile PeelToLit(r) then r else "<no match>"
//│ = Lit(1)

:expect "no match"
if Box(Tag(7)) is PeelToLit(r) then "matched" else "no match"
//│ = "no match"

:expect "no match"
if Box(Tag(7)) is @compile PeelToLit(r) then "matched" else "no match"
//│ = "no match"

:expect Lit(5)
if Lit(5) is PeelToLit(r) then r else "<no match>"
//│ = Lit(5)

:expect Lit(5)
if Lit(5) is @compile PeelToLit(r) then r else "<no match>"
//│ = Lit(5)
