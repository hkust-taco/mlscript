:js

open annotations

pattern Lower = "a"..="z"

"a" is Lower
//│ = true

"z" is Lower
//│ = true

"0" is Lower
//│ = false

pattern Upper = "A"..="Z"

"A" is Upper
//│ = true

"Q" is Upper
//│ = true

"b" is Upper
//│ = false

pattern UnsignedShort = 0 ..< 65536

0 is UnsignedShort
//│ = true

-1 is UnsignedShort
//│ = false

65535 is UnsignedShort
//│ = true

65536 is UnsignedShort
//│ = false

2147483647 is UnsignedShort
//│ = false

"b" is UnsignedShort
//│ = false

[] is UnsignedShort
//│ = false

:pe
:e
// Don't forget to add a space between numbers and the range operator.
pattern UnsignedByte = 0..< 256
//│ ╔══[LEXICAL ERROR] Expected at least one digit after the  decimal point
//│ ║  l.53: 	pattern UnsignedByte = 0..< 256
//│ ╙──      	                         ^
//│ ╔══[COMPILATION ERROR] Name not found: .<
//│ ║  l.53: 	pattern UnsignedByte = 0..< 256
//│ ╙──      	                         ^^
//│ ╔══[COMPILATION ERROR] Cannot use this ‹error› as a pattern.
//│ ║  l.53: 	pattern UnsignedByte = 0..< 256
//│ ╙──      	                         ^^

:e
pattern BadRange = "s"..=0
//│ ╔══[COMPILATION ERROR] The upper and lower bounds of range patterns should be literals of the same type.
//│ ║  l.65: 	pattern BadRange = "s"..=0
//│ ╙──      	                   ^^^^^^^

// It becomes an absurd pattern.
0 is BadRange
//│ = true

:e
pattern BadRange = 0 ..= "s"
//│ ╔══[COMPILATION ERROR] The upper and lower bounds of range patterns should be literals of the same type.
//│ ║  l.75: 	pattern BadRange = 0 ..= "s"
//│ ╙──      	                   ^^^^^^^^^

:e
pattern BadRange = "yolo" ..= "swag"
//│ ╔══[COMPILATION ERROR] The lower bound of character ranges must be a single character.
//│ ║  l.81: 	pattern BadRange = "yolo" ..= "swag"
//│ ║        	                   ^^^^^^
//│ ╟── The upper bound of character ranges must be a single character.
//│ ║  l.81: 	pattern BadRange = "yolo" ..= "swag"
//│ ╙──      	                              ^^^^^^

// Ranges denote sets of single characters or numbers, so the scrutinee is
// type-guarded before the bound comparisons — bare JS comparisons would
// otherwise coerce foreign values (`[]` compares equal to `0`, tested with
// `UnsignedShort` above) and compare strings lexicographically.

// A character range matches exactly one character:

:expect true
"b" is Lower
//│ = true

:expect false
"abc" is Lower
//│ = false

:expect false
"" is Lower
//│ = false

:expect false
42 is Lower
//│ = false

// The plain and compiled paths agree:

:expect false
"abc" is @compile Lower
//│ = false

// An integer range matches integers only:

:expect true
6 is (5 ..= 7)
//│ = true

:expect false
5.5 is (5 ..= 7)
//│ = false

// A decimal range matches any number in it, including integers:

:expect true
6.5 is (5.5 ..= 7.5)
//│ = true

:expect true
7 is (5.5 ..= 7.5)
//│ = true

:expect false
8 is (5.5 ..= 7.5)
//│ = false

:expect false
[] is (0.0 ..= 1.0)
//│ = false

// `Char.AnyChar` is the full character range:

import "../../mlscript-compile/Char.mls"

:expect true
"a" is Char.AnyChar
//│ = true

:expect true
"\t" is Char.AnyChar
//│ = true

:expect false
"" is Char.AnyChar
//│ = false

:expect false
"ab" is Char.AnyChar
//│ = false

:expect false
"😀" is Char.AnyChar
//│ = false

:expect false
42 is Char.AnyChar
//│ = false
