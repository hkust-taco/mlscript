:js

open annotations { compile }

pattern Zero = "0"
pattern One = "1"
pattern Two = "2"

:ucs normalized
:fixme
fun checkZeroOneTwo(x) = if x is
  @compile Zero then 0
  @compile One then 1
  @compile Two then 2
  else ()
