pattern Parse = 0

let tokens
//│ tokens = undefined

// Works:
if tokens is @compile Parse as stack do print(stack)

// Aliases inside the compiled pattern remain available to the branch.
if tokens is
  @compile Parse as stack do print(stack)

// The alias can also sit outside the annotation.
if tokens is
  (@compile Parse) as stack do print(stack)

