:fixme
pattern Sym =
  ([x, y] where (x == y))
//│ ╔══[WARNING] Useless pattern binding: x.
//│ ║  l.31: 	  ([x, y] where (x == y))
//│ ╙──      	    ^
//│ ╔══[WARNING] Useless pattern binding: y.
//│ ║  l.31: 	  ([x, y] where (x == y))
//│ ╙──      	       ^

// * It does work, though:

[1, 1] is Sym
//│ = true

[1, 2] is Sym
//│ = false

// ——— ——— ———

pattern Bin =
  [(1 => true) | (_ => false)]

fun f(x) = if x is Bin as res then res

:fixme
:expect false
f([0])
//│ ═══[RUNTIME ERROR] Expected: 'false', got: '[0]'
//│ = [0]

:fixme
:expect true
f([1])
//│ ═══[RUNTIME ERROR] Expected: 'true', got: '[1]'
//│ = [1]

