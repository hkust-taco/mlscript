import "../../mlscript-compile/Char.mls"

pattern Input =
  ((Char.Whitespace ~ (Input as inp)) => inp) | ((c ~ (Input as inp)) => [c, ..inp]) | ("" => [])

:fixme
if "a b c" is Input as chars then chars
//│ ═══[RUNTIME ERROR] RangeError: Maximum call stack size exceeded

// ——— ——— ———

// * Problems happen with `..` destrucuring of sequences (same happens with `...`)

fun go(stack) = if stack is
  [..stack, "+", "+"] then 0
  [..stack2, Str] then 1
  else print("Str??", stack is [..stack2, Str])

go([1, 2, "z"])
//│ > Str?? true

