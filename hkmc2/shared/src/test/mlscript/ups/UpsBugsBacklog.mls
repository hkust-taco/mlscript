pattern Parse = 0

let tokens
//│ tokens = undefined

// Works:
if tokens is @compile Parse as stack do print(stack)

:fixme // Should be a "name not found"
if tokens is
  @compile Parse as stack do print(stack)
//│ ╔══[COMPILATION ERROR] No definition found in scope for member 'stack'
