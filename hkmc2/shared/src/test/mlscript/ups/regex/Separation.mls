:js

import "../../../mlscript-compile/Iter.mls"

open annotations

pattern TailLines(pattern L) =
  | ("\n" ~ (Lines(L) as t)) => t
  | "" => []
pattern Lines(pattern L) = 
  | (((L as h) ~ (TailLines(L) as t)) => [h, ...t])
  | "" => []

:expect true
"hello" is Lines("hello")
//│ = true

:expect true
"hello" is @compile Lines("hello")
//│ = true

:expect true
"hello\nworld" is Lines("hello" | "world")
//│ = true

:expect true
"hello\nworld" is @compile Lines("hello" | "world")
//│ = true

:expect false
"hello\nworld" is Lines("hello")
//│ = false

:expect false
"hello\nworld" is @compile Lines("hello")
//│ = false

pattern Digit = "0" ..= "9"

pattern Integer = Digit ~ (Integer | "")

"12345" is Integer
//│ = true

Integer.unapplyStringPrefix("123")
//│ = MatchSuccess(["123", ""], null)

// Beautiful!
"123\n456\n789" is Lines of Integer
//│ = true

"123\n456\n789" is @compile (Lines of Integer)
//│ = true

fun parseIntegers(input) =
  if input is (Lines of (Integer as n) => parseInt(n, 10)) as n then n

fun parseIntegersCompiled(input) =
  if input is @compile (Lines of (Integer as n) => parseInt(n, 10)) as n then n

parseIntegers of "123\n456\n789"
//│ = [123, 456, 789]

parseIntegersCompiled of "123\n456\n789"
//│ = [123, 456, 789]

:e
:re
// We may need a shorthand syntax to obtain the result of pattern matching.
// `t through P` means match `t` against `P` and returns the result.
"123\n456\n789" through Lines(Integer) // ==> [123, 456, 789]
//│ ╔══[COMPILATION ERROR] Illegal juxtaposition right-hand side (identifier).
//│ ║  l.71: 	"123\n456\n789" through Lines(Integer) // ==> [123, 456, 789]
//│ ╙──      	                ^^^^^^^
//│ ═══[RUNTIME ERROR] TypeError: Lines1 is not a function
