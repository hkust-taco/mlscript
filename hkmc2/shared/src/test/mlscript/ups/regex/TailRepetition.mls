:js

import "../../../mlscript-compile/Runtime.mls"


pattern Zero = "0"

Zero
//│ = pattern Zero

:expect true
Zero.unapply("0") is Runtime.MatchSuccess
//│ = true

:expect true
"0" is Zero
//│ = true

pattern ManyZeros = "0" ~ (ManyZeros | "")

:expect false
"" is ManyZeros
//│ = false

:expect true
"0" is ManyZeros
//│ = true

:expect true
"000" is ManyZeros
//│ = true

:expect false
"0001" is ManyZeros
//│ = false

:expect false
"1" is ManyZeros
//│ = false

:expect false
"1000" is ManyZeros
//│ = false

pattern Rep(pattern S) = S ~ (Rep(S) | "")

"00000" is Rep("0")
//│ = true
