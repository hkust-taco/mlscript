:js

open annotations

// Regressions of the compiled string pattern engine (`ups.StringCompiler` and
// `Runtime.StrPat`) against the naive translation it replaced. Each block
// records the *correct* answer with `:expect`; the ones still marked `:fixme`
// are not fixed yet, the rest are regression tests for bugs already fixed.


// ——— Purity of a recursive component must not depend on alternative order ———
//
// `isPureDeep` used to memoize the optimistic answer it assumes for an
// instantiation already being visited, so a member of an impure SCC could be
// recorded as pure — which member depending on where `forall` happened to
// short-circuit, i.e. on the order the alternatives are written in. The two
// spellings below must agree.

pattern Y = ("a" ~ X) | (("b" ~ "c") => "T")
pattern X = ("d" ~ Y) | "e"

:expect "zae"
if "zae" is ("z" ~ Y) as r then r else "no"
//│ = "zae"

// The same grammar with `Y`'s alternatives swapped compiles correctly.

pattern Y2 = (("b" ~ "c") => "T") | ("a" ~ X2)
pattern X2 = ("d" ~ Y2) | "e"

:expect "zae"
if "zae" is ("z" ~ Y2) as r2 then r2 else "no"
//│ = "zae"


// ——— A string region must not match a non-string scrutinee ———
//
// `makeStringRegionSplit` used to emit the `StrPat` call with no `Str` class
// test, unlike the `Str` head of the multi-matcher, so `matchWhole` read
// `input.length` off whatever it was given and reported a match.

pattern Funny = "" ~ "" ~ ""

:expect false
42 is Funny
//│ = false

:expect false
[] is Funny
//│ = false

// The multi-matcher always got this right: it tests the `Str` head first.

:expect false
42 is @compile Funny
//│ = false


// ——— Exclusive string ranges ———
//
// `Instantiator` used to drop `rightInclusive` when building a `CharClass`, so
// `..<` silently became `..=` as soon as the range sat inside a `~` sequence.

pattern Half = ("a" ..< "z") ~ "!"

:expect false
"z!" is Half
//│ = false

:expect true
"y!" is Half
//│ = true

// Outside a sequence the range goes through `makeRangeTest` instead, which
// always honoured the flag — the two must agree.

pattern Plain = "a" ..< "z"

:expect false
"z" is Plain
//│ = false

// An empty range — exclusive (`5 ..< 5`) or reversed (`5 ..= 3`) — must
// match nothing. It expands to an empty disjunction, which used to make it
// match *everything*: `Or(Nil)` was the wildcard until the encoding of the
// pattern-lattice units was fixed to `Never = Or(Nil)`.

:expect false
5 is @compile (5 ..< 5)
//│ = false

:expect false
4 is @compile (5 ..= 3)
//│ = false

:expect false
"hello" is (5 ..< 5) ~ ""
//│ = false


// ——— Bindings of the outer activations of a recursive component ———
//
// Binding slots are global to the region and rewritten by every recursion
// level. `Op.Defer` captures the slots a deferred frame reads before writing,
// but a slot that a frame *writes* (here `t`) is read back from the global
// store, so the outermost transform sees the innermost activation's `h`.

pattern Digit = "0" ..= "9"
pattern Listed = (((Digit as h) ~ (Listed as t)) => h + "," + t) | ("" => "$")

:expect "1,$"
if "1" is Listed as l1 then l1 else "NOPE"
//│ = "1,$"

:expect "1,2,$"
:fixme
if "12" is Listed as l2 then l2 else "NOPE"
//│ ═══[RUNTIME ERROR] Expected: '"1,2,$"', got: '"2,2,$"'
//│ = "2,2,$"

:expect "1,2,3,$"
:fixme
if "123" is Listed as l3 then l3 else "NOPE"
//│ ═══[RUNTIME ERROR] Expected: '"1,2,3,$"', got: '"3,2,3,$"'
//│ = "3,2,3,$"

// The multi-matcher route compiles the same definition correctly.

fun listedCompiled(s) = if s is @compile Listed as l then l else "NOPE"

:expect "1,2,3,$"
listedCompiled("123")
//│ = "1,2,3,$"


// ——— Transforms must run exactly once on the committed parse ———
//
// `multiMatcherStringBranch` used to call `matchWhole` in match-only mode
// even when the region had transforms, so `@compile` silently dropped their
// effects. Both call sites now consult `Compiled.recognitionSuffices`, so
// the two spellings below must print alike.

fun probe(x) = if x is ("a" => print("ran")) ~ "b" then "yes" else "no"

probe("ab")
//│ > ran
//│ = "yes"

fun probeCompiled(x) = if x is @compile (("a" => print("ran")) ~ "b") then "yes" else "no"

probeCompiled("ab")
//│ > ran
//│ = "yes"


// ——— Use sites of parametric string patterns ignore extraction parameters ———
//
// `isParametricStringSite` routes the site to an in-place automaton, which
// only knows about the region's own output, so the extraction parameter is
// lost and the whole match is returned instead.

pattern Bracket(pattern P, inner) = "[" ~ (P as inner) ~ "]"

:expect "ab"
:fixme
if "[ab]" is Bracket(Str) as bv then bv else "no"
//│ ═══[RUNTIME ERROR] Expected: '"ab"', got: '"[ab]"'
//│ = "[ab]"

// Matching the extraction argument directly never worked (pre-existing).

:expect "ab"
:fixme
if "[ab]" is Bracket(Str, bx) then bx else "no"
//│ ═══[RUNTIME ERROR] Expected: '"ab"', got: '"no"'
//│ = "no"


// ——— Transform closures shared across the labels of one multi-matcher ———
//
// Each label of a multi-matcher gets its own `StringCompiler`, so a definition
// reached from two labels emits its transform lambda twice; both copies bind
// the same parameter symbols, which `SymbolRefresher` asserts against.

class Box(val v)

pattern T = (("a" ~ "b") as w) => [w]

pattern P2 = Box(T ~ "c") | Box(T ~ "d")

:fixme
fun f2(x) = if x is @compile P2 as y then y else "no"
//│ /!!!\ Uncaught error: java.lang.AssertionError: assertion failed: already defined: w
