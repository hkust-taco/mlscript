:js

pattern X = "x"

"x" is X
//│ = true

pattern Xs = X ~ (Xs | "")

"xxxxxxx" is Xs
//│ = true

pattern Xss = Xs ~ (Xss | "")

"xxxxxxxxxxxxxx" is Xss
//│ = true

pattern XsX = Xs ~ "x"

// In the following tests, the left-hand side of concatenation must not
// eagerly consume all letters. String patterns are compiled to automata whose
// splitting decisions are global to the whole sequence, so these all match.

:expect true
"xxxxxxxxxxxxxx" is XsX
//│ = true

pattern XssX = Xss ~ "x"

:expect true
"xxxxxxxx" is XssX
//│ = true

pattern XsXs = Xs ~ Xs

:expect true
"xxxxxx" is XsXs
//│ = true
