:js
:effectHandlers
:lift

open annotations

abstract class Read with
  fun read(): Str

// Ordinary transforms can resume effects. Compiled string transforms cannot
// suspend the parser yet, so effects escaping them must fail explicitly.

fun plain(e) = if "a" is ("a" => e.read()) as r then r else "no"
fun compiled(e) = if "ab" is (("a" => e.read()) ~ "b") as r then r else "no"

:expect "X"
handle e = Read with
  fun read()(k) = k("X")
in
  plain(e)
//│ = "X"

:re
handle e = Read with
  fun read()(k) = k("X")
in
  compiled(e)
//│ ═══[RUNTIME ERROR] Error: Effects cannot escape a compiled string pattern transform.

// Rejection precedes both the outer handler and later committed transforms.
// Catch the error within this call so the trace remains observable and the
// following match checks that the rejected effect did not leak into it.

fun aborting() =
  let trace = ""
  fun after() =
    set trace = "ran"
    "b"
  let result =
    js.try_catch of
      () =>
        handle e = Read with
          fun read()(k) =
            set trace += "handled"
            "stop"
        in
          if "ab" is (("a" => e.read()) ~ ("b" => after())) then "matched" else "no"
      error => error.message
  let recovery =
    handle e = Read with
      fun read()(k) = k("recovered")
    in
      plain(e)
  [result === "Effects cannot escape a compiled string pattern transform.", trace, recovery]

:expect [true, "", "recovered"]
aborting()
//│ = [true, "", "recovered"]


// Match-only compilation must reject an escaping effect too, even though its
// caller does not demand the transform's output.

fun compiledCondition(e) = "ab" is @compile (("a" => e.read()) ~ "b")

:re
handle e = Read with
  fun read()(k) = k("X")
in
  compiledCondition(e)
//│ ═══[RUNTIME ERROR] Error: Effects cannot escape a compiled string pattern transform.


// Named patterns share a handler value; entering its block at the call site
// exercises the generated prefix method without a nested pattern definition.

:silent
val reader =
  handle e = Read with
    fun read()(k) = k("X")
  in
    e

pattern Prefix = ("a" => reader.read()) ~ "b"

:re
enterHandleBlock(reader, () => Prefix.unapplyStringPrefix("abtail"))
//│ ═══[RUNTIME ERROR] Error: Effects cannot escape a compiled string pattern transform.


// An effect in a deferred recursive transform must stop outer frames too.
// The outer transform throws a different error if the parser runs it.

pattern Nested = (("a" ~ Nested) => throw Error("Unexpected outer recursive transform")) | (("b" ~ Nested) => reader.read()) | ""

:expect "Effects cannot escape a compiled string pattern transform."
js.try_catch of
  () => enterHandleBlock(reader, () => if "ab" is Nested as r then r else "no")
  error => error.message
//│ = "Effects cannot escape a compiled string pattern transform."


// Handler constructs are temporarily forbidden in compiled transforms, even
// through a known helper that handles its own effects completely.

fun locallyHandled() =
  handle e = Read with
    fun read()(k) = k("X")
  in
    e.read()

:e
fun staticRejection() = if "ab" is (("a" => locallyHandled()) ~ "b") as r then r else "no"
//│ ╔══[COMPILATION ERROR] Effect handlers are not supported inside compiled string pattern transforms.
//│ ║  l.107: 	  handle e = Read with
//│ ║         	             ^^^^^^^^^
//│ ║  l.108: 	    fun read()(k) = k("X")
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.109: 	  in
//│ ║         	^^^^
//│ ║  l.110: 	    e.read()
//│ ║         	^^^^^^^^^^^^
//│ ╟── While compiling this string pattern transform.
//│ ║  l.113: 	fun staticRejection() = if "ab" is (("a" => locallyHandled()) ~ "b") as r then r else "no"
//│ ╙──       	                                            ^^^^^^^^^^^^^^^^

// Ordinary transforms still support the same helper.
:expect "X"
if "a" is ("a" => locallyHandled()) as r then r else "no"
//│ = "X"
