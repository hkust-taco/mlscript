pattern HelloWorld =
  (("hello" as a) ~ " " ~ ("world" as b)) =>
    "the user said " + a + " to the " + b

"hello world" is HelloWorld
//│ = true

if "hello world" is HelloWorld as x then x
//│ = "the user said hello to the world"
