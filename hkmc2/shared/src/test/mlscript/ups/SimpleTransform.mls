// Some helper functions to create `Term`s.
fun wrapLiteral(value) = if value is Int then Literal(value) else value
fun (+:+) add(a, b) = Infix("+", wrapLiteral(a), wrapLiteral(b))
fun (*:*) mul(a, b) = Infix("*", wrapLiteral(a), wrapLiteral(b))
fun (-:-) sub(a, b) = Infix("-", wrapLiteral(a), wrapLiteral(b))
fun (/:/) div(a, b) = Infix("/", wrapLiteral(a), wrapLiteral(b))
