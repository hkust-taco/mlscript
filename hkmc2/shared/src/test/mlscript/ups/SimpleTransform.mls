// The following pattern generates a lot of code.
pattern EvaluatedTerm =
  (Literal(value) => value) |
  (Infix("+", EvaluatedTerm as left, EvaluatedTerm as right) => left + right) |
  (Infix("-", EvaluatedTerm as left, EvaluatedTerm as right) => left - right) |
  (Infix("*", EvaluatedTerm as left, EvaluatedTerm as right) => left * right) |
  (Infix("/", EvaluatedTerm as left, EvaluatedTerm as right) => left / right) |
  (Prefix("-", EvaluatedTerm as operand) => -operand) |
  (Prefix("+", EvaluatedTerm as operand) => +operand)
