  nofibStringToList("(equal (eqp x y)(equal (fix x)(fix y) ) )") ::
  nofibStringToList("(equal (greaterp x y)(lessp y x) )") ::
  nofibStringToList("(equal (lesseqp x y)(not (lessp y x) ) )") ::
