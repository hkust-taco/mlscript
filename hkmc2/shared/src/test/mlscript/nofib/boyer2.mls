:js
:import NofibPrelude.mls
//│ Imported 111 member(s)



abstract class Lisplist: Nill | Atom | Conss

object Nill extends Lisplist
class
  Atom(a: List[Char]) extends Lisplist
  Conss(a: Tup2[Lisplist, Lisplist]) extends Lisplist

fun lispListEq(x, y) = if x is
  Nill and y is Nill then true
  Atom(a) and y is Atom(b) then listEq(a, b)
  Conss(Tup2(a, b)) and y is Conss(Tup2(c, d)) and (lispListEq(a, c)) then lispListEq(b, d)
  else false

fun lispmember(e_x) = if e_x is 
  Tup2(e, Conss(Tup2(x, xs))) and
    lispListEq(e, x) then true
    else lispmember(Tup2(e, xs))
  Tup2(_, _) then false
  
fun truep(term_l) = if term_l is
  Tup2(Nill, _) then false
  Tup2(Conss(Tup2(Atom(Cons("t", Nil)), Nill), _)) then true
  Tup2(term, l) then lispmember(Tup2(term, l))

fun falsep(term_l) = if term_l is
  Tup2(Nill, _) then false
  Tup2(Conss(Tup2(Atom(Cons("f", Nil)), Nill), _)) then true
  Tup2(term, l) then lispmember(Tup2(term, l))

fun tv(x) = if x is Atom(a) then a

fun atom(x) = if x is Atom(_) then true else false

fun car(x) = if x is Conss(Tup2(a, _)) then a else Nill

fun cdr(x) = if x is Conss(Tup2(_, b)) then b else Nill

fun cadr(x) = car(cdr(x))

fun caddr(x) = car(cdr(cdr(x)))

fun cadddr(x) = car(cdr(cdr(cdr(x))))

fun tautologyp(f_truelst_falselst) = if f_truelst_falselst is Tup3(f, truelst, falselst) and f is
  Nill then false
  Atom(x) then truep(Tup2(Atom(x), truelst))
  Conss(Tup2(x, y)) and
    truep(Tup2(Conss(Tup2(x, y)), truelst)) then true
    falsep(Tup2(Conss(Tup2(x, y)), falselst)) then false
    x is
      Atom(Cons("i", Cons("f", Nil))) and
        truep(Tup2(car(y), truelst)) then
          tautologyp(Tup3(cadr(y), truelst, falselst))
        falsep(Tup2(car(y), falselst)) then
          tautologyp(Tup3(caddr(y), truelst, falselst))
        else
          tautologyp(Tup3(cadr(y), Conss(Tup2(car(y), truelst)), falselst)) and tautologyp(Tup3(caddr(y), truelst, Conss(Tup2(car(y), falselst))))
      else false

fun sublist(t) = if t is
  Nil then Tup2(Nil, Nill)
  Cons(Cons("(", Nil), t) and sublist(t) is Tup2(r1, l1) and sublist(r1) is Tup2(r2, l2) then Tup2(r2, Conss(Tup2(l1, l2)))
  Cons(Cons(")", Nil), t) then Tup2(t, Nill)
  Cons(h, t) and sublist(t) is Tup2(r, l) then Tup2(r, Conss(Tup2(Atom(h), l)))

fun mkLispList(ls) = if ls is
  Cons(Cons("(", Nil), t) and sublist(t) is Tup2(r, l) and r is
    Nil then l
    else Nill
  _ then Nill

fun restOfToken(s) = if s is
  Nil then Tup2(Nil, Nil)
  Cons(h, t) and
    (h === "(") || (h === ")") || (h === " ") then Tup2(Nil, Cons(h, t))
    restOfToken(t) is Tup2(a, b) then Tup2(Cons(h, a), b)

fun getToken(s) = if s is
  Nil then Tup2(Nil, Nil)
  Cons(h, t) and
    (h === " ") then getToken(t)
    (h === "(") || (h === ")") then Tup2(Cons(h, Nil), t)
    restOfToken(t) is Tup2(a, b) then Tup2(Cons(h, a), b)

fun strToToken(s) = if
  s is Nil then Nil
  getToken(s) is Tup2(a, b) then Cons(a, strToToken(b))

fun assoc(term_x_y) = if term_x_y is
  Tup2(term, Conss(Tup2(x, y))) and x is
    Conss(Tup2(Atom(key), rest)) and
      lispListEq(term, Atom(key)) then x
      else assoc(Tup2(term, y))
    _ then Nill
  Tup2(_, _) then Nill

type LUTentry = Tup2[String, List[Lisplist]]

abstract class LUT: Empty | Node

object Empty extends LUT

class Node(x: Tup3[LUT, LUTentry, LUT]) extends LUT

fun addtoLUT(k_l_lut) = if k_l_lut is
  Tup3(k, l, Empty) then Node(Tup3(Empty, Tup2(k, Cons(l, Nil)), Empty))
  Tup3(k, l, Node(Tup3(left, Tup2(k1, kl), right))) and
    listEq(k, k1) then Node(Tup3(left, Tup2(k1, Cons(l, kl)), right))
    ltList(k, k1, (x, y) => x < y, (x, y) => x > y) then Node(Tup3(addtoLUT(Tup3(k, l, left)), Tup2(k1, kl), right))
    else Node(Tup3(left, Tup2(k1, kl), addtoLUT(Tup3(k, l, right))))

fun getLUT(t_lut) = if t_lut is
  Tup2(t, Empty) then Nil
  Tup2(t, Node(Tup3(left, Tup2(k, kl), right))) and
    listEq(t, k) then kl
    ltList(t, k, (x, y) => x < y, (x, y) => x > y) then getLUT(Tup2(t, left))
    else getLUT(Tup2(t, right))

fun makelemmas(rules) = if rules is
  Nil then Nil
  Cons(h, t) then Cons(mkLispList(strToToken(h)), makelemmas(t))

fun addlemma(lspls, term) = if lspls is
  Nill then term
  Atom(x) then throw new Error("error")
  Conss(Tup2(x, y)) then
    let z = car(y)
    if listEq(tv(x), nofibStringToList("equal")) and (not(atom(z)))
    then addtoLUT(Tup3(tv(car(z)), Conss(Tup2(x, y)), term))
    else throw new Error("error")

fun addlemmalst(lspls, term) = if lspls is
  Nil then term
  Cons(h, t) then addlemmalst(t, addlemma(h, term))

