fun showPiece(p) = if p is
  X then nofibStringToList("X")
  O then nofibStringToList("O")
  Empty then nofibStringToList(" ")

fun showRow(ps) = if ps is
  Cons(p1, Cons(p2, Cons(p3, Nil))) then
    append(append(showPiece(p1), nofibStringToList("|")), append(showPiece(p2), append(nofibStringToList("|"), showPiece(p3))))

fun showBoard(rs) = if rs is
  Cons(r1, Cons(r2, Cons(r3, Nil))) then
    append(
      showRow(r1),
      append(
        nofibStringToList("\n------\n"),
        append(
          showRow(r2),
          append(
            nofibStringToList("\n------\n"),
            append(
              showRow(r3),
              nofibStringToList("\n\n")
            )
          )
        )
      )
    )

fun insert(p, ps, i) = if ps is Cons(p1, Cons(p2, Cons(p3, Nil))) and i ===
  1 then Cons(p, Cons(p2, Cons(p3, Nil)))
  2 then Cons(p1, Cons(p, Cons(p3, Nil)))
  3 then Cons(p1, Cons(p2, Cons(p, Nil)))

fun empty_(x, r) = if
  x === 1 and r is Cons(Empty, Cons(_, Cons(_, Nil))) then true
  x === 2 and r is Cons(_, Cons(Empty, Cons(_, Nil))) then true
  x === 3 and r is Cons(_, Cons(_, Cons(Empty, Nil))) then true
  else false

fun empty(pos, board) = if board is Cons(r1, Cons(r2, Cons(r3, Nil))) and pos is
  Tup2(1, x) then empty_(x, r1)
  Tup2(2, x) then empty_(x, r2)
  Tup2(3, x) then empty_(x, r3)

fun placePiece(p, board, pos) = if
  not(empty(pos, board)) then Nil
  board is Cons(r1, Cons(r2, Cons(r3, Nil))) and pos is
    Tup2(1, x) then (insert(p, r1, x) :: r2 :: r3 :: Nil) :: Nil
    Tup2(2, x) then (r1 :: insert(p, r2, x) :: r3 :: Nil) :: Nil
    Tup2(3, x) then (r1 :: r2 :: insert(p, r3, x) :: Nil) :: Nil

fun fullBoard(b) = andd(map(
  x => not(eqPiece(x, Empty)),
  concat(b)
))

fun newPositions(piece, board) =
  fun lscomp1(ls) = if ls is
    Nil then Nil
    Cons(x, xs) then
      fun lscomp2(ls) = if ls is
        Nil then lscomp1(xs)
        Cons(y, ys) then Cons(Tup2(x, y), lscomp2(ys))
      lscomp2(1 :: 2 :: 3 :: Nil)
  concat(map(
    pos => placePiece(piece, board, pos),
    lscomp1(1 :: 2 :: 3 :: Nil)
  ))
  
let initialBoard = replicate(3, replicate(3, Empty))
//│ > Cons {
//│ >   head: Cons {
//│ >     head: Empty { class: [class Empty] },
//│ >     tail: Cons { head: [Empty], tail: [Cons] }
//│ >   },
//│ >   tail: Cons {
//│ >     head: Cons { head: [Empty], tail: [Cons] },
//│ >     tail: Cons { head: [Cons], tail: [Nil] }
//│ >   }
//│ initialBoard = }

fun eval(x) = if x ===
  3 then XWin
  -3 then OWin
  else Score(x)

fun interpret(x, l) = if l is
  Nil then Score(x)
  Cons(Score(y), ls) then interpret(x + y, ls)
  Cons(XWin, _) then XWin
  Cons(OWin, _) then OWin

fun scorePiece(p, score) = if p is
  X then score
  Empty then 0
  O then -score

fun map2(f, xs, ys) = if xs is
  Nil then Nil
  Cons(x, xs) and
    ys is Cons(y, ys) then Cons(f(x, y), map2(f, xs, ys))
    Nil then Nil

fun score(board, win) = eval(sum(map(sum, map2((x, y) => map2(scorePiece, x, y), board, win))))

fun static(board) = interpret(0, map(x => score(board, x), wins))

fun repTree(f, g, a) = Branch(a, map(x => repTree(g, f, x), f(a)))

fun mapTree(f, t) = if t is Branch(a, l) then Branch(f(a), map(x => mapTree(f, x), l))

fun prune(n, t) = if t is Branch(a, l) and n
  === 0 then Branch(a, Nil)
  < 0 then throw Error("Tree.prune: < 0")
  else Branch(a, map(x => prune(n - 1, x), l))

fun opposite(p) = if p is
  X then O
  O then X
  else throw Error("opposite")

fun best(f, bs, ss) = if bs is Cons(b, bs) and ss is Cons(s, ss) then
  fun best_(b, s, ls1, ls2) = if ls1 is
    Nil and ls2 is Nil then Tup2(b, s)
    Cons(b_, bs) and ls2 is Cons(s_, ss) and
      evaluationEq(s, f(s, s_)) then best_(b, s, bs, ss)
      else best_(b_, s_, bs, ss)
  best_(b, s, bs, ss)

fun showMove(m) = if m is Tup2(b, e) then
  append(showEvaluation(e), append(nofibStringToList("\n"), showBoard(b)))

fun max_(e1, e2) = if
  e1 is XWin then XWin
  e2 is XWin then XWin
  e2 is OWin then e1
  e1 is OWin then e2
  e1 is Score(x) and e2 is Score(y) and
    x > y then Score(x)
    else Score(y)

fun min_(e1, e2) = if
  e1 is OWin then OWin
  e2 is OWin then OWin
  e2 is XWin then e1
  e1 is XWin then e2
  e1 is Score(x) and e2 is Score(y) and
    x < y then Score(x)
    else Score(y)

fun mise(f, g, t) = if t is
  Branch(a, Nil) then a
  Branch(_, l) then foldr(f, g(OWin, XWin), map(x => mise(g, f, x), l))

fun searchTree(p, board) =
  prune(
    5,
    repTree(
      x => newPositions(p, x),
      x => newPositions(opposite(p), x),
      board
    )
  )

fun cropTree(t) = if t is
  Branch(a, Nil) then Branch(a, Nil)
  Branch(Score(x), l) then Branch(Score(x), map(cropTree, l))
  Branch(x, l) then Branch(x, Nil)

fun bestMove(p, f, g, b) =
  mise(f, g, cropTree(mapTree(static, searchTree(p, b))))


fun alternate(player, f, g, board) = if
  fullBoard(board) then Nil
  evaluationEq(static(board), XWin) then Nil
  evaluationEq(static(board), OWin) then Nil
  let opposition = opposite(player)
  let possibles = newPositions(player, board)
  let scores = map(x => bestMove(opposition, g, f, x), possibles)
  let boardd_eval = best(f, possibles, scores)
  boardd_eval is Tup2(boardd, eval) then
    Cons(Tup2(boardd, eval), alternate(opposition, g, f, boardd))

fun prog(input) =
  let testBoard =
    (Empty :: O :: Empty :: Nil) ::
    (Empty :: X :: Empty :: Nil) ::
    (Empty :: Empty :: Empty :: Nil) :: Nil
  fun board(x) = if x ===
    "doesn't happen" then append(testBoard, testBoard)
    else testBoard
  let game = alternate(X, max_, min_, board(input))
  append(
    nofibStringToList("OXO\n"),
    concat(map(showMove, game))
  )

print(nofibListToString(prog("180000")))
