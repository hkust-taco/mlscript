fun enumFromTo_lz(a, b) = lazy of () =>
  if a <= b then LzCons(a, enumFromTo_lz(a + 1, b)) else LzNil

fun last(ls) =
  fun go(h, t) = if t is
    Nil then h
    Cons(head, t) then go(head, t)
  if ls is
    Cons(h, t) then go(h, t)
    else throw Error("last: empty list")

class K(s: String, c1: Char, c2: Char, i: Int)

class H(f: Option[Int], s: Option[Int], ls: List[Int])

fun ends(k) = if k is K(_, a, z, _) then Cons(a, Cons(z, Nil))

fun assoc(x, yz) = if yz is
  Cons(Tup2(y, z), yzs) then if x === y then z else assoc(x, yzs)
  else throw Error("assoc: not found")

fun assocm(x, yz) = if yz is
  Cons(Tup2(y, z), yzs) then if x === y then Some(z) else assocm(x, yzs)
  else None

fun histins(x, yns) = if yns is
  Cons(Tup2(y, n), yns) then if x === y then Cons(Tup2(y, n + 1), yns) else Cons(Tup2(y, n), histins(x, yns))
  else Cons(Tup2(x, 1), Nil)

fun histo(ls) = foldr(histins, Nil, ls)

fun subset(xs, ys) = all(x => inList(x, ys), xs)

fun union(xs, ys) =
  fun lscomp(ls) = if ls is
    Nil then Nil
    Cons(h, t) and
      not(inList(h, xs)) then Cons(h, lscomp(t))
      else lscomp(t)
  append(xs, lscomp(ys))

fun attribkeys(ks) = map(k => K(k, head(k), last(k), listLen(k)), ks)

let numberofkeys = listLen(keys)
//│ numberofkeys = 22

fun minm(x, y) = if x is
  None then y
  Some(x) then min(x, y)

fun maxm(x, y) = if x is
  None then y
  Some(x) then max(x, y)

fun hash(cvs, k) = if k is K(_, a, z, n) then n + assoc(a, cvs) + assoc(z, cvs)

fun select(p, x, ts_fs) = if ts_fs is Tup2(ts, fs) and
  p(x) then Tup2(Cons(x, ts), fs)
  else Tup2(ts, Cons(x, fs))

fun partition_(p, ls) = foldr((x, y) => select(p, x, y), Tup2(Nil, Nil), ls)

fun freqsorted(x) = x

fun blocked_(ds, ls) = if ls is
  Nil then Nil
  Cons(k, ks) then
    let ds_ = union(ds, ends(k))
    if partition_(x => subset(ends(x), ds_), ks) is Tup2(det, rest) then
      Cons(k, append(det, blocked_(ds_, rest)))

fun blocked(ls) = blocked_(Nil, ls)

let freqtab = histo(concat(map(ends, attribkeys(keys))))
//│ > Cons {
//│ >   head: Tup2 { fst: 'e', snd: 8 },
//│ >   tail: Cons {
//│ >     head: Tup2 { fst: 'w', snd: 1 },
//│ >     tail: Cons { head: [Tup2], tail: [Cons] }
//│ >   }
//│ freqtab = }

let maxval = listLen(freqtab)
//│ maxval = 17

abstract class Status[T]: NotEver | YesIts[T]

class
  NotEver(i: Int) extends Status[Nothing]
  YesIts[T](i: Int, t: T) extends Status[T]

fun hinsert(h, hh) = if hh is H(lo, hi, hs) then
  let lo_ = minm(lo, h)
  let hi_ = maxm(hi, h)
  if inList(h, hs) || (1 + hi_ - lo_) > numberofkeys
  then None
  else Some(H(Some(lo_), Some(hi_), Cons(h, hs)))

fun first(k, ls) = if force(ls) is
  LzNil then NotEver(k)
  LzCons(a, l) and a is
    YesIts(leaves, y) then YesIts(k + leaves, y)
    NotEver(leaves) then first(k + leaves, l)

fun firstSuccess(f, possibles) = first(0, map_lz(f, possibles))

fun findhash_(keyHashSet, charAssocs, ks) = if ks is
  Nil then YesIts(1, charAssocs)
  Cons(K(s, a, z, n), ks) then
    fun tryy(newAssocs) =
      let newCharAssocs = append(newAssocs, charAssocs)
      if hinsert(hash(newCharAssocs, K(s, a, z, n)), keyHashSet) is
        None then NotEver(1)
        Some(newKeyHashSet) then findhash_(newKeyHashSet, newCharAssocs, ks)
    if Tup2(assocm(a, charAssocs), assocm(z, charAssocs)) is
      Tup2(None, None) and
        a === z then firstSuccess(m => tryy(Cons(Tup2(a, m), Nil)), enumFromTo_lz(0, maxval))
        else
          fun lscomp1(ls1) = lazy of () =>
            if force(ls1) is
              LzNil then LzNil
              LzCons(m, ms) then
                fun lscomp2(ls2) =
                  if force(ls2) is
                    LzNil then lscomp1(ms)
                    LzCons(n, ns) then lazy of () => LzCons(Tup2(m, n), lscomp2(ns))
                force(lscomp2(enumFromTo_lz(0, maxval)))
          firstSuccess(mn => if mn is Tup2(m, n) then tryy(Cons(Tup2(a, m), Cons(Tup2(z, n), Nil))), lscomp1(enumFromTo_lz(0, maxval)))
      Tup2(None, Some(zc)) then firstSuccess(m => tryy(Cons(Tup2(a, m), Nil)), enumFromTo_lz(0, maxval))
      Tup2(Some(ac), None) then firstSuccess(n => tryy(Cons(Tup2(z, n), Nil)), enumFromTo_lz(0, maxval))
      Tup2(Some(ac), Some(zc)) then tryy(Nil)

fun findhash(keys) = findhash_(H(None, None, Nil), Nil, keys)

fun freq(c) = assoc(c, freqtab)

fun morefreq(k1, k2) = if
  k1 is K(_, a, x, _) and k2 is K(_, b, y, _) then (freq(a) + freq(x)) > (freq(b) + freq(y))

fun cichelli(n) =
  let attribkeys_ = attribkeys(append(keys, take(intMod(n, 2), keys)))
  let hashkeys = blocked(freqsorted(attribkeys_))
  findhash(hashkeys)

fun prog(n) = cichelli(n)

prog(6).toString()
