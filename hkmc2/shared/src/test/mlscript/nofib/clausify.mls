:js
:import NofibPrelude.mls
//│ Imported 114 member(s)

abstract class Formula: Sym | Not | Dis | Con | Imp | Eqv

class
  Sym(a: Char) extends Formula
  Not(a: Formula) extends Formula
  Dis(a: Formula, b: Formula) extends Formula
  Con(a: Formula, b: Formula) extends Formula
  Imp(a: Formula, b: Formula) extends Formula
  Eqv(a: Formula, b: Formula) extends Formula

abstract class StackFrame: Ast | Lex

class
  Ast(f: Formula) extends StackFrame
  Lex(s: Char) extends StackFrame

fun charLt(a, b) = a < b
fun charLeq(a, b) = a <= b
fun charGt(a, b) = a > b
fun charGeq(a, b) = a >= b

fun insert(x, ys) = if ys is
  Nil then Cons(x, Nil)
  Cons(y, ys) and
    charLt(x, y) then Cons(x, Cons(y, ys))
    charGt(x, y) then Cons(y, insert(x, ys))
    else Cons(y, ys)

fun clauseHelper(p, x) = if p is
  Dis(p, q) then clauseHelper(p, clauseHelper(q, x))
  Sym(s) and x is Tup2(c, a) then Tup2(insert(s, c), a)
  Not(Sym(s)) and x is Tup2(c, a) then Tup2(c, insert(s, a))

fun clause(p) = clauseHelper(p, Tup2(Nil, Nil))

fun conjunct(p) = if p is Con(_, _) then true else false

fun disin(p) = if p is
  Dis(p, Con(q, r)) then Con(disin(Dis(p, q)), disin(Dis(p, r)))
  Dis(Con(p, q), r) then Con(disin(Dis(p, r)), disin(Dis(q, r)))
  Dis(p, q) then
    let dp = disin(p)
    let dq = disin(q)
    if conjunct(dp) || conjunct(dq) then disin(Dis(dp, dq)) else Dis(dp, dq)
  Con(p, q) then Con(disin(p), disin(q))
  else p

fun elim(p) = if p is
  Sym(s) then Sym(s)
  Not(p) then Not(elim(p))
  Dis(p, q) then Dis(elim(p), elim(q))
  Con(p, q) then Con(elim(p), elim(q))
  Imp(p, q) then Dis(Not(elim(p)), elim(q))
  Eqv(f, f_) then Con(elim(Imp(f, f_)), elim(Imp(f_, f)))
  
fun interleave(xs, ys) = if xs is
  Cons(x, xs) then Cons(x, interleave(ys, xs))
  Nil then Nil

fun negin(p) = if p is
  Not(Not(p)) then negin(p)
  Not(Con(p, q)) then Dis(negin(Not(p)), negin(Not(q)))
  Not(Dis(p, q)) then Con(negin(Not(p)), negin(Not(q)))
  Dis(p, q) then Dis(negin(p), negin(q))
  Con(p, q) then Con(negin(p), negin(q))
  else p

fun opri(c) = if c
  === "(" then 0
  === "=" then 1
  === ">" then 2
  === "|" then 3
  === "&" then 4
  === "~" then 5
  else throw Error(c)
  
fun red(s) = if s is
  Cons(Ast(p), Cons(Lex("="), Cons(Ast(q), s))) then Cons(Ast(Eqv(q, p)), s)
  Cons(Ast(p), Cons(Lex(">"), Cons(Ast(q), s))) then Cons(Ast(Imp(q, p)), s)
  Cons(Ast(p), Cons(Lex("|"), Cons(Ast(q), s))) then Cons(Ast(Dis(q, p)), s)
  Cons(Ast(p), Cons(Lex("&"), Cons(Ast(q), s))) then Cons(Ast(Con(q, p)), s)
  Cons(Ast(p), Cons(Lex("~"), s)) then Cons(Ast(Not(p)), s)

fun spri(s) = if s is
  Cons(Ast(x), Cons(Lex(c), s)) then opri(c)
  else 0

fun redstar(s) = while_(s => spri(s) != 0, red, s)

fun spaces(n) = replicate(n, " ")

fun parseHelper(t, s) = if t is
  Nil then redstar(s)
  Cons(" ", t) then parseHelper(t, s)
  Cons("(", t) then parseHelper(t, Cons(Lex("("), s))
  Cons(")", t) and redstar(s) is Cons(x, Cons(Lex("("), ss)) then parseHelper(t, Cons(x, ss))
  Cons(c, t) and
    charLeq("a", c) && charLeq(c, "z") then parseHelper(t, Cons(Ast(Sym(c)), s))
    spri(s) > opri(c) then parseHelper(Cons(c, t), red(s))
    else parseHelper(t, Cons(Lex(c), s))

fun parse(t) = if parseHelper(t, Nil) is Cons(Ast(f), Nil) then f

fun splitHelper(p, a) = if p is
  Con(p, q) then splitHelper(p, splitHelper(q, a))
  else Cons(p, a)

fun split(p) = splitHelper(p, Nil)

fun tautclause(c_a) = if c_a is Tup2(c, a) then
  fun lscomp(ls) = if ls is
    Nil then Nil
    Cons(h, t) and
      inList(h, a) then Cons(h, lscomp(t))
      else lscomp(t)
  listNeq(lscomp(c), Nil)

fun uniclHelper(p, x) =
  let cp = clause(p)
  if tautclause(cp) then x else insert(cp, x)

fun unicl(a) = foldr(uniclHelper, Nil, a)

fun disp(l_r) = if l_r is Tup2(l, r) then
  append(
    interleave(l, spaces(listLen(l))),
    append(
      nofibStringToList("<="),
      append(
        interleave(spaces(listLen(r)), r),
        nofibStringToList("\n"))))

fun clauses(t) = concat(map(disp, unicl(split(disin(negin(elim(parse(t))))))))

// NOTE: original input "(a = a = a) = (a = a = a) = (a = a = a)"
fun testClausify_nofib(n) =
  let xs = replicate(n, nofibStringToList("a = a = a"))
  concat(map(clauses, xs))

nofibListToString(testClausify_nofib(10))
//│ = 'a <=\na <=\na <=\na <=\na <=\na <=\na <=\na <=\na <=\na <=\n'
