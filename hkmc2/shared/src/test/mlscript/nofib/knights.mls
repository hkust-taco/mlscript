fun root(sze) =
  fun lscomp1(ls) = if ls is
    Nil then Nil
    Cons(h1, t1) then
      fun lscomp2(ls) = if ls is
        Nil then lscomp1(t1)
        Cons(h2, t2) then Cons(Tup2(h1, h2), lscomp2(t2))
      lscomp2(enumFromTo(1, sze))
  addAllFront(
    zip_lz_nl(
      repeat(1 - (sze * sze)),
      zipWith(startTour, lscomp1(enumFromTo(1, sze)), replicate(sze * sze, sze))
    ),
    createQueue
  )

fun grow(x_y) = if x_y is Tup2(x, y) then zip_lz_nl(repeat(x + 1), descendents(y))

fun isFinished(x_y) = if x_y is Tup2(x, y) then tourFinished(y)

fun depthSearch(q, growFn, finFn) = if
  emptyQueue(q) then lazy of () => LzNil
  finFn(inquireFront(q)) then lazy of () => LzCons(inquireFront(q), depthSearch(removeFront(q), growFn, finFn))
  else depthSearch(addAllFront(growFn(inquireFront(q)), removeFront(q)), growFn, finFn)

fun printTour(ss) =
  fun strToInt(y, xs) = if xs is
    Nil then y
    Cons(x, xs) then strToInt((10 * y) + (x.codePointAt(0) - 48), xs)
  // fun pp(xs) = if xs is
  //   Nil then Nil
  //   Cons(Tup2(x, y), xs) then append(
  //     nofibStringToList("|Knights tour with "),
  //     append(
  //       nofibStringToList(stringOfInt(x)),
  //       append(nofibStringToList(" backtracking moves|"), append(showChessSet(y), pp(xs)))
  //     )
  //   )
  if map(x => strToInt(0, x), ss) is
    Cons(size, Cons(number, Nil)) then (take_lz(number, depthSearch(root(size), grow, isFinished)))
    else throw Error("printTour error")

fun testKnights_nofib(ss) =
  let usageString = "|Usage: knights <board size> <no solutions>|"
  fun all_digits(s) = foldr((a, b) => (myIsDigit(a)) && b, true, s)
  fun argsOk(ss) = (listLen(ss) === 2) && (foldr((a, b) => (all_digits(a)) && b, true, ss))
  if argsOk(ss) then (printTour(ss)) else throw Error(usageString)


