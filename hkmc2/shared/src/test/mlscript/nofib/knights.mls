:js
:import NofibPrelude.mls
//│ Imported 119 member(s)

fun myIsDigit(c) =
  c.codePointAt(0) >= 48 && c.codePointAt(0) <= 57

fun intintComp(a_b, c_d) = if a_b is Tup2(a, b) and c_d is Tup2(c, d) then (a < c) || ((a === c) && (b < d))

fun intChessSetComp(a_b, c_d) = if a_b is Tup2(a, b) and c_d is Tup2(c, d) then a < c

fun myInit(a_t) = if a_t is
  Cons(a, Nil) then Nil
  Cons(a, t) then Cons(a, myInit(t))

fun myLast(a_t) =
  fun go(h, t) = if t is
    Nil then h
    Cons(head, t) then go(head, t)
  if a_t is Cons(a, t) then go(a, t)

fun quickSortIntInt(xs) = if xs is
  Nil then Nil
  Cons(x, xs) then
    fun lscomp1(ls) = if ls is
      Nil then Nil
      Cons(h, t) and
        intintComp(h, x) then Cons(h, lscomp1(t))
        else lscomp1(t)
    fun lscomp2(ls) = if ls is
      Nil then Nil
      Cons(h, t) and
        not(intintComp(h, x)) then Cons(h, lscomp2(t))
        else lscomp2(t)
    append(lscomp1(xs), Cons(x, lscomp2(xs)))

fun quickSortIntChessSet(xs) = if xs is
  Nil then Nil
  Cons(x, xs) then
    fun lscomp1(ls) = if ls is
      Nil then Nil
      Cons(h, t) and
        intChessSetComp(h, x) then Cons(h, lscomp1(t))
        else lscomp1(t)
    fun lscomp2(ls) = if ls is
      Nil then Nil
      Cons(h, t) and
        not(intChessSetComp(h, x)) then Cons(h, lscomp2(t))
        else lscomp2(t)
    append(lscomp1(xs), Cons(x, lscomp2(xs)))

fun sizeQueue(xs) = listLen(xs)

fun emptyQueue(x) = listEq(x, Nil)

fun removeBack(xs) = if xs is
  Cons(x, Nil) then Nil
  Cons(x, xs) then Cons(x, removeBack(xs))

fun removeFront(xs) = if xs is
  Cons(h, t) then t

fun inquireBack(xs) = if xs is
  Cons(x, Nil) then x
  Cons(x, xs) then inquireBack(xs)

fun inquireFront(h_t) = if h_t is Cons(h, t) then h

fun addAllBack(list, q) = append(q, list)

fun addAllFront(list, q) = append(list, q)

fun addBack(x, q) = append(q, Cons(x, Nil))

fun addFront(x, q) = Cons(x, q)

let createQueue = Nil
//│ createQueue = Nil { class: [class Nil] }

class Board(a: Int, b: Int, c: Lazy[Tup2[Int, Int]], d: List[Tup2[Int, Int]])

fun createBoard(x, t) = Board(x, 1, (lazy of (() => t)), Cons(t, Nil))

fun sizeBoard(b) = if b is Board(a, _, _, _) then a

fun noPieces(b) = if b is Board(_, n, _, _) then n

fun addPiece(t, b) = if b is Board(s, n, f, ts) then Board(s, n + 1, f, Cons(t, ts))

fun deleteFirst(b) = if b is Board(s, n, f, ts) then
  let ts_ = myInit(ts)
  Board(s, n - 1, (lazy of () => myLast(ts_)), ts_)

fun positionPiece(x, b) = if b is Board(_, n, _, ts) then atIndex(n - x, ts)

fun lastPiece(b) = if b is Board(_, _, _, Cons(t, ts)) then t

fun firstPiece(b) = if b is Board(_, _, f, _) then force(f)

fun pieceAtTile(x, b) = if b is Board(_, _, _, ts) then
  fun find(x, xs) = if xs is
    Nil then throw Error("Tile not used")
    Cons(y, xs) then if eqTup2(x, y) then 1 + listLen(xs) else find(x, xs)
  find(x, ts)

fun tup2InList(y, xs) = if xs is
  Nil then false
  Cons(x, xs) and
    eqTup2(y, x) then true
    else tup2InList(y, xs)

fun isSquareFree(x, b) = if b is Board(_, _, _, ts) then not(tup2InList(x, ts))

fun assignMoveNo(t, size, z) = if t is
  Nil then Nil
  Cons(Tup2(x, y), t) then Cons(Tup2((y - 1) * size + x, z), assignMoveNo(t, size, z - 1))

fun spaces(s, y) =
  fun logTen(x) = if x === 0 then 0 else 1 + logTen(intDiv(x, 10))
  replicate((logTen(s) - logTen(y)) + 1, " ")

fun printBoard(s, n, xs) = if xs is
  Nil and
    n > s * s then Nil
    intMod(n, s) != 0 then append(nofibStringToList("*"), append(spaces(s * s, 1), printBoard(s, n + 1, Nil)))
    intMod(n, s) === 0 then append(nofibStringToList("*|"), printBoard(s, n + 1, Nil))
    else throw Error("printBoard empty list error")
  Cons(Tup2(i, j), xs) and
    i === n and intMod(n, s) === 0 then append(append(nofibStringToList(stringOfInt(j)), nofibStringToList("|")), printBoard(s, n + 1, xs))
    i === n and intMod(n, s) != 0 then append(append(nofibStringToList(stringOfInt(j)), spaces(s * s, j)), printBoard(s, n + 1, xs))
    intMod(n, s) != 0 then append(nofibStringToList("*"), append(spaces(s * s, 1), printBoard(s, n + 1, Tup2(i, j) :: xs)))
    intMod(n, s) === 0 then append(nofibStringToList("*|"), printBoard(s, n + 1, Tup2(i, j) :: xs))
    else throw Error("printBoard non-empty list error")

abstract class Direction: UL | UR | DL |DR | LU | LD | RU | RD

object
  UL extends Direction
  UR extends Direction
  DL extends Direction
  DR extends Direction
  LU extends Direction
  LD extends Direction
  RU extends Direction
  RD extends Direction

fun move(d, x_y) = if x_y is Tup2(x, y) and d is
  UL then Tup2(x - 1, y - 2)
  UR then Tup2(x + 1, y - 2)
  DL then Tup2(x - 1, y + 2)
  DR then Tup2(x + 1, y + 2)
  LU then Tup2(x - 2, y - 1)
  LD then Tup2(x - 2, y + 1)
  RU then Tup2(x + 2, y - 1)
  RD then Tup2(x + 2, y + 1)

fun startTour(st, size) =
  if intMod(size, 2) === 0 then createBoard(size, st)
  else throw Error("Tour doesnt exist for odd size board")

fun moveKnight(board, dir) = addPiece(move(dir, lastPiece(board)), board)

fun canMoveTo(x_y, board) = if x_y is Tup2(x, y) then
  let sze = sizeBoard(board)
  let res = (x >= 1) and (x <= sze) and (y >= 1) and (y <= sze) and (isSquareFree(x_y, board))
  // process.stdout.write(if res then "1" else "0")
  res

fun canMove(board, dir) = canMoveTo(move(dir, lastPiece(board)), board)

fun canJumpFirst(board) = canMoveTo(firstPiece(board), deleteFirst(board))

fun tourFinished(board) =
  let sze = sizeBoard(board)
  (noPieces(board) === (sze * sze)) && canJumpFirst(board)

fun possibleMoves(board) =
  fun lscomp(ls) = if ls is
    Nil then Nil
    Cons(x, t) and
      canMove(board, x) then Cons(x, lscomp(t))
      else lscomp(t)
  let res = lscomp(UL :: UR :: DL :: DR :: LU :: LD :: RU :: RD :: Nil)
  // process.stdout.write(listLen(res).toString())
  res

fun deadEnd(board) = listLen(possibleMoves(board)) === 0

fun allDescend(board) = map(b => moveKnight(board, b), possibleMoves(board))

fun descAndNo(board) =
  fun lscomp(ls) = if ls is
    Nil then Nil
    Cons(x, t) then Cons(Tup2(listLen(possibleMoves(deleteFirst(x))), x), lscomp(t))
  lscomp(allDescend(board))

fun singleDescend(board) =
  fun lscomp(ls) = if ls is
    Nil then Nil
    Cons(Tup2(y, x), t) then
      // print(y)
      if
        y === 1 then Cons(x, lscomp(t))
        else lscomp(t)
  lscomp(descAndNo(board))

fun descendents(board) =
  if canJumpFirst(board) && deadEnd(addPiece(firstPiece(board), board)) then Nil
  else
    let singles = singleDescend(board)
    // print(singles)
    let scrut = listLen(singles)
    // print(scrut)
    let res = if scrut
      === 0 then map(snd, quickSortIntChessSet(descAndNo(board)))
      === 1 then singles
      else Nil
    // print(res)
    res


