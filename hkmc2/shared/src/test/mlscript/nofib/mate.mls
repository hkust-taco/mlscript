fun showReplies(rs, n) = if rs is
  Nil then Nil
  Cons(Tup2(mifs, s), rs) then
    append(
      tab(n),
      append(
        nofibStringToList("if "),
        append(
          if null_(rs) && (listLen(mifs) > 1) then nofibStringToList("others") else showMoves(mifs),
          append(
            nofibStringToList("; "),
            append(
              showSoln(s, n + 1),
              showReplies(rs, n)
            )
          )
        )
      )
    )

fun showSoln(s, n) = if s is Soln(mif, rs) then
  append(
    nofibStringToList(stringOfInt(n)),
    append(
      nofibStringToList(". "),
      append(
        showMoveInFull(mif),
        if rs is
          Nil then nofibStringToList("++\n")
          Cons(Tup2(mifs, s_), Nil) then
            append(
              nofibStringToList(", "),
              append(
                if listLen(mifs) > 1 then nofibStringToList("...") else showMoves(mifs),
                append(
                  nofibStringToList("; "),
                  showSoln(s_, n + 1)
                )
              )
            )
          else append(
            nofibStringToList(",\n"),
            showReplies(sort(rs), n)
          )
      )
    )
  )
