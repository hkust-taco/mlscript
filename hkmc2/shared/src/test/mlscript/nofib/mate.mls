//│ ————————————————————————————————————————————————————————————————————————————————
fun rqpart(le, x, ys, rle, rgt, r) = if ys is
  Nil then qsort(le, rle, x :: qsort(le, rgt, r))
  Cons(y, ys) and
    le(y, x) then rqpart(le, x, ys, y :: rle, rgt, r)
    else rqpart(le, x, ys, rle, y :: rgt, r)

fun rqsort(le, xs, r) = if xs is
  Nil then r
  Cons(x, Nil) then x :: r
  Cons(x, xs) then rqpart(le, x, xs, Nil, Nil, r)

fun qpart(le, x, ys, rlt, rge, r) = if ys is
  Nil then rqsort(le, rlt, x :: rqsort(le, rge, r))
  Cons(y, ys) and
    le(x, y) then qpart(le, x, ys, rlt, y :: rge, r)
    else qpart(le, x, ys, y :: rlt, rge, r)

fun qsort(le, xs, r) = if xs is
  Nil then r
  Cons(x, Nil) then x :: r
  Cons(x, xs) then qpart(le, x, xs, Nil, Nil, r)
//│ ————————————————————————————————————————————————————————————————————————————————

fun sort(l) = qsort(
  (a, b) => if a is Tup2(aa, _) and b is Tup2(bb, _) then listLen(aa) <= listLen(bb),
  l,
  Nil
)

abstract class Kind: King | Queen | Rook | Bishop | Knight | Pawn

object
  King extends Kind
  Queen extends Kind
  Rook extends Kind
  Bishop extends Kind
  Knight extends Kind
  Pawn extends Kind

abstract class Colour: Black | White

object
  Black extends Colour
  White extends Colour

type Piece = Tup2[Colour,Kind]

type Square = Tup2[Int,Int]

class Board(a: List[Tup2[Kind, Square]], b: List[Tup2[Kind, Square]])

class Move(a: Square, b: Option[Piece], c: Option[Piece])

class MoveInFull(a: Piece, b: Square, c: Move)

class Solution(a: MoveInFull, b: List[Tup2[List[MoveInFull],Solution]])

fun maybe(d, f, x) = if x is
  None then d
  Some(x) then f(x)

fun isUpper(c) = let x = c.charCodeAt(0) in (x >= 65 and x <= 90)

fun isLower(c) = let x = c.charCodeAt(0) in (x >= 97 and x <= 122)

fun toLower(c) = if isUpper(c) then String.fromCharCode(c.charCodeAt(0) + 32) else c

fun words(s) = if dropWhile(x => x === " ", s) is
  Nil then Nil
  s_ and
    break_(x => x === " ", s_) is Tup2(w, s__) then w :: words(s__)

fun unlines(ls) = concat(map(l => append(l, "\n" :: Nil), ls))

fun lines(s) = if break_(x => x === "|", s) is Tup2(l, s_) then
  Cons(
    l,
    (if s_ is
      Nil then Nil
      Cons(_, s__) then lines(s__)
    )
  )
  
fun any(p, ls) = if ls is
  Nil then false
  Cons(x, xs) then p(x) || any(p, xs)

fun showColour(c) = nofibStringToList(if c is Black then "Black" else "White")

fun pieceAt(bd, sq) = if bd is Board(wkss, bkss) then
  fun pieceAtWith(c, n, ls) = if ls is
    Nil then n
    Cons(Tup2(k, s), xs) and
      eqTup2(s, sq) then Some(Tup2(c, k))
      else pieceAtWith(c, n, xs)
  pieceAtWith(White, pieceAtWith(Black, None, bkss), wkss)

fun kindToChar(k) = if k is
  King then "K"
  Queen then "Q"
  Rook then "R"
  Bishop then "B"
  Knight then "N"
  Pawn then "P"

fun pieceToChar(p) = if p is
  Tup2(Black, k) then kindToChar(k)
  Tup2(White, k) then toLower(kindToChar(k))

fun showBoard(bd) =
  fun showRank(r) =
    fun consFile(f, s) = if pieceAt(bd, Tup2(f, r)) is
      None then append(nofibStringToList(" -"), s)
      Some(p) then " " :: pieceToChar(p) :: s
    foldr(consFile, Nil, enumFromTo(1, 8))
  unlines(map(showRank, reverse(enumFromTo(1, 8))))

fun showPiece(p) = if p is Tup2(c, k) then kindToChar(k) :: Nil

fun showSquare(c, x_y) = if x_y is Tup2(x, y) then
  append(
    atIndex(
      x - 1,
      nofibStringToList("QR") ::
      nofibStringToList("QN") ::
      nofibStringToList("QB") ::
      nofibStringToList("Q") ::
      nofibStringToList("K") ::
      nofibStringToList("KB") ::
      nofibStringToList("KN") ::
      nofibStringToList("KR") :: Nil
    ),
    nofibStringToList(stringOfInt(if c is Black then 9 - y else y))
  )

fun emptyAtAll(bd, e) = if bd is Board(wkss, bkss) then
  fun emptyAtAllAnd(b, ls) = if ls is
    Nil then b
    Cons(Tup2(_, s), xs) then (not(e(s)) and emptyAtAllAnd(b, xs))
  emptyAtAllAnd(emptyAtAllAnd(true, bkss), wkss)

fun rPa(sq, kss) = if kss is
  Nil then throw Error("rPa")
  Cons(Tup2(k, s), kss) then if eqTup2(s, sq) then kss else Cons(Tup2(k, s), rPa(sq, kss))

fun rmPieceAt(c, sq, bd) = if bd is Board(wkss, bkss) and c is
  White then Board(rPa(sq, wkss), bkss)
  Black then Board(wkss, rPa(sq, bkss))

fun putPieceAt(sq, c_k, bd) =
  if c_k is Tup2(c, k) and bd is Board(wkss, bkss) and c is
    White then Board(Cons(Tup2(k, sq), wkss), bkss)
    Black then Board(wkss, Cons(Tup2(k, sq), bkss))

fun kSq(kss) = if kss is
  Cons(Tup2(King, s), _) then s
  Cons(_, kss) then kSq(kss)
  Nil then throw Error("kSq")

fun kingSquare(c, bd) = if bd is Board(wkss, bkss) and c is
  White then kSq(wkss)
  Black then kSq(bkss)

fun opponent(c) = if c is White then Black else White

fun colourOf(c_k) = if c_k is Tup2(c, _) then c

fun kindOf(c_k) = if c_k is Tup2(_, k) then k

fun onboard(p_q) = if p_q is Tup2(p, q) then
  (p >= 1 and p <= 8) and (q >= 1 and q <= 8)

fun forcesColoured(c, bd) = if bd is Board(wkss, bkss) and c is
  White then wkss
  Black then bkss

let emptyBoard = Board(Nil, Nil)
//│ emptyBoard = Board { a: Nil { class: [class Nil] }, b: Nil { class: [class Nil] } }

fun showMove(withPiece, m) = if m is MoveInFull(Tup2(c, k), sq, Move(sq_, mcp, mpp)) then
  let capt = mcp is Some(_)
  let prom = mpp is Some(_)
  append(
    (if withPiece
      then append(
        showPiece(Tup2(c, k)),
        if ((k === King) || (k is Pawn and not(capt || prom))) then Nil else "/" :: showSquare(c, sq)
      )
      else Nil
    ),
    append(
      maybe("-" :: Nil, cp => "x" :: append(showPiece(cp), "/" :: Nil), mcp),
      append(
        showSquare(c, sq_),
        maybe(Nil, pp => "(" :: append(showPiece(pp), ")" :: Nil), mpp)
      )
    ) 
  )

fun showMoveInFull(a) = showMove(true, a)

fun showMovesAfter(p_, mifs) = if mifs is
  Nil then Nil
  Cons(MoveInFull(p, sq, d_), mifs) and p_ is MoveInFull(p_, sq_, _) then
    append(
      nofibStringToList(", "),
      append(
        showMove(not(eqTup2(p, p_)) || not(eqTup2(sq, sq_)), MoveInFull(p, sq, d_)),
        showMovesAfter(MoveInFull(p, sq, d_), mifs)
      )
    )

fun showMoves(mifs) = if mifs is
  Nil then throw Error("showMoves")
  Cons(mif, mifs) then append(
    showMoveInFull(mif),
    showMovesAfter(mif, mifs)
  )

fun sift(c, bd, ms, sqs) = if sqs is
  Nil then ms
  Cons(sq, sqs) and
    onboard(sq) and pieceAt(bd, sq) is
      None then sift(c, bd, Cons(Move(sq, None, None), ms), sqs)
      Some(p_) and
        colourOf(p_) === c then sift(c, bd, ms, sqs)
        else sift(c, bd, Cons(Move(sq, Some(p_), None), ms), sqs)
    else sift(c, bd, ms, sqs)

fun moveLine(bd, c, sq, inc, cont) = 
  fun ml(sq, ms) = 
    let sq_ = inc(sq)
    if onboard(sq_) and pieceAt(bd, sq_) is
      None then ml(sq_, Cons(Move(sq_, None, None), ms))
      Some(p_) and
        not(colourOf(p_) === c) then cont(Cons(Move(sq_, Some(p_), None), ms))
        else cont(ms)
    else cont(ms)
  ms => ml(sq, ms)

// bishopmoves :: Colour -> Square -> Board -> [Move]
// bishopmoves c sq bd =
//   ( moveLine bd c sq (\xy -> case xy of {(x,y) -> (x-1,y+1)}) $ (moveLine bd c sq (\xy -> case xy of {(x,y) -> (x+1,y+1)}) $ (moveLine bd c sq (\xy -> case xy of {(x,y) -> (x-1,y-1)}) $ (moveLine bd c sq (\xy -> case xy of {(x,y) -> (x+1,y-1)}) (\x -> x))))) []
fun bishopmoves(c, sq, bd) =
  moveLine(
    bd,
    c,
    sq,
    xy => if xy is Tup2(x, y) then Tup2(x - 1, y + 1),
    moveLine(
      bd,
      c,
      sq,
      xy => if xy is Tup2(x, y) then Tup2(x + 1, y + 1),
      moveLine(
        bd,
        c,
        sq,
        xy => if xy is Tup2(x, y) then Tup2(x - 1, y - 1),
        moveLine(
          bd,
          c,
          sq,
          xy => if xy is Tup2(x, y) then Tup2(x + 1, y - 1),
          x => x
        )
      )
    )
  )(Nil)

// rookmoves :: Colour -> Square -> Board -> [Move]
// rookmoves c sq bd =
//   ( moveLine bd c sq (\xy -> case xy of {(x,y) -> (x-1,y)}) $ (moveLine bd c sq (\xy -> case xy of {(x,y) -> (x+1,y)}) $ (moveLine bd c sq (\xy -> case xy of {(x,y) -> (x,y-1)}) $ (moveLine bd c sq (\xy -> case xy of {(x,y) -> (x,y+1)}) (\x -> x))))) []
fun rookmoves(c, sq, bd) =
  moveLine(
    bd,
    c,
    sq,
    xy => if xy is Tup2(x, y) then Tup2(x - 1, y),
    moveLine(
      bd,
      c,
      sq,
      xy => if xy is Tup2(x, y) then Tup2(x + 1, y),
      moveLine(
        bd,
        c,
        sq,
        xy => if xy is Tup2(x, y) then Tup2(x, y - 1),
        moveLine(
          bd,
          c,
          sq,
          xy => if xy is Tup2(x, y) then Tup2(x, y + 1),
          x => x
        )
      )
    )
  )(Nil)

fun kingmoves(c, pq, bd) = if pq is Tup2(p, q) then
  sift(
    c,
    bd,
    Nil,
    Tup2(p - 1, q + 1) ::
    Tup2(p, q + 1) ::
    Tup2(p + 1, q + 1) ::
    Tup2(p - 1, q) ::
    Tup2(p + 1, q) ::
    Tup2(p - 1, q - 1) ::
    Tup2(p, q - 1) ::
    Tup2(p + 1, q - 1) :: Nil
  )

fun knightmoves(c, pq, bd) = if pq is Tup2(p, q) then
  sift(
    c,
    bd,
    Nil,
    Tup2(p - 1, q + 2) ::
    Tup2(p + 1, q + 2) ::
    Tup2(p - 2, q + 1) ::
    Tup2(p + 2, q + 1) ::
    Tup2(p - 2, q - 1) ::
    Tup2(p + 2, q - 1) ::
    Tup2(p - 1, q - 2) ::
    Tup2(p + 1, q - 2) :: Nil
  )

fun pawnmoves(c, pq, bd) = if pq is Tup2(p, q) then
  let fwd = if c is White then 1 else -1
  fun promote(xy, mcp) = if xy is Tup2(x, y) and
    ((c is Black) and y === 1) || ((c is White) and y === 8) then
      map(
        param => Move(Tup2(x, y), mcp, Some(param)),
        Tup2(c, Queen) ::
        Tup2(c, Rook) ::
        Tup2(c, Bishop) ::
        Tup2(c, Knight) :: Nil
      )
    else Move(Tup2(x, y), mcp, None) :: Nil
  let movs =
    let on1 = Tup2(p, q + fwd)
    let on2 = Tup2(p, q + 2 * fwd)
    if pieceAt(bd, on1) is None then
      append(
        promote(on1, None),
        if (q === 2 and c is White) || (q === 7 and c is Black) and pieceAt(bd, on2) is None then
          Move(on2, None, None) :: Nil
        else Nil
      )
    else Nil
  fun lscomp1(ls) = if ls is
    Nil then Nil
    Cons(sq, sqs) then
      fun lscomp2(ls) = if ls is
        Nil then lscomp1(sqs)
        Cons(h, ls) and
          h is Some(p_) and not(colourOf(p_) === c) then Cons(promote(sq, Some(p_)), lscomp2(ls))
          else lscomp2(ls)
      lscomp2(pieceAt(bd, sq) :: Nil)
  let caps = concat(lscomp1(Tup2(p + 1, q + fwd) :: Tup2(p - 1, q + fwd) :: Nil))
  append(movs, caps)

fun queenmoves(c, sq, bd) = append(bishopmoves(c, sq, bd), rookmoves(c, sq, bd))

fun kingincheck(c, bd) =
  fun givesCheck(kxy) = if kxy is Tup2(k, Tup2(x, y)) then
    fun kthreat(param) = if kingSquare(c, bd) is Tup2(xk, yk) and param is
      King then (abs(x - xk) <= 1) and (abs(y - yk) <= 1)
      Queen then kthreat(Rook) || kthreat(Bishop)
      Rook then
        ((x === xk) && emptyAtAll(bd, xeye => if xeye is Tup2(xe, ye) then (xe === xk) && ((min(y, yk) < ye) && (ye < max(y, yk))))) ||
        ((y === yk) && emptyAtAll(bd, xeye => if xeye is Tup2(xe, ye) then (ye === yk) && ((min(x, xk) < xe) && (xe < max(x, xk)))))
      Bishop then
        (((x + y) === (xk + yk)) && emptyAtAll(bd, xeye => if xeye is Tup2(xe, ye) then ((xe + ye) === (xk + yk)) && ((min(x, xk) < xe) && (xe < max(x, xk))))) ||
        (((x - y) === (xk - yk)) && emptyAtAll(bd, xeye => if xeye is Tup2(xe, ye) then ((xe - ye) === (xk - yk)) && ((min(x, xk) < xe) && (xe < max(x, xk)))))
      Knight then
        (((abs(x - xk)) === 2) && ((abs(y - yk)) === 1)) || (((abs(x - xk)) === 1) && ((abs(y - yk)) === 2))
      Pawn then
        ((abs(x - xk) === 1) && (if c is Black then yk === (y + 1) else yk === (y - 1)))
    kthreat(k)
  any(givesCheck, forcesColoured(opponent(c), bd))

fun tryMove(c, ksq, m, bd) = if 
  ksq is Tup2(k, sq) and m is Move(sq_, mcp, mpp) then
    let p = Tup2(c, k)
    let bd1 = rmPieceAt(c, sq, bd)
    let p_ = maybe(p, x => x, mpp)
    let bd2 = maybe(
      putPieceAt(sq_, p_, bd1),
      dummy => putPieceAt(sq_, p_, rmPieceAt(opponent(c), sq_, bd1)),
      mcp
    )
    if not(kingincheck(c, bd2)) then Some(Tup2(MoveInFull(p, sq, Move(sq_, mcp, mpp)), bd2)) else None
  else
    throw Error(m)

fun rawmoves(c, ksq, bd) = if ksq is Tup2(k, sq) then
  let m = if k is
    King then kingmoves
    Queen then queenmoves
    Rook then rookmoves
    Bishop then bishopmoves
    Knight then knightmoves
    Pawn then pawnmoves
  let res = m(c, sq, bd)
  res

fun moveDetailsFor(c, bd) = foldr(
  (ksq, ms) => foldr(
    (rm, ms_) => maybe(x => x, h => (t => h :: t), tryMove(c, ksq, rm, bd))(ms_),
    ms,
    rawmoves(c, ksq, bd)
  ),
  Nil,
  forcesColoured(c, bd)
)

fun comment(s) = (s is Nil) || listEq(take(2, s), nofibStringToList("--"))

fun last(ls) = if ls is
  Cons(x, Nil) then x
  Cons(h, t) then last(t)

fun intOfString(s) = globalThis.parseInt(nofibListToString(s))

fun parseGoal(ls) = if ls is
  Cons(gltxt, Nil) then
    let ws = words(gltxt)
    let c = if listEq(head(ws), nofibStringToList("Black")) then Black else White
    let n = intOfString(last(ws))
    Tup2(c, n)
  else throw Error("parseGoal")

fun parseSquare(r, f, c) = if c === "-" then Nil else
  let clr = if isUpper(c) then Black else White
  let kin = if toLower(c) ===
    "k" then King
    "q" then Queen
    "r" then Rook
    "b" then Bishop
    "n" then Knight
    "p" then Pawn
  Tup2(Tup2(clr, kin), Tup2(f, r)) :: Nil

fun parseRank(r, x) = concat(zipWith(
  (a, b) => parseSquare(r, a, b),
  enumFromTo(1, 8),
  filter(pp => not(pp === " "), x)
))


fun parseBoard(ls) =
  fun addPiece(p_sq, x) = if p_sq is Tup2(p, sq) then putPieceAt(sq, p, x)
  foldr(
    addPiece,
    emptyBoard,
    concat(zipWith(parseRank, reverse(enumFromTo(1, 8)), ls))
  )

fun parseProblem(s) =
  let bdtxt_gltxt = splitAt(8, filter(x => not(comment(x)), s))
  if bdtxt_gltxt is Tup2(bdtxt, gltxt) then
    let bd = parseBoard(bdtxt)
    let gl = parseGoal(gltxt)
    Tup2(bd, gl)

fun readProblem(s) = parseProblem(lines(s))

