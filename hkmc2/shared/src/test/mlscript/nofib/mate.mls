fun compact(s) = if s is Solution(mif, rs) then Soln(mif, foldr(insertCompact, Nil, rs))

fun insertCompact(mif_s, ls) = if mif_s is Tup2(mif, s) then
  fun insert(x, ls) = if ls is
    Nil then x :: Nil
    Cons(y, ys) then if polyGt(x, y) then y :: insert(x, ys) else x :: y :: ys
  let cs = compact(s)
  fun ic(ls) = if ls is
    Nil then Cons(Tup2(mif :: Nil, cs), Nil)
    Cons(Tup2(mifs, cs_), etc) then
      let a = showSoln(cs, 1)
      let b = showSoln(cs_, 1)
      if
        ltList(a, b, (x, y) => x < y, (x, y) => x > y) then Cons(Tup2(mif :: Nil, cs), Cons(Tup2(mifs, cs_), etc))
        listEq(a, b) then Cons(Tup2(insert(mif, mifs), cs), etc)
        not(ltList(a, b, (x, y) => x < y, (x, y) => x > y)) then Cons(Tup2(mifs, cs_), ic(etc))
        else throw Error("compare error")
  ic(ls)
//│ ————————————————————————————————————————————————————————————————————————————————

fun showResult(s) = if s is
  None then nofibStringToList("No solution!")
  Some(s) then showSoln(compact(s), 1)

fun solve(bd, c, n) = showResult(solution(bd, c, (2 * n) - 1))

fun testMate_nofib(dummy) = 
  let input = nofibStringToList("-- G. Heathcote|-- Reading Observer, 1904|-- `A charming little three-mover constructed with|-- the art that conceals art.'  (Phillips)||- - - - - - - - |- - - - - - - - |- - - - - - - - |- - - - P - - - |- - - - p - k b |- P n - K - - - |- P - - - - - - |- q - - - - - - ||White to play and mate in 3")
  let bdcn = readProblem(input)
  if bdcn is Tup2(bd, Tup2(c, n)) then
    append(
      showBoard(bd), 
      append(
        nofibStringToList("\n"),
        append(
          showColour(c),
          append(
            nofibStringToList(" to move and mate in "),
            append(
              nofibStringToList(stringOfInt(n)),
              append(
                nofibStringToList("\n"),
                append(
                  nofibStringToList("\n"),
                  solve(bd, c, n)
                )
              )
            )
          )
        )
      )
    )

print(nofibListToString(testMate_nofib(0)))
