// NOTE: original input -2100000000 14000001 2100000000
:js
:import NofibPrelude.mls
//│ Imported 111 member(s)
fun runalltests(astart, astep, alim, bstart, bstep, blim) =
  fun z_add(a, b) = a + b
  fun z_sub(a, b) = a - b
  fun z_mul(a, b) = a * b
  fun z_div(a, b) = intDiv(a, b)
  fun z_mod(a, b) = intMod(a, b)
  fun z_equal(a, b) = a == b
  fun z_lt(a, b) = a < b
  fun z_leq(a, b) = a <= b
  fun z_gt(a, b) = a > b
  fun z_geq(a, b) = a >= b
  nofibPrint(runbench((a, b) => z_add(a, b), (a, b) => a + b, "(+)", astart, astep, alim, astart, astep, alim).toString());
  nofibPrint(runbench((a, b) => z_sub(a, b), (a, b) => a - b, "(-)", astart, astep, alim, astart, astep, alim).toString());
  nofibPrint(runbench((a, b) => z_mul(a, b), (a, b) => a * b, "(*)", astart, astep, alim, astart, astep, alim).toString());
  nofibPrint(runbench((a, b) => z_div(a, b), (a, b) => intDiv(a, b), "div", astart, astep, alim, astart, astep, alim).toString());
  nofibPrint(runbench((a, b) => z_mod(a, b), (a, b) => intMod(a, b), "mod", astart, astep, alim, astart, astep, alim).toString());
  nofibPrint(runbench((a, b) => z_equal(a, b), (a, b) => a == b, "(==)", astart, astep, alim, astart, astep, alim).toString());
  nofibPrint(runbench((a, b) => z_lt(a, b), (a, b) => a < b, "(<)", astart, astep, alim, astart, astep, alim).toString());
  nofibPrint(runbench((a, b) => z_leq(a, b), (a, b) => a <= b, "(<=)", astart, astep, alim, astart, astep, alim).toString());
  nofibPrint(runbench((a, b) => z_gt(a, b), (a, b) => a > b, "(>)", astart, astep, alim, astart, astep, alim).toString());
  nofibPrint(runbench((a, b) => z_geq(a, b), (a, b) => a >= b, "(>=)", astart, astep, alim, astart, astep, alim).toString())
fun runbench(jop, iop, opstr, astart, astep, alim, bstart, bstep, blim) =
  intbench(iop, astart, astep, alim, astart, astep, alim);
  integerbench(jop, astart, astep, alim, astart, astep, alim)
fun integerbench(op, astart, astep, alim, bstart, bstep, blim) =
  fun lscomp1(ls) = if ls is
    Nil then Nil
    Cons(a, t1) then
      fun lscomp2(ls) = if ls is
        Nil then lscomp1(t1)
        Cons(b, t2) then Cons(op(a, b), lscomp2(t2))
      lscomp2(enumFromThenTo(bstart, bstart + bstep, blim))
  lscomp1(enumFromThenTo(astart, astart + astep, alim))
fun intbench(op, astart, astep, alim, bstart, bstep, blim) =
  fun lscomp1(ls) = if ls is
    Nil then Nil
    Cons(a, t1) then
      fun lscomp2(ls) = if ls is
        Nil then lscomp1(t1)
        Cons(b, t2) then Cons(op(a, b), lscomp2(t2))
      lscomp2(enumFromThenTo(bstart, bstart + bstep, blim))
  lscomp1(enumFromThenTo(astart, astart + astep, alim))
fun testInteger_nofib(n) = runalltests(-2100000000, n, 2100000000, -2100000000, n, -2100000000)
testInteger_nofib(70000001)
