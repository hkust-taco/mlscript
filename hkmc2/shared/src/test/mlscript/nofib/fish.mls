:js
:import NofibPrelude.mls
//│ Imported 117 member(s)

fun vec_add(v1, v2) = if v1 is Tup2(x1, y1) and v2 is Tup2(x2, y2) then Tup2(x1 + x2, y1 + y2)

fun vec_sub(v1, v2) = if v1 is Tup2(x1, y1) and v2 is Tup2(x2, y2) then Tup2(x1 - x2, y1 - y2)

fun scale_vec2(v, a, b) = if v is Tup2(x, y) then Tup2(intDiv(x * a, b), intDiv(y * a, b))

