let initial =
  fun lscomp(ls) = if ls is
    Nil then Nil
    Cons(Tup2(k, rs), t) then Cons(Tup2(words(k), cycle(rs)), lscomp(t))
  Tup2(lscomp(respMsgs), cycle(repeatMsgs))
//│ > Tup2 {
//│ >   fst: Cons {
//│ >     head: Tup2 { fst: [Cons], snd: [Lazy] },
//│ >     tail: Cons { head: [Tup2], tail: [Cons] }
//│ >   },
//│ >   snd: Lazy {
//│ >     init: [Function (anonymous)],
//│ >     cached: None { class: [class None] }
//│ >   }
//│ initial = }

fun prefix(xxs, yys) = if xxs is
  Nil then true
  Cons(x, xs) and
    force(yys) is
      LzNil then false
      LzCons(y, ys) then listEq(x, y) && prefix(xs, ys)

fun tails(xs) = lazy of () =>
  if xs is
    Nil then LzNil
    xss then LzCons(xss, tails(tail(xss)))

fun ucase(ls) = map(toUpper, ls)

let conjugates =
  let oneways = Tup2(nofibStringToList("me"), nofibStringToList("you")) :: Nil
  let bothways = Tup2(nofibStringToList("are"), nofibStringToList("am")) ::
    Tup2(nofibStringToList("we're"), nofibStringToList("was")) ::
    Tup2(nofibStringToList("you"), nofibStringToList("I")) ::
    Tup2(nofibStringToList("your"), nofibStringToList("my")) ::
    Tup2(nofibStringToList("I've"), nofibStringToList("you've")) ::
    Tup2(nofibStringToList("I'm"), nofibStringToList("you're")) ::
    Nil
  fun prepare(ls) = map(wr => if wr is Tup2(w, r) then Tup2(ucase(w), r), ls)
  fun lscomp(ls) = if ls is
    Nil then Nil
    Cons(Tup2(x, y), t) then Cons(Tup2(x, y) :: Tup2(y, x) :: Nil, lscomp(t))
  prepare(append(oneways, concat(lscomp(bothways))))
//│ > Cons {
//│ >   head: Tup2 {
//│ >     fst: Cons { head: 'M', tail: [Cons] },
//│ >     snd: Cons { head: 'y', tail: [Cons] }
//│ >   },
//│ >   tail: Cons {
//│ >     head: Tup2 { fst: [Cons], snd: [Cons] },
//│ >     tail: Cons { head: [Tup2], tail: [Cons] }
//│ >   }
//│ conjugates = }

fun conjug(d, w) =
  fun maybe(d, xs) = if null_(xs) then d else xs
  fun conj(w) =
    fun lscomp(ls) = if ls is
      Nil then Nil
      Cons(Tup2(w_, m), t) and
        listEq(ucase(w), w_) then Cons(m, lscomp(t))
        else lscomp(t)
    head(append(lscomp(conjugates), w :: Nil))
  fun trailingI(ls) =
    fun cons(x, xs) =
      if listEq(x, nofibStringToList("I")) && null_(xs)
      then nofibStringToList("me") :: Nil
      else x :: xs
    foldr(cons, Nil, ls)
  unwords(trailingI(map(conj, maybe(d, w))))

fun replies(key, l) =
  map_lz(
    x => conjug(l, drop(listLen(key), x)),
    filter_lz(
      ls => prefix(key, lz_map(ucase, ls)),
      tails(l)
    )
  )

fun answer(st, l) =
  fun cons(e, r_es) = if r_es is Tup2(r, es) then Tup2(r, Cons(e, es))
  fun ans(e_es, l) = if e_es is
    Cons(Tup2(key, a_as), es) and force(a_as) is LzCons(a, as_) then
      let rs = replies(key, l)
      if null_lz(rs)
      then cons(Tup2(key, a_as), ans(es, l))
      else Tup2(makeResponse(a, head_lz(rs)), Cons(Tup2(key, as_), es))
  if ans(keyTabOf(st), l) is Tup2(response, kt) then Tup2(response, newKeyTab(kt, st))

fun session(rs, prev, ls) = if ls is
  Nil then Nil
  Cons(l, ls) and
    (if listEqBy(listEq, prev, l) then repeated(rs) else answer(rs, l)) is Tup2(response, rs_) then
      append(response, append(nofibStringToList("\n\n"), session(rs_, l, ls)))

fun testEliza_nofib(n) =
  let input = 
    nofibStringToList("Are we alone?") ::
    nofibStringToList("That the Roswell event was actually an alien encounter. Do you agreed?") ::
    nofibStringToList("But why not talk about you, its more fun.") ::
    nofibStringToList("I dont ask, you do") ::
    nofibStringToList("do ray me") ::
    nofibStringToList("Nop, thats because your a computer") ::
    nofibStringToList("you dont") ::
    nofibStringToList("Oh, a paranoid computer, ehh?") ::
    nofibStringToList("Tell me about *your* mother") ::
    nofibStringToList("No, what what was she like?") ::
    nofibStringToList("I'm asking questions, not you") ::
    nofibStringToList("no") ::
    nofibStringToList("yes") ::
    nofibStringToList("but I'm not") ::
    Nil
  map(
    i => (session(initial, Nil, filter(x => not(null_(x)), map(x => words(trim(x)), take(intMod(i, 20), input))))),
    enumFromTo(1, n)
  )

