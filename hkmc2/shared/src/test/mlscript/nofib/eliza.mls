:import NofibPrelude.mls
//│ Imported 120 member(s)


fun toUpper(c) = c.toUpperCase()

fun lz_map(f, ls) = lazy of () =>
  if ls is
    Nil then LzNil
    Cons(h, t) then LzCons(f(h), lz_map(f, t))

fun append_lz(xs, ys) = if xs is
  Nil then force(ys)
  Cons(h, t) then lazy of () => LzCons(h, append_lz(t, ys))

fun cycle(xs) = append_lz(xs, lazy of () => cycle(xs))

fun isSpace(c) = c === " "

fun words(s) = if dropWhile(isSpace, s) is
  Nil then Nil
  Cons(h, t) and
    break_(isSpace, Cons(h, t)) is Tup2(w, s_) then Cons(w, words(s_))

fun unwords(ws) =
  fun go(ws) = if ws is
    Nil then Nil
    Cons(w, ws) then Cons(" ", append(w, go(ws)))
  if ws is
    Nil then Nil
    Cons(w, ws) then append(w, go(ws))

fun null_lz(ls) = if force(ls) is
  LzNil then true
  LzCons(h, t) then false

fun trim(ls) =
  fun cons(x, xs) = if inList(x, nofibStringToList(" .!?,")) and null_(xs) then Nil else Cons(x, xs)
  foldr(cons, Nil, dropWhile(x => inList(x, nofibStringToList(" .!?,")), ls))

fun repeated(kt_rp) = if kt_rp is Tup2(kt, Cons(r, rp)) then Tup2(r, Tup2(kt, rp))

fun newKeyTab(kt_, kt_rp) = if kt_rp is Tup2(kt, rp) then Tup2(kt_, rp)

fun keyTabOf(kt_rp) = if kt_rp is Tup2(kt, rp) then kt

fun makeResponse(cs, us) = if cs is
  Cons("?", cs_) then append(cs_, append(nofibStringToList(" "), append(us, nofibStringToList("?"))))
  Cons(".", cs_) then append(cs_, append(nofibStringToList(" "), append(us, nofibStringToList("."))))
  else cs

