fun infRand(m) =
  fun f(x) = lazy(() => LzCons(((x % m) + 1), f((97 * x + 11) % power(2, 7))))
  f(37)
fun simulate(n, m, proc) =
  fun lscomp(ls) = if ls is
    Nil then Nil
    Cons(seed, t) then Cons(proc(infRand(m)), lscomp(t))
  listLen(filter(x => x, lscomp(enumFromTo(1, n)))) / n
fun sim(k) =
  fun proc(rs) =
    let xs = take_lz(8, nub_lz(rs))
    let best = 8
    let bestk = maximum(take(k, xs))
    let afterk = dropWhile(x => x < bestk, drop(k, xs))
    listEq(best :: Nil, take(1, afterk))
  simulate(500, 10, proc)
fun testSecretary_nofib(dummy) =
  fun listcomp(ls) = if ls is
    Nil then Nil
    Cons(h, t) then Cons(sim(h), listcomp(t))
  listcomp(enumFromTo(35, 39))
nofibPrint(testSecretary_nofib(0))
