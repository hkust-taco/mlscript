fun unlines(ls) = concat(map(x => append(x, ("\n" :: Nil)), ls))
fun join(ls) = foldr1((xs, ys) => append(xs, append((" " :: " " :: Nil), ys)), ls)
fun say(s) = "\n" :: (unlines(map(join, transpose(map(picChar, s)))))
fun isUpper(c) =
  let n = int_of_char(c)
  (n >= 65) and (n <= 90)
fun isLower(c) =
  let n = int_of_char(c)
  (n >= 97) and (n <= 122)
fun isDigit(c) =
  let n = int_of_char(c)
  (n >= 48) and (n <= 57)
fun isSpace(c) =
  let n = int_of_char(c)
  (n == 32)
fun picChar(c) =
  fun lscomp(ls) = if ls is
    Nil then Nil
    Cons(h, t) and
      h is Tup2(c_, letter) and c_ === c then Cons(letter, lscomp(t))
      else lscomp(t)
  if
    isUpper(c) then atIndex(int_of_char(c) - int_of_char("A"), alphas)
    isLower(c) then atIndex(int_of_char(c) - int_of_char("a"), alphas)
    isSpace(c) then blank
    isDigit(c) then atIndex(int_of_char(c) - int_of_char("0"), digits)
    c === "/" then slant
    c === "=" then reverse(slant)
    else head(append(lscomp(punct), Nil :: Nil :: Nil))
fun testBanner_nofib(n) =
  let x = Cons("I", Cons("s", Cons(" ", Cons("t", Cons("h", Cons("i", Cons("s", Cons(" ", Cons("n", Cons("o", Cons("t", Cons(" ", Cons("a", Cons(" ", Cons("g", Cons("r", Cons("e", Cons("a", Cons("t", Cons(" ", Cons("b", Cons("a", Cons("n", Cons("n", Cons("e", Cons("r", Cons("?", Nil)))))))))))))))))))))))))))
  say(concat(replicate(n, x)))
testBanner_nofib(1)
